@@ -0,0 +1,71 @@
+use super::protocol;
+use serde_json::{Map,Value};
+
+const SESSIONS: &[&str] = &["id","project","agentId","startedAt","endedAt","status","observationCount","title","cwd","agent","firstPrompt","model","compressionMethod"];
+const OBSERVATIONS: &[&str] = &["id","sessionId","agentId","timestamp","type","title","subtitle","narrative","facts","concepts","files","importance","tokens","toolName","hookType","userPrompt","compressionMethod"];
+
+pub fn validate_fields(entity: &str, fields: &[String]) -> anyhow::Result<()> {
+    let allowed = if entity=="sessions" {SESSIONS} else {OBSERVATIONS};
+    protocol::require(!fields.is_empty() && fields.len()<=allowed.len()
+        && fields.iter().all(|field|allowed.contains(&field.as_str()))
+        && fields.iter().collect::<std::collections::HashSet<_>>().len()==fields.len())
+}
+
+pub(super) fn project(source: &Value, fields: &[String]) -> (Value,Vec<String>) {
+    let mut result=Map::new();
+    let mut truncated=Vec::new();
+    for field in fields {
+        let Some(value)=source.get(field) else {continue;};
+        let cap=if ["narrative","firstPrompt","userPrompt"].contains(&field.as_str()) {4096} else {2048};
+        let projected=match value {
+            Value::String(_) if ["id","sessionId"].contains(&field.as_str())=>value.clone(),
+            Value::String(text)=> {
+                let bounded:String=text.chars().take(cap).collect();
+                if bounded.len()!=text.len() {truncated.push(field.clone());}
+                Value::String(bounded)
+            }
+            Value::Array(values)=> {
+                let mut bounded=Vec::new();
+                let mut changed=values.len()>16;
+                for value in values.iter().take(16) {
+                    if let Some(text)=value.as_str() {
+                        let item:String=text.chars().take(256).collect();
+                        changed|=item.len()!=text.len();
+                        bounded.push(Value::String(item));
+                    } else {changed=true;}
+                }
+                if changed {truncated.push(field.clone());}
+                Value::Array(bounded)
+            }
+            Value::Null|Value::Bool(_)|Value::Number(_)=>value.clone(),
+            Value::Object(_)=> {truncated.push(field.clone());continue;}
+        };
+        result.insert(field.clone(),projected);
+    }
+    (Value::Object(result),truncated)
+}
+
+pub(super) fn shrink(value:&mut Value,truncated:&mut Vec<String>,cap:usize,array_cap:usize) {
+    let Some(fields)=value.as_object_mut() else {return;};
+    for (name,value) in fields {
+        if ["id","sessionId"].contains(&name.as_str()) {continue;}
+        let mut changed=false;
+        match value {
+            Value::String(text)=> {
+                let bounded:String=text.chars().take(cap).collect();
+                changed=bounded.len()!=text.len();*text=bounded;
+            }
+            Value::Array(values)=> {
+                changed=values.len()>array_cap;values.truncate(array_cap);
+                for item in values {
+                    if let Value::String(text)=item {
+                        let bounded:String=text.chars().take(cap).collect();
+                        changed|=bounded.len()!=text.len();*text=bounded;
+                    }
+                }
+            }
+            _=>{}
+        }
+        if changed && !truncated.contains(name) {truncated.push(name.clone());}
+    }
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/workflow_statistics.rs b/engine/src/workers/state/adapters/sqlite/retrieval/workflow_statistics.rs
