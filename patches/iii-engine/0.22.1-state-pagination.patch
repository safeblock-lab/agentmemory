diff --git a/engine/src/workers/state/adapters/sqlite/retention.rs b/engine/src/workers/state/adapters/sqlite/retention.rs
new file mode 100644
index 0000000..29aa19e
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retention.rs
@@ -0,0 +1,273 @@
+use super::{commit, database, protocol};
+use protocol::{Checkpoint, Guard, JOBS, WORKING, error, require};
+use rusqlite::{Connection, params};
+use serde::{Deserialize, Serialize};
+use serde_json::{Value, json};
+
+const MAX_BYTES: u64 = 4 * 1024 * 1024;
+#[derive(Clone, Default, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct Cursor {
+    pub scope_index: usize,
+    pub after_key: String,
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct GraphRequest {
+    pub guard: Guard,
+    pub job_id: String,
+    pub expected_checkpoint_version: String,
+    pub limit: usize,
+    pub max_bytes: u64,
+    pub cursor: Option<Cursor>,
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct AuditRequest {
+    pub guard: Guard,
+    pub through_key: String,
+    pub limit: usize,
+    pub max_bytes: u64,
+    pub cursor: Option<Cursor>,
+}
+fn budget(
+    limit: usize,
+    max_bytes: u64,
+    cursor: &Option<Cursor>,
+    last: usize,
+) -> anyhow::Result<()> {
+    require((1..=256).contains(&limit) && (1..=MAX_BYTES).contains(&max_bytes))?;
+    require(
+        cursor
+            .as_ref()
+            .is_none_or(|c| c.scope_index <= last && c.after_key.len() <= 4096),
+    )
+}
+struct Range {
+    scope: String,
+    lower: String,
+    upper: String,
+    keep: String,
+    exact: bool,
+}
+fn receipt_key(point: &Checkpoint) -> anyhow::Result<String> {
+    require(point.next_chunk_ordinal > 0)?;
+    Ok(serde_json::to_string(&json!([
+        point.generation,
+        point.job_id,
+        point.logical_delta_id,
+        point.next_chunk_ordinal - 1
+    ]))?)
+}
+fn eligible(connection: &Connection, job_id: &str, version: &str) -> anyhow::Result<Checkpoint> {
+    let job = database::row(connection, JOBS, job_id)?
+        .value
+        .ok_or_else(|| error("STATE_TX_CHECKPOINT_CONFLICT"))?;
+    let checkpoint = database::row(connection, database::CHECKPOINT_SCOPE, job_id)?;
+    if checkpoint.version != protocol::counter(version)? {
+        return Err(error("STATE_TX_CHECKPOINT_CONFLICT"));
+    }
+    let point: Checkpoint = protocol::decode(
+        checkpoint
+            .value
+            .ok_or_else(|| error("STATE_TX_CHECKPOINT_CONFLICT"))?,
+    )?;
+    require(
+        commit::prunable_job(&job)
+            && point.visibility == "complete"
+            && point.job_id == job_id
+            && job["id"] == job_id
+            && job["generation"] == point.generation,
+    )?;
+    let receipt = database::row(connection, database::RECEIPT_SCOPE, &receipt_key(&point)?)?
+        .value
+        .ok_or_else(|| error("STATE_GRAPH_RECOVERY_REQUIRED"))?;
+    let identity = json!({"generation":point.generation,"job_id":job_id,"logical_delta_id":point.logical_delta_id,"chunk_ordinal":point.next_chunk_ordinal-1});
+    require(
+        receipt["identity"] == identity
+            && receipt["checkpoint_version"] == version
+            && receipt["payload_digest"]
+                .as_str()
+                .is_some_and(|v| v.len() == 64 && v.bytes().all(|b| b.is_ascii_hexdigit()))
+            && receipt["row_versions"].is_array(),
+    )?;
+    Ok(point)
+}
+fn ranges(point: &Checkpoint) -> anyhow::Result<Vec<Range>> {
+    let mut ranges: Vec<Range> = protocol::PREFIXES
+        .iter()
+        .map(|prefix| Range {
+            scope: format!("{prefix}{}", point.job_id),
+            lower: String::new(),
+            upper: String::new(),
+            keep: String::new(),
+            exact: false,
+        })
+        .collect();
+    ranges.push(Range {
+        scope: WORKING.into(),
+        lower: point.job_id.clone(),
+        upper: point.job_id.clone(),
+        keep: String::new(),
+        exact: true,
+    });
+    let encoded = serde_json::to_string(&json!([point.generation, point.job_id]))?;
+    let prefix = format!("{},", &encoded[..encoded.len() - 1]);
+    ranges.push(Range {
+        scope: database::RECEIPT_SCOPE.into(),
+        lower: prefix.clone(),
+        upper: format!("{prefix}~"),
+        keep: receipt_key(point)?,
+        exact: false,
+    });
+    Ok(ranges)
+}
+fn remove_page(
+    connection: &Connection,
+    ranges: &[Range],
+    limit: usize,
+    max_bytes: u64,
+    cursor: Option<Cursor>,
+) -> anyhow::Result<Value> {
+    let start = std::time::Instant::now();
+    let budget = std::time::Duration::from_secs(3);
+    connection.progress_handler(10_000, Some(move || start.elapsed() >= budget))?;
+    let result = remove_page_inner(connection, ranges, limit, max_bytes, cursor);
+    connection.progress_handler(0, None::<fn() -> bool>)?;
+    if start.elapsed() >= budget || result.as_ref().err().is_some_and(|cause| {
+        cause.downcast_ref::<rusqlite::Error>().is_some_and(|error| {
+            matches!(error, rusqlite::Error::SqliteFailure(code, _)
+                if code.code == rusqlite::ErrorCode::OperationInterrupted)
+        })
+    }) {
+        return Err(error("STATE_TX_LIMIT_EXCEEDED"));
+    }
+    result
+}
+fn remove_page_inner(
+    connection: &Connection,
+    ranges: &[Range],
+    limit: usize,
+    max_bytes: u64,
+    cursor: Option<Cursor>,
+) -> anyhow::Result<Value> {
+    let mut cursor = cursor.unwrap_or_default();
+    let mut count = 0usize;
+    let mut bytes = 0u64;
+    while cursor.scope_index < ranges.len() {
+        let range = &ranges[cursor.scope_index];
+        let rows = {
+            let after = cursor.after_key.as_str();
+            let lower = range.lower.as_str();
+            let upper = range.upper.as_str();
+            let (sql, lower, upper) = if range.exact {
+                ("SELECT key,value_bytes FROM state_rows WHERE scope=?1 AND key=?3 AND key>?2 AND key<>?5 ORDER BY key LIMIT ?4", lower, None)
+            } else if !upper.is_empty() {
+                ("SELECT key,value_bytes FROM state_rows WHERE scope=?1 AND key>?2 AND key>=?3 AND key<?6 AND key<>?5 ORDER BY key LIMIT ?4", lower, Some(upper))
+            } else if !lower.is_empty() {
+                ("SELECT key,value_bytes FROM state_rows WHERE scope=?1 AND key>?2 AND key>=?3 AND key<>?5 ORDER BY key LIMIT ?4", lower, None)
+            } else {
+                ("SELECT key,value_bytes FROM state_rows WHERE scope=?1 AND key>?2 AND key<>?5 ORDER BY key LIMIT ?4", "", None)
+            };
+            let mut statement = connection.prepare_cached(sql)?;
+            statement.raw_bind_parameter(1, &range.scope)?;
+            statement.raw_bind_parameter(2, after)?;
+            if range.exact || !range.upper.is_empty() || !range.lower.is_empty() {
+                statement.raw_bind_parameter(3, lower)?;
+            }
+            statement.raw_bind_parameter(4, (limit - count + 1) as i64)?;
+            statement.raw_bind_parameter(5, &range.keep)?;
+            if let Some(upper) = upper {
+                statement.raw_bind_parameter(6, upper)?;
+            }
+            let mut selected = Vec::new();
+            let mut rows = statement.raw_query();
+            while let Some(row) = rows.next()? {
+                selected.push((row.get::<_, String>(0)?, row.get::<_, i64>(1)?));
+            }
+            selected
+        };
+        if rows.is_empty() {
+            cursor.scope_index += 1;
+            cursor.after_key.clear();
+            continue;
+        }
+        let mut changed = false;
+        for (key, value_bytes) in rows {
+            let cost = u64::try_from(value_bytes)?
+                .saturating_add(key.len() as u64 + range.scope.len() as u64);
+            if count == limit || (count > 0 && bytes.saturating_add(cost) > max_bytes) {
+                if changed {
+                    revision(connection, &range.scope)?;
+                }
+                return Ok(
+                    json!({"deleted_count":count,"deleted_bytes":bytes,"cursor":cursor,"done":false}),
+                );
+            }
+            connection.execute(
+                "DELETE FROM state_rows WHERE scope=?1 AND key=?2",
+                params![range.scope, key],
+            )?;
+            cursor.after_key = key;
+            count += 1;
+            bytes = bytes.saturating_add(cost);
+            changed = true;
+        }
+        if changed {
+            revision(connection, &range.scope)?;
+        }
+    }
+    Ok(json!({"deleted_count":count,"deleted_bytes":bytes,"cursor":null,"done":true}))
+}
+fn revision(connection: &Connection, scope: &str) -> anyhow::Result<()> {
+    let revision = protocol::next(database::revision(connection, scope)?)?.to_string();
+    connection.execute(
+        "UPDATE state_scopes SET revision=?2 WHERE scope=?1",
+        params![scope, revision],
+    )?;
+    Ok(())
+}
+pub fn close_page(connection: &Connection, job_id: &str, version: &str) -> anyhow::Result<Value> {
+    let point = eligible(connection, job_id, version)?;
+    remove_page(connection, &ranges(&point)?, 256, MAX_BYTES, None)
+}
+pub fn graph(connection: &Connection, request: GraphRequest) -> anyhow::Result<Value> {
+    budget(request.limit, request.max_bytes, &request.cursor, 6)?;
+    require(
+        !request.job_id.is_empty()
+            && request.job_id.len() <= 4096
+            && protocol::counter(&request.expected_checkpoint_version)? > 0,
+    )?;
+    commit::maintenance_allowed(connection, &request.guard, Some(&request.job_id))?;
+    let point = eligible(
+        connection,
+        &request.job_id,
+        &request.expected_checkpoint_version,
+    )?;
+    remove_page(
+        connection,
+        &ranges(&point)?,
+        request.limit,
+        request.max_bytes,
+        request.cursor,
+    )
+}
+pub fn audit(connection: &Connection, request: AuditRequest) -> anyhow::Result<Value> {
+    budget(request.limit, request.max_bytes, &request.cursor, 0)?;
+    require(!request.through_key.is_empty() && request.through_key.len() <= 4096)?;
+    commit::maintenance_allowed(connection, &request.guard, None)?;
+    let range = Range {
+        scope: "mem:audit".into(),
+        lower: String::new(),
+        upper: format!("{}\0", request.through_key),
+        keep: String::new(),
+        exact: false,
+    };
+    remove_page(
+        connection,
+        &[range],
+        request.limit,
+        request.max_bytes,
+        request.cursor,
+    )
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retention_tests.rs b/engine/src/workers/state/adapters/sqlite/retention_tests.rs
new file mode 100644
index 0000000..2ad712c
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retention_tests.rs
@@ -0,0 +1,116 @@
+use super::*;
+
+async fn closed() -> (tempfile::TempDir, Arc<SqliteAdapter>, Value, Value) {
+    let (directory, adapter) = fresh();
+    let owner = guard(&adapter, "maintenance", "1").await;
+    adapter.commit_batch(batch(owner.clone(),"legacy", "delta",0,"0","staging",vec![
+        op(JOBS,"legacy","0",job("legacy","1")),op(WORKING,"legacy","0",working("legacy","1","delta",None)),
+    ])).await.unwrap();
+    let receipt = adapter.commit_batch(batch(owner.clone(),"legacy","delta",1,"1","complete",vec![
+        op(JOBS,"legacy","1",json!({"version":1,"id":"legacy","generation":"1","state":"completed","result":{"ok":true}})),check(SNAPSHOT,"current","0"),
+    ])).await.unwrap();
+    (directory,adapter,owner,receipt)
+}
+fn request(owner: Value, limit: usize) -> Value {
+    json!({"guard":owner,"job_id":"legacy","expected_checkpoint_version":"2","limit":limit,"max_bytes":4096})
+}
+
+#[tokio::test]
+async fn sqlite_terminal_retention_pages_retry_restart_and_preserve_final_replay() {
+    let (directory, adapter, owner, final_receipt) = closed().await;
+    adapter.run(4096,|connection| {
+        for prefix in protocol::PREFIXES {
+            for n in 0..5 {
+                database::write(connection,&format!("{prefix}legacy"),&format!("key-{n}"),Some(&json!({"work":n})))?;
+            }
+        }
+        database::write(connection,"mem:obs:session","observation",Some(&json!({"content":"recall must retain"})))?;
+        Ok(())
+    }).await.unwrap();
+    let first = adapter.graph_prune_terminal(request(owner.clone(),2)).await.unwrap();
+    assert_eq!(first["deleted_count"],2);
+    assert_eq!(first["done"],false);
+    // Lost acknowledgement may repeat the same page safely.
+    assert_eq!(adapter.graph_prune_terminal(request(owner.clone(),2)).await.unwrap()["deleted_count"],2);
+    drop(adapter);
+    let adapter = Arc::new(SqliteAdapter::new(Some(json!({"file_path":directory.path().join("synthetic.sqlite3")}))).unwrap());
+    let mut next = request(owner,2);
+    next["cursor"] = first["cursor"].clone();
+    let mut deleted = 4;
+    for _ in 0..32 {
+        let result = adapter.graph_prune_terminal(next.clone()).await.unwrap();
+        assert!(result["deleted_count"].as_u64().unwrap() <= 2);
+        deleted += result["deleted_count"].as_u64().unwrap();
+        if result["done"] == true { break; }
+        next["cursor"] = result["cursor"].clone();
+    }
+    assert_eq!(deleted,25);
+    for prefix in protocol::PREFIXES { assert!(adapter.list(&format!("{prefix}legacy")).await.unwrap().is_empty()); }
+    let key = serde_json::to_string(&json!(["1","legacy","delta",1])).unwrap();
+    assert_eq!(adapter.get(database::RECEIPT_SCOPE,&key).await.unwrap(),Some(final_receipt));
+    assert_eq!(adapter.get("mem:obs:session","observation").await.unwrap(),Some(json!({"content":"recall must retain"})));
+}
+
+#[tokio::test]
+async fn sqlite_terminal_retention_refuses_missing_receipt_checkpoint_change_and_recovery_barrier() {
+    let (_directory,adapter,owner,_) = closed().await;
+    let mut changed = request(owner.clone(),1);
+    changed["expected_checkpoint_version"] = json!("1");
+    assert_eq!(code(adapter.graph_prune_terminal(changed).await.unwrap_err()),"STATE_TX_CHECKPOINT_CONFLICT");
+    adapter.run(4096,|connection| {
+        let mut control = database::row(connection,database::CONTROL_SCOPE,"current")?.value.unwrap();
+        control["recovery"] = database::row(connection,database::CHECKPOINT_SCOPE,"legacy")?.value.unwrap();
+        database::write(connection,database::CONTROL_SCOPE,"current",Some(&control))?; Ok(())
+    }).await.unwrap();
+    assert_eq!(code(adapter.graph_prune_terminal(request(owner.clone(),1)).await.unwrap_err()),"STATE_GRAPH_RECOVERY_REQUIRED");
+    adapter.run(4096,|connection| {
+        let mut control = database::row(connection,database::CONTROL_SCOPE,"current")?.value.unwrap();
+        control["recovery"] = Value::Null;
+        database::write(connection,database::CONTROL_SCOPE,"current",Some(&control))?;
+        connection.execute("DELETE FROM state_rows WHERE scope=?1",[database::RECEIPT_SCOPE])?; Ok(())
+    }).await.unwrap();
+    assert_eq!(code(adapter.graph_prune_terminal(request(owner,1)).await.unwrap_err()),"STATE_GRAPH_RECOVERY_REQUIRED");
+}
+
+#[tokio::test]
+async fn sqlite_terminal_retention_page_rollback_and_audit_ceiling_are_physical_and_scoped() {
+    let (_directory,adapter,owner,_) = closed().await;
+    for key in ["a","b","z"] { adapter.set("mem:audit",key,json!({"operation":"legacy"})).await.unwrap(); }
+    adapter.set("mem:obs:s","a",json!({"content":"preserve"})).await.unwrap();
+    adapter.run(4096,|connection| {
+        connection.execute_batch("CREATE TRIGGER fail_prune BEFORE DELETE ON state_rows WHEN OLD.scope='mem:audit' AND OLD.key='b' BEGIN SELECT RAISE(ABORT,'prune failed'); END;")?; Ok(())
+    }).await.unwrap();
+    let input = json!({"guard":owner,"through_key":"b","limit":2,"max_bytes":4096});
+    assert!(adapter.audit_prune_history(input.clone()).await.is_err());
+    assert_eq!(adapter.list("mem:audit").await.unwrap().len(),3);
+    adapter.run(4096,|connection| { connection.execute_batch("DROP TRIGGER fail_prune")?; Ok(()) }).await.unwrap();
+    let result = adapter.audit_prune_history(input.clone()).await.unwrap();
+    assert_eq!(result["deleted_count"],2);
+    assert_eq!(result["done"],true);
+    assert_eq!(adapter.audit_prune_history(input).await.unwrap()["deleted_count"],0);
+    assert_eq!(adapter.get("mem:audit","z").await.unwrap(),Some(json!({"operation":"legacy"})));
+    assert!(adapter.get("mem:obs:s","a").await.unwrap().is_some());
+    assert_eq!(adapter.run(4096,|connection| Ok(connection.query_row("SELECT count(*) FROM state_rows WHERE scope='mem:audit'",[],|r|r.get::<_,i64>(0))?)).await.unwrap(),1);
+}
+
+#[tokio::test]
+async fn sqlite_terminal_retention_byte_budget_advances_one_oversized_row_and_removes_tombstones() {
+    let (_directory,adapter,owner,_) = closed().await;
+    adapter.run(4096,|connection| {
+        let scope = "mem:graph:inputs:legacy";
+        database::write(connection,scope,"a",Some(&json!("x".repeat(8192))))?;
+        database::write(connection,scope,"b",Some(&json!("small")))?;
+        database::write(connection,scope,"c",None)?;
+        Ok(())
+    }).await.unwrap();
+    let first = adapter.graph_prune_terminal(request(owner.clone(),256)).await.unwrap();
+    assert_eq!(first["deleted_count"],1);
+    assert!(first["deleted_bytes"].as_u64().unwrap() > 4096);
+    assert_eq!(first["done"],false);
+    let mut continuation = request(owner,256);
+    continuation["cursor"] = first["cursor"].clone();
+    let second = adapter.graph_prune_terminal(continuation).await.unwrap();
+    assert_eq!(second["deleted_count"],2);
+    assert_eq!(second["done"],true);
+    assert_eq!(adapter.run(4096,|connection| Ok(connection.query_row("SELECT count(*) FROM state_rows WHERE scope='mem:graph:inputs:legacy'",[],|r|r.get::<_,i64>(0))?)).await.unwrap(),0);
+}
