@@ -0,0 +1,107 @@
+use super::super::database;
+use rusqlite::{Connection, OptionalExtension, params};
+use serde_json::Value;
+
+mod mutations;
+mod payload;
+
+const SCOPE: &str = "mem:fireworks-batch:work-items";
+
+#[derive(Clone)]
+pub(super) struct RowMeta {
+    pub version: String,
+    pub logical_bytes: i64,
+    pub stored_bytes: i64,
+}
+
+pub(super) fn row_meta(
+    connection: &Connection,
+    scope: &str,
+    key: &str,
+) -> anyhow::Result<Option<RowMeta>> {
+    connection.query_row(
+        "SELECT version,value_bytes,CASE typeof(value) WHEN 'blob' THEN length(value) WHEN 'text' THEN length(value)*4 ELSE 0 END FROM state_rows WHERE scope=?1 AND key=?2 AND value IS NOT NULL",
+        params![scope,key],
+        |row| Ok(RowMeta { version: row.get(0)?, logical_bytes: row.get(1)?, stored_bytes: row.get(2)? }),
+    ).optional().map_err(Into::into)
+}
+
+pub(super) fn encoded_value(
+    connection: &Connection,
+    scope: &str,
+    key: &str,
+    meta: &RowMeta,
+) -> anyhow::Result<Option<Vec<u8>>> {
+    connection.query_row(
+        "SELECT value FROM state_rows WHERE scope=?1 AND key=?2 AND version=?3 AND value IS NOT NULL AND value_bytes=?4 AND CASE typeof(value) WHEN 'blob' THEN length(value) WHEN 'text' THEN length(value)*4 ELSE 0 END=?5",
+        params![scope,key,meta.version,meta.logical_bytes,meta.stored_bytes],
+        |row| Ok(row.get_ref(0)?.as_bytes()?.to_vec()),
+    ).optional().map_err(Into::into)
+}
+
+pub(super) fn decode(
+    connection: &Connection,
+    scope: &str,
+    key: &str,
+    meta: &RowMeta,
+) -> anyhow::Result<Option<Value>> {
+    let Some(encoded) = encoded_value(connection, scope, key, meta)? else {
+        return Ok(None);
+    };
+    let raw = database::decode_value(&encoded, meta.logical_bytes)?;
+    Ok(Some(serde_json::from_str(&raw)?))
+}
+
+pub(super) fn valid_bound(meta: &RowMeta, max_bytes: usize) -> bool {
+    meta.logical_bytes > 0
+        && meta.stored_bytes > 0
+        && meta.logical_bytes <= max_bytes as i64
+        && meta.stored_bytes <= max_bytes as i64
+}
+
+pub(super) fn fingerprint(version: &str, item: &Value) -> anyhow::Result<String> {
+    use sha2::{Digest, Sha256};
+    Ok(format!(
+        "{:x}",
+        Sha256::digest(serde_json::to_vec(
+            &serde_json::json!({"version":version,"item":item})
+        )?)
+    ))
+}
+
+pub fn payload(
+    connection: &Connection,
+    keys: &[String],
+    max_bytes: usize,
+) -> anyhow::Result<Value> {
+    payload::execute(connection, keys, max_bytes)
+}
+
+pub fn submission_patch(
+    connection: &Connection,
+    job_id: &str,
+    updated_at: &str,
+    items: &[super::request::BatchSubmissionItem],
+) -> anyhow::Result<Value> {
+    mutations::submission_patch(connection, job_id, updated_at, items)
+}
+
+pub fn bridge_ack(
+    connection: &Connection,
+    key: &str,
+    expected_version: &str,
+    expected_fingerprint: &str,
+    receipt_key: &str,
+) -> anyhow::Result<Value> {
+    mutations::bridge_ack(
+        connection,
+        key,
+        expected_version,
+        expected_fingerprint,
+        receipt_key,
+    )
+}
+
+pub(super) fn work_scope() -> &'static str {
+    SCOPE
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/batch_work/mutations.rs b/engine/src/workers/state/adapters/sqlite/retrieval/batch_work/mutations.rs
