+use super::state::{Epochs, Project};
+use rusqlite::{Connection, OptionalExtension, params};
+use serde::{Deserialize, Serialize};
+
+pub fn current(vector: &str, session: &str) -> String {
+    format!("{vector}.project_generation=1 AND {vector}.generation={session}.generation
+        AND EXISTS(SELECT 1 FROM retrieval_source_items si JOIN state_values r ON r.scope=si.scope AND r.key=si.key AND r.version=si.version AND r.live=1 WHERE si.index_id='observations' AND si.scope='mem:obs:'||{session}.name AND si.key={vector}.id AND si.dirty=0)
+        AND (EXISTS(SELECT 1 FROM retrieval_project_refs a INDEXED BY retrieval_project_refs_session JOIN state_values r ON r.scope='mem:sessions' AND r.key=a.source_key AND r.version=a.version AND r.live=1 WHERE a.source='sessions' AND a.epoch=?4 AND a.session_id={session}.name AND a.project=?3)
+        OR (NOT EXISTS(SELECT 1 FROM state_values r WHERE r.scope='mem:sessions' AND r.key={session}.name AND r.live=1)
+        AND EXISTS(SELECT 1 FROM retrieval_project_refs a INDEXED BY retrieval_project_refs_session JOIN state_values r ON r.scope='mem:summaries' AND r.key=a.source_key AND r.version=a.version AND r.live=1 WHERE a.source='summaries' AND a.epoch=?5 AND a.session_id={session}.name AND a.source_key={session}.name AND a.project=?3)))")
+}
+
+pub fn node_current(key: &str) -> String {
+    let active = current("v", "s");
+    format!("EXISTS(SELECT 1 FROM retrieval_nodes n CROSS JOIN retrieval_identifiers node ON node.epoch=n.epoch AND node.value=n.key CROSS JOIN retrieval_membership_values m ON m.epoch=node.epoch AND m.key=node.id CROSS JOIN retrieval_identifiers o ON o.epoch=m.epoch AND o.id=m.observation CROSS JOIN retrieval_scoped_vectors v ON v.index_id='observations' AND v.epoch=?2 AND v.id=o.value CROSS JOIN retrieval_scoped_sessions s ON s.token=v.session WHERE n.epoch=?1 AND n.key={key} AND v.kind=0 AND v.project=(SELECT token FROM retrieval_scoped_projects WHERE name=?3) AND {active})")
+}
+
+pub fn contains(c: &Connection, epochs: &Epochs, project: &str, key: &str) -> anyhow::Result<bool> {
+    let sql = format!("SELECT {}",node_current("?6"));
+    c.query_row(&sql,params![epochs.nodes,epochs.vectors,project,epochs.sessions,epochs.summaries,key],|r|r.get(0)).map_err(Into::into)
+}
+
+#[derive(Default, Deserialize, Serialize)]
+struct Cursor {
+    session: i64,
+    observation: String,
+    active: String,
+    node: i64,
+}
+
+pub fn seed(c: &Connection, project: &str, saved: &Project, epochs: &Epochs, max_rows: usize) -> anyhow::Result<(String, usize, bool)> {
+    let mut cursor: Cursor = if saved.cursor.is_empty() { Cursor::default() } else { serde_json::from_str(&saved.cursor)? };
+    let mut processed = 0;
+    let mut complete = false;
+    while processed < max_rows {
+        if cursor.active.is_empty() {
+            let active = current("v", "s");
+            let sql = format!("SELECT v.session,v.id FROM retrieval_scoped_vectors v INDEXED BY retrieval_scoped_vectors_project CROSS JOIN retrieval_scoped_sessions s ON s.token=v.session WHERE v.index_id='observations' AND v.epoch=?2 AND v.project=(SELECT token FROM retrieval_scoped_projects WHERE name=?3) AND v.kind=0 AND (v.session,v.id)>(?6,?7) AND {active} ORDER BY v.session,v.id LIMIT 1");
+            let next: Option<(i64,String)> = c.query_row(&sql,params![epochs.nodes,epochs.vectors,project,epochs.sessions,epochs.summaries,cursor.session,cursor.observation],|r|Ok((r.get(0)?,r.get(1)?))).optional()?;
+            let Some((session, observation)) = next else { complete = true; break };
+            cursor.session = session;
+            cursor.observation = observation.clone();
+            cursor.active = observation;
+            cursor.node = 0;
+        }
+        let next: Option<(i64,String)> = c.query_row("SELECT m.key,n.key FROM retrieval_identifiers o CROSS JOIN retrieval_inverse_membership_values m ON m.epoch=o.epoch AND m.observation=o.id CROSS JOIN retrieval_identifiers node ON node.epoch=m.epoch AND node.id=m.key CROSS JOIN retrieval_nodes n ON n.epoch=node.epoch AND n.key=node.value WHERE o.epoch=?1 AND o.value=?2 AND m.key>?3 ORDER BY m.key LIMIT 1",params![epochs.nodes,cursor.active,cursor.node],|r|Ok((r.get(0)?,r.get(1)?))).optional()?;
+        if let Some((node,key)) = next {
+            c.execute("INSERT OR IGNORE INTO browse_nodes VALUES(?1,?2,?3)",params![project,saved.generation,key])?;
+            cursor.node = node;
+        } else {
+            cursor.active.clear();
+        }
+        processed += 1;
+    }
+    Ok((serde_json::to_string(&cursor)?,processed,complete))
+}
