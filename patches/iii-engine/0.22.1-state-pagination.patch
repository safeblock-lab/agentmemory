+    assert_eq!(projected["items"].as_array().unwrap().len(),1);
+    assert_eq!(projected["items"][0]["value"]["has_result"],true);
+    assert!(projected["items"][0]["value"].get("result").is_none());
+    assert!(projected["items"][0]["value"].get("unknownProviderField").is_none());
