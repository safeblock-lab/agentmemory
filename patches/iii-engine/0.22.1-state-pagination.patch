@@ -0,0 +1,118 @@
+use super::super::protocol;
+use super::source::kind;
+use rusqlite::{Connection, params};
+use serde_json::Value;
+
+pub(super) fn project_fields(value: &Value, fields: &[&str]) -> Value {
+    Value::Object(fields.iter().filter_map(|field|
+        value.get(*field).map(|value| ((*field).to_owned(), value.clone()))).collect())
+}
+
+pub fn lexical_text(
+    connection: &Connection,
+    id: &str,
+    value: &Value,
+) -> anyhow::Result<Option<String>> {
+    if kind(connection, id)?.is_none() {
+        return value
+            .get("text")
+            .map(|v| {
+                v.as_str()
+                    .map(str::to_owned)
+                    .ok_or_else(|| protocol::error("STATE_TX_INVALID_REQUEST"))
+            })
+            .transpose();
+    }
+    let scope = value["sourceScope"]
+        .as_str()
+        .ok_or_else(|| protocol::error("STATE_TX_INVALID_REQUEST"))?;
+    let key = value["id"]
+        .as_str()
+        .ok_or_else(|| protocol::error("STATE_TX_INVALID_REQUEST"))?;
+    let projection = "json_object('title',json_extract(state_value,'$.title'),'subtitle',json_extract(state_value,'$.subtitle'),'narrative',json_extract(state_value,'$.narrative'),'content',json_extract(state_value,'$.content'),'facts',json_extract(state_value,'$.facts'),'concepts',json_extract(state_value,'$.concepts'),'files',json_extract(state_value,'$.files'))";
+    let sql = format!(
+        "WITH source_row AS MATERIALIZED (SELECT state_json(value,value_bytes) AS state_value FROM state_values WHERE scope=?1 AND key=?2 AND live=1) SELECT length(CAST({projection} AS BLOB)),{projection} FROM source_row"
+    );
+    let mut statement = connection.prepare(&sql)?;
+    let mut rows = statement.query(params![scope, key])?;
+    let row = rows
+        .next()?
+        .ok_or_else(|| protocol::error("STATE_SEMANTIC_SOURCE_STALE"))?;
+    if row.get::<_, i64>(0)? > 1_048_576 {
+        return Err(super::request::resource());
+    }
+    let raw: String = row.get(1)?;
+    let document: Value = serde_json::from_str(&raw)?;
+    Ok(Some(project(&document, scope)?))
+}
+
+pub fn project(document: &Value, scope: &str) -> anyhow::Result<String> {
+    let mut terms = Vec::new();
+    visit_terms(document, scope, |text| terms.push(text))?;
+    let text = terms.join(" ");
+    protocol::require(!text.trim().is_empty())?;
+    Ok(text)
+}
+
+pub fn prefix(text: &str, max_bytes: usize) -> &str {
+    let mut end = text.find('\0').unwrap_or(text.len()).min(max_bytes);
+    while !text.is_char_boundary(end) { end -= 1; }
+    &text[..end]
+}
+
+pub fn project_prefix(document: &Value, scope: &str, max_bytes: usize) -> anyhow::Result<(String, usize)> {
+    let mut text = String::new();
+    let mut bytes = 0usize;
+    let mut first = true;
+    let mut stopped = false;
+    let mut nonblank = false;
+    visit_terms(document, scope, |term| {
+        if !first {
+            bytes += 1;
+            if !stopped && text.len() < max_bytes { text.push(' '); }
+        }
+        first = false;
+        bytes += term.len();
+        nonblank |= !term.trim().is_empty();
+        if !stopped {
+            let part = prefix(term, max_bytes - text.len());
+            text.push_str(part);
+            stopped = part.len() < term.len();
+        }
+    })?;
+    protocol::require(nonblank)?;
+    Ok((text, bytes))
+}
+
+fn visit_terms<'a>(document: &'a Value, scope: &str, mut visit: impl FnMut(&'a str)) -> anyhow::Result<()> {
+    protocol::require(super::source::tracked_scope(scope))?;
+    let fields: &[&str] = if scope == "mem:memories" {
+        &["title", "content", "concepts", "files"]
+    } else {
+        &[
+            "title",
+            "subtitle",
+            "narrative",
+            "facts",
+            "concepts",
+            "files",
+        ]
+    };
+    for field in fields {
+        match &document[field] {
+            Value::Null => {}
+            Value::String(text) => visit(text.as_str()),
+            Value::Array(values) => {
+                for value in values {
+                    visit(
+                        value
+                            .as_str()
+                            .ok_or_else(|| protocol::error("STATE_TX_INVALID_REQUEST"))?,
+                    );
+                }
+            }
+            _ => return Err(protocol::error("STATE_TX_INVALID_REQUEST")),
+        }
+    }
+    Ok(())
+}
