+        }
+    } else {None};
+    let retained:Option<String>=c.query_row("SELECT proof_json FROM engine_graph_auto_terminal_sources WHERE root_id=?1 AND local_value_digest IS NULL",[&id],|r|r.get(0)).optional()?;
