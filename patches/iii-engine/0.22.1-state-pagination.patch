+    async fn snapshot_open(&self, bytes: usize, owner: String, request: String) -> anyhow::Result<Value> {
+        let capture_slot = self.snapshot_slot.clone().try_acquire_owned()
+            .map_err(|_| protocol::error("STATE_SNAPSHOT_BUSY"))?;
+        let budget = database::PreparationBudget::new("snapshot_open", Duration::from_millis(snapshot_read_view::CAPTURE_MS));
+        let _cancellation = CancelPreparation(Some(budget.clone()));
+        // A single capture reserves the existing admission ceiling and one queue
+        // slot. No corpus or decoded row is retained with this reservation.
+        let permit = self.admission.clone().try_acquire_many_owned(MAX_ENVELOPE_BYTES as u32)
+            .map_err(|_| protocol::error("STATE_TX_LIMIT_EXCEEDED"))?;
+        protocol::require(bytes <= MAX_ENVELOPE_BYTES)?;
+        let (reply, response) = oneshot::channel();
+        let worker_budget = budget.clone();
+        let queued: Job = Box::new(move |_source, views| {
+            if reply.is_closed() || worker_budget.check().is_err() {
+                let _ = reply.send(Err(protocol::error("STATE_SNAPSHOT_CANCELLED"))); return None;
+            }
+            if views.reap().is_err() || views.busy() {
+                let _ = reply.send(Err(protocol::error("STATE_SNAPSHOT_BUSY"))); return None;
+            }
+            Some(Capture(Box::new(move |source, receiver, views| {
+                let result = views.capture(source,owner,request,&worker_budget, |connection, views| {
+                    for _ in 0..8 {
+                        match receiver.try_recv() {
+                            Ok(job) => {
+                                if let Some(nested) = job(connection,views) {
+                                    // An open request sees the occupied view slot and
+                                    // refuses before producing a nested capture.
+                                    drop(nested); return Err(protocol::error("STATE_SNAPSHOT_BUSY"));
+                                }
+                            },
+                            Err(mpsc::TryRecvError::Empty) => break,
+                            Err(mpsc::TryRecvError::Disconnected) => return Err(protocol::error("STATE_SNAPSHOT_CANCELLED")),
+                        }
+                    }
+                    std::thread::yield_now();
+                    Ok(())
+                });
+                if reply.send(result).is_err() {
+                    worker_budget.failure("snapshot_open_ack_lost");
+                    if views.cleanup().is_err() { tracing::warn!(failure_class="snapshot_cleanup_failed", "state snapshot cleanup pending"); }
+                }
+                drop(permit);
+                drop(capture_slot);
+            })))
+        });
+        // Capture is optional work. Do not occupy a queue waiter when full.
+        self.sender.as_ref().ok_or_else(|| protocol::error("STATE_TX_FAILED"))?
+            .try_send(queued).map_err(|_| protocol::error("STATE_SNAPSHOT_BUSY"))?;
+        match tokio::time::timeout_at(tokio::time::Instant::from_std(budget.deadline),response).await {
+            Ok(result) => result.map_err(|_| protocol::error("STATE_TX_FAILED"))?,
+            Err(_) => { budget.cancel(); Err(protocol::error("STATE_SNAPSHOT_EXPIRED")) },
+        }
+    }
+
+    async fn mutate<T: Send + 'static>(
+        &self,
+        bytes: usize,
+        job: impl FnOnce(&rusqlite::Transaction<'_>) -> anyhow::Result<T> + Send + 'static,
+    ) -> anyhow::Result<T> {
+        let path = self.path.clone();
+        self.run(bytes, move |connection| {
+            database::wal_pressure(connection, &path)?;
+            let transaction = rusqlite::Transaction::new_unchecked(
+                connection, rusqlite::TransactionBehavior::Immediate)?;
+            let result = job(&transaction)?;
+            transaction.commit()?;
+            Ok(result)
+        })
+        .await
+    }
+
+    async fn mutate_profiled<T: Send + 'static>(&self,bytes:usize,job:impl FnOnce(&rusqlite::Transaction<'_>)->anyhow::Result<T>+Send+'static)->anyhow::Result<T> {
+        let path=self.path.clone(); let queued=Instant::now();
+        self.run(bytes,move |connection| {
+            tracing::info!(target:"iii::storage_profile",queue_wall_us=queued.elapsed().as_micros() as u64,"state storage queue profile");
+            let _trace=storage_profile::Trace::start(connection);
+            let total=storage_profile::Clock::start();
+            storage_profile::wal("before_pre_wal",connection,&path);
+            let clock=storage_profile::Clock::start();
+            let pressure=database::wal_pressure(connection,&path);
+            storage_profile::emit("pre_wal",clock,0,0);
+            pressure?;
+            storage_profile::wal("after_pre_wal",connection,&path);
+            let clock=storage_profile::Clock::start();
+            let transaction=rusqlite::Transaction::new_unchecked(connection,rusqlite::TransactionBehavior::Immediate)?;
+            storage_profile::emit("begin",clock,0,0);
+            let clock=storage_profile::Clock::start();
+            let result=job(&transaction);
+            storage_profile::emit("execute",clock,0,0);
+            let result=match result {Ok(result)=>result,Err(error)=>{
+                let clock=storage_profile::Clock::start(); drop(transaction);
+                storage_profile::emit("rollback",clock,0,0);
+                storage_profile::emit("mutation_failed",total,0,0); return Err(error);
+            }};
+            let clock=storage_profile::Clock::start(); let committed=transaction.commit();
+            storage_profile::emit("commit",clock,0,0); committed?;
+            storage_profile::wal("after_commit",connection,&path);
+            storage_profile::emit("mutation_complete",total,0,0);
+            Ok(result)
+        }).await
+    }
+}
