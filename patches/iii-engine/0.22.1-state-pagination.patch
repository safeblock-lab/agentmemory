+        if remove {connection.execute("DELETE FROM engine_graph_auto_terminal_results WHERE job_id=?1 AND generation=?2 AND job_version=?3 AND checkpoint_version=?4 AND reason='GRAPH_AUTOMATIC_SLOT_EXHAUSTED'",params![current.job_id,generation,current.job_version,current.checkpoint_version])?;}
+    }
+    Ok(())
+}
+pub(super) fn recover(connection:&Connection,path:&Path,current:&TerminalAnchor,now:i64,rollback:bool,trusted:&mut Option<authority::Trusted>)->anyhow::Result<Value> {
+    commit::read_allowed(connection,JOBS,&current.job_id,Some(&current.guard))?;
+    let control=database::row(connection,database::CONTROL_SCOPE,"current")?.value.ok_or_else(||error("STATE_GRAPH_RECOVERY_REQUIRED"))?;
+    need(control["recovery"].is_null(),"STATE_GRAPH_RECOVERY_REQUIRED")?;
+    let row=database::row(connection,JOBS,&current.job_id)?;
+    need(row.version.to_string()==current.job_version,"STATE_TX_CONFLICT")?;
+    let job=row.value.ok_or_else(||error("STATE_GRAPH_AUTOMATIC_JOB_MISSING"))?;
+    need(job["version"]==1 && job["id"]==current.job_id && job["kind"]=="extraction" && job["state"]=="failed" && job["recoveryStopped"]==true,UNPROVEN)?;
+    let point=database::row(connection,database::CHECKPOINT_SCOPE,&current.job_id)?;
+    need(point.version.to_string()==current.checkpoint_version,"STATE_TX_CHECKPOINT_CONFLICT")?;
+    let checkpoint:Checkpoint=protocol::decode(point.value.ok_or_else(||error("STATE_TX_CHECKPOINT_CONFLICT"))?)?;
+    need(checkpoint.visibility=="complete" && checkpoint.job_id==current.job_id && job["generation"]==checkpoint.generation
+        && checkpoint.delta_ordinal>0 && checkpoint.logical_delta_id==format!("delta:{}",checkpoint.delta_ordinal) && checkpoint.next_chunk_ordinal>0,UNPROVEN)?;
+    receipt(connection,&checkpoint.generation,&current.job_id,checkpoint.delta_ordinal,checkpoint.next_chunk_ordinal-1,&current.checkpoint_version)?;
+    if checkpoint.generation!=current.guard.generation {return stopped(connection,current,&checkpoint.generation,"GRAPH_AUTOMATIC_SOURCE_GENERATION_STALE",now);}
+    let cached:Option<(String,String,String,Option<String>)>=connection.query_row("SELECT t.job_version,t.checkpoint_version,t.reason,p.revision FROM engine_graph_auto_terminal_results t LEFT JOIN engine_graph_auto_terminal_proof_revisions p ON p.job_id=t.job_id AND p.generation=t.generation AND p.job_version=t.job_version AND p.checkpoint_version=t.checkpoint_version WHERE t.job_id=?1 AND t.generation=?2",params![current.job_id,checkpoint.generation],|r|Ok((r.get(0)?,r.get(1)?,r.get(2)?,r.get(3)?))).optional()?;
+    let mut revising_source=false;
+    if let Some((job_version,checkpoint_version,reason,revision))=cached {
+        let reconsider=reason=="GRAPH_AUTOMATIC_SOURCE_UNIT_UNPROVEN" && revision.as_deref()!=Some(SOURCE_PROOF_REVISION)
+            || reason=="GRAPH_AUTOMATIC_SLOT_EXHAUSTED" && revision.as_deref()!=Some(adoption::REVISION)
+            || reason=="GRAPH_AUTOMATIC_ADOPTION_CHILD_PRESENT";
+        if job_version==current.job_version && checkpoint_version==current.checkpoint_version && !reconsider {return output(connection,current,None,Value::Null,Some(&reason),false);}
+        revising_source=job_version==current.job_version && checkpoint_version==current.checkpoint_version && reconsider && reason=="GRAPH_AUTOMATIC_SOURCE_UNIT_UNPROVEN";
+    }
+    let (anchor,proof,reference)=match derive(connection,current,&job,&checkpoint) {
+        Ok(derived)=>derived,
+        Err(cause)=>{
+            let reason=reason(&cause);
+            return stopped(connection,current,&checkpoint.generation,reason,now);
+        }
+    };
