@@ -0,0 +1,32 @@
+use super::super::{graph, request};
+use rusqlite::{Connection, params};
+use serde_json::Value;
+
+pub fn node(value: &Value) -> Option<(String, String)> {
+    let name = value.get("name")?.as_str()?.trim().chars().take(256).collect();
+    let kind = value.get("type")?.as_str()?;
+    if kind.is_empty() || kind.len() > 64 {
+        return None;
+    }
+    Some((name, kind.to_owned()))
+}
+
+pub fn edge(value: &Value) -> Option<(String, f64)> {
+    let kind = value.get("type")?.as_str()?;
+    let weight = value.get("weight")?.as_f64()?;
+    if kind.is_empty() || kind.len() > 64 || !weight.is_finite() {
+        return None;
+    }
+    Some((kind.to_owned(), weight))
+}
+
+pub fn update(c: &Connection, scope: &str, epoch: i64, key: &str, value: &Value) -> anyhow::Result<()> {
+    if scope == graph::NODES {
+        let (name, kind) = node(value).ok_or_else(|| super::super::super::protocol::error("STATE_INDEX_RECORD_INVALID"))?;
+        c.execute("UPDATE retrieval_nodes SET display_name=?3,display_type=?4 WHERE epoch=?1 AND key=?2", params![epoch,key,name,kind])?;
+    } else {
+        let (kind, weight) = edge(value).ok_or_else(|| super::super::super::protocol::error("STATE_INDEX_RECORD_INVALID"))?;
+        c.execute("UPDATE retrieval_edges SET display_type=?3,display_weight=?4 WHERE epoch=?1 AND key=?2", params![epoch,key,kind,weight])?;
+    }
+    request::identifier(key)
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/graph_browse/dirty.rs b/engine/src/workers/state/adapters/sqlite/retrieval/graph_browse/dirty.rs
