+            let slot=existing(connection,id)?;
+            let root=existing(connection,&slot.root)?;
+            if root.regeneration.is_some() { return store::response(connection,command,id,false); }
+            let attempt=store::current(connection,&slot)?.ok_or_else(||error("STATE_GRAPH_AUTOMATIC_ATTEMPT_MISSING"))?;
+            if attempt.digest.is_some() || root.terminal.as_deref()==Some("GRAPH_AUTOMATIC_LEGACY_COMPLETE_OUTPUT") { return store::response(connection,command,id,false); }
+            need(["unknown","expired","failed"].contains(&attempt.state.as_str()),"STATE_GRAPH_AUTOMATIC_ATTEMPT_ACTIVE")?;
+            if let Some(reason)=terminal::history(connection,&anchor,slot.original_intent.as_ref())? {
+                store::terminal(connection,id,reason,now)?;
+                return store::response(connection,command,id,false);
+            }
+            if let Err(cause)=terminal::pin_staging(connection,&anchor,&job) {
+                store::terminal(connection,id,stable_reason(&cause),now)?;
+                return store::response(connection,command,id,false);
+            }
+            if let Some(reason)=store::admit(connection,&root.id,"regeneration",now)? {
+                store::terminal(connection,id,reason,now)?;
+                return store::response(connection,command,id,false);
+            }
+            cleanup::parts(connection,id,&attempt.id,now)?;
+            cleanup::invalidate_staging(connection,id,&mut anchor,now)?;
+            let regeneration=format!("{}:regen:1",root.id);
+            let new_job=format!("graphjob_{}",binding::digest(regeneration.as_bytes()));
+            connection.execute("INSERT INTO engine_graph_auto_regenerations(regeneration_id,root_id,new_job_id,deadline_ms) VALUES(?1,?2,?3,?4)",params![regeneration,root.id,new_job,now+120_000])?;
+            connection.execute("UPDATE engine_graph_auto_slots SET regeneration_id=?2,new_job_id=?3,terminal_reason='GRAPH_AUTOMATIC_REGENERATION_READY' WHERE slot_id=?1",params![root.id,regeneration,new_job])?;
+            store::insert_attempt(connection,&root.id,&root.id,1,"prepared",false,now+120_000,now)?;
+            connection.execute("UPDATE engine_graph_auto_slots SET current_attempt=0 WHERE slot_id=?1",[&root.id])?;
+            let mut response=store::response(connection,command,id,true)?;
+            response["cleanup"]=cleanup::page(connection,id,now)?;
+            Ok(response)
+        },
+        Request::Cleanup {..}=>{
+            let slot=existing(connection,id)?;
+            let attempt=store::current(connection,&slot)?.ok_or_else(||error("STATE_GRAPH_AUTOMATIC_ATTEMPT_MISSING"))?;
+            let mut invalidated=0;
+            let mut removed=0;
+            if ["unknown","expired","failed"].contains(&attempt.state.as_str()) && attempt.digest.is_none() {
+                removed=cleanup::parts(connection,id,&attempt.id,now)?;
+                invalidated=cleanup::invalidate_staging(connection,id,&mut anchor,now)?;
+            }
+            let mut response=store::response(connection,command,id,invalidated>0 || removed>0)?;
+            response["cleanup"]=cleanup::page(connection,id,now)?;
+            response["cleanup"]["invalidated"]=json!(invalidated);
+            response["cleanup"]["deleted"]=json!(response["cleanup"]["deleted"].as_u64().unwrap_or(0)+removed as u64);
+            Ok(response)
+        },
+        Request::Status {..} | Request::TerminalRecover {..}=>unreachable!(),
+    }
+}
