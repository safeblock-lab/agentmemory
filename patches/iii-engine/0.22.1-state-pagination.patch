index 0000000000000000000000000000000000000000..8b4e257e77030b0903d7cb761a7c46a68b5fda0c
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/protocol.rs
@@ -0,0 +1,460 @@
+use super::{
+    MAX_ENVELOPE_BYTES,
+    database::{CHECKPOINT_SCOPE, CONTROL_SCOPE, RECEIPT_SCOPE},
+};
+use crate::protocol::ErrorBody;
+use serde::{Deserialize, Serialize};
+use serde_json::Value;
+use sha2::{Digest, Sha256};
+use std::{collections::HashSet, io::Write};
+
+pub const SNAPSHOT: &str = "mem:graph:snapshot";
+pub const WORKING: &str = "mem:graph:working-snapshots";
+pub const JOBS: &str = "mem:graph:jobs";
+const PREFIXES: [&str; 5] = [
+    "mem:graph:inputs:",
+    "mem:graph:provider-results:",
+    "mem:graph:deltas:",
+    "mem:graph:prepared:",
+    "mem:graph:remaps:",
+];
+const RECORDS: [&str; 7] = [
+    "mem:graph:nodes",
+    "mem:graph:edges",
+    SNAPSHOT,
+    "mem:graph:name-index",
+    "mem:graph:edge-key",
+    "mem:graph:node-degree",
+    "mem:graph:edge-history",
+];
+
+#[derive(Debug, thiserror::Error)]
+#[error("{0}: state transaction rejected")]
+pub struct TxError(pub &'static str);
+pub fn error(code: &'static str) -> anyhow::Error {
+    TxError(code).into()
+}
+pub fn require(condition: bool) -> anyhow::Result<()> {
+    if condition {
+        Ok(())
+    } else {
+        Err(error("STATE_TX_INVALID_REQUEST"))
+    }
+}
+pub fn guarded(scope: &str, key: &str) -> bool {
+    RECORDS.contains(&scope)
+        || [
+            JOBS,
+            WORKING,
+            CONTROL_SCOPE,
+            CHECKPOINT_SCOPE,
+            RECEIPT_SCOPE,
+        ]
+        .contains(&scope)
+        || PREFIXES.iter().any(|prefix| scope.starts_with(prefix))
+        || (scope == "mem:batch-callbacks" && (key == "active:graph" || key.starts_with("graph:")))
+}
+pub fn live(scope: &str, key: &str) -> bool {
+    RECORDS.contains(&scope) || (scope == "mem:batch-callbacks" && guarded(scope, key))
+}
+pub fn plain_write(scope: &str, key: &str) -> anyhow::Result<()> {
+    if guarded(scope, key) {
+        Err(error("STATE_TX_FENCED"))
+    } else {
+        Ok(())
+    }
+}
+pub fn error_body(cause: &anyhow::Error, fallback: &str) -> ErrorBody {
+    tracing::warn!(error = ?cause, "state operation rejected");
+    let code = cause
+        .downcast_ref::<TxError>()
+        .map_or(fallback, |error| error.0);
+    ErrorBody {
+        code: code.into(),
+        message: format!("{code}: state operation rejected"),
+        stacktrace: None,
+    }
+}
+#[derive(Default)]
+struct Size(usize);
+impl Write for Size {
+    fn write(&mut self, bytes: &[u8]) -> std::io::Result<usize> {
+        self.0 = self.0.saturating_add(bytes.len());
+        Ok(bytes.len())
+    }
+    fn flush(&mut self) -> std::io::Result<()> {
+        Ok(())
+    }
+}
+pub fn size(value: &impl Serialize) -> anyhow::Result<usize> {
+    let mut size = Size::default();
+    serde_json::to_writer(&mut size, value)?;
+    Ok(size.0)
+}
+pub fn decode<T: serde::de::DeserializeOwned>(value: Value) -> anyhow::Result<T> {
+    serde_json::from_value(value).map_err(|_| error("STATE_TX_INVALID_REQUEST"))
+}
+pub fn counter(value: &str) -> anyhow::Result<u64> {
+    require(
+        !value.is_empty()
+            && value.len() <= 20
+            && value.bytes().all(|c| c.is_ascii_digit())
+            && (value == "0" || !value.starts_with('0')),
+    )?;
+    value.parse().map_err(|_| error("STATE_TX_INVALID_REQUEST"))
+}
+pub fn next(value: u64) -> anyhow::Result<u64> {
+    value
+        .checked_add(1)
+        .ok_or_else(|| error("STATE_TX_LIMIT_EXCEEDED"))
+}
+fn ordinal(value: u64) -> bool {
+    value < 9_007_199_254_740_991
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Guard {
+    pub owner_id: String,
+    pub generation: String,
+    pub fence: String,
+}
+impl Guard {
+    pub fn validate(&self) -> anyhow::Result<()> {
+        require(
+            !self.owner_id.is_empty()
+                && counter(&self.generation)? > 0
+                && counter(&self.fence)? > 0,
+        )
+    }
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct VersionedRequest {
+    pub scope: String,
+    pub key: String,
+    pub guard: Option<Guard>,
+}
+impl VersionedRequest {
+    pub fn validate(&self) -> anyhow::Result<()> {
+        require(!self.scope.is_empty() && !self.key.is_empty())?;
+        if let Some(guard) = &self.guard {
+            guard.validate()?;
+        }
+        Ok(())
+    }
+}
+#[derive(Deserialize)]
+#[serde(tag = "action", rename_all = "lowercase", deny_unknown_fields)]
+pub enum LeaseRequest {
+    Acquire {
+        owner_id: String,
+        generation: String,
+        ttl_ms: u64,
+    },
+    Renew {
+        owner_id: String,
+        generation: String,
+        fence: String,
+        ttl_ms: u64,
+    },
+    Release {
+        owner_id: String,
+        generation: String,
+        fence: String,
+    },
+}
+pub fn lease_request(value: Value) -> anyhow::Result<LeaseRequest> {
+    let request = decode(value)?;
+    match &request {
+        LeaseRequest::Acquire {
+            owner_id,
+            generation,
+            ttl_ms,
+        } => require(
+            !owner_id.is_empty() && counter(generation)? > 0 && (1..=300_000).contains(ttl_ms),
+        )?,
+        LeaseRequest::Renew {
+            owner_id,
+            generation,
+            fence,
+            ttl_ms,
+        } => {
+            Guard {
+                owner_id: owner_id.clone(),
+                generation: generation.clone(),
+                fence: fence.clone(),
+            }
+            .validate()?;
+            require((1..=300_000).contains(ttl_ms))?;
+        }
+        LeaseRequest::Release {
+            owner_id,
+            generation,
+            fence,
+        } => Guard {
+            owner_id: owner_id.clone(),
+            generation: generation.clone(),
+            fence: fence.clone(),
+        }
+        .validate()?,
+    }
+    Ok(request)
+}
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct Identity {
+    pub generation: String,
+    pub job_id: String,
+    pub logical_delta_id: String,
+    pub chunk_ordinal: u64,
+}
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Checkpoint {
+    pub generation: String,
+    pub job_id: String,
+    pub logical_delta_id: String,
+    pub delta_ordinal: u64,
+    pub next_chunk_ordinal: u64,
+    pub visibility: String,
+}
+#[derive(Debug, Deserialize)]
+#[serde(tag = "type", rename_all = "lowercase", deny_unknown_fields)]
+pub enum Operation {
+    Set {
+        scope: String,
+        key: String,
+        expected_version: String,
+        value: Value,
+    },
+    Delete {
+        scope: String,
+        key: String,
+        expected_version: String,
+    },
+    Check {
+        scope: String,
+        key: String,
+        expected_version: String,
+    },
+}
+impl Operation {
+    pub fn row(&self) -> (&str, &str, &str) {
+        match self {
+            Self::Set {
+                scope,
+                key,
+                expected_version,
+                ..
+            }
+            | Self::Delete {
+                scope,
+                key,
+                expected_version,
+            }
+            | Self::Check {
+                scope,
+                key,
+                expected_version,
+            } => (scope, key, expected_version),
+        }
+    }
+    pub fn changed(&self) -> bool {
+        !matches!(self, Self::Check { .. })
+    }
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct CommitBody {
+    pub identity: Identity,
+    pub expected_checkpoint_version: String,
+    pub checkpoint: Checkpoint,
+    pub operations: Vec<Operation>,
+    pub advance_generation: Option<bool>,
+    pub allow_oversized_record: Option<bool>,
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct CommitRequest {
+    pub guard: Guard,
+    pub payload_json: String,
+    pub payload_digest: String,
+}
+impl CommitRequest {
+    pub fn validate(&self, bytes: usize) -> anyhow::Result<CommitBody> {
+        self.guard.validate()?;
+        require(
+            self.payload_digest.len() == 64
+                && self
+                    .payload_digest
+                    .bytes()
+                    .all(|c| c.is_ascii_digit() || (b'a'..=b'f').contains(&c)),
+        )?;
+        require(hex::encode(Sha256::digest(self.payload_json.as_bytes())) == self.payload_digest)?;
+        let strict: strict_json::StrictValue = serde_json::from_str(&self.payload_json)
+            .map_err(|_| error("STATE_TX_INVALID_REQUEST"))?;
+        for flag in ["advance_generation", "allow_oversized_record"] {
+            if let Some(value) = strict.0.get(flag) {
+                require(value == true)?;
+            }
+        }
+        if let Some(operations) = strict.0.get("operations").and_then(Value::as_array) {
+            for operation in operations {
+                if operation.get("type") == Some(&Value::String("set".into())) {
+                    require(operation.get("value").is_some())?;
+                }
+            }
+        }
+        let body: CommitBody = decode(strict.0)?;
+        body.validate()?;
+        if bytes > MAX_ENVELOPE_BYTES {
+            return Err(error("STATE_RECORD_TOO_LARGE"));
+        }
+        if bytes > 4 * 1024 * 1024 && body.allow_oversized_record != Some(true) {
+            return Err(error("STATE_TX_LIMIT_EXCEEDED"));
+        }
+        Ok(body)
+    }
+}
+impl CommitBody {
+    fn validate(&self) -> anyhow::Result<()> {
+        let id = &self.identity;
+        let point = &self.checkpoint;
+        require(
+            counter(&id.generation)? > 0
+                && !id.job_id.is_empty()
+                && !id.logical_delta_id.is_empty()
+                && ordinal(id.chunk_ordinal),
+        )?;
+        next(counter(&self.expected_checkpoint_version)?)?;
+        require(
+            point.generation == id.generation
+                && point.job_id == id.job_id
+                && point.logical_delta_id == id.logical_delta_id
+                && ordinal(point.delta_ordinal)
+                && ordinal(point.next_chunk_ordinal)
+                && point.next_chunk_ordinal == id.chunk_ordinal + 1
+                && ["staging", "applying", "complete"].contains(&point.visibility.as_str()),
+        )?;
+        require(
+            self.operations.len() <= 256
+                && self.advance_generation != Some(false)
+                && self.allow_oversized_record != Some(false),
+        )?;
+        if self.advance_generation == Some(true) {
+            require(point.visibility == "complete")?;
+            next(counter(&id.generation)?)?;
+        }
+        let mut seen = HashSet::new();
+        for op in &self.operations {
+            let (scope, key, version) = op.row();
+            require(
+                !scope.is_empty()
+                    && !key.is_empty()
+                    && guarded(scope, key)
+                    && ![CONTROL_SCOPE, CHECKPOINT_SCOPE, RECEIPT_SCOPE].contains(&scope)
+                    && seen.insert((scope, key)),
+            )?;
+            let version = counter(version)?;
+            if op.changed() {
+                next(version)?;
+            }
+            if point.visibility == "staging" {
+                require(
+                    ([JOBS, WORKING].contains(&scope) && key == id.job_id)
+                        || PREFIXES
+                            .iter()
+                            .any(|prefix| scope == format!("{prefix}{}", id.job_id)),
+                )?;
+            }
+            if point.visibility != "complete" {
+                require(scope != SNAPSHOT || !op.changed())?;
+            }
+            if ([JOBS, WORKING].contains(&scope) && key != id.job_id)
+                || (PREFIXES.iter().any(|prefix| scope.starts_with(prefix))
+                    && !PREFIXES
+                        .iter()
+                        .any(|prefix| scope == format!("{prefix}{}", id.job_id)))
+            {
+                return Err(error("STATE_TX_INVALID_REQUEST"));
+            }
+        }
+        if point.visibility == "complete" {
+            require(self.operations.iter().any(|op| {
+                let (scope, key, _) = op.row();
+                scope == SNAPSHOT && key == "current" && !matches!(op, Operation::Delete { .. })
+            }))?;
+        }
+        if self.allow_oversized_record == Some(true) {
+            require(
+                self.operations.iter().filter(|op| op.changed()).count() == 1
+                    && self
+                        .operations
+                        .iter()
+                        .any(|op| matches!(op, Operation::Set { .. })),
+            )?;
+        }
+        Ok(())
+    }
+}
+
+mod strict_json {
+    use serde::{
+        Deserialize, Deserializer,
+        de::{Error, MapAccess, SeqAccess, Visitor},
+    };
+    use serde_json::Value;
+    pub struct StrictValue(pub Value);
+    impl<'de> Deserialize<'de> for StrictValue {
+        fn deserialize<D: Deserializer<'de>>(d: D) -> Result<Self, D::Error> {
+            d.deserialize_any(StrictVisitor).map(Self)
+        }
+    }
+    struct StrictVisitor;
+    impl<'de> Visitor<'de> for StrictVisitor {
+        type Value = Value;
+        fn expecting(&self, f: &mut std::fmt::Formatter) -> std::fmt::Result {
+            f.write_str("strict JSON")
+        }
+        fn visit_unit<E: Error>(self) -> Result<Value, E> {
+            Ok(Value::Null)
+        }
+        fn visit_bool<E: Error>(self, v: bool) -> Result<Value, E> {
+            Ok(Value::Bool(v))
+        }
+        fn visit_i64<E: Error>(self, v: i64) -> Result<Value, E> {
+            Ok(v.into())
+        }
+        fn visit_u64<E: Error>(self, v: u64) -> Result<Value, E> {
+            Ok(v.into())
+        }
+        fn visit_f64<E: Error>(self, v: f64) -> Result<Value, E> {
+            serde_json::Number::from_f64(v)
+                .map(Value::Number)
+                .ok_or_else(|| E::custom("nonfinite number"))
+        }
+        fn visit_str<E: Error>(self, v: &str) -> Result<Value, E> {
+            Ok(v.into())
+        }
+        fn visit_string<E: Error>(self, v: String) -> Result<Value, E> {
+            Ok(v.into())
+        }
+        fn visit_seq<A: SeqAccess<'de>>(self, mut sequence: A) -> Result<Value, A::Error> {
+            let mut values = Vec::new();
+            while let Some(value) = sequence.next_element::<StrictValue>()? {
+                values.push(value.0);
+            }
+            Ok(Value::Array(values))
+        }
+        fn visit_map<A: MapAccess<'de>>(self, mut map: A) -> Result<Value, A::Error> {
+            let mut values = serde_json::Map::new();
+            while let Some((key, value)) = map.next_entry::<String, StrictValue>()? {
+                if values.insert(key, value.0).is_some() {
+                    return Err(A::Error::custom("duplicate key"));
+                }
+            }
+            Ok(Value::Object(values))
+        }
+    }
+}
