+use super::sqlite_state_pool::Pool;
+use super::*;
+use crate::workers::state::adapters::sqlite::codec;
+use rusqlite::{params, types::Value};
+fn table() -> sqlite_tables::Table {
+    sqlite_tables::Table {
+        name: "state_rows".into(),
+        columns: [
+            "scope",
+            "key",
+            "value",
+            "version",
+            "position",
+            "value_bytes",
+        ]
+        .map(str::to_string)
+        .to_vec(),
+        keys: vec![0, 1],
+    }
+}
+fn row(i: usize, value: Option<String>) -> Vec<Value> {
+    let bytes = value.as_ref().map(String::len).unwrap_or(0);
+    vec![
+        Value::Text("scope".into()),
+        Value::Text(format!("ñ😀{i:08}")),
+        value.map(Value::Text).unwrap_or(Value::Null),
+        Value::Text(format!("v{i}")),
+        if bytes == 0 {
+            Value::Null
+        } else {
+            Value::Integer(-(i as i64))
+        },
+        Value::Integer(bytes as i64),
+    ]
+}
+#[test]
+fn sqlite_state_pool_preserves_exact_codec_order_tombstones_and_reverse() {
+    let t = table();
+    let mut pool = Pool::new(&t, false).unwrap();
+    let mut reverse = Pool::new(&t, true).unwrap();
+    for batch in 0..4 {
+        let source: Vec<_> = (0..97)
+            .map(|i| {
+                row(
+                    batch * 97 + i,
+                    if i % 11 == 0 {
+                        None
+                    } else if i % 3 == 0 {
+                        Some(format!("{{\"n\":{i}}}"))
+                    } else {
+                        Some(format!("{{\"text\":\"{}\"}}", "repeat/".repeat(i + 1)))
+                    },
+                )
+            })
+            .collect();
+        let expected: Vec<_> = source
+            .iter()
+            .cloned()
+            .map(|mut r| {
+                if let Value::Text(v) = &r[2] {
+                    r[2] = Value::Blob(codec::encode(v).unwrap())
+                }
+                r
+            })
+            .collect();
+        let encoded = pool.encode(source.clone()).unwrap();
+        assert_eq!(encoded, expected);
+        assert_eq!(reverse.encode(encoded).unwrap(), source);
+    }
+    pool.finish().unwrap();
+    reverse.finish().unwrap();
+}
+#[test]
+fn sqlite_state_pool_rejects_invalid_json_bytes_and_oversized_batches() {
+    let t = table();
+    for r in [row(0, Some("{bad".into())), {
+        let mut r = row(0, Some("{}".into()));
+        r[5] = Value::Integer(99);
+        r
+    }] {
+        let mut pool = Pool::new(&t, false).unwrap();
+        assert!(pool.encode(vec![r]).is_err());
+    }
+    let mut pool = Pool::new(&t, false).unwrap();
+    let oversized = format!("\"{}\"", "x".repeat(5 * 1024 * 1024));
+    assert!(
+        pool.encode(vec![
+            row(0, Some(oversized.clone())),
+            row(1, Some(oversized))
+        ])
+        .unwrap_err()
+        .to_string()
+        .contains("alone")
+    );
+    let large = format!("\"{}\"", "x".repeat(codec::MAX_LOGICAL_VALUE_BYTES));
+    assert!(
+        pool.encode(vec![row(0, Some(large))])
+            .unwrap_err()
+            .to_string()
+            .contains("native format limit")
+    );
+}
+fn fixture(n: usize) -> (tempfile::TempDir, MigrationArgs) {
+    let dir = tempfile::tempdir_in(std::env::var_os("III_SQLITE_TEST_ROOT").unwrap()).unwrap();
+    let args = MigrationArgs {
+        source: dir.path().join("state-v1.sqlite3"),
+        target: dir.path().join("state-v2.sqlite3"),
+        disk_budget_bytes: 256 * 1024 * 1024,
+        reverse: false,
+    };
+    let mut c = Connection::open(&args.source).unwrap();
+    c.execute_batch("CREATE TABLE state_scopes(scope TEXT PRIMARY KEY,revision TEXT NOT NULL,next_position INTEGER NOT NULL) WITHOUT ROWID;CREATE TABLE state_rows(scope TEXT NOT NULL,key TEXT NOT NULL,value TEXT,version TEXT NOT NULL,position INTEGER,value_bytes INTEGER NOT NULL,PRIMARY KEY(scope,key)) WITHOUT ROWID;CREATE INDEX state_rows_order ON state_rows(scope,position) WHERE value IS NOT NULL;INSERT INTO state_scopes VALUES('scope','9',10000);").unwrap();
+    let tx = c.transaction().unwrap();
+    for i in 0..n {
+        let r = row(
+            i,
+            if i % 19 == 0 {
+                None
+            } else {
+                Some(format!(
+                    " {{\"i\":{i},\"text\":\"{}\"}} ",
+                    "word/".repeat(i % 9)
+                ))
+            },
+        );
+        tx.execute(
+            "INSERT INTO state_rows VALUES(?,?,?,?,?,?)",
+            rusqlite::params_from_iter(r),
+        )
+        .unwrap();
+    }
+    tx.commit().unwrap();
+    c.pragma_update(None, "application_id", database::APPLICATION_ID)
+        .unwrap();
+    c.pragma_update(None, "user_version", 1).unwrap();
+    drop(c);
+    (dir, args)
+}
+#[test]
+fn sqlite_state_pool_migration_resumes_exact_checkpoint_and_reverse() {
+    let (dir, args) = fixture(5003);
+    let original = archive::file_digest(&args.source).unwrap();
+    assert!(
+        run_segment(&args, Some(4097), None)
+            .unwrap_err()
+            .to_string()
+            .contains("interruption")
+    );
+    {
+        let c = Connection::open(&args.target).unwrap();
+        let n: i64 = c
+            .query_row(
+                "SELECT count FROM shadow_transfer_progress WHERE name='state_rows'",
+                [],
+                |r| r.get(0),
+            )
+            .unwrap();
+        assert_eq!(n, 4097);
+        assert_eq!(
+            c.query_row("SELECT count(*) FROM state_rows", [], |r| r
+                .get::<_, i64>(0))
+                .unwrap(),
+            n
+        );
+        assert_eq!(
+            c.query_row("SELECT status FROM shadow_transfer", [], |r| r
+                .get::<_, String>(0))
+                .unwrap(),
+            "pending"
+        );
+        c.execute_batch("PRAGMA synchronous=FULL;PRAGMA wal_checkpoint(TRUNCATE)")
+            .unwrap();
+    }
+    run(&args).unwrap();
+    let c = database::open(&args.target).unwrap();
+    assert_eq!(
+        c.query_row("PRAGMA integrity_check", [], |r| r.get::<_, String>(0))
+            .unwrap(),
+        "ok"
+    );
+    drop(c);
+    run(&MigrationArgs {
+        source: args.target.clone(),
+        target: dir.path().join("rollback-v1.sqlite3"),
+        reverse: true,
+        ..args.clone()
+    })
+    .unwrap();
+    assert_eq!(archive::file_digest(&args.source).unwrap(), original);
+}
+#[test]
+fn sqlite_state_pool_invalid_json_never_commits_partial_batch() {
+    let (_dir, args) = fixture(2);
+    let c = Connection::open(&args.source).unwrap();
+    c.execute(
+        "UPDATE state_rows SET value=?1,value_bytes=4 WHERE key=?2",
+        params!["{bad", "ñ😀00000001"],
+    )
+    .unwrap();
+    drop(c);
+    assert!(format!("{:#}", run(&args).unwrap_err()).contains("Invalid stored JSON"));
+    let c = Connection::open(&args.target).unwrap();
+    assert_eq!(
+        c.query_row("SELECT count(*) FROM state_rows", [], |r| r
+            .get::<_, i64>(0))
+            .unwrap(),
+        0
+    );
+    assert_eq!(
+        c.query_row("SELECT status FROM shadow_transfer", [], |r| r
+            .get::<_, String>(0))
+            .unwrap(),
+        "pending"
+    );
+}
+
+#[test]
+fn sqlite_state_pool_reverse_accepts_maximum_uncompressed_value() {
+    let source = row(
+        0,
+        Some(format!(
+            "\"{}\"",
+            "x".repeat(codec::MAX_LOGICAL_VALUE_BYTES - 2)
+        )),
+    );
+    let mut encoded = source.clone();
+    if let Value::Text(value) = &encoded[2] {
+        encoded[2] = Value::Blob(value.as_bytes().to_vec());
+    }
+    assert!(sqlite_state_pool::row_bytes(&encoded, true).unwrap() > 32 * 1024 * 1024);
+    let mut pool = Pool::new(&table(), true).unwrap();
+    assert_eq!(pool.encode(vec![encoded]).unwrap(), vec![source]);
+    pool.finish().unwrap();
+}
+
+#[test]
+fn sqlite_state_pool_two_three_mib_values_use_separate_batches() {
+    let (_dir, args) = fixture(2);
+    let c = Connection::open(&args.source).unwrap();
+    let value = format!("\"{}\"", "y".repeat(3 * 1024 * 1024 - 2));
+    c.execute(
+        "UPDATE state_rows SET value=?1,value_bytes=?2",
+        params![value, value.len() as i64],
+    )
+    .unwrap();
+    drop(c);
+    run(&args).unwrap();
+    let c = Connection::open_with_flags(&args.target, OpenFlags::SQLITE_OPEN_READ_ONLY).unwrap();
+    assert_eq!(
+        c.query_row("SELECT count(*) FROM state_rows", [], |r| r
+            .get::<_, i64>(0))
+            .unwrap(),
+        2
+    );
+}
