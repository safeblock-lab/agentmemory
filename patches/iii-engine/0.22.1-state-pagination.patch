@@ -0,0 +1,115 @@
+use super::{graph_query, lexical, prepare, request::Request, semantic, semantic_query, source};
+use rusqlite::Connection;
+use serde_json::Value;
+
+pub fn execute(connection: &Connection, request: Request) -> anyhow::Result<Value> {
+    match request {
+        Request::IndexStatus {} => super::status(connection),
+        Request::IndexPrepare {
+            scope,
+            max_rows,
+            max_bytes,
+        } => prepare::prepare(connection, &scope, max_rows, max_bytes),
+        Request::GraphSeeds {
+            entity_names,
+            observation_ids,
+            r#match,
+            max_items,
+            max_bytes,
+        } => graph_query::seeds(
+            connection,
+            &entity_names,
+            &observation_ids,
+            r#match,
+            max_items,
+            max_bytes,
+        ),
+        Request::GraphEdges {
+            node_ids,
+            max_items,
+            max_bytes,
+        } => graph_query::edges(connection, &node_ids, max_items, max_bytes),
+        Request::SemanticConfigure {
+            index_id,
+            model,
+            dimensions,
+            generation,
+            source_kind,
+        } => semantic::configure(
+            connection,
+            &index_id,
+            &model,
+            dimensions,
+            &generation,
+            source_kind.as_deref(),
+        ),
+        Request::SourcePrepare {
+            index_id,
+            model,
+            dimensions,
+            generation,
+            max_rows,
+            max_bytes,
+        } => {
+            semantic::get(connection, &index_id)?.identity(&model, dimensions, &generation)?;
+            source::prepare(connection, &index_id, max_rows, max_bytes)
+        }
+        Request::SemanticUpsert {
+            index_id,
+            model,
+            dimensions,
+            generation,
+            items,
+        } => semantic::upsert(
+            connection,
+            &index_id,
+            &model,
+            dimensions,
+            &generation,
+            items,
+        ),
+        Request::SemanticDelete {
+            index_id,
+            model,
+            dimensions,
+            generation,
+            ids,
+        } => semantic::delete(connection, &index_id, &model, dimensions, &generation, &ids),
+        Request::SemanticSearch {
+            index_id,
+            model,
+            dimensions,
+            generation,
+            embedding,
+            limit,
+            max_candidates,
+            probes,
+        } => semantic_query::search(
+            connection,
+            &index_id,
+            &model,
+            dimensions,
+            &generation,
+            &embedding,
+            limit,
+            max_candidates,
+            probes,
+        ),
+        Request::KeywordSearch {
+            index_id,
+            model,
+            dimensions,
+            generation,
+            query,
+            limit,
+        } => lexical::search(
+            connection,
+            &index_id,
+            &model,
+            dimensions,
+            &generation,
+            &query,
+            limit,
+        ),
+    }
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/eligibility.rs b/engine/src/workers/state/adapters/sqlite/retrieval/eligibility.rs
new file mode 100644
index 0000000..572f5cb
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/eligibility.rs
@@ -0,0 +1,48 @@
+use rusqlite::{Connection, functions::FunctionFlags};
+use serde_json::Value;
+
+pub const SQL: &str = "retrieval_source_eligible(scope,json_extract(state_value,'$.title'),CASE WHEN scope='mem:memories' THEN json_extract(state_value,'$.content') ELSE json_extract(state_value,'$.narrative') END,json_type(state_value,'$.isLatest'))";
+
+fn has_content(value: Option<&str>) -> bool {
+    value.is_some_and(|value|value.chars().any(|c|!matches!(c,'\u{0009}'..='\u{000d}'|'\u{0020}'|'\u{00a0}'|'\u{1680}'|'\u{2000}'..='\u{200a}'|'\u{2028}'|'\u{2029}'|'\u{202f}'|'\u{205f}'|'\u{3000}'|'\u{feff}')))
+}
+
+fn eligible(scope: &str, title: Option<&str>, body: Option<&str>, latest: bool) -> bool {
+    (scope != "mem:memories" || latest) && has_content(title) && has_content(body)
+}
+
+pub fn value(scope: &str, value: Option<&Value>) -> bool {
+    let Some(value) = value else {
+        return false;
+    };
+    let body = if scope == "mem:memories" {
+        "content"
+    } else {
+        "narrative"
+    };
+    eligible(
+        scope,
+        value["title"].as_str(),
+        value[body].as_str(),
+        value.get("isLatest") != Some(&Value::Bool(false)),
+    )
+}
+
+pub fn register(connection: &Connection) -> anyhow::Result<()> {
+    connection.create_scalar_function(
+        "retrieval_source_eligible",
+        4,
+        FunctionFlags::SQLITE_UTF8
+            | FunctionFlags::SQLITE_DETERMINISTIC
+            | FunctionFlags::SQLITE_INNOCUOUS,
+        |context| {
+            Ok(eligible(
+                context.get_raw(0).as_str().unwrap_or(""),
+                context.get_raw(1).as_str().ok(),
+                context.get_raw(2).as_str().ok(),
+                context.get_raw(3).as_str().ok() != Some("false"),
+            ))
+        },
+    )?;
+    Ok(())
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/graph.rs b/engine/src/workers/state/adapters/sqlite/retrieval/graph.rs
new file mode 100644
index 0000000..025a758
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/graph.rs
@@ -0,0 +1,187 @@
+use super::{metadata, request};
+use rusqlite::{Connection, OptionalExtension, params};
+use serde_json::Value;
+use std::collections::BTreeSet;
+
+pub const NODES: &str = "mem:graph:nodes";
+pub const EDGES: &str = "mem:graph:edges";
+
+pub fn schema(connection: &Connection) -> anyhow::Result<()> {
+    connection.execute_batch("CREATE TABLE IF NOT EXISTS retrieval_graph_meta(scope TEXT PRIMARY KEY,status TEXT NOT NULL,cursor INTEGER NOT NULL,revision TEXT NOT NULL,epoch INTEGER NOT NULL) WITHOUT ROWID;
+        CREATE TABLE IF NOT EXISTS retrieval_nodes(epoch INTEGER NOT NULL,key TEXT NOT NULL,id TEXT NOT NULL,name TEXT NOT NULL,prefix TEXT NOT NULL,position INTEGER NOT NULL,PRIMARY KEY(epoch,key)) WITHOUT ROWID;
+        CREATE INDEX IF NOT EXISTS retrieval_nodes_name ON retrieval_nodes(epoch,name,position);
+        CREATE INDEX IF NOT EXISTS retrieval_nodes_prefix ON retrieval_nodes(epoch,prefix,position);
+        CREATE TABLE IF NOT EXISTS retrieval_name_grams(epoch INTEGER NOT NULL,gram TEXT NOT NULL,key TEXT NOT NULL,position INTEGER NOT NULL,PRIMARY KEY(epoch,gram,key)) WITHOUT ROWID;
+        CREATE INDEX IF NOT EXISTS retrieval_name_grams_key ON retrieval_name_grams(epoch,key);
+        CREATE TABLE IF NOT EXISTS retrieval_identifiers(id INTEGER PRIMARY KEY,epoch INTEGER NOT NULL,value TEXT NOT NULL,UNIQUE(epoch,id),UNIQUE(epoch,value));
+        CREATE TEMP TABLE IF NOT EXISTS retrieval_orphans(id INTEGER PRIMARY KEY);
+        CREATE TABLE IF NOT EXISTS retrieval_membership(epoch INTEGER NOT NULL,observation INTEGER NOT NULL,key INTEGER NOT NULL,position INTEGER NOT NULL,PRIMARY KEY(epoch,observation,key),FOREIGN KEY(epoch,observation) REFERENCES retrieval_identifiers(epoch,id) ON DELETE CASCADE,FOREIGN KEY(epoch,key) REFERENCES retrieval_identifiers(epoch,id) ON DELETE CASCADE) WITHOUT ROWID;
+        CREATE INDEX IF NOT EXISTS retrieval_membership_key ON retrieval_membership(epoch,key);
+        CREATE TABLE IF NOT EXISTS retrieval_edges(epoch INTEGER NOT NULL,key TEXT NOT NULL,source TEXT NOT NULL,target TEXT NOT NULL,position INTEGER NOT NULL,PRIMARY KEY(epoch,key)) WITHOUT ROWID;
+        CREATE INDEX IF NOT EXISTS retrieval_edges_source ON retrieval_edges(epoch,source,position);
+        CREATE INDEX IF NOT EXISTS retrieval_edges_target ON retrieval_edges(epoch,target,position);")?;
+    for scope in [NODES, EDGES] {
+        metadata::initialize_graph(connection, scope)?;
+    }
+    Ok(())
+}
+
+fn identifier_id(connection: &Connection, epoch: i64, value: &str) -> anyhow::Result<Option<i64>> {
+    Ok(connection
+        .query_row(
+            "SELECT id FROM retrieval_identifiers WHERE epoch=?1 AND value=?2",
+            params![epoch, value],
+            |row| row.get(0),
+        )
+        .optional()?)
+}
+
+fn ensure_identifier_id(connection: &Connection, epoch: i64, value: &str) -> anyhow::Result<i64> {
+    connection.execute(
+        "INSERT OR IGNORE INTO retrieval_identifiers(epoch,value) VALUES(?1,?2)",
+        params![epoch, value],
+    )?;
+    identifier_id(connection, epoch, value)?
+        .ok_or_else(|| super::super::protocol::error("STATE_TX_FAILED"))
+}
+
+fn remove_old_memberships(connection: &Connection, epoch: i64, key: &str) -> anyhow::Result<()> {
+    connection.execute("DELETE FROM retrieval_orphans", [])?;
+    if let Some(key_id) = identifier_id(connection, epoch, key)? {
+        connection.execute(
+            "INSERT OR IGNORE INTO retrieval_orphans(id) SELECT observation FROM retrieval_membership WHERE epoch=?1 AND key=?2",
+            params![epoch, key_id],
+        )?;
+        connection.execute(
+            "INSERT OR IGNORE INTO retrieval_orphans(id) VALUES(?1)",
+            [key_id],
+        )?;
+        connection.execute(
+            "DELETE FROM retrieval_membership INDEXED BY retrieval_membership_key WHERE epoch=?1 AND key=?2",
+            params![epoch, key_id],
+        )?;
+        connection.execute(
+            "DELETE FROM retrieval_identifiers AS i WHERE i.epoch=?1 AND i.id IN (SELECT id FROM retrieval_orphans) AND NOT EXISTS(SELECT 1 FROM retrieval_membership WHERE epoch=i.epoch AND observation=i.id) AND NOT EXISTS(SELECT 1 FROM retrieval_membership INDEXED BY retrieval_membership_key WHERE epoch=i.epoch AND key=i.id)",
+            params![epoch],
+        )?;
+    }
+    connection.execute("DELETE FROM retrieval_orphans", [])?;
+    Ok(())
+}
+
+pub fn grams(name: &str, width: usize) -> BTreeSet<String> {
+    let chars: Vec<char> = name.chars().collect();
+    if chars.len() < width {
+        return BTreeSet::new();
+    }
+    chars
+        .windows(width)
+        .map(|part| part.iter().collect())
+        .collect()
+}
+
+fn indexable(value: &Value, key: &str) -> anyhow::Result<bool> {
+    request::identifier(key)?;
+    super::super::protocol::require(value.is_object() && value["id"].as_str() == Some(key))?;
+    match value.get("stale") {
+        None | Some(Value::Bool(false)) => Ok(true),
+        Some(Value::Bool(true)) => Ok(false),
+        _ => Err(super::super::protocol::error("STATE_TX_INVALID_REQUEST")),
+    }
+}
+
+pub fn replace(
+    connection: &Connection,
+    scope: &str,
+    key: &str,
+    value: Option<&Value>,
+    position: Option<i64>,
+    epoch: i64,
+) -> anyhow::Result<()> {
+    if scope == NODES {
+        connection.execute(
+            "DELETE FROM retrieval_name_grams INDEXED BY retrieval_name_grams_key WHERE epoch=?1 AND key=?2",
+            params![epoch, key],
+        )?;
+        remove_old_memberships(connection, epoch, key)?;
+        connection.execute(
+            "DELETE FROM retrieval_nodes WHERE epoch=?1 AND key=?2",
+            params![epoch, key],
+        )?;
+        let Some(value) = value.filter(|_| position.is_some()) else {
+            return Ok(());
+        };
+        if !indexable(value, key)? {
+            return Ok(());
+        }
+        let name = value["name"]
+            .as_str()
+            .ok_or_else(|| super::super::protocol::error("STATE_TX_INVALID_REQUEST"))?;
+        if name.len() > 16 * 1024 {
+            return Err(request::resource());
+        }
+        let name = name.to_lowercase();
+        let prefix: String = name.chars().take(3).collect();
+        let members = value["sourceObservationIds"]
+            .as_array()
+            .ok_or_else(|| super::super::protocol::error("STATE_TX_INVALID_REQUEST"))?;
+        connection.execute(
+            "INSERT INTO retrieval_nodes VALUES(?1,?2,?2,?3,?4,?5)",
+            params![epoch, key, name, prefix, position],
+        )?;
+        let mut insert =
+            connection.prepare_cached("INSERT INTO retrieval_name_grams VALUES(?1,?2,?3,?4)")?;
+        for width in 1..=3 {
+            for gram in grams(&name, width) {
+                insert.execute(params![epoch, gram, key, position])?;
+            }
+        }
+        let mut bytes = 0usize;
+        for member in members {
+            let member = member
+                .as_str()
+                .ok_or_else(|| super::super::protocol::error("STATE_TX_INVALID_REQUEST"))?;
+            request::identifier(member)?;
+            bytes = bytes.saturating_add(member.len());
+            if bytes > 2 * 1024 * 1024 {
+                return Err(request::resource());
+            }
+        }
+        if !members.is_empty() {
+            let key_id = ensure_identifier_id(connection, epoch, key)?;
+            let members_json = serde_json::to_string(members)?;
+            connection.execute(
+                "INSERT OR IGNORE INTO retrieval_identifiers(epoch,value) SELECT ?1,value FROM json_each(?2) WHERE type='text'",
+                params![epoch, members_json],
+            )?;
+            connection.execute(
+                "INSERT OR IGNORE INTO retrieval_membership(epoch,observation,key,position) SELECT ?1,observation.id,?3,?4 FROM json_each(?2) source CROSS JOIN retrieval_identifiers observation ON observation.epoch=?1 AND observation.value=source.value WHERE source.type='text'",
+                params![epoch, members_json, key_id, position],
+            )?;
+        }
+    } else if scope == EDGES {
+        connection.execute(
+            "DELETE FROM retrieval_edges WHERE epoch=?1 AND key=?2",
+            params![epoch, key],
+        )?;
+        let Some(value) = value.filter(|_| position.is_some()) else {
+            return Ok(());
+        };
+        if !indexable(value, key)? {
+            return Ok(());
+        }
+        let source = value["sourceNodeId"]
+            .as_str()
+            .ok_or_else(|| super::super::protocol::error("STATE_TX_INVALID_REQUEST"))?;
+        let target = value["targetNodeId"]
+            .as_str()
+            .ok_or_else(|| super::super::protocol::error("STATE_TX_INVALID_REQUEST"))?;
+        request::identifier(source)?;
+        request::identifier(target)?;
+        connection.execute(
+            "INSERT INTO retrieval_edges VALUES(?1,?2,?3,?4,?5)",
+            params![epoch, key, source, target, position],
+        )?;
+    }
+    Ok(())
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/graph_query.rs b/engine/src/workers/state/adapters/sqlite/retrieval/graph_query.rs
new file mode 100644
index 0000000..fffb108
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/graph_query.rs
@@ -0,0 +1,243 @@
+use super::super::{commit, database, protocol};
+use super::{
+    graph, metadata,
+    request::{self, NameMatch},
+};
+use rusqlite::{Connection, params};
+use serde_json::{Value, json};
+
+const MAX_CANDIDATE_VISITS: usize = 131_072;
+
+fn begin(connection: &Connection, scope: &str) -> anyhow::Result<i64> {
+    commit::read_allowed(connection, scope, "", None)?;
+    let epoch = metadata::ready_graph(connection, scope)?;
+    connection.execute_batch("DELETE FROM retrieval_selected;")?;
+    Ok(epoch)
+}
+
+fn selected(
+    connection: &Connection,
+    key: &str,
+    position: i64,
+    entity: bool,
+    observation: bool,
+    max_items: usize,
+) -> anyhow::Result<()> {
+    connection.execute("INSERT INTO retrieval_selected VALUES(?1,?2,?3,?4) ON CONFLICT(key) DO UPDATE SET entity=MAX(entity,excluded.entity),observation=MAX(observation,excluded.observation)", params![key,position,entity,observation])?;
+    let count: i64 =
+        connection.query_row("SELECT count(*) FROM retrieval_selected", [], |r| r.get(0))?;
+    if count > max_items as i64 {
+        return Err(request::resource());
+    }
+    Ok(())
+}
+
+fn select_names(
+    connection: &Connection,
+    sql: &str,
+    epoch: i64,
+    term: &str,
+    query: &str,
+    mode: NameMatch,
+    visits: &mut usize,
+    max_items: usize,
+) -> anyhow::Result<()> {
+    let mut statement = connection.prepare_cached(sql)?;
+    let mut rows = statement.query(params![epoch, term])?;
+    while let Some(row) = rows.next()? {
+        *visits += 1;
+        if *visits > MAX_CANDIDATE_VISITS {
+            return Err(request::resource());
+        }
+        let name: String = row.get(1)?;
+        let matched = match mode {
+            NameMatch::Exact => name == query,
+            NameMatch::Substring => name.contains(query) || query.contains(&name),
+        };
+        if matched {
+            selected(
+                connection,
+                &row.get::<_, String>(0)?,
+                row.get(2)?,
+                true,
+                false,
+                max_items,
+            )?;
+        }
+    }
+    Ok(())
+}
+
+fn generation(connection: &Connection) -> anyhow::Result<Value> {
+    let control = database::row(connection, database::CONTROL_SCOPE, "current")?
+        .value
+        .ok_or_else(|| protocol::error("STATE_TX_FAILED"))?;
+    Ok(control["generation"].clone())
+}
+
+pub fn seeds(
+    connection: &Connection,
+    names: &[String],
+    observations: &[String],
+    mode: NameMatch,
+    max_items: usize,
+    max_bytes: usize,
+) -> anyhow::Result<Value> {
+    let epoch = begin(connection, graph::NODES)?;
+    let mut visits = 0;
+    for query in names {
+        let query = query.to_lowercase();
+        if mode == NameMatch::Exact {
+            select_names(
+                connection,
+                "SELECT key,name,position FROM retrieval_nodes INDEXED BY retrieval_nodes_name WHERE epoch=?1 AND name=?2",
+                epoch,
+                &query,
+                &query,
+                mode,
+                &mut visits,
+                max_items,
+            )?;
+            continue;
+        }
+        if query.is_empty() {
+            select_names(
+                connection,
+                "SELECT key,name,position FROM retrieval_nodes WHERE epoch=?1 AND ?2=''",
+                epoch,
+                "",
+                "",
+                mode,
+                &mut visits,
+                max_items,
+            )?;
+            continue;
+        }
+        let anchor: String = query.chars().take(3).collect();
+        select_names(
+            connection,
+            "SELECT n.key,n.name,n.position FROM retrieval_name_grams g CROSS JOIN retrieval_nodes n WHERE g.epoch=?1 AND g.gram=?2 AND n.epoch=g.epoch AND n.key=g.key",
+            epoch,
+            &anchor,
+            &query,
+            mode,
+            &mut visits,
+            max_items,
+        )?;
+        for width in 1..=3 {
+            for prefix in graph::grams(&query, width) {
+                select_names(
+                    connection,
+                    "SELECT key,name,position FROM retrieval_nodes INDEXED BY retrieval_nodes_prefix WHERE epoch=?1 AND prefix=?2",
+                    epoch,
+                    &prefix,
+                    &query,
+                    mode,
+                    &mut visits,
+                    max_items,
+                )?;
+            }
+        }
+        select_names(
+            connection,
+            "SELECT key,name,position FROM retrieval_nodes INDEXED BY retrieval_nodes_name WHERE epoch=?1 AND name=?2",
+            epoch,
+            "",
+            &query,
+            mode,
+            &mut visits,
+            max_items,
+        )?;
+    }
+    let mut statement = connection.prepare_cached(
+        "SELECT k.value,m.position FROM retrieval_membership m CROSS JOIN retrieval_identifiers k ON k.epoch=m.epoch AND k.id=m.key WHERE m.epoch=?1 AND m.observation=(SELECT id FROM retrieval_identifiers WHERE epoch=?1 AND value=?2) ORDER BY k.value",
+    )?;
+    for observation in observations {
+        let mut rows = statement.query(params![epoch, observation])?;
+        while let Some(row) = rows.next()? {
+            visits += 1;
+            if visits > MAX_CANDIDATE_VISITS {
+                return Err(request::resource());
+            }
+            selected(
+                connection,
+                &row.get::<_, String>(0)?,
+                row.get(1)?,
+                false,
+                true,
+                max_items,
+            )?;
+        }
+    }
+    let mut output = Vec::new();
+    let mut bytes = 256;
+    let mut statement = connection.prepare(
+        "SELECT key,position,entity,observation FROM retrieval_selected ORDER BY position",
+    )?;
+    let mut rows = statement.query([])?;
+    while let Some(row) = rows.next()? {
+        let key: String = row.get(0)?;
+        let position: i64 = row.get(1)?;
+        let item = json!({"key":key,"id":key,"position":position.to_string(),"entity":row.get::<_,bool>(2)?,"observation":row.get::<_,bool>(3)?});
+        bytes += protocol::size(&item)? + 1;
+        if bytes > max_bytes {
+            return Err(request::resource());
+        }
+        output.push(item);
+    }
+    Ok(json!({"items":output,"generation":generation(connection)?}))
+}
+
+pub fn edges(
+    connection: &Connection,
+    node_ids: &[String],
+    max_items: usize,
+    max_bytes: usize,
+) -> anyhow::Result<Value> {
+    let epoch = begin(connection, graph::EDGES)?;
+    let mut visits = 0;
+    for node in node_ids {
+        for sql in [
+            "SELECT key,position FROM retrieval_edges INDEXED BY retrieval_edges_source WHERE epoch=?1 AND source=?2",
+            "SELECT key,position FROM retrieval_edges INDEXED BY retrieval_edges_target WHERE epoch=?1 AND target=?2",
+        ] {
+            let mut statement = connection.prepare_cached(sql)?;
+            let mut rows = statement.query(params![epoch, node])?;
+            while let Some(row) = rows.next()? {
+                visits += 1;
+                if visits > MAX_CANDIDATE_VISITS {
+                    return Err(request::resource());
+                }
+                selected(
+                    connection,
+                    &row.get::<_, String>(0)?,
+                    row.get(1)?,
+                    false,
+                    false,
+                    max_items,
+                )?;
+            }
+        }
+    }
+    let mut statement = connection.prepare("SELECT s.key,s.position,r.value,r.value_bytes FROM retrieval_selected s CROSS JOIN state_rows r WHERE r.scope=?1 AND r.key=s.key AND r.value IS NOT NULL ORDER BY s.position")?;
+    let mut rows = statement.query([graph::EDGES])?;
+    let mut output = Vec::new();
+    let mut bytes = 256;
+    while let Some(row) = rows.next()? {
+        let raw_bytes: i64 = row.get(3)?;
+        if raw_bytes < 0 || raw_bytes as usize > max_bytes.saturating_sub(bytes) {
+            return Err(request::resource());
+        }
+        let encoded: Vec<u8> = row.get(2)?;
+        let value: Value = serde_json::from_str(&database::decode_value(&encoded, raw_bytes)?)?;
+        let position: i64 = row.get(1)?;
+        let item =
+            json!({"key":row.get::<_,String>(0)?,"position":position.to_string(),"value":value});
+        bytes += protocol::size(&item)? + 1;
+        if bytes > max_bytes {
+            return Err(request::resource());
+        }
+        output.push(item);
+    }
+    Ok(json!({"items":output,"generation":generation(connection)?}))
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/lexical.rs b/engine/src/workers/state/adapters/sqlite/retrieval/lexical.rs
new file mode 100644
index 0000000..ceb4589
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/lexical.rs
@@ -0,0 +1,112 @@
+use super::super::protocol;
+use super::{request, semantic, source};
+use rusqlite::{Connection, OptionalExtension, params};
+use serde_json::{Value, json};
+use std::collections::BTreeSet;
+
+pub fn schema(connection: &Connection) -> anyhow::Result<()> {
+    connection.execute_batch("CREATE VIRTUAL TABLE IF NOT EXISTS retrieval_lexical USING fts5(index_id UNINDEXED,epoch UNINDEXED,id UNINDEXED,text,tokenize='unicode61 tokenchars ''_''');
+        CREATE TABLE IF NOT EXISTS retrieval_lexical_links(index_id TEXT NOT NULL,epoch INTEGER NOT NULL,id TEXT NOT NULL,rowid INTEGER NOT NULL UNIQUE,PRIMARY KEY(index_id,epoch,id)) WITHOUT ROWID;")?;
+    Ok(())
+}
+
+pub fn replace(
+    connection: &Connection,
+    meta: &semantic::Meta,
+    key: &str,
+    value: Option<&Value>,
+) -> anyhow::Result<()> {
+    let rowid: Option<i64> = connection
+        .query_row(
+            "SELECT rowid FROM retrieval_lexical_links WHERE index_id=?1 AND epoch=?2 AND id=?3",
+            params![meta.index_id, meta.epoch, key],
+            |r| r.get(0),
+        )
+        .optional()?;
+    if let Some(rowid) = rowid {
+        connection.execute("DELETE FROM retrieval_lexical WHERE rowid=?1", [rowid])?;
+        connection.execute(
+            "DELETE FROM retrieval_lexical_links WHERE index_id=?1 AND epoch=?2 AND id=?3",
+            params![meta.index_id, meta.epoch, key],
+        )?;
+        connection.execute(
+            "UPDATE retrieval_semantic_meta SET lexical_count=lexical_count-1 WHERE index_id=?1",
+            [&meta.index_id],
+        )?;
+    }
+    let Some(value) = value else {
+        return Ok(());
+    };
+    let Some(text) = source::lexical_text(connection, &meta.index_id, value)? else {
+        return Ok(());
+    };
+    protocol::require(!text.trim().is_empty() && text.len() <= 1_048_576)?;
+    if source::kind(connection, &meta.index_id)?.is_none() {
+        protocol::require(text.len() <= 65_536)?;
+    }
+    connection.execute(
+        "INSERT INTO retrieval_lexical(index_id,epoch,id,text) VALUES(?1,?2,?3,?4)",
+        params![meta.index_id, meta.epoch, key, text],
+    )?;
+    let rowid = connection.last_insert_rowid();
+    connection.execute(
+        "INSERT INTO retrieval_lexical_links VALUES(?1,?2,?3,?4)",
+        params![meta.index_id, meta.epoch, key, rowid],
+    )?;
+    connection.execute(
+        "UPDATE retrieval_semantic_meta SET lexical_count=lexical_count+1 WHERE index_id=?1",
+        [&meta.index_id],
+    )?;
+    Ok(())
+}
+
+fn expression(query: &str) -> anyhow::Result<Option<String>> {
+    let terms: BTreeSet<String> = query
+        .split(|c: char| !(c.is_alphanumeric() || c == '_'))
+        .filter(|v| !v.is_empty())
+        .map(str::to_lowercase)
+        .collect();
+    if terms.len() > 32 || terms.iter().any(|v| v.len() > 256) {
+        return Err(request::resource());
+    }
+    if terms.is_empty() {
+        return Ok(None);
+    }
+    Ok(Some(
+        terms
+            .into_iter()
+            .map(|v| format!("\"{v}\""))
+            .collect::<Vec<_>>()
+            .join(" OR "),
+    ))
+}
+
+pub fn search(
+    connection: &Connection,
+    id: &str,
+    model: &str,
+    dimensions: usize,
+    generation: &str,
+    query: &str,
+    limit: usize,
+) -> anyhow::Result<Value> {
+    let meta = semantic::get(connection, id)?;
+    meta.identity(model, dimensions, generation)?;
+    meta.ready(connection)?;
+    if meta.lexical_count != meta.count {
+        return Err(protocol::error("STATE_LEXICAL_INDEX_NOT_READY"));
+    }
+    let mut output = Vec::new();
+    if let Some(expression) = expression(query)? {
+        let mut statement=connection.prepare_cached("SELECT retrieval_lexical.id,v.session_id,bm25(retrieval_lexical) FROM retrieval_lexical CROSS JOIN retrieval_vectors v ON v.index_id=retrieval_lexical.index_id AND v.epoch=retrieval_lexical.epoch AND v.id=retrieval_lexical.id WHERE retrieval_lexical MATCH ?1 AND retrieval_lexical.index_id=?2 AND retrieval_lexical.epoch=?3 ORDER BY bm25(retrieval_lexical),retrieval_lexical.id LIMIT ?4")?;
+        let mut rows = statement.query(params![expression, id, meta.epoch, limit as i64])?;
+        while let Some(row) = rows.next()? {
+            let score: f64 = row.get(2)?;
+            if !score.is_finite() {
+                return Err(protocol::error("STATE_INDEX_NOT_READY"));
+            }
+            output.push(json!({"obsId":row.get::<_,String>(0)?,"sessionId":row.get::<_,String>(1)?,"score":-score}));
+        }
+    }
+    Ok(json!({"items":output,"model":model,"dimensions":dimensions,"generation":generation}))
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/lsh.rs b/engine/src/workers/state/adapters/sqlite/retrieval/lsh.rs
new file mode 100644
index 0000000..363cff6
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/lsh.rs
@@ -0,0 +1,139 @@
+use super::super::protocol::{error, require};
+use base64::{Engine, engine::general_purpose::STANDARD};
+
+pub const TABLES: usize = 12;
+const BITS: usize = 12;
+
+pub fn decode(encoded: &str, dimensions: usize) -> anyhow::Result<Vec<f32>> {
+    let bytes = dimensions
+        .checked_mul(4)
+        .ok_or_else(|| error("STATE_TX_INVALID_REQUEST"))?;
+    require(encoded.len() == bytes.div_ceil(3) * 4)?;
+    let raw = STANDARD
+        .decode(encoded)
+        .map_err(|_| error("STATE_TX_INVALID_REQUEST"))?;
+    require(raw.len() == bytes)?;
+    let vector: Vec<f32> = raw
+        .chunks_exact(4)
+        .map(|part| f32::from_le_bytes([part[0], part[1], part[2], part[3]]))
+        .collect();
+    normalize(vector)
+}
+
+fn normalize(mut vector: Vec<f32>) -> anyhow::Result<Vec<f32>> {
+    require(vector.iter().all(|v| v.is_finite()))?;
+    let norm = vector
+        .iter()
+        .map(|v| (*v as f64).powi(2))
+        .sum::<f64>()
+        .sqrt();
+    require(norm.is_finite() && norm > 0.0)?;
+    for value in &mut vector {
+        *value = (*value as f64 / norm) as f32;
+    }
+    Ok(vector)
+}
+
+pub fn blob(vector: &[f32]) -> Vec<u8> {
+    vector
+        .iter()
+        .flat_map(|value| value.to_le_bytes())
+        .collect()
+}
+pub fn from_blob(bytes: &[u8], dimensions: usize) -> anyhow::Result<Vec<f32>> {
+    if bytes.len() != dimensions * 4 {
+        return Err(error("STATE_INDEX_NOT_READY"));
+    }
+    let vector: Vec<f32> = bytes
+        .chunks_exact(4)
+        .map(|part| f32::from_le_bytes([part[0], part[1], part[2], part[3]]))
+        .collect();
+    if !vector.iter().all(|v| v.is_finite()) {
+        return Err(error("STATE_INDEX_NOT_READY"));
+    }
+    Ok(vector)
+}
+
+pub struct Signature {
+    pub bucket: u16,
+    margins: [f64; BITS],
+}
+
+fn random(state: &mut u64) -> u64 {
+    *state ^= *state << 13;
+    *state ^= *state >> 7;
+    *state ^= *state << 17;
+    *state
+}
+
+pub fn signatures(vector: &[f32]) -> Vec<Signature> {
+    (0..TABLES)
+        .map(|table| {
+            let mut signature = Signature {
+                bucket: 0,
+                margins: [0.0; BITS],
+            };
+            for bit in 0..BITS {
+                let mut seed =
+                    0x9e37_79b9_7f4a_7c15u64.wrapping_mul((table * BITS + bit + 1) as u64);
+                let mut dot = 0.0;
+                for value in vector {
+                    dot += if random(&mut seed) & 1 == 0 {
+                        *value as f64
+                    } else {
+                        -(*value as f64)
+                    };
+                }
+                if dot >= 0.0 {
+                    signature.bucket |= 1 << bit;
+                }
+                signature.margins[bit] = dot.abs();
+            }
+            signature
+        })
+        .collect()
+}
+
+pub fn buckets(signature: &Signature, probes: usize) -> Vec<u16> {
+    let mut masks = vec![(0.0, 0u16)];
+    for a in 0..BITS {
+        masks.push((signature.margins[a], 1 << a));
+        for b in (a + 1)..BITS {
+            masks.push((
+                signature.margins[a] + signature.margins[b],
+                (1 << a) | (1 << b),
+            ));
+            for c in (b + 1)..BITS {
+                masks.push((
+                    signature.margins[a] + signature.margins[b] + signature.margins[c],
+                    (1 << a) | (1 << b) | (1 << c),
+                ));
+            }
+        }
+    }
+    masks.sort_unstable_by(|a, b| a.0.total_cmp(&b.0).then(a.1.cmp(&b.1)));
+    masks
+        .into_iter()
+        .take(probes)
+        .map(|(_, mask)| signature.bucket ^ mask)
+        .collect()
+}
+
+pub fn cosine(query: &[f32], vector: &[f32]) -> f64 {
+    let dot: f64 = query
+        .iter()
+        .zip(vector)
+        .map(|(a, b)| *a as f64 * *b as f64)
+        .sum();
+    let q = query
+        .iter()
+        .map(|v| (*v as f64).powi(2))
+        .sum::<f64>()
+        .sqrt();
+    let v = vector
+        .iter()
+        .map(|v| (*v as f64).powi(2))
+        .sum::<f64>()
+        .sqrt();
+    (dot / (q * v)).clamp(-1.0, 1.0)
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/metadata.rs b/engine/src/workers/state/adapters/sqlite/retrieval/metadata.rs
new file mode 100644
index 0000000..81974a9
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/metadata.rs
@@ -0,0 +1,90 @@
+use super::super::{database, protocol};
+use rusqlite::{Connection, OptionalExtension, params};
+
+pub struct Meta {
+    pub status: String,
+    pub cursor: i64,
+    pub revision: String,
+    pub epoch: i64,
+}
+
+pub fn graph(connection: &Connection, scope: &str) -> anyhow::Result<Meta> {
+    connection
+        .query_row(
+            "SELECT status,cursor,revision,epoch FROM retrieval_graph_meta WHERE scope=?1",
+            [scope],
+            |r| {
+                Ok(Meta {
+                    status: r.get(0)?,
+                    cursor: r.get(1)?,
+                    revision: r.get(2)?,
+                    epoch: r.get(3)?,
+                })
+            },
+        )
+        .optional()?
+        .ok_or_else(|| protocol::error("STATE_TX_INVALID_REQUEST"))
+}
+
+pub fn initialize_graph(connection: &Connection, scope: &str) -> anyhow::Result<()> {
+    let revision = database::revision(connection, scope)?.to_string();
+    let exists: bool = connection.query_row(
+        "SELECT EXISTS(SELECT 1 FROM retrieval_graph_meta WHERE scope=?1)",
+        [scope],
+        |r| r.get(0),
+    )?;
+    if !exists {
+        let populated: bool = connection.query_row("SELECT EXISTS(SELECT 1 FROM state_rows INDEXED BY state_rows_order WHERE scope=?1 AND value IS NOT NULL)", [scope], |r| r.get(0))?;
+        connection.execute(
+            "INSERT INTO retrieval_graph_meta VALUES(?1,?2,-1,?3,1)",
+            params![scope, if populated { "pending" } else { "ready" }, revision],
+        )?;
+    } else {
+        let meta = graph(connection, scope)?;
+        if meta.revision != revision {
+            rebuild_graph(connection, scope, &revision, meta.epoch)?;
+        }
+    }
+    Ok(())
+}
+
+fn next_epoch(epoch: i64) -> anyhow::Result<i64> {
+    epoch
+        .checked_add(1)
+        .ok_or_else(|| protocol::error("STATE_TX_LIMIT_EXCEEDED"))
+}
+
+pub fn rebuild_graph(
+    connection: &Connection,
+    scope: &str,
+    revision: &str,
+    epoch: i64,
+) -> anyhow::Result<i64> {
+    let epoch = next_epoch(epoch)?;
+    connection.execute("UPDATE retrieval_graph_meta SET status='pending',cursor=-1,revision=?2,epoch=?3 WHERE scope=?1", params![scope,revision,epoch])?;
+    Ok(epoch)
+}
+
+pub fn graph_write_epoch(connection: &Connection, scope: &str) -> anyhow::Result<i64> {
+    let meta = graph(connection, scope)?;
+    let revision = database::revision(connection, scope)?;
+    let epoch = if protocol::counter(&meta.revision)?.checked_add(1) == Some(revision) {
+        meta.epoch
+    } else {
+        rebuild_graph(connection, scope, &revision.to_string(), meta.epoch)?
+    };
+    connection.execute(
+        "UPDATE retrieval_graph_meta SET revision=?2 WHERE scope=?1",
+        params![scope, revision.to_string()],
+    )?;
+    Ok(epoch)
+}
+
+pub fn ready_graph(connection: &Connection, scope: &str) -> anyhow::Result<i64> {
+    let meta = graph(connection, scope)?;
+    if meta.status != "ready" || meta.revision != database::revision(connection, scope)?.to_string()
+    {
+        return Err(protocol::error("STATE_INDEX_NOT_READY"));
+    }
+    Ok(meta.epoch)
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/mod.rs b/engine/src/workers/state/adapters/sqlite/retrieval/mod.rs
new file mode 100644
index 0000000..b05c473
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/mod.rs
@@ -0,0 +1,179 @@
+mod dispatch;
+mod eligibility;
+mod graph;
+mod graph_query;
+mod lexical;
+mod lsh;
+mod metadata;
+mod prepare;
+pub(super) mod request;
+mod request_validate;
+mod semantic;
+mod semantic_meta;
+mod semantic_query;
+mod source;
+mod source_lexical;
+mod source_prepare;
+mod source_write;
+#[cfg(test)]
+mod tests;
+
+use super::{database, protocol};
+use request::Request;
+use rusqlite::{Connection, params};
+use serde_json::{Value, json};
+
+pub const CAPABILITIES: [&str; 2] = ["state::indexed_graph_v1", "state::semantic_lsh_v1"];
+
+pub fn initialize(connection: &Connection) -> anyhow::Result<()> {
+    connection.execute_batch("CREATE TEMP TABLE IF NOT EXISTS retrieval_selected(key TEXT PRIMARY KEY,position INTEGER NOT NULL,entity INTEGER NOT NULL,observation INTEGER NOT NULL) WITHOUT ROWID;
+        CREATE INDEX IF NOT EXISTS retrieval_selected_position ON retrieval_selected(position);
+        CREATE TABLE IF NOT EXISTS retrieval_graph_invalid(scope TEXT NOT NULL,epoch INTEGER NOT NULL,key TEXT NOT NULL,PRIMARY KEY(scope,epoch,key)) WITHOUT ROWID;")?;
+    graph::schema(connection)?;
+    lexical::schema(connection)?;
+    semantic::schema(connection)?;
+    source::schema(connection)?;
+    Ok(())
+}
+
+pub fn maintain(
+    connection: &Connection,
+    scope: &str,
+    key: &str,
+    value: Option<&Value>,
+    position: Option<i64>,
+) -> anyhow::Result<()> {
+    if [graph::NODES, graph::EDGES].contains(&scope) {
+        let epoch = metadata::graph_write_epoch(connection, scope)?;
+        connection.execute_batch("SAVEPOINT retrieval_graph_row;")?;
+        match graph::replace(connection, scope, key, value, position, epoch) {
+            Ok(()) => {
+                connection.execute_batch("RELEASE retrieval_graph_row;")?;
+                connection.execute(
+                    "DELETE FROM retrieval_graph_invalid WHERE scope=?1 AND epoch=?2 AND key=?3",
+                    params![scope, epoch, key],
+                )?;
+            }
+            Err(cause)
+                if cause.downcast_ref::<protocol::TxError>().is_some_and(|e| {
+                    ["STATE_TX_INVALID_REQUEST", "STATE_RETRIEVAL_RESOURCE_LIMIT"].contains(&e.0)
+                }) =>
+            {
+                connection.execute_batch(
+                    "ROLLBACK TO retrieval_graph_row; RELEASE retrieval_graph_row;",
+                )?;
+                connection.execute(
+                    "INSERT OR IGNORE INTO retrieval_graph_invalid VALUES(?1,?2,?3)",
+                    params![scope, epoch, key],
+                )?;
+                connection.execute(
+                    "UPDATE retrieval_graph_meta SET status='pending',cursor=-1 WHERE scope=?1",
+                    [scope],
+                )?;
+            }
+            Err(cause) => {
+                connection.execute_batch(
+                    "ROLLBACK TO retrieval_graph_row; RELEASE retrieval_graph_row;",
+                )?;
+                return Err(cause);
+            }
+        }
+    } else if let Some(id) = scope.strip_prefix(semantic::PREFIX) {
+        let configured: bool = connection.query_row(
+            "SELECT EXISTS(SELECT 1 FROM retrieval_semantic_meta WHERE index_id=?1)",
+            [id],
+            |r| r.get(0),
+        )?;
+        if configured {
+            semantic::maintain(connection, id, key, value)?;
+        }
+    }
+    Ok(())
+}
+
+fn status(connection: &Connection) -> anyhow::Result<Value> {
+    let mut graph_status = Vec::new();
+    for scope in [graph::NODES, graph::EDGES] {
+        let meta = metadata::graph(connection, scope)?;
+        let status = if meta.revision == database::revision(connection, scope)?.to_string() {
+            meta.status.as_str()
+        } else {
+            "pending"
+        };
+        let invalid: i64 = connection.query_row(
+            "SELECT count(*) FROM retrieval_graph_invalid WHERE scope=?1 AND epoch=?2",
+            params![scope, meta.epoch],
+            |r| r.get(0),
+        )?;
+        graph_status.push(json!({"scope":scope,"status":status,"cursor":meta.cursor.to_string(),"revision":meta.revision,"invalid_records":invalid}));
+    }
+    let mut statement =
+        connection.prepare("SELECT index_id FROM retrieval_semantic_meta ORDER BY index_id")?;
+    let ids = statement
+        .query_map([], |r| r.get::<_, String>(0))?
+        .collect::<rusqlite::Result<Vec<_>>>()?;
+    let mut semantic_status = Vec::with_capacity(ids.len());
+    for id in ids {
+        let meta = semantic::get(connection, &id)?;
+        let mut value = meta.status_value();
+        if meta.revision != database::revision(connection, &meta.scope())?.to_string() {
+            value["status"] = json!("pending");
+            value["lexical_ready"] = json!(false);
+        }
+        semantic_status.push(source::decorate(connection, &id, value)?);
+    }
+    Ok(
+        json!({"version":1,"capabilities":CAPABILITIES,"graph":graph_status,"semantic":semantic_status}),
+    )
+}
+
+pub fn read_only(request: &Request) -> bool {
+    matches!(
+        request,
+        Request::IndexStatus {}
+            | Request::GraphSeeds { .. }
+            | Request::GraphEdges { .. }
+            | Request::SemanticSearch { .. }
+            | Request::KeywordSearch { .. }
+    )
+}
+
+pub fn source_changed(
+    connection: &Connection,
+    scope: &str,
+    key: &str,
+    old: &database::Row,
+    value: Option<&Value>,
+    version: u64,
+) -> anyhow::Result<()> {
+    source_write::changed(connection, scope, key, old, value, version)
+}
+
+pub fn bounded<T>(
+    connection: &Connection,
+    job: impl FnOnce() -> anyhow::Result<T>,
+) -> anyhow::Result<T> {
+    bounded_for(connection, std::time::Duration::from_secs(45), job)
+}
+
+fn bounded_for<T>(
+    connection: &Connection,
+    budget: std::time::Duration,
+    job: impl FnOnce() -> anyhow::Result<T>,
+) -> anyhow::Result<T> {
+    let start = std::time::Instant::now();
+    connection.progress_handler(10_000, Some(move || start.elapsed() >= budget))?;
+    let result = job();
+    connection.progress_handler(0, None::<fn() -> bool>)?;
+    if start.elapsed() >= budget {
+        return Err(request::resource());
+    }
+    if let Err(cause) = &result {
+        if cause.downcast_ref::<rusqlite::Error>().is_some_and(|e| matches!(e,rusqlite::Error::SqliteFailure(code,_) if code.code==rusqlite::ErrorCode::OperationInterrupted)) {
+            return Err(request::resource());
+        }
+    }
+    result
+}
+
+pub use dispatch::execute;
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/prepare.rs b/engine/src/workers/state/adapters/sqlite/retrieval/prepare.rs
new file mode 100644
index 0000000..79a4ca7
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/prepare.rs
@@ -0,0 +1,126 @@
+use super::super::{commit, database, protocol};
+use super::{graph, metadata, semantic};
+use rusqlite::{Connection, params};
+use serde_json::{Value, json};
+
+pub fn prepare(
+    connection: &Connection,
+    scope: &str,
+    max_rows: usize,
+    max_bytes: usize,
+) -> anyhow::Result<Value> {
+    let (mut status, mut cursor, mut epoch, table, column, id) =
+        if [graph::NODES, graph::EDGES].contains(&scope) {
+            commit::read_allowed(connection, scope, "", None)?;
+            metadata::initialize_graph(connection, scope)?;
+            let meta = metadata::graph(connection, scope)?;
+            (
+                meta.status,
+                meta.cursor,
+                meta.epoch,
+                "retrieval_graph_meta",
+                "scope",
+                scope.to_owned(),
+            )
+        } else if let Some(id) = scope.strip_prefix(semantic::PREFIX) {
+            let mut meta = semantic::get(connection, id)?;
+            let revision = database::revision(connection, scope)?.to_string();
+            if meta.revision != revision {
+                semantic::rebuild(connection, &meta, &revision)?;
+                meta = semantic::get(connection, id)?;
+            }
+            (
+                meta.status,
+                meta.cursor,
+                meta.epoch,
+                "retrieval_semantic_meta",
+                "index_id",
+                id.to_owned(),
+            )
+        } else {
+            return Err(protocol::error("STATE_TX_INVALID_REQUEST"));
+        };
+    if status == "ready" {
+        return Ok(
+            json!({"scope":scope,"status":status,"cursor":cursor.to_string(),"processed":0,"revision":database::revision(connection,scope)?.to_string()}),
+        );
+    }
+    let projection = if scope == graph::NODES {
+        "json_object('id',json_extract(state_value,'$.id'),'name',json_extract(state_value,'$.name'),'stale',COALESCE(json_extract(state_value,'$.stale'),json('false')),'sourceObservationIds',json_extract(state_value,'$.sourceObservationIds'))"
+    } else if scope == graph::EDGES {
+        "json_object('id',json_extract(state_value,'$.id'),'stale',COALESCE(json_extract(state_value,'$.stale'),json('false')),'sourceNodeId',json_extract(state_value,'$.sourceNodeId'),'targetNodeId',json_extract(state_value,'$.targetNodeId'))"
+    } else {
+        "state_value"
+    };
+    let sql = format!(
+        "WITH indexed_rows AS MATERIALIZED (SELECT key,position,state_json(value,value_bytes) AS state_value FROM state_rows INDEXED BY state_rows_order WHERE scope=?1 AND value IS NOT NULL AND position>?2 ORDER BY position LIMIT ?3) SELECT key,position,{projection} FROM indexed_rows ORDER BY position"
+    );
+    let mut statement = connection.prepare(&sql)?;
+    let mut rows = statement.query(params![scope, cursor, (max_rows + 1) as i64])?;
+    let mut processed = 0usize;
+    let mut bytes = 0usize;
+    let mut complete = true;
+    while let Some(row) = rows.next()? {
+        if processed == max_rows {
+            complete = false;
+            break;
+        }
+        let raw: String = row.get(2)?;
+        if bytes.saturating_add(raw.len()) > max_bytes {
+            if processed == 0 {
+                return Err(super::request::resource());
+            }
+            complete = false;
+            break;
+        }
+        let key: String = row.get(0)?;
+        let position: i64 = row.get(1)?;
+        let mut value: Value = serde_json::from_str(&raw)?;
+        if scope == graph::NODES || scope == graph::EDGES {
+            // SQLite JSON scalar projection represents booleans as integer 0/1.
+            if let Some(stale) = value.get("stale").and_then(Value::as_i64) {
+                if stale == 0 || stale == 1 {
+                    value["stale"] = Value::Bool(stale == 1);
+                }
+            }
+            graph::replace(connection, scope, &key, Some(&value), Some(position), epoch).map_err(
+                |cause| match cause.downcast_ref::<protocol::TxError>() {
+                    Some(protocol::TxError("STATE_TX_INVALID_REQUEST")) => {
+                        protocol::error("STATE_INDEX_RECORD_INVALID")
+                    }
+                    _ => cause,
+                },
+            )?;
+            connection.execute(
+                "DELETE FROM retrieval_graph_invalid WHERE scope=?1 AND epoch=?2 AND key=?3",
+                params![scope, epoch, key],
+            )?;
+        } else {
+            let meta = semantic::get(connection, &id)?;
+            epoch = meta.epoch;
+            semantic::replace(connection, &meta, &key, Some(&value))?;
+        }
+        cursor = position;
+        processed += 1;
+        bytes += raw.len();
+    }
+    if complete {
+        if scope == graph::NODES || scope == graph::EDGES {
+            let invalid: bool = connection.query_row(
+                "SELECT EXISTS(SELECT 1 FROM retrieval_graph_invalid WHERE scope=?1 AND epoch=?2)",
+                params![scope, epoch],
+                |r| r.get(0),
+            )?;
+            if invalid {
+                return Err(protocol::error("STATE_INDEX_RECORD_INVALID"));
+            }
+        }
+        status = "ready".into();
+    }
+    let revision = database::revision(connection, scope)?.to_string();
+    let update = format!("UPDATE {table} SET status=?2,cursor=?3,revision=?4 WHERE {column}=?1");
+    connection.execute(&update, params![id, status, cursor, revision])?;
+    Ok(
+        json!({"scope":scope,"status":status,"cursor":cursor.to_string(),"processed":processed,"revision":revision}),
+    )
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/request.rs b/engine/src/workers/state/adapters/sqlite/retrieval/request.rs
new file mode 100644
index 0000000..f442056
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/request.rs
@@ -0,0 +1,172 @@
+use super::super::protocol::{error, require};
+use serde::Deserialize;
+
+pub const MAX_INPUT_ITEMS: usize = 512;
+pub const MAX_ITEMS: usize = 16_384;
+pub const MAX_BYTES: usize = 8 * 1024 * 1024;
+
+fn items() -> usize {
+    4096
+}
+fn bytes() -> usize {
+    1_048_576
+}
+fn rows() -> usize {
+    256
+}
+fn limit() -> usize {
+    50
+}
+fn probes() -> usize {
+    32
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct VectorInput {
+    pub id: String,
+    pub session_id: String,
+    pub embedding: String,
+    #[serde(default)]
+    pub text: Option<String>,
+    #[serde(default)]
+    pub source_scope: Option<String>,
+    #[serde(default)]
+    pub source_version: Option<String>,
+}
+
+#[derive(Clone, Copy, Deserialize, PartialEq)]
+#[serde(rename_all = "lowercase")]
+pub enum NameMatch {
+    Substring,
+    Exact,
+}
+impl Default for NameMatch {
+    fn default() -> Self {
+        Self::Substring
+    }
+}
+
+#[derive(Deserialize)]
+#[serde(tag = "action", rename_all = "snake_case", deny_unknown_fields)]
+pub enum Request {
+    IndexStatus {},
+    IndexPrepare {
+        scope: String,
+        #[serde(default = "rows")]
+        max_rows: usize,
+        #[serde(default = "bytes")]
+        max_bytes: usize,
+    },
+    GraphSeeds {
+        #[serde(default)]
+        entity_names: Vec<String>,
+        #[serde(default)]
+        observation_ids: Vec<String>,
+        #[serde(default)]
+        r#match: NameMatch,
+        #[serde(default = "items")]
+        max_items: usize,
+        #[serde(default = "bytes")]
+        max_bytes: usize,
+    },
+    GraphEdges {
+        node_ids: Vec<String>,
+        #[serde(default = "items")]
+        max_items: usize,
+        #[serde(default = "bytes")]
+        max_bytes: usize,
+    },
+    SemanticConfigure {
+        index_id: String,
+        model: String,
+        dimensions: usize,
+        generation: String,
+        #[serde(default)]
+        source_kind: Option<String>,
+    },
+    SourcePrepare {
+        index_id: String,
+        model: String,
+        dimensions: usize,
+        generation: String,
+        #[serde(default = "rows")]
+        max_rows: usize,
+        #[serde(default = "bytes")]
+        max_bytes: usize,
+    },
+    SemanticUpsert {
+        index_id: String,
+        model: String,
+        dimensions: usize,
+        generation: String,
+        items: Vec<VectorInput>,
+    },
+    SemanticDelete {
+        index_id: String,
+        model: String,
+        dimensions: usize,
+        generation: String,
+        ids: Vec<String>,
+    },
+    SemanticSearch {
+        index_id: String,
+        model: String,
+        dimensions: usize,
+        generation: String,
+        embedding: String,
+        #[serde(default = "limit")]
+        limit: usize,
+        #[serde(default = "items")]
+        max_candidates: usize,
+        #[serde(default = "probes")]
+        probes: usize,
+    },
+    KeywordSearch {
+        index_id: String,
+        model: String,
+        dimensions: usize,
+        generation: String,
+        query: String,
+        #[serde(default = "limit")]
+        limit: usize,
+    },
+}
+
+pub fn identifier(value: &str) -> anyhow::Result<()> {
+    require(!value.is_empty() && value.len() <= 4096)
+}
+pub fn identifiers(values: &[String], allow_empty: bool) -> anyhow::Result<()> {
+    require(values.len() <= MAX_INPUT_ITEMS)?;
+    let mut total = 0usize;
+    for value in values {
+        require((allow_empty || !value.is_empty()) && value.len() <= 4096)?;
+        total = total.saturating_add(value.len());
+    }
+    require(total <= 128 * 1024)
+}
+pub fn bounds(count: usize, size: usize) -> anyhow::Result<()> {
+    require((1..=MAX_ITEMS).contains(&count) && (1024..=MAX_BYTES).contains(&size))
+}
+pub fn identity(
+    index_id: &str,
+    model: &str,
+    dimensions: usize,
+    generation: &str,
+) -> anyhow::Result<()> {
+    require(
+        !index_id.is_empty()
+            && index_id.len() <= 128
+            && index_id
+                .bytes()
+                .all(|c| c.is_ascii_alphanumeric() || c == b'-' || c == b'_'),
+    )?;
+    require(!model.is_empty() && model.len() <= 512 && (1..=4096).contains(&dimensions))?;
+    require(!generation.is_empty() && generation.len() <= 128)
+}
+
+pub fn resource() -> anyhow::Error {
+    error("STATE_RETRIEVAL_RESOURCE_LIMIT")
+}
+
+pub use super::request_validate::parse;
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/request_validate.rs b/engine/src/workers/state/adapters/sqlite/retrieval/request_validate.rs
new file mode 100644
index 0000000..717500e
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/request_validate.rs
@@ -0,0 +1,128 @@
+use super::super::protocol::{decode, require};
+use super::request::*;
+use serde_json::Value;
+
+pub fn parse(value: Value) -> anyhow::Result<Request> {
+    let request: Request = decode(value)?;
+    match &request {
+        Request::IndexStatus {} => {}
+        Request::IndexPrepare {
+            scope,
+            max_rows,
+            max_bytes,
+        } => {
+            identifier(scope)?;
+            require((1..=1024).contains(max_rows))?;
+            bounds(*max_rows, *max_bytes)?;
+        }
+        Request::GraphSeeds {
+            entity_names,
+            observation_ids,
+            max_items,
+            max_bytes,
+            ..
+        } => {
+            identifiers(entity_names, true)?;
+            identifiers(observation_ids, false)?;
+            bounds(*max_items, *max_bytes)?;
+        }
+        Request::GraphEdges {
+            node_ids,
+            max_items,
+            max_bytes,
+        } => {
+            identifiers(node_ids, false)?;
+            bounds(*max_items, *max_bytes)?;
+        }
+        Request::SemanticConfigure {
+            index_id,
+            model,
+            dimensions,
+            generation,
+            source_kind,
+        } => {
+            identity(index_id, model, *dimensions, generation)?;
+            require(
+                source_kind
+                    .as_ref()
+                    .is_none_or(|kind| kind == "agentmemory"),
+            )?;
+        }
+        Request::SourcePrepare {
+            index_id,
+            model,
+            dimensions,
+            generation,
+            max_rows,
+            max_bytes,
+        } => {
+            identity(index_id, model, *dimensions, generation)?;
+            require((1..=1024).contains(max_rows))?;
+            bounds(*max_rows, *max_bytes)?;
+        }
+        Request::SemanticUpsert {
+            index_id,
+            model,
+            dimensions,
+            generation,
+            items,
+        } => {
+            identity(index_id, model, *dimensions, generation)?;
+            require(!items.is_empty() && items.len() <= 256)?;
+            for item in items {
+                identifier(&item.id)?;
+                identifier(&item.session_id)?;
+                if let Some(text) = &item.text {
+                    require(!text.trim().is_empty() && text.len() <= 65_536)?;
+                }
+                require(item.source_scope.is_some() == item.source_version.is_some())?;
+                if let Some(scope) = &item.source_scope {
+                    identifier(scope)?;
+                }
+                if let Some(version) = &item.source_version {
+                    super::super::protocol::counter(version)?;
+                }
+            }
+        }
+        Request::SemanticDelete {
+            index_id,
+            model,
+            dimensions,
+            generation,
+            ids,
+        } => {
+            identity(index_id, model, *dimensions, generation)?;
+            identifiers(ids, false)?;
+            require(!ids.is_empty() && ids.len() <= 256)?;
+        }
+        Request::SemanticSearch {
+            index_id,
+            model,
+            dimensions,
+            generation,
+            limit,
+            max_candidates,
+            probes,
+            ..
+        } => {
+            identity(index_id, model, *dimensions, generation)?;
+            require(
+                (1..=100).contains(limit)
+                    && (*limit..=MAX_ITEMS).contains(max_candidates)
+                    && (1..=256).contains(probes),
+            )?;
+        }
+        Request::KeywordSearch {
+            index_id,
+            model,
+            dimensions,
+            generation,
+            query,
+            limit,
+        } => {
+            identity(index_id, model, *dimensions, generation)?;
+            require(query.len() <= 4096 && (1..=100).contains(limit))?;
+        }
+    }
+    Ok(request)
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/semantic.rs b/engine/src/workers/state/adapters/sqlite/retrieval/semantic.rs
new file mode 100644
index 0000000..1d5709b
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/semantic.rs
@@ -0,0 +1,221 @@
+use super::super::{database, protocol};
+use super::{lexical, lsh, request, source};
+use rusqlite::{Connection, params};
+use serde_json::{Value, json};
+
+pub const PREFIX: &str = "mem:semantic:";
+pub fn rebuild(connection: &Connection, meta: &Meta, revision: &str) -> anyhow::Result<()> {
+    let epoch = meta
+        .epoch
+        .checked_add(1)
+        .ok_or_else(|| protocol::error("STATE_TX_LIMIT_EXCEEDED"))?;
+    connection.execute("UPDATE retrieval_semantic_meta SET status='pending',cursor=-1,revision=?2,epoch=?3,count=0,lexical_count=0 WHERE index_id=?1", params![meta.index_id,revision,epoch])?;
+    Ok(())
+}
+
+pub fn schema(connection: &Connection) -> anyhow::Result<()> {
+    connection.execute_batch("CREATE TABLE IF NOT EXISTS retrieval_semantic_meta(index_id TEXT PRIMARY KEY,model TEXT NOT NULL,dimensions INTEGER NOT NULL,generation TEXT NOT NULL,status TEXT NOT NULL,cursor INTEGER NOT NULL,revision TEXT NOT NULL,epoch INTEGER NOT NULL,count INTEGER NOT NULL,lexical_count INTEGER NOT NULL) WITHOUT ROWID;
+        CREATE TABLE IF NOT EXISTS retrieval_vectors(index_id TEXT NOT NULL,epoch INTEGER NOT NULL,id TEXT NOT NULL,session_id TEXT NOT NULL,embedding BLOB NOT NULL,PRIMARY KEY(index_id,epoch,id)) WITHOUT ROWID;
+        CREATE TABLE IF NOT EXISTS retrieval_vector_postings(index_id TEXT NOT NULL,epoch INTEGER NOT NULL,table_id INTEGER NOT NULL,bucket INTEGER NOT NULL,id TEXT NOT NULL,PRIMARY KEY(index_id,epoch,table_id,bucket,id)) WITHOUT ROWID;
+        CREATE INDEX IF NOT EXISTS retrieval_vector_postings_id ON retrieval_vector_postings(index_id,epoch,id);")?;
+    let mut statement = connection.prepare("SELECT index_id FROM retrieval_semantic_meta")?;
+    let ids = statement
+        .query_map([], |r| r.get::<_, String>(0))?
+        .collect::<rusqlite::Result<Vec<_>>>()?;
+    for id in ids {
+        let meta = get(connection, &id)?;
+        let revision = database::revision(connection, &meta.scope())?.to_string();
+        if meta.revision != revision {
+            rebuild(connection, &meta, &revision)?;
+        }
+    }
+    Ok(())
+}
+
+pub fn configure(
+    connection: &Connection,
+    id: &str,
+    model: &str,
+    dimensions: usize,
+    generation: &str,
+    source_kind: Option<&str>,
+) -> anyhow::Result<Value> {
+    let exists: bool = connection.query_row(
+        "SELECT EXISTS(SELECT 1 FROM retrieval_semantic_meta WHERE index_id=?1)",
+        [id],
+        |r| r.get(0),
+    )?;
+    if exists {
+        let meta = get(connection, id)?;
+        meta.identity(model, dimensions, generation)?;
+        source::configure(connection, id, source_kind, true)?;
+        return source::decorate(connection, id, meta.status_value());
+    }
+    let count: i64 =
+        connection.query_row("SELECT count(*) FROM retrieval_semantic_meta", [], |r| {
+            r.get(0)
+        })?;
+    if count >= 128 {
+        return Err(request::resource());
+    }
+    let scope = format!("{PREFIX}{id}");
+    let populated: bool = connection.query_row("SELECT EXISTS(SELECT 1 FROM state_rows INDEXED BY state_rows_order WHERE scope=?1 AND value IS NOT NULL)", [&scope], |r| r.get(0))?;
+    let revision = database::revision(connection, &scope)?.to_string();
+    connection.execute(
+        "INSERT INTO retrieval_semantic_meta VALUES(?1,?2,?3,?4,?5,-1,?6,1,0,0)",
+        params![
+            id,
+            model,
+            dimensions as i64,
+            generation,
+            if populated { "pending" } else { "ready" },
+            revision
+        ],
+    )?;
+    source::configure(connection, id, source_kind, false)?;
+    source::decorate(connection, id, get(connection, id)?.status_value())
+}
+
+pub fn replace(
+    connection: &Connection,
+    meta: &Meta,
+    key: &str,
+    value: Option<&Value>,
+) -> anyhow::Result<()> {
+    if let Some(value) = value {
+        source::validate(connection, &meta.index_id, key, value)?;
+    } else {
+        source::embedding_deleted(connection, &meta.index_id, key)?;
+    }
+    lexical::replace(connection, meta, key, value)?;
+    let exists: bool = connection.query_row(
+        "SELECT EXISTS(SELECT 1 FROM retrieval_vectors WHERE index_id=?1 AND epoch=?2 AND id=?3)",
+        params![meta.index_id, meta.epoch, key],
+        |r| r.get(0),
+    )?;
+    connection.execute(
+        "DELETE FROM retrieval_vector_postings WHERE index_id=?1 AND epoch=?2 AND id=?3",
+        params![meta.index_id, meta.epoch, key],
+    )?;
+    connection.execute(
+        "DELETE FROM retrieval_vectors WHERE index_id=?1 AND epoch=?2 AND id=?3",
+        params![meta.index_id, meta.epoch, key],
+    )?;
+    if exists {
+        connection.execute(
+            "UPDATE retrieval_semantic_meta SET count=count-1 WHERE index_id=?1",
+            [&meta.index_id],
+        )?;
+    }
+    let Some(value) = value else {
+        return Ok(());
+    };
+    protocol::require(value.is_object() && value["id"].as_str() == Some(key))?;
+    let model = value["model"]
+        .as_str()
+        .ok_or_else(|| protocol::error("STATE_TX_INVALID_REQUEST"))?;
+    let dimensions = value["dimensions"]
+        .as_u64()
+        .ok_or_else(|| protocol::error("STATE_TX_INVALID_REQUEST"))?;
+    let generation = value["generation"]
+        .as_str()
+        .ok_or_else(|| protocol::error("STATE_TX_INVALID_REQUEST"))?;
+    meta.identity(model, dimensions as usize, generation)?;
+    let session = value["sessionId"]
+        .as_str()
+        .ok_or_else(|| protocol::error("STATE_TX_INVALID_REQUEST"))?;
+    request::identifier(session)?;
+    request::identifier(key)?;
+    let encoded = value["embedding"]
+        .as_str()
+        .ok_or_else(|| protocol::error("STATE_TX_INVALID_REQUEST"))?;
+    let vector = lsh::decode(encoded, meta.dimensions)?;
+    connection.execute(
+        "INSERT INTO retrieval_vectors VALUES(?1,?2,?3,?4,?5)",
+        params![meta.index_id, meta.epoch, key, session, lsh::blob(&vector)],
+    )?;
+    let mut insert = connection
+        .prepare_cached("INSERT INTO retrieval_vector_postings VALUES(?1,?2,?3,?4,?5)")?;
+    for (table, signature) in lsh::signatures(&vector).iter().enumerate() {
+        insert.execute(params![
+            meta.index_id,
+            meta.epoch,
+            table as i64,
+            signature.bucket,
+            key
+        ])?;
+    }
+    connection.execute(
+        "UPDATE retrieval_semantic_meta SET count=count+1 WHERE index_id=?1",
+        [&meta.index_id],
+    )?;
+    Ok(())
+}
+
+pub fn maintain(
+    connection: &Connection,
+    id: &str,
+    key: &str,
+    value: Option<&Value>,
+) -> anyhow::Result<()> {
+    let mut meta = get(connection, id)?;
+    let revision = database::revision(connection, &meta.scope())?;
+    if protocol::counter(&meta.revision)?.checked_add(1) != Some(revision) {
+        rebuild(connection, &meta, &revision.to_string())?;
+        meta = get(connection, id)?;
+    }
+    replace(connection, &meta, key, value)?;
+    connection.execute(
+        "UPDATE retrieval_semantic_meta SET revision=?2 WHERE index_id=?1",
+        params![id, revision.to_string()],
+    )?;
+    Ok(())
+}
+
+pub fn upsert(
+    connection: &Connection,
+    id: &str,
+    model: &str,
+    dimensions: usize,
+    generation: &str,
+    items: Vec<request::VectorInput>,
+) -> anyhow::Result<Value> {
+    let meta = get(connection, id)?;
+    meta.identity(model, dimensions, generation)?;
+    let mut ids = std::collections::HashSet::new();
+    for item in &items {
+        protocol::require(ids.insert(&item.id))?;
+    }
+    for item in &items {
+        let mut value = json!({"id":item.id,"sessionId":item.session_id,"embedding":item.embedding,"model":model,"dimensions":dimensions,"generation":generation});
+        if let Some(text) = &item.text {
+            value["text"] = json!(text);
+        }
+        if let Some(scope) = &item.source_scope {
+            value["sourceScope"] = json!(scope);
+        }
+        if let Some(version) = &item.source_version {
+            value["sourceVersion"] = json!(version);
+        }
+        database::write(connection, &meta.scope(), &item.id, Some(&value))?;
+    }
+    Ok(json!({"updated":items.len(),"generation":generation}))
+}
+
+pub fn delete(
+    connection: &Connection,
+    id: &str,
+    model: &str,
+    dimensions: usize,
+    generation: &str,
+    ids: &[String],
+) -> anyhow::Result<Value> {
+    let meta = get(connection, id)?;
+    meta.identity(model, dimensions, generation)?;
+    for key in ids {
+        database::write(connection, &meta.scope(), key, None)?;
+    }
+    Ok(json!({"deleted":ids.len(),"generation":generation}))
+}
+
+pub use super::semantic_meta::{Meta, get};
