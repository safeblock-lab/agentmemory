+use super::*;
+use super::super::super::{SqliteAdapter, StateAdapter};
+use rusqlite::{params, Connection};
+use std::{
+    fs,
+    path::PathBuf,
+    sync::{
+        atomic::{AtomicU64, Ordering},
+        Arc,
+    },
+    time::Instant,
+};
+
+const ROWS: usize = 4096;
+const BATCH_ROWS: usize = 64;
+const BATCH_BYTES: usize = 8 * 1024 * 1024;
+
+fn replace_vm_steps(connection: &Connection, key: &str, value: &Value, position: i64) -> u64 {
+    let steps = Arc::new(AtomicU64::new(0));
+    let callback_steps = Arc::clone(&steps);
+    connection
+        .progress_handler(1, Some(move || {
+            callback_steps.fetch_add(1, Ordering::Relaxed);
+            false
+        }))
+        .unwrap();
+    graph::replace(connection, graph::NODES, key, Some(value), Some(position), 1).unwrap();
+    connection
+        .progress_handler(0, None::<fn() -> bool>)
+        .unwrap();
+    steps.load(Ordering::Relaxed)
+}
