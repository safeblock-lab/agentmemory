+use super::*;
+use rusqlite::types::Value as SqlValue;
+use sha2::{Digest, Sha256};
+
+const MAX_BATCH_WINDOWS: usize = 36;
+const MAX_BATCH_ROWS: usize = 1024;
+const MAX_BATCH_ID_BYTES: usize = 4 * 1024 * 1024;
+const MAX_IDENTIFIER_BYTES: usize = 4096;
+const MAX_VECTOR_BATCH_BYTES: usize = 8 * 1024 * 1024;
+const SQLITE_BIND_LIMIT: usize = 999;
+pub(super) const SMALL_PROJECT_MAX_ID_BYTES: usize = 256 * 1024;
+pub(super) const SMALL_PROJECT_MAX_CANDIDATES: usize = 64;
+pub fn terms(
+    index: &str,
+    epoch: i64,
+    project: i64,
+    generation: i64,
+    kind: i64,
+    session: i64,
+) -> (String, String) {
+    let project = format!(
+        "i{}e{epoch}p{project}g{generation}k{kind}",
+        hex::encode(Sha256::digest(index.as_bytes()))
+    );
+    let session = format!("{project}s{session}");
+    (project, session)
+}
+#[cfg(test)]
+pub fn statement(session: bool) -> String {
+    let authority = project_catalog::session_project_predicate(
+        "scoped_session.name",
+        "?10",
+    );
+    format!(
+        "WITH prefix AS MATERIALIZED (SELECT id,session,kind,generation FROM retrieval_scoped_postings WHERE index_id=?1 AND epoch=?2 AND project=?3 AND project_generation=?4 AND kind=?5 AND table_id=?6 AND bucket=?7 {} AND EXISTS(SELECT 1 FROM retrieval_scoped_sessions scoped_session WHERE scoped_session.token=retrieval_scoped_postings.session AND (retrieval_scoped_postings.kind=2 OR {authority})) ORDER BY session,id LIMIT ?9) SELECT p.id,s.name,v.embedding,p.kind,s.name,p.generation,s.generation,si.version,si.dirty FROM prefix p LEFT JOIN retrieval_scoped_sessions s ON s.token=p.session LEFT JOIN retrieval_vectors v ON v.index_id=?1 AND v.epoch=?2 AND v.id=p.id LEFT JOIN retrieval_source_items si ON si.index_id=?1 AND si.key=p.id AND si.scope=CASE p.kind WHEN 0 THEN 'mem:obs:'||s.name WHEN 1 THEN 'mem:memories' ELSE '' END",
+        if session {
+            "AND session=?8"
+        } else {
+            "AND ?8 IS NULL"
+        },
+        authority=authority
+    )
+}
+pub(super) fn batch_window_count(bucket_limit: usize) -> usize {
+    let rows_per_window = bucket_limit.saturating_add(1).max(1);
+    let id_bytes_per_window = rows_per_window.saturating_mul(MAX_IDENTIFIER_BYTES);
+    let max_rows_per_query = MAX_BATCH_ROWS.min(MAX_BATCH_ID_BYTES / MAX_IDENTIFIER_BYTES);
+    if rows_per_window > max_rows_per_query {
+        return 1;
+    }
+    let by_rows = (MAX_BATCH_ROWS / rows_per_window).max(1);
+    let by_id_bytes = (MAX_BATCH_ID_BYTES / id_bytes_per_window.max(1)).max(1);
+    MAX_BATCH_WINDOWS.min(by_rows).min(by_id_bytes)
+}
+
+pub(super) fn batch_page_size(bucket_limit: usize) -> usize {
+    bucket_limit
+        .saturating_add(1)
+        .max(1)
+        .min(MAX_BATCH_ROWS)
+        .min(MAX_BATCH_ID_BYTES / MAX_IDENTIFIER_BYTES)
+}
+
+pub(super) fn batch_statement(session: bool, windows: usize) -> String {
+    let session_filter = if session {
+        "AND session=?5"
+    } else {
+        "AND ?5 IS NULL"
+    };
+    let authority = project_catalog::session_project_predicate("authority_session.name", "?6");
+    let mut branches = Vec::with_capacity(windows);
+    for window in 0..windows {
+        let kind = 10 + window * 3;
+        let table = kind + 1;
+        let bucket = kind + 2;
+        branches.push(format!(
+            "SELECT {window} AS window_order,p.id,p.session,p.kind,p.generation FROM (SELECT candidate.id,candidate.session,candidate.kind,candidate.generation FROM retrieval_scoped_postings candidate JOIN retrieval_scoped_sessions authority_session ON authority_session.token=candidate.session JOIN retrieval_vectors authority_vector ON authority_vector.index_id=?1 AND authority_vector.epoch=?2 AND authority_vector.id=candidate.id LEFT JOIN retrieval_source_items authority_source ON authority_source.index_id=candidate.index_id AND authority_source.key=candidate.id AND authority_source.scope=CASE candidate.kind WHEN 0 THEN 'mem:obs:'||authority_session.name WHEN 1 THEN 'mem:memories' ELSE '' END LEFT JOIN state_rows authority_current ON authority_current.scope=CASE candidate.kind WHEN 0 THEN 'mem:obs:'||authority_session.name WHEN 1 THEN 'mem:memories' ELSE '' END AND authority_current.key=candidate.id WHERE candidate.index_id=?1 AND candidate.epoch=?2 AND candidate.project=?3 AND candidate.project_generation=?4 AND candidate.kind=?{kind} AND candidate.table_id=?{table} AND candidate.bucket=?{bucket} {session_filter} AND candidate.generation=authority_session.generation AND (candidate.kind=2 OR (authority_source.version=authority_current.version AND authority_source.dirty=0 AND authority_current.value IS NOT NULL)) AND (candidate.kind=2 OR {authority}) AND (?8 IS NULL OR candidate.session>?8 OR (candidate.session=?8 AND candidate.id>?9)) ORDER BY candidate.session,candidate.id LIMIT ?7) p"
+        ));
+    }
+    format!(
+        "WITH prefix AS MATERIALIZED ({}) SELECT p.window_order,p.id,p.session,p.kind,p.generation,s.name,s.generation,si.version,si.dirty,v.id IS NOT NULL FROM prefix p LEFT JOIN retrieval_scoped_sessions s ON s.token=p.session LEFT JOIN retrieval_vectors v ON v.index_id=?1 AND v.epoch=?2 AND v.id=p.id LEFT JOIN retrieval_source_items si ON si.index_id=?1 AND si.key=p.id AND si.scope=CASE p.kind WHEN 0 THEN 'mem:obs:'||s.name WHEN 1 THEN 'mem:memories' ELSE '' END ORDER BY p.window_order,p.session,p.id",
+        branches.join(" UNION ALL ")
+    )
+}
+
+pub(super) fn batch_params(
+    index: &str,
+    epoch: i64,
+    project: i64,
+    session: Option<i64>,
+    project_name: &str,
+    page_size: usize,
+    after: Option<(i64, &str)>,
+    selectors: &[(i64, i64, Option<u16>)],
+    windows: usize,
+) -> Vec<SqlValue> {
+    let mut values = Vec::with_capacity(9 + windows * 3);
+    values.extend([
+        SqlValue::Text(index.to_owned()),
+        SqlValue::Integer(epoch),
+        SqlValue::Integer(project),
+        SqlValue::Integer(1),
+        session.map_or(SqlValue::Null, SqlValue::Integer),
+        SqlValue::Text(project_name.to_owned()),
+        SqlValue::Integer(page_size as i64),
+        after.map_or(SqlValue::Null, |(session, _)| SqlValue::Integer(session)),
+        after.map_or(SqlValue::Null, |(_, id)| SqlValue::Text(id.to_owned())),
+    ]);
+    for slot in 0..windows {
+        if let Some((kind, table, bucket)) = selectors.get(slot) {
+            values.extend([
+                SqlValue::Integer(*kind),
+                SqlValue::Integer(*table),
+                bucket.map_or(SqlValue::Null, |value| SqlValue::Integer(i64::from(value))),
+            ]);
+        } else {
+            values.extend([SqlValue::Null, SqlValue::Null, SqlValue::Null]);
+        }
+    }
+    values
+}
+
+pub(super) fn small_project_statement(kind: i64, session: bool) -> String {
+    let session_filter = if session {
+        "AND p.session=?6"
+    } else {
+        "AND ?6 IS NULL"
+    };
+    let source_scope = match kind {
+        0 => "'mem:obs:'||s.name",
+        1 => "'mem:memories'",
+        _ => "''",
+    };
+    let current_source = if kind == 2 {
+        "1"
+    } else {
+        "si.version=current.version AND si.dirty=0 AND current.value IS NOT NULL"
+    };
+    let authority = project_catalog::session_project_predicate(
+        "s.name",
+        "(SELECT name FROM retrieval_scoped_projects WHERE token=?3)",
+    );
+    format!(
+        "SELECT CASE WHEN length(CAST(p.id AS BLOB))<=?9 THEN p.id ELSE '' END,p.session,p.generation,s.name,s.generation,si.version,si.dirty,current.version,current.value IS NOT NULL,v.id IS NOT NULL,length(CAST(p.id AS BLOB))>?9 FROM retrieval_scoped_postings p JOIN retrieval_scoped_sessions s ON s.token=p.session LEFT JOIN retrieval_source_items si ON si.index_id=?1 AND si.key=p.id AND si.scope={source_scope} LEFT JOIN state_rows current ON current.scope={source_scope} AND current.key=p.id LEFT JOIN retrieval_vectors v ON v.index_id=?1 AND v.epoch=?2 AND v.id=p.id WHERE p.index_id=?1 AND p.epoch=?2 AND p.project=?3 AND p.project_generation=?4 AND p.kind=?5 AND p.table_id=0 {session_filter} AND p.project_generation=1 AND p.generation=s.generation AND v.id IS NOT NULL AND ({current_source}) AND (p.kind=2 OR {authority}) ORDER BY p.bucket,p.session,p.id LIMIT ?8"
+    )
+}
+
+pub(super) fn small_project_params(
+    index: &str,
+    epoch: i64,
+    project: i64,
+    kind: i64,
+    session: Option<i64>,
+    _project_name: &str,
+    limit: usize,
+    id_budget: usize,
+) -> Vec<SqlValue> {
+    let id_limit = (id_budget / limit.max(1)).min(MAX_IDENTIFIER_BYTES);
+    vec![
+        SqlValue::Text(index.to_owned()),
+        SqlValue::Integer(epoch),
+        SqlValue::Integer(project),
+        SqlValue::Integer(1),
+        SqlValue::Integer(kind),
+        session.map_or(SqlValue::Null, SqlValue::Integer),
+        SqlValue::Integer(1),
+        SqlValue::Integer(limit as i64),
+        SqlValue::Integer(id_limit as i64),
+    ]
+}
+
+pub(super) fn vector_batch_size(dimensions: usize) -> usize {
+    let bytes_per_vector = dimensions.saturating_mul(4).max(1);
+    (MAX_VECTOR_BATCH_BYTES / bytes_per_vector)
+        .max(1)
+        .min(SQLITE_BIND_LIMIT - 2)
+}
+
+pub(super) fn vector_statement(items: usize) -> String {
+    let ids = (3..3 + items)
+        .map(|parameter| format!("?{parameter}"))
+        .collect::<Vec<_>>()
+        .join(",");
+    format!(
+        "SELECT id,embedding FROM retrieval_vectors WHERE index_id=?1 AND epoch=?2 AND id IN ({ids})"
+    )
+}
+
+pub(super) fn vector_params(
+    index: &str,
+    epoch: i64,
+    ids: &[String],
+    items: usize,
+) -> Vec<SqlValue> {
+    let mut values = Vec::with_capacity(items + 2);
+    values.extend([SqlValue::Text(index.to_owned()), SqlValue::Integer(epoch)]);
+    values.extend(ids.iter().take(items).cloned().map(SqlValue::Text));
+    values.resize(items + 2, SqlValue::Null);
+    values
+}
+pub(super) fn kinds(
+    c: &Connection,
+    index: &str,
+    options: super::super::search_projection::Options<'_>,
+) -> anyhow::Result<Vec<i64>> {
+    Ok(
+        if options.source_kind.is_some() || options.source_scope.is_some() {
+            vec![0]
+        } else if source::kind(c, index)?.is_some() {
+            vec![0, 1]
+        } else {
+            vec![2]
+        },
+    )
+}
+pub(super) fn available(
+    c: &Connection,
+    meta: &semantic::Meta,
+    options: super::super::search_projection::Options<'_>,
+) -> anyhow::Result<Availability> {
+    if ready(
+        c,
+        &meta.index_id,
+        meta.epoch,
+        options.project.unwrap(),
+        options.source_kind == Some("observation") || options.source_scope.is_some(),
+    )? {
+        return Ok(Availability {
+            usable: true,
+            partial_reason: None,
+        });
+    }
+    let Some(project) = project_token(c, options.project.unwrap())? else {
+        return Ok(Availability::unavailable());
+    };
+    let generation = generation(c, project)?;
+    let sessions_epoch: i64 = c.query_row(
+        "SELECT epoch FROM retrieval_project_catalog WHERE source='sessions'",
+        [],
+        |row| row.get(0),
+    )?;
+    let summaries_epoch: i64 = c.query_row(
+        "SELECT epoch FROM retrieval_project_catalog WHERE source='summaries'",
+        [],
+        |row| row.get(0),
+    )?;
+    let mut families = kinds(c, &meta.index_id, options)?;
+    families.sort_unstable();
+    families.dedup();
+    let mut has_current_coverage = false;
+    let mut missing_family = false;
+    let mut incomplete_coverage = false;
+    for family in families {
+        let coverage_kind = if family == 0 { 0 } else { 3 };
+        let coverage: Option<(String, i64)> = c
+            .query_row(
+                "SELECT status,source FROM retrieval_scoped_coverage WHERE index_id=?1 AND epoch=?2 AND project=?3 AND generation=?4 AND kind=?5 AND sessions_epoch=?6 AND summaries_epoch=?7 AND status IN ('pending','partial','ready')",
+                params![meta.index_id, meta.epoch, project, generation, coverage_kind, sessions_epoch, summaries_epoch],
+                |row| Ok((row.get(0)?, row.get(1)?)),
+            )
+            .optional()?;
+        if let Some((status, source)) = coverage {
+            has_current_coverage = true;
+            incomplete_coverage |= status != "ready" || source < 2;
+        } else {
+            missing_family = true;
+        }
+    }
+    if !has_current_coverage {
+        return Ok(Availability::unavailable());
+    }
+    let partial_reason = if project_catalog::has_incomplete_authority(c)? {
+        "catalog_not_ready"
+    } else if !super::super::project_vectors::ready(c, &meta.index_id, meta.epoch)? {
+        "project_mapping_not_ready"
+    } else if source::status(c, &meta.index_id)?["coverage_ready"] != true {
+        "project_source_not_ready"
+    } else if missing_family
+        || incomplete_coverage
+        || pending::has(c, &meta.index_id, project, 0)?
+        || pending::has(c, &meta.index_id, project, 3)?
+    {
+        "project_projection_pending"
+    } else {
+        "project_projection_pending"
+    };
+    Ok(Availability {
+        usable: true,
+        partial_reason: Some(partial_reason),
+    })
+}
+pub(super) struct Availability {
+    pub usable: bool,
+    pub partial_reason: Option<&'static str>,
+}
+impl Availability {
+    fn unavailable() -> Self {
+        Self {
+            usable: false,
+            partial_reason: Some("project_index_not_ready"),
+        }
+    }
+}
+pub(super) fn partial(meta: &semantic::Meta, reason: &str) -> Value {
+    json!({"items":[],"approximate":true,"candidates":0,"budget_exhausted":reason=="query_work_budget","status":"partial","reason":reason,"model":meta.model,"dimensions":meta.dimensions,"generation":meta.generation})
+}
+pub(super) fn guarded(
+    c: &Connection,
+    meta: &semantic::Meta,
+    job: impl FnOnce() -> anyhow::Result<Value>,
+) -> anyhow::Result<Value> {
+    match super::super::bounded_for(c, std::time::Duration::from_millis(250), job) {
+        Err(cause)
+            if cause
+                .downcast_ref::<protocol::TxError>()
+                .is_some_and(|e| e.0 == "STATE_RETRIEVAL_RESOURCE_LIMIT") =>
+        {
+            Ok(partial(meta, "query_work_budget"))
+        }
+        result => result,
+    }
+}
+pub(super) fn rank(a: &Value, b: &Value) -> std::cmp::Ordering {
+    b["score"]
+        .as_f64()
+        .unwrap()
