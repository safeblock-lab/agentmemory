+use super::super::protocol::{decode, require};
+use super::request::*;
+use serde_json::Value;
+
+pub fn parse(value: Value) -> anyhow::Result<Request> {
+    let request: Request = if value.get("action").and_then(Value::as_str) == Some("canonical_apply")
+    {
+        let mut fields = value
+            .as_object()
+            .cloned()
+            .ok_or_else(|| super::super::protocol::error("STATE_TX_INVALID_REQUEST"))?;
+        fields.remove("action");
+        Request::CanonicalApply {
+            input: decode(Value::Object(fields))?,
+        }
+    } else {
+        decode(value)?
+    };
+    match &request {
+        Request::PreparationStatus {target,index_id,project,source_kind} => {
+            require(["viewer_recent","project_vector"].contains(&target.as_str()))?;
+            if target == "viewer_recent" {
+                require(index_id.is_none() && project.is_none() && source_kind.is_none())?;
+            } else {
+                let index=index_id.as_deref().ok_or_else(|| super::super::protocol::error("STATE_TX_INVALID_REQUEST"))?;
+                identity(index,"index",1,"generation")?;
