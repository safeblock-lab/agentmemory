+    pub async fn list_page(
+        &self,
+        scope: &str,
+        cursor: Option<&str>,
+        limit: usize,
+        max_bytes: usize,
+    ) -> Result<StateListPageResult, StatePageError> {
+        let decoded_cursor = cursor.map(decode_state_page_cursor).transpose()?;
+        let scope_fingerprint = state_page_scope_fingerprint(scope);
+        if let Some(decoded_cursor) = &decoded_cursor
+            && decoded_cursor.scope_fingerprint != scope_fingerprint
+        {
+            return Err(StatePageError::InvalidCursor);
+        }
+
+        let store = self.store.read().await;
+        let revisions = self.scope_revisions.read().await;
+        let generation = self.cursor_generation.read().await;
+        let revision = revisions.get(scope).copied().unwrap_or_default();
+
+        let start_offset = if let Some(decoded_cursor) = &decoded_cursor {
+            if decoded_cursor.generation != *generation || decoded_cursor.revision != revision {
+                return Err(StatePageError::StaleCursor);
+            }
+            usize::try_from(decoded_cursor.next_offset)
+                .map_err(|_| StatePageError::InvalidCursor)?
+        } else {
+            0
+        };
+
+        let values = store.get(scope);
+        let value_count = values.map_or(0, IndexMap::len);
+        if start_offset > value_count {
+            return Err(StatePageError::InvalidCursor);
+        }
+
+        let empty_page_bytes = serialized_json_len(&StateListPageResult {
+            items: Vec::new(),
+            next_cursor: None,
+        })?;
+        let mut items = Vec::with_capacity(limit.min(value_count.saturating_sub(start_offset)));
+        let mut items_bytes = 0usize;
+        let mut next_cursor = None;
+        let stop_offset = start_offset.saturating_add(limit).min(value_count);
+
+        for absolute_offset in start_offset..stop_offset {
+            let value = values
+                .and_then(|values| values.get_index(absolute_offset))
+                .map(|(_, value)| value)
+                .ok_or(StatePageError::Internal)?;
+            let value_bytes = serialized_json_len(value)?;
+            let candidate_count = items.len() + 1;
+            let candidate_offset = absolute_offset + 1;
+            let candidate_cursor = if candidate_offset < value_count {
+                Some(encode_state_page_cursor(&StatePageCursor {
+                    version: STATE_PAGE_CURSOR_VERSION,
+                    generation: *generation,
+                    scope_fingerprint: scope_fingerprint.clone(),
+                    revision,
+                    next_offset: u64::try_from(candidate_offset)
+                        .map_err(|_| StatePageError::Internal)?,
+                })?)
+            } else {
+                None
+            };
+            let cursor_json_bytes = serialized_json_len(&candidate_cursor)?;
+            let candidate_items_bytes = items_bytes
+                .saturating_add(value_bytes)
+                .saturating_add(if candidate_count > 1 { 1 } else { 0 });
+            let candidate_page_bytes = empty_page_bytes
+                .saturating_add(candidate_items_bytes)
+                .saturating_add(cursor_json_bytes.saturating_sub(4));
+
+            if candidate_page_bytes > max_bytes {
+                if items.is_empty() {
+                    return Err(StatePageError::RecordTooLarge {
+                        required_bytes: candidate_page_bytes,
+                    });
+                }
+                break;
+            }
+
+            items.push(value.clone());
+            items_bytes = candidate_items_bytes;
+            next_cursor = candidate_cursor;
+        }
+
+        Ok(StateListPageResult { items, next_cursor })
+    }
