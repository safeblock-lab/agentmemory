@@ -0,0 +1,72 @@
+use super::sqlite_tables::Table;
+use crate::workers::state::adapters::sqlite::database;
+use anyhow::{Context, ensure};
+use rusqlite::types::Value;
+use serde::{Deserialize, Serialize};
+
+#[derive(Serialize, Deserialize)]
+enum CursorValue {
+    Null,
+    Integer(i64),
+    Real(f64),
+    Text(String),
+    Blob(Vec<u8>),
+}
+
+pub(super) fn cursor(values: &[Value]) -> anyhow::Result<String> {
+    let values: Vec<_> = values
+        .iter()
+        .map(|v| match v {
+            Value::Null => CursorValue::Null,
+            Value::Integer(v) => CursorValue::Integer(*v),
+            Value::Real(v) => CursorValue::Real(*v),
+            Value::Text(v) => CursorValue::Text(v.clone()),
+            Value::Blob(v) => CursorValue::Blob(v.clone()),
+        })
+        .collect();
+    Ok(serde_json::to_string(&values)?)
+}
+
+pub(super) fn parse_cursor(value: &str) -> anyhow::Result<Vec<Value>> {
+    Ok(serde_json::from_str::<Vec<CursorValue>>(value)?
+        .into_iter()
+        .map(|v| match v {
+            CursorValue::Null => Value::Null,
+            CursorValue::Integer(v) => Value::Integer(v),
+            CursorValue::Real(v) => Value::Real(v),
+            CursorValue::Text(v) => Value::Text(v),
+            CursorValue::Blob(v) => Value::Blob(v),
+        })
+        .collect())
+}
+
+pub(super) fn quote(name: &str) -> String {
+    format!("\"{}\"", name.replace('"', "\"\""))
+}
+
+pub(super) fn logical_row(
+    table: &Table,
+    mut row: Vec<Value>,
+    v2: bool,
+) -> anyhow::Result<Vec<Value>> {
+    if table.name == "state_rows" && row[2] != Value::Null {
+        let bytes = match row[5] {
+            Value::Integer(v) => v,
+            _ => anyhow::bail!("Invalid logical value_bytes"),
+        };
+        let value = match &row[2] {
+            Value::Text(value) if !v2 => {
+                ensure!(
+                    i64::try_from(value.len())? == bytes,
+                    "V1 value_bytes mismatch"
+                );
+                value.clone()
+            }
+            Value::Blob(value) if v2 => database::decode_value(value, bytes)?,
+            _ => anyhow::bail!("Unexpected state value storage type"),
+        };
+        let _: serde_json::Value = serde_json::from_str(&value).context("Invalid stored JSON")?;
+        row[2] = Value::Text(value);
+    }
+    Ok(row)
+}
