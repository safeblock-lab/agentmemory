+fn use_key(scope: &str,key: &str)->String {format!("ttl-use:{}",json!([scope,key]))}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct ContextUse { pub session_id: String, pub project: String, pub targets: Vec<Target> }
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Target { pub scope: String, pub key: String, pub expected_version: String }
+pub fn record_use(connection:&Connection,request:ContextUse)->anyhow::Result<Value> {
+    require(request.targets.len()<=50 && request.session_id.len()<=4096 && request.project.len()<=4096)?;
+    let Some(session)=storage_prune::bounded_dependency(connection,"mem:sessions",&request.session_id)? else {return Ok(json!({"recorded":0}))};
+    if session["id"]!=request.session_id || session["project"]!=request.project || session.get("endedAt").is_some_and(|v|!v.is_null()) {return Ok(json!({"recorded":0}));}
+    let now=chrono::Utc::now().timestamp_millis(); let mut recorded=0;
+    for target in request.targets {
+        require(target.scope.starts_with("mem:obs:") && target.scope.len()<=4096 && target.key.len()<=4096)?;
+        if database::row_version(connection,&target.scope,&target.key)?.to_string()!=target.expected_version {continue;}
+        let Some(value)=storage_prune::bounded_dependency(connection,&target.scope,&target.key)? else {continue};
+        if value["id"]!=target.key || value["sessionId"]!=target.scope.trim_start_matches("mem:obs:") {continue;}
+        database::write(connection,STATE,&use_key(&target.scope,&target.key),Some(&json!({
+            "producer":"server-task-context-delivery","taskId":request.session_id,"occurredAtMs":now,"targetVersion":target.expected_version})))?;
+        recorded+=1;
+    }
+    Ok(json!({"recorded":recorded}))
+}
