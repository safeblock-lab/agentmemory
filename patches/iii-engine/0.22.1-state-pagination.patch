+use super::*;
+
+fn sessions_page(
+    connection: &Connection,
+    project: &str,
+    cursor: Option<&str>,
+    limit: usize,
+) -> anyhow::Result<Value> {
+    let mut request = json!({
+        "action": "project_sessions_page",
+        "project": project,
+        "limit": limit,
+        "max_bytes": 65_536,
+    });
+    if let Some(cursor) = cursor {
+        request["cursor"] = json!(cursor);
+    }
+    call(connection, request)
+}
+
+fn session(id: &str, project: &str, private: &str) -> Value {
+    json!({
+        "id": id,
+        "project": project,
+        "cwd": private,
+        "summary": private,
+        "firstPrompt": private,
+        "agentId": "agent-test",
+        "startedAt": "2026-10-10T12:00:00.000Z",
+        "endedAt": "2026-10-10T12:05:00.000Z",
+        "status": "completed",
+        "observationCount": 3,
+    })
+}
+
+#[test]
+fn project_sessions_page_filters_before_limit_projects_fields_and_paginates() {
+    let connection = fresh();
+    write(&connection, "mem:sessions", "session-a", Some(&session("session-a", "project-a", "private-a")));
+    write(&connection, "mem:sessions", "session-b", Some(&session("session-b", "project-b", "private-b")));
+    write(&connection, "mem:sessions", "session-c", Some(&session("session-c", "project-a", "private-c")));
+
+    let first = sessions_page(&connection, "project-a", None, 1).unwrap();
+    assert_eq!(first["status"], "partial");
+    assert_eq!(first["partial"], true);
+    assert_eq!(first["items"].as_array().unwrap().len(), 1);
+    assert_eq!(first["items"][0]["session_id"], "session-a");
+    let current_version: String = connection.query_row(
+        "SELECT version FROM state_rows WHERE scope='mem:sessions' AND key='session-a'",
+        [],
+        |row| row.get(0),
+    ).unwrap();
+    assert_eq!(first["items"][0]["row_version"].as_str(), Some(current_version.as_str()));
+    assert_eq!(first["items"][0]["session"]["project"], "project-a");
+    assert_eq!(first["items"][0]["session"]["agentId"], "agent-test");
+    assert_eq!(first["items"][0]["session"]["startedAt"], "2026-10-10T12:00:00.000Z");
+    assert_eq!(first["items"][0]["session"]["observationCount"], 3);
+    assert!(first["next_cursor"].as_str().is_some());
+    assert!(!first.to_string().contains("private-a"));
+
+    let next = first["next_cursor"].as_str().unwrap();
+    let cross_project = sessions_page(&connection, "project-b", Some(next), 1).unwrap_err();
+    assert_eq!(code(cross_project), "STATE_RETRIEVAL_STALE_CURSOR");
+    let second = sessions_page(&connection, "project-a", Some(next), 1).unwrap();
+    assert_eq!(second["status"], "ready");
+    assert_eq!(second["partial"], false);
+    assert_eq!(second["items"][0]["session_id"], "session-c");
+    assert_eq!(second["next_cursor"], Value::Null);
+}
