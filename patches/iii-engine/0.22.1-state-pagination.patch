+#[test]
+fn storage_maintenance_lease_two_connections_expiry_fences_and_reopen() {
+    let (_directory, path, first, second) = connections();
+    let acquired = lease::acquire(&first, "owner:a", 120_000).unwrap();
+    assert_eq!(acquired["status"], "acquired");
+    assert_eq!(acquired["recovered_expired"], false);
+    let fence = acquired["fence"].as_u64().unwrap();
+    let busy = lease::acquire(&second, "owner:b", 120_000).unwrap();
+    assert_eq!(busy["status"], "busy");
+    assert_eq!(busy["fence"], fence);
+    assert_eq!(busy["expires_at"], acquired["expires_at"]);
+    assert_eq!(lease::refresh(&second, "owner:b", fence, 120_000).unwrap()["status"], "stale");
+    assert_eq!(lease::release(&second, "owner:a", fence+1).unwrap()["status"], "stale");
+    let refreshed = lease::refresh(&first, "owner:a", fence, 150_000).unwrap();
+    assert_eq!(refreshed["status"], "refreshed");
+    assert!(refreshed["expires_at"].as_str().unwrap() > acquired["expires_at"].as_str().unwrap());
+    expire(&first);
+    drop(first);
+    let reopened = database::open(&path).unwrap();
+    let replacement = lease::acquire(&reopened, "owner:b", 120_000).unwrap();
+    assert_eq!(replacement["recovered_expired"], true);
+    assert_eq!(replacement["fence"], fence+1);
+    assert_eq!(lease::refresh(&second, "owner:a", fence, 120_000).unwrap()["status"], "stale");
+    assert_eq!(lease::release(&second, "owner:a", fence).unwrap()["status"], "stale");
+    assert_eq!(lease::release(&reopened, "owner:b", fence+1).unwrap()["status"], "released");
+    assert_eq!(lease::acquire(&second, "owner:c", 120_000).unwrap()["fence"], fence+2);
+}
+
+#[test]
+fn storage_maintenance_lease_old_snapshot_and_release_cannot_overwrite_new_owner() {
+    let (_directory, _path, first, second) = connections();
+    let a = lease::acquire(&first, "a", 120_000).unwrap()["fence"].as_u64().unwrap();
+    lease::save_state(&first, "a", a, state("a"), false).unwrap();
+    expire(&first);
+    let b = lease::acquire(&second, "b", 120_000).unwrap()["fence"].as_u64().unwrap();
+    lease::save_state(&second, "b", b, state("advanced-b"), false).unwrap();
+    let before = database::row(&second,"mem:storage-maintenance","current").unwrap();
+    for release in [false,true] {
+        assert_eq!(code(lease::save_state(&first,"a",a,state("stale-a"),release).unwrap_err()),"STATE_STORAGE_MAINTENANCE_LEASE_FENCED");
+        assert_eq!(database::row(&second,"mem:storage-maintenance","current").unwrap().value, before.value);
+        assert_eq!(database::row_version(&second,"mem:storage-maintenance","current").unwrap(),before.version);
+        assert_eq!(lease::acquire(&first,"a",120_000).unwrap()["fence"],b);
+    }
+    second.execute_batch("CREATE TRIGGER fail_state BEFORE INSERT ON state_rows WHEN NEW.scope='mem:storage-maintenance' BEGIN SELECT RAISE(ABORT,'save failed'); END;").unwrap();
+    assert!(lease::save_state(&second,"b",b,state("final"),true).is_err());
+    assert_eq!(lease::acquire(&first,"a",120_000).unwrap()["status"],"busy");
+    assert_eq!(database::row(&second,"mem:storage-maintenance","current").unwrap().value,before.value);
+    second.execute_batch("DROP TRIGGER fail_state").unwrap();
+    let saved = lease::save_state(&second,"b",b,state("final-b"),true).unwrap();
+    assert_eq!(saved["released"],true);
+    assert_eq!(database::row(&first,"mem:storage-maintenance","current").unwrap().value,Some(state("final-b")));
+    assert_eq!(lease::acquire(&first,"c",120_000).unwrap()["fence"],b+1);
+}
+
+#[test]
+fn storage_maintenance_lease_lock_wait_samples_clock_after_immediate_lock() {
+    let (_directory,path,first,second) = connections();
+    let fence = lease::acquire(&first,"a",1000).unwrap()["fence"].as_u64().unwrap();
+    first.execute_batch("BEGIN IMMEDIATE").unwrap();
+    let (started_tx,started_rx) = std::sync::mpsc::channel();
+    let join = std::thread::spawn(move || {
+        started_tx.send(()).unwrap();
+        lease::refresh(&second,"a",fence,120_000).unwrap()
+    });
+    started_rx.recv().unwrap();
+    std::thread::sleep(Duration::from_millis(1100));
+    first.execute_batch("COMMIT").unwrap();
+    assert_eq!(join.join().unwrap()["status"],"stale");
+    let second = database::open(&path).unwrap();
+    let fence = lease::acquire(&first,"b",1000).unwrap()["fence"].as_u64().unwrap();
+    first.execute_batch("BEGIN IMMEDIATE").unwrap();
+    let (started_tx,started_rx) = std::sync::mpsc::channel();
+    let join = std::thread::spawn(move || { started_tx.send(()).unwrap(); lease::acquire(&second,"c",120_000).unwrap() });
+    started_rx.recv().unwrap();
+    std::thread::sleep(Duration::from_millis(1100));
+    first.execute_batch("COMMIT").unwrap();
+    let acquired = join.join().unwrap();
+    assert_eq!(acquired["status"],"acquired");
+    assert_eq!(acquired["fence"],fence+1);
+    assert_eq!(acquired["recovered_expired"],true);
+}
+
+#[test]
+fn storage_maintenance_lease_page_is_atomic_legal_and_excludes_other_connection() {
+    let (_directory,path,first,second) = connections();
+    first.execute_batch("CREATE TABLE garbage(v BLOB); INSERT INTO garbage VALUES(zeroblob(262144)); DELETE FROM garbage;").unwrap();
+    let before: i64 = first.pragma_query_value(None,"freelist_count",|r|r.get(0)).unwrap();
+    assert!(before>0);
+    let fence = lease::acquire(&first,"a",120_000).unwrap()["fence"].as_u64().unwrap();
+    first.execute_batch("BEGIN IMMEDIATE").unwrap();
+    second.busy_timeout(Duration::from_millis(1)).unwrap();
+    assert!(lease::acquire(&second,"b",120_000).is_err());
+    first.execute_batch("PRAGMA incremental_vacuum(1); COMMIT").unwrap();
+    assert_eq!(lease::acquire(&second,"b",120_000).unwrap()["status"],"busy");
+    let before_pages: i64 = first.pragma_query_value(None,"page_count",|r|r.get(0)).unwrap();
+    lease::reclaim_page(&first,"a",fence).unwrap();
+    let after_pages: i64 = second.pragma_query_value(None,"page_count",|r|r.get(0)).unwrap();
+    assert_eq!(before_pages-after_pages,1);
+    expire(&first);
+    lease::acquire(&second,"b",120_000).unwrap();
+    assert_eq!(code(lease::reclaim_page(&first,"a",fence).unwrap_err()),"STATE_STORAGE_MAINTENANCE_LEASE_FENCED");
+    assert_eq!(second.pragma_query_value(None,"page_count",|r|r.get::<_,i64>(0)).unwrap(),after_pages);
+    assert!(path.exists());
+}
+
+#[test]
+fn storage_maintenance_lease_reclaim_bounds_pressure_cooldown_and_progress() {
+    let (_directory,path,first,second) = connections();
+    first.execute_batch("CREATE TABLE garbage(v BLOB); INSERT INTO garbage VALUES(zeroblob(262144)); DELETE FROM garbage; PRAGMA wal_checkpoint(TRUNCATE);").unwrap();
+    let fence = lease::acquire(&first,"a",120_000).unwrap()["fence"].as_u64().unwrap();
+    let mut schedule = storage_reclaim::Schedule::default();
+    let run = |schedule:&mut storage_reclaim::Schedule,pages,ms,reserved,pressure| storage_reclaim::cut(&first,&path,schedule,pages,ms,reserved,||pressure,"a",fence);
+    assert!(run(&mut schedule,17,25,true,false).is_err());
+    assert!(run(&mut schedule,1,26,true,false).is_err());
+    assert_eq!(run(&mut schedule,1,25,false,false).unwrap()["reason"],"reclaim_in_flight");
+    assert_eq!(run(&mut schedule,1,25,true,true).unwrap()["reason"],"foreground_pressure");
+    second.execute_batch("BEGIN IMMEDIATE").unwrap();
+    let blocked_at=Instant::now();
+    assert_eq!(run(&mut schedule,1,25,true,false).unwrap()["reason"],"sqlite_busy");
+    assert!(blocked_at.elapsed()<Duration::from_millis(250));
+    second.execute_batch("ROLLBACK").unwrap();
+    let start=Instant::now();
+    let progress=run(&mut schedule,1,25,true,false).unwrap();
+    assert!(start.elapsed()<Duration::from_secs(1));
+    assert_eq!(progress["pages_reclaimed"],1);
+    assert_eq!(progress["checkpoint_performed"],false);
+    assert_eq!(progress["min_interval_ms"],5000);
+    assert_eq!(run(&mut schedule,1,25,true,false).unwrap()["reason"],"cooldown");
+}
+
+#[tokio::test]
+async fn storage_maintenance_lease_wire_dispatch_and_validation() {
+    let (_directory,adapter)=fresh();
+    assert!(adapter.storage(json!({"action":"reclaim","max_pages":1,"max_ms":25})).await.is_err());
+    assert!(adapter.storage(json!({"action":"maintenance_lease_acquire","owner_id":"bad owner","lease_ms":120000})).await.is_err());
+    let acquired=adapter.storage(json!({"action":"maintenance_lease_acquire","owner_id":"a","lease_ms":120000})).await.unwrap();
+    let fence=acquired["fence"].as_u64().unwrap();
+    assert_eq!(adapter.storage(json!({"action":"maintenance_lease_refresh","owner_id":"a","fence":fence,"lease_ms":120000})).await.unwrap()["status"],"refreshed");
+    assert_eq!(adapter.storage(json!({"action":"maintenance_state_save","owner_id":"a","fence":fence,"value":state("wire"),"release":true})).await.unwrap()["status"],"saved");
+    assert_eq!(adapter.get("mem:storage-maintenance","current").await.unwrap(),Some(state("wire")));
+}
+
+#[test]
+fn storage_maintenance_lease_wal_pressure_defers_without_checkpoint_or_page() {
+    let (_directory,path,first,_second) = connections();
+    let fence = lease::acquire(&first,"a",120_000).unwrap()["fence"].as_u64().unwrap();
+    first.execute_batch("PRAGMA wal_autocheckpoint=0; CREATE TABLE garbage(v BLOB); INSERT INTO garbage VALUES(zeroblob(17000000)); DELETE FROM garbage;").unwrap();
+    let before=storage_reclaim::physical(&first,&path).unwrap();
+    assert!(before["wal_bytes"].as_u64().unwrap()>16*1024*1024);
+    let mut schedule=storage_reclaim::Schedule::default();
+    let result=storage_reclaim::cut(&first,&path,&mut schedule,16,25,true,||false,"a",fence).unwrap();
+    assert_eq!(result["reason"],"wal_pressure");
+    assert_eq!(result["status"],"deferred");
+    assert_eq!(result["pages_reclaimed"],0);
+    assert_eq!(result["physical_bytes_reclaimed"],0);
+    assert_eq!(result["checkpoint_performed"],false);
+    assert_eq!(result["before"]["page_count"],result["after"]["page_count"]);
+    assert_eq!(result["before"]["wal_bytes"],result["after"]["wal_bytes"]);
+}
