+use super::*;
+use rusqlite::params;
+
+fn simulate_older_writer(connection: &Connection) {
+    connection.execute("UPDATE state_scopes SET revision=CAST(CAST(revision AS INTEGER)+1 AS TEXT) WHERE scope=?1",[graph::NODES]).unwrap();
+}
+
+#[test]
+fn resumable_prepare_is_projected_atomic_and_survives_reopen() {
+    let root = std::env::var("III_SQLITE_TEST_ROOT").expect("workspace-only synthetic test root");
+    let directory = tempfile::tempdir_in(root).unwrap();
+    let path = directory.path().join("retrieval.sqlite3");
+    {
+        let connection = database::open(&path).unwrap();
+        for index in 0..4 {
+            let mut value = node(&format!("n{index}"), &format!("name{index}"), &["obs"]);
+            value["properties"] = json!({"large":"x".repeat(256*1024)});
+            write(
+                &connection,
+                graph::NODES,
+                &format!("n{index}"),
+                Some(&value),
+            );
+        }
+        simulate_older_writer(&connection);
+        assert_eq!(
+            call(&connection, json!({"action":"index_status"})).unwrap()["graph"][0]["status"],
+            "pending"
+        );
+        {
+            let transaction = connection.unchecked_transaction().unwrap();
+            let request=request::parse(json!({"action":"index_prepare","scope":graph::NODES,"max_rows":1,"max_bytes":1024})).unwrap();
+            execute(&transaction, request).unwrap();
+        }
+        assert_eq!(
+            metadata::graph(&connection, graph::NODES).unwrap().cursor,
+            -1
+        );
+        let value = call(
+            &connection,
+            json!({"action":"index_prepare","scope":graph::NODES,"max_rows":1,"max_bytes":1024}),
+        )
+        .unwrap();
+        assert_eq!(value["processed"], 1);
+        assert_eq!(value["status"], "pending");
+        assert_eq!(value["cursor"], "0");
+        assert_eq!(
+            code(
+                call(
+                    &connection,
+                    json!({"action":"graph_seeds","observation_ids":["obs"]})
+                )
+                .unwrap_err()
+            ),
+            "STATE_INDEX_NOT_READY"
+        );
+    }
+    {
+        let connection = database::open(&path).unwrap();
+        assert_eq!(
+            metadata::graph(&connection, graph::NODES).unwrap().cursor,
+            0
+        );
+        write(&connection, graph::NODES, "n0", None);
+        write(
+            &connection,
+            graph::NODES,
+            "n1",
+            Some(&node("n1", "updated", &["obs"])),
+        );
+        write(
+            &connection,
+            graph::NODES,
+            "appended",
+            Some(&node("appended", "new", &["obs"])),
+        );
+        loop {
+            let value=call(&connection,json!({"action":"index_prepare","scope":graph::NODES,"max_rows":1,"max_bytes":1024})).unwrap();
+            if value["status"] == "ready" {
+                break;
+            }
+        }
+        let value = call(
+            &connection,
+            json!({"action":"graph_seeds","observation_ids":["obs"]}),
+        )
+        .unwrap();
+        assert_eq!(ids(&value), vec!["n1", "n2", "n3", "appended"]);
+        assert!(
+            ids(&call(
+                &connection,
+                json!({"action":"graph_seeds","entity_names":["name0"],"match":"exact"})
+            )
+            .unwrap())
+            .is_empty()
+        );
+        let cache: i64 = connection
+            .pragma_query_value(None, "cache_size", |r| r.get(0))
+            .unwrap();
+        assert_eq!(cache, -65536);
+        let mmap: i64 = connection
+            .pragma_query_value(None, "mmap_size", |r| r.get(0))
+            .unwrap();
+        assert_eq!(mmap, 0);
+    }
+}
+
+#[test]
+fn prepare_restarts_epoch_on_unindexed_old_writer_and_excludes_ghosts() {
+    let connection = fresh();
+    for id in ["a", "b", "c"] {
+        write(&connection, graph::NODES, id, Some(&node(id, "old", &[])));
+    }
+    simulate_older_writer(&connection);
+    call(
+        &connection,
+        json!({"action":"index_prepare","scope":graph::NODES,"max_rows":1}),
+    )
+    .unwrap();
+    let epoch = metadata::graph(&connection, graph::NODES).unwrap().epoch;
+    connection.execute("UPDATE state_rows SET value=NULL,position=NULL,value_bytes=0 WHERE scope=?1 AND key='a'",[graph::NODES]).unwrap();
+    let raw = serde_json::to_string(&node("b", "new", &[])).unwrap();
+    connection
+        .execute(
+            "UPDATE state_rows SET value=?2,value_bytes=?3 WHERE scope=?1 AND key='b'",
+            params![graph::NODES, raw, raw.len() as i64],
+        )
+        .unwrap();
+    simulate_older_writer(&connection);
+    let value = call(
+        &connection,
+        json!({"action":"index_prepare","scope":graph::NODES}),
+    )
+    .unwrap();
+    assert_eq!(value["status"], "ready");
+    assert!(metadata::graph(&connection, graph::NODES).unwrap().epoch > epoch);
+    assert_eq!(
+        ids(&call(
+            &connection,
+            json!({"action":"graph_seeds","entity_names":["old"],"match":"exact"})
+        )
+        .unwrap()),
+        vec!["c"]
+    );
+    assert_eq!(
+        ids(&call(
+            &connection,
+            json!({"action":"graph_seeds","entity_names":["new"],"match":"exact"})
+        )
+        .unwrap()),
+        vec!["b"]
+    );
+}
+
+#[test]
+fn semantic_reprepare_streams_canonical_rows_without_resident_restoration() {
+    let connection = fresh();
+    configure(&connection);
+    upsert(
+        &connection,
+        vec![
+            vector_item("a", &[1.0, 0.0, 0.0, 0.0], Some("original")),
+            vector_item("b", &[0.0, 1.0, 0.0, 0.0], Some("next")),
+        ],
+    )
+    .unwrap();
+    connection
+        .execute(
+            "UPDATE state_scopes SET revision='3' WHERE scope='mem:semantic:observations'",
+            [],
+        )
+        .unwrap();
+    let mut query = semantic_request("semantic_search");
+    query["embedding"] = json!(encoded(&[1.0, 0.0, 0.0, 0.0]));
+    assert_eq!(
+        code(call(&connection, query).unwrap_err()),
+        "STATE_INDEX_NOT_READY"
+    );
+    let value = call(
+        &connection,
+        json!({"action":"index_prepare","scope":"mem:semantic:observations","max_rows":1}),
+    )
+    .unwrap();
+    assert_eq!(value["status"], "pending");
+    assert_eq!(
+        code(keywords(&connection, "original").unwrap_err()),
+        "STATE_INDEX_NOT_READY"
+    );
+    let value = call(
+        &connection,
+        json!({"action":"index_prepare","scope":"mem:semantic:observations","max_rows":1}),
+    )
+    .unwrap();
+    assert_eq!(value["status"], "ready");
+    assert_eq!(
+        returned_ids(&keywords(&connection, "original").unwrap()),
+        vec!["a"]
+    );
+    assert_eq!(
+        search(&connection, &[1.0, 0.0, 0.0, 0.0], 64)["items"][0]["obsId"],
+        "a"
+    );
+    let meta = semantic::get(&connection, "observations").unwrap();
+    assert_eq!(meta.count, 2);
+    assert_eq!(meta.lexical_count, 2);
+}
+
+#[test]
+fn retrieval_request_rejects_unknown_fields_and_oversized_bounds() {
+    for request in [
+        json!({"action":"index_status","unknown":true}),
+        json!({"action":"graph_seeds","max_items":0}),
+        json!({"action":"graph_edges","node_ids":[""],"max_bytes":1024}),
+        json!({"action":"index_prepare","scope":graph::NODES,"max_rows":1025}),
+        json!({"action":"graph_seeds","entity_names":["x".repeat(4097)]}),
+    ] {
+        assert_eq!(
+            code(request::parse(request).err().unwrap()),
+            "STATE_TX_INVALID_REQUEST"
+        );
+    }
+}
