+                    "staging",
+                    vec![op(JOBS, "other", "0", job("other", "1"))]
+                ))
+                .await
+                .unwrap_err()
+        ),
+        "STATE_GRAPH_RECOVERY_REQUIRED"
+    );
+    let changed = batch(
+        owner.clone(),
+        "job",
+        "delta",
+        0,
+        "0",
+        "applying",
+        vec![
