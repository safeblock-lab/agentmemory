+pub(super) fn row_protected(value: &Value) -> bool {
+    ["protected", "keep", "pinned", "retentionProtected", "rollbackRequired", "replayRequired", "recoveryStopped", "dispatchPending"]
+        .iter().any(|field| value[*field] == true)
+        || ["recovery", "lease", "activeUnitJobId", "recoveryOfJobId", "zeroSpendRecoveryOfJobId", "recoveryMode", "recoveryGeneration"]
+            .iter().any(|field| value.get(*field).is_some_and(|field| !field.is_null()))
+        || ["references", "dependentJobIds", "protectedBy"].iter().any(|field| {
+            value.get(*field).is_some_and(|field| field.as_array().is_none_or(|items| !items.is_empty()))
+        })
+}
+pub(super) fn terminal_old_enough(value:&Value)->bool {
+    if row_protected(value) || !(value["state"]=="completed" || value["state"]=="invalidated" || value["status"]=="completed") {return false;}
+    let at=value.get("completedAt").or_else(||value.get("closedAt")).or_else(||value.get("updatedAt"));
+    at.and_then(Value::as_str).and_then(|at|chrono::DateTime::parse_from_rfc3339(at).ok()).is_some_and(|at|at.timestamp_millis()<=chrono::Utc::now().timestamp_millis()-7*24*60*60*1000)
+}
