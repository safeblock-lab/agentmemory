+#[test]
+fn deletes_reassignment_shared_nodes_and_unrelated_capture_reconcile() {
+    let c=fixture();
+    observation(&c,"other-session","other","other-obs");
+    write(&c,graph::NODES,"shared",Some(&node("shared","Shared",&["obs","other-obs"])));
+    write(&c,graph::NODES,"target-only",Some(&node("target-only","Target",&["obs"])));
+    ready(&c,"target"); ready(&c,"other"); ready(&c,"moved");
+    let revision=browse(&c,"target",None,128,65536).unwrap()["revision"].clone();
+    write(&c,"mem:obs:session","unrelated",Some(&json!({"id":"unrelated","title":"capture","narrative":"body"})));
+    let unchanged=browse(&c,"target",None,128,65536).unwrap();
+    assert_eq!(unchanged["status"],"ready"); assert_eq!(unchanged["revision"],revision);
+    write(&c,"mem:sessions","session",Some(&json!({"id":"session","project":"moved"})));
+    assert_eq!(browse(&c,"target",None,128,65536).unwrap()["status"],"preparing");
+    assert_eq!(browse(&c,"moved",None,128,65536).unwrap()["status"],"preparing");
+    // The unrelated capture needs an embedding before the existing scoped source index can finish.
+    embed(&c,"session","unrelated");
+    ready(&c,"target"); ready(&c,"moved");
+    assert!(ids(&browse(&c,"target",None,128,65536).unwrap()).is_empty());
+    assert_eq!(ids(&browse(&c,"moved",None,128,65536).unwrap()),vec!["shared","target-only"]);
+    write(&c,graph::NODES,"shared",None);
+    ready(&c,"other"); ready(&c,"moved");
+    assert!(ids(&browse(&c,"other",None,128,65536).unwrap()).is_empty());
+    assert_eq!(ids(&browse(&c,"moved",None,128,65536).unwrap()),vec!["target-only"]);
+    write(&c,"mem:obs:session","obs",None);
+    ready(&c,"moved");
+    assert!(ids(&browse(&c,"moved",None,128,65536).unwrap()).is_empty());
+}
