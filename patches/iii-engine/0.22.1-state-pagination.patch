+use super::*;
+use windows_sys::Win32::Security::{PROTECTED_DACL_SECURITY_INFORMATION, WinWorldSid, InitializeAcl, AddAccessAllowedAce, GetLengthSid,
+    Authorization::{SetEntriesInAclW, SetSecurityInfo, EXPLICIT_ACCESS_W, TRUSTEE_W, SET_ACCESS, TRUSTEE_IS_SID, TRUSTEE_IS_USER, NO_MULTIPLE_TRUSTEE}};
+
+unsafe fn fixture_identity() -> Vec<u64> {
+    let mut token=null_mut(); assert_ne!(unsafe { OpenProcessToken(GetCurrentProcess(),TOKEN_QUERY,&mut token) },0);
+    let token=unsafe { OwnedHandle::from_raw_handle(token) }; let mut needed=0;
+    unsafe { GetTokenInformation(token.as_raw_handle(),TokenUser,null_mut(),0,&mut needed); }
+    assert!(needed>0 && needed<=65536);
+    let mut user=vec![0u64;(needed as usize).div_ceil(8)];
+    assert_ne!(unsafe { GetTokenInformation(token.as_raw_handle(),TokenUser,user.as_mut_ptr().cast(),needed,&mut needed) },0);
+    user
+}
+unsafe fn fixture_acl(file: &File, principals: &[PSID]) {
+    let entries=principals.iter().map(|sid|EXPLICIT_ACCESS_W {grfAccessPermissions:0x1f01ff,grfAccessMode:SET_ACCESS,grfInheritance:0,
+        Trustee:TRUSTEE_W {pMultipleTrustee:null_mut(),MultipleTrusteeOperation:NO_MULTIPLE_TRUSTEE,
+            TrusteeForm:TRUSTEE_IS_SID,TrusteeType:TRUSTEE_IS_USER,ptstrName:sid.cast()}}).collect::<Vec<_>>();
+    let mut acl=null_mut();
+    assert_eq!(unsafe { SetEntriesInAclW(entries.len() as u32,entries.as_ptr(),std::ptr::null(),&mut acl) },0);
+    let _release=Descriptor(acl.cast());
+    assert_eq!(unsafe { SetSecurityInfo(file.as_raw_handle(),SE_FILE_OBJECT,DACL_SECURITY_INFORMATION|PROTECTED_DACL_SECURITY_INFORMATION,
+        null_mut(),null_mut(),acl,std::ptr::null()) },0);
+}
+#[test]
+fn windows_acl_accepts_only_engine_system_admin_and_fails_closed_on_everyone_null_or_unavailable() {
+    use std::{fs::OpenOptions,os::windows::fs::OpenOptionsExt};
+    let root=std::env::var("III_SQLITE_TEST_ROOT").expect("isolated III_SQLITE_TEST_ROOT must be set");
+    assert!(std::path::Path::new(&root).is_absolute());
+    let directory=tempfile::tempdir_in(root).unwrap();
+    // ACL mutations exist only in this unexecuted fixture source and target a new isolated file.
+    let file=OpenOptions::new().read(true).write(true).create_new(true).access_mode(0xc0060000)
+        .open(directory.path().join("acl-fixture.json")).unwrap();
+    unsafe {
+        let user=fixture_identity(); let identity=(*user.as_ptr().cast::<TOKEN_USER>()).User.Sid;
+        let mut system=[0u64;16];let mut administrators=[0u64;16];let mut everyone=[0u64;16];
+        for (kind,buffer) in [(WinLocalSystemSid,&mut system),(WinBuiltinAdministratorsSid,&mut administrators),(WinWorldSid,&mut everyone)] {
+            let mut size=size_of_val(buffer) as u32; assert_ne!(CreateWellKnownSid(kind,null_mut(),buffer.as_mut_ptr().cast(),&mut size),0);
+        }
+        let allowed=[identity,system.as_mut_ptr().cast(),administrators.as_mut_ptr().cast()];
+        fixture_acl(&file,&allowed); assert!(check(&file).is_ok());
+        fixture_acl(&file,&[allowed[0],allowed[1],allowed[2],everyone.as_mut_ptr().cast()]);
+        assert!(check(&file).is_err());
+        let bytes=size_of::<ACL>()+65*(8+GetLengthSid(identity) as usize);
+        let mut oversized=vec![0u64;bytes.div_ceil(8)];let acl=oversized.as_mut_ptr().cast::<ACL>();
+        assert_ne!(InitializeAcl(acl,(oversized.len()*8) as u32,2),0);
+        for _ in 0..65 { assert_ne!(AddAccessAllowedAce(acl,2,0x1f01ff,identity),0); }
+        assert_eq!(SetSecurityInfo(file.as_raw_handle(),SE_FILE_OBJECT,DACL_SECURITY_INFORMATION|PROTECTED_DACL_SECURITY_INFORMATION,
+            null_mut(),null_mut(),acl,std::ptr::null()),0);
+        assert!(check(&file).is_err());
+        assert_eq!(SetSecurityInfo(file.as_raw_handle(),SE_FILE_OBJECT,DACL_SECURITY_INFORMATION|PROTECTED_DACL_SECURITY_INFORMATION,
+            null_mut(),null_mut(),std::ptr::null(),std::ptr::null()),0);
+        assert!(check(&file).is_err());
+        assert!(inspect(null_mut()).is_err());
+        fixture_acl(&file,&allowed);
+    }
+}
+
+#[tokio::test]
+async fn native_state_storage_uses_only_fixed_private_grant_file_and_duplicate_is_never_fresh() {
+    use std::{fs::OpenOptions,os::windows::fs::OpenOptionsExt,io::Write};
+    use super::super::super::super::{SqliteAdapter,StateAdapter};
+    use serde_json::json;
+    let root=std::env::var("III_SQLITE_TEST_ROOT").expect("isolated III_SQLITE_TEST_ROOT must be set");
+    assert!(std::path::Path::new(&root).is_absolute());
+    let directory=tempfile::tempdir_in(root).unwrap();
+    let database=directory.path().join("private-grant.sqlite3");
+    let adapter=SqliteAdapter::new(Some(json!({"file_path":database}))).unwrap();
+    let grant_path=directory.path().join("provider-budget-grants.json");
+    let mut file=OpenOptions::new().read(true).write(true).create_new(true).access_mode(0xc0060000).open(&grant_path).unwrap();
+    let now=chrono::Utc::now();
+    let config=json!({"version":1,"window":{"id":"window-fixture","ceiling":1,
+        "startsAt":(now-chrono::Duration::minutes(1)).to_rfc3339_opts(chrono::SecondsFormat::Millis,true),
+        "expiresAt":(now+chrono::Duration::minutes(5)).to_rfc3339_opts(chrono::SecondsFormat::Millis,true)},
+        "operations":[{"id":"operation-fixture","ceiling":1}],"allowedEndpoints":["POST https://provider.test/v1/chat"]});
+    file.write_all(serde_json::to_string(&config).unwrap().as_bytes()).unwrap(); file.sync_all().unwrap();
+    let dir=OpenOptions::new().read(true).access_mode(0x60000).custom_flags(0x02000000).open(directory.path()).unwrap();
+    unsafe {
+        let user=fixture_identity(); let sid=(*user.as_ptr().cast::<TOKEN_USER>()).User.Sid;
+        fixture_acl(&file,&[sid]); fixture_acl(&dir,&[sid]);
+    }
+    drop(file); drop(dir);
+    let claimed=adapter.storage(json!({"action":"provider_budget_claim","operation_id":"operation-fixture",
+        "window_id":"window-fixture","claim_id":"claim-fixture","expected_ceiling":1})).await.unwrap();
+    assert_eq!(claimed["fresh"],true);
+    let attempt=json!({"action":"provider_budget_consume","operation_id":"operation-fixture","window_id":"window-fixture",
+        "claim_id":"claim-fixture","attempt_id":"attempt-fixture","endpoint":"POST https://provider.test/v1/chat"});
+    assert_eq!(adapter.storage(attempt.clone()).await.unwrap()["fresh"],true);
+    assert_eq!(adapter.storage(attempt).await.unwrap()["fresh"],false);
+    let receipt=adapter.storage(json!({"action":"provider_budget_status","operation_id":"operation-fixture"})).await.unwrap();
+    assert_eq!(receipt["receipt"]["consumed"],1); assert_eq!(receipt["fresh"],false);
+    let mut changed=config.clone(); changed["window"]["ceiling"]=json!(2);
+    std::fs::write(&grant_path,serde_json::to_vec(&changed).unwrap()).unwrap();
+    assert!(adapter.storage(json!({"action":"provider_budget_status","operation_id":"operation-fixture"})).await.is_err());
+}
diff --git a/engine/src/workers/state/adapters/sqlite/provider_attempt_budget/store.rs b/engine/src/workers/state/adapters/sqlite/provider_attempt_budget/store.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/provider_attempt_budget/store.rs
@@ -0,0 +1,141 @@
+use super::{acknowledgment, config::{Context, Trusted}, error, need, Identity};
+use rusqlite::{params, Connection, OptionalExtension};
+use serde_json::{json, Value};
+
+pub(super) fn initialize(connection: &Connection) -> anyhow::Result<()> {
+    connection.execute_batch("
+        CREATE TABLE IF NOT EXISTS engine_provider_budget_windows(
+          window_id TEXT PRIMARY KEY, authority TEXT NOT NULL, ceiling INTEGER NOT NULL CHECK(ceiling BETWEEN 1 AND 10000),
+          consumed INTEGER NOT NULL DEFAULT 0 CHECK(consumed BETWEEN 0 AND ceiling)) WITHOUT ROWID;
+        CREATE TABLE IF NOT EXISTS engine_provider_budget_grants(
+          operation_id TEXT PRIMARY KEY, window_id TEXT NOT NULL REFERENCES engine_provider_budget_windows(window_id),
+          declaration TEXT NOT NULL) WITHOUT ROWID;
+        CREATE TABLE IF NOT EXISTS engine_provider_budget_operations(
+          operation_id TEXT PRIMARY KEY REFERENCES engine_provider_budget_grants(operation_id), window_id TEXT NOT NULL REFERENCES engine_provider_budget_windows(window_id),
+          claim_id TEXT NOT NULL UNIQUE, ceiling INTEGER NOT NULL CHECK(ceiling BETWEEN 1 AND 1000),
+          consumed INTEGER NOT NULL DEFAULT 0 CHECK(consumed BETWEEN 0 AND ceiling),
+          state TEXT NOT NULL CHECK(state IN ('started','completed','unknown')),
+          claimed_at_ms INTEGER NOT NULL, finished_at_ms INTEGER) WITHOUT ROWID;
+        CREATE TABLE IF NOT EXISTS engine_provider_budget_attempts(
+          attempt_id TEXT PRIMARY KEY, operation_id TEXT NOT NULL REFERENCES engine_provider_budget_operations(operation_id),
+          claim_id TEXT NOT NULL, endpoint TEXT NOT NULL, consumed_at_ms INTEGER NOT NULL) WITHOUT ROWID;
+    ")?;
+    Ok(())
+}
+pub(super) fn check_pinned(connection: &Connection, trusted: &Trusted) -> anyhow::Result<()> {
+    let authority: Option<String> = connection.query_row(
+        "SELECT authority FROM engine_provider_budget_windows WHERE window_id=?1", [&trusted.grant.window.id], |row| row.get(0)).optional()?;
+    if let Some(authority) = authority {
+        let prior=Trusted::parse(authority.as_bytes()).map_err(|_|error("STATE_PROVIDER_BUDGET_CONFIG_CHANGED"))?;
+        need(trusted.extends(&prior), "STATE_PROVIDER_BUDGET_CONFIG_CHANGED")?;
+    }
+    Ok(())
+}
+fn pin(connection: &Connection, trusted: &Trusted) -> anyhow::Result<()> {
+    check_pinned(connection, trusted)?;
+    connection.execute("INSERT OR IGNORE INTO engine_provider_budget_windows(window_id,authority,ceiling) VALUES(?1,?2,?3)",
+        params![trusted.grant.window.id, trusted.canonical, trusted.grant.window.ceiling])?;
+    for grant in &trusted.grant.operations {
+        let declaration=serde_json::to_string(grant)?;
+        let previous: Option<(String,String)>=connection.query_row(
+            "SELECT window_id,declaration FROM engine_provider_budget_grants WHERE operation_id=?1",[&grant.id],
+            |row|Ok((row.get(0)?,row.get(1)?))).optional()?;
+        if let Some((window,prior))=previous {
+            need(window==trusted.grant.window.id && prior==declaration,"STATE_PROVIDER_BUDGET_ID_CONFLICT")?;
+        } else {
+            connection.execute("INSERT INTO engine_provider_budget_grants(operation_id,window_id,declaration) VALUES(?1,?2,?3)",
+                params![grant.id,trusted.grant.window.id,declaration])?;
+        }
+    }
+    // Append-only authority updates preserve all existing identities and the durable window ceiling.
+    connection.execute("UPDATE engine_provider_budget_windows SET authority=?2 WHERE window_id=?1",
+        params![trusted.grant.window.id,trusted.canonical])?;
+    Ok(())
+}
+pub(super) fn receipt(connection: &Connection, operation: &str, trusted: &Trusted) -> anyhow::Result<Value> {
+    let stored: Option<(String,u32,u32,u32,u32,String)> = connection.query_row(
+        "SELECT o.window_id,o.ceiling,w.ceiling,o.consumed,w.consumed,o.state
+         FROM engine_provider_budget_operations o JOIN engine_provider_budget_windows w ON w.window_id=o.window_id
+         WHERE o.operation_id=?1", [operation], |row| Ok((row.get(0)?,row.get(1)?,row.get(2)?,row.get(3)?,row.get(4)?,row.get(5)?))).optional()?;
+    if let Some((window,ceiling,window_ceiling,consumed,window_consumed,state)) = stored {
+        return Ok(json!({"operation_id":operation,"window_id":window,"ceiling":ceiling,"window_ceiling":window_ceiling,
+            "consumed":consumed,"window_consumed":window_consumed,"remaining":ceiling-consumed,
+            "window_remaining":window_ceiling-window_consumed,"state":state}));
+    }
+    let Ok(grant) = trusted.operation(operation) else { return Ok(Value::Null); };
+    let window_consumed: u32 = connection.query_row("SELECT consumed FROM engine_provider_budget_windows WHERE window_id=?1",
+        [&trusted.grant.window.id], |row| row.get(0)).optional()?.unwrap_or(0);
+    let state = if trusted.open().is_err() { "expired" } else if window_consumed >= trusted.grant.window.ceiling { "exhausted" } else { "available" };
+    Ok(json!({"operation_id":operation,"window_id":trusted.grant.window.id,"ceiling":grant.ceiling,
+        "window_ceiling":trusted.grant.window.ceiling,"consumed":0,"window_consumed":window_consumed,
+        "remaining":grant.ceiling,"window_remaining":trusted.grant.window.ceiling-window_consumed,"state":state}))
+}
+fn matching(connection: &Connection, identity: &Identity) -> anyhow::Result<(u32,u32,String)> {
+    let row: Option<(String,String,u32,u32,String)> = connection.query_row(
+        "SELECT window_id,claim_id,ceiling,consumed,state FROM engine_provider_budget_operations WHERE operation_id=?1",
+        [&identity.operation_id], |row| Ok((row.get(0)?,row.get(1)?,row.get(2)?,row.get(3)?,row.get(4)?))).optional()?;
+    let (window,claim,ceiling,consumed,state) = row.ok_or_else(|| error("STATE_PROVIDER_BUDGET_NOT_CLAIMED"))?;
+    need(window == identity.window_id && claim == identity.claim_id, "STATE_PROVIDER_BUDGET_ID_CONFLICT")?;
+    Ok((ceiling, consumed, state))
+}
+fn assert_window(trusted: &Trusted, identity: &Identity) -> anyhow::Result<()> {
+    need(identity.window_id == trusted.grant.window.id, "STATE_PROVIDER_BUDGET_BINDING_MISMATCH")?;
+    trusted.operation(&identity.operation_id)?;
+    Ok(())
+}
+pub(super) fn claim(connection: &Connection, trusted: &Trusted, identity: &Identity, ceiling: u32, context: Option<&Context>) -> anyhow::Result<Value> {
+    assert_window(trusted, identity)?;
+    let grant = trusted.operation(&identity.operation_id)?;
+    need(grant.ceiling == ceiling && grant.context.as_ref() == context, "STATE_PROVIDER_BUDGET_BINDING_MISMATCH")?;
+    trusted.open()?;
+    pin(connection, trusted)?;
+    let existing: bool = connection.query_row("SELECT EXISTS(SELECT 1 FROM engine_provider_budget_operations WHERE operation_id=?1)",
+        [&identity.operation_id], |row| row.get(0))?;
+    if existing {
+        let (stored, _, _) = matching(connection, identity)?;
+        need(stored == ceiling, "STATE_PROVIDER_BUDGET_ID_CONFLICT")?;
+        return Ok(acknowledgment("provider_budget_claim", identity, None, "duplicate", false, receipt(connection, &identity.operation_id, trusted)?));
+    }
+    let collision: bool = connection.query_row("SELECT EXISTS(SELECT 1 FROM engine_provider_budget_operations WHERE claim_id=?1)", [&identity.claim_id], |row| row.get(0))?;
+    need(!collision, "STATE_PROVIDER_BUDGET_ID_CONFLICT")?;
+    let remaining: bool = connection.query_row("SELECT consumed<ceiling FROM engine_provider_budget_windows WHERE window_id=?1", [&identity.window_id], |row| row.get(0))?;
+    need(remaining, "STATE_PROVIDER_BUDGET_WINDOW_EXHAUSTED")?;
+    connection.execute("INSERT INTO engine_provider_budget_operations(operation_id,window_id,claim_id,ceiling,state,claimed_at_ms) VALUES(?1,?2,?3,?4,'started',?5)",
+        params![identity.operation_id, identity.window_id, identity.claim_id, ceiling, chrono::Utc::now().timestamp_millis()])?;
+    Ok(acknowledgment("provider_budget_claim", identity, None, "claimed", true, receipt(connection, &identity.operation_id, trusted)?))
+}
+pub(super) fn consume(connection: &Connection, trusted: &Trusted, identity: &Identity, attempt: &str, endpoint: &str) -> anyhow::Result<Value> {
+    assert_window(trusted, identity)?;
+    pin(connection, trusted)?;
+    let (ceiling, consumed, state) = matching(connection, identity)?;
+    let previous: Option<(String,String,String)> = connection.query_row(
+        "SELECT operation_id,claim_id,endpoint FROM engine_provider_budget_attempts WHERE attempt_id=?1", [attempt],
+        |row| Ok((row.get(0)?,row.get(1)?,row.get(2)?))).optional()?;
+    if let Some((operation,claim,target)) = previous {
+        need(operation == identity.operation_id && claim == identity.claim_id && target == endpoint, "STATE_PROVIDER_BUDGET_ID_CONFLICT")?;
+        return Ok(acknowledgment("provider_budget_consume", identity, Some(attempt), "duplicate", false, receipt(connection, &identity.operation_id, trusted)?));
+    }
+    trusted.open()?;
+    need(state == "started", "STATE_PROVIDER_BUDGET_OPERATION_CLOSED")?;
+    need(trusted.grant.allowed_endpoints.iter().any(|allowed| allowed == endpoint), "STATE_PROVIDER_BUDGET_ENDPOINT_NOT_APPROVED")?;
+    need(consumed < ceiling, "STATE_PROVIDER_BUDGET_OPERATION_EXHAUSTED")?;
+    let advanced = connection.execute("UPDATE engine_provider_budget_windows SET consumed=consumed+1 WHERE window_id=?1 AND consumed<ceiling", [&identity.window_id])?;
+    need(advanced == 1, "STATE_PROVIDER_BUDGET_WINDOW_EXHAUSTED")?;
+    let advanced = connection.execute("UPDATE engine_provider_budget_operations SET consumed=consumed+1 WHERE operation_id=?1 AND state='started' AND consumed<ceiling", [&identity.operation_id])?;
+    need(advanced == 1, "STATE_PROVIDER_BUDGET_OPERATION_EXHAUSTED")?;
+    connection.execute("INSERT INTO engine_provider_budget_attempts(attempt_id,operation_id,claim_id,endpoint,consumed_at_ms) VALUES(?1,?2,?3,?4,?5)",
+        params![attempt,identity.operation_id,identity.claim_id,endpoint,chrono::Utc::now().timestamp_millis()])?;
+    Ok(acknowledgment("provider_budget_consume", identity, Some(attempt), "consumed", true, receipt(connection, &identity.operation_id, trusted)?))
+}
+pub(super) fn finish(connection: &Connection, trusted: &Trusted, identity: &Identity, outcome: &str) -> anyhow::Result<Value> {
+    assert_window(trusted, identity)?;
+    pin(connection, trusted)?;
+    let (_, _, state) = matching(connection, identity)?;
+    if state != "started" {
+        need(state == outcome, "STATE_PROVIDER_BUDGET_OPERATION_CLOSED")?;
+        return Ok(acknowledgment("provider_budget_finish", identity, None, "duplicate", false, receipt(connection, &identity.operation_id, trusted)?));
+    }
+    connection.execute("UPDATE engine_provider_budget_operations SET state=?2,finished_at_ms=?3 WHERE operation_id=?1 AND state='started'",
+        params![identity.operation_id, outcome, chrono::Utc::now().timestamp_millis()])?;
+    Ok(acknowledgment("provider_budget_finish", identity, None, "finished", true, receipt(connection, &identity.operation_id, trusted)?))
+}
diff --git a/engine/src/workers/state/adapters/sqlite/provider_attempt_budget/tests.rs b/engine/src/workers/state/adapters/sqlite/provider_attempt_budget/tests.rs
