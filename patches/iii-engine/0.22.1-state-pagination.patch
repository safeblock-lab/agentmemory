+async fn guard(adapter: &SqliteAdapter, owner: &str, generation: &str) -> Value {
+    let mut lease = adapter
+        .lease(json!({"action":"acquire","owner_id":owner,"generation":generation,"ttl_ms":300000}))
+        .await
+        .unwrap();
+    lease.as_object_mut().unwrap().remove("expires_at_ms");
+    lease
+}
+fn op(scope: &str, key: &str, version: &str, value: Value) -> Value {
+    json!({"type":"set","scope":scope,"key":key,"expected_version":version,"value":value})
+}
+fn check(scope: &str, key: &str, version: &str) -> Value {
+    json!({"type":"check","scope":scope,"key":key,"expected_version":version})
+}
+fn job(id: &str, generation: &str) -> Value {
+    json!({"version":1,"id":id,"generation":generation,"logicalDeltaCount":2,"state":"applying"})
+}
+fn working(id: &str, generation: &str, delta: &str, snapshot: Option<Value>) -> Value {
+    json!({"version":1,"generation":generation,"jobId":id,"logicalDeltaId":delta,"snapshotExists":snapshot.is_some(),"snapshot":snapshot})
+}
+fn batch(
+    guard: Value,
+    job: &str,
+    delta: &str,
+    chunk: u64,
+    checkpoint: &str,
+    visibility: &str,
+    operations: Vec<Value>,
+) -> Value {
+    let generation = guard["generation"].as_str().unwrap();
+    let body = json!({"identity":{"generation":generation,"job_id":job,"logical_delta_id":delta,"chunk_ordinal":chunk},
+        "expected_checkpoint_version":checkpoint,"checkpoint":{"generation":generation,"job_id":job,"logical_delta_id":delta,"delta_ordinal":0,"next_chunk_ordinal":chunk+1,"visibility":visibility},"operations":operations});
+    prepared(guard, body)
+}
+fn prepared(guard: Value, body: Value) -> Value {
+    let payload = serde_json::to_string(&body).unwrap();
+    json!({"guard":guard,"payload_digest":hex::encode(Sha256::digest(payload.as_bytes())),"payload_json":payload})
+}
+fn code(error: anyhow::Error) -> String {
+    error
+        .downcast_ref::<protocol::TxError>()
+        .map_or_else(|| error.to_string(), |e| e.0.to_owned())
+}
