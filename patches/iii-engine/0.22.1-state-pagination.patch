+use rusqlite::Connection;
+use serde_json::{Value, json};
+use std::path::{Path, PathBuf};
+use super::super::protocol::require;
+
+const RESERVE: u64 = 8 * 1024 * 1024;
+const BASELINE_CAP: u64 = 115_856_165;
+
+fn file_bytes(path: &Path) -> anyhow::Result<u64> {
+    match std::fs::metadata(path) {
+        Ok(m) => Ok(m.len()),
+        Err(e) if e.kind()==std::io::ErrorKind::NotFound => Ok(0),
+        Err(e) => Err(e.into()),
+    }
+}
+pub(super) fn sample(c: &Connection,path: &Path) -> anyhow::Result<Value> {
+    let physical=super::super::storage_reclaim::physical(c,path)?;
+    let shm=file_bytes(&PathBuf::from(format!("{}-shm",path.display())))?;
+    let db=physical["database_bytes"].as_u64().ok_or_else(||anyhow::anyhow!("STATE_FORWARD_PHYSICAL_UNKNOWN"))?;
+    let wal=physical["wal_bytes"].as_u64().ok_or_else(||anyhow::anyhow!("STATE_FORWARD_PHYSICAL_UNKNOWN"))?;
+    let total=db.checked_add(wal).and_then(|n|n.checked_add(shm)).ok_or_else(||anyhow::anyhow!("STATE_FORWARD_PHYSICAL_OVERFLOW"))?;
+    Ok(json!({"physical":physical,"shm_bytes":shm,"total_bytes":total,
+        "reserve_bytes":RESERVE}))
+}
+pub(super) fn layout(c: &Connection,r: &super::Request,job: &mut Value) -> anyhow::Result<(usize,usize)> {
+    let rev=super::revision(c)?;let inverse=super::inverse_proof::revision(c)?;
+    if job["layout"]["revision"].as_i64()!=Some(rev) || job["layout"]["inverse_revision"].as_i64()!=Some(inverse) {
+        job["layout"]=json!({"revision":rev,"inverse_revision":inverse,"object":0,"source_bytes":0,"candidate_bytes":0,"complete":false});
+    }
+    let names=["compact_list_members","compact_forward_blocks","compact_forward_config","forward_repack_job","forward_repack_receipts"];
+    let index=usize::try_from(job["layout"]["object"].as_u64().ok_or_else(||anyhow::anyhow!("STATE_FORWARD_LAYOUT_INVALID"))?)?;
+    if index==names.len() {return Ok((0,0));}
+    require(index<names.len())?;
+    let started=std::time::Instant::now();let mut count=0usize;let mut bytes=0u64;
+    // One streaming traversal per object: no aggregate, sort, OFFSET, or repeated prefix scan.
+    let mut statement=c.prepare_cached("SELECT pgsize FROM dbstat WHERE name=?1")?;
+    let mut rows=statement.query([names[index]])?;
+    while let Some(row)=rows.next()? {
+        require(started.elapsed()<std::time::Duration::from_millis(r.max_ms.saturating_sub(200)))?;
+        require(count<r.limit.min(r.max_bytes/8))?;
+        bytes=bytes.checked_add(u64::try_from(row.get::<_,i64>(0)?)?).ok_or_else(||anyhow::anyhow!("STATE_FORWARD_PHYSICAL_OVERFLOW"))?;
+        count+=1;
+    }
+    let key=if index==0 {"source_bytes"} else {"candidate_bytes"};
+    let prior=job["layout"][key].as_u64().unwrap_or(0);
+    job["layout"][key]=json!(prior.checked_add(bytes).ok_or_else(||anyhow::anyhow!("STATE_FORWARD_PHYSICAL_OVERFLOW"))?);
+    job["layout"]["object"]=json!(index+1);job["layout"]["complete"]=json!(index+1==names.len());
+    Ok((count,count*8))
+}
+pub(super) fn retirement_gate(c: &Connection,path: &Path,job: &Value) -> anyhow::Result<Value> {
+    let baseline=job["baseline"]["total_bytes"].as_u64().ok_or_else(||anyhow::anyhow!("STATE_FORWARD_BASELINE_MISSING"))?;
+    require(baseline>0)?;
+    let now=sample(c,path)?;
+    let total=now["total_bytes"].as_u64().ok_or_else(||anyhow::anyhow!("STATE_FORWARD_PHYSICAL_UNKNOWN"))?;
+    require(job["layout"]["complete"]==true && job["layout"]["revision"].as_i64()==Some(super::revision(c)?) && job["layout"]["inverse_revision"].as_i64()==Some(super::inverse_proof::revision(c)?))?;
+    let source=job["layout"]["source_bytes"].as_u64().ok_or_else(||anyhow::anyhow!("STATE_FORWARD_PHYSICAL_UNKNOWN"))?;
+    let candidate=job["layout"]["candidate_bytes"].as_u64().ok_or_else(||anyhow::anyhow!("STATE_FORWARD_PHYSICAL_UNKNOWN"))?;
+    let gate=cost_gate(baseline,total,source,candidate,now["physical"]["wal_bytes"].as_u64().ok_or_else(||anyhow::anyhow!("STATE_FORWARD_PHYSICAL_UNKNOWN"))?,now["physical"]["auto_vacuum"].as_u64().ok_or_else(||anyhow::anyhow!("STATE_FORWARD_PHYSICAL_UNKNOWN"))?)?;
+    Ok(json!({"before_retirement":now,"baseline_total_bytes":baseline,"threshold_bytes":gate.0,
+        "complete_candidate_bytes":gate.1,"conservative_net_reclaim_bytes":gate.2,
+        "actual_net_savings_proven":false,"post_reclaim_measurement_required":true}))
+}
+fn cost_gate(baseline:u64,total:u64,source:u64,candidate:u64,wal:u64,auto_vacuum:u64) -> anyhow::Result<(u64,u64,u64)> {
+    require(baseline>0 && source>0 && candidate>0)?;
+    let threshold=baseline.checked_add(19).ok_or_else(||anyhow::anyhow!("STATE_FORWARD_PHYSICAL_OVERFLOW"))?/20;
+    let growth=total.saturating_sub(baseline).max(candidate);
+    let complete=growth.checked_add(RESERVE).ok_or_else(||anyhow::anyhow!("STATE_FORWARD_PHYSICAL_OVERFLOW"))?;
+    let conservative=source.saturating_sub(growth).saturating_sub(RESERVE);
+    require(complete<=BASELINE_CAP && conservative>=threshold)?;
+    // Unknown reclaim mode or WAL debt cannot be covered by the small growth reserve.
+    require(auto_vacuum==2 && wal<=RESERVE)?;
+    Ok((threshold,complete,conservative))
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn physical_gate_includes_candidate_growth_wal_reserve_and_overflow() {
+        let baseline=6_079_676_688;let source=419_840_000;let candidate=100_216_972;
+        let gate=cost_gate(baseline,baseline+candidate,source,candidate,0,2).unwrap();
+        assert_eq!(gate.0,303_983_835);assert_eq!(gate.1,candidate+RESERVE);assert!(gate.2>=gate.0);
+        for args in [(baseline,baseline+115_000_000,source,candidate,0,2),
+            (baseline,baseline+candidate,source,candidate,RESERVE+1,2),
+            (baseline,baseline+candidate,source,candidate,0,0),
+            (baseline,baseline+candidate,300_000_000,candidate,0,2),
+            (u64::MAX,u64::MAX,source,candidate,0,2),
+            (baseline,u64::MAX,source,candidate,0,2)] {
+            assert!(cost_gate(args.0,args.1,args.2,args.3,args.4,args.5).is_err());
+        }
+    }
+}
+pub(super) fn post_reclaim(c: &Connection,path: &Path,job: &Value) -> anyhow::Result<Value> {
+    let now=sample(c,path)?;
+    let baseline=job["baseline"]["total_bytes"].as_u64().ok_or_else(||anyhow::anyhow!("STATE_FORWARD_BASELINE_MISSING"))?;
+    let current=now["total_bytes"].as_u64().ok_or_else(||anyhow::anyhow!("STATE_FORWARD_PHYSICAL_UNKNOWN"))?;
+    let threshold=job["physical_gate"]["threshold_bytes"].as_u64().ok_or_else(||anyhow::anyhow!("STATE_FORWARD_PHYSICAL_GATE_MISSING"))?;
+    let savings=baseline.saturating_sub(current);
+    require(savings>=threshold && super::source(c)?.is_none())?;
+    require(job["physical_gate"]["conservative_net_reclaim_bytes"].as_u64().is_some_and(|n|n>=threshold))?;
+    Ok(json!({"after_reclaim":now,"actual_database_wal_shm_savings_bytes":savings,
+        "threshold_bytes":threshold,"actual_net_savings_proven":true,
+        "attribution":"retired forward source only; source and packed mutation revisions unchanged since exact proof"}))
+}
