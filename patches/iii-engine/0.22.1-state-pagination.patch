+use super::*;
+
+#[path = "project_catalog_diagnostics_tests.rs"]
+mod project_catalog_diagnostics_tests;
+
+fn project_vector(connection: &Connection, session: &str, project: &str, observation: &str) {
+    write(
+        connection,
+        "mem:sessions",
+        session,
+        Some(&json!({"id":session,"project":project})),
+    );
+    let mut item = vector_item(observation, &[1.0, 0.0, 0.0, 0.0], None);
+    item["session_id"] = json!(session);
+    upsert(connection, vec![item]).unwrap();
+}
+
+fn graph_edge(id: &str, source: &str, target: &str, from: &str, to: Option<&str>) -> Value {
+    json!({"id":id,"type":"related_to","sourceNodeId":source,"targetNodeId":target,"weight":0.75,"stale":false,"createdAt":from,"tvalid":from,"tvalidEnd":to,"isLatest":true})
+}
+
+fn project_catalog(connection: &Connection) -> Value {
+    call(
+        connection,
