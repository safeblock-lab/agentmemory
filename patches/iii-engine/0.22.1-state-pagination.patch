diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/graph_browse/prepare.rs b/engine/src/workers/state/adapters/sqlite/retrieval/graph_browse/prepare.rs
new file mode 100644
index 0000000..45b2ee3
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/graph_browse/prepare.rs
@@ -0,0 +1,183 @@
+use super::{compact, dirty, membership, state};
+use super::super::{database, graph, metadata, project_catalog, project_vectors, scoped, semantic, source};
+use rusqlite::{Connection, params};
+use serde_json::{Value, json};
+use anyhow::Context;
+
+#[derive(Debug)]
+struct PrerequisitePhase(&'static str);
+impl std::fmt::Display for PrerequisitePhase {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(f, "graph preparation prerequisite {}", self.0)
+    }
+}
+
+fn response(project: &str, saved: &state::Project, status: &str, phase: &str, processed: usize, more: bool, reason: Option<&str>) -> Value {
+    json!({"scope":super::SCOPE,"project":project,"status":status,"phase":phase,"processed":processed,"revision":super::revision(saved),"continue":more,"reason":reason})
+}
+
+fn prerequisite(c: &Connection, project: &str, saved: &state::Project, max_rows: usize, max_bytes: usize) -> anyhow::Result<Option<Value>> {
+    for (scope, phase) in [(graph::NODES,"node_index"),(graph::EDGES,"edge_index")] {
+        let (status_step, revision_step, batch_step) = if scope == graph::NODES {
+            ("graph_node_index_status", "graph_node_index_revision", "graph_node_index_batch")
+        } else {
+            ("graph_edge_index_status", "graph_edge_index_revision", "graph_edge_index_batch")
+        };
+        let meta = database::trace_preparation(status_step, || metadata::graph(c,scope))?;
+        let needs_batch = if meta.status != "ready" {
+            true
+        } else {
+            let revision = database::trace_preparation(revision_step, || database::revision(c,scope))?;
+            meta.revision != revision.to_string()
+        };
+        if needs_batch {
+            let result = database::trace_preparation(batch_step, || super::super::prepare::prepare(c,scope,max_rows,max_bytes).context(PrerequisitePhase(phase)))?;
+            return Ok(Some(response(project,saved,"preparing",phase,result["processed"].as_u64().unwrap_or(0) as usize,true,None)));
+        }
+    }
+    for (name,prepare_step) in [("sessions","sessions_authority_prepare"),("summaries","summaries_authority_prepare")] {
+        let status = database::trace_preparation("project_authority_catalog_status", || project_catalog::status(c))?;
+        if status[name]["status"] != "ready" {
+            if status[name]["status"] == "partial" {
+                return Ok(Some(response(project,saved,"preparing","authority",0,false,Some("project_authority_incomplete"))));
+            }
+            let result = database::trace_preparation(prepare_step, || project_catalog::prepare(c,name,max_rows,max_bytes).context(PrerequisitePhase("authority")))?;
+            if result["reason"] == "preparation_resource_limit" {
+                database::DecodeWorkGuard::note_required(result["required_bytes"].as_u64().unwrap_or(max_bytes as u64 + 1) as usize);
+                return Err(super::super::request::resource()).context(PrerequisitePhase("authority"));
+            }
+            let more = result["status"] == "ready" || (result["status"] != "partial" && result["processed"].as_u64().unwrap_or(0) > 0);
+            return Ok(Some(response(project,saved,"preparing","authority",result["processed"].as_u64().unwrap_or(0) as usize,more,if more {None} else {Some("project_authority_incomplete")})));
+        }
+    }
+    let meta = database::trace_preparation("observation_index_status", || semantic::get(c,"observations"))?;
+    if database::trace_preparation("observation_source_kind", || source::kind(c,"observations"))?.is_none() {
+        return Ok(Some(response(project,saved,"preparing","observations",0,false,Some("observation_source_unavailable"))));
+    }
+    let observation_needs_batch = if meta.status != "ready" {
+        true
+    } else {
+        let revision = database::trace_preparation("observation_index_revision", || database::revision(c,&meta.scope()))?;
+        meta.revision != revision.to_string()
+    };
+    if observation_needs_batch {
+        let result = database::trace_preparation("observation_index_batch", || super::super::prepare::prepare(c,&meta.scope(),max_rows,max_bytes).context(PrerequisitePhase("observation_index")))?;
+        return Ok(Some(response(project,saved,"preparing","observation_index",result["processed"].as_u64().unwrap_or(0) as usize,true,None)));
+    }
+    if database::trace_preparation("observation_source_pending_status", || source::pending_scope(c,"observations"))?.is_some() {
+        let result = database::trace_preparation("observation_source_batch", || source::prepare(c,"observations",max_rows,max_bytes).context(PrerequisitePhase("observation_sources")))?;
+        return Ok(Some(response(project,saved,"preparing","observation_sources",result["processed"].as_u64().unwrap_or(0) as usize,true,None)));
+    }
+    if !database::trace_preparation("observation_session_index_status", || project_vectors::ready(c,"observations",meta.epoch))? {
+        let result = database::trace_preparation("observation_session_index_batch", || project_vectors::prepare(c,"observations",max_rows,max_bytes).context(PrerequisitePhase("observation_sessions")))?;
+        return Ok(Some(response(project,saved,"preparing","observation_sessions",result["processed"].as_u64().unwrap_or(0) as usize,true,None)));
+    }
+    if !database::trace_preparation("project_observations_status", || scoped::ready(c,"observations",meta.epoch,project,true))? {
+        let result = database::trace_preparation("project_observation_session_ref_batch", || scoped::prepare_browse(c,"observations",project,max_rows,max_bytes).context(PrerequisitePhase("project_observations")))?;
+        let processed = result["processed"].as_u64().unwrap_or(0) as usize;
+        let reason = result["reason"].as_str();
+        let more = processed > 0 || result["status"] == "pending" || result["status"] == "ready";
+        return Ok(Some(response(project,saved,"preparing","project_observations",processed,more,if more {None} else {reason.or(Some("project_observations_unavailable"))})));
+    }
+    Ok(None)
+}
+
+fn compact_batch(c: &Connection, scope: &str, epoch: i64, after: &str, max_rows: usize, max_bytes: usize) -> anyhow::Result<(String,usize,bool)> {
+    let (table, fields) = if scope == graph::NODES { ("retrieval_nodes","display_name IS NULL OR display_type IS NULL") } else { ("retrieval_edges","display_type IS NULL OR display_weight IS NULL") };
+    let sql = format!("SELECT n.key,r.value_bytes FROM {table} n LEFT JOIN state_rows r ON r.scope=?4 AND r.key=n.key AND r.value IS NOT NULL WHERE n.epoch=?1 AND n.key>?2 AND ({fields}) ORDER BY n.key LIMIT ?3");
+    let mut statement = c.prepare(&sql)?;
+    let keys = statement.query_map(params![epoch,after,(max_rows+1) as i64,scope],|r|Ok((r.get::<_,String>(0)?,r.get::<_,Option<i64>>(1)?)))?.collect::<rusqlite::Result<Vec<_>>>()?;
+    let mut cursor = after.to_owned();
+    let mut processed = 0;
+    let mut decoded_bytes = 0usize;
+    for (key,logical) in keys.iter().take(max_rows) {
+        let logical = logical.and_then(|v|usize::try_from(v).ok()).filter(|v|*v>0 && *v<=super::super::super::codec::MAX_LOGICAL_VALUE_BYTES).ok_or_else(||super::super::super::protocol::error("STATE_INDEX_RECORD_INVALID"))?;
+        let needed = database::row_work(c,scope,key)?.max(logical);
+        if decoded_bytes.saturating_add(needed)>max_bytes { if processed==0 { database::DecodeWorkGuard::note_required(needed); return Err(super::super::request::resource()); } break; }
+        let value = database::row(c,scope,key).map_err(|_|super::super::super::protocol::error("STATE_INDEX_RECORD_INVALID"))?.value.ok_or_else(|| super::super::super::protocol::error("STATE_INDEX_RECORD_INVALID"))?;
+        compact::update(c,scope,epoch,key,&value)?;
+        cursor = key.clone();
+        processed += 1;
+        decoded_bytes += needed;
+    }
+    Ok((cursor,processed,processed==keys.len()))
+}
+
+fn batch(c: &Connection, project: &str, max_rows: usize, max_bytes: usize) -> anyhow::Result<Value> {
+    let Some(epochs) = state::epochs(c)? else {
+        return Ok(json!({"scope":super::SCOPE,"project":project,"status":"preparing","phase":"observations","processed":0,"revision":null,"continue":false,"reason":"observation_index_unavailable"}));
+    };
+    let saved = state::ensure(c,project,&epochs)?;
+    if let Some(result) = prerequisite(c,project,&saved,max_rows,max_bytes)? { return Ok(result) }
+    if saved.status == "ready" && !dirty::pending(c,project)? {
+        return Ok(response(project,&saved,"ready","ready",0,false,None));
+    }
+    let (phase,cursor,processed) = match saved.phase.as_str() {
+        "cleanup" => {
+            let processed=c.execute("DELETE FROM browse_nodes WHERE project=?1 AND (generation,key) IN(SELECT generation,key FROM browse_nodes WHERE project=?1 AND generation<>?2 ORDER BY generation,key LIMIT ?3)",params![project,saved.generation,max_rows as i64])?;
+            (if processed<max_rows {"compact_nodes"} else {"cleanup"},String::new(),processed)
+        }
+        "compact_nodes" | "compact_edges" => {
+            let nodes = saved.phase == "compact_nodes";
+            let (cursor,processed,complete) = compact_batch(c,if nodes {graph::NODES} else {graph::EDGES},if nodes {epochs.nodes} else {epochs.edges},&saved.cursor,max_rows,max_bytes)?;
+            (if complete { if nodes {"compact_edges"} else {"membership"} } else {saved.phase.as_str()},if complete {String::new()} else {cursor},processed)
+        }
+        "membership" => {
+            let (cursor,processed,complete) = membership::seed(c,project,&saved,&epochs,max_rows)?;
+            (if complete {"dirty"} else {"membership"},if complete {String::new()} else {cursor},processed)
+        }
+        "dirty" | "ready" => {
+            let processed = dirty::drain(c,project,max_rows)?;
+            if !dirty::pending(c,project)? && state::epochs(c)?.as_ref() == Some(&epochs) {
+                let changed = c.execute("UPDATE browse_projects SET status='ready',phase='ready',cursor='',revision=revision+1,progress=progress+?4,last_error=NULL WHERE project=?1 AND generation=?2 AND input_epochs=?3 AND revision<9007199254740990",params![project,saved.generation,serde_json::to_string(&epochs)?,processed as i64])?;
+                super::super::super::protocol::require(changed == 1)?;
+                let ready = state::project(c,project)?.unwrap();
+                return Ok(response(project,&ready,"ready","ready",processed,false,None));
+            }
+            ("dirty",String::new(),processed)
+        }
+        _ => return Err(super::super::super::protocol::error("STATE_TX_FAILED")),
+    };
+    state::save(c,project,&saved,phase,&cursor,processed)?;
+    let saved = state::project(c,project)?.unwrap();
+    Ok(response(project,&saved,"preparing",phase,processed,true,None))
+}
+
+pub fn prepare(c: &Connection, project: &str, max_rows: usize, max_bytes: usize) -> anyhow::Result<Value> {
+    super::super::super::protocol::require(!project.trim().is_empty() && project.len() <= 256 && (1..=1024).contains(&max_rows) && (1024..=super::super::request::MAX_GRAPH_PREPARATION_WORK_BYTES).contains(&max_bytes))?;
+    if let Some(epochs)=state::epochs(c)? { state::ensure(c,project,&epochs)?; }
+    database::trace_preparation("graph_browse_savepoint", || { c.execute_batch("SAVEPOINT graph_browse_prepare")?; Ok(()) })?;
+    let work = database::DecodeWorkGuard::new(max_bytes);
+    let result = batch(c,project,max_rows,max_bytes).map_err(|error| {
+        let phase = error.downcast_ref::<PrerequisitePhase>().map_or("projection", |phase|phase.0);
+        let code = error.downcast_ref::<super::super::super::protocol::TxError>().map(|error|error.0);
+        let failure = if database::check_preparation().is_err() { "deadline_or_cancellation" }
+            else if work.required()>0 { "stored_logical_decode_exhaustion" }
+            else if code.is_some_and(|code|["STATE_TX_INVALID_REQUEST","STATE_INDEX_RECORD_INVALID"].contains(&code)) { "invalid_prerequisite" }
+            else if code==Some("STATE_RETRIEVAL_RESOURCE_LIMIT") { "prerequisite_resource_limit" }
+            else { "prerequisite_transaction_failure" };
+        let operation_id = database::active_preparation_id().map_or_else(String::new, |id| id.to_string());
+        tracing::warn!(operation_id=%operation_id, failure_class=failure, prerequisite=phase, required_bytes=work.required(), max_bytes,
+            "graph preparation refused; durable checkpoint requires reconciliation");
+        if work.required()>0 {
+            super::super::request::resource().context(PrerequisitePhase(phase))
+        } else { error }
+    });
+    match result {
+        Ok(value) => { database::trace_preparation("graph_browse_savepoint_release", || { c.execute_batch("RELEASE graph_browse_prepare")?; Ok(()) })?; Ok(value) }
+        Err(error) if error.downcast_ref::<super::super::super::protocol::TxError>().is_some_and(|e|["STATE_TX_INVALID_REQUEST","STATE_INDEX_RECORD_INVALID","STATE_RETRIEVAL_RESOURCE_LIMIT"].contains(&e.0)) => {
+            database::trace_preparation("graph_browse_savepoint_rollback", || { c.execute_batch("ROLLBACK TO graph_browse_prepare; RELEASE graph_browse_prepare")?; Ok(()) })?;
+            let reason = if error.downcast_ref::<super::super::super::protocol::TxError>().is_some_and(|e|e.0=="STATE_RETRIEVAL_RESOURCE_LIMIT") {"preparation_resource_limit"} else {"index_record_invalid"};
+            c.execute("UPDATE browse_projects SET status='error',last_error=?2 WHERE project=?1",params![project,reason])?;
+            if let Some(saved) = state::project(c,project)? {
+                let phase = error.downcast_ref::<PrerequisitePhase>().map_or(saved.phase.as_str(), |phase|phase.0);
+                let mut output = response(project,&saved,"error",phase,0,false,Some(reason));
+                if work.required()>0 { output["required_bytes"] = json!(work.required()); }
+                Ok(output)
+            } else {
+                Ok(json!({"scope":super::SCOPE,"project":project,"status":"error","phase":"prerequisites","processed":0,"revision":null,"continue":false,"reason":reason,"required_bytes":work.required()}))
+            }
+        }
+        Err(error) => { database::trace_preparation("graph_browse_savepoint_rollback", || { c.execute_batch("ROLLBACK TO graph_browse_prepare; RELEASE graph_browse_prepare")?; Ok(()) })?; Err(error) }
+    }
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/graph_browse/state.rs b/engine/src/workers/state/adapters/sqlite/retrieval/graph_browse/state.rs
new file mode 100644
index 0000000..2bc66bd
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/graph_browse/state.rs
@@ -0,0 +1,84 @@
+use super::super::{graph, metadata};
+use rusqlite::{Connection, OptionalExtension, params};
+use serde::{Deserialize, Serialize};
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+pub struct Epochs {
+    pub nodes: i64,
+    pub edges: i64,
+    pub vectors: i64,
+    pub sessions: i64,
+    pub summaries: i64,
+}
+
+pub struct Project {
+    pub generation: i64,
+    pub status: String,
+    pub phase: String,
+    pub cursor: String,
+    pub input_epochs: Option<Epochs>,
+    pub revision: i64,
+    pub progress: i64,
+    pub last_error: Option<String>,
+}
+
+fn add_column(c: &Connection, table: &str, name: &str, kind: &str) -> anyhow::Result<()> {
+    let mut statement = c.prepare(&format!("PRAGMA table_info({table})"))?;
+    let names = statement.query_map([], |r| r.get::<_, String>(1))?.collect::<rusqlite::Result<Vec<_>>>()?;
+    if !names.iter().any(|column| column == name) {
+        c.execute_batch(&format!("ALTER TABLE {table} ADD COLUMN {name} {kind}"))?;
+    }
+    Ok(())
+}
+
+pub fn schema(c: &Connection) -> anyhow::Result<()> {
+    add_column(c, "retrieval_nodes", "display_name", "TEXT")?;
+    add_column(c, "retrieval_nodes", "display_type", "TEXT")?;
+    add_column(c, "retrieval_edges", "display_type", "TEXT")?;
+    add_column(c, "retrieval_edges", "display_weight", "REAL")?;
+    c.execute_batch("CREATE TABLE IF NOT EXISTS browse_projects(project TEXT PRIMARY KEY,generation INTEGER NOT NULL,status TEXT NOT NULL,phase TEXT NOT NULL,cursor TEXT NOT NULL,input_epochs TEXT,revision INTEGER NOT NULL,progress INTEGER NOT NULL,last_error TEXT) WITHOUT ROWID;
+        CREATE TABLE IF NOT EXISTS browse_nodes(project TEXT NOT NULL,generation INTEGER NOT NULL,key TEXT NOT NULL,PRIMARY KEY(project,generation,key)) WITHOUT ROWID;
+        CREATE INDEX IF NOT EXISTS browse_nodes_key ON browse_nodes(key,project,generation);
+        CREATE TABLE IF NOT EXISTS browse_dirty(kind TEXT NOT NULL,key TEXT NOT NULL,version INTEGER NOT NULL,cursor TEXT NOT NULL,PRIMARY KEY(kind,key)) WITHOUT ROWID;
+        CREATE INDEX IF NOT EXISTS retrieval_edges_pair ON retrieval_edges(epoch,source,target,key);
+        CREATE INDEX IF NOT EXISTS retrieval_scoped_vectors_project ON retrieval_scoped_vectors(index_id,epoch,project,kind,session,id);
+        CREATE INDEX IF NOT EXISTS retrieval_scoped_vectors_session ON retrieval_scoped_vectors(index_id,epoch,session,id);")?;
+    Ok(())
+}
+
+pub fn epochs(c: &Connection) -> anyhow::Result<Option<Epochs>> {
+    let vectors: Option<i64> = c.query_row("SELECT epoch FROM retrieval_semantic_meta WHERE index_id='observations'",[],|r|r.get(0)).optional()?;
+    let Some(vectors) = vectors else { return Ok(None) };
+    Ok(Some(Epochs {
+        nodes: metadata::graph(c, graph::NODES)?.epoch,
+        edges: metadata::graph(c, graph::EDGES)?.epoch,
+        vectors,
+        sessions: c.query_row("SELECT epoch FROM retrieval_project_catalog WHERE source='sessions'", [], |r| r.get(0))?,
+        summaries: c.query_row("SELECT epoch FROM retrieval_project_catalog WHERE source='summaries'", [], |r| r.get(0))?,
+    }))
+}
+
+pub fn project(c: &Connection, name: &str) -> anyhow::Result<Option<Project>> {
+    let row: Option<(i64,String,String,String,Option<String>,i64,i64,Option<String>)> = c.query_row(
+        "SELECT generation,status,phase,cursor,input_epochs,revision,progress,last_error FROM browse_projects WHERE project=?1", [name],
+        |r| Ok((r.get(0)?,r.get(1)?,r.get(2)?,r.get(3)?,r.get(4)?,r.get(5)?,r.get(6)?,r.get(7)?))).optional()?;
+    row.map(|(generation,status,phase,cursor,input_epochs,revision,progress,last_error)| Ok(Project {
+        generation,status,phase,cursor,input_epochs:input_epochs.map(|v| serde_json::from_str(&v)).transpose()?,revision,progress,last_error,
+    })).transpose()
+}
+
+pub fn ensure(c: &Connection, name: &str, epochs: &Epochs) -> anyhow::Result<Project> {
+    c.execute("INSERT OR IGNORE INTO browse_projects VALUES(?1,1,'preparing','compact_nodes','',?2,1,0,NULL)", params![name,serde_json::to_string(epochs)?])?;
+    let mut saved = project(c, name)?.unwrap();
+    if saved.input_epochs.as_ref() != Some(epochs) {
+        c.execute("UPDATE browse_projects SET generation=generation+1,status='preparing',phase='cleanup',cursor='',input_epochs=?2,revision=revision+1,progress=0,last_error=NULL WHERE project=?1 AND generation<9007199254740990 AND revision<9007199254740990", params![name,serde_json::to_string(epochs)?])?;
+        saved = project(c, name)?.unwrap();
+        super::super::super::protocol::require(saved.input_epochs.as_ref() == Some(epochs))?;
+    }
+    Ok(saved)
+}
+
+pub fn save(c: &Connection, name: &str, saved: &Project, phase: &str, cursor: &str, processed: usize) -> anyhow::Result<()> {
+    c.execute("UPDATE browse_projects SET status='preparing',phase=?3,cursor=?4,progress=progress+?5,last_error=NULL WHERE project=?1 AND generation=?2",params![name,saved.generation,phase,cursor,processed as i64])?;
+    Ok(())
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/graph_query.rs b/engine/src/workers/state/adapters/sqlite/retrieval/graph_query.rs
new file mode 100644
index 0000000..fffb108
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/graph_query.rs
@@ -0,0 +1,243 @@
+use super::super::{commit, database, protocol};
+use super::{
+    graph, metadata,
+    request::{self, NameMatch},
+};
+use rusqlite::{Connection, params};
+use serde_json::{Value, json};
+
+const MAX_CANDIDATE_VISITS: usize = 131_072;
+
+fn begin(connection: &Connection, scope: &str) -> anyhow::Result<i64> {
+    commit::read_allowed(connection, scope, "", None)?;
+    let epoch = metadata::ready_graph(connection, scope)?;
+    connection.execute_batch("DELETE FROM retrieval_selected;")?;
+    Ok(epoch)
+}
+
+fn selected(
+    connection: &Connection,
+    key: &str,
+    position: i64,
+    entity: bool,
+    observation: bool,
+    max_items: usize,
+) -> anyhow::Result<()> {
+    connection.execute("INSERT INTO retrieval_selected VALUES(?1,?2,?3,?4) ON CONFLICT(key) DO UPDATE SET entity=MAX(entity,excluded.entity),observation=MAX(observation,excluded.observation)", params![key,position,entity,observation])?;
+    let count: i64 =
+        connection.query_row("SELECT count(*) FROM retrieval_selected", [], |r| r.get(0))?;
+    if count > max_items as i64 {
+        return Err(request::resource());
+    }
+    Ok(())
+}
+
+fn select_names(
+    connection: &Connection,
+    sql: &str,
+    epoch: i64,
+    term: &str,
+    query: &str,
+    mode: NameMatch,
+    visits: &mut usize,
+    max_items: usize,
+) -> anyhow::Result<()> {
+    let mut statement = connection.prepare_cached(sql)?;
+    let mut rows = statement.query(params![epoch, term])?;
+    while let Some(row) = rows.next()? {
+        *visits += 1;
+        if *visits > MAX_CANDIDATE_VISITS {
+            return Err(request::resource());
+        }
+        let name: String = row.get(1)?;
+        let matched = match mode {
+            NameMatch::Exact => name == query,
+            NameMatch::Substring => name.contains(query) || query.contains(&name),
+        };
+        if matched {
+            selected(
+                connection,
+                &row.get::<_, String>(0)?,
+                row.get(2)?,
+                true,
+                false,
+                max_items,
+            )?;
+        }
+    }
+    Ok(())
+}
+
+fn generation(connection: &Connection) -> anyhow::Result<Value> {
+    let control = database::row(connection, database::CONTROL_SCOPE, "current")?
+        .value
+        .ok_or_else(|| protocol::error("STATE_TX_FAILED"))?;
+    Ok(control["generation"].clone())
+}
+
+pub fn seeds(
+    connection: &Connection,
+    names: &[String],
+    observations: &[String],
+    mode: NameMatch,
+    max_items: usize,
+    max_bytes: usize,
+) -> anyhow::Result<Value> {
+    let epoch = begin(connection, graph::NODES)?;
+    let mut visits = 0;
+    for query in names {
+        let query = query.to_lowercase();
+        if mode == NameMatch::Exact {
+            select_names(
+                connection,
+                "SELECT key,name,position FROM retrieval_nodes INDEXED BY retrieval_nodes_name WHERE epoch=?1 AND name=?2",
+                epoch,
+                &query,
+                &query,
+                mode,
+                &mut visits,
+                max_items,
+            )?;
+            continue;
+        }
+        if query.is_empty() {
+            select_names(
+                connection,
+                "SELECT key,name,position FROM retrieval_nodes WHERE epoch=?1 AND ?2=''",
+                epoch,
+                "",
+                "",
+                mode,
+                &mut visits,
+                max_items,
+            )?;
+            continue;
+        }
+        let anchor: String = query.chars().take(3).collect();
+        select_names(
+            connection,
+            "SELECT n.key,n.name,n.position FROM retrieval_name_grams g CROSS JOIN retrieval_nodes n WHERE g.epoch=?1 AND g.gram=?2 AND n.epoch=g.epoch AND n.key=g.key",
+            epoch,
+            &anchor,
+            &query,
+            mode,
+            &mut visits,
+            max_items,
+        )?;
+        for width in 1..=3 {
+            for prefix in graph::grams(&query, width) {
+                select_names(
+                    connection,
+                    "SELECT key,name,position FROM retrieval_nodes INDEXED BY retrieval_nodes_prefix WHERE epoch=?1 AND prefix=?2",
+                    epoch,
+                    &prefix,
+                    &query,
+                    mode,
+                    &mut visits,
+                    max_items,
+                )?;
+            }
+        }
+        select_names(
+            connection,
+            "SELECT key,name,position FROM retrieval_nodes INDEXED BY retrieval_nodes_name WHERE epoch=?1 AND name=?2",
+            epoch,
+            "",
+            &query,
+            mode,
+            &mut visits,
+            max_items,
+        )?;
+    }
+    let mut statement = connection.prepare_cached(
+        "SELECT k.value,m.position FROM retrieval_membership m CROSS JOIN retrieval_identifiers k ON k.epoch=m.epoch AND k.id=m.key WHERE m.epoch=?1 AND m.observation=(SELECT id FROM retrieval_identifiers WHERE epoch=?1 AND value=?2) ORDER BY k.value",
+    )?;
+    for observation in observations {
+        let mut rows = statement.query(params![epoch, observation])?;
+        while let Some(row) = rows.next()? {
+            visits += 1;
+            if visits > MAX_CANDIDATE_VISITS {
+                return Err(request::resource());
+            }
+            selected(
+                connection,
+                &row.get::<_, String>(0)?,
+                row.get(1)?,
+                false,
+                true,
+                max_items,
+            )?;
+        }
+    }
+    let mut output = Vec::new();
+    let mut bytes = 256;
+    let mut statement = connection.prepare(
+        "SELECT key,position,entity,observation FROM retrieval_selected ORDER BY position",
+    )?;
+    let mut rows = statement.query([])?;
+    while let Some(row) = rows.next()? {
+        let key: String = row.get(0)?;
+        let position: i64 = row.get(1)?;
+        let item = json!({"key":key,"id":key,"position":position.to_string(),"entity":row.get::<_,bool>(2)?,"observation":row.get::<_,bool>(3)?});
+        bytes += protocol::size(&item)? + 1;
+        if bytes > max_bytes {
+            return Err(request::resource());
+        }
+        output.push(item);
+    }
+    Ok(json!({"items":output,"generation":generation(connection)?}))
+}
+
+pub fn edges(
+    connection: &Connection,
+    node_ids: &[String],
+    max_items: usize,
+    max_bytes: usize,
+) -> anyhow::Result<Value> {
+    let epoch = begin(connection, graph::EDGES)?;
+    let mut visits = 0;
+    for node in node_ids {
+        for sql in [
+            "SELECT key,position FROM retrieval_edges INDEXED BY retrieval_edges_source WHERE epoch=?1 AND source=?2",
+            "SELECT key,position FROM retrieval_edges INDEXED BY retrieval_edges_target WHERE epoch=?1 AND target=?2",
+        ] {
+            let mut statement = connection.prepare_cached(sql)?;
+            let mut rows = statement.query(params![epoch, node])?;
+            while let Some(row) = rows.next()? {
+                visits += 1;
+                if visits > MAX_CANDIDATE_VISITS {
+                    return Err(request::resource());
+                }
+                selected(
+                    connection,
+                    &row.get::<_, String>(0)?,
+                    row.get(1)?,
+                    false,
+                    false,
+                    max_items,
+                )?;
+            }
+        }
+    }
+    let mut statement = connection.prepare("SELECT s.key,s.position,r.value,r.value_bytes FROM retrieval_selected s CROSS JOIN state_rows r WHERE r.scope=?1 AND r.key=s.key AND r.value IS NOT NULL ORDER BY s.position")?;
+    let mut rows = statement.query([graph::EDGES])?;
+    let mut output = Vec::new();
+    let mut bytes = 256;
+    while let Some(row) = rows.next()? {
+        let raw_bytes: i64 = row.get(3)?;
+        if raw_bytes < 0 || raw_bytes as usize > max_bytes.saturating_sub(bytes) {
+            return Err(request::resource());
+        }
+        let encoded: Vec<u8> = row.get(2)?;
+        let value: Value = serde_json::from_str(&database::decode_value(&encoded, raw_bytes)?)?;
+        let position: i64 = row.get(1)?;
+        let item =
+            json!({"key":row.get::<_,String>(0)?,"position":position.to_string(),"value":value});
+        bytes += protocol::size(&item)? + 1;
+        if bytes > max_bytes {
+            return Err(request::resource());
+        }
+        output.push(item);
+    }
+    Ok(json!({"items":output,"generation":generation(connection)?}))
+}
