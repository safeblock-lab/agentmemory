+        .list_page("metadata", None, 1, 1_048_576)
+        .await
+        .unwrap();
+    let exact = protocol::size(&page).unwrap() as u32;
+    assert_eq!(
+        adapter
+            .list_page("metadata", None, 1, exact)
+            .await
+            .unwrap()
+            .items,
+        page.items
+    );
+    assert!(
+        matches!(adapter.list_page("metadata", None, 1, exact - 1).await,
+        Err(StatePageError::RecordTooLarge { required_bytes }) if required_bytes == exact as usize)
+    );
+    adapter
+        .run(4096, |connection| {
+            connection.execute(
+                "UPDATE state_rows SET value_bytes=-1 WHERE scope='metadata'",
+                [],
+            )?;
+            Ok(())
+        })
+        .await
+        .unwrap();
+    assert!(matches!(
+        adapter.list_page("metadata", None, 1, 1024).await,
+        Err(StatePageError::Internal)
+    ));
+    adapter
+        .run(4096, |connection| {
+            connection.execute(
+                "UPDATE state_rows SET value_bytes=2e19 WHERE scope='metadata'",
+                [],
+            )?;
+            Ok(())
+        })
+        .await
+        .unwrap();
+    assert!(matches!(
+        adapter.list_page("metadata", None, 1, 1024).await,
+        Err(StatePageError::Internal)
+    ));
+    adapter
+        .run(4096, |connection| {
+            connection.execute(
