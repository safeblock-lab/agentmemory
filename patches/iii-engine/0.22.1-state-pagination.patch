+fn add_node(c: &Connection, id: i64, project: i64) {
+    let key = format!("node-{id:04}");
+    let observation = format!("obs-{id:04}");
+    let session = if project == 1 { "target-session" } else { "foreign-session" };
+    c.execute("INSERT INTO retrieval_nodes VALUES(1,?1,?2,?1,'concept')", params![key,id]).unwrap();
+    c.execute("INSERT INTO state_rows VALUES('mem:graph:nodes',?1,'1',x'01')", [&key]).unwrap();
+    c.execute("INSERT INTO retrieval_identifiers VALUES(?1,1,?2)", params![id*2,key]).unwrap();
+    c.execute("INSERT INTO retrieval_identifiers VALUES(?1,1,?2)", params![id*2+1,observation]).unwrap();
+    c.execute("INSERT INTO retrieval_membership VALUES(1,?1,?2,?3)", params![id*2+1,id*2,id]).unwrap();
+    c.execute("INSERT INTO retrieval_scoped_vectors VALUES('observations',3,?1,?2,1,0,?3,2)", params![observation,project,project*10]).unwrap();
+    c.execute("INSERT INTO retrieval_source_items VALUES('observations',?1,?2,'1',0)", params![format!("mem:obs:{session}"),observation]).unwrap();
+    c.execute("INSERT INTO state_rows VALUES(?1,?2,'1',x'01')", params![format!("mem:obs:{session}"),observation]).unwrap();
+}
+
+fn plan(c: &Connection, sql: &str) -> Vec<String> {
+    c.prepare(&format!("EXPLAIN QUERY PLAN {sql}")).unwrap()
+        .query_map(params![1,3,"target",2,16], |row| row.get(3)).unwrap()
+        .collect::<rusqlite::Result<Vec<_>>>().unwrap()
+}
+
+fn measured_ranking(c: &Connection, sql: &str) -> (Vec<(String,i64)>,i32) {
+    let mut statement = c.prepare(sql).unwrap();
+    let items = statement.query_map(params![1,3,"target",2,16], |row| Ok((row.get(0)?,row.get(3)?))).unwrap()
+        .collect::<rusqlite::Result<Vec<_>>>().unwrap();
+    (items,statement.get_status(StatementStatus::VmStep))
+}
+
+fn original_ranking_sql(summary_authority_ready: bool) -> String {
+    let authority=node_project_predicate("n.key",summary_authority_ready);
+    let source=node_project_predicate("e.source",summary_authority_ready);
+    let target=node_project_predicate("e.target",summary_authority_ready);
+    let degree=format!("(SELECT count(*) FROM retrieval_edges e INDEXED BY retrieval_edges_source WHERE e.epoch=?4 AND e.source=n.key AND {source} AND {target})+(SELECT count(*) FROM retrieval_edges e INDEXED BY retrieval_edges_target WHERE e.epoch=?4 AND e.target=n.key AND {source} AND {target})");
+    format!("SELECT n.key,n.position,n.display_name,({degree}) AS degree FROM retrieval_nodes n JOIN state_rows s ON s.scope='mem:graph:nodes' AND s.key=n.key AND s.value IS NOT NULL WHERE n.epoch=?1 AND n.display_type='concept' AND length(trim(n.display_name))>0 AND {authority} ORDER BY degree DESC,n.position,n.key LIMIT ?5")
+}
+
+fn add_edge(c: &Connection, key: &str, source: i64, target: i64) {
+    c.execute("INSERT INTO retrieval_edges VALUES(2,?1,?2,?3,0)",params![key,format!("node-{source:04}"),format!("node-{target:04}")]).unwrap();
+}
+
+fn assert_ranking(c: &Connection, summary_authority_ready: bool, expected: Vec<(String,i64)>) {
+    let actual=measured_ranking(c,&ranking_sql(summary_authority_ready)).0;
+    assert_eq!(actual,measured_ranking(c,&original_ranking_sql(summary_authority_ready)).0);
+    assert_eq!(actual,expected);
+}
