+#[test]
+fn canonical_decay_rejects_removed_backwards_and_invalid_last_decay_markers() {
+    let c = fresh();
+    write(
+        &c,
+        "mem:sessions",
+        "s",
+        Some(&json!({"id":"s","project":"p"})),
+    );
+    let mut previous = fact("a", "Fact");
+    previous["lastDecayAt"] = json!("2026-10-09T01:00:00Z");
+    write(&c, SCOPE, "a", Some(&previous));
+    prepare_all(&c, SCOPE);
+    let old = database::row(&c, SCOPE, "a").unwrap();
+    for at in [None, Some("2026-10-09T00:00:00Z"), Some("invalid")] {
+        let mut next = previous.clone();
+        next["strength"] = json!(0.5);
+        match at {
+            Some(at) => next["lastDecayAt"] = json!(at),
+            None => {
+                next.as_object_mut().unwrap().remove("lastDecayAt");
+            }
+        }
+        let mut value = application(&c, SCOPE, "", "fact", "a", next, 'd');
+        value["operation_kind"] = json!("decay");
+        value["source_session_ids"] = json!(["s"]);
+        value["source_project"] = json!("p");
+        assert_eq!(
+            code(call(&c, value.clone()).unwrap_err()),
+            "STATE_TX_INVALID_REQUEST"
+        );
+        assert_eq!(
+            call(&c, probe(&value, true)).unwrap()["status"],
+            "not_applied"
+        );
+        let current = database::row(&c, SCOPE, "a").unwrap();
+        assert_eq!(current.version, old.version);
+        assert_eq!(current.value, old.value);
+    }
+}
