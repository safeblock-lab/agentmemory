+#[test]
+fn project_catalog_unknowns_returns_two_distinct_metadata_only_records() {
+    let connection = fresh();
+    unknown_summary(
+        &connection,
+        "summary-z",
+        json!({"sessionId":"session-z","body":"private-z"}),
+    );
+    unknown_summary(
+        &connection,
+        "summary-a",
+        json!({"sessionId":"session-a","body":"private-a"}),
+    );
+    write(
+        &connection,
+        "mem:sessions",
+        "session-unknown",
+        Some(&json!({"id":"session-unknown"})),
+    );
+
+    let page = diagnostics(&connection, "summaries", None, 16, 65_536).unwrap();
+    assert_eq!(page["status"], "partial");
+    assert_eq!(page["incomplete_rows"], "2");
+    let items = page["items"].as_array().unwrap();
+    assert_eq!(items.len(), 2);
+    assert_eq!(items[0]["key"], "summary-a");
+    assert_eq!(items[1]["key"], "summary-z");
+    for item in items {
+        assert_eq!(item["reason"], "missing_authority");
+        assert_eq!(item["reason_detail"], "project");
+        assert_eq!(item["version"], item["current_version"]);
+        assert!(item["logical_bytes"].as_i64().unwrap() > 0);
+        assert!(item["stored_bytes"].as_i64().unwrap() > 0);
+        assert!(item.get("value").is_none());
+    }
+    let text = page.to_string();
+    assert!(!text.contains("private-a"));
+    assert!(!text.contains("private-z"));
+
+    let sessions = diagnostics(&connection, "sessions", None, 16, 65_536).unwrap();
+    assert_eq!(sessions["items"].as_array().unwrap().len(), 1);
+    assert_eq!(sessions["items"][0]["key"], "session-unknown");
+}
