+++ b/engine/src/workers/state/adapters/sqlite/retrieval/crystals/tests.rs
@@ -0,0 +1,138 @@
+use super::*;
+
+fn fixture() -> Connection {
+    let c=Connection::open_in_memory().unwrap();
+    c.execute_batch("CREATE TABLE state_rows(scope TEXT NOT NULL,key TEXT NOT NULL,value BLOB,version TEXT NOT NULL,position INTEGER,value_bytes INTEGER NOT NULL,PRIMARY KEY(scope,key)) WITHOUT ROWID;").unwrap();
+    schema(&c).unwrap();
+    c
+}
+
+fn crystal(id:&str,project:&str,created:&str) -> Value {
+    json!({"id":id,"project":project,"sessionId":"session","createdAt":created,
+        "narrative":"complete narrative","keyOutcomes":["decision"],"filesAffected":["src/a.ts"],
+        "lessons":["lesson"],"sourceActionIds":["action-a","action-b"],"extraProvenance":{"retained":true}})
+}
+
+fn put(c:&Connection,key:&str,value:&Value,version:&str) {
+    let text=serde_json::to_string(value).unwrap();
+    c.execute("INSERT INTO state_rows VALUES(?1,?2,?3,?4,NULL,?5) ON CONFLICT(scope,key) DO UPDATE SET value=excluded.value,version=excluded.version,value_bytes=excluded.value_bytes",
+        params![SCOPE,key,text.as_bytes(),version,text.len() as i64]).unwrap();
+}
+
+fn ready(c:&Connection) {
+    for _ in 0..64 {
+        if prepare(c,256,1_048_576,25).unwrap()["ready"]==true {return;}
+    }
+    panic!("bounded crystal preparation did not finish");
+}
+
+fn code(error:anyhow::Error) -> &'static str {
+    error.downcast_ref::<protocol::TxError>().expect("expected typed crystal error").0
+}
+
+#[test]
+fn sparse_project_filters_before_limit_and_preserves_complete_rows() {
+    let c=fixture();
+    for i in 0..200 {let key=format!("a{i:03}");put(&c,&key,&crystal(&key,"other","2026-10-13T12:00:00Z"),"1");}
+    let expected=crystal("z","wanted","2026-10-12T12:00:00Z");
+    put(&c,"z",&expected,"1");ready(&c);
+    let before=c.total_changes();
+    let result=page(&c,Some("wanted"),None,None,16,65536).unwrap();
+    assert_eq!(result["crystals"],json!([expected]));
+    assert_eq!(result["partial"],false);
+    assert_eq!(result["total"],Value::Null);
+    assert_eq!(c.total_changes(),before);
+}
+
+#[test]
+fn keyset_orders_timestamp_then_id_and_binds_scope_revision() {
+    let c=fixture();
+    for (key,time) in [("b","2026-10-13T12:00:00Z"),("a","2026-10-13T14:00:00+02:00"),("c","2026-10-12T00:00:00Z")] {
+        put(&c,key,&crystal(key,"p",time),"1");
+    }
+    ready(&c);
+    let first=page(&c,Some("p"),Some("session"),None,1,65536).unwrap();
+    assert_eq!(first["crystals"][0]["id"],"a");
+    let cursor=first["nextCursor"].as_str().unwrap();
+    assert!(!cursor.starts_with('{'));
+    let second=page(&c,Some("p"),Some("session"),Some(cursor),1,65536).unwrap();
+    assert_eq!(second["crystals"][0]["id"],"b");
+    assert_eq!(code(page(&c,Some("other"),Some("session"),Some(cursor),1,65536).unwrap_err()),"STATE_TX_INVALID_REQUEST");
+    put(&c,"a",&crystal("a","p","2026-10-13T12:00:00Z"),"2");
+    assert_eq!(code(page(&c,Some("p"),Some("session"),Some(cursor),1,65536).unwrap_err()),"STATE_CRYSTAL_CURSOR_STALE");
+    assert_eq!(page(&c,Some("p"),None,None,16,65536).unwrap()["reason"],"crystal_index_preparing");
+}
+
+#[test]
+fn exact_envelope_byte_boundary_is_inclusive_and_oversize_is_not_truncated() {
+    let c=fixture();
+    let mut value=crystal("a","p","2026-10-13T12:00:00Z");
+    value["narrative"]=json!("");
+    let overhead=protocol::size(&response(true,&[value.clone()],false,None,None)).unwrap();
+    value["narrative"]=json!("x".repeat(65536-overhead));
+    put(&c,"a",&value,"1");ready(&c);
+    let exact=page(&c,Some("p"),None,None,16,65536).unwrap();
+    assert_eq!(protocol::size(&exact).unwrap(),65536);
+    assert_eq!(exact["crystals"],json!([value.clone()]));
+    value["narrative"]=json!(format!("{}x",value["narrative"].as_str().unwrap()));
+    put(&c,"a",&value,"2");ready(&c);
+    let over=page(&c,Some("p"),None,None,16,65536).unwrap();
+    assert_eq!(over["crystals"],json!([]));
+    assert_eq!(over["partial"],true);
+    assert_eq!(over["reason"],"record_too_large");
+    assert_eq!(over["nextCursor"],Value::Null);
+}
+
+#[test]
+fn deleted_invalid_and_corrupt_sources_are_reported_without_false_ready() {
+    let c=fixture();
+    let mut deleted=crystal("a","p","2026-10-13T12:00:00Z");deleted["deleted"]=json!(true);
+    put(&c,"a",&deleted,"1");
+    put(&c,"bad",&crystal("wrong-id","p","invalid"),"1");
+    c.execute("INSERT INTO state_rows VALUES(?1,'corrupt',X'FF','1',NULL,1)",[SCOPE]).unwrap();
+    ready(&c);
+    let result=page(&c,Some("p"),None,None,16,65536).unwrap();
+    assert_eq!(result["crystals"],json!([]));
+    assert_eq!(result["partial"],true);
+    assert_eq!(result["reason"],"unindexable_crystal_sources");
+    assert_eq!(status(&c).unwrap()["status"],"partial");
+}
+
+#[test]
+fn current_version_and_epoch_are_checked_even_if_projection_was_tampered() {
+    let c=fixture();put(&c,"a",&crystal("a","p","2026-10-13T12:00:00Z"),"2");ready(&c);
+    c.execute("UPDATE crystal_rows SET version='1' WHERE key='a'",[]).unwrap();
+    assert_eq!(code(page(&c,Some("p"),None,None,16,65536).unwrap_err()),"STATE_CRYSTAL_CURSOR_STALE");
+    c.execute("UPDATE crystal_rows SET version='2',epoch=0 WHERE key='a'",[]).unwrap();
+    assert_eq!(code(page(&c,Some("p"),None,None,16,65536).unwrap_err()),"STATE_CRYSTAL_EPOCH_STALE");
+    c.execute("UPDATE crystal_meta SET epoch=0",[]).unwrap();
+    assert_eq!(status(&c).unwrap()["ready"],false);
+}
+
+#[test]
+fn preparation_is_bounded_and_too_small_cut_reports_required_retry() {
+    let c=fixture();let mut value=crystal("a","p","2026-10-13T12:00:00Z");value["narrative"]=json!("x".repeat(2048));
+    put(&c,"a",&value,"1");
+    let cut=prepare(&c,1,1024,25).unwrap();
+    assert_eq!(cut["processed"],0);
+    assert_eq!(cut["reason"],"source_exceeds_preparation_bytes");
+    assert_eq!(cut["ready"],false);
+    ready(&c);
+    assert_eq!(page(&c,Some("p"),None,None,16,65536).unwrap()["crystals"][0],value);
+}
+
+#[test]
+fn sixteen_row_bound_and_global_session_filter_continue_without_duplicates() {
+    let c=fixture();
+    for i in 0..18 {let key=format!("a{i:02}");put(&c,&key,&crystal(&key,if i%2==0 {"p"}else{"q"},"2026-10-13T12:00:00Z"),"1");}
+    let mut other=crystal("other","p","2026-10-14T12:00:00Z");other["sessionId"]=json!("different");
+    put(&c,"other",&other,"1");ready(&c);
+    let first=page(&c,None,Some("session"),None,16,65536).unwrap();
+    assert_eq!(first["crystals"].as_array().unwrap().len(),16);
+    let second=page(&c,None,Some("session"),first["nextCursor"].as_str(),16,65536).unwrap();
+    assert_eq!(second["crystals"].as_array().unwrap().len(),2);
+    assert_eq!(second["crystals"][0]["id"],"a16");
+    assert_eq!(second["nextCursor"],Value::Null);
+    assert!(page(&c,None,None,None,17,65536).is_err());
+    assert!(page(&c,None,None,None,16,65537).is_err());
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/dispatch.rs b/engine/src/workers/state/adapters/sqlite/retrieval/dispatch.rs
