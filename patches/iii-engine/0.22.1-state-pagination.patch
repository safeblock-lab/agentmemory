+        connection.execute("INSERT INTO engine_graph_auto_terminal_proof_revisions(job_id,generation,job_version,checkpoint_version,revision,source_proven,previous_job_version,previous_checkpoint_version,previous_reason,previous_updated_at_ms) VALUES(?1,?2,?3,?4,?5,1,?3,?4,?6,?7) ON CONFLICT(job_id,generation) DO UPDATE SET job_version=excluded.job_version,checkpoint_version=excluded.checkpoint_version,revision=excluded.revision,source_proven=1,previous_job_version=excluded.previous_job_version,previous_checkpoint_version=excluded.previous_checkpoint_version,previous_reason=excluded.previous_reason,previous_updated_at_ms=excluded.previous_updated_at_ms",params![current.job_id,generation,job_version,checkpoint_version,adoption::REVISION,reason,updated])?;
