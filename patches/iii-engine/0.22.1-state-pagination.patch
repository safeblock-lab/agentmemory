+pub struct Schedule {
+    last_cut: Option<Instant>,
+    pages: u32,
+}
+impl Default for Schedule {
+    fn default() -> Self { Self {last_cut: None, pages: 1} }
+}
+
+// The serialized worker owns this temporary handler. Restore on every exit path,
+// including unwinding; ordinary operations retain their existing timeout policy.
+pub(super) struct Settings<'a> {
+    connection: &'a Connection,
+    busy_ms: u64,
+    restored: bool,
+}
+impl<'a> Settings<'a> {
+    pub(super) fn begin(connection: &'a Connection, started: Instant, budget: Duration) -> anyhow::Result<Self> {
+        let busy_ms: i64 = connection.pragma_query_value(None, "busy_timeout", |row| row.get(0))?;
+        let busy_ms = u64::try_from(busy_ms)?;
+        let guard = Self {connection, busy_ms, restored: false};
+        connection.busy_timeout(Duration::from_millis(1))?;
+        connection.progress_handler(100, Some(move || started.elapsed() >= budget))?;
+        Ok(guard)
+    }
+    pub(super) fn restore(&mut self) -> anyhow::Result<()> {
+        let progress = self.connection.progress_handler(0, None::<fn() -> bool>);
+        let busy = self.connection.busy_timeout(Duration::from_millis(self.busy_ms));
+        progress?;
+        busy?;
+        self.restored = true;
+        Ok(())
+    }
+}
+impl Drop for Settings<'_> {
+    fn drop(&mut self) {
+        if !self.restored {
+            if let Err(cause) = self.restore() {
+                tracing::error!(error = %cause, "state SQLite maintenance settings restore failed");
+            }
+        }
+    }
+}
+
+pub fn physical(connection: &Connection, path: &Path) -> anyhow::Result<Value> {
+    let mut result = storage_diagnostics::physical(connection, path)?;
+    result["sampled_at"] = json!(chrono::Utc::now().to_rfc3339_opts(chrono::SecondsFormat::Millis,true));
+    result["consistency"] = json!("physical_live");
+    Ok(result)
+}
+fn number(value: &Value, key: &str) -> u64 { value[key].as_u64().unwrap_or(0) }
+fn response(before: Value, after: Value, started: Instant, status: &str, reason: &str) -> Value {
+    let mode = number(&before, "auto_vacuum");
+    let pages = number(&before, "page_count").saturating_sub(number(&after, "page_count"));
+    let physical = number(&before, "database_bytes").saturating_sub(number(&after, "database_bytes"));
+    json!({"mode":if mode == 2 {"incremental"} else {"checkpoint_only"},
+        "requires_explicit_full_rebuild":mode == 0,"checkpoint_busy":false,
+        "wal_frames":0,"checkpointed_frames":0,"checkpoint_performed":false,
+        "status":status,"reason":reason,"elapsed_ms":started.elapsed().as_millis() as u64,
+        "pages_reclaimed":pages,"physical_bytes_reclaimed":physical,
+        "before":before,"after":after})
+}
+fn interrupted(cause: &rusqlite::Error) -> bool {
+    matches!(cause, rusqlite::Error::SqliteFailure(code, _)
+        if code.code == rusqlite::ErrorCode::OperationInterrupted)
+}
+fn busy(cause: &rusqlite::Error) -> bool {
+    matches!(cause, rusqlite::Error::SqliteFailure(code, _)
+        if matches!(code.code, rusqlite::ErrorCode::DatabaseBusy | rusqlite::ErrorCode::DatabaseLocked))
+}
+
+pub fn cut(connection: &Connection, path: &Path, schedule: &mut Schedule,
+    max_pages: u32, max_ms: u64, reserved: bool, pressure: impl Fn() -> bool,
+    lease_owner_id: &str, lease_fence: u64) -> anyhow::Result<Value> {
+    require((1..=16).contains(&max_pages) && (1..=25).contains(&max_ms)
+        && super::storage_maintenance_lease::valid_owner(lease_owner_id) && lease_fence > 0)?;
+    let started = Instant::now();
+    let budget = Duration::from_millis(max_ms);
+    let mut settings = Settings::begin(connection, started, budget)?;
+    if let Err(cause) = super::storage_maintenance_lease::validate_current(connection, lease_owner_id, lease_fence) {
+        let reason = if cause.downcast_ref::<rusqlite::Error>().is_some_and(busy) { Some("sqlite_busy") }
+            else if cause.downcast_ref::<rusqlite::Error>().is_some_and(interrupted) { Some("time_budget") }
+            else { None };
+        settings.restore()?;
+        if let Some(reason) = reason {
+            let before = physical(connection, path)?;
+            return Ok(response(before.clone(), before, started, "deferred", reason));
+        }
+        return Err(cause);
+    }
+    let before = physical(connection, path)?;
+    let defer = if number(&before, "auto_vacuum") == 0 { Some(("migration_required", "auto_vacuum_none")) }
+        else if number(&before, "auto_vacuum") != 2 { Some(("deferred", "auto_vacuum_not_incremental")) }
+        else if !reserved { Some(("deferred", "reclaim_in_flight")) }
+        else if pressure() { Some(("deferred", "foreground_pressure")) }
+        else if schedule.last_cut.is_some_and(|last| last.elapsed() < COOLDOWN) { Some(("deferred", "cooldown")) }
+        else if number(&before, "wal_bytes") > WAL_LIMIT { Some(("deferred", "wal_pressure")) }
+        else if number(&before, "freelist_count") == 0 { Some(("complete", "no_free_pages")) }
+        else { None };
+    if let Some((status, reason)) = defer {
+        settings.restore()?;
+        return Ok(response(before.clone(), before, started, status, reason));
+    }
+    let pages = schedule.pages.min(max_pages).clamp(1,16);
+    schedule.last_cut = Some(Instant::now());
+    let mut reason = "page_cut_complete";
+    let mut completed = 0;
+    let mut failure = None;
+    for _ in 0..pages {
+        if started.elapsed() >= budget { reason = "time_budget"; break; }
+        if pressure() { reason = "foreground_pressure"; break; }
+        let current = storage_diagnostics::physical(connection, path)?;
+        if number(&current, "wal_bytes") > WAL_LIMIT { reason = "wal_pressure"; break; }
+        if number(&current, "freelist_count") == 0 { reason = "no_free_pages"; break; }
+        match super::storage_maintenance_lease::reclaim_page(connection, lease_owner_id, lease_fence) {
+            Ok(()) => completed += 1,
+            Err(cause) if cause.downcast_ref::<rusqlite::Error>().is_some_and(interrupted) => { reason = "time_budget"; break; }
+            Err(cause) if cause.downcast_ref::<rusqlite::Error>().is_some_and(busy) => { reason = "sqlite_busy"; break; }
+            Err(cause) => { failure = Some(cause); break; }
+        }
+    }
+    settings.restore()?;
+    if let Some(cause) = failure { return Err(cause.into()); }
+    let after = physical(connection, path)?;
+    schedule.pages = if completed == pages && started.elapsed() < budget / 2 {
+        pages.saturating_mul(2).min(16)
+    } else { (pages / 2).max(1) };
+    let status = if number(&after, "freelist_count") == 0 { "complete" }
+        else if number(&before, "page_count") > number(&after, "page_count") { "progress" }
+        else { "deferred" };
+    let mut result = response(before, after, started, status, reason);
+    result["next_max_pages"] = json!(schedule.pages);
+    result["min_interval_ms"] = json!(COOLDOWN.as_millis() as u64);
+    Ok(result)
+}
+
+// Explicit maintenance-window operation only. VACUUM is an atomic SQLite rebuild;
+// it blocks this worker and requires temporary disk space proportional to the DB.
+pub fn migrate(connection: &Connection, path: &Path, allow_blocking: bool, max_ms: u64) -> anyhow::Result<Value> {
+    migrate_rebuild(connection,path,allow_blocking,max_ms,false)
+}
+
+pub fn migrate_rebuild(connection: &Connection,path: &Path,allow_blocking: bool,max_ms: u64,rebuild: bool) -> anyhow::Result<Value> {
+    require(allow_blocking && (1..=86_400_000).contains(&max_ms))?;
+    let started = Instant::now();
+    let before = physical(connection, path)?;
+    let prior = number(&before, "auto_vacuum");
+    if prior == 2 && !rebuild { return Ok(json!({"status":"complete","reason":"already_incremental","before":before,"after":before,"elapsed_ms":0})); }
+    require(connection.is_autocommit())?;
+    let mut settings = Settings::begin(connection, started, Duration::from_millis(max_ms))?;
+    let outcome = (|| -> anyhow::Result<()> {
+        connection.execute_batch("PRAGMA auto_vacuum=INCREMENTAL")?;
+        if prior == 0 || rebuild { connection.execute_batch("VACUUM")?; }
+        Ok(())
+    })();
+    settings.restore()?;
+    if let Err(cause) = outcome {
+        connection.pragma_update(None, "auto_vacuum", i64::try_from(prior)?)?;
+        return Err(cause.context("STATE_STORAGE_MIGRATION_FAILED: inspect current physical mode before retry; no migration progress offset is persisted"));
+    }
+    let after = physical(connection, path)?;
+    if number(&after, "auto_vacuum") != 2 { return Err(error("STATE_STORAGE_MIGRATION_FAILED")); }
+    Ok(json!({"status":"complete","reason":"incremental_enabled","before":before,"after":after,
+        "elapsed_ms":started.elapsed().as_millis() as u64,"blocking_rebuild":prior == 0 || rebuild}))
+}
diff --git a/engine/src/workers/state/adapters/sqlite/storage_reclaim_maintenance.rs b/engine/src/workers/state/adapters/sqlite/storage_reclaim_maintenance.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/storage_reclaim_maintenance.rs
@@ -0,0 +1,81 @@
+use super::{busy, interrupted, number, physical, response, Settings, WAL_LIMIT};
+use super::super::{protocol::require, storage_maintenance_lease as lease};
+use rusqlite::Connection;
+use serde_json::{json, Value};
+use std::{path::Path, time::{Duration, Instant}};
+
+fn checkpoint(connection: &Connection) -> anyhow::Result<(i64, i64, i64)> {
+    Ok(connection.query_row("PRAGMA wal_checkpoint(TRUNCATE)", [], |row| {
+        Ok((row.get(0)?, row.get(1)?, row.get(2)?))
+    })?)
+}
+
+pub fn cut(connection: &Connection, path: &Path, max_pages: u32, max_ms: u64,
+    reserved: bool, pressure: impl Fn() -> bool, owner: &str, fence: u64) -> anyhow::Result<Value> {
+    require((1..=4096).contains(&max_pages) && (1..=3000).contains(&max_ms)
+        && lease::valid_owner(owner) && fence > 0)?;
+    let started = Instant::now();
+    let budget = Duration::from_millis(max_ms);
+    let before = physical(connection, path)?;
+    let mut settings = Settings::begin(connection, started, budget)?;
+    let mut checkpointed = false;
+    let mut checkpoint_busy = false;
+    let mut frames = (0i64, 0i64);
+    let outcome = (|| -> anyhow::Result<&str> {
+        lease::validate_current(connection, owner, fence)?;
+        if !reserved { return Ok("reclaim_in_flight"); }
+        if pressure() { return Ok("foreground_pressure"); }
+        if number(&before, "auto_vacuum") != 2 { return Ok("auto_vacuum_not_incremental"); }
+        if number(&before, "wal_bytes") > WAL_LIMIT {
+            let (busy, wal, done) = checkpoint(connection)?;
+            checkpointed = true;
+            checkpoint_busy = busy != 0;
+            frames = (wal, done);
+            if checkpoint_busy { return Ok("checkpoint_busy"); }
+        }
+        let mut reclaimed = 0u64;
+        while reclaimed < u64::from(max_pages) {
+            if started.elapsed() >= budget { return Ok("time_budget"); }
+            if pressure() { return Ok("foreground_pressure"); }
+            lease::validate_current(connection, owner, fence)?;
+            let current = physical(connection, path)?;
+            if number(&current, "freelist_count") == 0 { break; }
+            if number(&current, "wal_bytes") > WAL_LIMIT { break; }
+            let pages = (u64::from(max_pages) - reclaimed).min(128) as u32;
+            lease::reclaim_chunk(connection, owner, fence, pages)?;
+            let after = physical(connection, path)?;
+            let progress = number(&current, "page_count").saturating_sub(number(&after, "page_count"));
+            reclaimed += progress;
+            if progress == 0 { break; }
+            std::thread::yield_now();
+        }
+        if started.elapsed() < budget && !pressure() {
+            lease::validate_current(connection, owner, fence)?;
+            let (busy, wal, done) = checkpoint(connection)?;
+            checkpointed = true;
+            checkpoint_busy = busy != 0;
+            frames = (wal, done);
+        }
+        Ok(if checkpoint_busy {"checkpoint_busy"} else {"page_cut_complete"})
+    })();
+    settings.restore()?;
+    let reason = match outcome {
+        Ok(reason) => reason,
+        Err(cause) if cause.downcast_ref::<rusqlite::Error>().is_some_and(interrupted) => "time_budget",
+        Err(cause) if cause.downcast_ref::<rusqlite::Error>().is_some_and(busy) => "sqlite_busy",
+        Err(cause) => return Err(cause),
+    };
+    let after = physical(connection, path)?;
+    let status = if number(&after, "freelist_count") == 0 && number(&after, "wal_bytes") == 0 {"complete"}
+        else if number(&after, "page_count") < number(&before, "page_count") {"progress"}
+        else {"deferred"};
+    let mut result = response(before, after, started, status, reason);
+    result["maintenance"] = json!(true);
+    result["min_interval_ms"] = json!(0);
+    result["max_chunk_pages"] = json!(128);
+    result["checkpoint_performed"] = json!(checkpointed);
+    result["checkpoint_busy"] = json!(checkpoint_busy);
+    result["wal_frames"] = json!(frames.0);
+    result["checkpointed_frames"] = json!(frames.1);
+    Ok(result)
+}
diff --git a/engine/src/workers/state/adapters/sqlite/storage_repack.rs b/engine/src/workers/state/adapters/sqlite/storage_repack.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/storage_repack.rs
@@ -0,0 +1,174 @@
+mod schema;
+mod mirror;
+#[cfg(test)]
+mod tests;
+
+use super::{database, protocol::{error, require, Guard}, storage_maintenance_lease};
+use rusqlite::{Connection, OptionalExtension, params};
+use serde::{Deserialize, Serialize};
+use serde_json::{Value, json};
+use sha2::{Digest, Sha256};
+use std::time::{Duration, Instant};
+
+#[derive(Clone, Copy, Deserialize, Serialize, PartialEq)]
+#[serde(rename_all="snake_case")]
+pub enum Step { Begin, Copy, Cut, Rollback, Retire }
+#[derive(Clone, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct Request {
+    pub operation_id: String, pub job_id: String, pub expected_ordinal: u64,
+    pub step: Step, pub max_ms: u64, pub max_bytes: usize, pub limit: usize,
+    pub owner_id: String, pub fence: u64, pub guard: Guard,
+}
+
+pub fn initialize(c: &Connection) -> anyhow::Result<()> { schema::initialize(c) }
+pub fn protected(c: &Connection) -> anyhow::Result<bool> {
+    Ok(c.query_row("SELECT EXISTS(SELECT 1 FROM sqlite_schema WHERE name IN ('state_repack_stage','state_repack_original'))",[],|r|r.get(0))?)
+}
+pub fn status(c: &Connection) -> anyhow::Result<Value> {
+    let value: Option<String> = c.query_row("SELECT value FROM state_repack_job WHERE singleton=1",[],|r|r.get(0)).optional()?;
+    Ok(value.map(|v|serde_json::from_str(&v)).transpose()?.unwrap_or(json!({"phase":"absent","ordinal":0})))
+}
+pub fn receipt(c: &Connection, request: &Request) -> anyhow::Result<Value> {
+    let saved: Option<(Vec<u8>,String)> = c.query_row("SELECT digest,result FROM state_repack_receipts WHERE operation_id=?1",[&request.operation_id],|r|Ok((r.get(0)?,r.get(1)?))).optional()?;
+    match saved {
+        None => Ok(json!({"status":"not_found","operation_id":request.operation_id})),
+        Some((digest,result)) => {
+            require(digest == Sha256::digest(serde_json::to_vec(request)?).to_vec())?;
+            Ok(json!({"status":"applied","operation_id":request.operation_id,"result":serde_json::from_str::<Value>(&result)?}))
+        }
+    }
+}
+fn equivalent(c:&Connection,target:&str,scope:&str,key:&str)->anyhow::Result<bool> {
+    let columns=["scope","key","value","version","position","value_bytes"];
+    let equality=columns.iter().map(|name|format!("a.{name} IS b.{name} AND typeof(a.{name})=typeof(b.{name})")).collect::<Vec<_>>().join(" AND ");
+    Ok(c.query_row(&format!("SELECT EXISTS(SELECT 1 FROM state_rows a JOIN {target} b ON a.scope=b.scope AND a.key=b.key WHERE a.scope=?1 AND a.key=?2 AND {equality})"),params![scope,key],|r|r.get(0))?)
+}
+pub fn proof(c:&Connection)->anyhow::Result<Value> {
+    let job=status(c)?;let phase=job["phase"].as_str().unwrap_or("");
+    require(["ready","cut"].contains(&phase))?;
+    let target=if phase=="cut"{"state_repack_original"}else{"state_repack_stage"};
+    let names:Vec<String>=c.prepare("SELECT name FROM sqlite_schema WHERE type='trigger' AND name IN ('state_repack_insert','state_repack_update','state_repack_delete') ORDER BY name")?.query_map([],|r|r.get(0))?.collect::<rusqlite::Result<_>>()?;
+    let plan:Vec<String>=c.prepare("EXPLAIN QUERY PLAN SELECT key FROM state_rows INDEXED BY state_rows_order WHERE scope='mem:graph:control' AND value IS NOT NULL ORDER BY position")?.query_map([],|r|r.get(3))?.collect::<rusqlite::Result<_>>()?;
+    Ok(json!({"job_id":job["job_id"],"ordinal":job["ordinal"],"phase":phase,
+        "raw_verified_rows":job["raw_verified_rows"],"copied_rows":job["copied_rows"],
+        "copied_tombstones":job["copied_tombstones"],"copied_null_positions":job["copied_null_positions"],"raw_storage_types":job["raw_storage_types"],
+        "schema_exact":schema::capture(c)?==job["schema"],"preserved_native_triggers":job["schema"]["triggers"].as_array().map(Vec::len),
+        "mirror_triggers":names,"mirror_target":target,"graph_control_raw_types_equal":equivalent(c,target,database::CONTROL_SCOPE,"current")?,
+        "original_protected":protected(c)?,"order_query_plan":plan}))
+}
+pub(super) fn leases(c: &Connection, r: &Request) -> anyhow::Result<()> {
+    storage_maintenance_lease::validate_in_transaction(c,&r.owner_id,r.fence)?;
+    require(r.owner_id == r.guard.owner_id)?;
+    super::commit::read_allowed(c,database::CONTROL_SCOPE,"current",Some(&r.guard))?;
+    let control=database::row(c,database::CONTROL_SCOPE,"current")?.value.ok_or_else(||error("STATE_TX_FAILED"))?;
+    require(control["recovery"].is_null())?;
+    if r.step == Step::Cut {
+        let now=chrono::Utc::now().timestamp_millis();
+        let expiry:i64=c.query_row("SELECT expires_at_ms FROM state_storage_maintenance_lease WHERE singleton=1",[],|r|r.get(0))?;
+        require(expiry-now>=120_000 && control["lease"]["expires_at_ms"].as_i64().is_some_and(|expiry|expiry-now>=120_000))?;
+    }
+    Ok(())
+}
+pub fn execute(c: &Connection, r: Request) -> anyhow::Result<Value> {
+    require(!c.is_autocommit() && !r.operation_id.is_empty() && r.operation_id.len()<=128
+        && !r.job_id.is_empty() && r.job_id.len()<=96 && (1..=4096).contains(&r.limit)
+        && (1024..=4*1024*1024).contains(&r.max_bytes)
+        && (1..=if r.step==Step::Cut {60_000} else {3000}).contains(&r.max_ms))?;
+    leases(c,&r)?;
+    let prior=receipt(c,&r)?;
+    if prior["status"]=="applied" {return Ok(prior["result"].clone());}
+    let mut job=status(c)?;
+    require(job["ordinal"].as_u64()==Some(r.expected_ordinal))?;
+    if r.step==Step::Begin {
+        require(job["phase"]=="absent" && !protected(c)?)?;
+        let saved=schema::capture(c)?;
+        c.execute_batch(schema::STAGE)?;
+        mirror::install(c,"state_rows","state_repack_stage")?;
+        job=json!({"job_id":r.job_id,"owner_id":r.owner_id,"phase":"copy","ordinal":0,
+            "cursor":null,"copied_rows":0,"copied_stored_bytes":0,"raw_verified_rows":0,"copied_tombstones":0,"copied_null_positions":0,"raw_storage_types":{},"schema":saved});
+    } else {
+        require(job["job_id"]==r.job_id && job["owner_id"]==r.owner_id)?;
+    }
+    let mut rows=0usize;let mut bytes=0usize;
+    match r.step {
+        Step::Begin => (),
+        Step::Copy => {
+            require(job["phase"]=="copy")?;
+            (rows,bytes)=copy(c,&r,&mut job)?;
+        }
+        Step::Cut => {
+            require(job["phase"]=="ready")?;
+            schema::cut(c,&job["schema"])?;
+            job["phase"]=json!("cut");
+        }
+        Step::Rollback => {
+            require(job["phase"]=="cut")?;
+            schema::rollback(c,&job["schema"])?;
+            job["phase"]=json!("ready");
+        }
+        Step::Retire => {
+            require(job["phase"]=="cut" || job["phase"]=="retiring")?;
+            if job["phase"]=="cut" {mirror::remove(c)?;job["phase"]=json!("retiring");}
+            (rows,bytes)=retire(c,&r,&mut job)?;
+        }
+    }
+    job["ordinal"]=json!(r.expected_ordinal.checked_add(1).ok_or_else(||error("STATE_TX_LIMIT_EXCEEDED"))?);
+    c.execute("INSERT INTO state_repack_job VALUES(1,?1) ON CONFLICT(singleton) DO UPDATE SET value=excluded.value",[serde_json::to_string(&job)?])?;
+    let result=json!({"operation_id":r.operation_id,"job":job,"processed_rows":rows,"input_bytes":bytes,"original_protected":protected(c)?});
+    c.execute("INSERT INTO state_repack_receipts VALUES(?1,?2,?3)",params![r.operation_id,Sha256::digest(serde_json::to_vec(&r)?).to_vec(),serde_json::to_string(&result)?])?;
+    Ok(result)
+}
+
+fn copy(c: &Connection,r:&Request,job:&mut Value)->anyhow::Result<(usize,usize)> {
+    let started=Instant::now();let mut rows=0usize;let mut bytes=0usize;
+    let mut cursor=job["cursor"].clone();
+    while rows<r.limit && (rows==0 || started.elapsed()<Duration::from_millis(r.max_ms.saturating_sub(200).min(1500))) {
+        let after_scope=cursor["scope"].as_str().unwrap_or("");let after_key=cursor["key"].as_str().unwrap_or("");
+        let predicate=if cursor.is_null(){"?1 IS NOT NULL AND ?2 IS NOT NULL"}else{"(scope,key)>(?1,?2)"};
+        let batch=c.prepare(&format!("SELECT scope,key,length(CAST(scope AS BLOB))+length(CAST(key AS BLOB))+coalesce(length(CAST(value AS BLOB)),0)+length(CAST(version AS BLOB))+16 FROM state_rows WHERE {predicate} ORDER BY scope,key LIMIT ?3"))?
+            .query_map(params![after_scope,after_key,128.min(r.limit-rows) as i64],|r|Ok((r.get::<_,String>(0)?,r.get::<_,String>(1)?,r.get::<_,i64>(2)?)))?.collect::<rusqlite::Result<Vec<_>>>()?;
+        if batch.is_empty() {job["phase"]=json!("ready");break;}
+        let mut advanced=false;
+        for (scope,key,size) in batch {
+            let size=usize::try_from(size)?;
+            if bytes.saturating_add(size)>r.max_bytes {
+                if rows==0 {return Err(error("STATE_REPACK_ROW_EXCEEDS_BUDGET"));}
+                break;
+            }
+            c.execute("INSERT INTO state_repack_stage SELECT * FROM state_rows WHERE scope=?1 AND key=?2 ON CONFLICT(scope,key) DO UPDATE SET value=excluded.value,version=excluded.version,position=excluded.position,value_bytes=excluded.value_bytes",params![scope,key])?;
+            anyhow::ensure!(equivalent(c,"state_repack_stage",&scope,&key)?,"STATE_REPACK_RAW_MISMATCH");
+            let (tombstone,null_position,kind):(bool,bool,String)=c.query_row("SELECT value IS NULL,position IS NULL,typeof(value) FROM state_rows WHERE scope=?1 AND key=?2",params![scope,key],|r|Ok((r.get(0)?,r.get(1)?,r.get(2)?)))?;
+            job["raw_verified_rows"]=json!(job["raw_verified_rows"].as_u64().unwrap_or(0)+1);
+            job["copied_tombstones"]=json!(job["copied_tombstones"].as_u64().unwrap_or(0)+u64::from(tombstone));
+            job["copied_null_positions"]=json!(job["copied_null_positions"].as_u64().unwrap_or(0)+u64::from(null_position));
+            job["raw_storage_types"][&kind]=json!(job["raw_storage_types"][&kind].as_u64().unwrap_or(0)+1);
+            cursor=json!({"scope":scope,"key":key});rows+=1;bytes+=size;advanced=true;
+            if started.elapsed()>=Duration::from_millis(r.max_ms.saturating_sub(200).min(1500)) {break;}
+        }
+        if !advanced || bytes>=r.max_bytes || started.elapsed()>=Duration::from_millis(r.max_ms.saturating_sub(200).min(1500)) {break;}
+        // A full byte budget may leave one row unconsumed in this metadata chunk.
+        let next_size:Option<i64>=c.query_row("SELECT length(CAST(scope AS BLOB))+length(CAST(key AS BLOB))+coalesce(length(CAST(value AS BLOB)),0)+length(CAST(version AS BLOB))+16 FROM state_rows WHERE (scope,key)>(?1,?2) ORDER BY scope,key LIMIT 1",params![cursor["scope"].as_str(),cursor["key"].as_str()],|r|r.get(0)).optional()?;
+        if next_size.is_some_and(|n|usize::try_from(n).map_or(true,|n|bytes.saturating_add(n)>r.max_bytes)) {break;}
+    }
+    job["cursor"]=cursor;
+    job["copied_rows"]=json!(job["copied_rows"].as_u64().unwrap_or(0)+rows as u64);
+    job["copied_stored_bytes"]=json!(job["copied_stored_bytes"].as_u64().unwrap_or(0)+bytes as u64);
+    Ok((rows,bytes))
+}
+
+fn retire(c:&Connection,r:&Request,job:&mut Value)->anyhow::Result<(usize,usize)> {
+    let started=Instant::now();let mut rows=0usize;let mut bytes=0usize;
+    while rows<r.limit && (rows==0 || started.elapsed()<Duration::from_millis(r.max_ms.saturating_sub(200).min(1500))) {
+        let row:Option<(String,String,i64)>=c.query_row("SELECT scope,key,length(CAST(scope AS BLOB))+length(CAST(key AS BLOB))+coalesce(length(CAST(value AS BLOB)),0)+length(CAST(version AS BLOB))+16 FROM state_repack_original ORDER BY scope,key LIMIT 1",[],|r|Ok((r.get(0)?,r.get(1)?,r.get(2)?))).optional()?;
+        let Some((scope,key,size))=row else {
+            c.execute_batch("DROP TABLE state_repack_original; DROP INDEX state_repack_stage_order;")?;
+            job["phase"]=json!("retired");break;
+        };
+        let size=usize::try_from(size)?;
+        if bytes.saturating_add(size)>r.max_bytes {anyhow::ensure!(rows>0,"STATE_REPACK_ROW_EXCEEDS_BUDGET");break;}
+        c.execute("DELETE FROM state_repack_original WHERE scope=?1 AND key=?2",params![scope,key])?;rows+=1;bytes+=size;
+    }
+    job["retired_representation_rows"]=json!(job["retired_representation_rows"].as_u64().unwrap_or(0)+rows as u64);
+    Ok((rows,bytes))
+}
diff --git a/engine/src/workers/state/adapters/sqlite/storage_repack/mirror.rs b/engine/src/workers/state/adapters/sqlite/storage_repack/mirror.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/storage_repack/mirror.rs
@@ -0,0 +1,10 @@
+use rusqlite::Connection;
+pub(super) fn remove(c:&Connection)->anyhow::Result<()> {
+    c.execute_batch("DROP TRIGGER IF EXISTS state_repack_insert; DROP TRIGGER IF EXISTS state_repack_update; DROP TRIGGER IF EXISTS state_repack_delete;")?;Ok(())
+}
+pub(super) fn install(c:&Connection,source:&str,target:&str)->anyhow::Result<()> {
+    let insert=format!("INSERT INTO {target}(scope,key,value,version,position,value_bytes) VALUES(NEW.scope,NEW.key,NEW.value,NEW.version,NEW.position,NEW.value_bytes) ON CONFLICT(scope,key) DO UPDATE SET value=excluded.value,version=excluded.version,position=excluded.position,value_bytes=excluded.value_bytes;");
+    c.execute_batch(&format!("CREATE TRIGGER state_repack_insert AFTER INSERT ON {source} BEGIN {insert} END;
+        CREATE TRIGGER state_repack_update AFTER UPDATE ON {source} BEGIN DELETE FROM {target} WHERE scope=OLD.scope AND key=OLD.key AND (OLD.scope IS NOT NEW.scope OR OLD.key IS NOT NEW.key); {insert} END;
+        CREATE TRIGGER state_repack_delete AFTER DELETE ON {source} BEGIN DELETE FROM {target} WHERE scope=OLD.scope AND key=OLD.key; END;"))?;Ok(())
+}
diff --git a/engine/src/workers/state/adapters/sqlite/storage_repack/schema.rs b/engine/src/workers/state/adapters/sqlite/storage_repack/schema.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/storage_repack/schema.rs
@@ -0,0 +1,49 @@
+use rusqlite::Connection;
+use serde_json::{Value,json};
+use super::super::protocol::require;
+pub(super) const STAGE:&str="CREATE TABLE state_repack_stage(scope TEXT NOT NULL,key TEXT NOT NULL,value BLOB,version TEXT NOT NULL,position INTEGER,value_bytes INTEGER NOT NULL,PRIMARY KEY(scope,key)) WITHOUT ROWID; CREATE INDEX state_repack_stage_order ON state_repack_stage(scope,position) WHERE value IS NOT NULL;";
+pub(super) fn initialize(c:&Connection)->anyhow::Result<()> {
+    c.execute_batch("CREATE TABLE IF NOT EXISTS state_repack_job(singleton INTEGER PRIMARY KEY CHECK(singleton=1),value TEXT NOT NULL); CREATE TABLE IF NOT EXISTS state_repack_receipts(operation_id TEXT PRIMARY KEY,digest BLOB NOT NULL,result TEXT NOT NULL) WITHOUT ROWID;")?;Ok(())
+}
+pub(super) fn capture(c:&Connection)->anyhow::Result<Value> {
+    let view:String=c.query_row("SELECT sql FROM sqlite_schema WHERE type='view' AND name='state_values'",[],|r|r.get(0))?;
+    let index:String=c.query_row("SELECT sql FROM sqlite_schema WHERE type='index' AND name='state_rows_order'",[],|r|r.get(0))?;
+    let triggers=c.prepare("SELECT name,sql FROM sqlite_schema WHERE type='trigger' AND tbl_name='state_rows' AND name NOT IN ('state_repack_insert','state_repack_update','state_repack_delete') ORDER BY name")?.query_map([],|r|Ok(json!({"name":r.get::<_,String>(0)?,"sql":r.get::<_,String>(1)?})))?.collect::<rusqlite::Result<Vec<_>>>()?;
+    let names=triggers.iter().map(|t|t["name"].as_str().unwrap_or("")).collect::<Vec<_>>();
+    let expected=vec!["compact_gc_state_rows_DELETE","compact_gc_state_rows_INSERT","compact_gc_state_rows_UPDATE","compact_inline_insert","compact_inline_update","crystal_delete","crystal_insert","crystal_update","lexical_content_before_DELETE","lexical_content_before_UPDATE","viewer_recent_delete","viewer_recent_insert","viewer_recent_update"];
+    let unexpected:Vec<_>=names.iter().filter(|name|!expected.contains(name)).map(|name|name.chars().take(128).collect::<String>()).take(16).collect();
+    let missing:Vec<_>=expected.iter().filter(|name|!names.contains(name)).collect();
+    anyhow::ensure!(unexpected.is_empty() && missing.is_empty(),"STATE_REPACK_SCHEMA_UNSUPPORTED unexpected={unexpected:?} missing={missing:?}");
+    Ok(json!({"view":view,"index":index,"triggers":triggers}))
+}
+fn detach(c:&Connection,saved:&Value)->anyhow::Result<()> {
+    super::mirror::remove(c)?;
+    c.execute_batch("DROP VIEW state_values;")?;
+    for trigger in saved["triggers"].as_array().ok_or_else(||super::error("STATE_TX_FAILED"))? {
+        let name=trigger["name"].as_str().ok_or_else(||super::error("STATE_TX_FAILED"))?;
+        c.execute_batch(&format!("DROP TRIGGER \"{name}\";"))?;
+    }
+    c.execute_batch("DROP INDEX state_rows_order;")?;Ok(())
+}
+fn attach(c:&Connection,saved:&Value)->anyhow::Result<()> {
+    c.execute_batch(saved["index"].as_str().ok_or_else(||super::error("STATE_TX_FAILED"))?)?;
+    c.execute_batch(saved["view"].as_str().ok_or_else(||super::error("STATE_TX_FAILED"))?)?;
+    for trigger in saved["triggers"].as_array().ok_or_else(||super::error("STATE_TX_FAILED"))? {c.execute_batch(trigger["sql"].as_str().ok_or_else(||super::error("STATE_TX_FAILED"))?)?;}
+    Ok(())
+}
+pub(super) fn cut(c:&Connection,saved:&Value)->anyhow::Result<()> {
+    require(capture_without_mirror(c)?==*saved)?;
+    c.flush_prepared_statement_cache();detach(c,saved)?;
+    c.execute_batch("ALTER TABLE state_rows RENAME TO state_repack_original; ALTER TABLE state_repack_stage RENAME TO state_rows;")?;
+    attach(c,saved)?;super::mirror::install(c,"state_rows","state_repack_original")?;
+    c.flush_prepared_statement_cache();Ok(())
+}
+fn capture_without_mirror(c:&Connection)->anyhow::Result<Value> {
+    capture(c)
+}
+pub(super) fn rollback(c:&Connection,saved:&Value)->anyhow::Result<()> {
+    c.flush_prepared_statement_cache();detach(c,saved)?;
+    c.execute_batch("ALTER TABLE state_rows RENAME TO state_repack_stage; ALTER TABLE state_repack_original RENAME TO state_rows;")?;
+    attach(c,saved)?;super::mirror::install(c,"state_rows","state_repack_stage")?;
+    c.flush_prepared_statement_cache();Ok(())
+}
diff --git a/engine/src/workers/state/adapters/sqlite/storage_repack/tests.rs b/engine/src/workers/state/adapters/sqlite/storage_repack/tests.rs
