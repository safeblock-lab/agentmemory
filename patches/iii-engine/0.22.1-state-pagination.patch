+#[test]
+fn old_writer_revision_gap_blocks_and_reconciles_deleted_source() {
+    let connection = fresh();
+    tracked(&connection);
+    write(&connection, OBS, "a", Some(&observation("a", "initial")));
+    upsert(&connection, vec![source_item(&connection, OBS, "a")]).unwrap();
