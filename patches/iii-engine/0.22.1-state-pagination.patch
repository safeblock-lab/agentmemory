+}
+fn adoption_cache(connection:&Connection,current:&TerminalAnchor,generation:&str,root:&str,remove:bool,now:i64)->anyhow::Result<()> {
+    let before:Option<(String,String,String,i64)>=connection.query_row("SELECT job_version,checkpoint_version,reason,updated_at_ms FROM engine_graph_auto_terminal_results WHERE job_id=?1 AND generation=?2 AND job_version=?3 AND checkpoint_version=?4 AND reason='GRAPH_AUTOMATIC_SLOT_EXHAUSTED'",params![current.job_id,generation,current.job_version,current.checkpoint_version],|row|Ok((row.get(0)?,row.get(1)?,row.get(2)?,row.get(3)?))).optional()?;
