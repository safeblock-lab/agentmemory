@@ -0,0 +1,204 @@
+use super::super::{database, protocol};
+use super::{eligibility, semantic, source_prepare};
+use rusqlite::{Connection, OptionalExtension, params};
+use serde_json::{Value, json};
+
+pub const SCOPES: &str = "SELECT scope,revision FROM state_scopes WHERE scope>='mem:obs:' AND scope<'mem:obs;' UNION ALL SELECT scope,revision FROM state_scopes WHERE scope='mem:memories'";
+pub fn tracked_scope(scope: &str) -> bool {
+    scope.starts_with("mem:obs:") || scope == "mem:memories"
+}
+
+pub fn schema(connection: &Connection) -> anyhow::Result<()> {
+    eligibility::register(connection)?;
+    connection.execute_batch("CREATE TABLE IF NOT EXISTS retrieval_source_meta(index_id TEXT PRIMARY KEY,kind TEXT NOT NULL,dirty_count INTEGER NOT NULL CHECK(dirty_count>=0),current_scope TEXT NOT NULL,cursor INTEGER NOT NULL,phase TEXT NOT NULL,cleanup_cursor TEXT NOT NULL) WITHOUT ROWID;
+        CREATE TABLE IF NOT EXISTS retrieval_source_scopes(index_id TEXT NOT NULL,scope TEXT NOT NULL,revision TEXT NOT NULL,prepared INTEGER NOT NULL,PRIMARY KEY(index_id,scope)) WITHOUT ROWID;
+        CREATE TABLE IF NOT EXISTS retrieval_source_items(index_id TEXT NOT NULL,scope TEXT NOT NULL,key TEXT NOT NULL,version TEXT NOT NULL,dirty INTEGER NOT NULL,PRIMARY KEY(index_id,scope,key)) WITHOUT ROWID;
+        CREATE INDEX IF NOT EXISTS retrieval_source_items_id ON retrieval_source_items(index_id,key);
+        CREATE INDEX IF NOT EXISTS retrieval_source_items_dirty ON retrieval_source_items(index_id,dirty,scope,key);")?;
+    Ok(())
+}
+
+pub fn kind(connection: &Connection, id: &str) -> anyhow::Result<Option<String>> {
+    Ok(connection
+        .query_row(
+            "SELECT kind FROM retrieval_source_meta WHERE index_id=?1",
+            [id],
+            |r| r.get(0),
+        )
+        .optional()?)
+}
+
+pub fn configure(
+    connection: &Connection,
+    id: &str,
+    source_kind: Option<&str>,
+    existed: bool,
+) -> anyhow::Result<()> {
+    let current = kind(connection, id)?;
+    if existed && current.as_deref() != source_kind {
+        return Err(protocol::error("STATE_SEMANTIC_IDENTITY_MISMATCH"));
+    }
+    if source_kind.is_some() && current.is_none() {
+        connection.execute(
+            "INSERT INTO retrieval_source_meta VALUES(?1,'agentmemory',0,'',-1,'rows','')",
+            [id],
+        )?;
+    }
+    Ok(())
+}
+
+pub fn pending_scope(
+    connection: &Connection,
+    id: &str,
+) -> anyhow::Result<Option<(String, String)>> {
+    let sql = format!(
+        "SELECT s.scope,s.revision FROM ({SCOPES}) s LEFT JOIN retrieval_source_scopes r ON r.index_id=?1 AND r.scope=s.scope WHERE r.scope IS NULL OR r.revision<>s.revision OR r.prepared=0 ORDER BY s.scope LIMIT 1"
+    );
+    Ok(connection
+        .query_row(&sql, [id], |r| Ok((r.get(0)?, r.get(1)?)))
+        .optional()?)
+}
+
+pub fn status(connection: &Connection, id: &str) -> anyhow::Result<Value> {
+    let source_kind = kind(connection, id)?;
+    let dirty: i64 = if source_kind.is_some() {
+        connection.query_row(
+            "SELECT dirty_count FROM retrieval_source_meta WHERE index_id=?1",
+            [id],
+            |r| r.get(0),
+        )?
+    } else {
+        0
+    };
+    let prepared = source_kind.is_none() || pending_scope(connection, id)?.is_none();
+    Ok(
+        json!({"source_kind":source_kind,"source_prepared":prepared,"dirty_count":dirty.to_string(),"coverage_ready":prepared && dirty==0}),
+    )
+}
+
+pub fn ready(connection: &Connection, id: &str) -> anyhow::Result<()> {
+    if status(connection, id)?["coverage_ready"] != true {
+        return Err(protocol::error("STATE_SEMANTIC_SOURCE_NOT_READY"));
+    }
+    Ok(())
+}
+
+pub fn decorate(connection: &Connection, id: &str, mut value: Value) -> anyhow::Result<Value> {
+    if let (Some(output), Some(fields)) =
+        (value.as_object_mut(), status(connection, id)?.as_object())
+    {
+        output.extend(
+            fields
+                .iter()
+                .map(|(key, value)| (key.clone(), value.clone())),
+        );
+    }
+    Ok(value)
+}
+
+pub(super) fn item(
+    connection: &Connection,
+    id: &str,
+    scope: &str,
+    key: &str,
+) -> anyhow::Result<Option<(String, bool)>> {
+    Ok(connection.query_row("SELECT version,dirty FROM retrieval_source_items WHERE index_id=?1 AND scope=?2 AND key=?3",params![id,scope,key],|r|Ok((r.get(0)?,r.get(1)?))).optional()?)
+}
+
+pub fn touch(
+    connection: &Connection,
+    id: &str,
+    scope: &str,
+    key: &str,
+    version: &str,
+    dirty: bool,
+) -> anyhow::Result<()> {
+    let previous = item(connection, id, scope, key)?;
+    let delta = i64::from(dirty) - i64::from(previous.as_ref().is_some_and(|(_, dirty)| *dirty));
+    connection.execute("INSERT INTO retrieval_source_items VALUES(?1,?2,?3,?4,?5) ON CONFLICT(index_id,scope,key) DO UPDATE SET version=excluded.version,dirty=excluded.dirty",params![id,scope,key,version,dirty])?;
+    connection.execute(
+        "UPDATE retrieval_source_meta SET dirty_count=dirty_count+?2 WHERE index_id=?1",
+        params![id, delta],
+    )?;
+    Ok(())
+}
+
+pub fn remove(connection: &Connection, id: &str, scope: &str, key: &str) -> anyhow::Result<()> {
+    let previous = item(connection, id, scope, key)?;
+    connection.execute(
+        "DELETE FROM retrieval_source_items WHERE index_id=?1 AND scope=?2 AND key=?3",
+        params![id, scope, key],
+    )?;
+    if previous.is_some_and(|(_, dirty)| dirty) {
+        connection.execute(
+            "UPDATE retrieval_source_meta SET dirty_count=dirty_count-1 WHERE index_id=?1",
+            [id],
+        )?;
+    }
+    let semantic_scope = format!("{}{id}", semantic::PREFIX);
+    if database::row(connection, &semantic_scope, key)?
+        .value
+        .is_some()
+    {
+        database::write(connection, &semantic_scope, key, None)?;
+    }
+    Ok(())
+}
+
+pub fn validate(connection: &Connection, id: &str, key: &str, value: &Value) -> anyhow::Result<()> {
+    if kind(connection, id)?.is_none() {
+        return Ok(());
+    }
+    let scope = value["sourceScope"]
+        .as_str()
+        .ok_or_else(|| protocol::error("STATE_TX_INVALID_REQUEST"))?;
+    let version = value["sourceVersion"]
+        .as_str()
+        .ok_or_else(|| protocol::error("STATE_TX_INVALID_REQUEST"))?;
+    protocol::require(tracked_scope(scope))?;
+    protocol::counter(version)?;
+    let sql = format!(
+        "WITH source_row AS MATERIALIZED (SELECT scope,version,state_json(value,value_bytes) AS state_value FROM state_rows WHERE scope=?1 AND key=?2) SELECT version,state_value IS NOT NULL,json_extract(state_value,'$.id'),{} FROM source_row",
+        eligibility::SQL
+    );
+    let source: Option<(String, bool, Option<String>, bool)> = connection
+        .query_row(&sql, params![scope, key], |r| {
+            Ok((r.get(0)?, r.get(1)?, r.get(2)?, r.get(3)?))
+        })
+        .optional()?;
+    if !source.is_some_and(|(current, present, source_id, eligible)| {
+        current == version && present && source_id.as_deref() == Some(key) && eligible
+    }) {
+        return Err(protocol::error("STATE_SEMANTIC_SOURCE_STALE"));
+    }
+    let conflict: bool=connection.query_row("SELECT EXISTS(SELECT 1 FROM retrieval_source_items WHERE index_id=?1 AND key=?2 AND scope<>?3)",params![id,key,scope],|r|r.get(0))?;
+    if conflict {
+        return Err(protocol::error("STATE_SEMANTIC_SOURCE_ID_CONFLICT"));
+    }
+    touch(connection, id, scope, key, version, false)
+}
+
+pub fn embedding_deleted(connection: &Connection, id: &str, key: &str) -> anyhow::Result<()> {
+    let mut statement = connection
+        .prepare("SELECT scope,version FROM retrieval_source_items WHERE index_id=?1 AND key=?2")?;
+    let rows = statement
+        .query_map(params![id, key], |r| {
+            Ok((r.get::<_, String>(0)?, r.get::<_, String>(1)?))
+        })?
+        .collect::<rusqlite::Result<Vec<_>>>()?;
+    for (scope, version) in rows {
+        touch(connection, id, &scope, key, &version, true)?;
+    }
+    Ok(())
+}
+
+pub fn prepare(
+    connection: &Connection,
+    id: &str,
+    max_rows: usize,
+    max_bytes: usize,
+) -> anyhow::Result<Value> {
+    source_prepare::prepare(connection, id, max_rows, max_bytes)
+}
+
+pub use super::source_lexical::lexical_text;
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/source_lexical.rs b/engine/src/workers/state/adapters/sqlite/retrieval/source_lexical.rs
