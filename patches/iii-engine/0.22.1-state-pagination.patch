+                            sleep(SQLITE_QUEUE_RETRY_DELAY.min(remaining)).await;
+                        }
+                    }
+                }
+            }
+        }
+        if let Some(budget) = &budget {
+            match tokio::time::timeout_at(tokio::time::Instant::from_std(budget.deadline), receiver).await {
+                Ok(result) => result.map_err(|_| protocol::error("STATE_TX_FAILED"))?,
