+    assert!(run(&mut schedule,17,25,true,false).is_err());
+    assert!(run(&mut schedule,1,26,true,false).is_err());
+    assert_eq!(run(&mut schedule,1,25,false,false).unwrap()["reason"],"reclaim_in_flight");
+    assert_eq!(run(&mut schedule,1,25,true,true).unwrap()["reason"],"foreground_pressure");
+    second.execute_batch("BEGIN IMMEDIATE").unwrap();
+    let blocked_at=Instant::now();
+    assert_eq!(run(&mut schedule,1,25,true,false).unwrap()["reason"],"sqlite_busy");
+    assert!(blocked_at.elapsed()<Duration::from_millis(250));
+    second.execute_batch("ROLLBACK").unwrap();
+    let start=Instant::now();
+    let progress=run(&mut schedule,1,25,true,false).unwrap();
+    assert!(start.elapsed()<Duration::from_secs(1));
+    assert_eq!(progress["pages_reclaimed"],1);
+    assert_eq!(progress["checkpoint_performed"],false);
+    assert_eq!(progress["min_interval_ms"],5000);
+    assert_eq!(run(&mut schedule,1,25,true,false).unwrap()["reason"],"cooldown");
+}
