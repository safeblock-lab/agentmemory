@@ -0,0 +1,161 @@
+use super::{LEGACY_LIST_BYTES, commit, database, protocol};
+use crate::workers::state::{
+    adapters::StatePageError,
+    structs::{STATE_PAGE_MAX_CURSOR_BYTES, StateListPageResult},
+};
+use base64::{Engine as _, engine::general_purpose::URL_SAFE_NO_PAD};
+use rusqlite::{Connection, params};
+use serde::{Deserialize, Serialize};
+use serde_json::Value;
+use sha2::{Digest, Sha256};
+
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Cursor {
+    version: u8,
+    generation: uuid::Uuid,
+    scope_fingerprint: String,
+    revision: String,
+    after_position: i64,
+}
+fn encode(cursor: &Cursor) -> Result<String, StatePageError> {
+    let encoded =
+        URL_SAFE_NO_PAD.encode(serde_json::to_vec(cursor).map_err(|_| StatePageError::Internal)?);
+    if encoded.len() > STATE_PAGE_MAX_CURSOR_BYTES {
+        return Err(StatePageError::Internal);
+    }
+    Ok(encoded)
+}
+pub fn list(connection: &Connection, scope: &str) -> anyhow::Result<Vec<Value>> {
+    let transaction = connection.unchecked_transaction()?;
+    commit::read_allowed(&transaction, scope, "", None)?;
+    let bytes:i64=transaction.query_row("SELECT COALESCE(SUM(value_bytes+1),0)+2 FROM state_rows WHERE scope=?1 AND value IS NOT NULL",[scope],|r|r.get(0))?;
+    if bytes > LEGACY_LIST_BYTES as i64 - 4096 {
+        return Err(protocol::error("STATE_TX_LIMIT_EXCEEDED"));
+    }
+    let mut statement = transaction.prepare(
+        "SELECT value FROM state_rows WHERE scope=?1 AND value IS NOT NULL ORDER BY position",
+    )?;
+    let mut rows = statement.query([scope])?;
+    let mut values = Vec::new();
+    while let Some(row) = rows.next()? {
+        values.push(serde_json::from_str(&row.get::<_, String>(0)?)?);
+    }
+    Ok(values)
+}
+pub fn page(
+    connection: &Connection,
+    scope: &str,
+    cursor: Option<&str>,
+    limit: u32,
+    max_bytes: u32,
+    generation: uuid::Uuid,
+) -> Result<StateListPageResult, StatePageError> {
+    page_inner(connection, scope, cursor, limit, max_bytes, generation).map_err(|error| {
+        if let Some(page) = error.downcast_ref::<PageFailure>() {
+            return page.0.clone();
+        }
+        if error
+            .downcast_ref::<protocol::TxError>()
+            .is_some_and(|e| e.0 == "STATE_GRAPH_RECOVERY_REQUIRED")
+        {
+            return StatePageError::RecoveryRequired;
+        }
+        tracing::warn!(error=?error,"SQLite state page failed");
+        StatePageError::Internal
+    })
+}
+#[derive(Debug, thiserror::Error)]
+#[error("state page rejected")]
+struct PageFailure(StatePageError);
+fn reject(error: StatePageError) -> anyhow::Error {
+    PageFailure(error).into()
+}
+fn page_inner(
+    connection: &Connection,
+    scope: &str,
+    cursor: Option<&str>,
+    limit: u32,
+    max_bytes: u32,
+    generation: uuid::Uuid,
+) -> anyhow::Result<StateListPageResult> {
+    if limit == 0 || limit > 1024 || max_bytes == 0 || max_bytes > 1_048_576 {
+        return Err(reject(StatePageError::InvalidCursor));
+    }
+    let decoded = cursor
+        .map(|cursor| {
+            if cursor.len() > STATE_PAGE_MAX_CURSOR_BYTES {
+                return Err(reject(StatePageError::InvalidCursor));
+            }
+            let bytes = URL_SAFE_NO_PAD
+                .decode(cursor)
+                .map_err(|_| reject(StatePageError::InvalidCursor))?;
+            serde_json::from_slice::<Cursor>(&bytes)
+                .map_err(|_| reject(StatePageError::InvalidCursor))
+        })
+        .transpose()?;
+    let transaction = connection.unchecked_transaction()?;
+    commit::read_allowed(&transaction, scope, "", None)?;
+    let fingerprint = URL_SAFE_NO_PAD.encode(Sha256::digest(scope.as_bytes()));
+    let revision = database::revision(&transaction, scope)?.to_string();
+    let start = if let Some(decoded) = decoded {
+        if decoded.version != 2
+            || decoded.scope_fingerprint != fingerprint
+            || decoded.after_position < 0
+        {
+            return Err(reject(StatePageError::InvalidCursor));
+        }
+        if decoded.generation != generation || decoded.revision != revision {
+            return Err(reject(StatePageError::StaleCursor));
+        }
+        let exists:bool=transaction.query_row("SELECT EXISTS(SELECT 1 FROM state_rows WHERE scope=?1 AND position=?2 AND value IS NOT NULL)",params![scope,decoded.after_position],|r|r.get(0))?;
+        if !exists {
+            return Err(reject(StatePageError::InvalidCursor));
+        }
+        decoded.after_position
+    } else {
+        -1
+    };
+    let mut statement=transaction.prepare("SELECT position,value,value_bytes FROM state_rows WHERE scope=?1 AND position>?2 AND value IS NOT NULL ORDER BY position LIMIT ?3")?;
+    let mut rows = statement.query(params![scope, start, limit])?;
+    let mut items = Vec::with_capacity(limit as usize);
+    let mut next_cursor = None;
+    let mut item_bytes = 0usize;
+    while let Some(row) = rows.next()? {
+        let position: i64 = row.get(0)?;
+        let value_bytes = usize::try_from(row.get::<_, i64>(2)?)?;
+        let more:bool=transaction.query_row("SELECT EXISTS(SELECT 1 FROM state_rows WHERE scope=?1 AND position>?2 AND value IS NOT NULL)",params![scope,position],|r|r.get(0))?;
+        let candidate_cursor = if more {
+            Some(
+                encode(&Cursor {
+                    version: 2,
+                    generation,
+                    scope_fingerprint: fingerprint.clone(),
+                    revision: revision.clone(),
+                    after_position: position,
+                })
+                .map_err(reject)?,
+            )
+        } else {
+            None
+        };
+        let candidate_bytes = item_bytes + value_bytes + usize::from(!items.is_empty());
+        let bytes = protocol::size(&StateListPageResult {
+            items: vec![],
+            next_cursor: candidate_cursor.clone(),
+        })? + candidate_bytes;
+        if bytes > max_bytes as usize {
+            if items.is_empty() {
+                return Err(reject(StatePageError::RecordTooLarge {
+                    required_bytes: bytes,
+                }));
+            }
+            break;
+        }
+        let value: String = row.get(1)?;
+        items.push(serde_json::from_str(&value)?);
+        item_bytes = candidate_bytes;
+        next_cursor = candidate_cursor;
+    }
+    Ok(StateListPageResult { items, next_cursor })
+}
