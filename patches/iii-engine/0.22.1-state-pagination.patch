+        Step::Retire=>("SELECT root,length(CAST(scope AS BLOB))+length(CAST(key AS BLOB))+length(CAST(version AS BLOB)) FROM compact_root_originals WHERE root>?1 AND root<=?2 ORDER BY root LIMIT ?3","retiring","retired"),
