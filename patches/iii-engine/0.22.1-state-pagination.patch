+pub(crate) const FORMAT_VERSION: i64 = 2;
+pub const GRAPH_SNAPSHOT_MAX_BYTES: i64 = 4 * 1024 * 1024;
+pub const CONTROL_SCOPE: &str = "mem:graph:control";
+pub const CHECKPOINT_SCOPE: &str = "mem:graph:checkpoints";
+pub const RECEIPT_SCOPE: &str = "mem:graph:receipts";
+
+pub fn open(path: &Path) -> anyhow::Result<Connection> {
+    let mut marker = path.as_os_str().to_owned();
+    marker.push(".migration-pending");
+    if Path::new(&marker).exists() {
+        anyhow::bail!("STATE_MIGRATION_INCOMPLETE: shadow target is not ready");
+    }
+    if path.is_file() {
+        let prior = Connection::open_with_flags(path, rusqlite::OpenFlags::SQLITE_OPEN_READ_ONLY)?;
+        let exists: i64 = prior.query_row(
+            "SELECT count(*) FROM sqlite_master WHERE type='table' AND name='state_migration'",
+            [],
+            |r| r.get(0),
+        )?;
+        if exists != 0 {
+            let ready: String =
+                prior.query_row("SELECT status FROM state_migration WHERE id=1", [], |r| {
+                    r.get(0)
+                })?;
+            if ready != "ready" {
+                anyhow::bail!("STATE_MIGRATION_INCOMPLETE: shadow target is not ready");
+            }
+        }
+    }
+    let connection = open_for_migration(path)?;
+    let pending: i64 = connection.query_row(
+        "SELECT count(*) FROM sqlite_master WHERE type='table' AND name='state_migration'",
+        [],
+        |r| r.get(0),
+    )?;
+    if pending != 0 {
+        let ready: String =
+            connection.query_row("SELECT status FROM state_migration WHERE id=1", [], |r| {
+                r.get(0)
+            })?;
+        if ready != "ready" {
+            anyhow::bail!("STATE_MIGRATION_INCOMPLETE: shadow target is not ready");
+        }
+    }
+    Ok(connection)
+}
+
+pub(crate) fn open_for_migration(path: &Path) -> anyhow::Result<Connection> {
+    if path.is_dir() {
+        anyhow::bail!(
+            "SQLite file_path must name a database file; migration is required for legacy directories"
+        );
+    }
+    if let Some(parent) = path.parent().filter(|p| !p.as_os_str().is_empty()) {
+        std::fs::create_dir_all(parent)?;
+    }
+    let connection = Connection::open(path)?;
+    register_value_function(&connection)?;
+    super::compact::register(&connection)?;
+    let application: i64 = connection.pragma_query_value(None, "application_id", |r| r.get(0))?;
+    let version: i64 = connection.pragma_query_value(None, "user_version", |r| r.get(0))?;
+    let tables: i64 = connection.query_row(
+        "SELECT count(*) FROM sqlite_master WHERE type='table'",
+        [],
+        |r| r.get(0),
+    )?;
+    let compatible = if tables == 0 {
+        (application == 0 || application == APPLICATION_ID)
+            && (version == 0 || version == FORMAT_VERSION)
+    } else {
+        application == APPLICATION_ID && [FORMAT_VERSION, 3, 4].contains(&version)
+    };
+    if !compatible {
+        anyhow::bail!("Unsupported SQLite state format; explicit migration is required");
+    }
+    super::retrieval::lexical_content::validate_format(&connection)?;
+    if tables == 0 {
+        connection.execute_batch("PRAGMA auto_vacuum=INCREMENTAL")?;
+    }
+    connection.busy_timeout(Duration::from_secs(5))?;
+    connection.execute_batch("PRAGMA journal_mode=WAL; PRAGMA synchronous=FULL; PRAGMA cache_size=-65536; PRAGMA mmap_size=0; PRAGMA temp_store=FILE; PRAGMA wal_autocheckpoint=1024; PRAGMA journal_size_limit=67108864; PRAGMA foreign_keys=ON;
+        CREATE TABLE IF NOT EXISTS state_scopes(scope TEXT PRIMARY KEY, revision TEXT NOT NULL, next_position INTEGER NOT NULL) WITHOUT ROWID;
+        CREATE TABLE IF NOT EXISTS state_rows(scope TEXT NOT NULL, key TEXT NOT NULL, value BLOB, version TEXT NOT NULL, position INTEGER, value_bytes INTEGER NOT NULL, PRIMARY KEY(scope,key)) WITHOUT ROWID;
+        CREATE INDEX IF NOT EXISTS state_rows_order ON state_rows(scope,position) WHERE value IS NOT NULL;
+        CREATE TABLE IF NOT EXISTS graph_storage_metadata(scope TEXT PRIMARY KEY,status TEXT NOT NULL CHECK(status IN ('preparing','scanned','ready','stale')),rows INTEGER NOT NULL CHECK(rows>=0),logical_bytes INTEGER NOT NULL CHECK(logical_bytes>=0),stored_bytes INTEGER NOT NULL CHECK(stored_bytes>=0),revision TEXT NOT NULL,last_key TEXT) WITHOUT ROWID;")?;
+    super::storage_maintenance_lease::initialize(&connection)?;
+    super::retention_use_schema::initialize(&connection)?;
+    super::compact::schema(&connection)?;
+    super::storage_repack::initialize(&connection)?;
+    super::storage_lexical_repack::initialize(&connection)?;
+    connection.pragma_update(None, "application_id", APPLICATION_ID)?;
+    connection.pragma_update(None, "user_version", version.max(FORMAT_VERSION))?;
+    {
+        let transaction = connection.unchecked_transaction()?;
+        super::retrieval::initialize(&transaction)?;
+        super::search_packed::schema(&transaction)?;
+        super::compact::reference_schema(&transaction)?;
+        transaction.commit()?;
+    }
+    {
+        let transaction = rusqlite::Transaction::new_unchecked(
+            &connection,
+            rusqlite::TransactionBehavior::Immediate,
+        )?;
+        if row(&transaction, CONTROL_SCOPE, "current")?.value.is_none() {
+            write(
+                &transaction,
+                CONTROL_SCOPE,
+                "current",
+                Some(
+                    &serde_json::json!({"version":1,"generation":"1","fence":"0","lease":null,"recovery":null}),
+                ),
+            )?;
+        }
+        transaction.commit()?;
+    }
+    Ok(connection)
+}
+
+fn register_value_function(connection: &Connection) -> anyhow::Result<()> {
+    super::retrieval::lexical_content::register(connection)?;
+    connection.create_scalar_function(
+        "state_json",
+        2,
+        FunctionFlags::SQLITE_UTF8
+            | FunctionFlags::SQLITE_DETERMINISTIC
+            | FunctionFlags::SQLITE_INNOCUOUS,
+        |context| {
+            if matches!(context.get_raw(0), ValueRef::Null) {
+                return Ok(None::<String>);
+            }
+            let encoded = match context.get_raw(0) {
+                ValueRef::Blob(encoded) | ValueRef::Text(encoded) => encoded,
+                value => {
+                    return Err(rusqlite::Error::InvalidFunctionParameterType(
+                        0,
+                        value.data_type(),
+                    ));
+                }
+            };
+            let logical_bytes = context.get::<i64>(1)?;
+            let logical_bytes = usize::try_from(logical_bytes)
+                .map_err(|error| rusqlite::Error::UserFunctionError(Box::new(error)))?;
+            admit_decode(encoded.len(), logical_bytes)
+                .map_err(|error| rusqlite::Error::UserFunctionError(error.into()))?;
+            let decoded = super::codec::decode(encoded, logical_bytes)
+                .map_err(|error| rusqlite::Error::UserFunctionError(error.into()))?;
+            Ok(Some(decoded))
+        },
+    )?;
+    connection.create_scalar_function(
+        "state_project",
+        3,
+        FunctionFlags::SQLITE_UTF8
+            | FunctionFlags::SQLITE_DETERMINISTIC
+            | FunctionFlags::SQLITE_INNOCUOUS,
+        |context| {
+            let encoded = match context.get_raw(0) {
+                ValueRef::Blob(encoded) | ValueRef::Text(encoded) => encoded,
+                ValueRef::Null => return Ok(None::<String>),
+                value => {
+                    return Err(rusqlite::Error::InvalidFunctionParameterType(
+                        0,
+                        value.data_type(),
+                    ));
+                }
+            };
+            let logical_bytes = usize::try_from(context.get::<i64>(1)?)
+                .map_err(|error| rusqlite::Error::UserFunctionError(Box::new(error)))?;
+            if logical_bytes == 0
+                || logical_bytes > 65_536
+                || encoded.is_empty()
+                || encoded.len() > 65_536
+            {
+                return Ok(None::<String>);
+            }
+            let expected_session = context.get::<Option<String>>(2)?;
+            let decoded = match super::codec::decode(encoded, logical_bytes) {
+                Ok(decoded) => decoded,
+                Err(_) => return Ok(None::<String>),
+            };
+            let value: Value = match serde_json::from_str(&decoded) {
+                Ok(value) => value,
+                Err(_) => return Ok(None::<String>),
+            };
+            if !value.is_object()
+                || value.get("deleted") == Some(&Value::Bool(true))
+                || value.get("stale") == Some(&Value::Bool(true))
+                || expected_session.as_deref().is_some_and(|expected| {
+                    value.get("sessionId").and_then(Value::as_str) != Some(expected)
+                })
+            {
+                return Ok(None::<String>);
+            }
+            Ok(value
+                .get("project")
+                .and_then(Value::as_str)
+                .filter(|project| !project.trim().is_empty() && project.len() <= 256)
+                .map(str::to_owned))
+        },
+    )?;
+    Ok(())
+}
+
+pub fn wal_pressure(connection: &Connection, path: &Path) -> anyhow::Result<()> {
+    let wal = std::path::PathBuf::from(format!("{}-wal", path.display()));
+    let bytes = match std::fs::metadata(&wal) {
+        Ok(metadata) => metadata.len(),
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => 0,
+        Err(error) => return Err(error.into()),
+    };
+    if bytes >= 32 * 1024 * 1024 {
+        let profile_checkpoint=super::storage_profile::Clock::start();
+        let (busy, frames, checkpointed): (i64, i64, i64) =
+            connection.query_row("PRAGMA wal_checkpoint(PASSIVE)", [], |r| {
+                Ok((r.get(0)?, r.get(1)?, r.get(2)?))
+            })?;
+        super::storage_profile::emit("pre_wal_passive_checkpoint",profile_checkpoint,0,0);
+        if super::storage_profile::enabled() {tracing::info!(target:"iii::storage_profile",busy,frames,checkpointed,wal_allocated_bytes=bytes,"state checkpoint result");}
+        if (busy != 0 || checkpointed < frames) && bytes >= 64 * 1024 * 1024 {
+            return Err(protocol::error("STATE_TX_LIMIT_EXCEEDED"));
+        }
+    }
+    Ok(())
+}
+
+pub struct Row {
+    pub value: Option<Value>,
+    pub version: u64,
+    pub position: Option<i64>,
+}
+
+struct GraphSnapshotMetadata {
+    version: u64,
+    position: Option<i64>,
+    logical_bytes: i64,
+    stored_bytes: i64,
+    exists: bool,
+}
+
+fn is_graph_snapshot(scope: &str, key: &str) -> bool {
+    scope == "mem:graph:snapshot" && key == "current"
+}
+
+fn graph_snapshot_metadata(
+    connection: &Connection,
+    scope: &str,
+    key: &str,
+) -> anyhow::Result<Option<GraphSnapshotMetadata>> {
+    let raw: Option<(String, Option<i64>, i64, i64, bool)> = connection
+        .query_row(
+            "SELECT version,position,value_bytes,COALESCE(length(CAST(value AS BLOB)),0),value IS NOT NULL FROM state_rows WHERE scope=?1 AND key=?2",
+            params![scope, key],
+            |row| Ok((row.get(0)?, row.get(1)?, row.get(2)?, row.get(3)?, row.get(4)?)),
+        )
+        .optional()?;
+    raw.map(|(version, position, logical_bytes, stored_bytes, exists)| {
+        Ok(GraphSnapshotMetadata {
+            version: protocol::counter(&version)?,
+            position,
+            logical_bytes,
+            stored_bytes,
+            exists,
+        })
+    })
+    .transpose()
+}
+
+fn require_bounded_graph_snapshot(metadata: &GraphSnapshotMetadata) -> anyhow::Result<()> {
+    if metadata.exists
+        && (metadata.logical_bytes > GRAPH_SNAPSHOT_MAX_BYTES
+            || metadata.stored_bytes > GRAPH_SNAPSHOT_MAX_BYTES)
+    {
+        return Err(protocol::error("STATE_GRAPH_SNAPSHOT_TOO_LARGE"));
+    }
+    Ok(())
+}
+
+fn graph_snapshot_row(connection: &Connection, scope: &str, key: &str) -> anyhow::Result<Row> {
+    let Some(metadata) = graph_snapshot_metadata(connection, scope, key)? else {
+        return Ok(Row {
+            value: None,
+            version: 0,
+            position: None,
+        });
+    };
+    require_bounded_graph_snapshot(&metadata)?;
+    let value = if metadata.exists {
+        let encoded: Vec<u8> = connection.query_row(
+            "SELECT value FROM state_values WHERE scope=?1 AND key=?2 AND version=?3 AND live=1 AND value_bytes=?4 AND stored_bytes=?5",
+            params![scope, key, metadata.version.to_string(), metadata.logical_bytes, metadata.stored_bytes],
+            |row| row.get(0),
+        )?;
+        let decoded = decode_value(&encoded, metadata.logical_bytes)?;
+        Some(serde_json::from_str(&decoded)?)
+    } else {
+        None
+    };
+    Ok(Row {
+        value,
+        version: metadata.version,
+        position: metadata.position,
+    })
+}
+
+fn graph_snapshot_row_for_write(
+    connection: &Connection,
+    scope: &str,
+    key: &str,
+) -> anyhow::Result<Row> {
+    let Some(metadata) = graph_snapshot_metadata(connection, scope, key)? else {
+        return Ok(Row {
+            value: None,
+            version: 0,
+            position: None,
+        });
+    };
+    require_bounded_graph_snapshot(&metadata)?;
+    if super::retrieval::requires_previous_value(scope) {
+        return graph_snapshot_row(connection, scope, key);
+    }
+    Ok(Row {
+        value: None,
+        version: metadata.version,
+        position: metadata.position,
+    })
+}
+
+pub fn row_version(connection: &Connection, scope: &str, key: &str) -> anyhow::Result<u64> {
+    if is_graph_snapshot(scope, key) {
+        let Some(metadata) = graph_snapshot_metadata(connection, scope, key)? else {
+            return Ok(0);
+        };
+        require_bounded_graph_snapshot(&metadata)?;
+        return Ok(metadata.version);
+    }
+    Ok(row(connection, scope, key)?.version)
+}
+
+pub fn decode_value(encoded: &[u8], logical_bytes: i64) -> anyhow::Result<String> {
+    let logical_bytes = usize::try_from(logical_bytes)?;
+    admit_decode(encoded.len(), logical_bytes)?;
+    Ok(super::codec::decode(encoded, logical_bytes)?)
+}
+
+pub fn row(connection: &Connection, scope: &str, key: &str) -> anyhow::Result<Row> {
+    if is_graph_snapshot(scope, key) {
+        return graph_snapshot_row(connection, scope, key);
+    }
+    let mut statement = connection.prepare(
+        "SELECT value,version,position,value_bytes FROM state_values WHERE scope=?1 AND key=?2",
+    )?;
+    let mut rows = statement.query(params![scope, key])?;
+    let Some(raw) = rows.next()? else {
+        return Ok(Row {
+            value: None,
+            version: 0,
+            position: None,
+        });
+    };
+    let encoded = match raw.get_ref(0)? {
+        ValueRef::Null => None,
+        ValueRef::Blob(encoded) => Some(encoded),
+        value => {
+            return Err(rusqlite::Error::InvalidColumnType(
+                0,
+                "value".to_owned(),
+                value.data_type(),
+            )
+            .into());
+        }
+    };
+    let version: String = raw.get(1)?;
+    let position: Option<i64> = raw.get(2)?;
+    let value_bytes: i64 = raw.get(3)?;
+    let value: Option<Value> = encoded
+        .map(|encoded| -> anyhow::Result<Value> {
+            let decoded = decode_value(encoded, value_bytes)?;
+            Ok(serde_json::from_str(&decoded)?)
+        })
+        .transpose()?;
+    Ok(Row {
+        value,
+        version: protocol::counter(&version)?,
+        position,
+    })
+}
+pub fn revision(connection: &Connection, scope: &str) -> anyhow::Result<u64> {
+    let version: Option<String> = connection
+        .query_row(
+            "SELECT revision FROM state_scopes WHERE scope=?1",
+            [scope],
+            |r| r.get(0),
+        )
+        .optional()?;
+    version.map_or(Ok(0), |v| protocol::counter(&v))
+}
+
+pub fn scope_revision(
+    connection: &Connection,
+    scope: &str,
+    prefix: bool,
+) -> anyhow::Result<String> {
+    if !prefix {
+        return Ok(revision(connection, scope)?.to_string());
+    }
+
+    let upper = scope_prefix_upper_bound(scope)?;
+    let mut statement = connection
+        .prepare("SELECT revision FROM state_scopes WHERE scope>=?1 AND scope<?2 ORDER BY scope")?;
+    let mut rows = statement.query(params![scope, upper])?;
+    let mut count = 0u64;
+    let mut total = 0u128;
+    while let Some(row) = rows.next()? {
+        let value: String = row.get(0)?;
+        total = total
+            .checked_add(u128::from(protocol::counter(&value)?))
+            .ok_or_else(|| protocol::error("STATE_TX_LIMIT_EXCEEDED"))?;
+        count = count
+            .checked_add(1)
+            .ok_or_else(|| protocol::error("STATE_TX_LIMIT_EXCEEDED"))?;
+    }
+    Ok(format!("{count}:{total}"))
+}
+
+fn scope_prefix_upper_bound(prefix: &str) -> anyhow::Result<String> {
+    if prefix.is_empty() || !prefix.is_ascii() || prefix.as_bytes().contains(&0) {
+        anyhow::bail!("STATE_SCOPE_REVISION_INVALID_REQUEST");
+    }
+    let mut bytes = prefix.as_bytes().to_vec();
+    let last = bytes.len() - 1;
+    if bytes[last] == u8::MAX {
+        anyhow::bail!("STATE_SCOPE_REVISION_INVALID_REQUEST");
+    }
+    bytes[last] += 1;
+    String::from_utf8(bytes).map_err(Into::into)
+}
+pub fn write(
+    connection: &Connection,
+    scope: &str,
+    key: &str,
+    value: Option<&Value>,
+) -> anyhow::Result<u64> {
+    let old_graph_size = if super::protocol::GRAPH_RECORD_SCOPES.contains(&scope) {
+        Some(super::storage_graph_metadata::row_size(connection, scope, key)?)
+    } else {
+        None
+    };
+    let old = if is_graph_snapshot(scope, key) {
+        graph_snapshot_row_for_write(connection, scope, key)?
+    } else {
+        row(connection, scope, key)?
+    };
+    let version = protocol::next(old.version)?;
+    let old_revision = revision(connection, scope)?;
+    let revision = protocol::next(old_revision)?;
+    connection.execute(
+        "INSERT OR IGNORE INTO state_scopes VALUES(?1,'0',0)",
+        [scope],
+    )?;
+    let position = if value.is_some() {
+        match old
+            .position
+            .filter(|_| is_graph_snapshot(scope, key) || old.value.is_some())
+        {
+            Some(position) => Some(position),
+            None => {
+                let position: i64 = connection.query_row(
+                    "SELECT next_position FROM state_scopes WHERE scope=?1",
+                    [scope],
+                    |r| r.get(0),
+                )?;
+                if position >= 9_007_199_254_740_990 {
+                    return Err(protocol::error("STATE_TX_LIMIT_EXCEEDED"));
+                }
+                connection.execute(
+                    "UPDATE state_scopes SET next_position=?2 WHERE scope=?1",
+                    params![scope, position + 1],
+                )?;
+                Some(position)
+            }
+        }
+    } else {
+        None
+    };
+    let serialized = value.map(serde_json::to_string).transpose()?;
+    let logical_bytes = serialized.as_ref().map_or(0, String::len);
+    let encoded = serialized
+        .as_deref()
+        .map(|text| super::compact::encode(connection,scope,key,&version.to_string(),text))
+        .transpose()?;
+    let bytes = i64::try_from(logical_bytes)?;
+    connection.execute("INSERT INTO state_rows VALUES(?1,?2,?3,?4,?5,?6) ON CONFLICT(scope,key) DO UPDATE SET value=excluded.value,version=excluded.version,position=excluded.position,value_bytes=excluded.value_bytes",
+        params![scope,key,encoded,version.to_string(),position,bytes])?;
+    connection.execute(
+        "UPDATE state_scopes SET revision=?2 WHERE scope=?1",
+        params![scope, revision.to_string()],
+    )?;
+    if let Some(old_size) = old_graph_size {
+        let new_size = super::storage_graph_metadata::RowSize::new(
+            value.is_some(),
+            u64::try_from(logical_bytes)?,
+            u64::try_from(encoded.as_ref().map_or(0, Vec::len))?,
+        );
+        super::storage_graph_metadata::record_write(
+            connection, scope, key, old_revision, revision, old_size, new_size,
+        )?;
+    }
+    super::retrieval::maintain(
+        connection,
+        scope,
+        key,
+        old.value.as_ref(),
+        old.position,
+        value,
+        position,
+        version,
+    )?;
+    super::retrieval::source_changed(connection, scope, key, &old, value, version)?;
+    if let Some(value)=value {super::compact::membership::row(connection,scope,key,position,value)?;}
+    Ok(version)
+}
+
+pub(super) fn configure_snapshot_reader(connection: &Connection) -> anyhow::Result<()> {
+    super::retrieval::lexical_content::validate_format(connection)?;
+    register_value_function(connection)?;
+    super::compact::register(connection)?;
+    connection.busy_timeout(Duration::from_millis(100))?;
+    connection.execute_batch("PRAGMA query_only=ON; PRAGMA cache_size=-8192; PRAGMA mmap_size=0; PRAGMA temp_store=MEMORY")?;
+    Ok(())
+}
+
+pub(super) fn combined_format(c:&Connection)->anyhow::Result<()> {
+    anyhow::ensure!(!c.is_autocommit(),"STATE_TX_INVALID_REQUEST");
+    let version:i64=c.pragma_query_value(None,"user_version",|r|r.get(0))?;
+    anyhow::ensure!([2,3,4].contains(&version),"STATE_TX_INVALID_REQUEST");
+    c.pragma_update(None,"user_version",4)?;Ok(())
+}
