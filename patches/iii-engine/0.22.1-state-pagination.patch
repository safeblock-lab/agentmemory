index 0000000..d1ec5d4
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/codec.rs
@@ -0,0 +1,106 @@
+use flate2::{Compression, Decompress, FlushDecompress, Status, write::ZlibEncoder};
+use std::io::Write;
+
+const COMPRESSED_HEADER: &[u8; 7] = b"\x89AMV2Z\x01";
+const MINIMUM_SAVING_BYTES: usize = 16;
+pub const MAX_LOGICAL_VALUE_BYTES: usize = 16 * 1024 * 1024;
+
+pub fn encode(value: &str) -> anyhow::Result<Vec<u8>> {
+    anyhow::ensure!(
+        value.len() <= MAX_LOGICAL_VALUE_BYTES,
+        "SQLite state value exceeds the native format limit"
+    );
+    let mut encoder = ZlibEncoder::new(Vec::new(), Compression::new(6));
+    encoder.write_all(value.as_bytes())?;
+    let compressed = encoder.finish()?;
+    if compressed
+        .len()
+        .saturating_add(COMPRESSED_HEADER.len())
+        .saturating_add(MINIMUM_SAVING_BYTES)
+        < value.len()
+    {
+        let mut encoded = Vec::with_capacity(COMPRESSED_HEADER.len() + compressed.len());
+        encoded.extend_from_slice(COMPRESSED_HEADER);
+        encoded.extend_from_slice(&compressed);
+        Ok(encoded)
+    } else {
+        Ok(value.as_bytes().to_vec())
+    }
+}
+
+pub fn decode(encoded: &[u8], logical_bytes: usize) -> anyhow::Result<String> {
+    anyhow::ensure!(
+        logical_bytes <= MAX_LOGICAL_VALUE_BYTES,
+        "SQLite state value exceeds the native format limit"
+    );
+    if let Some(compressed) = encoded.strip_prefix(COMPRESSED_HEADER) {
+        let mut decoder = Decompress::new(true);
+        let mut decoded = vec![0; logical_bytes + 1];
+        let status = decoder.decompress(compressed, &mut decoded, FlushDecompress::Finish)?;
+        anyhow::ensure!(
+            status == Status::StreamEnd && decoder.total_in() == compressed.len() as u64,
+            "SQLite state compressed value is incomplete or has trailing bytes"
+        );
+        anyhow::ensure!(
+            decoder.total_out() == logical_bytes as u64,
+            "SQLite state value length mismatch"
+        );
+        decoded.truncate(logical_bytes);
+        return Ok(String::from_utf8(decoded)?);
+    }
+    anyhow::ensure!(
+        encoded.len() == logical_bytes,
+        "SQLite state value length mismatch"
+    );
+    Ok(String::from_utf8(encoded.to_vec())?)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn compact_value_round_trips_exact_json_bytes() {
+        let value = format!(
+            "{{\"text\":\"{}\",\"n\":9007199254740993}}",
+            "repeat/".repeat(4096)
+        );
+        let encoded = encode(&value).unwrap();
+        assert!(encoded.starts_with(COMPRESSED_HEADER));
+        assert!(encoded.len() < value.len() / 4);
+        assert_eq!(decode(&encoded, value.len()).unwrap(), value);
+    }
+
+    #[test]
+    fn small_value_stays_uncompressed_without_changing_bytes() {
+        let value = r#"{"a":1,"b":true}"#;
+        let encoded = encode(value).unwrap();
+        assert_eq!(encoded, value.as_bytes());
+        assert_eq!(decode(&encoded, value.len()).unwrap(), value);
+    }
+
+    #[test]
+    fn rejects_wrong_sizes_and_corrupt_compressed_values() {
+        let value = format!("{{\"text\":\"{}\"}}", "repeat/".repeat(32));
+        let mut encoded = encode(&value).unwrap();
+        assert!(decode(&encoded, value.len() + 1).is_err());
+        let last = encoded.len() - 1;
+        encoded[last] ^= 0xff;
+        assert!(decode(&encoded, value.len()).is_err());
+    }
+
+    #[test]
+    fn rejects_truncation_trailing_bytes_and_expansion_beyond_declared_size() {
+        let value = format!("{{\"text\":\"{}\"}}", "repeat/".repeat(4096));
+        let encoded = encode(&value).unwrap();
+        for end in COMPRESSED_HEADER.len()..encoded.len() {
+            assert!(decode(&encoded[..end], value.len()).is_err());
+        }
+        let mut trailing = encoded.clone();
+        trailing.push(0);
+        assert!(decode(&trailing, value.len()).is_err());
+        assert!(decode(&encoded, 16).is_err());
+        assert!(decode(&encoded, MAX_LOGICAL_VALUE_BYTES + 1).is_err());
+        assert!(decode(&[0xff], 1).is_err());
+    }
+}
