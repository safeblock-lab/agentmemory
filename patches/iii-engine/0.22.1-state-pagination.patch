+        },
+        Step::Rollback=>{
+            c.execute("UPDATE compact_roots AS r SET (scope,key,version)=(SELECT scope,key,version FROM compact_root_originals WHERE root=r.id) WHERE id IN(SELECT value FROM json_each(?1)) AND EXISTS(SELECT 1 FROM compact_root_originals WHERE root=r.id)",[&ids])?;
+            c.execute("DELETE FROM compact_root_originals WHERE root IN(SELECT value FROM json_each(?1))",[&ids])?;
+            c.execute("DELETE FROM compact_root_fields WHERE root IN(SELECT value FROM json_each(?1))",[&ids])?;
+        },
+        Step::Retire=>{c.execute("DELETE FROM compact_root_originals WHERE root IN(SELECT value FROM json_each(?1))",[&ids])?;},
+        _=>unreachable!(),
+    }
+    if processed==rows.len() && rows.len()<r.limit {j.phase=next.into();j.cursor=0;}
+    Ok(())
+}
+fn collect(c:&Connection,r:&Request,j:&mut Job)->anyhow::Result<()> {
+    if j.gc_complete {j.gc_complete=false;j.gc_stage=0;j.gc_cursor=0;}
+    let (sql,delete)=match j.gc_stage {
+        0=>("SELECT f.root,24,NOT EXISTS(SELECT 1 FROM compact_roots r WHERE r.id=f.root) FROM compact_root_fields f WHERE f.root>?1 ORDER BY f.root LIMIT ?2","DELETE FROM compact_root_fields WHERE root=?1"),
+        1=>("SELECT o.root,length(CAST(o.scope AS BLOB))+length(CAST(o.key AS BLOB))+length(CAST(o.version AS BLOB)),NOT EXISTS(SELECT 1 FROM compact_roots r WHERE r.id=o.root) FROM compact_root_originals o WHERE o.root>?1 ORDER BY o.root LIMIT ?2","DELETE FROM compact_root_originals WHERE root=?1"),
+        _=>("SELECT d.id,length(CAST(d.token AS BLOB)),NOT EXISTS(SELECT 1 FROM compact_root_fields f WHERE f.scope=d.id) AND NOT EXISTS(SELECT 1 FROM compact_root_fields f WHERE f.key=d.id) AND NOT EXISTS(SELECT 1 FROM compact_root_fields f WHERE f.version=d.id) FROM compact_root_dictionary d WHERE d.id>?1 ORDER BY d.id LIMIT ?2","DELETE FROM compact_root_dictionary WHERE id=?1"),
+    };
+    let rows=c.prepare_cached(sql)?.query_map(params![j.gc_cursor,r.limit as i64],|v|Ok((v.get::<_,i64>(0)?,v.get::<_,i64>(1)?,v.get::<_,bool>(2)?)))?.collect::<rusqlite::Result<Vec<_>>>()?;
+    let start=Instant::now();let mut bytes=0usize;let mut processed=0;
+    for (id,size,dead) in &rows {
+        database::check_preparation()?;
+        if start.elapsed().as_millis()>=u128::from(r.max_ms)||bytes+usize::try_from(*size)?>r.max_bytes {break;}
+        if *dead {c.execute(delete,[id])?;}
+        bytes+=usize::try_from(*size)?;j.gc_cursor=*id;processed+=1;
+    }
+    if processed==rows.len()&&rows.len()<r.limit {j.gc_cursor=0;if j.gc_stage<2 {j.gc_stage+=1;}else{j.gc_complete=true;}}
+    Ok(())
+}
