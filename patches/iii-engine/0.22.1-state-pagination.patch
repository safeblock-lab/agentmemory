+async fn sqlite_legacy_list_preflight_and_bounded_cache() {
+    let (_directory, adapter) = fresh();
+    adapter
+        .mutate(4096, |connection| {
+            let value = json!({"text":"x".repeat(2048)});
+            for i in 0..36_000 {
+                database::write(connection, "many", &i.to_string(), Some(&value))?;
+            }
+            Ok(())
+        })
+        .await
+        .unwrap();
+    assert_eq!(
+        code(adapter.list("many").await.unwrap_err()),
+        "STATE_TX_LIMIT_EXCEEDED"
+    );
+    let page = adapter
+        .list_page("many", None, 256, 1_048_576)
+        .await
+        .unwrap();
+    assert_eq!(page.items.len(), 256);
+    assert!(protocol::size(&page).unwrap() <= 1_048_576);
+    let cache = adapter
+        .run(4096, |connection| {
+            let mut current = 0;
+            let mut highwater = 0;
+            // The handle belongs exclusively to this executor thread during the status query.
+            let status = unsafe {
+                rusqlite::ffi::sqlite3_db_status(
+                    connection.handle(),
+                    rusqlite::ffi::SQLITE_DBSTATUS_CACHE_USED,
+                    &mut current,
+                    &mut highwater,
