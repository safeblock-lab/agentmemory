+use super::*;
+
+#[test]
+fn native_semantic_candidates_use_cosine_and_deterministic_ties() {
+    let connection = fresh();
+    configure(&connection);
+    upsert(
+        &connection,
+        vec![
+            vector_item("b", &[1.0, 0.0, 0.0, 0.0], Some("graph memory")),
+            vector_item("a", &[1.0, 0.0, 0.0, 0.0], Some("graph memory")),
+            vector_item("near", &[1.0, 0.1, 0.0, 0.0], Some("graph retrieval")),
+            vector_item("other", &[0.0, 1.0, 0.0, 0.0], Some("unrelated")),
+        ],
+    )
+    .unwrap();
+    let value = search(&connection, &[1.0, 0.0, 0.0, 0.0], 64);
+    assert_eq!(&returned_ids(&value)[..2], &["a", "b"]);
+    assert_eq!(value["approximate"], true);
+    assert!(value["candidates"].as_u64().unwrap() <= 64);
+    assert!(value["items"][0]["score"].as_f64().unwrap() > 0.9999);
+    for pair in value["items"].as_array().unwrap().windows(2) {
+        assert!(pair[0]["score"].as_f64().unwrap() >= pair[1]["score"].as_f64().unwrap());
+    }
+}
+
+#[test]
+fn canonical_vector_and_lexical_updates_and_deletes_are_atomic() {
+    let connection = fresh();
+    configure(&connection);
+    upsert(
+        &connection,
+        vec![vector_item(
+            "a",
+            &[1.0, 0.0, 0.0, 0.0],
+            Some("get_code_snippet original"),
+        )],
+    )
+    .unwrap();
+    assert_eq!(
+        returned_ids(&keywords(&connection, "get_code_snippet").unwrap()),
+        vec!["a"]
+    );
+    let mut bad = vector_item("bad", &[1.0, 0.0, 0.0, 0.0], Some("should_not_commit"));
+    bad["embedding"] = json!("not-base64");
+    assert_eq!(
+        code(
+            upsert(
