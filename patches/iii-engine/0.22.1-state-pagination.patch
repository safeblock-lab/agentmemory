+    let scope = format!("mem:graph:inputs:{id}");
+    adapter.commit_batch(batch(owner.clone(),id,"delta:0",0,"0","staging",vec![
+        op(JOBS,id,"0",json!({"version":1,"id":id,"generation":"1","state":"failed","recoveryStopped":true})),
+        op(WORKING,id,"0",working(id,"1","delta:0",None)),op(&scope,"capture","0",json!("retain until close")),
+    ])).await.unwrap();
+    let close = batch(
+        owner,
+        id,
+        "delta:0",
+        1,
+        "1",
+        "complete",
+        vec![check(SNAPSHOT, "current", "0")],
+    );
+    adapter.run(4096,|connection|{ connection.execute_batch("CREATE TRIGGER fail_close BEFORE INSERT ON state_rows WHEN NEW.scope='mem:graph:receipts' BEGIN SELECT RAISE(ABORT,'close failed'); END;")?; Ok(()) }).await.unwrap();
+    assert!(adapter.commit_batch(close.clone()).await.is_err());
+    assert_eq!(
+        adapter.list(&scope).await.unwrap(),
+        vec![json!("retain until close")]
+    );
+    assert_eq!(
+        adapter.list(database::RECEIPT_SCOPE).await.unwrap().len(),
+        1
+    );
+    adapter
+        .run(4096, |connection| {
+            connection.execute_batch("DROP TRIGGER fail_close")?;
+            Ok(())
+        })
+        .await
+        .unwrap();
+    let receipt = adapter.commit_batch(close.clone()).await.unwrap();
+    assert_eq!(adapter.commit_batch(close).await.unwrap(), receipt);
+    assert!(adapter.list(&scope).await.unwrap().is_empty());
+    assert_eq!(
