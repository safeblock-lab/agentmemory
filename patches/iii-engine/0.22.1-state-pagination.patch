+fn queued_work(id:&str,task:&str)->Value {
+    json!({"id":id,"customId":format!("custom-{id}"),"correlationId":format!("corr-{id}"),"callbackProtocolVersion":1,
+        "task":task,"model":"test-model","systemPrompt":"system","userPrompt":"user","maxTokens":128,
+        "state":"queued","attempts":0,"nextAttemptAt":"2026-10-09T00:00:00Z","createdAt":"2026-10-09T00:00:00Z",
+        "updatedAt":"2026-10-09T00:00:00Z","metadata":{"project":"alpha","cluster":"{\"concepts\":[\"bounded\"]}"},
+        "unknownProviderField":{"must":"survive"},"result":null,"completionIntent":null})
+}
+
+fn payload(connection:&Connection,key:&str)->Value {
+    call(connection,json!({"action":"batch_work_payload","keys":[key]})).unwrap()
+}
