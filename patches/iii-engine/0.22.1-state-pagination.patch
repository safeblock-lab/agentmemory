+use super::*;
+
+fn decoded_memberships(connection: &Connection) -> Vec<(i64, String, String, i64)> {
+    connection.prepare("SELECT m.epoch,o.value,k.value,m.position FROM retrieval_membership m JOIN retrieval_identifiers o ON o.epoch=m.epoch AND o.id=m.observation JOIN retrieval_identifiers k ON k.epoch=m.epoch AND k.id=m.key ORDER BY m.epoch,o.value,k.value").unwrap()
+        .query_map([], |r| Ok((r.get(0)?,r.get(1)?,r.get(2)?,r.get(3)?))).unwrap()
+        .collect::<rusqlite::Result<_>>().unwrap()
+}
+
+#[test]
+fn observation_lookup_work_does_not_scan_unrelated_identifiers() {
+    use std::sync::{
+        Arc,
+        atomic::{AtomicUsize, Ordering},
+    };
+    let connection = fresh();
+    write(
+        &connection,
+        graph::NODES,
+        "target",
+        Some(&node("target", "target", &["wanted"])),
+    );
+    let measure = || {
+        let steps = Arc::new(AtomicUsize::new(0));
+        let counted = Arc::clone(&steps);
+        connection
+            .progress_handler(
+                1,
+                Some(move || {
+                    counted.fetch_add(1, Ordering::Relaxed);
+                    false
+                }),
+            )
+            .unwrap();
+        let found = graph_query::seeds(
+            &connection,
+            &[],
+            &["wanted".into()],
+            request::NameMatch::Exact,
+            10,
+            1048576,
+        )
+        .unwrap();
+        connection
+            .progress_handler(0, None::<fn() -> bool>)
+            .unwrap();
+        assert_eq!(ids(&found), vec!["target"]);
+        steps.load(Ordering::Relaxed)
+    };
+    let baseline = measure();
+    let epoch = metadata::graph(&connection, graph::NODES).unwrap().epoch;
+    connection.execute("WITH RECURSIVE n(i) AS (VALUES(1) UNION ALL SELECT i+1 FROM n WHERE i<20000) INSERT INTO retrieval_identifiers(epoch,value) SELECT ?1,'unrelated-'||i FROM n", [epoch]).unwrap();
+    let expanded = measure();
+    assert!(
+        expanded <= baseline + 512,
+        "lookup work grew with unrelated identifiers: {baseline} -> {expanded}"
+    );
+}
+
+#[test]
+fn high_fanout_prepare_preserves_complete_memberships_and_public_bounds() {
+    let connection = fresh();
+    let members: Vec<String> = (0..18_814)
+        .map(|i| format!("observation-{i:012}"))
+        .collect();
+    let references: Vec<&str> = members.iter().map(String::as_str).collect();
+    let original = node("high-fanout", "bounded", &references);
+    write(&connection, graph::NODES, "high-fanout", Some(&original));
+    connection.execute("UPDATE state_scopes SET revision=CAST(CAST(revision AS INTEGER)+1 AS TEXT) WHERE scope=?1",[graph::NODES]).unwrap();
+    call(&connection, json!({"action":"index_status"})).unwrap();
+    let before = metadata::graph(&connection, graph::NODES).unwrap();
+    assert_eq!(
+        code(
+            call(
+                &connection,
+                json!({"action":"index_prepare","scope":graph::NODES,"max_rows":1,"max_bytes":1024})
+            )
+            .unwrap_err()
+        ),
+        "STATE_RETRIEVAL_RESOURCE_LIMIT"
+    );
+    assert_eq!(
+        metadata::graph(&connection, graph::NODES).unwrap().cursor,
+        before.cursor
+    );
+    let prepared = call(
+        &connection,
+        json!({"action":"index_prepare","scope":graph::NODES,"max_rows":1,"max_bytes":1048576}),
+    )
+    .unwrap();
+    assert_eq!(prepared["status"], "ready");
+    assert_eq!(prepared["processed"], 1);
+    let epoch = metadata::graph(&connection, graph::NODES).unwrap().epoch;
+    let indexed: Vec<String> = decoded_memberships(&connection)
+        .into_iter()
+        .filter(|p| p.0 == epoch && p.2 == "high-fanout")
+        .map(|p| p.1)
+        .collect();
+    assert_eq!(indexed, members);
+    for chunk in members.chunks(request::MAX_INPUT_ITEMS) {
+        let found = call(
+            &connection,
+            json!({"action":"graph_seeds","observation_ids":chunk}),
+        )
+        .unwrap();
+        assert_eq!(ids(&found), vec!["high-fanout"]);
+        assert_eq!(found["items"][0]["observation"], true);
+    }
+    assert_eq!(
+        database::row(&connection, graph::NODES, "high-fanout")
+            .unwrap()
+            .value,
+        Some(original)
+    );
+    for invalid in [
+        json!({"action":"graph_seeds","observation_ids":members[..request::MAX_INPUT_ITEMS+1]}),
+        json!({"action":"graph_seeds","max_items":request::MAX_ITEMS+1}),
