+    let before:i64=c.query_row("SELECT count(*) FROM compact_blobs WHERE kind=2",[],|r|r.get(0)).unwrap();
+    c.execute_batch("DELETE FROM compact_list_members WHERE (list_id,identifier) IN(SELECT list_id,identifier FROM compact_list_members ORDER BY list_id,identifier LIMIT 128);").unwrap();
+    assert_eq!(pairs(&c,false),pairs(&c,true));
+    let after:i64=c.query_row("SELECT count(*) FROM compact_blobs WHERE kind=2",[],|r|r.get(0)).unwrap();assert_eq!(before,after);
+    for _ in 0..20 {
+        let lease=storage_maintenance_lease::acquire(&c,"inverse-test",300_000).unwrap();
+        let generation=super::super::compact::status(&c).unwrap()["generation"].as_str().unwrap().to_owned();
+        let tx=c.unchecked_transaction().unwrap();
+        super::super::compact::execute(&tx,super::super::compact::Request {
+            operation_id:format!("collector-{generation}"),expected_generation:generation,
+            step:super::super::compact::Step::Collect,limit:4096,max_bytes:4*1024*1024,max_ms:3000,
+            lease_owner_id:"inverse-test".into(),lease_fence:lease["fence"].as_u64().unwrap(),
+        }).unwrap();tx.commit().unwrap();assert_eq!(pairs(&c,false),pairs(&c,true));
+        if super::super::compact::status(&c).unwrap()["gc_complete"]==true {break;}
+    }
+    assert_eq!(super::super::compact::status(&c).unwrap()["gc_complete"],true);
+}
diff --git a/engine/src/workers/state/adapters/sqlite/storage_operations.rs b/engine/src/workers/state/adapters/sqlite/storage_operations.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/storage_operations.rs
@@ -0,0 +1,64 @@
+use super::{database, protocol::{self, error}};
+use rusqlite::Connection;
+use serde_json::{Value, json};
+
+fn safe_id(value: &Value) -> bool {
+    value.as_str().is_some_and(|id| id.starts_with("op_") && id.len() <= 83
+        && id[3..].bytes().all(|byte| byte.is_ascii_lowercase() || byte.is_ascii_digit() || byte == b'_'))
+}
+fn public_error(code: &str) -> (&'static str, &'static str) {
+    match code {
+        "invalid_input" => ("invalid_input","Required operation input is missing or invalid."),
+        "session_not_found" => ("session_not_found","Session was not found."),
+        "no_observations" => ("no_observations","No observations are available."),
+        "no_provider" => ("no_provider","No provider is configured."),
+        "empty_provider_response" => ("empty_provider_response","Provider returned no usable output."),
+        "parse_failed" => ("parse_failed","Operation output could not be parsed."),
+        "validation_failed" => ("validation_failed","Operation output did not pass validation."),
+        "compression_failed" => ("compression_failed","Compression failed."),
+        "summary_failed" => ("summary_failed","Session summary failed."),
+        "graph_extraction_failed" => ("graph_extraction_failed","Graph extraction failed."),
+        _ => ("operation_failed","Operation failed."),
+    }
+}
+fn sanitize(item: &Value) -> Option<Value> {
+    if !safe_id(&item["id"]) { return None; }
+    let timestamp = chrono::DateTime::parse_from_rfc3339(item["timestamp"].as_str()?).ok()?;
+    let name = match item["functionId"].as_str()? {
+        "mem::compress" => "Compression",
+        "mem::summarize" => "Session summary",
+        "mem::graph-extract" => "Graph extraction",
+        _ => return None,
+    };
+    if !["completed","failed","skipped","queued","partial"].contains(&item["outcome"].as_str()?) { return None; }
+    let mut counts = json!({});
+    for field in ["observationsProcessed","observationsCompressed","summariesCreated","nodesAdded","edgesAdded","unitsQueued"] {
+        if item["counts"][field].as_u64().is_some_and(|count| count <= 9_007_199_254_740_991) { counts[field] = item["counts"][field].clone(); }
+    }
+    let mut value = json!({"id":item["id"],"timestamp":timestamp.to_rfc3339_opts(chrono::SecondsFormat::Millis,true),
+        "functionId":item["functionId"],"outcome":item["outcome"],"name":name,"counts":counts});
+    if item["durationMs"].as_u64().is_some_and(|duration| duration <= 9_007_199_254_740_991) { value["durationMs"] = item["durationMs"].clone(); }
+    if let Some(code) = item["error"]["code"].as_str() {
+        let (code,message) = public_error(code);
+        value["error"] = json!({"code":code,"message":message});
+    }
+    // Historical identifiers are retained only in the bounded machine identifier grammar.
+    if item["agentId"].as_str().is_some_and(|id| !id.is_empty() && id.len() <= 128
+        && id.bytes().all(|byte| byte.is_ascii_alphanumeric() || b"_-.".contains(&byte))) { value["agentId"] = item["agentId"].clone(); }
+    Some(value)
+}
+pub fn prune(connection: &Connection, expected_version: &str) -> anyhow::Result<Value> {
+    let scope = "mem:recent-operations";
+    let row = database::row(connection, scope, "current")?;
+    if row.version != protocol::counter(expected_version)? { return Err(error("STATE_TX_CONFLICT")); }
+    let Some(previous) = row.value else { return Ok(json!({"deleted_count":0,"retained_count":0,"version":row.version.to_string()})) };
+    let source = previous["items"].as_array().cloned().unwrap_or_default();
+    let mut items: Vec<Value> = source.iter().rev().take(30).filter_map(sanitize).collect();
+    items.reverse();
+    let value = json!({"items":items});
+    let before = protocol::size(&previous)?;
+    let after = protocol::size(&value)?;
+    let version = database::write(connection,scope,"current",Some(&value))?;
+    Ok(json!({"deleted_count":source.len().saturating_sub(items.len()),"retained_count":items.len(),
+        "deleted_logical_bytes":before.saturating_sub(after),"version":version.to_string()}))
+}
diff --git a/engine/src/workers/state/adapters/sqlite/storage_profile.rs b/engine/src/workers/state/adapters/sqlite/storage_profile.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/storage_profile.rs
@@ -0,0 +1,109 @@
+use rusqlite::{Connection, ffi};
+use std::{cell::Cell, io::Read, path::Path, sync::OnceLock, time::Instant};
+
+static ENABLED: OnceLock<bool> = OnceLock::new();
+
+#[derive(Clone, Copy, Default)]
+struct SqlCounts { statements:u64, vm:u64, scan:u64, sorts:u64, nanos:u64 }
+thread_local! {
+    static COUNTS: Cell<SqlCounts> = Cell::new(SqlCounts::default());
+    static ACTIVE: Cell<bool> = const { Cell::new(false) };
+}
+
+pub fn configure(path:&Path) {
+    let matched=std::env::var_os("III_SQLITE_STORAGE_PROFILE_PATH").and_then(|target| {
+        std::fs::canonicalize(path).ok().zip(std::fs::canonicalize(target).ok())
+    }).is_some_and(|(actual,target)|actual==target);
+    let _=ENABLED.set(matched);
+}
+pub fn enabled()->bool {*ENABLED.get_or_init(||false)}
+
+#[cfg(windows)]
+fn cpu_us()->Option<u64> {
+    use std::ffi::c_void;
+    #[repr(C)] #[derive(Default)] struct FileTime {low:u32,high:u32}
+    #[link(name="kernel32")]
+    unsafe extern "system" {
+        fn GetCurrentThread()->*mut c_void;
+        fn GetThreadTimes(thread:*mut c_void,created:*mut FileTime,exited:*mut FileTime,kernel:*mut FileTime,user:*mut FileTime)->i32;
+    }
+    let (mut created,mut exited,mut kernel,mut user)=(FileTime::default(),FileTime::default(),FileTime::default(),FileTime::default());
+    let ok=unsafe{GetThreadTimes(GetCurrentThread(),&mut created,&mut exited,&mut kernel,&mut user)};
+    if ok==0 {return None;}
+    let ticks=|time:FileTime| (u64::from(time.high)<<32)|u64::from(time.low);
+    Some(ticks(kernel).saturating_add(ticks(user))/10)
+}
+#[cfg(not(windows))]
+fn cpu_us()->Option<u64> {None}
+
+pub struct Clock {wall:Instant,cpu:Option<u64>,sql:SqlCounts}
+impl Clock {
+    pub fn start()->Option<Self> {
+        enabled().then(||Self{wall:Instant::now(),cpu:cpu_us(),sql:COUNTS.with(Cell::get)})
+    }
+}
+pub fn emit(stage:&'static str,clock:Option<Clock>,rows:usize,bytes:usize) {
+    if let Some(clock)=clock {
+        let sql=COUNTS.with(Cell::get);
+        let cpu=clock.cpu.zip(cpu_us()).map(|(before,after)|after.saturating_sub(before));
+        tracing::info!(target:"iii::storage_profile", stage,wall_us=clock.wall.elapsed().as_micros() as u64,
+            thread_cpu_us=?cpu,rows,input_bytes=bytes,statements=sql.statements.saturating_sub(clock.sql.statements),
+            vm_steps=sql.vm.saturating_sub(clock.sql.vm),fullscan_steps=sql.scan.saturating_sub(clock.sql.scan),
+            sorts=sql.sorts.saturating_sub(clock.sql.sorts),sql_wall_ns=sql.nanos.saturating_sub(clock.sql.nanos),
+            "state storage profile");
+    }
+}
+
+unsafe extern "C" fn trace(mask:u32,_context:*mut std::ffi::c_void,statement:*mut std::ffi::c_void,elapsed:*mut std::ffi::c_void)->i32 {
+    if mask!=ffi::SQLITE_TRACE_PROFILE as u32 || statement.is_null() || elapsed.is_null() {return 0;}
+    let statement=statement.cast::<ffi::sqlite3_stmt>();
+    let status=|code|unsafe{ffi::sqlite3_stmt_status(statement,code,1)}.max(0) as u64;
+    let nanos=unsafe{*elapsed.cast::<i64>()}.max(0) as u64;
+    COUNTS.with(|cell| {
+        let mut counts=cell.get(); counts.statements+=1;
+        counts.vm+=status(ffi::SQLITE_STMTSTATUS_VM_STEP);
+        counts.scan+=status(ffi::SQLITE_STMTSTATUS_FULLSCAN_STEP);
+        counts.sorts+=status(ffi::SQLITE_STMTSTATUS_SORT);
+        counts.nanos=counts.nanos.saturating_add(nanos); cell.set(counts);
+    });
+    0
+}
+fn cache(db:*mut ffi::sqlite3)->[Option<i32>;3] {
+    [ffi::SQLITE_DBSTATUS_CACHE_HIT,ffi::SQLITE_DBSTATUS_CACHE_MISS,ffi::SQLITE_DBSTATUS_CACHE_WRITE].map(|code| {
+        let (mut current,mut high)=(0,0);
+        (unsafe{ffi::sqlite3_db_status(db,code,&mut current,&mut high,0)}==ffi::SQLITE_OK).then_some(current)
+    })
+}
+pub struct Trace {db:*mut ffi::sqlite3,active:bool,before:[Option<i32>;3]}
+impl Trace {
+    pub fn start(connection:&Connection)->Self {
+        let db=unsafe{connection.handle()};
+        COUNTS.with(|counts|counts.set(SqlCounts::default()));
+        let active=unsafe{ffi::sqlite3_trace_v2(db,ffi::SQLITE_TRACE_PROFILE as u32,Some(trace),std::ptr::null_mut())}==ffi::SQLITE_OK;
+        ACTIVE.with(|value|value.set(active));
+        Self{db,active,before:cache(db)}
+    }
+}
+impl Drop for Trace {
+    fn drop(&mut self) {
+        if self.active {unsafe{ffi::sqlite3_trace_v2(self.db,0,None,std::ptr::null_mut());}}
+        let after=cache(self.db);
+        let delta=|index:usize|self.before[index].zip(after[index]).map(|(a,b)|i64::from(b)-i64::from(a));
+        tracing::info!(target:"iii::storage_profile",trace_available=self.active,cache_hits=?delta(0),cache_misses=?delta(1),cache_writes=?delta(2),"state storage cache profile");
+        ACTIVE.with(|value|value.set(false));
+    }
+}
+
+pub fn wal(stage:&'static str,connection:&Connection,path:&Path) {
+    if !enabled() {return;}
+    let bytes=std::fs::metadata(format!("{}-wal",path.display())).ok().map(|m|m.len());
+    let mut header=[0u8;100];
+    let readable=std::fs::File::open(format!("{}-shm",path.display())).and_then(|mut file|file.read_exact(&mut header)).is_ok();
+    // Layout verified against the bundled SQLite WalIndexHdr/WalCkptInfo, not application data.
+    let stable=readable && header[..48]==header[48..96] && header[12]==1;
+    let number=|offset|stable.then(||u32::from_ne_bytes(header[offset..offset+4].try_into().unwrap()));
+    let autocheckpoint=connection.pragma_query_value(None,"wal_autocheckpoint",|r|r.get::<_,i64>(0)).ok();
+    tracing::info!(target:"iii::storage_profile",stage,wal_allocated_bytes=?bytes,wal_header_stable=stable,
+        wal_frames=?number(16),backfilled_frames=?number(96),wal_change=?number(8),autocheckpoint_pages=?autocheckpoint,
+        "state storage WAL profile");
+}
diff --git a/engine/src/workers/state/adapters/sqlite/storage_prune.rs b/engine/src/workers/state/adapters/sqlite/storage_prune.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/storage_prune.rs
@@ -0,0 +1,415 @@
+use super::{database, protocol::{self, error, require}};
+use rusqlite::{Connection, params};
+use serde::Deserialize;
+use serde_json::{Value, json};
+use std::collections::HashSet;
+use sha2::{Digest, Sha256};
+
+pub(super) const TEMPORAL_WORK: &str = "mem:temporal-graph-work";
+const TEMPORAL_PENDING: &str = "mem:temporal-graph-pending";
+const DEPENDENCY_BYTES: i64 = 128 * 1024;
+
+pub(super) fn bounded_dependency(connection: &Connection, scope: &str, key: &str) -> anyhow::Result<Option<Value>> {
+    let fits: bool = connection.query_row("SELECT EXISTS(SELECT 1 FROM state_values WHERE scope=?1 AND key=?2 AND live=1 AND value_bytes<=?3 AND stored_bytes<=?3)", params![scope,key,DEPENDENCY_BYTES], |row| row.get(0))?;
+    if !fits { return Ok(None); }
+    Ok(database::row(connection, scope, key)?.value)
+}
+fn parent_id(id: &str) -> bool {
+    id.strip_prefix("temporaljob_").is_some_and(|suffix| suffix.len() == 16 && suffix.bytes().all(|byte| byte.is_ascii_hexdigit() && !byte.is_ascii_uppercase()))
+}
+fn origin_valid(origin: &Value, job_id: &str, digest: &Value) -> bool {
+    let (Some(parent),Some(page),Some(fingerprint)) = (origin["parentId"].as_str(),origin["pageIndex"].as_u64(),origin["unitFingerprint"].as_str()) else { return false };
+    if origin["version"] != 1 || !parent_id(parent) || page > 9_007_199_254_740_991 || fingerprint.is_empty() || fingerprint.len() > 128 || origin["captureDigest"] != *digest || !digest.as_str().is_some_and(|digest| digest.len()==64 && digest.bytes().all(|byte| byte.is_ascii_hexdigit())) { return false; }
+    let hash = hex::encode(Sha256::digest(format!("{parent}:{page}:{fingerprint}").as_bytes()));
+    job_id == format!("graphjob_{}", &hash[..16])
+}
+pub(super) fn temporal_parent_complete(parent: &Value, id: &str) -> bool {
+    parent["version"] == 1 && parent["id"] == id && parent["state"] == "completed"
+        && parent["pageCount"].as_u64().is_some_and(|count| count > 0 && count <= 9_007_199_254_740_991 && parent["currentPage"].as_u64() == Some(count))
+        && parent.get("activeUnitJobId").is_none_or(Value::is_null)
+        && parent.get("cursor").is_none_or(Value::is_null)
+        && parent["workUnits"].as_u64().is_some_and(|count| count <= 9_007_199_254_740_991)
+        && parent.get("nativeTemporalPrunedUnits").is_none_or(|count| count.as_u64().is_some_and(|count| Some(count) <= parent["workUnits"].as_u64()))
+        && parent["createdAt"].as_str().is_some_and(|date| chrono::DateTime::parse_from_rfc3339(date).is_ok())
+}
+fn temporal_dependencies(connection: &Connection, id: &str) -> anyhow::Result<bool> {
+    let prefix = format!("temporal-work:{id}:page:");
+    Ok(connection.query_row("SELECT EXISTS(SELECT 1 FROM state_values WHERE scope=?1 AND key>=?2 AND key<?3 AND live=1) OR EXISTS(SELECT 1 FROM state_values WHERE scope=?4 AND key=?5 AND live=1)", params![TEMPORAL_WORK,prefix,format!("{prefix}~"),TEMPORAL_PENDING,id], |row| row.get(0))?)
+}
+// Origin survives the first pruning page, which can remove capture:0 before a later retry.
+fn temporal_origin(connection: &Connection, job_id: &str, job: &Value) -> anyhow::Result<Option<Value>> {
+    if protocol::size(job)? > DEPENDENCY_BYTES as usize { return Ok(None); }
+    let origin = if let Some(origin) = job.get("nativeTemporalOrigin") {
+        if !origin_valid(origin, job_id, &job["captureDigest"]) { return Ok(None); }
+        origin.clone()
+    } else {
+        if job["captureComplete"] != true || job["captureParts"] != 1 { return Ok(None); }
+        let Some(capture) = bounded_dependency(connection, &format!("mem:graph:inputs:{job_id}"), "capture:0")? else { return Ok(None) };
+        let Some(text) = capture.as_str() else { return Ok(None) };
+        if job["captureDigest"] != hex::encode(Sha256::digest(text.as_bytes())) { return Ok(None); }
+        let Ok(request) = serde_json::from_str::<Value>(text) else { return Ok(None) };
+        if request["temporalUnitVersion"] != 2 { return Ok(None); }
+        let origin = json!({"version":1,"parentId":request["jobId"],"pageIndex":request["pageIndex"],"unitFingerprint":request["unit"]["fingerprint"],"captureDigest":job["captureDigest"]});
+        if !origin_valid(&origin, job_id, &job["captureDigest"]) { return Ok(None); }
+        origin
+    };
+    Ok(Some(origin))
+}
+pub(super) fn remember_temporal_origin(connection: &Connection, job_id: &str, job: &Value) -> anyhow::Result<()> {
+    if job["kind"] != "temporal" || job.get("nativeTemporalOrigin").is_some() { return Ok(()); }
+    let origin = temporal_origin(connection,job_id,job)?.ok_or_else(|| error("STATE_TX_CONFLICT"))?;
+    let mut enriched = job.clone(); enriched["nativeTemporalOrigin"] = origin;
+    database::write(connection,super::protocol::JOBS,job_id,Some(&enriched))?;
+    Ok(())
+}
+pub(super) fn temporal_unit_ready(connection: &Connection, job_id: &str, job: &Value) -> anyhow::Result<bool> {
+    if job["kind"] != "temporal" { return Ok(true); }
+    let Some(origin) = temporal_origin(connection,job_id,job)? else { return Ok(false); };
+    let id = origin["parentId"].as_str().expect("validated origin");
+    let key = format!("temporal-work:{id}:manifest");
+    let Some(parent) = bounded_dependency(connection,TEMPORAL_WORK,&key)? else { return Ok(false) };
+    Ok(temporal_parent_complete(&parent,id) && origin["pageIndex"].as_u64() < parent["pageCount"].as_u64() && !temporal_dependencies(connection,id)?)
+}
+pub(super) fn temporal_unit_pruned(connection: &Connection, job_id: &str) -> anyhow::Result<()> {
+    let Some(mut job) = bounded_dependency(connection,super::protocol::JOBS,job_id)? else { return Ok(()) };
+    if job["kind"] != "temporal" { return Ok(()); }
+    let origin = &job["nativeTemporalOrigin"];
+    require(origin_valid(origin,job_id,&job["captureDigest"]))?;
+    let id = origin["parentId"].as_str().expect("validated origin");
+    let key = format!("temporal-work:{id}:manifest");
+    let mut parent = bounded_dependency(connection,TEMPORAL_WORK,&key)?.ok_or_else(|| error("STATE_TX_CONFLICT"))?;
+    require(temporal_parent_complete(&parent,id) && !temporal_dependencies(connection,id)?)?;
+    let epoch = parent["createdAt"].clone();
+    if job["nativeTemporalPrunedFor"] == epoch { return Ok(()); }
+    let count = parent["nativeTemporalPrunedUnits"].as_u64().unwrap_or(0);
+    require((count == 0 || parent["nativeTemporalPruneEpoch"] == epoch) && count < parent["workUnits"].as_u64().unwrap_or(0))?;
+    parent["nativeTemporalPrunedUnits"] = json!(count + 1);
+    parent["nativeTemporalPruneEpoch"] = epoch.clone();
+    job["nativeTemporalPrunedFor"] = epoch;
+    database::write(connection,TEMPORAL_WORK,&key,Some(&parent))?;
+    database::write(connection,super::protocol::JOBS,job_id,Some(&job))?;
+    Ok(())
+}
+fn temporal_eligible(connection: &Connection, scope: &str, key: &str, value: &Value, reference: Option<&Reference>, cutoff: i64) -> anyhow::Result<bool> {
+    if scope == TEMPORAL_WORK && key.ends_with(":manifest") {
+        let Some(id) = key.strip_prefix("temporal-work:").and_then(|key| key.strip_suffix(":manifest")) else { return Ok(false) };
+        if !parent_id(id) || !temporal_parent_complete(value,id) || temporal_dependencies(connection,id)? { return Ok(false); }
+        let count = value["nativeTemporalPrunedUnits"].as_u64().unwrap_or(0);
+        return Ok(value["workUnits"].as_u64() == Some(count) && (count == 0 || value["nativeTemporalPruneEpoch"] == value["createdAt"]));
+    }
+    let Some(reference) = reference.filter(|reference| reference.scope == TEMPORAL_WORK) else { return Ok(false) };
+    let Some(id) = reference.key.strip_prefix("temporal-work:").and_then(|key| key.strip_suffix(":manifest")).filter(|id| parent_id(id)) else { return Ok(false) };
+    if database::row_version(connection,TEMPORAL_WORK,&reference.key)? != protocol::counter(&reference.expected_version)? { return Ok(false); }
+    let Some(parent) = bounded_dependency(connection,TEMPORAL_WORK,&reference.key)? else { return Ok(false) };
+    if !temporal_parent_complete(&parent,id) || age(&parent).is_none_or(|date| date > cutoff) { return Ok(false); }
+    if scope == TEMPORAL_PENDING { return Ok(key == id && value["version"] == 1 && value["jobId"] == id && value["state"] == "pending"); }
+    let prefix = format!("temporal-work:{id}:page:");
+    Ok(key.strip_prefix(&prefix).and_then(|index| index.parse::<u64>().ok().filter(|parsed| parsed.to_string() == index)).is_some_and(|index| Some(index) < parent["currentPage"].as_u64()))
+}
+
+pub const PROTECTED_JOB: &str = "graphjob_muzu6a4k_c7aa10a891eb";
+pub fn protected(value: &str) -> bool {
+    [PROTECTED_JOB, "graphjob_mv0567t0_7c392765f08d", "reflectjob_e7a9c192888162d1", "sqj_35a1a8c630506d43", "sq_8cf665f4a99f64b", "squ_mv4r30wc_5a82fdfbd842", "sqd_mv4r30xr_58ba4d5d4d64"].iter().any(|id| value.contains(id))
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Reference { scope: String, key: String, expected_version: String }
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Candidate {
+    scope: String,
+    key: String,
+    expected_version: String,
+    preserved: Option<Reference>,
+    #[serde(default)]
+    retention: Option<super::retention_use_guard::Guard>,
+}
+fn age(value: &Value) -> Option<i64> {
+    let mut latest = None;
+    for field in ["completedAt", "endedAt", "updatedAt", "lastSeenAt", "lastAt", "occurredAt", "timestamp", "capturedAt", "createdAt", "startedAt"] {
+        if let Some(value) = value.get(field) {
+            let date = chrono::DateTime::parse_from_rfc3339(value.as_str()?).ok()?.timestamp_millis();
+            latest = Some(latest.map_or(date, |old: i64| old.max(date)));
+        }
+    }
+    if let Some(value) = value.get("at") {
+        let at = value.as_i64().filter(|at| *at >= 0 && *at <= 9_007_199_254_740_991)?;
+        latest = Some(latest.map_or(at, |old| old.max(at)));
+    }
+    latest
+}
+fn queue_eligible(connection: &Connection, scope: &str, key: &str, value: &Value, reference: Option<&Reference>) -> anyhow::Result<bool> {
+    let job_id = if scope == "mem:summary-queue:jobs" { Some(key) }
+        else if let Some(id) = scope.strip_prefix("mem:summary-queue:units:") { Some(id) }
+        else { value["jobId"].as_str() };
+    let Some(job_id) = job_id else { return Ok(false) };
+    let Some(reference)=reference.filter(|r|r.scope=="mem:summary-queue:jobs" && r.key==job_id) else {return Ok(false);};
+    if database::row_version(connection,&reference.scope,&reference.key)?!=protocol::counter(&reference.expected_version)? {return Ok(false);}
+    let Some(job) = bounded_dependency(connection, "mem:summary-queue:jobs", job_id)? else { return Ok(false) };
+    if !terminal_old_enough(&job) {return Ok(false);}
+    if protected(&serde_json::to_string(&job)?) || job["status"] != "completed" || job["dispatchPending"] == true
+        || ["recoveryOfJobId", "zeroSpendRecoveryOfJobId", "recoveryMode", "recoveryGeneration"].iter().any(|field| job.get(*field).is_some_and(|value| !value.is_null())) { return Ok(false); }
+    let Some(session_id) = job["sessionId"].as_str() else { return Ok(false) };
+    let Some(summary) = bounded_dependency(connection,"mem:summaries",session_id)? else { return Ok(false) };
+    let Some(completed) = bounded_dependency(connection,"mem:summary-queue:completed",session_id)? else { return Ok(false) };
+    let Some(effect) = bounded_dependency(connection,"mem:state",&format!("{job_id}:publication-effect"))? else { return Ok(false) };
+    if completed["jobId"] != job_id || completed["fingerprint"] != job["snapshotFingerprint"] || effect["summary"] != summary { return Ok(false); }
+    let active: bool = connection.query_row("SELECT EXISTS(SELECT 1 FROM state_values WHERE scope='mem:summary-queue:active' AND key=?1 AND live=1)", [session_id], |row| row.get(0))?;
+    if active || protected(&serde_json::to_string(&effect)?) || protected(&serde_json::to_string(&summary)?) { return Ok(false) }
+    // The job is the durable replay/recovery identity even after disposable units are gone.
+    if scope == "mem:summary-queue:jobs" { return Ok(false); }
+    Ok(true)
+}
+fn raw_preserved(connection: &Connection, scope: &str, key: &str, value: &Value, reference: Option<&Reference>) -> anyhow::Result<bool> {
+    let Some(reference) = reference else { return Ok(false) };
+    if reference.scope != scope || reference.key == key { return Ok(false); }
+    let Some(session) = scope.strip_prefix("mem:obs:") else { return Ok(false) };
+    let Some(digest) = value["identityIndexedDigest"].as_str().filter(|digest| value["identityDigest"] == *digest) else { return Ok(false) };
+    let Some(identity) = bounded_dependency(connection,&format!("mem:obs-identity:{session}"),digest)? else { return Ok(false) };
+    if identity["observationId"] != reference.key || identity["identityDigest"] != digest { return Ok(false); }
+    let Some(preserved) = bounded_dependency(connection,&reference.scope,&reference.key)? else { return Ok(false) };
+    if database::row_version(connection,&reference.scope,&reference.key)? != protocol::counter(&reference.expected_version)? { return Ok(false); }
+    if protected(&serde_json::to_string(&preserved)?) || preserved["rawRetained"] == false
+        || preserved["sessionId"] != value["sessionId"] || preserved["hookType"] != value["hookType"]
+        || preserved["identityDigest"] != digest || preserved.get("raw").is_none() { return Ok(false); }
+    let (Some(first),Some(last),Some(count),Some(provenance)) = (value["firstSeenAt"].as_str(),value["lastSeenAt"].as_str(),value["occurrenceCount"].as_u64(),value["provenance"].as_array()) else { return Ok(false) };
+    let (Ok(first),Ok(last),Some(saved_first),Some(saved_last),Some(saved_count),Some(saved_provenance)) = (
+        chrono::DateTime::parse_from_rfc3339(first),chrono::DateTime::parse_from_rfc3339(last),
+        preserved["firstSeenAt"].as_str().and_then(|at| chrono::DateTime::parse_from_rfc3339(at).ok()),
+        preserved["lastSeenAt"].as_str().and_then(|at| chrono::DateTime::parse_from_rfc3339(at).ok()),
+        preserved["occurrenceCount"].as_u64(),preserved["provenance"].as_array()) else { return Ok(false) };
+    if count == 0 || saved_count < count || saved_first > first || saved_last < last
+        || value["provenanceOverflowCount"].as_u64().unwrap_or(0) != 0
+        || preserved["provenanceOverflowCount"].as_u64().unwrap_or(0) != 0
+        || !provenance.iter().all(|entry| saved_provenance.contains(entry)) { return Ok(false); }
+    Ok(["raw","toolInput","toolOutput","userPrompt","assistantResponse","imageData"].iter()
+        .all(|field| value.get(*field).is_none_or(|original| preserved.get(*field) == Some(original))))
+}
+
+fn canonical_raw(value:&Value)->anyhow::Result<String> {
+    Ok(match value {
+        Value::Object(fields)=>{
+            let mut keys:Vec<_>=fields.keys().collect();keys.sort();
+            let parts=keys.into_iter().map(|key|Ok(format!("{}:{}",serde_json::to_string(key)?,canonical_raw(&fields[key])?))).collect::<anyhow::Result<Vec<_>>>()?;
+            format!("{{{}}}",parts.join(","))
+        }
+        Value::Array(items)=>format!("[{}]",items.iter().map(canonical_raw).collect::<anyhow::Result<Vec<_>>>()?.join(",")),
+        _=>serde_json::to_string(value)?,
+    })
+}
+
+pub(super) fn compressed_source_reason(connection: &Connection, scope: &str, key: &str, value: &Value) -> anyhow::Result<&'static str> {
+    let Some(session)=scope.strip_prefix("mem:obs:") else {return Ok("not_observation_scope")};
+    let Some(digest)=value["identityDigest"].as_str().filter(|digest|digest.len()==64) else {return Ok("compressed_identity_digest_missing")};
+    if value["id"]!=key || value["sessionId"]!=session || value["compressionMethod"]!="llm"
+        || !matches!(value["hookType"].as_str(),Some("post_tool_use"|"post_tool_failure"))
+        || !value["sourceIdentityDigests"].as_array().is_some_and(|ids|ids.contains(&json!(digest)))
+        || !["title","narrative"].iter().all(|field|value[*field].as_str().is_some_and(|text|!text.trim().is_empty()))
+        || !value["facts"].as_array().is_some_and(|facts|facts.iter().all(Value::is_string))
+        || value["occurrenceCount"].as_u64().is_none_or(|count|count==0)
+        || !value["provenance"].as_array().is_some_and(|entries|!entries.is_empty())
+        || !["firstSeenAt","lastSeenAt"].iter().all(|field|value[*field].as_str().is_some_and(|at|chrono::DateTime::parse_from_rfc3339(at).is_ok()))
+        || value["provenanceOverflowCount"].as_u64().unwrap_or(0)!=0
+        || value.get("imageData").is_some() || value.get("imageRef").is_some() {return Ok("compressed_knowledge_or_provenance_not_proven");}
+    let Some(identity)=bounded_dependency(connection,&format!("mem:obs-identity:{session}"),digest)? else {return Ok("native_admission_index_missing_or_oversized")};
+    if identity["identityDigest"]!=digest || identity["observationId"]!=key {return Ok("native_admission_index_owner_mismatch");}
+    if value["identityIndexedDigest"]==digest {return Ok("legacy_indexed_compression");}
+    // Admission's index has no row version. The caller pins the current row version;
+    // recomputation proves that its retained raw still names this exact source.
+    if value.get("identityIndexedDigest").is_some() {return Ok("native_admission_marker_conflict");}
+    let Some(raw)=value.get("raw") else {return Ok("native_admission_raw_missing")};
+    let canonical=format!("{{\"data\":{},\"hookType\":{},\"sessionId\":{},\"version\":1}}",canonical_raw(raw)?,serde_json::to_string(&value["hookType"])?,serde_json::to_string(session)?);
+    if hex::encode(Sha256::digest(canonical.as_bytes()))!=digest {return Ok("native_admission_current_raw_digest_mismatch");}
+    Ok("native_admission_exact_source_compression")
+}
+
+pub(super) fn compressed_source(connection:&Connection,scope:&str,key:&str,value:&Value)->anyhow::Result<bool> {
+    Ok(matches!(compressed_source_reason(connection,scope,key,value)?,"legacy_indexed_compression"|"native_admission_exact_source_compression"))
+}
+fn plain_eligible(scope: &str, value: &Value) -> bool {
+    match scope {
+        "mem:audit" | "mem:access" | "mem:recent-searches" => true,
+        "mem:routine-runs" => value["status"] == "completed",
+        "mem:signals" => value["readAt"].as_str().is_some_and(|at| chrono::DateTime::parse_from_rfc3339(at).is_ok())
+            || value["expiresAt"].as_str().and_then(|at| chrono::DateTime::parse_from_rfc3339(at).ok()).is_some_and(|at| at.timestamp_millis() <= chrono::Utc::now().timestamp_millis()),
+        _ => false,
+    }
+}
+pub fn prune(connection: &Connection, candidates: Vec<Candidate>, max_bytes: u64) -> anyhow::Result<Value> {
+    prune_at(connection,candidates,max_bytes,chrono::Utc::now().timestamp_millis())
+}
+pub(super) fn prune_at(connection: &Connection, candidates: Vec<Candidate>, max_bytes: u64, now:i64) -> anyhow::Result<Value> {
+    require(candidates.len() <= 128 && (1..=4*1024*1024).contains(&max_bytes))?;
+    let total = candidates.len();
+    let candidate_keys: HashSet<_> = candidates.iter().map(|candidate| (candidate.scope.clone(),candidate.key.clone())).collect();
+    let cutoff = now - 7 * 24 * 60 * 60 * 1000;
+    let mut seen = HashSet::new();
+    let mut deleted = 0;
+    let mut stripped = 0;
+    let mut logical = 0u64;
+    let mut stored = 0u64;
+    let mut skipped = 0;
+    let mut processed = 0;
+    let mut admitted_bytes = 0u64;
+    let mut admitted_decode_bytes = 0u64;
+    for candidate in candidates {
+        require(candidate.scope.len() <= 4096 && candidate.key.len() <= 4096 && seen.insert((candidate.scope.clone(),candidate.key.clone())))?;
+        if protected(&candidate.scope) || protected(&candidate.key) { skipped += 1; processed += 1; continue; }
+        let plain = ["mem:audit","mem:metrics","mem:health","mem:access","mem:recent-searches","mem:routine-runs","mem:signals"].contains(&candidate.scope.as_str());
+        let observation = candidate.scope.starts_with("mem:obs:");
+        let event = candidate.scope.starts_with("mem:obs-events:");
+        let queue = candidate.scope == "mem:summary-queue:jobs" || candidate.scope == "mem:summary-queue:intents" || candidate.scope.starts_with("mem:summary-queue:units:");
+        let temporal = candidate.scope == TEMPORAL_WORK || candidate.scope == TEMPORAL_PENDING;
+        let legacy_cache = super::storage_legacy_cache::family(&candidate.scope);
+        if !plain && !observation && !queue && !event && !temporal && !legacy_cache { skipped += 1; processed += 1; continue; }
+        let bytes: Option<(i64,i64)> = connection.query_row("SELECT value_bytes,COALESCE(stored_bytes,0) FROM state_values WHERE scope=?1 AND key=?2 AND live=1",
+            params![candidate.scope,candidate.key], |row| Ok((row.get(0)?,row.get(1)?))).optional()?;
+        let Some((logical_bytes,stored_bytes)) = bytes else { skipped += 1; processed += 1; continue; };
+        let cost = u64::try_from(logical_bytes)?;
+        let decode_cost = cost.max(u64::try_from(stored_bytes)?);
+        if decode_cost > max_bytes { skipped += 1; processed += 1; continue; }
+        if admitted_decode_bytes.saturating_add(decode_cost) > max_bytes { break; }
+        admitted_bytes += cost;
+        admitted_decode_bytes += decode_cost;
+        let row = database::row(connection,&candidate.scope,&candidate.key)?;
+        if row.version != protocol::counter(&candidate.expected_version)? { skipped += 1; processed += 1; continue; }
+        let value = row.value.ok_or_else(|| error("STATE_TX_CONFLICT"))?;
+        if let Some(proof)=candidate.retention.as_ref() {
+            if !super::retention_use_guard::recheck(connection,&candidate.scope,&candidate.key,&value,proof)? {
+                skipped+=1; processed+=1; continue;
+            }
+        } else if observation || candidate.scope == "mem:recent-searches" || candidate.scope == "mem:routine-runs" {
+            // Raw-body retention requires a pinned native use/owner proof; technical callers cannot bypass it.
+            skipped+=1; processed+=1; continue;
+        }
+        if row_protected(&value) || protected(&serde_json::to_string(&value)?) { skipped += 1; processed += 1; continue; }
+        // Completed units clear startedAt; their validated parent publication owns terminal age.
+        if !legacy_cache && !queue && (!temporal || candidate.key.ends_with(":manifest")) && age(&value).is_none_or(|date| date > cutoff) { skipped += 1; processed += 1; continue; }
+        // Obsolescence is proven against the current corpus, never a fabricated age.
+        if legacy_cache && super::storage_legacy_cache::reason(connection,&candidate.scope,&candidate.key,&value)? != "legacy_cache_stale_dimension_canonical_preserved" { skipped += 1; processed += 1; continue; }
+        if temporal && !temporal_eligible(connection,&candidate.scope,&candidate.key,&value,candidate.preserved.as_ref(),cutoff)? { skipped += 1; processed += 1; continue; }
+        if queue && !queue_eligible(connection,&candidate.scope,&candidate.key,&value,candidate.preserved.as_ref())? { skipped += 1; processed += 1; continue; }
+        // Event receipts are the only exact replay identities; age cannot prove expiry.
+        if event || (plain && !plain_eligible(&candidate.scope,&value)) { skipped += 1; processed += 1; continue; }
+        if observation {
+            if !matches!(value["hookType"].as_str(),Some("post_tool_use"|"post_tool_failure")) { skipped += 1; processed += 1; continue; }
+            let compressed=candidate.preserved.is_none() && compressed_source(connection,&candidate.scope,&candidate.key,&value)?;
+            if !compressed && candidate.preserved.as_ref().is_none_or(|reference| candidate_keys.contains(&(reference.scope.clone(),reference.key.clone()))) { skipped += 1; processed += 1; continue; }
+            if value.get("raw").is_none() || (!compressed && !raw_preserved(connection,&candidate.scope,&candidate.key,&value,candidate.preserved.as_ref())?) { skipped += 1; processed += 1; continue; }
+            let mut replacement = value.clone();
+            for field in ["raw","toolInput","toolOutput","userPrompt","assistantResponse"] { replacement.as_object_mut().expect("stored object").remove(field); }
+            if let Some(reference)=candidate.preserved.as_ref() {
+                replacement["rawSource"] = json!({"scope":reference.scope,"key":reference.key});
+            } else {
+                replacement["rawRetentionEvidence"]=json!({"kind":"durable_compressed_observation","sourceVersion":candidate.expected_version,"identityDigest":value["identityDigest"],"knowledgeDigest":hex::encode(Sha256::digest(serde_json::to_vec(&json!([value["title"],value["facts"],value["narrative"]]))?))});
+            }
+            replacement["rawRetained"] = json!(false);
+            replacement["rawExpiredAt"] = json!(chrono::Utc::now().to_rfc3339_opts(chrono::SecondsFormat::Millis,true));
+            let after = protocol::size(&replacement)? as u64;
+            if let Some(proof)=candidate.retention.as_ref() {
+                super::retention_use_guard::require_recheck(connection,&candidate.scope,&candidate.key,&value,proof)?;
+            }
+            database::write(connection,&candidate.scope,&candidate.key,Some(&replacement))?;
+            super::retention_use_schema::forget_body(connection,&candidate.scope,&candidate.key)?;
+            let after_stored: i64 = connection.query_row("SELECT COALESCE(stored_bytes,0) FROM state_values WHERE scope=?1 AND key=?2",params![candidate.scope,candidate.key],|row| row.get(0))?;
+            logical += cost.saturating_sub(after);
+            stored += u64::try_from(stored_bytes)?.saturating_sub(u64::try_from(after_stored)?);
+            stripped += 1;
+        } else {
+            // Technical scopes have no retrieval indexes or graph replay ownership.
+            connection.execute("DELETE FROM state_rows WHERE scope=?1 AND key=?2",params![candidate.scope,candidate.key])?;
+            let revision = protocol::next(database::revision(connection,&candidate.scope)?)?.to_string();
+            connection.execute("UPDATE state_scopes SET revision=?2 WHERE scope=?1",params![candidate.scope,revision])?;
+            logical += cost;
+            stored += u64::try_from(stored_bytes)?;
+            deleted += 1;
+        }
+        processed += 1;
+    }
+    Ok(json!({"deleted_count":deleted,"raw_stripped_count":stripped,"deleted_logical_bytes":logical,
+        "deleted_stored_bytes":stored,"physical_bytes_reclaimed":null,"skipped_count":skipped,"processed_count":processed,
+        "cutoff_at_ms":cutoff,"done":processed == total,"input_logical_bytes":admitted_bytes}))
+}
