+use super::{database, protocol::{self, error, require}};
+use rusqlite::Connection;
+use serde::Deserialize;
+use serde_json::{Value, json};
+use sha2::{Digest, Sha256};
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Admit {
+    session_id: String,
+    identity_digest: String,
+    event_id: String,
+    occurred_at: String,
+    observation: Value,
+    provenance: Value,
+    session: Option<Value>,
+    max_observations: Option<u64>,
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Replace {
+    session_id: String,
+    observation_id: String,
+    expected_version: String,
+    observation: Value,
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Index {
+    pub session_id: String,
+    pub observation_id: String,
+    pub identity_digest: String,
+    pub canonical_identity: String,
+    pub expected_version: String,
+}
+fn identifier(value: &str) -> anyhow::Result<()> {
+    require(!value.is_empty() && value.len() <= 512 && !value.chars().any(char::is_control))
+}
+fn digest(value: &str) -> anyhow::Result<()> {
+    require(value.len() == 64 && value.bytes().all(|byte| byte.is_ascii_hexdigit()))
+}
+fn timestamp(value: &str) -> anyhow::Result<i64> {
+    chrono::DateTime::parse_from_rfc3339(value).map(|value| value.timestamp_millis())
+        .map_err(|_| error("STATE_TX_INVALID_REQUEST"))
+}
+fn scope(session: &str) -> String { format!("mem:obs:{session}") }
+fn identity_scope(session: &str) -> String { format!("mem:obs-identity:{session}") }
+fn event_scope(session: &str) -> String { format!("mem:obs-events:{session}") }
+fn provenance(value: &mut Value, source: Value, occurred_at: &str) -> anyhow::Result<()> {
+    let at = timestamp(occurred_at)?;
+    let mut entries = value["provenance"].as_array().cloned().unwrap_or_default();
+    require(entries.len() <= 32)?;
+    let existing = entries.iter_mut().find(|entry| {
+        let mut candidate = (*entry).clone();
+        if let Some(candidate) = candidate.as_object_mut() { for key in ["count","firstSeenAt","lastSeenAt"] { candidate.remove(key); } }
+        candidate == source
+    });
+    if let Some(entry) = existing {
+        entry["count"] = json!(protocol::next(entry["count"].as_u64().unwrap_or(1))?);
+        if entry["firstSeenAt"].as_str().is_none_or(|old| timestamp(old).is_ok_and(|old| at < old)) { entry["firstSeenAt"] = json!(occurred_at); }
+        if entry["lastSeenAt"].as_str().is_none_or(|old| timestamp(old).is_ok_and(|old| at > old)) { entry["lastSeenAt"] = json!(occurred_at); }
+    } else if entries.len() < 32 {
+        let mut source = source;
+        source["count"] = json!(1);
+        source["firstSeenAt"] = json!(occurred_at);
+        source["lastSeenAt"] = json!(occurred_at);
+        entries.push(source);
+    } else { return Err(error("STATE_TX_LIMIT_EXCEEDED")); }
+    value["provenance"] = json!(entries);
+    Ok(())
+}
+fn result(value: Value, version: u64, created: bool, duplicate_event: bool) -> Value {
+    json!({"created":created,"duplicate_event":duplicate_event,"observation_id":value["id"],
+        "version":version.to_string(),"occurrence_count":value["occurrenceCount"],
+        "first_seen_at":value["firstSeenAt"],"last_seen_at":value["lastSeenAt"],"observation":value})
+}
+const UNSCOPED_OBSERVATION_COUNT_LIMIT: u64 = 4096;
+fn check_unscoped_observation_limit(connection: &Connection, session_id: &str, limit: u64) -> anyhow::Result<()> {
+    let query_limit = limit.min(UNSCOPED_OBSERVATION_COUNT_LIMIT) as i64;
+    let mut statement = connection.prepare(
+        "SELECT 1 FROM state_values WHERE scope=?1 AND live=1 AND key<>'__ready__' ORDER BY position LIMIT ?2",
+    )?;
+    let mut rows = statement.query(rusqlite::params![identity_scope(session_id), query_limit])?;
+    let mut count = 0;
+    while rows.next()?.is_some() { count += 1; }
+    if count >= limit { return Err(error("STATE_OBSERVATION_LIMIT")); }
+    if limit > UNSCOPED_OBSERVATION_COUNT_LIMIT && count == UNSCOPED_OBSERVATION_COUNT_LIMIT {
+        return Err(error("STATE_TX_LIMIT_EXCEEDED"));
+    }
+    Ok(())
+}
+pub fn admit(connection: &Connection, request: Admit) -> anyhow::Result<Value> {
+    identifier(&request.session_id)?;
+    digest(&request.identity_digest)?;
+    digest(&request.event_id)?;
+    let at = timestamp(&request.occurred_at)?;
+    require(request.provenance.is_object() && protocol::size(&request.provenance)? <= 4096)?;
+    require(request.max_observations.is_none_or(|limit| limit > 0 && limit <= 9_007_199_254_740_991))?;
+    let candidate_id = request.observation["id"].as_str().ok_or_else(|| error("STATE_TX_INVALID_REQUEST"))?;
+    identifier(candidate_id)?;
+    require(request.observation.is_object() && request.observation["sessionId"] == request.session_id)?;
+    require(protocol::size(&request.observation)? <= 4 * 1024 * 1024)?;
+    if !database::row(connection, &identity_scope(&request.session_id), "__ready__")?.value.is_some_and(|value| value["version"] == 1 && value["ready"] == true) {
+        let existing: bool = connection.query_row("SELECT EXISTS(SELECT 1 FROM state_values WHERE scope=?1 AND live=1)", [scope(&request.session_id)], |row| row.get(0))?;
+        if existing { return Err(error("STATE_OBSERVATION_INDEX_PENDING")); }
+        database::write(connection, &identity_scope(&request.session_id), "__ready__", Some(&json!({"version":1,"ready":true})))?;
+    }
+    let identity = database::row(connection, &identity_scope(&request.session_id), &request.identity_digest)?.value;
+    if identity.as_ref().is_some_and(|value| value["observationId"].as_str().is_none() || value["identityDigest"] != request.identity_digest) { return Err(error("STATE_OBSERVATION_IDENTITY_DANGLING")); }
+    let canonical_id = identity.as_ref().and_then(|value| value["observationId"].as_str()).unwrap_or(candidate_id).to_owned();
+    let row = database::row(connection, &scope(&request.session_id), &canonical_id)?;
+    if identity.is_some() && row.value.is_none() { return Err(error("STATE_OBSERVATION_IDENTITY_DANGLING")); }
+    if let Some(previous) = row.value.as_ref().filter(|_| identity.is_some()) {
+        require(previous["hookType"] == request.observation["hookType"]
+            && previous.get("raw") == request.observation.get("raw"))?;
+    }
+    let event = database::row(connection, &event_scope(&request.session_id), &request.event_id)?.value;
+    if let Some(event) = event {
+        require(event["identityDigest"] == request.identity_digest && event["observationId"] == canonical_id)?;
+        return Ok(result(row.value.ok_or_else(|| error("STATE_OBSERVATION_IDENTITY_DANGLING"))?, row.version, false, true));
+    }
+    let created = identity.is_none();
+    if created && row.value.is_some() { return Err(error("STATE_TX_CONFLICT")); }
+    let mut session = database::row(connection, "mem:sessions", &request.session_id)?.value.or(request.session.clone());
+    if created {
+        let count = session.as_ref().and_then(|value| value["observationCount"].as_u64()).unwrap_or(0);
+        if let Some(limit) = request.max_observations {
+            if session.is_none() { check_unscoped_observation_limit(connection, &request.session_id, limit)?; }
+            else if count >= limit { return Err(error("STATE_OBSERVATION_LIMIT")); }
+        }
+        if let Some(session) = &mut session {
+            require(session.is_object() && session["id"] == request.session_id)?;
+            if session.get("firstPrompt").is_none() {
+                if let Some(prompt) = request.session.as_ref().and_then(|value| value.get("firstPrompt")) { session["firstPrompt"] = prompt.clone(); }
+            }
+            session["observationCount"] = json!(count.checked_add(1).filter(|count| *count <= 9_007_199_254_740_991).ok_or_else(|| error("STATE_TX_LIMIT_EXCEEDED"))?);
+            session["updatedAt"] = json!(chrono::Utc::now().to_rfc3339_opts(chrono::SecondsFormat::Millis, true));
+            database::write(connection, "mem:sessions", &request.session_id, Some(session))?;
+        }
+    }
+    let mut value = row.value.unwrap_or(request.observation);
+    let previous_count = if created { 0 } else { value["occurrenceCount"].as_u64().unwrap_or(1) };
+    value["occurrenceCount"] = json!(previous_count.checked_add(1).filter(|count| *count <= 9_007_199_254_740_991).ok_or_else(|| error("STATE_TX_LIMIT_EXCEEDED"))?);
+    value["identityDigest"] = json!(request.identity_digest);
+    let old_first = value["firstSeenAt"].as_str().filter(|value| timestamp(value).is_ok_and(|old| old <= at));
+    value["firstSeenAt"] = json!(old_first.unwrap_or(&request.occurred_at));
+    let old_last = value["lastSeenAt"].as_str().filter(|value| timestamp(value).is_ok_and(|old| old >= at));
+    value["lastSeenAt"] = json!(old_last.unwrap_or(&request.occurred_at));
+    provenance(&mut value, request.provenance, &request.occurred_at)?;
+    let version = database::write(connection, &scope(&request.session_id), &canonical_id, Some(&value))?;
+    if created { database::write(connection, &identity_scope(&request.session_id), &request.identity_digest, Some(&json!({"observationId":canonical_id,"identityDigest":request.identity_digest})))?; }
+    database::write(connection, &event_scope(&request.session_id), &request.event_id, Some(&json!({"observationId":canonical_id,"identityDigest":request.identity_digest,"occurredAt":request.occurred_at})))?;
+    Ok(result(value, version, created, false))
+}
+pub fn replace(connection: &Connection, request: Replace) -> anyhow::Result<Value> {
+    identifier(&request.session_id)?;
+    identifier(&request.observation_id)?;
+    let row = database::row(connection, &scope(&request.session_id), &request.observation_id)?;
+    if row.version != protocol::counter(&request.expected_version)? { return Err(error("STATE_TX_CONFLICT")); }
+    let previous = row.value.ok_or_else(|| error("STATE_TX_CONFLICT"))?;
+    let mut value = request.observation;
+    require(value.is_object() && value["id"] == request.observation_id && value["sessionId"] == request.session_id)?;
+    require(protocol::size(&value)? <= 4 * 1024 * 1024)?;
+    for field in ["raw", "toolInput", "toolOutput", "userPrompt", "assistantResponse", "imageData", "modality", "hookType", "timestamp", "agentId", "origin",
+        "identityDigest", "identityIndexedDigest", "rawSource", "rawRetained", "rawExpiredAt", "occurrenceCount", "firstSeenAt", "lastSeenAt", "provenance", "provenanceOverflowCount"] {
+        if let Some(metadata) = previous.get(field) { value[field] = metadata.clone(); }
+        else { value.as_object_mut().expect("validated object").remove(field); }
+    }
+    require(protocol::size(&value)? <= 4 * 1024 * 1024)?;
+    let version = database::write(connection, &scope(&request.session_id), &request.observation_id, Some(&value))?;
+    Ok(result(value, version, false, false))
+}
+pub fn index(connection: &Connection, request: Index) -> anyhow::Result<Value> {
+    identifier(&request.session_id)?;
+    identifier(&request.observation_id)?;
+    digest(&request.identity_digest)?;
+    require(request.canonical_identity.len() <= 4 * 1024 * 1024)?;
+    require(format!("{:x}", Sha256::digest(request.canonical_identity.as_bytes())) == request.identity_digest)?;
+    let identity: Value = serde_json::from_str(&request.canonical_identity)?;
+    require(identity["version"] == 1 && identity["sessionId"] == request.session_id)?;
+    let row = database::row(connection, &scope(&request.session_id), &request.observation_id)?;
+    if row.version != protocol::counter(&request.expected_version)? { return Err(error("STATE_TX_CONFLICT")); }
+    let mut value = row.value.ok_or_else(|| error("STATE_TX_CONFLICT"))?;
+    require(value.get("raw").is_some() && value["hookType"] == identity["hookType"] && value["raw"] == identity["data"])?;
+    require(value.get("storageBounds").is_none() && value.get("title").is_none())?;
+    let occurred_at = value["timestamp"].as_str().ok_or_else(|| error("STATE_TX_INVALID_REQUEST"))?.to_owned();
+    let at = timestamp(&occurred_at)?;
+    let event_id = format!("{:x}",Sha256::digest(serde_json::to_string(&json!([request.session_id,occurred_at,request.identity_digest]))?.as_bytes()));
+    let identity = database::row(connection,&identity_scope(&request.session_id),&request.identity_digest)?.value;
+    let canonical_id = identity.as_ref().and_then(|identity| identity["observationId"].as_str()).unwrap_or(&request.observation_id).to_owned();
+    if value["identityIndexedDigest"] == request.identity_digest {
+        require(identity.is_some())?;
+        return Ok(json!({"indexed":false,"canonical_id":canonical_id,"duplicate_event":true}));
+    }
+    if let Some(event) = database::row(connection,&event_scope(&request.session_id),&event_id)?.value {
+        require(event["identityDigest"] == request.identity_digest && event["observationId"] == canonical_id)?;
+        value["identityIndexedDigest"] = json!(request.identity_digest);
+        database::write(connection,&scope(&request.session_id),&request.observation_id,Some(&value))?;
+        return Ok(json!({"indexed":false,"canonical_id":canonical_id,"duplicate_event":true}));
+    }
+    let mut original = value.clone();
+    let mut source = json!({"sessionId":request.session_id,"hookType":value["hookType"]});
+    if let Some(agent) = value["agentId"].as_str().filter(|agent| agent.len() <= 128) { source["agentId"] = json!(agent); }
+    if let Some(channel) = value["origin"]["channel"].as_str() { source["origin"] = json!({"channel":channel}); }
+    let indexed = identity.is_none();
+    if canonical_id != request.observation_id {
+        value = database::row(connection,&scope(&request.session_id),&canonical_id)?.value.ok_or_else(|| error("STATE_OBSERVATION_IDENTITY_DANGLING"))?;
+        value["occurrenceCount"] = json!(protocol::next(value["occurrenceCount"].as_u64().unwrap_or(1))?);
+    } else { value["occurrenceCount"] = json!(value["occurrenceCount"].as_u64().unwrap_or(1)); }
+    value["identityDigest"] = json!(request.identity_digest);
+    if canonical_id == request.observation_id { value["identityIndexedDigest"] = json!(request.identity_digest); }
+    if value["firstSeenAt"].as_str().is_none_or(|old| timestamp(old).is_ok_and(|old| at < old)) { value["firstSeenAt"] = json!(occurred_at); }
+    if value["lastSeenAt"].as_str().is_none_or(|old| timestamp(old).is_ok_and(|old| at > old)) { value["lastSeenAt"] = json!(occurred_at); }
+    provenance(&mut value,source,&occurred_at)?;
+    database::write(connection,&scope(&request.session_id),&canonical_id,Some(&value))?;
+    if canonical_id != request.observation_id {
+        original["identityIndexedDigest"] = json!(request.identity_digest);
+        database::write(connection,&scope(&request.session_id),&request.observation_id,Some(&original))?;
+    }
+    if indexed { database::write(connection,&identity_scope(&request.session_id),&request.identity_digest,Some(&json!({"observationId":canonical_id,"identityDigest":request.identity_digest})))?; }
+    database::write(connection,&event_scope(&request.session_id),&event_id,Some(&json!({"observationId":canonical_id,"identityDigest":request.identity_digest,"occurredAt":occurred_at})))?;
+    Ok(json!({"indexed":indexed,"canonical_id":canonical_id,"occurrence_count":value["occurrenceCount"]}))
+}
