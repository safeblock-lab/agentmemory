+        }
+        let scope = format!("mem:obs:{session}");
+        let row:Option<(String,i64)>=c.query_row("SELECT version,value_bytes FROM state_rows WHERE scope=?1 AND key=?2 AND value IS NOT NULL",params![scope,id],|r|Ok((r.get(0)?,r.get(1)?))).optional()?;
+        if let Some((version, logical)) = row {
+            match projection::project_row(
+                c, meta, &session, &id, &version, logical, true, *processed, *bytes,
+                max_bytes,
+            )? {
+                projection::RowResult::Blocked => return Ok(true),
+                projection::RowResult::Budget => return Ok(false),
+                projection::RowResult::Done(needed) => *bytes += needed,
+            }
+        }
+        c.execute(
+            "DELETE FROM retrieval_scoped_dirty WHERE index_id=?1 AND session=?2 AND id=?3",
+            params![meta.index_id, token, id],
+        )?;
+        *processed += 1;
+    }
+    Ok(false)
+}
