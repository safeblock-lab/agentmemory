+use super::super::protocol;
+use rusqlite::{Connection,OptionalExtension,params};
+use serde_json::{Value,json};
+
+#[derive(Clone,Copy)]
+pub struct Options<'a> {
+    pub project:Option<&'a str>,pub session_id:Option<&'a str>,pub source_scope:Option<&'a str>,
+    pub source_kind:Option<&'a str>,pub include_text:bool,pub max_bytes:usize,
+}
+
+pub fn filter(scope_parameter:&str,kind_parameter:&str)->String {
+    format!(" AND ({scope_parameter} IS NULL OR EXISTS(SELECT 1 FROM retrieval_source_items si WHERE si.index_id=v.index_id AND si.scope={scope_parameter} AND si.key=v.id AND si.dirty=0)) AND ({kind_parameter} IS NULL OR EXISTS(SELECT 1 FROM retrieval_source_items si INDEXED BY retrieval_source_items_id WHERE si.index_id=v.index_id AND si.key=v.id AND si.scope>='mem:obs:' AND si.scope<'mem:obs;' AND si.dirty=0)) ")
+}
+
+pub fn enrich(connection:&Connection,index:&str,items:&mut Vec<Value>,options:Options<'_>)->anyhow::Result<Option<&'static str>> {
+    if !options.include_text {return Ok(None);}
+    let mut statement=connection.prepare("SELECT substr(f.text,1,2048),s.scope,s.version FROM retrieval_source_items s INDEXED BY retrieval_source_items_id CROSS JOIN retrieval_lexical_links l ON l.index_id=s.index_id AND l.id=s.key CROSS JOIN retrieval_semantic_meta m ON m.index_id=l.index_id AND m.epoch=l.epoch CROSS JOIN retrieval_lexical f ON f.rowid=l.rowid WHERE s.index_id=?1 AND s.key=?2 AND s.dirty=0 AND (?3 IS NULL OR s.scope=?3) AND (?4 IS NULL OR (s.scope>='mem:obs:' AND s.scope<'mem:obs;')) AND (?5 IS NULL OR s.scope<'mem:obs:' OR s.scope>='mem:obs;' OR s.scope='mem:obs:'||?5) LIMIT 1")?;
+    let mut output=Vec::with_capacity(items.len());let mut bytes=2048usize;let mut partial=None;
+    for mut item in items.drain(..) {
+        let id=item["obsId"].as_str().ok_or_else(||protocol::error("STATE_INDEX_NOT_READY"))?;
+        let projection:Option<(String,String,String)>=statement.query_row(params![index,id,options.source_scope,options.source_kind,options.session_id],|r|Ok((r.get(0)?,r.get(1)?,r.get(2)?))).optional()?;
+        let Some((mut text,scope,version))=projection else {partial=Some("projection_source_missing");continue;};
+        protocol::counter(&version)?;
+        let mut end=text.len().min(2048);while !text.is_char_boundary(end) {end-=1;}text.truncate(end);
+        item["text"]=json!(text);item["source_scope"]=json!(scope);item["source_version"]=json!(version);
+        let needed=protocol::size(&item)?+1;
+        if bytes+needed>options.max_bytes {partial=Some("projection_budget");break;}
+        bytes+=needed;output.push(item);
+    }
+    *items=output;Ok(partial)
+}
