+#[test]
+fn canonical_scoped_old_foreign_and_malformed_legacy_embeddings_never_acknowledge() {
+    for (field, value) in [
+        ("sourceVersion", json!("0")),
+        ("sourceScope", json!("mem:obs:foreign")),
+        ("embedding", json!("not-base64")),
+        ("model", json!("foreign-model")),
+    ] {
+        let c = fixture();
+        let original = database::row(&c, "mem:semantic:observations", "a")
+            .unwrap()
+            .value
+            .unwrap();
+        let mut invalid = original.clone();
+        invalid[field] = value;
+        replace_stored(&c, "a", &invalid);
+        let before = semantic::get(&c, "observations").unwrap();
+        let result = call(&c, request(16)).unwrap();
+        assert_eq!(result["status"], "partial", "{field}: {result}");
+        assert_eq!(result["reason"], "project_source_not_ready");
+        assert_eq!(result["processed"], 0);
+        assert!(proof(&c, "a").is_none(), "{field} acknowledged");
+        let after = semantic::get(&c, "observations").unwrap();
+        assert_eq!(
+            (after.count, after.lexical_count),
+            (before.count, before.lexical_count)
+        );
+        let derived:bool=c.query_row("SELECT EXISTS(SELECT 1 FROM retrieval_scoped_vectors WHERE index_id='observations' AND id='a')",[],|r|r.get(0)).unwrap();
+        assert!(!derived);
+        replace_stored(&c, "a", &original);
+        assert_eq!(call(&c, request(16)).unwrap()["status"], "ready");
+        assert_ready_hit(&c);
+    }
+}
