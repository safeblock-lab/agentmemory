+    assert_eq!(empty["status"], "ready");
+    assert_eq!(empty["complete"], true);
+    assert_eq!(empty["rows"], 0);
+    assert_eq!(empty["logical_bytes"], 0);
+    assert_eq!(empty["stored_bytes"], 0);
+}
