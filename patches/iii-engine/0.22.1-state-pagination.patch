+
+#[test]
+fn project_sessions_page_reports_catalog_not_ready_without_returning_rows() {
+    let connection = fresh();
+    write(&connection, "mem:sessions", "session-a", Some(&session("session-a", "project-a", "private-a")));
+    connection.execute(
+        "UPDATE retrieval_project_catalog SET status='pending' WHERE source='sessions'",
