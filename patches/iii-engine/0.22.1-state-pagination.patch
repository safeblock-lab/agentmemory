+struct Capture(Box<dyn FnOnce(&Connection, &mpsc::Receiver<Job>, &mut snapshot_read_view::Views) + Send>);
+struct Pending(Arc<AtomicUsize>);
+struct CancelPreparation(Option<database::PreparationBudget>);
+impl Drop for CancelPreparation {
+    fn drop(&mut self) { if let Some(budget) = &self.0 { budget.cancel(); } }
+}
+impl Drop for Pending {
+    fn drop(&mut self) { self.0.fetch_sub(1, Ordering::AcqRel); }
+}
+
+fn configured_path(config: Option<&Value>) -> anyhow::Result<PathBuf> {
+    let path = match config.and_then(|config| config.get("file_path")) {
+        Some(Value::String(path)) => path.as_str(),
+        Some(_) => return Err(protocol::error("STATE_TX_INVALID_REQUEST")),
+        None => DEFAULT_DATABASE_PATH,
+    };
+    if path.is_empty() {
+        return Err(protocol::error("STATE_TX_INVALID_REQUEST"));
+    }
+    Ok(PathBuf::from(path))
+}
