+fn append_bounded_feed_fits(existing: &[Value], item: &Value, limit: usize) -> bool {
+    let first_kept = existing.len().saturating_sub(limit.saturating_sub(1));
+    let mut size = 2usize;
+    let mut count = 0usize;
+    for value in existing[first_kept..].iter().chain(std::iter::once(item)) {
+        if count > 0 {
+            size = size.saturating_add(1);
+        }
+        let encoded_bytes = serde_json::to_vec(value).map_or(usize::MAX, |encoded| encoded.len());
+        size = size.saturating_add(encoded_bytes);
