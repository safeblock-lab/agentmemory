+#[test]
+fn canonical_scoped_legacy_version_change_between_cuts_stays_pending_until_current_embedding() {
+    let c = fixture();
+    observe(&c, "b", "needle before");
+    embed(&c, "b");
+    forget_derived(&c, "b");
+    let first = call(&c, request(1)).unwrap();
+    assert_eq!(first["processed"], 1);
+    assert_eq!(first["status"], "pending");
+    observe(&c, "b", "needle after");
+    let result = call(&c, request(16)).unwrap();
+    assert_eq!(result["status"], "partial", "{result}");
+    assert_eq!(proof(&c, "a"), Some(("1".to_owned(), false)));
+    assert_eq!(proof(&c, "b"), Some(("2".to_owned(), true)));
+    embed(&c, "b");
+    assert_eq!(call(&c, request(16)).unwrap()["status"], "ready");
+    assert_eq!(proof(&c, "b"), Some(("2".to_owned(), false)));
+}
