+CREATE TABLE IF NOT EXISTS compact_forward_config(singleton INTEGER PRIMARY KEY CHECK(singleton=1),writing INTEGER NOT NULL CHECK(writing IN(0,1)),active INTEGER NOT NULL CHECK(active IN(0,1)),revision INTEGER NOT NULL CHECK(revision>=0));
+INSERT OR IGNORE INTO compact_forward_config VALUES(1,0,0,0);
+CREATE TABLE IF NOT EXISTS compact_forward_blocks(list_id INTEGER NOT NULL CHECK(list_id>0),edge INTEGER NOT NULL CHECK(edge>=0),payload BLOB NOT NULL,PRIMARY KEY(list_id,edge)) WITHOUT ROWID;
+CREATE TABLE IF NOT EXISTS forward_repack_job(singleton INTEGER PRIMARY KEY CHECK(singleton=1),value TEXT NOT NULL);
+CREATE TABLE IF NOT EXISTS forward_repack_receipts(operation_id TEXT PRIMARY KEY,digest BLOB NOT NULL,result TEXT NOT NULL) WITHOUT ROWID;
+CREATE TRIGGER IF NOT EXISTS compact_forward_split_INSERT AFTER INSERT ON compact_forward_blocks WHEN state_forward_count(NEW.payload)>64 BEGIN
+INSERT INTO compact_forward_blocks VALUES(NEW.list_id,state_forward_split(NEW.payload),state_forward_slice(NEW.payload,1));
+UPDATE compact_forward_blocks SET payload=state_forward_slice(NEW.payload,0) WHERE list_id=NEW.list_id AND edge=NEW.edge; END;
+CREATE TRIGGER IF NOT EXISTS compact_forward_split_UPDATE AFTER UPDATE ON compact_forward_blocks WHEN state_forward_count(NEW.payload)>64 BEGIN
+INSERT INTO compact_forward_blocks VALUES(NEW.list_id,state_forward_split(NEW.payload),state_forward_slice(NEW.payload,1));
+UPDATE compact_forward_blocks SET payload=state_forward_slice(NEW.payload,0) WHERE list_id=NEW.list_id AND edge=NEW.edge; END;
+CREATE TRIGGER IF NOT EXISTS compact_forward_revision_INSERT AFTER INSERT ON compact_forward_blocks BEGIN UPDATE compact_forward_config SET revision=revision+1 WHERE singleton=1; END;
+CREATE TRIGGER IF NOT EXISTS compact_forward_revision_UPDATE AFTER UPDATE ON compact_forward_blocks BEGIN UPDATE compact_forward_config SET revision=revision+1 WHERE singleton=1; END;
+CREATE TRIGGER IF NOT EXISTS compact_forward_revision_DELETE AFTER DELETE ON compact_forward_blocks BEGIN UPDATE compact_forward_config SET revision=revision+1 WHERE singleton=1; END;
+CREATE TRIGGER IF NOT EXISTS compact_forward_empty AFTER UPDATE ON compact_forward_blocks WHEN state_forward_count(NEW.payload)=0 BEGIN DELETE FROM compact_forward_blocks WHERE list_id=NEW.list_id AND edge=NEW.edge; END;
+CREATE VIEW IF NOT EXISTS compact_forward_members AS
+SELECT list_id,identifier FROM compact_list_members WHERE (SELECT active FROM compact_forward_config WHERE singleton=1)=0
+UNION ALL SELECT b.list_id,CAST(j.value AS INTEGER) FROM compact_forward_blocks b CROSS JOIN json_each(state_forward_ids(b.payload)) j WHERE (SELECT active FROM compact_forward_config WHERE singleton=1)=1;
