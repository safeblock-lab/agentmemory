+    embed(&c, "a", "s");
+    observation(&c, "dirty-foreign", "foreign", "needle");
+    c.execute("DELETE FROM retrieval_project_vectors", [])
+        .unwrap();
+    c.execute(
+        "UPDATE retrieval_project_vector_meta SET status='pending',cursor=''",
+        [],
+    )
+    .unwrap();
+    c.execute("UPDATE retrieval_scoped_meta SET status='pending'", [])
+        .unwrap();
+    c.execute("DELETE FROM retrieval_scoped_postings", [])
+        .unwrap();
+    c.execute("DELETE FROM retrieval_scoped_lexical", [])
+        .unwrap();
+    c.execute("DELETE FROM retrieval_scoped_vectors", [])
+        .unwrap();
+    let first = cut(&c, "selected", 16);
+    assert_eq!(first["status"], "ready", "{first}");
+    assert_eq!(first["processed"], 1);
+    assert_eq!(first["project"], "selected");
