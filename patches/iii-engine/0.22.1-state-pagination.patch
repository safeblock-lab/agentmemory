+}
+
+fn sql_error(error: impl Into<anyhow::Error>) -> rusqlite::Error {
+    rusqlite::Error::UserFunctionError(error.into().into())
+}
+
+struct Concat;
+impl Aggregate<Vec<u8>, Vec<u8>> for Concat {
+    fn init(&self, _: &mut Context<'_>) -> rusqlite::Result<Vec<u8>> { Ok(Vec::new()) }
+    fn step(&self, context: &mut Context<'_>, bytes: &mut Vec<u8>) -> rusqlite::Result<()> {
+        let part = context.get::<Vec<u8>>(0)?;
+        if bytes.len().saturating_add(part.len()) > LIMIT {
+            return Err(sql_error(anyhow::anyhow!("STATE_TX_LIMIT_EXCEEDED")));
+        }
+        bytes.extend_from_slice(&part);
+        Ok(())
+    }
+    fn finalize(&self, _: &mut Context<'_>, bytes: Option<Vec<u8>>) -> rusqlite::Result<Vec<u8>> {
+        bytes.ok_or_else(|| sql_error(anyhow::anyhow!("STATE_COMPACT_CORRUPT")))
+    }
+}
+
+pub fn root(bytes: &[u8]) -> anyhow::Result<Option<i64>> {
+    if !bytes.starts_with(MARKER) { return Ok(None); }
+    anyhow::ensure!(bytes.len() == MARKER.len() + 8, "STATE_COMPACT_CORRUPT");
+    let id = i64::from_le_bytes(bytes[MARKER.len()..].try_into()?);
+    anyhow::ensure!(id > 0, "STATE_COMPACT_CORRUPT");
+    Ok(Some(id))
+}
+
+pub fn marker(id: i64) -> Vec<u8> {
+    [MARKER, &id.to_le_bytes()].concat()
+}
+
+pub fn register(connection: &Connection) -> anyhow::Result<()> {
+    super::text_layout::register(connection)?;
+    let flags = FunctionFlags::SQLITE_UTF8 | FunctionFlags::SQLITE_DETERMINISTIC | FunctionFlags::SQLITE_INNOCUOUS;
+    connection.create_scalar_function("state_compact_root", 1, flags, |ctx| {
+        match ctx.get_raw(0) {
+            ValueRef::Null => Ok(None),
+            ValueRef::Blob(bytes)|ValueRef::Text(bytes) => root(bytes).map_err(sql_error),
+            _ => Err(sql_error(anyhow::anyhow!("STATE_COMPACT_CORRUPT"))),
+        }
+    })?;
+    connection.create_scalar_function("state_compact_vector_root",1,flags,|ctx| {
+        let bytes=ctx.get::<Vec<u8>>(0)?;
+        if bytes.len()==MARKER.len()+8 {root(&bytes).map_err(sql_error)} else {Ok(None)}
+    })?;
+    connection.create_scalar_function("state_compact_piece", 3, flags, |ctx| {
+        let kind = ctx.get::<i64>(0)?;
+        let bytes = ctx.get::<Vec<u8>>(1)?;
+        let logical = usize::try_from(ctx.get::<i64>(2)?).map_err(sql_error)?;
+        let text = match kind {
+            0 => super::codec::decode(&bytes, logical).map_err(sql_error)?,
+            1 => serde_json::to_string(&STANDARD.encode(bytes)).map_err(sql_error)?,
+            _ => return Err(sql_error(anyhow::anyhow!("STATE_COMPACT_CORRUPT"))),
+        };
+        if kind==0 && text.len()!=logical { return Err(sql_error(anyhow::anyhow!("STATE_COMPACT_CORRUPT"))); }
+        Ok(text.into_bytes())
+    })?;
+    connection.create_scalar_function("state_compact_ids", 1, flags, |ctx| {
+        let bytes = ctx.get::<Vec<u8>>(0)?;
+        serde_json::to_string(&layout::unpack(&bytes).map_err(sql_error)?).map_err(sql_error)
+    })?;
+    connection.create_scalar_function("state_compact_required", 2, flags, |ctx| {
+        let bytes = ctx.get::<Option<Vec<u8>>>(0)?.ok_or_else(|| sql_error(anyhow::anyhow!("STATE_COMPACT_CORRUPT")))?;
+        let logical = usize::try_from(ctx.get::<i64>(1)?).map_err(sql_error)?;
+        if bytes.len() != logical || bytes.len() > LIMIT {
+            return Err(sql_error(anyhow::anyhow!("STATE_COMPACT_CORRUPT")));
+        }
+        Ok(bytes)
+    })?;
+    connection.create_aggregate_function("state_compact_concat", 1, flags, Concat)?;
+    super::storage_membership_repack::register(connection)?;
+    super::storage_forward_repack::register(connection)?;
+    Ok(())
+}
+
+pub fn schema(c: &Connection) -> anyhow::Result<()> {
+    let retired=super::storage_forward_repack::retired(c)?;
+    let membership_ddl=if retired {""} else {"CREATE TABLE IF NOT EXISTS compact_list_members(list_id INTEGER NOT NULL,identifier INTEGER NOT NULL,PRIMARY KEY(list_id,identifier)) WITHOUT ROWID;"};
+    c.execute_batch(membership_ddl)?;
+    c.execute_batch("CREATE TABLE IF NOT EXISTS compact_config(singleton INTEGER PRIMARY KEY CHECK(singleton=1),generation TEXT NOT NULL,mode INTEGER NOT NULL,phase TEXT NOT NULL,last_scope TEXT NOT NULL,last_key TEXT NOT NULL,complete INTEGER NOT NULL,started INTEGER NOT NULL);
+        INSERT OR IGNORE INTO compact_config VALUES(1,'1',0,'legacy','','',0,0);
+        CREATE TABLE IF NOT EXISTS compact_blobs(id INTEGER PRIMARY KEY,kind INTEGER NOT NULL,digest BLOB NOT NULL,logical_bytes INTEGER NOT NULL,payload BLOB NOT NULL);
+        CREATE INDEX IF NOT EXISTS compact_blob_digest ON compact_blobs(kind,digest,logical_bytes);
+        CREATE TABLE IF NOT EXISTS compact_identifiers(id INTEGER PRIMARY KEY,token TEXT NOT NULL UNIQUE);
+        CREATE TABLE IF NOT EXISTS compact_roots(id INTEGER PRIMARY KEY,scope TEXT NOT NULL,key TEXT NOT NULL,version TEXT NOT NULL,logical_bytes INTEGER NOT NULL);
+        CREATE INDEX IF NOT EXISTS compact_root_identity ON compact_roots(scope,key,version);
+        CREATE TABLE IF NOT EXISTS compact_segments(root INTEGER NOT NULL,ordinal INTEGER NOT NULL,blob INTEGER NOT NULL,PRIMARY KEY(root,ordinal)) WITHOUT ROWID;
+        CREATE INDEX IF NOT EXISTS compact_segments_blob ON compact_segments(blob,root);
+        CREATE TABLE IF NOT EXISTS compact_rollback(scope TEXT NOT NULL,key TEXT NOT NULL,version TEXT NOT NULL,value BLOB NOT NULL,value_bytes INTEGER NOT NULL,PRIMARY KEY(scope,key,version)) WITHOUT ROWID;
+        CREATE TABLE IF NOT EXISTS compact_checkpoints(operation_id TEXT PRIMARY KEY,digest BLOB NOT NULL,result TEXT) WITHOUT ROWID;
+        CREATE INDEX IF NOT EXISTS compact_checkpoint_pending ON compact_checkpoints(operation_id) WHERE result IS NULL;
+        CREATE TRIGGER IF NOT EXISTS compact_blob_immutable BEFORE UPDATE ON compact_blobs BEGIN SELECT RAISE(ABORT,'STATE_COMPACT_IMMUTABLE'); END;
+        CREATE TRIGGER IF NOT EXISTS compact_identifier_immutable BEFORE UPDATE ON compact_identifiers BEGIN SELECT RAISE(ABORT,'STATE_COMPACT_IMMUTABLE'); END;
+        CREATE TABLE IF NOT EXISTS compact_receipts(operation_id TEXT PRIMARY KEY,digest BLOB NOT NULL,result TEXT NOT NULL) WITHOUT ROWID;
+        CREATE TABLE IF NOT EXISTS compact_graph_lists(epoch INTEGER NOT NULL,key INTEGER NOT NULL,position INTEGER NOT NULL,list INTEGER NOT NULL,PRIMARY KEY(epoch,key)) WITHOUT ROWID;
+        CREATE INDEX IF NOT EXISTS compact_graph_list_inverse ON compact_graph_lists(list,epoch,key);
+        CREATE TABLE IF NOT EXISTS compact_graph_identifiers(epoch INTEGER NOT NULL,identifier INTEGER NOT NULL,observation INTEGER NOT NULL,PRIMARY KEY(epoch,identifier),UNIQUE(epoch,observation)) WITHOUT ROWID;
+        CREATE VIEW IF NOT EXISTS compact_graph_membership AS SELECT g.epoch,i.observation,g.key,g.position FROM compact_graph_lists g JOIN compact_list_members m ON m.list_id=g.list JOIN compact_graph_identifiers i ON i.epoch=g.epoch AND i.identifier=m.identifier;
+        CREATE VIEW IF NOT EXISTS retrieval_membership_values AS SELECT epoch,observation,key,position FROM retrieval_membership UNION ALL SELECT epoch,observation,key,position FROM compact_graph_membership;
+        CREATE TABLE IF NOT EXISTS compact_vector_refs(index_id TEXT NOT NULL,epoch INTEGER NOT NULL,id TEXT NOT NULL,blob INTEGER NOT NULL,PRIMARY KEY(index_id,epoch,id)) WITHOUT ROWID;
+        CREATE INDEX IF NOT EXISTS compact_vector_blob ON compact_vector_refs(blob);
+        CREATE TABLE IF NOT EXISTS compact_vector_cursor(singleton INTEGER PRIMARY KEY CHECK(singleton=1),index_id TEXT NOT NULL,epoch INTEGER NOT NULL,id TEXT NOT NULL,complete INTEGER NOT NULL);
+        INSERT OR IGNORE INTO compact_vector_cursor VALUES(1,'',-1,'',0);
+        CREATE TABLE IF NOT EXISTS compact_gc_cursor(singleton INTEGER PRIMARY KEY CHECK(singleton=1),root INTEGER NOT NULL,graph_epoch INTEGER NOT NULL,graph_key INTEGER NOT NULL,map_epoch INTEGER NOT NULL,map_identifier INTEGER NOT NULL,blob INTEGER NOT NULL);
+        INSERT OR IGNORE INTO compact_gc_cursor VALUES(1,0,-1,0,-1,0,0);
+        CREATE VIEW IF NOT EXISTS compact_list_values AS SELECT b.id,CAST('[' || COALESCE((SELECT group_concat(token,',') FROM (SELECT i.token FROM json_each(state_compact_ids(b.payload)) j JOIN compact_identifiers i ON i.id=j.value ORDER BY CAST(j.key AS INTEGER))),'') || ']' AS BLOB) AS value FROM compact_blobs b WHERE b.kind=2;
+        DROP VIEW IF EXISTS compact_piece_values; CREATE VIEW compact_piece_values AS SELECT b.id,CASE WHEN b.kind=2 THEN (SELECT value FROM compact_list_values WHERE id=b.id) ELSE state_compact_piece(b.kind,b.payload,b.logical_bytes) END AS value FROM compact_blobs b;
+        DROP VIEW IF EXISTS state_values; CREATE VIEW state_values AS SELECT r.scope,r.key,CASE WHEN state_compact_root(r.value) IS NULL THEN CAST(r.value AS BLOB) ELSE state_compact_required((SELECT state_compact_concat(value) FROM ( SELECT p.value FROM compact_segments s JOIN compact_piece_values p ON p.id=s.blob WHERE s.root=state_compact_root(r.value) AND EXISTS( SELECT 1 FROM compact_roots t WHERE t.id=s.root AND ( ((t.scope<>'' OR t.key<>'' OR t.version<>'' OR NOT EXISTS(SELECT 1 FROM compact_root_fields f WHERE f.root=t.id)) AND t.scope=r.scope AND t.key=r.key AND t.version=r.version) OR (t.scope='' AND t.key='' AND t.version='' AND EXISTS( SELECT 1 FROM compact_root_fields f JOIN compact_root_dictionary ds ON ds.id=f.scope JOIN compact_root_dictionary dk ON dk.id=f.key JOIN compact_root_dictionary dv ON dv.id=f.version WHERE f.root=t.id AND ds.token=r.scope AND dk.token=r.key AND dv.token=r.version)) ) ) ORDER BY s.ordinal )),r.value_bytes) END AS value,r.version,r.position,r.value_bytes,r.value IS NOT NULL AS live,COALESCE(length(CAST(r.value AS BLOB)),0) AS stored_bytes FROM state_rows r;
+        CREATE VIEW IF NOT EXISTS retrieval_vector_values AS SELECT v.index_id,v.epoch,v.id,v.session_id,CASE WHEN state_compact_vector_root(v.embedding) IS NULL THEN v.embedding ELSE state_compact_required(b.payload,b.logical_bytes) END AS embedding FROM retrieval_vectors v LEFT JOIN compact_vector_refs f ON f.index_id=v.index_id AND f.epoch=v.epoch AND f.id=v.id AND f.blob=state_compact_vector_root(v.embedding) LEFT JOIN compact_blobs b ON b.id=f.blob AND b.kind=1;
+        CREATE TRIGGER IF NOT EXISTS compact_inline_insert AFTER INSERT ON state_rows WHEN NEW.value IS NOT NULL AND state_compact_root(NEW.value) IS NULL BEGIN UPDATE compact_config SET complete=0,phase='copy',last_scope='',last_key='',started=0 WHERE mode=1; END;
+        CREATE TRIGGER IF NOT EXISTS compact_inline_update AFTER UPDATE ON state_rows WHEN NEW.value IS NOT NULL AND state_compact_root(NEW.value) IS NULL BEGIN UPDATE compact_config SET complete=0,last_scope='',last_key='' WHERE mode=1; END;")?;
+    copy_progress::schema(c)?;
+    inline_control_triggers(c)?;
+    super::root_layout::schema(c)?;
+    super::text_layout::schema(c)?;
+    collector::schema(c)?;
+    super::storage_membership_repack::schema(c)?;
+    super::storage_forward_repack::schema(c)?;
+    c.execute_batch("DROP VIEW IF EXISTS compact_graph_membership; CREATE VIEW compact_graph_membership AS SELECT g.epoch,i.observation,g.key,g.position FROM compact_graph_lists g CROSS JOIN compact_forward_members m ON m.list_id=g.list CROSS JOIN compact_graph_identifiers i ON i.epoch=g.epoch AND i.identifier=m.identifier;")?;
+    Ok(())
