+use super::protocol;
+use rusqlite::{Connection, OptionalExtension, functions::FunctionFlags, params, types::ValueRef};
+use serde_json::Value;
+use std::{path::Path, sync::{Arc, atomic::{AtomicBool, AtomicUsize, Ordering}}, time::{Duration, Instant}};
+
+thread_local! {
+    static ACTIVE_PREPARATION: std::cell::RefCell<Option<PreparationBudget>> = const { std::cell::RefCell::new(None) };
+}
+
+thread_local! {
+    static DECODE_WORK: std::cell::RefCell<Option<(usize, usize, usize)>> = const { std::cell::RefCell::new(None) };
+}
+
+pub(super) struct DecodeWorkGuard;
+impl DecodeWorkGuard {
+    pub fn new(limit: usize) -> Self {
+        DECODE_WORK.with(|work| *work.borrow_mut() = Some((limit, 0, 0)));
+        Self
+    }
+    pub fn note_required(needed: usize) {
+        DECODE_WORK.with(|work| { if let Some(value) = work.borrow_mut().as_mut() { value.2 = value.2.max(needed); } });
+    }
+    pub fn active() -> bool { DECODE_WORK.with(|work| work.borrow().is_some()) }
+    pub fn remaining() -> usize {
+        DECODE_WORK.with(|work| work.borrow().as_ref().map_or(usize::MAX, |v| v.0.saturating_sub(v.1)))
+    }
+    pub fn required(&self) -> usize {
+        DECODE_WORK.with(|work| work.borrow().as_ref().map_or(0, |v| v.2))
+    }
+}
+impl Drop for DecodeWorkGuard {
+    fn drop(&mut self) { DECODE_WORK.with(|work| *work.borrow_mut() = None); }
+}
+fn admit_decode(stored: usize, logical: usize) -> anyhow::Result<()> {
+    check_preparation()?;
+    DECODE_WORK.with(|work| {
+        let mut work = work.borrow_mut();
+        if let Some((limit, used, required)) = work.as_mut() {
+            let next = used.saturating_add(stored).saturating_add(logical);
+            if next > *limit {
+                *required = next;
+                return Err(protocol::error("STATE_RETRIEVAL_RESOURCE_LIMIT"));
+            }
+            *used = next;
+        }
+        Ok(())
+    })
+}
+
+pub(super) fn row_work(c: &Connection, scope: &str, key: &str) -> anyhow::Result<usize> {
+    let sizes: Option<(i64,i64)> = c.query_row(
+        "SELECT value_bytes,length(CAST(value AS BLOB)) FROM state_rows WHERE scope=?1 AND key=?2 AND value IS NOT NULL",
+        params![scope,key], |r| Ok((r.get(0)?,r.get(1)?))).optional()?;
+    sizes.map_or(Ok(0), |(logical,stored)| {
+        let logical = usize::try_from(logical).unwrap_or(usize::MAX);
+        let stored = usize::try_from(stored).unwrap_or(usize::MAX);
+        if logical == 0 || stored == 0 || logical.max(stored) > super::codec::MAX_LOGICAL_VALUE_BYTES {
+            return Err(protocol::error("STATE_INDEX_RECORD_INVALID"));
+        }
+        Ok(logical.saturating_add(stored))
+    })
+}
+
+pub(super) fn check_preparation() -> anyhow::Result<()> {
+    ACTIVE_PREPARATION.with(|active| active.borrow().as_ref().map_or(Ok(()), PreparationBudget::check))
+}
+
+pub(super) fn recent_preparation_duration(rows: usize, bytes: usize, requested_ms: usize) -> Duration {
+    // A work-based safety deadline, not an elapsed-time slice of a successful batch.
+    let work_ms = 30_000usize.saturating_add(rows.saturating_mul(4))
+        .saturating_add((bytes / 65_536).saturating_mul(10));
+    Duration::from_millis(work_ms.max(requested_ms).min(300_000) as u64)
+}
+
+#[derive(Clone)]
+pub(super) struct PreparationBudget {
+    pub deadline: Instant,
+    cancelled: Arc<AtomicBool>,
+    stage: Arc<AtomicUsize>,
+    operation: uuid::Uuid,
+    action: String,
+}
+
+impl PreparationBudget {
+    pub fn new(action: &str, duration: Duration) -> Self {
+        Self { deadline: Instant::now() + duration, cancelled: Arc::new(AtomicBool::new(false)),
+            stage: Arc::new(AtomicUsize::new(0)), operation: uuid::Uuid::new_v4(), action: action.into() }
+    }
+    pub fn expired(&self) -> bool {
+        self.cancelled.load(Ordering::Acquire) || Instant::now() >= self.deadline
+    }
+    pub fn cancel(&self) { self.cancelled.store(true, Ordering::Release); }
+    pub fn span(&self) -> tracing::Span {
+        tracing::info_span!("state_sqlite_preparation", operation = %self.operation, action = %self.action)
+    }
+    pub fn enter(&self, stage: usize) -> anyhow::Result<()> {
+        self.stage.store(stage, Ordering::Release);
+        tracing::debug!(operation = %self.operation, action = %self.action,
+            stage = self.stage_name(), "state SQLite preparation stage");
+        self.check()
+    }
+    fn stage_name(&self) -> &'static str {
+        ["queue", "wal", "begin", "retrieval", "commit", "ack"]
+            [self.stage.load(Ordering::Acquire).min(5)]
+    }
+    pub fn check(&self) -> anyhow::Result<()> {
+        if self.expired() {
+            self.failure("deadline_or_cancellation");
+            return Err(protocol::error("STATE_RETRIEVAL_RESOURCE_LIMIT"));
+        }
+        Ok(())
+    }
+    pub fn failure(&self, failure: &str) {
+        tracing::warn!(operation = %self.operation, action = %self.action,
+            stage = self.stage_name(), failure_class = failure,
+            "state SQLite preparation failed; reconcile durable checkpoint before retry");
+    }
+    pub fn install(&self, connection: &Connection) -> anyhow::Result<()> {
+        self.check()?;
+        ACTIVE_PREPARATION.with(|active| *active.borrow_mut() = Some(self.clone()));
+        // Short busy waits cannot consume a fresh timeout at every transaction stage.
+        connection.busy_timeout(Duration::from_millis(100))?;
+        let budget = self.clone();
+        connection.progress_handler(1000, Some(move || budget.expired()))?;
+        Ok(())
+    }
+}
+
+pub(super) fn clear_preparation_budget(connection: &Connection) -> anyhow::Result<()> {
+    ACTIVE_PREPARATION.with(|active| *active.borrow_mut() = None);
+    connection.progress_handler(0, None::<fn() -> bool>)?;
+    connection.busy_timeout(Duration::from_secs(5))?;
+    Ok(())
+}
+
+pub(super) fn run_preparation<T>(
+    connection: &Connection,
+    path: &Path,
+    budget: &PreparationBudget,
+    read_only: bool,
+    job: impl FnOnce(&Connection) -> anyhow::Result<T>,
+) -> anyhow::Result<T> {
+    let span = budget.span();
+    let _entered = span.enter();
+    let result: anyhow::Result<T> = (|| {
+        budget.install(connection)?;
+        if !read_only {
+            budget.enter(1)?;
+            wal_pressure(connection,path)?;
+        }
+        budget.enter(2)?;
+        let transaction = rusqlite::Transaction::new_unchecked(connection, if read_only {
+            rusqlite::TransactionBehavior::Deferred
+        } else { rusqlite::TransactionBehavior::Immediate })?;
+        let result: anyhow::Result<T> = (|| {
+            budget.enter(3)?;
+            let value = job(&transaction)?;
+            budget.enter(4)?;
+            transaction.execute_batch("COMMIT")?;
+            Ok(value)
+        })();
+        match result {
+            Ok(value) => { drop(transaction); Ok(value) }
+            Err(error) => {
+                // Cancellation must not interrupt rollback of the bounded cut.
+                transaction.progress_handler(0, None::<fn() -> bool>)?;
+                if !transaction.is_autocommit() { transaction.rollback()?; }
+                Err(error)
+            }
+        }
+    })();
+    let restored = clear_preparation_budget(connection);
+    if restored.is_err() { budget.failure("budget_cleanup_failed"); }
+    if result.is_err() {
+        budget.failure("stage_error");
+        budget.check()?;
+    }
+    let value = result?;
+    restored?;
+    // Commit may have completed even if delivery is subsequently lost.
+    budget.enter(5)?;
+    Ok(value)
+}
