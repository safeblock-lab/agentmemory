+        INSERT OR IGNORE INTO compact_inverse_config VALUES(1,0,0,0);
+        CREATE TABLE IF NOT EXISTS compact_inverse_blocks(identifier INTEGER NOT NULL CHECK(identifier>0),edge INTEGER NOT NULL CHECK(edge>=0),payload BLOB NOT NULL,PRIMARY KEY(identifier,edge)) WITHOUT ROWID;
+        CREATE TABLE IF NOT EXISTS membership_repack_job(singleton INTEGER PRIMARY KEY CHECK(singleton=1),value TEXT NOT NULL);
+        CREATE TABLE IF NOT EXISTS membership_repack_receipts(operation_id TEXT PRIMARY KEY,digest BLOB NOT NULL,result TEXT NOT NULL) WITHOUT ROWID;")?;
+    let job=status(c)?;
+    let (writing,active):(bool,bool)=c.query_row("SELECT writing,active FROM compact_inverse_config WHERE singleton=1",[],|r|Ok((r.get(0)?,r.get(1)?)))?;
+    if job["phase"]=="absent" {
+        anyhow::ensure!(!writing && !active,"STATE_INVERSE_MANIFEST_MISMATCH");
+        c.execute_batch("CREATE INDEX IF NOT EXISTS compact_list_inverse ON compact_list_members(identifier,list_id);")?;
+    } else if job["phase"]=="aborted" {
+        anyhow::ensure!(!writing && !active && job["source_sql"].is_string() && source(c)?.as_deref()==job["source_sql"].as_str(),"STATE_INVERSE_MANIFEST_MISMATCH");
+        legacy(c)?;return Ok(());
+    } else {
+        let phase=job["phase"].as_str().unwrap_or("");
+        anyhow::ensure!(["copy","ready","cancelled","cut","retired"].contains(&phase),"STATE_INVERSE_MANIFEST_MISMATCH");
+        anyhow::ensure!(writing && active==["cut","retired"].contains(&phase),"STATE_INVERSE_MANIFEST_MISMATCH");
+        if phase=="retired" {anyhow::ensure!(source(c)?.is_none(),"STATE_INVERSE_MANIFEST_MISMATCH");}
+        else {anyhow::ensure!(job["source_sql"].is_string() && source(c)?.as_deref()==job["source_sql"].as_str(),"STATE_INVERSE_SOURCE_MISSING");}
+    }
+    for operation in ["INSERT","UPDATE"] {
+        c.execute_batch(&format!("CREATE TRIGGER IF NOT EXISTS compact_inverse_split_{operation} AFTER {operation} ON compact_inverse_blocks WHEN state_inverse_count(NEW.payload)>128 BEGIN
+            INSERT INTO compact_inverse_blocks VALUES(NEW.identifier,state_inverse_split(NEW.payload),state_inverse_slice(NEW.payload,1));
+            UPDATE compact_inverse_blocks SET payload=state_inverse_slice(NEW.payload,0) WHERE identifier=NEW.identifier AND edge=NEW.edge; END;"))?;
+    }
+    for operation in ["INSERT","UPDATE","DELETE"] {
+        c.execute_batch(&format!("CREATE TRIGGER IF NOT EXISTS compact_inverse_revision_{operation} AFTER {operation} ON compact_inverse_blocks BEGIN UPDATE compact_inverse_config SET revision=revision+1 WHERE singleton=1; END;"))?;
+    }
+    c.execute_batch("CREATE TRIGGER IF NOT EXISTS compact_inverse_empty AFTER UPDATE ON compact_inverse_blocks WHEN state_inverse_count(NEW.payload)=0 BEGIN DELETE FROM compact_inverse_blocks WHERE identifier=NEW.identifier AND edge=NEW.edge; END;
+        CREATE TRIGGER IF NOT EXISTS compact_inverse_insert AFTER INSERT ON compact_list_members WHEN (SELECT writing FROM compact_inverse_config WHERE singleton=1)=1 BEGIN
+        INSERT INTO compact_inverse_blocks(identifier,edge,payload) VALUES(NEW.identifier,coalesce((SELECT max(edge) FROM compact_inverse_blocks WHERE identifier=NEW.identifier AND edge<=NEW.list_id),0),state_inverse_edit((SELECT payload FROM compact_inverse_blocks WHERE identifier=NEW.identifier AND edge<=NEW.list_id ORDER BY edge DESC LIMIT 1),NEW.list_id,0)) ON CONFLICT(identifier,edge) DO UPDATE SET payload=excluded.payload;
+        UPDATE compact_inverse_config SET revision=revision+1 WHERE singleton=1; END;
+        CREATE TRIGGER IF NOT EXISTS compact_inverse_update AFTER UPDATE OF list_id,identifier ON compact_list_members WHEN (SELECT writing FROM compact_inverse_config WHERE singleton=1)=1 BEGIN
+        UPDATE compact_inverse_blocks SET payload=state_inverse_edit(payload,OLD.list_id,1) WHERE identifier=OLD.identifier AND edge=(SELECT max(edge) FROM compact_inverse_blocks WHERE identifier=OLD.identifier AND edge<=OLD.list_id);
+        INSERT INTO compact_inverse_blocks(identifier,edge,payload) VALUES(NEW.identifier,coalesce((SELECT max(edge) FROM compact_inverse_blocks WHERE identifier=NEW.identifier AND edge<=NEW.list_id),0),state_inverse_edit((SELECT payload FROM compact_inverse_blocks WHERE identifier=NEW.identifier AND edge<=NEW.list_id ORDER BY edge DESC LIMIT 1),NEW.list_id,0)) ON CONFLICT(identifier,edge) DO UPDATE SET payload=excluded.payload;
+        UPDATE compact_inverse_config SET revision=revision+1 WHERE singleton=1; END;
+        CREATE TRIGGER IF NOT EXISTS compact_inverse_delete AFTER DELETE ON compact_list_members WHEN (SELECT writing FROM compact_inverse_config WHERE singleton=1)=1 BEGIN
+        UPDATE compact_inverse_blocks SET payload=state_inverse_edit(payload,OLD.list_id,1) WHERE identifier=OLD.identifier AND edge=(SELECT max(edge) FROM compact_inverse_blocks WHERE identifier=OLD.identifier AND edge<=OLD.list_id);
+        UPDATE compact_inverse_config SET revision=revision+1 WHERE singleton=1; END;
+        CREATE VIEW IF NOT EXISTS compact_inverse_members AS
+        SELECT identifier,list_id FROM compact_list_members WHERE (SELECT active FROM compact_inverse_config WHERE singleton=1)=0
+        UNION ALL SELECT b.identifier,CAST(j.value AS INTEGER) FROM compact_inverse_blocks b CROSS JOIN json_each(state_inverse_ids(b.payload)) j WHERE (SELECT active FROM compact_inverse_config WHERE singleton=1)=1;
+        DROP VIEW IF EXISTS compact_graph_membership;
+        CREATE VIEW compact_graph_membership AS SELECT g.epoch,i.observation,g.key,g.position FROM compact_graph_lists g JOIN compact_list_members m ON m.list_id=g.list JOIN compact_graph_identifiers i ON i.epoch=g.epoch AND i.identifier=m.identifier;
+        CREATE VIEW IF NOT EXISTS compact_graph_inverse_membership AS
+        SELECT g.epoch,i.observation,g.key,g.position FROM compact_graph_lists g JOIN compact_list_members m ON m.list_id=g.list JOIN compact_graph_identifiers i ON i.epoch=g.epoch AND i.identifier=m.identifier WHERE (SELECT active FROM compact_inverse_config WHERE singleton=1)=0
+        UNION ALL SELECT i.epoch,i.observation,g.key,g.position FROM compact_graph_identifiers i CROSS JOIN compact_inverse_blocks b ON b.identifier=i.identifier CROSS JOIN json_each(state_inverse_ids(b.payload)) j CROSS JOIN compact_graph_lists g ON g.list=CAST(j.value AS INTEGER) AND g.epoch=i.epoch WHERE (SELECT active FROM compact_inverse_config WHERE singleton=1)=1;
+        CREATE VIEW IF NOT EXISTS retrieval_inverse_membership_values AS SELECT epoch,observation,key,position FROM retrieval_membership UNION ALL SELECT epoch,observation,key,position FROM compact_graph_inverse_membership;")?;
+    Ok(())
+}
+
+fn legacy(c: &Connection) -> anyhow::Result<()> {
+    c.flush_prepared_statement_cache();
+    for name in ["compact_inverse_split_INSERT","compact_inverse_split_UPDATE",
+        "compact_inverse_revision_INSERT","compact_inverse_revision_UPDATE","compact_inverse_revision_DELETE",
+        "compact_inverse_empty","compact_inverse_insert","compact_inverse_delete","compact_inverse_update"] {
+        c.execute_batch(&format!("DROP TRIGGER IF EXISTS {name};"))?;
+    }
+    c.execute_batch("DROP VIEW IF EXISTS retrieval_inverse_membership_values;
+        DROP VIEW IF EXISTS compact_graph_inverse_membership; DROP VIEW IF EXISTS compact_inverse_members;
+        CREATE VIEW compact_inverse_members AS SELECT identifier,list_id FROM compact_list_members;
+        CREATE VIEW compact_graph_inverse_membership AS SELECT epoch,observation,key,position FROM compact_graph_membership;
+        CREATE VIEW retrieval_inverse_membership_values AS SELECT epoch,observation,key,position FROM retrieval_membership_values;")?;
+    c.flush_prepared_statement_cache();Ok(())
+}
