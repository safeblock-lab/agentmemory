+++ b/engine/src/workers/state/adapters/sqlite/retrieval/canonical/prepare.rs
@@ -0,0 +1,46 @@
+use super::*;
+
+pub fn prepare(connection:&Connection,scope:&str,max_rows:usize,max_bytes:usize)->anyhow::Result<Value> {
+    wire::scope(scope)?;
+    protocol::require((1..=16).contains(&max_rows) && (1024..=65_536).contains(&max_bytes))?;
+    let mut state=meta(connection,scope)?;
+    postings::gc_one(connection,scope)?;
+    if let Some(processed)=postings::prepare_one(connection,scope)? {
+        let mut result=result(&meta(connection,scope)?,0,0);
+        result["posting_memberships_processed"]=json!(processed);
+        return Ok(result);
+    }
+    if ready(connection,scope,&state)? {return Ok(result(&state,0,0));}
+    let mut statement=connection.prepare("SELECT key,position,version,value_bytes,CASE typeof(value) WHEN 'blob' THEN stored_bytes WHEN 'text' THEN stored_bytes*4 ELSE 0 END FROM state_values WHERE scope=?1 AND live=1 AND position>?2 ORDER BY position LIMIT ?3")?;
+    let mut rows=statement.query(params![scope,state.cursor,(max_rows+1) as i64])?;
+    let mut processed=0; let mut bytes=0usize; let mut more=false;
+    while let Some(row)=rows.next()? {
+        if processed==max_rows {more=true;break;}
+        let key:String=row.get(0)?; let position:i64=row.get(1)?; let version:String=row.get(2)?;
+        let logical:i64=row.get(3)?;let stored:i64=row.get(4)?;
+        let ceiling=super::super::super::codec::MAX_LOGICAL_VALUE_BYTES as i64;
+        let valid_size=(1..=ceiling).contains(&logical) && (1..=ceiling).contains(&stored);
+        let size=if valid_size {logical.max(stored) as usize+key.len()} else {key.len()};
+        if processed>0 && bytes.saturating_add(size)>max_bytes {more=true;break;}
+        if valid_size {
+            match database::row(connection,scope,&key).and_then(|r|r.value.ok_or_else(conflict)).and_then(|value|index::fields(scope,&key,&value)) {
+                Ok(fields)=>index::replace(connection,scope,&key,Some(&fields),Some(position),protocol::counter(&version)?)?,
+                Err(cause) if cause.downcast_ref::<rusqlite::Error>().is_some()=>return Err(cause),
+                Err(_)=>index::invalid(connection,scope,&key)?,
+            }
+        } else {index::invalid(connection,scope,&key)?;}
+        state.cursor=position;processed+=1;bytes=bytes.saturating_add(size);
+        if postings::has_pending(connection,scope)? {more=true;break;}
+        if bytes>max_bytes {more=true;break;}
+    }
+    drop(rows);drop(statement);
+    state=Meta{cursor:state.cursor,..meta(connection,scope)?};
+    state.status=if more {"pending"} else if state.invalid>0 {"partial"} else {"ready"}.into();
+    state.revision=database::revision(connection,scope)?.to_string();
+    connection.execute("UPDATE retrieval_canonical_meta SET status=?2,cursor=?3,revision=?4 WHERE scope=?1",params![scope,state.status,state.cursor,state.revision])?;
+    Ok(result(&state,processed,bytes))
+}
+
+fn result(state:&Meta,processed:usize,bytes:usize)->Value {
+    json!({"status":state.status,"continuation":if state.status=="ready" {None}else{Some(state.cursor.to_string())},"cursor":state.cursor.to_string(),"processed":processed,"bytes":bytes,"scope_revision":state.revision,"coverage_epoch":state.epoch,"normalization_version":NORMALIZATION,"invalid_records":state.invalid})
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/canonical/receipt.rs b/engine/src/workers/state/adapters/sqlite/retrieval/canonical/receipt.rs
