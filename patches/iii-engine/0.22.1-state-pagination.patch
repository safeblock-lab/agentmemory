+pub(super) fn vector_params(
+    index: &str,
+    epoch: i64,
+    ids: &[String],
+    items: usize,
+) -> Vec<SqlValue> {
+    let mut values = Vec::with_capacity(items + 2);
+    values.extend([SqlValue::Text(index.to_owned()), SqlValue::Integer(epoch)]);
+    values.extend(ids.iter().take(items).cloned().map(SqlValue::Text));
+    values.resize(items + 2, SqlValue::Null);
+    values
+}
+pub(super) fn kinds(
+    c: &Connection,
+    index: &str,
+    options: super::super::search_projection::Options<'_>,
+) -> anyhow::Result<Vec<i64>> {
+    Ok(
+        if options.source_kind.is_some() || options.source_scope.is_some() {
+            vec![0]
+        } else if source::kind(c, index)?.is_some() {
+            vec![0, 1]
+        } else {
+            vec![2]
+        },
+    )
+}
+pub(super) fn available(
+    c: &Connection,
+    meta: &semantic::Meta,
+    options: super::super::search_projection::Options<'_>,
+) -> anyhow::Result<Availability> {
+    if ready(
+        c,
+        &meta.index_id,
+        meta.epoch,
+        options.project.unwrap(),
+        options.source_kind == Some("observation") || options.source_scope.is_some(),
+    )? {
+        return Ok(Availability {
+            usable: true,
+            partial_reason: None,
+        });
+    }
+    let Some(project) = project_token(c, options.project.unwrap())? else {
+        return Ok(Availability::unavailable());
+    };
+    let generation = generation(c, project)?;
+    let sessions_epoch: i64 = c.query_row(
+        "SELECT epoch FROM retrieval_project_catalog WHERE source='sessions'",
+        [],
+        |row| row.get(0),
+    )?;
+    let summaries_epoch: i64 = c.query_row(
+        "SELECT epoch FROM retrieval_project_catalog WHERE source='summaries'",
+        [],
+        |row| row.get(0),
+    )?;
+    let mut families = kinds(c, &meta.index_id, options)?;
+    families.sort_unstable();
+    families.dedup();
+    let mut has_current_coverage = false;
+    let mut missing_family = false;
+    let mut incomplete_coverage = false;
+    for family in families {
+        let coverage_kind = if family == 0 { 0 } else { 3 };
+        let coverage: Option<(String, i64)> = c
+            .query_row(
+                "SELECT status,source FROM retrieval_scoped_coverage WHERE index_id=?1 AND epoch=?2 AND project=?3 AND generation=?4 AND kind=?5 AND sessions_epoch=?6 AND summaries_epoch=?7 AND status IN ('pending','partial','ready')",
+                params![meta.index_id, meta.epoch, project, generation, coverage_kind, sessions_epoch, summaries_epoch],
+                |row| Ok((row.get(0)?, row.get(1)?)),
+            )
+            .optional()?;
+        if let Some((status, source)) = coverage {
+            has_current_coverage = true;
+            incomplete_coverage |= status != "ready" || source < 2;
+        } else {
+            missing_family = true;
+        }
+    }
+    if !has_current_coverage {
+        return Ok(Availability::unavailable());
+    }
+    let partial_reason = if project_catalog::has_incomplete_authority(c)? {
+        "catalog_not_ready"
+    } else if !super::super::project_vectors::ready(c, &meta.index_id, meta.epoch)? {
+        "project_mapping_not_ready"
+    } else if source::status(c, &meta.index_id)?["coverage_ready"] != true {
+        "project_source_not_ready"
+    } else if missing_family
+        || incomplete_coverage
+        || pending::has(c, &meta.index_id, project, 0)?
+        || pending::has(c, &meta.index_id, project, 3)?
+    {
+        "project_projection_pending"
+    } else {
+        "project_projection_pending"
+    };
+    Ok(Availability {
+        usable: true,
+        partial_reason: Some(partial_reason),
+    })
+}
+pub(super) struct Availability {
+    pub usable: bool,
+    pub partial_reason: Option<&'static str>,
+}
+impl Availability {
+    fn unavailable() -> Self {
+        Self {
+            usable: false,
+            partial_reason: Some("project_index_not_ready"),
+        }
+    }
+}
+pub(super) fn partial(meta: &semantic::Meta, reason: &str) -> Value {
+    json!({"items":[],"approximate":true,"candidates":0,"budget_exhausted":reason=="query_work_budget","status":"partial","reason":reason,"model":meta.model,"dimensions":meta.dimensions,"generation":meta.generation})
+}
+#[derive(Default)]
+pub(super) struct SemanticDiagnostics {
+    pub subpath: std::cell::Cell<&'static str>,
+    pub small_project_ms: std::cell::Cell<std::time::Duration>,
+    pub prepare_sql_ms: std::cell::Cell<std::time::Duration>,
+    pub candidate_read_ms: std::cell::Cell<std::time::Duration>,
+    pub window: std::cell::Cell<usize>,
+    pub page: std::cell::Cell<usize>,
+    pub visited: std::cell::Cell<usize>,
+    pub unique: std::cell::Cell<usize>,
+    pub duplicate: std::cell::Cell<usize>,
+    pub id_bytes: std::cell::Cell<usize>,
+    pub fallback_reason: std::cell::Cell<Option<&'static str>>,
+}
+
+pub(super) struct DiagnosticTimer<'a> {
+    elapsed: &'a std::cell::Cell<std::time::Duration>,
+    started: std::time::Instant,
+}
+impl SemanticDiagnostics {
+    pub fn time<'a>(&self, elapsed: &'a std::cell::Cell<std::time::Duration>) -> DiagnosticTimer<'a> {
+        DiagnosticTimer { elapsed, started: std::time::Instant::now() }
+    }
+    fn snapshot(&self) -> Value {
+        json!({
+            "subpath":self.subpath.get(),
+            "small_project_ms":self.small_project_ms.get().as_millis(),
+            "prepare_sql_ms":self.prepare_sql_ms.get().as_millis(),
+            "candidate_read_ms":self.candidate_read_ms.get().as_millis(),
+            "window":self.window.get(),"page":self.page.get(),
+            "visited":self.visited.get(),"unique":self.unique.get(),
+            "duplicate":self.duplicate.get(),"id_bytes":self.id_bytes.get(),
+            "fallback_reason":self.fallback_reason.get()
+        })
+    }
+}
+impl Drop for DiagnosticTimer<'_> {
+    fn drop(&mut self) {
+        self.elapsed.set(self.elapsed.get().saturating_add(self.started.elapsed()));
+    }
+}
+
+pub(super) fn guarded_semantic(
+    c: &Connection,
+    meta: &semantic::Meta,
+    job: impl FnOnce(&std::cell::Cell<&'static str>, &SemanticDiagnostics) -> anyhow::Result<Value>,
+) -> anyhow::Result<Value> {
+    let diagnostics = SemanticDiagnostics::default();
+    diagnostics.subpath.set("scope_resolution");
+    let mut result = guarded(c, meta, |phase| job(phase, &diagnostics))?;
+    if result["reason"] == "query_work_budget" {
+        result["candidates"] = json!(diagnostics.unique.get());
+        result["raw_visits"] = json!(diagnostics.visited.get());
+    }
+    result["query_diagnostics"] = diagnostics.snapshot();
+    Ok(result)
+}
+
+pub(super) fn guarded_keyword(
+    c: &Connection,
+    meta: &semantic::Meta,
+    hit_budget: usize,
+    job: impl FnOnce(
+        &std::cell::Cell<&'static str>,
+        &super::super::search_projection::KeywordDiagnostics,
+    ) -> anyhow::Result<Value>,
+) -> anyhow::Result<Value> {
+    let diagnostics = super::super::search_projection::KeywordDiagnostics::new(hit_budget);
+    let mut result = guarded(c, meta, |phase| job(phase, &diagnostics))?;
+    if result["reason"] == "query_work_budget" {
+        result["keyword_diagnostics"] = diagnostics.snapshot();
+    }
+    Ok(result)
+}
+
+pub(super) fn guarded(
+    c: &Connection,
+    meta: &semantic::Meta,
+    job: impl FnOnce(&std::cell::Cell<&'static str>) -> anyhow::Result<Value>,
+) -> anyhow::Result<Value> {
+    let phase = std::cell::Cell::new("candidate_selection");
+    let started = std::time::Instant::now();
+    match super::super::bounded_for(c, std::time::Duration::from_millis(250), || job(&phase)) {
+        Err(cause)
+            if cause
+                .downcast_ref::<protocol::TxError>()
+                .is_some_and(|e| e.0 == "STATE_RETRIEVAL_RESOURCE_LIMIT") =>
+        {
+            let mut result = partial(meta, "query_work_budget");
+            result["query_phase"] = json!(phase.get());
+            result["query_elapsed_ms"] = json!(started.elapsed().as_millis());
+            Ok(result)
+        }
+        result => result,
+    }
+}
+pub(super) fn rank(a: &Value, b: &Value) -> std::cmp::Ordering {
+    b["score"]
+        .as_f64()
+        .unwrap()
+        .total_cmp(&a["score"].as_f64().unwrap())
+        .then(a["obsId"].as_str().cmp(&b["obsId"].as_str()))
+}
