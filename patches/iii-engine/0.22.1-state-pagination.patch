+                ))
+                .await
+                .unwrap_err()
+        ),
+        "STATE_TX_CONFLICT"
+    );
+    adapter
+        .commit_batch(batch(
+            owner.clone(),
+            "job",
+            "delta",
+            2,
+            "2",
+            "applying",
+            vec![op("mem:graph:nodes", "a", "2", json!(2))],
+        ))
+        .await
+        .unwrap();
+    assert_eq!(
+        version(&adapter, "mem:graph:nodes", "a", Some(owner)).await["version"],
+        "3"
+    );
+}
+
+#[tokio::test]
+async fn sqlite_snapshot_postcondition_and_logical_delta_progression() {
