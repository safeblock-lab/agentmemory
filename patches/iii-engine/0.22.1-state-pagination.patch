+#[test]
+fn orphan_scope_preparation_is_bounded_and_unacknowledged_refs_resume() {
+    let connection = fresh();
+    for id in ["a", "b", "c"] {
+        write(&connection, OBS, id, Some(&observation(id, id)));
+    }
+    tracked(&connection);
+    assert_eq!(status(&connection)["source_prepared"], false);
