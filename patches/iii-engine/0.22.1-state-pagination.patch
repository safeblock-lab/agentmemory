+    }
+    let mut invalid=canonical.clone(); invalid["operations"]=Value::Array((0..257).map(|i|json!({"id":format!("op-{i}"),"ceiling":1})).collect());
+    assert!(Trusted::parse(&serde_json::to_vec(&invalid).unwrap()).is_err());
+    let mut invalid=canonical.clone(); invalid["allowedEndpoints"]=Value::Array((0..65).map(|i|json!(format!("POST https://provider.test/v1/{i}"))).collect());
+    assert!(Trusted::parse(&serde_json::to_vec(&invalid).unwrap()).is_err());
+    assert!(config::valid_id(&"x".repeat(128))); assert!(!config::valid_id(&"x".repeat(129)));
+    for target in ["POST file:///private", "POST https://user:secret@provider.test/v1/chat", "POST https://provider.test/v1/chat#fragment", "POST https://provider.test:443/v1/chat", "post https://provider.test/v1/chat"] {
+        assert!(config::endpoint(target).is_err());
+    }
+    claim(&mut connection,&trusted,&id);
+    assert!(apply(&mut connection,&trusted,Request::Consume {identity:id.clone(),attempt_id:"denied-endpoint".into(),endpoint:"POST https://unapproved.test/v1/chat".into()}).is_err());
+    let mut expired=Trusted::parse(trusted.canonical.as_bytes()).unwrap(); expired.expires=chrono::Utc::now().timestamp_millis()-1;
+    assert!(consume(&mut connection,&expired,&id,"expired").is_err());
+    assert_eq!(status(&mut connection,&trusted,&id.operation_id)["receipt"]["consumed"],0);
+    for value in [json!({"action":"provider_budget_status","operation_id":"operation-1","config_path":"attacker"}),
+        json!({"action":"provider_budget_claim","operation_id":"operation-1","window_id":"window-1","claim_id":"claim-1","expected_ceiling":2,"context":null})] {
+        assert!(serde_json::from_value::<storage::Request>(value).is_err());
