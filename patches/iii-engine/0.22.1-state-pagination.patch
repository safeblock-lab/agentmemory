+use super::super::{codec, protocol};
+use super::{request::ReflectSource, source_lexical::project_fields};
+use rusqlite::{Connection, OptionalExtension, params};
+use serde_json::{Value, json};
+use sha2::{Digest, Sha256};
+
+const MAX_SOURCE_BYTES: i64 = 65_536;
+const FIELDS: &[&str] = &["id", "project", "sessionId", "sessionIds", "sourceSessionIds",
+    "title", "narrative", "content", "fact", "confidence", "strength", "concepts", "files",
+    "tags", "sourceMemoryIds", "sourceObservationIds", "sourceIds", "lessons", "keyOutcomes",
+    "filesAffected", "sourceActionIds", "createdAt", "updatedAt", "timestamp", "type",
+    "deleted", "stale", "isLatest", "supersededBy", "forgetAfter"];
+
+pub(super) fn scope_allowed(scope: &str) -> bool {
+    ["mem:memories", "mem:semantic", "mem:lessons", "mem:crystals", "mem:summaries",
+        "mem:graph:snapshot"].contains(&scope)
+        || scope.strip_prefix("mem:obs:").is_some_and(|suffix| !suffix.is_empty())
+}
+
+pub(super) fn load(connection: &Connection, scope: &str, key: &str) -> anyhow::Result<Result<(String, Value), &'static str>> {
+    let meta: Option<(String, i64, i64)> = connection.query_row(
+        "SELECT version,value_bytes,CASE typeof(value) WHEN 'blob' THEN length(value) WHEN 'text' THEN length(value)*4 ELSE 0 END FROM state_rows WHERE scope=?1 AND key=?2 AND value IS NOT NULL",
+        params![scope,key], |r| Ok((r.get(0)?,r.get(1)?,r.get(2)?))).optional()?;
+    let Some((version, logical, stored)) = meta else { return Ok(Err("missing")); };
+    if !(1..=MAX_SOURCE_BYTES).contains(&logical) || !(1..=MAX_SOURCE_BYTES).contains(&stored) {
+        return Ok(Err("oversized"));
+    }
+    // Repeat size guards on the value read: neither SQLite nor Rust materializes an unbounded blob.
+    let encoded: Option<Vec<u8>> = connection.query_row(
+        "SELECT value FROM state_rows WHERE scope=?1 AND key=?2 AND version=?3 AND value IS NOT NULL AND value_bytes BETWEEN 1 AND ?4 AND CASE typeof(value) WHEN 'blob' THEN length(value) WHEN 'text' THEN length(value)*4 ELSE 0 END BETWEEN 1 AND ?4",
+        params![scope,key,version,MAX_SOURCE_BYTES], |r| Ok(r.get_ref(0)?.as_bytes()?.to_vec())).optional()?;
+    let Some(encoded) = encoded else { return Ok(Err("stale")); };
+    let raw = codec::decode(&encoded, logical as usize)?;
+    let value: Value = serde_json::from_str(&raw)?;
+    if !value.is_object() { return Ok(Err("audience_unknown")); }
+    Ok(Ok((version, value)))
+}
+
+pub(super) fn fresh(value: &Value) -> bool {
+    for field in ["deleted", "stale"] {
+        if value.get(field).is_some_and(|v| !v.is_null() && v != &Value::Bool(false)) { return false; }
+    }
+    if value.get("isLatest").is_some_and(|v| v != &Value::Bool(true)) { return false; }
+    if value.get("supersededBy").is_some_and(|v| !v.is_null() && v != "") { return false; }
+    if let Some(expiry) = value.get("forgetAfter").filter(|v| !v.is_null()) {
+        return expiry.as_str().and_then(|s| chrono::DateTime::parse_from_rfc3339(s).ok())
+            .is_some_and(|at| at.timestamp_millis() > chrono::Utc::now().timestamp_millis());
+    }
+    true
+}
+
+fn authority(connection: &Connection, value: &Value, project: &str) -> anyhow::Result<Result<(), &'static str>> {
+    if let Some(direct) = value.get("project").filter(|v| !v.is_null()) {
+        return Ok(match direct.as_str() {
+            Some(found) if found == project => Ok(()),
+            Some(found) if !found.is_empty() => Err("project_mismatch"),
+            _ => Err("audience_unknown"),
+        });
+    }
+    let mut ids = Vec::new();
+    if let Some(id) = value.get("sessionId") { ids.push(id); }
+    for field in ["sessionIds", "sourceSessionIds"] {
+        if let Some(references) = value.get(field) {
+            let Some(references) = references.as_array() else { return Ok(Err("audience_unknown")); };
+            if references.len() > 12 { return Ok(Err("audience_unknown")); }
+            ids.extend(references);
+        }
+    }
+    if ids.is_empty() || ids.len() > 12 { return Ok(Err("audience_unknown")); }
+    for id in ids {
+        let Some(id) = id.as_str().filter(|s| !s.is_empty() && s.len() <= 256) else { return Ok(Err("audience_unknown")); };
+        let Ok((_, session)) = load(connection, "mem:sessions", id)? else { return Ok(Err("audience_unknown")); };
+        if !fresh(&session) { return Ok(Err("audience_unknown")); }
+        match session["project"].as_str() {
+            Some(found) if found == project => {}
+            Some(found) if !found.is_empty() => return Ok(Err("project_mismatch")),
+            _ => return Ok(Err("audience_unknown")),
+        }
+    }
+    Ok(Ok(()))
+}
+
+fn projection(connection: &Connection, scope: &str, value: &Value, project: &str) -> anyhow::Result<Result<Value, &'static str>> {
+    if !fresh(value) { return Ok(Err("stale")); }
+    if scope == "mem:graph:snapshot" {
+        if value.get("project").is_some_and(|v| !v.is_null() && v.as_str() != Some(project)) {
+            return Ok(Err("project_mismatch"));
+        }
+        let Some(nodes) = value["topNodes"].as_array() else { return Ok(Err("audience_unknown")); };
+        let mut selected = Vec::new();
+        for node in nodes {
+            if selected.len() == 12 { break; }
+            if !fresh(node) || node["type"] != "concept" { continue; }
+            if authority(connection, &node["properties"], project)?.is_err() { continue; }
+            let mut projected = project_fields(node, &["id", "name", "type", "stale"]);
+            projected["properties"] = project_fields(&node["properties"], &["project", "concepts"]);
+            selected.push(projected);
+        }
+        if selected.is_empty() { return Ok(Err("audience_unknown")); }
+        return Ok(Ok(json!({"project":project,"topNodes":selected,"dirty":value["dirty"],"batchInProgress":value["batchInProgress"]})));
+    }
+    if let Err(reason) = authority(connection, value, project)? { return Ok(Err(reason)); }
+    let mut projected = project_fields(value, FIELDS);
+    projected["project"] = json!(project);
+    Ok(Ok(projected))
+}
+
+pub(super) fn execute(connection: &Connection, project: &str, sources: &[ReflectSource], max_bytes: usize) -> anyhow::Result<Value> {
+    let mut result = json!({"items":[],"deferred":[]});
+    for source in sources {
+        let loaded = load(connection, &source.scope, &source.key)?;
+        let item = match loaded {
+            Err(reason) => Err(reason),
+            Ok((version, value)) => {
+                if source.expected_version.as_ref().is_some_and(|expected| expected != &version) { Err("stale") }
+                else { projection(connection, &source.scope, &value, project)?.map(|value| {
+                    let fingerprint = format!("{:x}", Sha256::digest(serde_json::to_vec(&json!({"version":version,"value":value})).expect("JSON value serialization")));
+                    json!({"scope":source.scope,"key":source.key,"version":version,"fingerprint":fingerprint,"value":value})
+                }) }
+            }
+        };
+        let reason = match item {
+            Ok(item) => {
+                result["items"].as_array_mut().unwrap().push(item);
+                if protocol::size(&result)? <= max_bytes { continue; }
+                result["items"].as_array_mut().unwrap().pop();
+                "oversized"
+            }
+            Err(reason) => reason,
+        };
+        result["deferred"].as_array_mut().unwrap().push(json!({"scope":source.scope,"key":source.key,"reason":reason}));
+    }
+    if protocol::size(&result)? > max_bytes { return Err(super::request::resource()); }
+    Ok(result)
+}
