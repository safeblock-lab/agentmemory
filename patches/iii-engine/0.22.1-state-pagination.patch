@@ -0,0 +1,155 @@
+use super::*;
+fn budget(processed: usize, needed: usize) -> anyhow::Result<RowResult> {
+    if processed == 0 && database::DecodeWorkGuard::active() {
+        database::DecodeWorkGuard::note_required(needed);
+        return Err(super::super::request::resource());
+    }
+    Ok(RowResult::Budget)
+}
+
+pub enum RowResult {
+    Done(usize),
+    Budget,
+    Blocked,
+}
+fn restore(
+    c: &Connection,
+    meta: &semantic::Meta,
+    scope: &str,
+    id: &str,
+    version: &str,
+) -> anyhow::Result<bool> {
+    let Some(embedding) = database::row(c, &meta.scope(), id)?.value else {
+        tracing::warn!(failure_class="canonical_embedding_missing", "state SQLite project preparation source unavailable");
+        return Ok(false);
+    };
+    if embedding["sourceScope"].as_str() != Some(scope)
+        || embedding["sourceVersion"].as_str() != Some(version)
+    {
+        tracing::warn!(failure_class="canonical_embedding_binding_mismatch", "state SQLite project preparation source unavailable");
+        return Ok(false);
+    }
+    // replace validates the current authoritative row before acknowledging its version.
+    // A malformed legacy embedding must not leave that acknowledgement or partial indexes.
+    c.execute_batch("SAVEPOINT scoped_embedding_restore")?;
+    match semantic::replace(c, meta, id, Some(&embedding)) {
+        Ok(()) => {
+            c.execute_batch("RELEASE scoped_embedding_restore")?;
+            Ok(true)
+        }
+        Err(error) => {
+            c.execute_batch(
+                "ROLLBACK TO scoped_embedding_restore; RELEASE scoped_embedding_restore",
+            )?;
+            if error.downcast_ref::<protocol::TxError>().is_some_and(|e| {
+                matches!(
+                    e.0,
+                    "STATE_TX_INVALID_REQUEST"
+                        | "STATE_SEMANTIC_IDENTITY_MISMATCH"
+                        | "STATE_SEMANTIC_SOURCE_STALE"
+                        | "STATE_SEMANTIC_SOURCE_ID_CONFLICT"
+                )
+            }) {
+                tracing::warn!(failure_class="canonical_embedding_invalid_or_stale", "state SQLite project preparation source unavailable");
+                Ok(false)
+            } else {
+                Err(error)
+            }
+        }
+    }
+}
+pub fn project_row(
+    c: &Connection,
+    meta: &semantic::Meta,
+    session: &str,
+    id: &str,
+    version: &str,
+    logical: i64,
+    observation: bool,
+    processed: usize,
+    bytes: usize,
+    max_bytes: usize,
+) -> anyhow::Result<RowResult> {
+    let mut source_bytes = if observation {
+        database::trace_preparation("scoped_row_source_work", || database::row_work(c, &format!("mem:obs:{session}"), id))?
+    } else { usize::try_from(logical).unwrap_or(usize::MAX) };
+    if bytes.saturating_add(source_bytes) > max_bytes {
+        return budget(processed, bytes.saturating_add(source_bytes));
+    }
+    let mut restored = false;
+    if observation {
+        let scope = format!("mem:obs:{session}");
+        let item:Option<(String,bool)>=database::trace_preparation("scoped_row_source_item", || c.query_row("SELECT version,dirty FROM retrieval_source_items WHERE index_id=?1 AND scope=?2 AND key=?3",params![meta.index_id,scope,id],|r|Ok((r.get(0)?,r.get(1)?))).optional().map_err(Into::into))?;
+        let clean = item.is_some_and(|(saved, dirty)| saved == version && !dirty);
+        let present:bool=database::trace_preparation("scoped_row_vector_exists", || Ok(c.query_row("SELECT EXISTS(SELECT 1 FROM retrieval_vectors WHERE index_id=?1 AND epoch=?2 AND id=?3)",params![meta.index_id,meta.epoch,id],|r|r.get(0))?))?;
+        if !clean || !present {
+            if processed > 0 {
+                return budget(processed, bytes.saturating_add(source_bytes));
+            }
+            if !clean {
+                let eligible = {
+                    let source = database::trace_preparation("scoped_row_source_decode", || database::row(c, &scope, id))?;
+                    if source.version.to_string() != version {
+                        tracing::warn!(failure_class="source_version_changed", "state SQLite project preparation source unavailable");
+                        return Ok(RowResult::Blocked);
+                    }
+                    database::trace_preparation("scoped_row_eligibility", || Ok(super::super::eligibility::value(&scope, source.value.as_ref())))?
+                };
+                if !eligible {
+                    database::trace_preparation("scoped_row_exclude", || source::remove(c, &meta.index_id, &scope, id))?;
+                    return Ok(RowResult::Done(source_bytes));
+                }
+            }
+            // Restore validates and extracts source text again, then projects lexical text.
+            let embedding_bytes = database::trace_preparation("scoped_row_embedding_work", || database::row_work(c, &meta.scope(), id))?;
+            let restore_bytes = source_bytes.saturating_mul(3).saturating_add(embedding_bytes);
+            if bytes.saturating_add(restore_bytes) > max_bytes || restore_bytes > database::DecodeWorkGuard::remaining() { return budget(processed, bytes.saturating_add(restore_bytes)); }
+            restored = database::trace_preparation("scoped_row_restore", || restore(c, meta, &scope, id, version))?;
+            if !restored {
+                return Ok(RowResult::Blocked);
+            }
+            source_bytes = restore_bytes;
+        }
+    }
+    let remaining = max_bytes.saturating_sub(bytes.saturating_add(source_bytes));
+    let Some((member, authority_bytes)) = database::trace_preparation("scoped_row_membership", || membership::get_bounded(c, session, remaining))? else {
+        return budget(processed, bytes.saturating_add(source_bytes));
+    };
+    let used = bytes
+        .saturating_add(source_bytes)
+        .saturating_add(authority_bytes);
+    let current:bool=database::trace_preparation("scoped_row_current", || Ok(c.query_row("SELECT EXISTS(SELECT 1 FROM retrieval_scoped_vectors WHERE index_id=?1 AND epoch=?2 AND id=?3 AND project IS ?4 AND project_generation=1 AND session=?5 AND generation=?6 AND (?7=0 OR document IS NOT NULL))",params![meta.index_id,meta.epoch,id,member.project,member.token,member.generation,observation && member.project.is_some()],|r|r.get(0))?))?;
+    if current && !restored {
+        return Ok(RowResult::Done(source_bytes.saturating_add(authority_bytes)));
+    }
+    let needed: Option<i64> = database::trace_preparation("scoped_row_lexical_work", || c.query_row(
+        "SELECT length(CAST(f.text AS BLOB)) FROM retrieval_lexical_links l JOIN retrieval_lexical f ON f.rowid=l.rowid WHERE l.index_id=?1 AND l.epoch=?2 AND l.id=?3",
+        params![meta.index_id, meta.epoch, id],
+        |row| row.get(0),
+    ).optional().map_err(Into::into))?;
+    let needed = needed.unwrap_or(0).try_into().unwrap_or(usize::MAX);
+    if used.saturating_add(needed) > max_bytes {
+        return budget(processed, used.saturating_add(needed));
+    }
+    let body = database::trace_preparation("scoped_row_lexical_text", || text(c, &meta.index_id, meta.epoch, id))?;
+    if observation && body.is_none() {
+        tracing::warn!(failure_class="lexical_source_missing", "state SQLite project preparation source unavailable");
+        return Ok(RowResult::Blocked);
+    }
+    if !restored {
+        database::trace_preparation("scoped_row_replace", || super::write::replace_with_member(
+            c,
+            &meta.index_id,
+            meta.epoch,
+            id,
+            session,
+            &member,
+            body.as_deref(),
+        ))?;
+    }
+    Ok(RowResult::Done(
+        source_bytes
+            .saturating_add(authority_bytes)
+            .saturating_add(needed),
+    ))
+}
