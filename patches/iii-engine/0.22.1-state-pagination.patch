+pub fn schema(c: &Connection) -> anyhow::Result<()> {
+    if super::storage_forward_repack::retired(c)? {
+        require(status(c)?["phase"]=="retired")?;
+        require(c.query_row("SELECT active=1 AND writing=1 FROM compact_inverse_config WHERE singleton=1",[],|r|r.get::<_,bool>(0))?)?;
+        return Ok(());
+    }
