+fn canonical_scoped_global_prepare_keeps_old_alias_and_bounded_epoch_gc() {
+    let c = fresh();
+    configure(&c);
+    session(&c, "session", "p");
+    upsert(
+        &c,
+        (0..20)
+            .map(|n| vector_item(&format!("a{n}"), &[1., 0., 0., 0.], Some("needle")))
+            .collect(),
+    )
+    .unwrap();
+    c.execute("DELETE FROM retrieval_scoped_postings", [])
+        .unwrap();
+    c.execute("DELETE FROM retrieval_scoped_lexical", [])
+        .unwrap();
+    c.execute("DELETE FROM retrieval_scoped_vectors", [])
+        .unwrap();
+    c.execute(
+        "UPDATE retrieval_scoped_meta SET status='pending',cursor=''",
+        [],
+    )
+    .unwrap();
+    for n in 0..20 {
+        let result=call(&c,json!({"action":if n%2==0{"project_vectors_prepare"}else{"project_vector_prepare"},"index_id":"observations","max_rows":3})).unwrap();
+        assert!(result["processed"].as_u64().unwrap() <= 3);
+        if result["status"] == "ready" {
+            break;
+        }
+        assert!(n < 19);
+    }
+    let mut q = semantic_request("keyword_search");
+    q["project"] = json!("p");
+    q["query"] = json!("needle");
+    assert!(!returned_ids(&call(&c, q).unwrap()).is_empty());
+    let meta = semantic::get(&c, "observations").unwrap();
+    semantic::rebuild(&c, &meta, &meta.revision).unwrap();
+    let epoch = meta.epoch + 1;
+    let before: i64 = c
+        .query_row(
+            "SELECT count(*) FROM retrieval_scoped_vectors WHERE epoch<?1",
+            [epoch],
+            |r| r.get(0),
+        )
+        .unwrap();
+    assert_eq!(before, 20);
+    let removed = scoped::background::gc(&c, "observations", epoch, 3).unwrap();
+    assert_eq!(removed, 3);
+    let left: i64 = c
+        .query_row(
+            "SELECT count(*) FROM retrieval_scoped_vectors WHERE epoch<?1",
+            [epoch],
+            |r| r.get(0),
+        )
+        .unwrap();
+    assert_eq!(left, 17);
+}
