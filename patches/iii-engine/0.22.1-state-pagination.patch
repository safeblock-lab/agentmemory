+fn global_preparation_status(c: &Connection, index: &str) -> anyhow::Result<Value> {
+    let meta=semantic::get(c,index)?;
+    let vector:Option<(i64,String,String,String)>=c.query_row(
+        "SELECT epoch,status,cursor,revision FROM retrieval_project_vector_meta WHERE index_id=?1",
+        [index],|r|Ok((r.get(0)?,r.get(1)?,r.get(2)?,r.get(3)?))).optional()?;
+    let scoped:Option<(i64,String,String,i64)>=c.query_row(
+        "SELECT epoch,status,cursor,unknown FROM retrieval_scoped_meta WHERE index_id=?1",
+        [index],|r|Ok((r.get(0)?,r.get(1)?,r.get(2)?,r.get(3)?))).optional()?;
+    let source=source::status(c,index)?;
+    let revision=database::revision(c,&meta.scope())?.to_string();
+    let ready=project_vectors::ready(c,index,meta.epoch)?
+        && scoped.as_ref().is_some_and(|(epoch,status,_,unknown)|*epoch==meta.epoch && status=="ready" && *unknown==0)
+        && source["coverage_ready"]==true;
+    let checkpoint=hex::encode(serde_json::to_vec(&(&vector,&scoped,meta.epoch,&revision,&source))?);
+    Ok(json!({"target":"project_vector","index_id":index,"project":null,"source_kind":null,
+        "status":if ready{"ready"}else{"pending"},"ready":ready,"has_more":!ready,
+        "checkpoint":checkpoint,"coverage_epoch":meta.epoch.to_string(),"revision":revision,
+        "vector":vector,"scoped":scoped,"source":source}))
+}
+
+fn metadata_status(connection:&Connection,index:&str)->anyhow::Result<Value> {
+    let meta=semantic::get(connection,index)?;let mut value=meta.status_value();
+    if meta.revision!=database::revision(connection,&meta.scope())?.to_string() {value["status"]=json!("pending");value["lexical_ready"]=json!(false);}
+    value["source_kind"]=json!(source::kind(connection,index)?);
+    Ok(json!({"version":1,"metadata_only":true,"index_id":index,"capabilities":CAPABILITIES,"semantic":[value]}))
+}
+fn status(connection: &Connection) -> anyhow::Result<Value> {
+    let mut graph_status = Vec::new();
+    for scope in [graph::NODES, graph::EDGES] {
+        let meta = metadata::graph(connection, scope)?;
+        let status = if meta.revision == database::revision(connection, scope)?.to_string() {
+            meta.status.as_str()
+        } else {
+            "pending"
+        };
+        let invalid: i64 = connection.query_row(
+            "SELECT count(*) FROM retrieval_graph_invalid WHERE scope=?1 AND epoch=?2",
+            params![scope, meta.epoch],
+            |r| r.get(0),
+        )?;
+        graph_status.push(json!({"scope":scope,"status":status,"cursor":meta.cursor.to_string(),"revision":meta.revision,"invalid_records":invalid}));
+    }
+    let mut statement =
+        connection.prepare("SELECT index_id FROM retrieval_semantic_meta ORDER BY index_id")?;
+    let ids = statement
+        .query_map([], |r| r.get::<_, String>(0))?
+        .collect::<rusqlite::Result<Vec<_>>>()?;
+    let mut semantic_status = Vec::with_capacity(ids.len());
+    for id in ids {
+        let meta = semantic::get(connection, &id)?;
+        let mut value = meta.status_value();
+        if meta.revision != database::revision(connection, &meta.scope())?.to_string() {
+            value["status"] = json!("pending");
+            value["lexical_ready"] = json!(false);
+        }
+        semantic_status.push(source::decorate(connection, &id, value)?);
+    }
+    Ok(
+        json!({"version":1,"capabilities":CAPABILITIES,"graph":graph_status,"semantic":semantic_status,"project_catalog":project_catalog::status(connection)?,"project_vectors":project_vectors::status(connection)?}),
+    )
+}
