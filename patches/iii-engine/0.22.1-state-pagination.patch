+use super::*;
+use rusqlite::params;
+
+fn assert_error(error: anyhow::Error, expected: &str) {
+    let message = format!("{error:#}");
+    assert!(
+        message.contains(expected),
+        "expected {expected:?}; got {message}"
+    );
+}
+
+fn fixture(rows: i64) -> (tempfile::TempDir, MigrationArgs) {
+    let directory =
+        tempfile::tempdir_in(std::env::var_os("III_SQLITE_TEST_ROOT").unwrap()).unwrap();
+    let args = MigrationArgs {
+        source: directory.path().join("simple-v1.sqlite3"),
+        target: directory.path().join("simple-v2.sqlite3"),
+        disk_budget_bytes: 256 * 1024 * 1024,
+        reverse: false,
+    };
+    let mut con = Connection::open(&args.source).unwrap();
+    con.execute_batch("CREATE TABLE state_scopes(scope TEXT PRIMARY KEY,revision TEXT NOT NULL,next_position INTEGER NOT NULL) WITHOUT ROWID;
+CREATE TABLE state_rows(scope TEXT NOT NULL,key TEXT NOT NULL,value TEXT,version TEXT NOT NULL,position INTEGER,value_bytes INTEGER NOT NULL,PRIMARY KEY(scope,key)) WITHOUT ROWID;
+CREATE INDEX state_rows_order ON state_rows(scope,position) WHERE value IS NOT NULL;
+CREATE TABLE retrieval_name_grams(epoch INTEGER NOT NULL,gram TEXT NOT NULL,key TEXT NOT NULL,position INTEGER NOT NULL,PRIMARY KEY(epoch,gram,key)) WITHOUT ROWID;
+CREATE INDEX retrieval_name_grams_key ON retrieval_name_grams(epoch,key);
+INSERT INTO state_scopes VALUES('scope','7',3);
+INSERT INTO state_rows VALUES('scope','live',' {\"a\":1} ','4',-3,9);
+INSERT INTO state_rows VALUES('scope','tombstone',NULL,'5',NULL,0);").unwrap();
+    let txn = con.transaction().unwrap();
+    for index in 0..rows {
+        txn.execute(
+            "INSERT INTO retrieval_name_grams VALUES(?1,?2,?3,?4)",
+            params![
+                index % 3,
+                format!("ñ😀-{index:06}"),
+                format!("node-{}", index % 17),
+                -index
+            ],
+        )
+        .unwrap();
+    }
+    txn.commit().unwrap();
+    con.pragma_update(None, "application_id", database::APPLICATION_ID)
+        .unwrap();
+    con.pragma_update(None, "user_version", 1).unwrap();
+    drop(con);
+    (directory, args)
+}
+
+#[test]
+fn sqlite_simple_resumes_multi_chunk_and_restores_indexes_and_reverse() {
+    let (directory, args) = fixture(65540);
+    let digest = archive::file_digest(&args.source).unwrap();
+    assert_error(
+        run_segment(&args, Some(32769), None).unwrap_err(),
+        "interruption",
+    );
+    {
+        let pending = Connection::open(&args.target).unwrap();
+        let count: i64 = pending
+            .query_row(
+                "SELECT count FROM shadow_transfer_progress WHERE name='retrieval_name_grams'",
+                [],
+                |r| r.get(0),
+            )
+            .unwrap();
+        assert_eq!(count, 32769);
+        assert_eq!(
+            pending
+                .query_row("SELECT count(*) FROM retrieval_name_grams", [], |r| r
+                    .get::<_, i64>(0))
+                .unwrap(),
+            count
+        );
+        assert_eq!(pending.query_row("SELECT count(*) FROM sqlite_master WHERE name IN ('retrieval_name_grams_key','state_rows_order')",[],|r|r.get::<_,i64>(0)).unwrap(),0);
+        pending.execute_batch("BEGIN; CREATE INDEX retrieval_name_grams_key ON retrieval_name_grams(epoch,key); ROLLBACK;").unwrap();
