+        let explicit: StateListPageInput = serde_json::from_value(json!({
+            "scope": "s", "limit": 1, "max_bytes": 1024
+        }))
+        .unwrap();
+        assert_eq!(explicit.limit, 1);
+        assert_eq!(explicit.max_bytes, 1024);
+    }
 
