diff --git a/engine/src/workers/state/adapters/sqlite/text-layout.rs b/engine/src/workers/state/adapters/sqlite/text-layout.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/text-layout.rs
@@ -0,0 +1,218 @@
+use rusqlite::{params, Connection, OptionalExtension, functions::FunctionFlags};
+use serde::{Deserialize, Serialize};
+use serde_json::{json, Value};
+use std::time::Instant;
+use super::{database, protocol::Guard, storage_repack};
+
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(rename_all="snake_case")]
+pub enum Step { Begin, Copy, Verify, Cut, Rollback, Retire, Collect }
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Request {
+    pub operation_id:String, pub job_id:String, pub expected_ordinal:u64, pub step:Step,
+    pub limit:usize, pub max_bytes:usize, pub max_ms:u64, pub owner_id:String, pub fence:u64,
+    pub guard:Guard, pub admission_id:String,
+}
+#[derive(Default, Serialize, Deserialize)]
+struct Job { id:String, phase:String, ordinal:u64, cutoff:i64, cursor:i64, admission:String,
+    #[serde(default)] gc_stage:u8, #[serde(default)] gc_cursor:i64, #[serde(default)] gc_complete:bool }
+pub fn register(c:&Connection)->anyhow::Result<()> {
+    let flags=FunctionFlags::SQLITE_UTF8|FunctionFlags::SQLITE_DETERMINISTIC|FunctionFlags::SQLITE_INNOCUOUS;
+    c.create_scalar_function("state_text_slice",4,flags,|ctx| {
+        let run=||->anyhow::Result<Vec<u8>> {
+            let payload=ctx.get::<Vec<u8>>(0)?;
+            let logical=usize::try_from(ctx.get::<i64>(1)?)?;
+            let offset=usize::try_from(ctx.get::<i64>(2)?)?;
+            let length=usize::try_from(ctx.get::<i64>(3)?)?;
+            anyhow::ensure!(logical<=512*1024,"STATE_COMPACT_CORRUPT");
+            let text=super::codec::decode(&payload,logical)?;
+            let end=offset.checked_add(length).ok_or_else(||anyhow::anyhow!("STATE_COMPACT_CORRUPT"))?;
+            Ok(text.as_bytes().get(offset..end).ok_or_else(||anyhow::anyhow!("STATE_COMPACT_CORRUPT"))?.to_vec())
+        };
+        run().map_err(|e|rusqlite::Error::UserFunctionError(e.into()))
+    })?;
+    c.create_scalar_function("state_text_encode",1,flags,|ctx| {
+        let bytes=ctx.get::<Vec<u8>>(0)?;
+        let run=||->anyhow::Result<Vec<u8>> {Ok(super::codec::encode(std::str::from_utf8(&bytes)?)?)};
+        run().map_err(|e|rusqlite::Error::UserFunctionError(e.into()))
+    })?;
+    Ok(())
+}
+pub fn schema(c:&Connection)->anyhow::Result<()> {c.execute_batch(include_str!("text-layout.sql"))?;Ok(())}
+fn load(c:&Connection)->anyhow::Result<Job> {
+    let raw:Option<String>=c.query_row("SELECT value FROM compact_text_job WHERE singleton=1",[],|r|r.get(0)).optional()?;
+    Ok(raw.map(|s|serde_json::from_str(&s)).transpose()?.unwrap_or_default())
+}
+pub fn status(c:&Connection)->anyhow::Result<Value> {Ok(serde_json::to_value(load(c)?)?)}
+pub fn receipt(c:&Connection,r:&Request)->anyhow::Result<Value> {
+    let saved:Option<(String,String)>=c.query_row("SELECT request,result FROM compact_text_receipts WHERE operation_id=?1",[&r.operation_id],|v|Ok((v.get(0)?,v.get(1)?))).optional()?;
+    if let Some((request,result))=saved {
+        anyhow::ensure!(request==serde_json::to_string(r)?,"STATE_TX_REPLAY_CONFLICT");
+        return Ok(json!({"status":"applied","result":serde_json::from_str::<Value>(&result)?}));
+    }
+    Ok(json!({"status":"not_found"}))
+}
+pub fn execute(c:&Connection,r:Request)->anyhow::Result<Value> {
+    anyhow::ensure!(!c.is_autocommit() && (1..=100000).contains(&r.limit) && (16384..=4*1024*1024).contains(&r.max_bytes)
+        && (1..=2500).contains(&r.max_ms) && !r.admission_id.is_empty() && r.admission_id.len()<=128
+        && !r.operation_id.is_empty() && r.operation_id.len()<=128 && !r.job_id.is_empty() && r.job_id.len()<=96,"STATE_TX_INVALID_REQUEST");
+    let lease=storage_repack::Request {operation_id:r.operation_id.clone(),job_id:r.job_id.clone(),expected_ordinal:r.expected_ordinal,
+        step:if matches!(r.step,Step::Cut|Step::Retire|Step::Rollback){storage_repack::Step::Cut}else{storage_repack::Step::Copy},
+        max_ms:r.max_ms,max_bytes:r.max_bytes,limit:r.limit,owner_id:r.owner_id.clone(),fence:r.fence,guard:r.guard.clone()};
+    storage_repack::leases(c,&lease)?;
+    let saved=receipt(c,&r)?;if saved["status"]=="applied" {return Ok(saved["result"].clone());}
+    let mut job=load(c)?;
+    anyhow::ensure!(job.ordinal==r.expected_ordinal,"STATE_TX_CONFLICT");
+    if matches!(r.step,Step::Begin) {
+        anyhow::ensure!(job.phase.is_empty() || (["retired","rollback"].contains(&job.phase.as_str()) && job.gc_complete && job.id!=r.job_id),"STATE_TX_CONFLICT");
+        let closed:bool=c.query_row("SELECT EXISTS(SELECT 1 FROM compact_text_closed_jobs WHERE job=?1)",[&r.job_id],|v|v.get(0))?;
+        anyhow::ensure!(!closed,"STATE_TX_REPLAY_CONFLICT");
+        if !job.id.is_empty() {c.execute("INSERT OR IGNORE INTO compact_text_closed_jobs VALUES(?1)",[&job.id])?;}
+        job.cursor=0;job.gc_complete=false;job.gc_stage=0;job.gc_cursor=0;
+        job.id=r.job_id.clone();job.phase="copy".into();job.admission=r.admission_id.clone();
+        job.cutoff=c.query_row("SELECT coalesce(max(id),0) FROM compact_blobs",[],|v|v.get(0))?;
+    } else {
+        anyhow::ensure!(job.id==r.job_id && job.admission==r.admission_id,"STATE_TX_CONFLICT");
+        match r.step {
+            Step::Copy=>copy(c,&r,&mut job)?, Step::Verify=>verify(c,&r,&mut job)?,
+            Step::Cut=>change(c,&r,&mut job,false)?, Step::Rollback=>change(c,&r,&mut job,true)?,
+            Step::Retire=>retire(c,&r,&mut job)?, Step::Collect=>collect(c,&r,&mut job)?, Step::Begin=>unreachable!(),
+        }
+    }
+    job.ordinal=job.ordinal.checked_add(1).ok_or_else(||anyhow::anyhow!("STATE_TX_LIMIT_EXCEEDED"))?;
+    let result=json!({"job":job,"physical_reclaimed_bytes":null});
+    c.execute("INSERT INTO compact_text_job VALUES(1,?1) ON CONFLICT(singleton) DO UPDATE SET value=excluded.value",[serde_json::to_string(&job)?])?;
+    c.execute("INSERT INTO compact_text_receipts VALUES(?1,?2,?3)",params![r.operation_id,serde_json::to_string(&r)?,serde_json::to_string(&result)?])?;
+    Ok(result)
+}
+fn copy(c:&Connection,r:&Request,j:&mut Job)->anyhow::Result<()> {
+    anyhow::ensure!(j.phase=="copy","STATE_TX_CONFLICT");
+    let rows=c.prepare_cached("SELECT id,logical_bytes,length(payload) FROM compact_blobs INDEXED BY compact_text_ingress_id WHERE kind=0 AND length(payload)>0 AND id>?1 AND id<=?2 ORDER BY id LIMIT ?3")?
+        .query_map(params![j.cursor,j.cutoff,r.limit as i64],|v|Ok((v.get::<_,i64>(0)?,v.get::<_,i64>(1)?,v.get::<_,i64>(2)?)))?.collect::<rusqlite::Result<Vec<_>>>()?;
+    let start=Instant::now();let mut joined=String::new();let mut entries=Vec::new();let mut old_bytes=0usize;let mut batch_bytes=0usize;
+    for (id,logical,stored) in &rows {
+        database::check_preparation()?;
+        if start.elapsed().as_millis()>=u128::from(r.max_ms) {break;}
+        let logical=usize::try_from(*logical)?;let stored=usize::try_from(*stored)?;
+        if logical>512*1024 || stored>512*1024 {j.cursor=*id;continue;}
+        if batch_bytes+logical+stored>r.max_bytes {break;}
+        if joined.len()+logical>512*1024 {store_block(c,&joined,&entries,old_bytes,&j.id)?;joined.clear();entries.clear();old_bytes=0;}
+        let bytes:Vec<u8>=c.query_row("SELECT payload FROM compact_blobs WHERE id=?1",[id],|v|v.get(0))?;
+        let text=super::codec::decode(&bytes,logical)?;
+        anyhow::ensure!(super::codec::encode(&text)?==bytes,"STATE_TEXT_CODEC_NONCANONICAL");
+        entries.push((*id,joined.len(),logical));joined.push_str(&text);old_bytes+=stored;j.cursor=*id;batch_bytes+=logical+stored;
+    }
+    store_block(c,&joined,&entries,old_bytes,&j.id)?;
+    let more:bool=c.query_row("SELECT EXISTS(SELECT 1 FROM compact_blobs INDEXED BY compact_text_ingress_id WHERE kind=0 AND length(payload)>0 AND id>?1 AND id<=?2)",params![j.cursor,j.cutoff],|v|v.get(0))?;
+    if !more {j.phase="verify".into();j.cursor=0;}
+    Ok(())
+}
+fn store_block(c:&Connection,joined:&str,entries:&[(i64,usize,usize)],old_bytes:usize,job:&str)->anyhow::Result<()> {
+    if !entries.is_empty() {
+        let bytes=super::codec::encode(&joined)?;
+        anyhow::ensure!(super::codec::decode(&bytes,joined.len())?==joined,"STATE_COMPACT_CORRUPT");
+        if bytes.len()+entries.len()*48+64<old_bytes {
+            c.execute("INSERT INTO compact_text_blocks(logical_bytes,payload,job) VALUES(?1,?2,?3)",params![joined.len() as i64,bytes,job])?;
+            let block=c.last_insert_rowid();
+            for (id,offset,length) in entries {c.execute("INSERT INTO compact_text_locators VALUES(?1,?2,?3,?4) ON CONFLICT(blob) DO UPDATE SET block=excluded.block,offset=excluded.offset,logical_bytes=excluded.logical_bytes",params![id,block,*offset as i64,*length as i64])?;}
+        }
+    }
+    Ok(())
+}
+fn verify(c:&Connection,r:&Request,j:&mut Job)->anyhow::Result<()> {
+    anyhow::ensure!(j.phase=="verify","STATE_TX_CONFLICT");
+    let rows=c.prepare_cached("SELECT id,logical_bytes,length(payload) FROM compact_text_blocks WHERE id>?1 AND job=?3 ORDER BY id LIMIT ?2")?
+        .query_map(params![j.cursor,r.limit as i64,j.id],|v|Ok((v.get::<_,i64>(0)?,v.get::<_,i64>(1)?,v.get::<_,i64>(2)?)))?.collect::<rusqlite::Result<Vec<_>>>()?;
+    let start=Instant::now();let mut processed=0;let mut bytes=0usize;
+    for (id,logical,stored) in &rows {
+        database::check_preparation()?;if start.elapsed().as_millis()>=u128::from(r.max_ms){break;}
+        let cost=usize::try_from(*logical)?.checked_add(usize::try_from(*stored)?).ok_or_else(||anyhow::anyhow!("STATE_TX_LIMIT_EXCEEDED"))?;
+        if bytes+cost>r.max_bytes {break;}
+        let payload:Vec<u8>=c.query_row("SELECT payload FROM compact_text_blocks WHERE id=?1",[id],|v|v.get(0))?;
+        let text=super::codec::decode(&payload,usize::try_from(*logical)?)?;
+        let mut statement=c.prepare_cached("SELECT l.offset,l.logical_bytes,b.payload FROM compact_text_locators l JOIN compact_blobs b ON b.id=l.blob WHERE l.block=?1 ORDER BY l.blob")?;
+        let mut pieces=statement.query([id])?;
+        while let Some(piece)=pieces.next()? {
+            let offset=usize::try_from(piece.get::<_,i64>(0)?)?;let length=usize::try_from(piece.get::<_,i64>(1)?)?;
+            let end=offset.checked_add(length).ok_or_else(||anyhow::anyhow!("STATE_COMPACT_CORRUPT"))?;
+            let slice=text.get(offset..end).ok_or_else(||anyhow::anyhow!("STATE_COMPACT_CORRUPT"))?;
+            anyhow::ensure!(super::codec::encode(slice)?==piece.get::<_,Vec<u8>>(2)?,"STATE_TEXT_PROOF_FAILED");
+        }
+        j.cursor=*id;processed+=1;bytes+=cost;
+    }
+    if processed==rows.len() && rows.len()<r.limit {j.phase="ready".into();j.cursor=0;}
+    Ok(())
+}
+fn change(c:&Connection,r:&Request,j:&mut Job,rollback:bool)->anyhow::Result<()> {
+    anyhow::ensure!(if rollback {["ready","cutting","cut"].contains(&j.phase.as_str())} else {["ready","cutting"].contains(&j.phase.as_str())},"STATE_TX_CONFLICT");
+    let sql=if rollback {"SELECT l.blob FROM compact_text_blocks t INDEXED BY compact_text_job_blocks CROSS JOIN compact_text_locators l INDEXED BY compact_text_block_roots ON l.block=t.id WHERE t.job=(SELECT json_extract(value,'$.id') FROM compact_text_job WHERE singleton=1) ORDER BY t.id,l.blob LIMIT ?1"}else{"SELECT b.id FROM compact_blobs b INDEXED BY compact_text_ingress_id CROSS JOIN compact_text_locators l ON l.blob=b.id CROSS JOIN compact_text_blocks t ON t.id=l.block WHERE b.kind=0 AND length(b.payload)>0 AND b.id<=?2 AND t.job=(SELECT json_extract(value,'$.id') FROM compact_text_job WHERE singleton=1) ORDER BY b.id LIMIT ?1"};
+    let ids=if rollback {
+        c.prepare_cached(sql)?.query_map([r.limit as i64],|v|v.get::<_,i64>(0))?.collect::<rusqlite::Result<Vec<_>>>()?
+    } else {
+        c.prepare_cached(sql)?.query_map(params![r.limit as i64,j.cutoff],|v|v.get::<_,i64>(0))?.collect::<rusqlite::Result<Vec<_>>>()?
+    };
+    if !rollback {database::combined_format(c)?;}
+    c.execute("UPDATE compact_text_config SET mutation=1 WHERE singleton=1",[])?;
+    let start=Instant::now();let mut bytes=0usize;let mut processed=0;let mut selected=Vec::new();
+    for id in &ids {
+        database::check_preparation()?;if start.elapsed().as_millis()>=u128::from(r.max_ms){break;}
+        let size:i64=c.query_row(if rollback {"SELECT coalesce((SELECT length(payload) FROM compact_text_originals WHERE blob=?1),0)"}else{"SELECT length(payload) FROM compact_blobs WHERE id=?1"},[id],|v|v.get(0))?;
+        if bytes+usize::try_from(size)?>r.max_bytes {break;}
+        selected.push(*id);bytes+=usize::try_from(size)?;processed+=1;
+    }
+    let selected=serde_json::to_string(&selected)?;
+    if rollback {
+        c.execute("UPDATE compact_blobs AS b SET payload=(SELECT payload FROM compact_text_originals WHERE blob=b.id) WHERE id IN(SELECT value FROM json_each(?1)) AND EXISTS(SELECT 1 FROM compact_text_originals WHERE blob=b.id)",[&selected])?;
+        c.execute("DELETE FROM compact_text_originals WHERE blob IN(SELECT value FROM json_each(?1))",[&selected])?;
+        c.execute("DELETE FROM compact_text_locators WHERE blob IN(SELECT value FROM json_each(?1))",[&selected])?;
+    }else {
+        c.execute("INSERT INTO compact_text_originals SELECT id,payload FROM compact_blobs WHERE id IN(SELECT value FROM json_each(?1))",[&selected])?;
+        c.execute("UPDATE compact_blobs SET payload=zeroblob(0) WHERE id IN(SELECT value FROM json_each(?1))",[&selected])?;
+    }
+    c.execute("UPDATE compact_text_config SET mutation=0 WHERE singleton=1",[])?;
+    if processed==ids.len() && ids.len()<r.limit {
+        if rollback {j.phase="rollback".into();}
+        else {j.phase="cut".into();}
+    } else if !rollback {j.phase="cutting".into();}
+    Ok(())
+}
+fn retire(c:&Connection,r:&Request,j:&mut Job)->anyhow::Result<()> {
+    anyhow::ensure!(["cut","retiring"].contains(&j.phase.as_str()),"STATE_TX_CONFLICT");
+    let rows=c.prepare_cached("SELECT blob,length(payload) FROM compact_text_originals ORDER BY blob LIMIT ?1")?
+        .query_map([r.limit as i64],|v|Ok((v.get::<_,i64>(0)?,v.get::<_,i64>(1)?)))?.collect::<rusqlite::Result<Vec<_>>>()?;
+    let start=Instant::now();let mut bytes=0usize;
+    for (id,size) in rows {
+        database::check_preparation()?;
+        if start.elapsed().as_millis()>=u128::from(r.max_ms) || bytes+usize::try_from(size)?>r.max_bytes {break;}
+        c.execute("DELETE FROM compact_text_originals WHERE blob=?1",[id])?;bytes+=usize::try_from(size)?;
+    }
+    let more:bool=c.query_row("SELECT EXISTS(SELECT 1 FROM compact_text_originals)",[],|v|v.get(0))?;
+    j.phase=if more {"retiring"}else{"retired"}.into();Ok(())
+}
+fn collect(c:&Connection,r:&Request,j:&mut Job)->anyhow::Result<()> {
+    if j.gc_complete {j.gc_complete=false;j.gc_stage=0;j.gc_cursor=0;}
+    let cap=(r.limit/4).max(1);
+    let sql=if j.gc_stage==0 {
+        "SELECT l.blob,coalesce(length(o.payload),0)+coalesce(length(b.payload),0),NOT EXISTS(SELECT 1 FROM compact_segments s WHERE s.blob=l.blob) FROM compact_text_locators l LEFT JOIN compact_text_originals o ON o.blob=l.blob LEFT JOIN compact_blobs b ON b.id=l.blob WHERE l.blob>?1 ORDER BY l.blob LIMIT ?2"
+    } else {
+        "SELECT b.id,length(b.payload),NOT EXISTS(SELECT 1 FROM compact_text_locators l WHERE l.block=b.id) FROM compact_text_blocks b WHERE b.id>?1 ORDER BY b.id LIMIT ?2"
+    };
+    let rows=c.prepare_cached(sql)?.query_map(params![j.gc_cursor,cap as i64],|v|Ok((v.get::<_,i64>(0)?,v.get::<_,i64>(1)?,v.get::<_,bool>(2)?)))?.collect::<rusqlite::Result<Vec<_>>>()?;
+    let mut bytes=0usize;let start=Instant::now();
+    let mut processed=0;
+    for (id,size,dead) in &rows {
+        database::check_preparation()?;
+        if start.elapsed().as_millis()>=u128::from(r.max_ms) || bytes+usize::try_from(*size)?>r.max_bytes {break;}
+        if *dead {
+            if j.gc_stage==0 {
+                c.execute("DELETE FROM compact_text_originals WHERE blob=?1",[id])?;
+                c.execute("DELETE FROM compact_text_locators WHERE blob=?1",[id])?;
+                c.execute("DELETE FROM compact_blobs WHERE id=?1 AND kind=0 AND NOT EXISTS(SELECT 1 FROM compact_segments WHERE blob=?1)",[id])?;
+            }else {c.execute("DELETE FROM compact_text_blocks WHERE id=?1",[id])?;}
+        }
+        bytes+=usize::try_from(*size)?;j.gc_cursor=*id;processed+=1;
+    }
+    if processed==rows.len() && rows.len()<cap {j.gc_cursor=0;if j.gc_stage==0 {j.gc_stage=1;}else{j.gc_complete=true;}}
+    Ok(())
+}
