--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/tests.rs
@@ -0,0 +1,100 @@
+use super::*;
+use rusqlite::Connection;
+use serde_json::{Value, json};
+
+mod durable_tests;
+mod graph_tests;
+mod preparation_performance_tests;
+mod semantic_tests;
+mod source_tests;
+
+fn fresh() -> Connection {
+    database::open(std::path::Path::new(":memory:")).unwrap()
+}
+
+fn call(connection: &Connection, value: Value) -> anyhow::Result<Value> {
+    let request = request::parse(value)?;
+    let transaction = connection.unchecked_transaction()?;
+    let value = bounded(&transaction, || execute(&transaction, request))?;
+    transaction.commit()?;
+    Ok(value)
+}
+
+fn write(connection: &Connection, scope: &str, key: &str, value: Option<&Value>) {
+    let transaction = connection.unchecked_transaction().unwrap();
+    database::write(&transaction, scope, key, value).unwrap();
+    transaction.commit().unwrap();
+}
+
+fn node(id: &str, name: &str, members: &[&str]) -> Value {
+    json!({"id":id,"name":name,"type":"concept","stale":false,"properties":{},"sourceObservationIds":members})
+}
+
+fn edge(id: &str, source: &str, target: &str) -> Value {
+    json!({"id":id,"type":"related_to","sourceNodeId":source,"targetNodeId":target,"weight":0.75,"stale":false,"tvalid":"2026-09-25","tinvalid":null,"context":{"reasoning":"café 東京 😀"}})
+}
+
+fn code(cause: anyhow::Error) -> String {
+    cause
+        .downcast_ref::<protocol::TxError>()
+        .map_or_else(|| cause.to_string(), |cause| cause.0.to_owned())
+}
+
+fn ids(value: &Value) -> Vec<String> {
+    value["items"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .map(|item| item["id"].as_str().unwrap().to_owned())
+        .collect()
+}
+
+fn encoded(vector: &[f32]) -> String {
+    use base64::Engine;
+    base64::engine::general_purpose::STANDARD.encode(lsh::blob(vector))
+}
+
+fn semantic_request(action: &str) -> Value {
+    json!({"action":action,"index_id":"observations","model":"test-local","dimensions":4,"generation":"local-v1"})
+}
+
+fn configure(connection: &Connection) {
+    call(connection, semantic_request("semantic_configure")).unwrap();
+}
+
+fn vector_item(id: &str, vector: &[f32], text: Option<&str>) -> Value {
+    let mut value = json!({"id":id,"session_id":"session","embedding":encoded(vector)});
+    if let Some(text) = text {
+        value["text"] = json!(text);
+    }
+    value
+}
+
+fn upsert(connection: &Connection, items: Vec<Value>) -> anyhow::Result<Value> {
+    let mut request = semantic_request("semantic_upsert");
+    request["items"] = json!(items);
+    call(connection, request)
+}
+
+fn search(connection: &Connection, vector: &[f32], candidates: usize) -> Value {
+    let mut request = semantic_request("semantic_search");
+    request["embedding"] = json!(encoded(vector));
+    request["max_candidates"] = json!(candidates);
+    request["limit"] = json!(3);
+    call(connection, request).unwrap()
+}
+
+fn keywords(connection: &Connection, text: &str) -> anyhow::Result<Value> {
+    let mut request = semantic_request("keyword_search");
+    request["query"] = json!(text);
+    call(connection, request)
+}
+
+fn returned_ids(value: &Value) -> Vec<String> {
+    value["items"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .map(|item| item["obsId"].as_str().unwrap().to_owned())
+        .collect()
+}
