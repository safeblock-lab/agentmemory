@@ -0,0 +1,84 @@
+use super::super::{graph, metadata};
+use rusqlite::{Connection, OptionalExtension, params};
+use serde::{Deserialize, Serialize};
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+pub struct Epochs {
+    pub nodes: i64,
+    pub edges: i64,
+    pub vectors: i64,
+    pub sessions: i64,
+    pub summaries: i64,
+}
+
+pub struct Project {
+    pub generation: i64,
+    pub status: String,
+    pub phase: String,
+    pub cursor: String,
+    pub input_epochs: Option<Epochs>,
+    pub revision: i64,
+    pub progress: i64,
+    pub last_error: Option<String>,
+}
+
+fn add_column(c: &Connection, table: &str, name: &str, kind: &str) -> anyhow::Result<()> {
+    let mut statement = c.prepare(&format!("PRAGMA table_info({table})"))?;
+    let names = statement.query_map([], |r| r.get::<_, String>(1))?.collect::<rusqlite::Result<Vec<_>>>()?;
+    if !names.iter().any(|column| column == name) {
+        c.execute_batch(&format!("ALTER TABLE {table} ADD COLUMN {name} {kind}"))?;
+    }
+    Ok(())
+}
+
+pub fn schema(c: &Connection) -> anyhow::Result<()> {
+    add_column(c, "retrieval_nodes", "display_name", "TEXT")?;
+    add_column(c, "retrieval_nodes", "display_type", "TEXT")?;
+    add_column(c, "retrieval_edges", "display_type", "TEXT")?;
+    add_column(c, "retrieval_edges", "display_weight", "REAL")?;
+    c.execute_batch("CREATE TABLE IF NOT EXISTS browse_projects(project TEXT PRIMARY KEY,generation INTEGER NOT NULL,status TEXT NOT NULL,phase TEXT NOT NULL,cursor TEXT NOT NULL,input_epochs TEXT,revision INTEGER NOT NULL,progress INTEGER NOT NULL,last_error TEXT) WITHOUT ROWID;
+        CREATE TABLE IF NOT EXISTS browse_nodes(project TEXT NOT NULL,generation INTEGER NOT NULL,key TEXT NOT NULL,PRIMARY KEY(project,generation,key)) WITHOUT ROWID;
+        CREATE INDEX IF NOT EXISTS browse_nodes_key ON browse_nodes(key,project,generation);
+        CREATE TABLE IF NOT EXISTS browse_dirty(kind TEXT NOT NULL,key TEXT NOT NULL,version INTEGER NOT NULL,cursor TEXT NOT NULL,PRIMARY KEY(kind,key)) WITHOUT ROWID;
+        CREATE INDEX IF NOT EXISTS retrieval_edges_pair ON retrieval_edges(epoch,source,target,key);
+        CREATE INDEX IF NOT EXISTS retrieval_scoped_vectors_project ON retrieval_scoped_vectors(index_id,epoch,project,kind,session,id);
+        CREATE INDEX IF NOT EXISTS retrieval_scoped_vectors_session ON retrieval_scoped_vectors(index_id,epoch,session,id);")?;
+    Ok(())
+}
+
+pub fn epochs(c: &Connection) -> anyhow::Result<Option<Epochs>> {
+    let vectors: Option<i64> = c.query_row("SELECT epoch FROM retrieval_semantic_meta WHERE index_id='observations'",[],|r|r.get(0)).optional()?;
+    let Some(vectors) = vectors else { return Ok(None) };
+    Ok(Some(Epochs {
+        nodes: metadata::graph(c, graph::NODES)?.epoch,
+        edges: metadata::graph(c, graph::EDGES)?.epoch,
+        vectors,
+        sessions: c.query_row("SELECT epoch FROM retrieval_project_catalog WHERE source='sessions'", [], |r| r.get(0))?,
+        summaries: c.query_row("SELECT epoch FROM retrieval_project_catalog WHERE source='summaries'", [], |r| r.get(0))?,
+    }))
+}
+
+pub fn project(c: &Connection, name: &str) -> anyhow::Result<Option<Project>> {
+    let row: Option<(i64,String,String,String,Option<String>,i64,i64,Option<String>)> = c.query_row(
+        "SELECT generation,status,phase,cursor,input_epochs,revision,progress,last_error FROM browse_projects WHERE project=?1", [name],
+        |r| Ok((r.get(0)?,r.get(1)?,r.get(2)?,r.get(3)?,r.get(4)?,r.get(5)?,r.get(6)?,r.get(7)?))).optional()?;
+    row.map(|(generation,status,phase,cursor,input_epochs,revision,progress,last_error)| Ok(Project {
+        generation,status,phase,cursor,input_epochs:input_epochs.map(|v| serde_json::from_str(&v)).transpose()?,revision,progress,last_error,
+    })).transpose()
+}
+
+pub fn ensure(c: &Connection, name: &str, epochs: &Epochs) -> anyhow::Result<Project> {
+    c.execute("INSERT OR IGNORE INTO browse_projects VALUES(?1,1,'preparing','compact_nodes','',?2,1,0,NULL)", params![name,serde_json::to_string(epochs)?])?;
+    let mut saved = project(c, name)?.unwrap();
+    if saved.input_epochs.as_ref() != Some(epochs) {
+        c.execute("UPDATE browse_projects SET generation=generation+1,status='preparing',phase='cleanup',cursor='',input_epochs=?2,revision=revision+1,progress=0,last_error=NULL WHERE project=?1 AND generation<9007199254740990 AND revision<9007199254740990", params![name,serde_json::to_string(epochs)?])?;
+        saved = project(c, name)?.unwrap();
+        super::super::super::protocol::require(saved.input_epochs.as_ref() == Some(epochs))?;
+    }
+    Ok(saved)
+}
+
+pub fn save(c: &Connection, name: &str, saved: &Project, phase: &str, cursor: &str, processed: usize) -> anyhow::Result<()> {
+    c.execute("UPDATE browse_projects SET status='preparing',phase=?3,cursor=?4,progress=progress+?5,last_error=NULL WHERE project=?1 AND generation=?2",params![name,saved.generation,phase,cursor,processed as i64])?;
+    Ok(())
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/graph_query.rs b/engine/src/workers/state/adapters/sqlite/retrieval/graph_query.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/graph_query.rs
@@ -0,0 +1,243 @@
+use super::super::{commit, database, protocol};
+use super::{
+    graph, metadata,
+    request::{self, NameMatch},
+};
+use rusqlite::{Connection, params};
+use serde_json::{Value, json};
+
+const MAX_CANDIDATE_VISITS: usize = 131_072;
+
+fn begin(connection: &Connection, scope: &str) -> anyhow::Result<i64> {
+    commit::read_allowed(connection, scope, "", None)?;
+    let epoch = metadata::ready_graph(connection, scope)?;
+    connection.execute_batch("DELETE FROM retrieval_selected;")?;
+    Ok(epoch)
+}
+
+fn selected(
+    connection: &Connection,
+    key: &str,
+    position: i64,
+    entity: bool,
+    observation: bool,
+    max_items: usize,
+) -> anyhow::Result<()> {
+    connection.execute("INSERT INTO retrieval_selected VALUES(?1,?2,?3,?4) ON CONFLICT(key) DO UPDATE SET entity=MAX(entity,excluded.entity),observation=MAX(observation,excluded.observation)", params![key,position,entity,observation])?;
+    let count: i64 =
+        connection.query_row("SELECT count(*) FROM retrieval_selected", [], |r| r.get(0))?;
+    if count > max_items as i64 {
+        return Err(request::resource());
+    }
+    Ok(())
+}
+
+fn select_names(
+    connection: &Connection,
+    sql: &str,
+    epoch: i64,
+    term: &str,
+    query: &str,
+    mode: NameMatch,
+    visits: &mut usize,
+    max_items: usize,
+) -> anyhow::Result<()> {
+    let mut statement = connection.prepare_cached(sql)?;
+    let mut rows = statement.query(params![epoch, term])?;
+    while let Some(row) = rows.next()? {
+        *visits += 1;
+        if *visits > MAX_CANDIDATE_VISITS {
+            return Err(request::resource());
+        }
+        let name: String = row.get(1)?;
+        let matched = match mode {
+            NameMatch::Exact => name == query,
+            NameMatch::Substring => name.contains(query) || query.contains(&name),
+        };
+        if matched {
+            selected(
+                connection,
+                &row.get::<_, String>(0)?,
+                row.get(2)?,
+                true,
+                false,
+                max_items,
+            )?;
+        }
+    }
+    Ok(())
+}
+
+fn generation(connection: &Connection) -> anyhow::Result<Value> {
+    let control = database::row(connection, database::CONTROL_SCOPE, "current")?
+        .value
+        .ok_or_else(|| protocol::error("STATE_TX_FAILED"))?;
+    Ok(control["generation"].clone())
+}
+
+pub fn seeds(
+    connection: &Connection,
+    names: &[String],
+    observations: &[String],
+    mode: NameMatch,
+    max_items: usize,
+    max_bytes: usize,
+) -> anyhow::Result<Value> {
+    let epoch = begin(connection, graph::NODES)?;
+    let mut visits = 0;
+    for query in names {
+        let query = query.to_lowercase();
+        if mode == NameMatch::Exact {
+            select_names(
+                connection,
+                "SELECT key,name,position FROM retrieval_nodes INDEXED BY retrieval_nodes_name WHERE epoch=?1 AND name=?2",
+                epoch,
+                &query,
+                &query,
+                mode,
+                &mut visits,
+                max_items,
+            )?;
+            continue;
+        }
+        if query.is_empty() {
+            select_names(
+                connection,
+                "SELECT key,name,position FROM retrieval_nodes WHERE epoch=?1 AND ?2=''",
+                epoch,
+                "",
+                "",
+                mode,
+                &mut visits,
+                max_items,
+            )?;
+            continue;
+        }
+        let anchor: String = query.chars().take(3).collect();
+        select_names(
+            connection,
+            "SELECT n.key,n.name,n.position FROM retrieval_name_grams g CROSS JOIN retrieval_nodes n WHERE g.epoch=?1 AND g.gram=?2 AND n.epoch=g.epoch AND n.key=g.key",
+            epoch,
+            &anchor,
+            &query,
+            mode,
+            &mut visits,
+            max_items,
+        )?;
+        for width in 1..=3 {
+            for prefix in graph::grams(&query, width) {
+                select_names(
+                    connection,
+                    "SELECT key,name,position FROM retrieval_nodes INDEXED BY retrieval_nodes_prefix WHERE epoch=?1 AND prefix=?2",
+                    epoch,
+                    &prefix,
+                    &query,
+                    mode,
+                    &mut visits,
+                    max_items,
+                )?;
+            }
+        }
+        select_names(
+            connection,
+            "SELECT key,name,position FROM retrieval_nodes INDEXED BY retrieval_nodes_name WHERE epoch=?1 AND name=?2",
+            epoch,
+            "",
+            &query,
+            mode,
+            &mut visits,
+            max_items,
+        )?;
+    }
+    let mut statement = connection.prepare_cached(
+        "SELECT k.value,m.position FROM retrieval_inverse_membership_values m CROSS JOIN retrieval_identifiers k ON k.epoch=m.epoch AND k.id=m.key WHERE m.epoch=?1 AND m.observation=(SELECT id FROM retrieval_identifiers WHERE epoch=?1 AND value=?2) ORDER BY k.value",
+    )?;
+    for observation in observations {
+        let mut rows = statement.query(params![epoch, observation])?;
+        while let Some(row) = rows.next()? {
+            visits += 1;
+            if visits > MAX_CANDIDATE_VISITS {
+                return Err(request::resource());
+            }
+            selected(
+                connection,
+                &row.get::<_, String>(0)?,
+                row.get(1)?,
+                false,
+                true,
+                max_items,
+            )?;
+        }
+    }
+    let mut output = Vec::new();
+    let mut bytes = 256;
+    let mut statement = connection.prepare(
+        "SELECT key,position,entity,observation FROM retrieval_selected ORDER BY position",
+    )?;
+    let mut rows = statement.query([])?;
+    while let Some(row) = rows.next()? {
+        let key: String = row.get(0)?;
+        let position: i64 = row.get(1)?;
+        let item = json!({"key":key,"id":key,"position":position.to_string(),"entity":row.get::<_,bool>(2)?,"observation":row.get::<_,bool>(3)?});
+        bytes += protocol::size(&item)? + 1;
+        if bytes > max_bytes {
+            return Err(request::resource());
+        }
+        output.push(item);
+    }
+    Ok(json!({"items":output,"generation":generation(connection)?}))
+}
+
+pub fn edges(
+    connection: &Connection,
+    node_ids: &[String],
+    max_items: usize,
+    max_bytes: usize,
+) -> anyhow::Result<Value> {
+    let epoch = begin(connection, graph::EDGES)?;
+    let mut visits = 0;
+    for node in node_ids {
+        for sql in [
+            "SELECT key,position FROM retrieval_edges INDEXED BY retrieval_edges_source WHERE epoch=?1 AND source=?2",
+            "SELECT key,position FROM retrieval_edges INDEXED BY retrieval_edges_target WHERE epoch=?1 AND target=?2",
+        ] {
+            let mut statement = connection.prepare_cached(sql)?;
+            let mut rows = statement.query(params![epoch, node])?;
+            while let Some(row) = rows.next()? {
+                visits += 1;
+                if visits > MAX_CANDIDATE_VISITS {
+                    return Err(request::resource());
+                }
+                selected(
+                    connection,
+                    &row.get::<_, String>(0)?,
+                    row.get(1)?,
+                    false,
+                    false,
+                    max_items,
+                )?;
+            }
+        }
+    }
+    let mut statement = connection.prepare("SELECT s.key,s.position,r.value,r.value_bytes FROM retrieval_selected s CROSS JOIN state_values r WHERE r.scope=?1 AND r.key=s.key AND r.live=1 ORDER BY s.position")?;
+    let mut rows = statement.query([graph::EDGES])?;
+    let mut output = Vec::new();
+    let mut bytes = 256;
+    while let Some(row) = rows.next()? {
+        let raw_bytes: i64 = row.get(3)?;
+        if raw_bytes < 0 || raw_bytes as usize > max_bytes.saturating_sub(bytes) {
+            return Err(request::resource());
+        }
+        let encoded: Vec<u8> = row.get(2)?;
+        let value: Value = serde_json::from_str(&database::decode_value(&encoded, raw_bytes)?)?;
+        let position: i64 = row.get(1)?;
+        let item =
+            json!({"key":row.get::<_,String>(0)?,"position":position.to_string(),"value":value});
+        bytes += protocol::size(&item)? + 1;
+        if bytes > max_bytes {
+            return Err(request::resource());
+        }
+        output.push(item);
+    }
+    Ok(json!({"items":output,"generation":generation(connection)?}))
+}
