+use super::{
+    MAX_ENVELOPE_BYTES,
+    database::{CHECKPOINT_SCOPE, CONTROL_SCOPE, RECEIPT_SCOPE},
+};
+use crate::protocol::ErrorBody;
+use serde::{Deserialize, Serialize};
+use serde_json::Value;
+use sha2::{Digest, Sha256};
+use std::{collections::HashSet, io::Write};
+
+pub const SNAPSHOT: &str = "mem:graph:snapshot";
+pub const WORKING: &str = "mem:graph:working-snapshots";
+pub const JOBS: &str = "mem:graph:jobs";
+pub(super) const PREFIXES: [&str; 5] = [
+    "mem:graph:inputs:",
+    "mem:graph:provider-results:",
+    "mem:graph:deltas:",
+    "mem:graph:prepared:",
+    "mem:graph:remaps:",
+];
+const RECORDS: [&str; 7] = [
+    "mem:graph:nodes",
+    "mem:graph:edges",
+    SNAPSHOT,
+    "mem:graph:name-index",
+    "mem:graph:edge-key",
+    "mem:graph:node-degree",
+    "mem:graph:edge-history",
+];
+
+#[derive(Debug, thiserror::Error)]
+#[error("{0}: state transaction rejected")]
+pub struct TxError(pub &'static str);
+pub fn error(code: &'static str) -> anyhow::Error {
+    TxError(code).into()
+}
+pub fn require(condition: bool) -> anyhow::Result<()> {
+    if condition {
+        Ok(())
+    } else {
+        Err(error("STATE_TX_INVALID_REQUEST"))
+    }
+}
+pub fn guarded(scope: &str, key: &str) -> bool {
+    RECORDS.contains(&scope)
+        || [
+            JOBS,
+            WORKING,
+            CONTROL_SCOPE,
+            CHECKPOINT_SCOPE,
+            RECEIPT_SCOPE,
+        ]
+        .contains(&scope)
+        || PREFIXES.iter().any(|prefix| scope.starts_with(prefix))
+        || (scope == "mem:batch-callbacks" && (key == "active:graph" || key.starts_with("graph:")))
+}
+pub fn live(scope: &str, key: &str) -> bool {
+    RECORDS.contains(&scope) || (scope == "mem:batch-callbacks" && guarded(scope, key))
+}
+pub fn plain_write(scope: &str, key: &str) -> anyhow::Result<()> {
+    if guarded(scope, key) {
+        Err(error("STATE_TX_FENCED"))
+    } else {
+        Ok(())
+    }
+}
+pub fn error_body(cause: &anyhow::Error, fallback: &str) -> ErrorBody {
+    tracing::warn!(error = ?cause, "state operation rejected");
+    let code = cause
+        .downcast_ref::<TxError>()
+        .map_or(fallback, |error| error.0);
+    ErrorBody {
+        code: code.into(),
+        message: format!("{code}: state operation rejected"),
+        stacktrace: None,
+    }
+}
+#[derive(Default)]
+struct Size(usize);
+impl Write for Size {
+    fn write(&mut self, bytes: &[u8]) -> std::io::Result<usize> {
+        self.0 = self.0.saturating_add(bytes.len());
+        Ok(bytes.len())
+    }
+    fn flush(&mut self) -> std::io::Result<()> {
+        Ok(())
+    }
+}
+pub fn size(value: &impl Serialize) -> anyhow::Result<usize> {
+    let mut size = Size::default();
+    serde_json::to_writer(&mut size, value)?;
+    Ok(size.0)
+}
+pub fn decode<T: serde::de::DeserializeOwned>(value: Value) -> anyhow::Result<T> {
+    serde_json::from_value(value).map_err(|_| error("STATE_TX_INVALID_REQUEST"))
+}
+pub fn counter(value: &str) -> anyhow::Result<u64> {
+    require(
+        !value.is_empty()
+            && value.len() <= 20
+            && value.bytes().all(|c| c.is_ascii_digit())
+            && (value == "0" || !value.starts_with('0')),
+    )?;
+    value.parse().map_err(|_| error("STATE_TX_INVALID_REQUEST"))
+}
+pub fn next(value: u64) -> anyhow::Result<u64> {
+    value
+        .checked_add(1)
+        .ok_or_else(|| error("STATE_TX_LIMIT_EXCEEDED"))
+}
+fn ordinal(value: u64) -> bool {
+    value < 9_007_199_254_740_991
+}
