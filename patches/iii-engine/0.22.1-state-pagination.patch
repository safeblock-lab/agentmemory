+#[tokio::test]
+async fn sqlite_atomic_replay_fencing_barrier_snapshot_and_restart() {
+    let (directory, adapter) = fresh();
+    let owner = guard(&adapter, "owner", "1").await;
+    let first = batch(
+        owner.clone(),
+        "job",
+        "delta",
+        0,
+        "0",
+        "applying",
+        vec![
+            op(JOBS, "job", "0", job("job", "1")),
+            op("mem:graph:nodes", "a", "0", json!({"weight":2})),
+        ],
+    );
+    let receipt = adapter.commit_batch(first.clone()).await.unwrap();
+    assert_eq!(adapter.commit_batch(first.clone()).await.unwrap(), receipt);
+    assert_eq!(
+        code(adapter.get("mem:graph:nodes", "a").await.unwrap_err()),
+        "STATE_GRAPH_RECOVERY_REQUIRED"
+    );
+    assert_eq!(
+        code(adapter.list("mem:graph:nodes").await.unwrap_err()),
+        "STATE_GRAPH_RECOVERY_REQUIRED"
+    );
+    assert!(matches!(
+        adapter.list_page("mem:graph:nodes", None, 1, 1024).await,
+        Err(StatePageError::RecoveryRequired)
+    ));
+    assert_eq!(
+        version(&adapter, "mem:graph:nodes", "a", Some(owner.clone())).await["version"],
+        "1"
+    );
+    assert_eq!(
+        code(
+            adapter
+                .commit_batch(batch(
+                    owner.clone(),
+                    "other",
+                    "delta",
+                    0,
+                    "0",
+                    "staging",
+                    vec![op(JOBS, "other", "0", job("other", "1"))]
+                ))
+                .await
+                .unwrap_err()
+        ),
+        "STATE_GRAPH_RECOVERY_REQUIRED"
+    );
+    let changed = batch(
+        owner.clone(),
+        "job",
+        "delta",
+        0,
+        "0",
+        "applying",
+        vec![
+            op(JOBS, "job", "0", job("job", "1")),
+            op("mem:graph:nodes", "a", "0", json!({"weight":3})),
+        ],
+    );
+    assert_eq!(
+        code(adapter.commit_batch(changed).await.unwrap_err()),
+        "STATE_TX_REPLAY_CONFLICT"
+    );
+    adapter
+        .lease(
+            json!({"action":"release","owner_id":"owner","generation":"1","fence":owner["fence"]}),
+        )
+        .await
+        .unwrap();
+    let reopened = SqliteAdapter::new(Some(
+        json!({"file_path":directory.path().join("synthetic.sqlite3")}),
+    ))
+    .unwrap();
+    let next = guard(&reopened, "recovery", "1").await;
+    assert_eq!(next["fence"], "2");
+    assert_eq!(
+        code(adapter.commit_batch(first.clone()).await.unwrap_err()),
+        "STATE_TX_FENCED"
+    );
+    let mut retry = first;
+    retry["guard"] = next.clone();
+    assert_eq!(reopened.commit_batch(retry).await.unwrap(), receipt);
+    let snapshot = json!({"version":1,"nodes":[],"edges":[]});
+    let complete = batch(
+        next,
+        "job",
+        "delta",
+        1,
+        "1",
+        "complete",
+        vec![
+            op(
+                WORKING,
+                "job",
+                "0",
+                working("job", "1", "delta", Some(snapshot.clone())),
+            ),
+            op(SNAPSHOT, "current", "0", snapshot.clone()),
+            check("mem:graph:nodes", "a", "1"),
+        ],
+    );
+    reopened.commit_batch(complete).await.unwrap();
+    assert_eq!(
+        reopened.get(SNAPSHOT, "current").await.unwrap(),
+        Some(snapshot)
+    );
+    assert_eq!(
+        reopened.get("mem:graph:nodes", "a").await.unwrap(),
+        Some(json!({"weight":2}))
+    );
+}
