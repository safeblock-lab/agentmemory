+#[test]
+fn canonical_restart_recovers_preparation_and_compact_receipt() {
+    let path = path();
+    let c = database::open(&path).unwrap();
+    for n in 0..20 {
+        let id = format!("a{n}");
+        write(&c, SCOPE, &id, Some(&fact(&id, &format!("Fact {n}"))));
