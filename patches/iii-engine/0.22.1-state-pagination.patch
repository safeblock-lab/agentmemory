+use super::*;
+fn buckets(c: &Connection, index: &str, epoch: i64, id: &str) -> anyhow::Result<Vec<u8>> {
+    if super::super::super::search_packed::retiring(c)? {return super::super::super::search_packed::packed_signature(c,index,epoch,id);}
+    let mut statement=c.prepare("SELECT table_id,bucket FROM retrieval_vector_postings INDEXED BY retrieval_vector_postings_id WHERE index_id=?1 AND epoch=?2 AND id=?3 ORDER BY table_id LIMIT ?4")?;
+    let rows = statement
+        .query_map(params![index, epoch, id, (lsh::TABLES + 1) as i64], |r| {
+            Ok((r.get::<_, i64>(0)?, r.get::<_, u16>(1)?))
+        })?
+        .collect::<rusqlite::Result<Vec<_>>>()?;
+    protocol::require(
+        rows.len() == lsh::TABLES
+            && rows
+                .iter()
+                .enumerate()
+                .all(|(n, (table, _))| *table == n as i64),
+    )?;
+    Ok(rows
+        .into_iter()
+        .flat_map(|(_, bucket)| bucket.to_le_bytes())
+        .collect())
+}
+pub fn text(c: &Connection, index: &str, epoch: i64, id: &str) -> anyhow::Result<Option<String>> {
+    let value=super::super::lexical_content::rowid(c,index,epoch,id)?.map(|rowid|super::super::lexical_content::text(c,rowid)).transpose()?.flatten();
+    if let Some(value) = &value {
+        protocol::require(value.len() <= 1_048_576)?;
+    }
+    Ok(value)
+}
+pub fn remove(c: &Connection, index: &str, epoch: i64, id: &str) -> anyhow::Result<()> {
+    let old:Option<(Option<i64>,i64,i64,i64,Vec<u8>,Option<i64>)>=c.query_row("SELECT project,project_generation,kind,session,buckets,document FROM retrieval_scoped_vectors WHERE index_id=?1 AND epoch=?2 AND id=?3",params![index,epoch,id],|r|Ok((r.get(0)?,r.get(1)?,r.get(2)?,r.get(3)?,r.get(4)?,r.get(5)?))).optional()?;
+    if let Some((project, project_generation, kind, session, buckets, document)) = old {
+        protocol::require(buckets.len() == lsh::TABLES * 2)?;
+        if let Some(project) = project {
+            for (table, bucket) in buckets.chunks_exact(2).enumerate() {
+                c.execute("DELETE FROM retrieval_scoped_postings WHERE index_id=?1 AND epoch=?2 AND project=?3 AND project_generation=?4 AND kind=?5 AND table_id=?6 AND bucket=?7 AND session=?8 AND id=?9",params![index,epoch,project,project_generation,kind,table as i64,u16::from_le_bytes([bucket[0],bucket[1]]),session,id])?;
+            }
+        } else {
+            c.execute(
+                "UPDATE retrieval_scoped_meta SET unknown=unknown-1 WHERE index_id=?1 AND epoch=?2",
+                params![index, epoch],
+            )?;
+        }
+        if let Some(document) = document {
+            c.execute(
+                "DELETE FROM retrieval_scoped_lexical WHERE rowid=?1",
+                [document],
+            )?;
+        }
+        c.execute(
+            "DELETE FROM retrieval_scoped_vectors WHERE index_id=?1 AND epoch=?2 AND id=?3",
+            params![index, epoch, id],
+        )?;
+    }
+    Ok(())
+}
