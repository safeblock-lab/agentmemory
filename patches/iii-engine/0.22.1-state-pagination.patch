+#[derive(Default,Serialize,Deserialize)]
+struct Job {id:String,phase:String,ordinal:u64,cutoff:i64,cursor:i64,admission:String,
+    #[serde(default)] gc_stage:u8,#[serde(default)] gc_cursor:i64,#[serde(default)] gc_complete:bool}
+pub fn schema(c:&Connection)->anyhow::Result<()> {c.execute_batch(include_str!("root-layout.sql"))?;Ok(())}
+pub fn insert(c:&Connection,scope:&str,key:&str,version:&str,logical:usize)->anyhow::Result<i64> {
+    anyhow::ensure!(!c.is_autocommit(),"STATE_TX_INVALID_REQUEST");
+    let (previous,live,fields,originals):(i64,i64,i64,i64)=c.query_row("SELECT last_id,(SELECT coalesce(max(id),0) FROM compact_roots),(SELECT coalesce(max(root),0) FROM compact_root_fields),(SELECT coalesce(max(root),0) FROM compact_root_originals) FROM compact_root_sequence WHERE singleton=1",[],|v|Ok((v.get(0)?,v.get(1)?,v.get(2)?,v.get(3)?)))?;
+    let id=previous.max(live).max(fields).max(originals).checked_add(1).ok_or_else(||anyhow::anyhow!("STATE_TX_LIMIT_EXCEEDED"))?;
+    let changed=c.execute("UPDATE compact_root_sequence SET last_id=?1 WHERE singleton=1 AND last_id=?2",params![id,previous])?;
+    anyhow::ensure!(changed==1,"STATE_TX_CONFLICT");
+    c.execute("INSERT INTO compact_roots(id,scope,key,version,logical_bytes) VALUES(?1,?2,?3,?4,?5)",params![id,scope,key,version,i64::try_from(logical)?])?;
+    Ok(id)
+}
+fn load(c:&Connection)->anyhow::Result<Job> {
+    let value:Option<String>=c.query_row("SELECT value FROM compact_root_job WHERE singleton=1",[],|v|v.get(0)).optional()?;
+    Ok(value.map(|v|serde_json::from_str(&v)).transpose()?.unwrap_or_default())
+}
+pub fn status(c:&Connection)->anyhow::Result<Value> {Ok(serde_json::to_value(load(c)?)?)}
+pub fn receipt(c:&Connection,r:&Request)->anyhow::Result<Value> {
+    let value:Option<(String,String)>=c.query_row("SELECT request,result FROM compact_root_receipts WHERE operation_id=?1",[&r.operation_id],|v|Ok((v.get(0)?,v.get(1)?))).optional()?;
+    if let Some((request,result))=value {
+        anyhow::ensure!(request==serde_json::to_string(r)?,"STATE_TX_REPLAY_CONFLICT");
+        return Ok(json!({"status":"applied","result":serde_json::from_str::<Value>(&result)?}));
+    }
+    Ok(json!({"status":"not_found"}))
+}
+pub fn execute(c:&Connection,r:Request)->anyhow::Result<Value> {
+    anyhow::ensure!(!c.is_autocommit() && (1..=100000).contains(&r.limit) && (16384..=4*1024*1024).contains(&r.max_bytes)
+        && (1..=2500).contains(&r.max_ms) && !r.admission_id.is_empty() && r.admission_id.len()<=128
+        && !r.operation_id.is_empty() && r.operation_id.len()<=128 && !r.job_id.is_empty() && r.job_id.len()<=96,"STATE_TX_INVALID_REQUEST");
+    let lease=storage_repack::Request{operation_id:r.operation_id.clone(),job_id:r.job_id.clone(),expected_ordinal:r.expected_ordinal,
