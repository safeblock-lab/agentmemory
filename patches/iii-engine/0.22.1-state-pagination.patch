+fn policy() -> Value { json!({"version":1,"additional_attempts_per_slot":1,"admissions_per_hour":4,"cooldown_ms":60_000,"deadline_ms":120_000}) }
+pub(super) fn initialize(connection: &Connection) -> anyhow::Result<()> {
+    need(connection.is_autocommit(),"STATE_GRAPH_AUTOMATIC_TRANSACTION_INVALID")?;
+    let transaction=rusqlite::Transaction::new_unchecked(connection,TransactionBehavior::Immediate)?;
+    transaction.execute_batch(include_str!("graph_automatic_recovery/schema.sql"))?;
+    let legacy_declaration=serde_json::to_string(&policy())?;
+    let mut extended_policy=policy();
+    extended_policy["unspent_reservation_adoption_revision"]=json!(adoption::REVISION);
+    let declaration=serde_json::to_string(&extended_policy)?;
+    transaction.execute("INSERT OR IGNORE INTO engine_graph_auto_policy(singleton,version,declaration) VALUES(1,1,?1)",[&declaration])?;
+    let (version,pinned):(u32,String)=transaction.query_row("SELECT version,declaration FROM engine_graph_auto_policy WHERE singleton=1",[],|r|Ok((r.get(0)?,r.get(1)?)))?;
+    need(version==1 && (pinned==declaration || pinned==legacy_declaration),"STATE_GRAPH_AUTOMATIC_POLICY_CHANGED")?;
+    adoption::initialize(&transaction)?;
+    if pinned!=declaration {
+        let prior:i64=transaction.query_row("SELECT last_clock_ms FROM engine_graph_auto_policy WHERE singleton=1",[],|row|row.get(0))?;
+        let activated_at=chrono::Utc::now().timestamp_millis().max(prior);
+        need((1..=9_007_199_254_620_991).contains(&activated_at),"STATE_GRAPH_AUTOMATIC_CLOCK_INVALID")?;
+        transaction.execute("UPDATE engine_graph_auto_policy SET declaration=?1 WHERE singleton=1 AND declaration=?2",params![declaration,pinned])?;
+        store::event(&transaction,"policy:adoption",None,"adoption_policy_activated",activated_at,json!({"previous_declaration":pinned,"revision":adoption::REVISION,"external_effect":false}))?;
+    }
+    transaction.commit()?;
+    Ok(())
+}
+pub(super) fn execute(connection: &Connection, path: &Path, request: Request) -> anyhow::Result<Value> {
+    request.validate()?;
+    need(connection.is_autocommit(),"STATE_GRAPH_AUTOMATIC_TRANSACTION_INVALID")?;
+    let synchronous:i64=connection.pragma_query_value(None,"synchronous",|r|r.get(0))?;
+    need(synchronous>=2,"STATE_GRAPH_AUTOMATIC_DURABILITY_UNAVAILABLE")?;
+    let _decode=database::DecodeWorkGuard::new(64*1024*1024);
+    let transaction=rusqlite::Transaction::new_unchecked(connection,TransactionBehavior::Immediate)?;
+    let (now,clock_rollback)=store::now(&transaction)?;
+    if let Request::TerminalRecover {anchor}=&request {
+        let mut trusted=None;
+        let result=terminal::recover(&transaction,path,anchor,now,clock_rollback,&mut trusted)?;
+        transaction.commit()?;
+        return Ok(result);
+    }
+    let id=match &request {
+        Request::Status {slot_id}=>slot_id.clone(),
+        _=>binding::slot_id(request.anchor().ok_or_else(||error(INVALID))?)?,
+    };
+    store::reconcile(&transaction,now,Some(&id))?;
+    if clock_rollback && matches!(&request,Request::Prepare{..}|Request::Dispatch{..}|Request::Admit{..}|Request::Regenerate{..}) {
+        let result=if store::slot(&transaction,&id)?.is_some() {store::response(&transaction,request.command(),&id,false)}
+            else {Err(error("STATE_GRAPH_AUTOMATIC_CLOCK_ROLLBACK"))};
+        transaction.commit()?;
+        return result;
+    }
+    let admission_authority=if matches!(&request,Request::Admit{..}|Request::Regenerate{..}) {
+        if let Some(slot)=store::slot(&transaction,&id)? {
+            let root=store::slot(&transaction,&slot.root)?.ok_or_else(||error("STATE_GRAPH_AUTOMATIC_SLOT_MISSING"))?;
+            let attempt=store::current(&transaction,&slot)?;
+            if matches!(&request,Request::Admit{..}) {
+                slot.binding.is_some() && !root.retry && attempt.is_some_and(|attempt|attempt.ordinal==0 && attempt.state=="unknown" && attempt.digest.is_none())
+            } else {
+                !root.retry && root.regeneration.is_none() && attempt.is_some_and(|attempt|attempt.digest.is_none()
+                    && ["unknown","expired","failed"].contains(&attempt.state.as_str()))
+            }
+        } else {matches!(&request,Request::Regenerate{..})}
+    } else {false};
+    let requires_authority=matches!(&request,Request::Prepare{..}|Request::Dispatch{..}) || admission_authority;
+    let trusted=if requires_authority {Some(authority::Trusted::read(path)?)} else {None};
+    let command=request.command();
+    let result=apply(&transaction,request,now,&id,command,trusted.as_ref())?;
+    transaction.commit()?;
+    Ok(result)
+}
+fn compatible(connection: &Connection, slot: &store::Slot, anchor: &Anchor, job: &Value, trusted:Option<&authority::Trusted>, now:i64) -> anyhow::Result<()> {
+    let definition=slot.binding.as_ref().ok_or_else(||error("STATE_GRAPH_AUTOMATIC_LEGACY_REQUEST_MISSING"))?;
+    let authority_id=slot.authority_id.as_deref().ok_or_else(||error("STATE_GRAPH_AUTOMATIC_PROFILE_NOT_APPROVED"))?;
+    trusted.ok_or_else(||error("STATE_GRAPH_AUTOMATIC_AUTHORITY_UNAVAILABLE"))?.authorize(connection,anchor,definition,job,Some(authority_id))?;
+    let source=binding::source_capture(connection,anchor,job)?;
+    need(slot.source_digest.as_deref()==Some(source.as_str()),"STATE_GRAPH_AUTOMATIC_SOURCE_CHANGED")?;
+    terminal::prepare(connection,anchor,job,definition,None,now)?;
+    binding::binding(connection,anchor,definition)
+}
+fn intent_matches(connection:&Connection,slot:&store::Slot,anchor:&Anchor,dispatched:bool)->anyhow::Result<Value> {
+    let current=database::row(connection,&anchor.provider_scope(),&anchor.intent_key())?;
+    let original=slot.original_intent.as_ref().ok_or_else(||error("STATE_GRAPH_AUTOMATIC_PREPARATION_REQUIRED"))?;
+    let mut expected=original.clone();
+    let mut version=super::protocol::counter(&slot.original_intent_version)?;
+    if dispatched && original["state"]=="not-dispatched" {
+        expected["state"]=json!("intended");
+        expected["automaticAttemptId"]=json!(format!("{}:{}",slot.root,if slot.root==slot.id {0}else{1}));
+        version=super::protocol::next(version)?;
+    }
+    need(current.version==version && current.value.as_ref()==Some(&expected),"STATE_GRAPH_AUTOMATIC_INTENT_CHANGED")?;
+    current.value.ok_or_else(||error("STATE_GRAPH_AUTOMATIC_PREPARATION_REQUIRED"))
+}
+fn stable_reason(cause: &anyhow::Error) -> &'static str {
+    match cause.downcast_ref::<TxError>().map(|error|error.0) {
+        Some("STATE_GRAPH_AUTOMATIC_SOURCE_CHANGED")=>"GRAPH_AUTOMATIC_SOURCE_CHANGED",
+        Some("STATE_GRAPH_AUTOMATIC_SOURCE_INCOMPLETE")=>"GRAPH_AUTOMATIC_SOURCE_INCOMPLETE",
+        Some("STATE_GRAPH_AUTOMATIC_SOURCE_LIMIT")=>"GRAPH_AUTOMATIC_SOURCE_LIMIT",
+        Some("STATE_GRAPH_AUTOMATIC_SOURCE_UNIT_UNPROVEN")=>"GRAPH_AUTOMATIC_SOURCE_UNIT_UNPROVEN",
+        Some("STATE_GRAPH_AUTOMATIC_SCOPE_UNPROVEN")=>"GRAPH_AUTOMATIC_SCOPE_UNPROVEN",
+        Some("STATE_RETRIEVAL_RESOURCE_LIMIT"|"STATE_TX_LIMIT_EXCEEDED"|"STATE_RECORD_TOO_LARGE")=>"GRAPH_AUTOMATIC_SOURCE_LIMIT",
+        Some("STATE_GRAPH_AUTOMATIC_LEGACY_REQUEST_MISSING")=>"GRAPH_AUTOMATIC_LEGACY_REQUEST_MISSING",
+        Some("STATE_GRAPH_AUTOMATIC_AUTHORITY_CHANGED")=>"GRAPH_AUTOMATIC_AUTHORITY_CHANGED",
+        Some("STATE_GRAPH_AUTOMATIC_PROFILE_NOT_APPROVED")=>"GRAPH_AUTOMATIC_PROFILE_NOT_APPROVED",
+        _=>"GRAPH_AUTOMATIC_BINDING_INCOMPATIBLE",
+    }
+}
+fn existing(connection:&Connection,id:&str)->anyhow::Result<store::Slot> {
+    store::slot(connection,id)?.ok_or_else(||error("STATE_GRAPH_AUTOMATIC_SLOT_MISSING"))
+}
+fn matching_attempt(connection:&Connection,slot:&store::Slot,id:&str)->anyhow::Result<store::Attempt> {
+    let attempt=store::attempt(connection,id)?.ok_or_else(||error("STATE_GRAPH_AUTOMATIC_ATTEMPT_MISSING"))?;
+    need(attempt.slot==slot.id && attempt.ordinal==slot.current,"STATE_GRAPH_AUTOMATIC_ID_CONFLICT")?;
+    Ok(attempt)
+}
+fn legacy(connection:&Connection,anchor:&mut Anchor,id:&str,now:i64)->anyhow::Result<()> {
+    let intent=database::row(connection,&anchor.provider_scope(),&anchor.intent_key())?;
+    if let Some(intent)=&intent.value {
+        need(intent["version"]==1 && intent["state"]=="intended" && intent["id"].as_str().is_some(),"STATE_GRAPH_AUTOMATIC_ORIGINAL_NOT_UNKNOWN")?;
+    }
+    store::insert_slot(connection,anchor,None,None,None,None,intent.value.as_ref(),Some("GRAPH_AUTOMATIC_LEGACY_REQUEST_MISSING"),now)?;
+    store::insert_attempt(connection,id,id,0,"unknown",true,now,now)?;
+    if cleanup::legacy_reference(connection,anchor,now,id)? {
+        store::terminal(connection,id,"GRAPH_AUTOMATIC_LEGACY_COMPLETE_OUTPUT",now)?;
+    } else {
+        cleanup::invalidate_staging(connection,id,anchor,now)?;
+    }
+    Ok(())
+}
