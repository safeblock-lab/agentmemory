+use super::{binding, error, need, store, terminal, wire::{Anchor, TerminalAnchor}};
+use super::super::{commit, database, protocol::{self, Checkpoint, JOBS}};
+use rusqlite::{params, Connection};
+use serde_json::{json, Value};
+
+pub(super) const REVISION:&str="unspent-child-recovery-v1";
+pub(super) const PROOF_REVISION:&str="staging-checkpoint-recovery-v1";
+const UNPROVEN:&str="STATE_GRAPH_AUTOMATIC_UNSPENT_CHILD_UNPROVEN";
+
+fn technical(scope:&str,key:&str,job:&str)->bool {
+    scope==JOBS && key==job || [format!("mem:graph:inputs:{job}"),format!("mem:graph:provider-results:{job}"),
+        format!("mem:graph:deltas:{job}"),format!("mem:graph:remaps:{job}")].iter().any(|allowed|scope==allowed)
+}
+fn no_effects(c:&Connection,job:&str,generation:&str,checkpoint_version:u64,checkpoint:&Checkpoint)->anyhow::Result<()> {
+    let prefix=serde_json::to_string(&(generation,job))?;
+    let prefix=format!("{},",prefix.strip_suffix(']').ok_or_else(||error(UNPROVEN))?);
+    let mut statement=c.prepare("SELECT key FROM state_values WHERE scope=?1 AND key>=?2 AND key<?3 AND value IS NOT NULL ORDER BY key LIMIT 4097")?;
+    let keys=statement.query_map(params![database::RECEIPT_SCOPE,prefix,format!("{prefix}\u{10ffff}")],|row|row.get::<_,String>(0))?.collect::<rusqlite::Result<Vec<_>>>()?;
+    need(!keys.is_empty() && keys.len()<=4096,UNPROVEN)?;
+    let mut versions=std::collections::BTreeSet::new();
+    for key in keys {
+        let receipt=database::row(c,database::RECEIPT_SCOPE,&key)?.value.ok_or_else(||error(UNPROVEN))?;
+        need(receipt["identity"]["job_id"]==job && receipt["identity"]["generation"]==generation,UNPROVEN)?;
+        let version=protocol::counter(receipt["checkpoint_version"].as_str().ok_or_else(||error(UNPROVEN))?)?;
+        need(version>0 && version<=checkpoint_version && versions.insert(version),UNPROVEN)?;
+        if version==checkpoint_version {
+            need(receipt["identity"]["logical_delta_id"]==checkpoint.logical_delta_id
+                && receipt["identity"]["chunk_ordinal"].as_u64().and_then(|ordinal|ordinal.checked_add(1))==Some(checkpoint.next_chunk_ordinal),UNPROVEN)?;
+        }
+        let rows=receipt["row_versions"].as_array().ok_or_else(||error(UNPROVEN))?;
+        for row in rows {
+            need(row["scope"].as_str().zip(row["key"].as_str()).is_some_and(|(scope,key)|technical(scope,key,job)),UNPROVEN)?;
+        }
+    }
+    need(u64::try_from(versions.len())?==checkpoint_version,UNPROVEN)?;
+    Ok(())
+}
+pub(super) fn prove(c:&Connection,parent:&Anchor,proof:&Value,child:&str,token:&str,staging:Option<&Anchor>)->anyhow::Result<Value> {
+    commit::read_allowed(c,JOBS,child,Some(&parent.guard))?;
+    let row=database::row(c,JOBS,child)?;
+    let job=row.value.ok_or_else(||error(UNPROVEN))?;
+    need(job["id"]==child && job["kind"]=="extraction" && job["version"]==1
+        && job["generation"]==parent.guard.generation && job["captureComplete"]==true
+        && job["automaticReplacementOf"]==parent.job_id && job["automaticRegenerationId"]==token
+        && job.get("automaticRegenerationClaimedSlot").is_none(),UNPROVEN)?;
+    if let Some(anchor)=staging {
+        need(anchor.job_id==child && anchor.job_version==row.version.to_string() && job["state"]=="staging"
+            && job["recoveryStopped"]!=true,UNPROVEN)?;
+    } else {
+        need(job["state"]=="failed" && job["recoveryStopped"]==true
+            && job["failureCode"]=="STATE_GRAPH_AUTOMATIC_REGENERATION_REQUIRED",UNPROVEN)?;
+    }
+    let occupied:bool=c.query_row("SELECT EXISTS(SELECT 1 FROM engine_graph_auto_slots WHERE json_extract(anchor_json,'$.job_id')=?1) OR EXISTS(SELECT 1 FROM engine_graph_auto_units WHERE job_id=?1)",[child],|row|row.get(0))?;
+    need(!occupied,UNPROVEN)?;
+    let point=database::row(c,database::CHECKPOINT_SCOPE,child)?;
+    let checkpoint:Checkpoint=protocol::decode(point.value.ok_or_else(||error(UNPROVEN))?)?;
+    need(checkpoint.job_id==child && checkpoint.generation==parent.guard.generation
+        && ["staging","complete"].contains(&checkpoint.visibility.as_str())
+        && checkpoint.delta_ordinal>0 && checkpoint.logical_delta_id==format!("delta:{}",checkpoint.delta_ordinal)
+        && checkpoint.next_chunk_ordinal>0,UNPROVEN)?;
+    if checkpoint.visibility=="staging" {
+        need(job["continuationState"]["activeUnit"]["resultOrdinal"]==checkpoint.delta_ordinal
+            && (staging.is_some() || job.get("continuationFromOrdinal").is_none()),UNPROVEN)?;
+    }
+    let current=TerminalAnchor {guard:parent.guard.clone(),job_id:child.to_owned(),job_version:row.version.to_string(),checkpoint_version:point.version.to_string()};
+    let (anchor,child_proof,reference)=terminal::derive(c,&current,&job,&checkpoint)?;
+    need(reference.is_null() && child_proof["capture"]==proof["capture"] && child_proof["selection"]==proof["selection"]
+        && job["continuationState"]["version"]==2 && job["continuationState"]["pageIndex"]==0
+        && job["continuationState"]["cursor"]==proof["progress"]["cursor"],UNPROVEN)?;
+    if let Some(expected)=staging {need(binding::slot_id(&anchor)?==binding::slot_id(expected)?,UNPROVEN)?;}
+    need(terminal::history(c,&anchor,None)?.is_none(),UNPROVEN)?;
+    let source_key=format!("value:{}:automatic-source",anchor.delta_ordinal);
+    let source_parts=format!("{source_key}:part:");
+    let mut statement=c.prepare("SELECT key FROM state_values WHERE scope=?1 AND key>='value:' AND key<'value;' AND value IS NOT NULL ORDER BY key LIMIT 514")?;
+    let outputs=statement.query_map([anchor.provider_scope()],|row|row.get::<_,String>(0))?.collect::<rusqlite::Result<Vec<_>>>()?;
+    need(outputs.len()<=513 && outputs.iter().all(|key|key==&source_key || key.strip_prefix(&source_parts).and_then(|part|part.parse::<u32>().ok()).is_some_and(|part|part<512)),UNPROVEN)?;
+    no_effects(c,child,&parent.guard.generation,point.version,&checkpoint)?;
+    Ok(json!({"job":job,"job_version":row.version.to_string(),"checkpoint_version":point.version.to_string(),"checkpoint":checkpoint}))
+}
+pub(super) fn reopen(c:&Connection,root:&str,child:&str,token:&str,proven:&Value,now:i64,staging:bool)->anyhow::Result<()> {
+    let row=database::row(c,JOBS,child)?;
+    need(row.version.to_string()==proven["job_version"] && row.value.as_ref()==Some(&proven["job"]),"STATE_TX_CONFLICT")?;
+    let checkpoint=database::row(c,database::CHECKPOINT_SCOPE,child)?;
+    need(checkpoint.version.to_string()==proven["checkpoint_version"] && checkpoint.value.as_ref()==Some(&proven["checkpoint"]),"STATE_TX_CHECKPOINT_CONFLICT")?;
+    let mut job=proven["job"].clone();
+    job["automaticRegenerationId"]=json!(token);
+    if !staging {
+        job["state"]=json!("staging");job["recoveryStopped"]=json!(false);job["recoveryAfter"]=Value::Null;
+        if proven["checkpoint"]["visibility"]=="complete" {
+            job["continuationFromOrdinal"]=proven["checkpoint"]["delta_ordinal"].clone();
+        }
+    }
+    let version=database::write(c,JOBS,child,Some(&job))?;
+    store::event(c,root,Some(&format!("{root}:1")),if staging {"unspent_child_prepare_refreshed"}else{"unspent_child_reopened"},now,
+        json!({"revision":REVISION,"child_job_id":child,"previous":proven,"job_version":version.to_string(),"checkpoint_preserved":true,"same_attempt":true}))?;
+    Ok(())
+}
diff --git a/engine/src/workers/state/adapters/sqlite/graph_automatic_recovery/cleanup.rs b/engine/src/workers/state/adapters/sqlite/graph_automatic_recovery/cleanup.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/graph_automatic_recovery/cleanup.rs
@@ -0,0 +1,83 @@
+use super::{need, store, wire::Anchor};
+use super::super::database;
+use rusqlite::{params, Connection, OptionalExtension};
+use serde_json::{json, Value};
+
+pub(super) fn parts(connection: &Connection, slot: &str, attempt: &str, now: i64) -> anyhow::Result<usize> {
+    let complete: Option<String> = connection.query_row("SELECT response_digest FROM engine_graph_auto_attempts WHERE attempt_id=?1 AND slot_id=?2",params![attempt,slot],|r|r.get(0))?;
+    if complete.is_some() { return Ok(0); }
+    connection.execute("UPDATE engine_graph_auto_attempts SET response_parts=NULL,response_bytes=NULL,response_digest=NULL,updated_at_ms=?2 WHERE attempt_id=?1",params![attempt,now])?;
+    let deleted = connection.execute("DELETE FROM engine_graph_auto_parts WHERE attempt_id=?1",[attempt])?;
+    if deleted > 0 { store::event(connection,slot,Some(attempt),"invalidate_incomplete_capture",now,json!({"deleted_parts":deleted,"preserved_intent":true,"preserved_consumed":true}))?; }
+    Ok(deleted)
+}
+pub(super) fn invalidate_staging(connection: &Connection, slot: &str, anchor: &mut Anchor, now: i64) -> anyhow::Result<usize> {
+    let row = database::row(connection,&anchor.manifest_scope(),&anchor.manifest_key())?;
+    let mut manifest = row.value.ok_or_else(||super::error("STATE_GRAPH_AUTOMATIC_MANIFEST_MISSING"))?;
+    need(row.version.to_string() == anchor.manifest_version && manifest["attempt"] == anchor.manifest_attempt
+        && manifest["phase"] == "preparing" && ["templateCount","applyOrdinal","applyCheckpointVersion","result"].iter().all(|key|manifest.get(key).is_none()),
+        "STATE_GRAPH_AUTOMATIC_ALREADY_APPLYING")?;
+    if manifest["automaticRecoveryInvalidated"] == true { return Ok(0); }
+    let old = anchor.manifest_attempt.clone();
+    let next = format!("auto-{}",uuid::Uuid::new_v4());
+    let object = manifest.as_object_mut().ok_or_else(||super::error(super::INVALID))?;
+    object.insert("attempt".into(),json!(next));
+    object.insert("shadowCount".into(),json!(0));
+    object.insert("automaticRecoveryInvalidated".into(),json!(true));
+    object.insert("automaticRecoveryPriorAttempt".into(),json!(old));
+    let version = database::write(connection,&anchor.manifest_scope(),&anchor.manifest_key(),Some(&manifest))?;
+    anchor.manifest_version = version.to_string(); anchor.manifest_attempt = next;
+    anchor.guard=super::super::commit::advance_graph_fence(connection,&anchor.guard)?;
+    for (scope,prefix,priority) in [
+        (format!("mem:graph:remaps:{}",anchor.job_id),format!("row-order:{}:{old}:",anchor.delta_ordinal),0),
+        (anchor.manifest_scope(),format!("row:{}:{old}:",anchor.delta_ordinal),1),
+    ] {
+        connection.execute("INSERT OR IGNORE INTO engine_graph_auto_cleanup(slot_id,scope,prefix,priority) VALUES(?1,?2,?3,?4)",params![slot,scope,prefix,priority])?;
+    }
+    store::save_anchor(connection,slot,anchor,now)?;
+    store::event(connection,slot,None,"invalidate_staging_attempt",now,json!({"delta_ordinal":anchor.delta_ordinal,"prior_attempt":old,"next_attempt":anchor.manifest_attempt,"manifest_version":anchor.manifest_version}))?;
+    Ok(1)
+}
+pub(super) fn page(connection: &Connection, slot: &str, now: i64) -> anyhow::Result<Value> {
+    let mut deleted = 0usize;
+    let mut bytes = 0usize;
+    loop {
+        let range: Option<(String,String,String)> = connection.query_row("SELECT scope,prefix,after_key FROM engine_graph_auto_cleanup WHERE slot_id=?1 AND done=0 ORDER BY priority,scope,prefix LIMIT 1",[slot],|r|Ok((r.get(0)?,r.get(1)?,r.get(2)?))).optional()?;
+        let Some((scope,prefix,after))=range else { break; };
+        let lower = if after.is_empty() { prefix.clone() } else { after.clone() };
+        let upper = format!("{prefix}\u{10ffff}");
+        let mut statement=connection.prepare("SELECT key,value_bytes FROM state_rows WHERE scope=?1 AND key>=?2 AND key<?3 AND key>?4 AND value IS NOT NULL ORDER BY key LIMIT 257")?;
+        let keys=statement.query_map(params![scope,lower,upper,after],|r|Ok((r.get::<_,String>(0)?,r.get::<_,i64>(1)?)))?.collect::<rusqlite::Result<Vec<_>>>()?;
+        drop(statement);
+        let mut last=after;
+        let mut done=true;
+        for (key,size) in keys {
+            need(key.starts_with(&prefix),"STATE_GRAPH_AUTOMATIC_CLEANUP_OWNERSHIP")?;
+            let work = usize::try_from(size)?.saturating_add(key.len()).saturating_add(256);
+            if deleted >= 256 || deleted > 0 && bytes.saturating_add(work)>4*1024*1024 { done=false; break; }
+            need(work<=super::super::MAX_ENVELOPE_BYTES.saturating_add(4096),"STATE_GRAPH_AUTOMATIC_CLEANUP_LIMIT")?;
+            database::write(connection,&scope,&key,None)?;
+            bytes += work; deleted += 1; last=key;
+        }
+        connection.execute("UPDATE engine_graph_auto_cleanup SET after_key=?4,done=?5 WHERE slot_id=?1 AND scope=?2 AND prefix=?3",params![slot,scope,prefix,last,done])?;
+        if !done { break; }
+    }
+    let pending:bool=connection.query_row("SELECT EXISTS(SELECT 1 FROM engine_graph_auto_cleanup WHERE slot_id=?1 AND done=0)",[slot],|r|r.get(0))?;
+    if deleted>0 { store::event(connection,slot,None,"cleanup_owned_staging",now,json!({"deleted":deleted,"pending":pending}))?; }
+    Ok(json!({"invalidated":0,"deleted":deleted,"pending":pending,"retained_unproven":true}))
+}
+
+pub(super) fn legacy_reference(connection: &Connection, anchor: &Anchor, now: i64, slot: &str) -> anyhow::Result<bool> {
+    let reference=database::row(connection,&anchor.provider_scope(),&anchor.value_key())?;
+    let Some(value)=reference.value else { return Ok(false); };
+    match super::binding::frozen(connection,&anchor.provider_scope(),&anchor.value_key(),&value) {
+        Ok(_)=>return Ok(true),
+        Err(cause)=>{
+            let code=cause.downcast_ref::<super::super::protocol::TxError>().map(|cause|cause.0);
+            if !matches!(code,Some("STATE_GRAPH_AUTOMATIC_SOURCE_INCOMPLETE"|"STATE_GRAPH_AUTOMATIC_SOURCE_CHANGED")) { return Ok(false); }
+        },
+    }
+    database::write(connection,&anchor.provider_scope(),&anchor.value_key(),None)?;
+    store::event(connection,slot,None,"invalidate_incomplete_legacy_reference",now,json!({"key":anchor.value_key(),"prior_version":reference.version.to_string(),"parts_retained":"ownership-unproven"}))?;
+    Ok(false)
+}
diff --git a/engine/src/workers/state/adapters/sqlite/graph_automatic_recovery/grouped.rs b/engine/src/workers/state/adapters/sqlite/graph_automatic_recovery/grouped.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/graph_automatic_recovery/grouped.rs
@@ -0,0 +1,93 @@
+use super::{binding, error, need};
+use serde::Serialize;
+use serde_json::{json, Value};
+
+const INVALID:&str="STATE_GRAPH_AUTOMATIC_SOURCE_UNIT_UNPROVEN";
+const PREFIX:&str="Extract entities and relationships from these project-scoped observations:\n\n";
+#[derive(Serialize)]
+struct Audience<'a> { scope:&'static str, project:&'a str }
+#[derive(Clone,Serialize)]
+#[serde(rename_all="camelCase")]
+struct Fragment { source_id:String, source_version:Value, source_fingerprint:String, start_byte:usize, end_byte:usize, content:String }
+#[derive(Serialize)]
+struct Rendered<'a> { audience:&'a Audience<'a>, fragments:&'a [Fragment] }
+#[derive(Serialize)]
+#[serde(rename_all="camelCase")]
+struct Prompt<'a> { system_prompt:&'a str, user_prompt:&'a str }
+pub(super) struct Unit { pub id:String, pub system:String, pub prompt:String, pub next:(u64,u64,u64) }
+fn fingerprint(prefix:&str,text:&str)->String { format!("{prefix}_{}",&binding::digest(text.as_bytes())[..16]) }
+fn text<'a>(value:&'a Value)->anyhow::Result<&'a str> { value.as_str().ok_or_else(||error(INVALID)) }
+fn number(value:&Value)->anyhow::Result<usize> { usize::try_from(value.as_u64().filter(|n|*n<=9_007_199_254_740_991).ok_or_else(||error(INVALID))?).map_err(Into::into) }
+fn render(audience:&Audience<'_>,suffix:&str,fragments:&[Fragment])->anyhow::Result<String> {
+    Ok(format!("{PREFIX}{}{suffix}",serde_json::to_string(&Rendered {audience,fragments})?))
+}
+fn fits(system:&str,audience:&Audience<'_>,suffix:&str,fragments:&[Fragment])->anyhow::Result<bool> {
+    Ok(serde_json::to_vec(&Prompt {system_prompt:system,user_prompt:&render(audience,suffix,fragments)?})?.len()<=8192)
+}
+fn char_offsets(content:&str)->Vec<(usize,usize)> {
+    let mut offsets=vec![(0,0)]; let mut units=0;
+    for (byte,character) in content.char_indices() {units+=character.len_utf16();offsets.push((units,byte+character.len_utf8()));}
+    offsets
+}
+pub(super) fn unit(job_id:&str,page_index:usize,page:&Value,progress:&Value)->anyhow::Result<Unit> {
+    need(page["version"]==2 && progress["version"]==2,INVALID)?;
+    let project=text(&page["project"])?; need(!project.trim().is_empty(),INVALID)?;
+    let system=text(&progress["extractionSystem"])?;
+    let suffix=text(&progress["envelopeSuffix"])?;
+    let sources=page["sources"].as_array().filter(|sources|!sources.is_empty() && sources.len()<=12).ok_or_else(||error(INVALID))?;
+    let audience=Audience {scope:"project",project};
+    let mut fingerprints=Vec::new(); let mut rows=Vec::new(); let mut bytes=0usize;
+    let mut unique=std::collections::HashSet::new();
+    for source in sources {
+        let id=text(&source["id"])?; let content=text(&source["content"])?;
+        need(!id.is_empty() && (source["version"].as_str().is_some_and(|v|!v.is_empty()) || source["version"].as_i64().is_some_and(|v|v.unsigned_abs()<=9_007_199_254_740_991)),INVALID)?;
+        need(unique.insert(serde_json::to_string(&(id,&source["version"]))?),INVALID)?;
+        let version=source["version"].as_str().map(str::to_owned).unwrap_or_else(||source["version"].to_string());
+        bytes=bytes.checked_add(id.len()+content.len()+version.len()).ok_or_else(||error(INVALID))?;
+        need(bytes<=65536,INVALID)?;
+        let fp=fingerprint("gws",&serde_json::to_string(&(id,&source["version"],content))?);
+        rows.push(json!([id,source["version"],fp])); fingerprints.push(fp);
+    }
+    need(system.len()+PREFIX.len()+suffix.len()+project.len()<=8192 && fits(system,&audience,suffix,&[])?,INVALID)?;
+    let audience_json=serde_json::to_string(&audience)?;
+    let page_identity=format!("[{audience_json},{},{},{},{}]",serde_json::to_string(system)?,serde_json::to_string(PREFIX)?,serde_json::to_string(suffix)?,serde_json::to_string(&rows)?);
+    let page_fingerprint=fingerprint("gwpage",&page_identity);
+    let cursor=&progress["cursor"];
+    let mut index=if cursor.is_null(){0}else{number(&cursor["sourceIndex"])?};
+    let mut offset=if cursor.is_null(){0}else{number(&cursor["byteOffset"])?};
+    need(index<sources.len(),INVALID)?;
+    if !cursor.is_null() { need(cursor["pageFingerprint"]==page_fingerprint && offset<text(&sources[index]["content"])?.len(),INVALID)?; }
+    let mut fragments=Vec::new();
+    while index<sources.len() {
+        let source=&sources[index]; let content=text(&source["content"])?;
+        need(content.is_char_boundary(offset),INVALID)?;
+        let offsets=char_offsets(content); let start_units=offsets.iter().find(|(_,byte)|*byte==offset).map(|(units,_)|*units).ok_or_else(||error(INVALID))?;
+        let mut fragment=Fragment {source_id:text(&source["id"])?.to_owned(),source_version:source["version"].clone(),source_fingerprint:fingerprints[index].clone(),start_byte:offset,end_byte:offset,content:String::new()};
+        let mut candidate=fragments.clone(); candidate.push(fragment.clone());
+        let mut best=offset;
+        if fits(system,&audience,suffix,&candidate)? {
+            let mut low=start_units; let mut high=offsets.last().map(|(units,_)|*units).unwrap_or(0);
+            while low<=high {
+                let middle=low+(high-low)/2;
+                let (end_units,end_byte)=offsets.iter().rev().find(|(units,_)|*units<=middle).copied().ok_or_else(||error(INVALID))?;
+                if end_units<=start_units {low=middle+1;continue;}
+                fragment.end_byte=end_byte; fragment.content=content[offset..end_byte].to_owned();
+                *candidate.last_mut().ok_or_else(||error(INVALID))?=fragment.clone();
+                if fits(system,&audience,suffix,&candidate)? {best=end_byte;low=middle+1;} else {high=middle-1;}
+            }
+        }
+        if best==offset && content.len()>offset {need(!fragments.is_empty(),INVALID)?;break;}
+        fragment.end_byte=best; fragment.content=content[offset..best].to_owned(); fragments.push(fragment);
+        if best<content.len() {offset=best;break;}
+        index+=1;offset=0;
+    }
+    need(!fragments.is_empty(),INVALID)?;
+    let rendered=render(&audience,suffix,&fragments)?;
+    let fragment_identity=fragments.iter().map(|f|json!([f.source_id,f.source_version,f.source_fingerprint,f.start_byte,f.end_byte])).collect::<Vec<_>>();
+    let identity=format!("[{},{audience_json},{},{},{}]",serde_json::to_string(&page_fingerprint)?,serde_json::to_string(&fragment_identity)?,serde_json::to_string(system)?,serde_json::to_string(&rendered)?);
+    let unit_fingerprint=fingerprint("gwunitfp",&identity);
+    let prompt=format!("{PREFIX}{}{suffix}",fragments.iter().enumerate().map(|(i,f)|format!("[{}] Source ID: {}\n{}",i+1,f.source_id,f.content)).collect::<Vec<_>>().join("\n\n"));
+    need(serde_json::to_vec(&Prompt {system_prompt:system,user_prompt:&prompt})?.len()<=8192,INVALID)?;
+    let next=if index==sources.len(){(u64::try_from(page_index)?.checked_add(1).ok_or_else(||error(INVALID))?,0,0)}else{(u64::try_from(page_index)?,u64::try_from(index)?,u64::try_from(offset)?)};
+    Ok(Unit {id:fingerprint("graphunit",&format!("{job_id}:{page_index}:{unit_fingerprint}")),system:system.to_owned(),prompt,next})
+}
diff --git a/engine/src/workers/state/adapters/sqlite/graph_automatic_recovery/schema.sql b/engine/src/workers/state/adapters/sqlite/graph_automatic_recovery/schema.sql
