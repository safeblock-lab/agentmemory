+    run(&args).unwrap();
+    let output = database::open(&args.target).unwrap();
+    let source =
+        Connection::open_with_flags(&args.source, OpenFlags::SQLITE_OPEN_READ_ONLY).unwrap();
+    let sql = "SELECT gram,position FROM retrieval_name_grams INDEXED BY retrieval_name_grams_key WHERE epoch=1 AND key='node-7' ORDER BY gram LIMIT 11 OFFSET 1200";
+    let rows = |con: &Connection| {
+        con.prepare(sql)
+            .unwrap()
+            .query_map([], |r| Ok((r.get::<_, String>(0)?, r.get::<_, i64>(1)?)))
+            .unwrap()
+            .collect::<rusqlite::Result<Vec<_>>>()
+            .unwrap()
+    };
+    assert_eq!(rows(&source), rows(&output));
+    assert_eq!(rows(&output).len(), 11);
+    assert!(
+        output
+            .prepare(&format!("EXPLAIN QUERY PLAN {sql}"))
+            .unwrap()
+            .query_map([], |r| r.get::<_, String>(3))
+            .unwrap()
+            .any(|r| r.unwrap().contains("retrieval_name_grams_key"))
+    );
+    assert_eq!(output.query_row("SELECT key FROM state_rows INDEXED BY state_rows_order WHERE scope='scope' AND value IS NOT NULL ORDER BY position",[],|r|r.get::<_,String>(0)).unwrap(),"live");
+    assert_eq!(
+        output
+            .query_row("PRAGMA integrity_check", [], |r| r.get::<_, String>(0))
+            .unwrap(),
+        "ok"
+    );
+    drop(output);
+    drop(source);
+    let reverse = MigrationArgs {
+        source: args.target.clone(),
