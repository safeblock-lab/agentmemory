--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/canonical/source_cut.rs
@@ -0,0 +1,49 @@
+use super::*;
+use rusqlite::types::ValueRef;
+
+fn invalid()->anyhow::Error {protocol::error("STATE_TX_INVALID_REQUEST")}
+fn whitespace(bytes:&[u8],cursor:&mut usize) {while bytes.get(*cursor).is_some_and(u8::is_ascii_whitespace) {*cursor+=1;}}
+fn string(bytes:&[u8],cursor:&mut usize)->anyhow::Result<String> {
+    let mut stream=serde_json::Deserializer::from_slice(bytes.get(*cursor..).ok_or_else(invalid)?).into_iter::<String>();
+    let value=stream.next().ok_or_else(invalid)??;*cursor+=stream.byte_offset();Ok(value)
+}
+fn skip(bytes:&[u8],cursor:&mut usize)->anyhow::Result<()> {
+    let mut depth=0usize;let mut quoted=false;let mut escaped=false;let start=*cursor;
+    while let Some(&byte)=bytes.get(*cursor) {
+        if quoted {if escaped {escaped=false;}else if byte==b'\\' {escaped=true;}else if byte==b'"' {quoted=false;}}
+        else {match byte {b'"'=>quoted=true,b'['|b'{'=>depth+=1,b']'|b'}' if depth==0=>break,b']'|b'}'=>depth-=1,b',' if depth==0=>break,_=>{}}}
+        *cursor+=1;
+        if depth==0 && !quoted && matches!(byte,b']'|b'}'|b'"') {break;}
+    }
+    protocol::require(*cursor>start && !quoted && depth==0)
+}
+fn array_start(text:&str,field:&str)->anyhow::Result<usize> {
+    let bytes=text.as_bytes();let mut cursor=0;whitespace(bytes,&mut cursor);protocol::require(bytes.get(cursor)==Some(&b'{'))?;cursor+=1;
+    loop {
+        whitespace(bytes,&mut cursor);let name=string(bytes,&mut cursor)?;whitespace(bytes,&mut cursor);protocol::require(bytes.get(cursor)==Some(&b':'))?;cursor+=1;whitespace(bytes,&mut cursor);
+        if name==field {protocol::require(bytes.get(cursor)==Some(&b'['))?;return Ok(cursor+1);}
+        skip(bytes,&mut cursor)?;whitespace(bytes,&mut cursor);protocol::require(bytes.get(cursor)==Some(&b','))?;cursor+=1;
+    }
+}
+
+pub fn read(connection:&Connection,scope:&str,key:&str,offset:usize,byte_version:&str,members:usize)->anyhow::Result<(Vec<String>,usize,bool,String)> {
+    let mut statement=connection.prepare("SELECT s.value,s.value_bytes,s.version,r.row_version FROM state_values s JOIN retrieval_canonical_rows r ON r.scope=s.scope AND r.key=s.key WHERE s.scope=?1 AND s.key=?2 AND s.value IS NOT NULL")?;
+    let mut rows=statement.query(params![scope,key])?;let row=rows.next()?.ok_or_else(conflict)?;
+    let encoded=match row.get_ref(0)? {ValueRef::Blob(v)|ValueRef::Text(v)=>v,_=>return Err(invalid())};
+    let logical=usize::try_from(row.get::<_,i64>(1)?).map_err(|_|invalid())?;
+    protocol::require(logical<=super::super::super::codec::MAX_LOGICAL_VALUE_BYTES && encoded.len()<=super::super::super::codec::MAX_LOGICAL_VALUE_BYTES)?;
+    let version=row.get::<_,String>(2)?;if version!=row.get::<_,String>(3)? {return Err(conflict());}
+    let text=super::super::super::codec::decode(encoded,logical)?;drop(rows);drop(statement);
+    let start=array_start(&text,index::source_field(scope))?;let bytes=text.as_bytes();let mut cursor=start.checked_add(if version==byte_version {offset}else{0}).ok_or_else(invalid)?;
+    if version!=byte_version {for n in 0..members {
+        whitespace(bytes,&mut cursor);protocol::require(bytes.get(cursor)==Some(&b'"'))?;skip(bytes,&mut cursor)?;whitespace(bytes,&mut cursor);
+        match bytes.get(cursor) {Some(b',')=>cursor+=1,Some(b']') if n+1==members=>{},_=>return Err(invalid())}
+    }}
+    protocol::require(cursor<=bytes.len() && text.is_char_boundary(cursor))?;let mut items=Vec::with_capacity(postings::CUT);let mut done=false;
+    for _ in 0..postings::CUT {
+        whitespace(bytes,&mut cursor);if bytes.get(cursor)==Some(&b']') {done=true;break;}
+        let item=string(bytes,&mut cursor)?;protocol::require(!item.is_empty() && item.len()<=256)?;items.push(item);whitespace(bytes,&mut cursor);
+        match bytes.get(cursor) {Some(b',')=>cursor+=1,Some(b']')=>{done=true;break;},_=>return Err(invalid())}
+    }
+    Ok((items,cursor-start,done,version))
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/canonical/wire.rs b/engine/src/workers/state/adapters/sqlite/retrieval/canonical/wire.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/canonical/wire.rs
@@ -0,0 +1,86 @@
+use super::{NORMALIZATION, SCOPES, protocol};
+use serde::Deserialize;
+use serde_json::Value;
+
+#[derive(Clone, Copy, Deserialize, PartialEq)]
+#[serde(rename_all="snake_case")]
+pub enum Kind { Upsert, Evolve, Decay }
+impl Kind {
+    pub fn name(self) -> &'static str { match self { Self::Upsert=>"upsert",Self::Evolve=>"evolve",Self::Decay=>"decay" } }
+}
+
+#[derive(Deserialize)]
+#[serde(untagged)]
+pub enum ApplyRequest {Probe(Probe),Write(Apply)}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Probe {
+    pub receipt_only:bool,pub scope:String,pub partition:String,pub operation_kind:Kind,
+    pub effect_key:String,pub operation_fingerprint:String,pub target_id:String,
+    #[serde(default)]
+    pub normalized_key:Option<String>,
+}
+
+pub fn validate_request(input:&ApplyRequest)->anyhow::Result<()> {
+    match input {
+        ApplyRequest::Write(input)=>validate(input),
+        ApplyRequest::Probe(input)=>{
+            scope(&input.scope)?;digest(&input.effect_key)?;digest(&input.operation_fingerprint)?;
+            protocol::require(input.receipt_only && !input.target_id.is_empty() && input.target_id.len()<=256)?;
+            if let Some(key)=&input.normalized_key {identity(&input.scope,&input.partition,key)?;}
+            else {protocol::require(input.operation_kind==Kind::Decay && if input.scope=="mem:memories" {!input.partition.trim().is_empty() && input.partition.len()<=256} else {input.partition.is_empty()})?;}
+            Ok(())
+        }
+    }
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Apply {
+    pub scope:String,
+    pub partition:String,
+    pub normalized_key:String,
+    pub operation_kind:Kind,
+    pub canonical_id:Option<String>,
+    pub expected_row_version:String,
+    pub expected_scope_revision:String,
+    pub coverage_epoch:String,
+    pub normalization_version:String,
+    pub target_id:String,
+    pub expected_target_version:String,
+    pub effect_key:String,
+    pub operation_fingerprint:String,
+    pub value:Value,
+    #[serde(default)]
+    pub source_session_ids:Vec<String>,
+    #[serde(default)]
+    pub source_project:Option<String>,
+}
+
+pub fn scope(value:&str) -> anyhow::Result<()> { protocol::require(SCOPES.contains(&value)) }
+pub fn identity(scope_name:&str, partition:&str, normalized:&str) -> anyhow::Result<()> {
+    scope(scope_name)?;
+    protocol::require(!normalized.is_empty() && normalized.len() <= 1_048_576 && super::lowercase(normalized)==normalized)?;
+    protocol::require(if scope_name=="mem:memories" { !partition.trim().is_empty() && partition.len()<=256 } else {partition.is_empty()})
+}
+pub fn sessions(values:&[String]) -> anyhow::Result<()> {
+    protocol::require(!values.is_empty() && values.len()<=12)?;
+    for value in values { protocol::require(!value.is_empty() && value.len()<=256)?; }
+    protocol::require(values.iter().collect::<std::collections::HashSet<_>>().len()==values.len())
+}
+pub fn digest(value:&str) -> anyhow::Result<()> { protocol::require(value.len()==64 && value.bytes().all(|v|v.is_ascii_digit() || (b'a'..=b'f').contains(&v))) }
+pub fn validate(input:&Apply) -> anyhow::Result<()> {
+    if input.value.get("embeddingReuse").is_some() {protocol::require(input.operation_kind==Kind::Evolve && input.canonical_id.is_some() && input.scope=="mem:memories")?;}
+    identity(&input.scope,&input.partition,&input.normalized_key)?;
+    protocol::require(input.normalization_version==NORMALIZATION && !input.target_id.is_empty() && input.target_id.len()<=256)?;
+    if let Some(id)=&input.canonical_id { protocol::require(!id.is_empty() && id.len()<=256)?; }
+    for value in [&input.expected_row_version,&input.expected_scope_revision,&input.coverage_epoch,&input.expected_target_version] { protocol::counter(value)?; }
+    digest(&input.effect_key)?; digest(&input.operation_fingerprint)?;
+    protocol::require(protocol::size(&input.value)?<=super::super::super::MAX_ENVELOPE_BYTES-4096 && input.value.is_object())?;
+    protocol::require(input.operation_kind!=Kind::Evolve || input.scope=="mem:memories")?;
+    protocol::require(input.operation_kind!=Kind::Upsert || input.scope!="mem:memories")?;
+    if input.operation_kind==Kind::Decay { sessions(&input.source_session_ids)?; } else { protocol::require(input.source_session_ids.is_empty())?; }
+    if let Some(project)=&input.source_project { protocol::require(input.operation_kind==Kind::Decay && !project.trim().is_empty() && project.len()<=256)?; }
+    Ok(())
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/crystals/mod.rs b/engine/src/workers/state/adapters/sqlite/retrieval/crystals/mod.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/crystals/mod.rs
@@ -0,0 +1,52 @@
+mod page;
+mod prepare;
+mod projection;
+#[cfg(test)]
+mod tests;
+
+pub use page::page;
+pub use prepare::{prepare, status};
+use super::super::{database, protocol};
+use rusqlite::{params, Connection, OptionalExtension};
+use serde_json::{json, Value};
+
+const SCOPE: &str = "mem:crystals";
+const EPOCH: i64 = 1;
+const SOURCE_MAX: i64 = 1_048_576;
+
+pub fn schema(c: &Connection) -> anyhow::Result<()> {
+    c.execute_batch("DROP TRIGGER IF EXISTS crystal_insert; DROP TRIGGER IF EXISTS crystal_update; DROP TRIGGER IF EXISTS crystal_delete; CREATE TABLE IF NOT EXISTS crystal_meta(id INTEGER PRIMARY KEY CHECK(id=1),epoch INTEGER NOT NULL,identity TEXT NOT NULL,revision INTEGER NOT NULL,key_cursor TEXT NOT NULL,scanned INTEGER NOT NULL);
+        CREATE TABLE IF NOT EXISTS crystal_rows(key TEXT PRIMARY KEY,project TEXT,session_id TEXT,stamp INTEGER NOT NULL,version TEXT NOT NULL,epoch INTEGER NOT NULL) WITHOUT ROWID;
+        CREATE INDEX IF NOT EXISTS crystal_project_order ON crystal_rows(project,stamp DESC,key);
+        CREATE INDEX IF NOT EXISTS crystal_project_session_order ON crystal_rows(project,session_id,stamp DESC,key);
+        CREATE INDEX IF NOT EXISTS crystal_order ON crystal_rows(stamp DESC,key);
+        CREATE INDEX IF NOT EXISTS crystal_session_order ON crystal_rows(session_id,stamp DESC,key);
+        CREATE TABLE IF NOT EXISTS crystal_dirty(key TEXT PRIMARY KEY) WITHOUT ROWID;
+        CREATE TABLE IF NOT EXISTS crystal_issues(key TEXT PRIMARY KEY,reason TEXT NOT NULL) WITHOUT ROWID;
+        CREATE TRIGGER IF NOT EXISTS crystal_insert AFTER INSERT ON state_rows WHEN NEW.scope='mem:crystals' BEGIN INSERT INTO crystal_dirty SELECT NEW.key WHERE NOT EXISTS (SELECT 1 FROM crystal_dirty WHERE key=NEW.key); UPDATE crystal_meta SET revision=revision+1 WHERE id=1; END;
+        CREATE TRIGGER IF NOT EXISTS crystal_update AFTER UPDATE ON state_rows WHEN NEW.scope='mem:crystals' OR OLD.scope='mem:crystals' BEGIN INSERT INTO crystal_dirty SELECT NEW.key WHERE NEW.scope='mem:crystals' AND NOT EXISTS (SELECT 1 FROM crystal_dirty WHERE key=NEW.key); INSERT INTO crystal_dirty SELECT OLD.key WHERE OLD.scope='mem:crystals' AND NOT EXISTS (SELECT 1 FROM crystal_dirty WHERE key=OLD.key); UPDATE crystal_meta SET revision=revision+1 WHERE id=1; END;
+        CREATE TRIGGER IF NOT EXISTS crystal_delete AFTER DELETE ON state_rows WHEN OLD.scope='mem:crystals' BEGIN INSERT INTO crystal_dirty SELECT OLD.key WHERE NOT EXISTS (SELECT 1 FROM crystal_dirty WHERE key=OLD.key); UPDATE crystal_meta SET revision=revision+1 WHERE id=1; END;")?;
+    c.execute("INSERT OR IGNORE INTO crystal_meta VALUES(1,?1,?2,0,'',0)",params![EPOCH,uuid::Uuid::new_v4().to_string()])?;
+    Ok(())
+}
+
+pub(super) fn load(c: &Connection, key: &str, expected: Option<&str>) -> anyhow::Result<Option<(Value,String,i64)>> {
+    let metadata: Option<(String,i64,i64)> = c.query_row(
+        "SELECT version,value_bytes,stored_bytes FROM state_values WHERE scope=?1 AND key=?2 AND live=1",
+        params![SCOPE,key],|r|Ok((r.get(0)?,r.get(1)?,r.get(2)?))).optional()?;
+    let Some((version,logical,stored))=metadata else {return Ok(None);};
+    if expected.is_some_and(|v|v!=version) {return Err(protocol::error("STATE_CRYSTAL_CURSOR_STALE"));}
+    if logical<=0 || stored<=0 || logical>SOURCE_MAX || stored>SOURCE_MAX {
+        return Err(protocol::error("STATE_CRYSTAL_SOURCE_TOO_LARGE"));
+    }
+    let encoded:Vec<u8>=c.query_row("SELECT value FROM state_values WHERE scope=?1 AND key=?2 AND version=?3",params![SCOPE,key,version],|r|Ok(r.get_ref(0)?.as_bytes()?.to_vec()))?;
+    let decoded=database::decode_value(&encoded,logical).map_err(|_|protocol::error("STATE_CRYSTAL_SOURCE_INVALID"))?;
+    let value=serde_json::from_str(&decoded).map_err(|_|protocol::error("STATE_CRYSTAL_SOURCE_INVALID"))?;
+    Ok(Some((value,version,logical)))
+}
+
+pub(super) fn response(success:bool, items:&[Value], partial:bool, next:Option<String>, reason:Option<&str>) -> Value {
+    let mut result=json!({"success":success,"crystals":items,"partial":partial,"nextCursor":next,"total":null,"countScope":"page"});
+    if let Some(reason)=reason {result["reason"]=json!(reason);}
+    result
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/crystals/page.rs b/engine/src/workers/state/adapters/sqlite/retrieval/crystals/page.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/crystals/page.rs
@@ -0,0 +1,94 @@
+use super::*;
+use serde::{Deserialize,Serialize};
+use std::time::{Duration,Instant};
+
+#[derive(Deserialize,Serialize)]
+#[serde(deny_unknown_fields)]
+struct Cursor {
+    format:u8,
+    project:Option<String>,
+    session:Option<String>,
+    identity:String,
+    epoch:i64,
+    revision:String,
+    stamp:i64,
+    key:String,
+}
+
+fn encode(cursor:&Cursor) -> anyhow::Result<String> {Ok(hex::encode(serde_json::to_vec(cursor)?))}
+
+pub fn page(c:&Connection,project:Option<&str>,session:Option<&str>,cursor:Option<&str>,limit:usize,max_bytes:usize) -> anyhow::Result<Value> {
+    protocol::require((1..=16).contains(&limit) && (8192..=65536).contains(&max_bytes)
+        && project.is_none_or(|v|!v.is_empty() && v.len()<=256)
+        && session.is_none_or(|v|!v.is_empty() && v.len()<=256))?;
+    let previous:Option<Cursor>=cursor.map(|text| {
+        protocol::require(!text.is_empty() && text.len()<=8192 && text.bytes().all(|b|b.is_ascii_digit() || (b'a'..=b'f').contains(&b)))?;
+        let bytes=hex::decode(text).map_err(|_|protocol::error("STATE_TX_INVALID_REQUEST"))?;
+        serde_json::from_slice(&bytes).map_err(|_|protocol::error("STATE_TX_INVALID_REQUEST"))
+    }).transpose()?;
+    let state=status(c)?;
+    if let Some(previous)=&previous {
+        protocol::require(previous.format==1 && previous.project.as_deref()==project && previous.session.as_deref()==session
+            && !previous.key.is_empty() && previous.key.len()<=1024)?;
+        if previous.identity!=state["identity"].as_str().unwrap_or_default() || previous.epoch!=EPOCH
+            || previous.revision!=state["revision"].as_str().unwrap_or_default() {
+            return Err(protocol::error("STATE_CRYSTAL_CURSOR_STALE"));
+        }
+    }
+    if state["ready"]!=true {return Ok(response(false,&[],false,None,Some("crystal_index_preparing")));}
+    let (index,filter)=match (project.is_some(),session.is_some()) {
+        (true,true)=>("crystal_project_session_order","project=?1 AND session_id=?2"),
+        (true,false)=>("crystal_project_order","project=?1"),
+        (false,true)=>("crystal_session_order","session_id=?2"),
+        (false,false)=>("crystal_order","1=1"),
+    };
+    let mut candidates=Vec::new();
+    // Separate indexed ranges avoid scanning an ever-growing prefix on deep pages.
+    let ranges=if previous.is_some() {vec!["AND stamp=?3 AND key>?4","AND stamp<?3"]}else{vec![""]};
+    for range in ranges {
+        let remaining=limit+1-candidates.len();
+        if remaining==0 {break;}
+        let sql=format!("SELECT key,stamp,version,epoch FROM crystal_rows INDEXED BY {index} WHERE {filter} {range} ORDER BY stamp DESC,key ASC LIMIT ?5");
+        let mut statement=c.prepare(&sql)?;
+        let mut rows=statement.query(params![project,session,previous.as_ref().map(|v|v.stamp),previous.as_ref().map(|v|v.key.as_str()),remaining as i64])?;
+        while let Some(row)=rows.next()? {candidates.push((row.get::<_,String>(0)?,row.get::<_,i64>(1)?,row.get::<_,String>(2)?,row.get::<_,i64>(3)?));}
+    }
+    let start=Instant::now();
+    let mut items=Vec::new();
+    let mut next=cursor.map(str::to_owned);
+    let mut reason=(state["issues"]==true).then_some("unindexable_crystal_sources");
+    let mut more=candidates.len()>limit;
+    let mut decoded=0i64;
+    for (position,(key,stamp,version,epoch)) in candidates.iter().take(limit).enumerate() {
+        if start.elapsed()>=Duration::from_millis(25) || decoded>=SOURCE_MAX {more=true;reason=Some("crystal_query_budget_exceeded");break;}
+        if *epoch!=EPOCH {return Err(protocol::error("STATE_CRYSTAL_EPOCH_STALE"));}
+        let Some((value,_,bytes))=load(c,key,Some(version))? else {return Err(protocol::error("STATE_CRYSTAL_CURSOR_STALE"));};
+        decoded+=bytes;
+        let Some((actual_project,actual_session,actual_stamp))=projection::fields(&value,key) else {return Err(protocol::error("STATE_CRYSTAL_SOURCE_INVALID"));};
+        if actual_stamp!=*stamp || project.is_some_and(|p|Some(p)!=actual_project)
+            || session.is_some_and(|s|Some(s)!=actual_session) || value.get("deleted")==Some(&Value::Bool(true)) {
+            return Err(protocol::error("STATE_CRYSTAL_CURSOR_STALE"));
+        }
+        let candidate=encode(&Cursor{format:1,project:project.map(str::to_owned),session:session.map(str::to_owned),
+            identity:state["identity"].as_str().unwrap_or_default().into(),epoch:EPOCH,
+            revision:state["revision"].as_str().unwrap_or_default().into(),stamp:*stamp,key:key.clone()})?;
+        items.push(value);
+        let continuation=(position+1<candidates.len()).then(||candidate.clone());
+        // Reserve the longest possible stop reason while a later row can still stop the page.
+        let reserved_reason=if continuation.is_some() {Some("crystal_query_budget_exceeded")}else{reason};
+        if protocol::size(&response(true,&items,reserved_reason.is_some(),continuation,reserved_reason))?>max_bytes {
+            items.pop();
+            if items.is_empty() {
+                // Advance past an unreturnable record; never truncate canonical provenance.
+                next=Some(candidate);reason=Some("record_too_large");
+                continue;
+            }
+            more=true;reason=Some("response_byte_limit");break;
+        }
+        next=Some(candidate);
+    }
+    if !more {next=None;}
+    let result=response(true,&items,reason.is_some(),next,reason);
+    protocol::require(protocol::size(&result)?<=max_bytes)?;
+    Ok(result)
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/crystals/prepare.rs b/engine/src/workers/state/adapters/sqlite/retrieval/crystals/prepare.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/crystals/prepare.rs
@@ -0,0 +1,46 @@
+use super::*;
+use std::time::{Duration,Instant};
+
+pub fn status(c:&Connection) -> anyhow::Result<Value> {
+    let (epoch,identity,revision,key,scanned):(i64,String,i64,String,bool)=c.query_row(
+        "SELECT epoch,identity,revision,key_cursor,scanned FROM crystal_meta WHERE id=1",[],|r|Ok((r.get(0)?,r.get(1)?,r.get(2)?,r.get(3)?,r.get(4)?)))?;
+    let dirty:bool=c.query_row("SELECT EXISTS(SELECT 1 FROM crystal_dirty)",[],|r|r.get(0))?;
+    let issues:bool=c.query_row("SELECT EXISTS(SELECT 1 FROM crystal_issues)",[],|r|r.get(0))?;
+    let ready=epoch==EPOCH && scanned && !dirty;
+    Ok(json!({"target":"crystals","status":if !ready {"preparing"}else if issues {"partial"}else{"ready"},
+        "ready":ready,"epoch":epoch,"identity":identity,"revision":revision.to_string(),"keyCursor":key,
+        "scanned":scanned,"dirty":dirty,"issues":issues,"has_more":!ready}))
+}
+
+pub fn prepare(c:&Connection,max_rows:usize,max_bytes:usize,max_ms:usize) -> anyhow::Result<Value> {
+    protocol::require((1..=256).contains(&max_rows) && (1024..=1_048_576).contains(&max_bytes) && (1..=25).contains(&max_ms))?;
+    let start=Instant::now();
+    let (epoch,mut key,mut scanned):(i64,String,bool)=c.query_row("SELECT epoch,key_cursor,scanned FROM crystal_meta WHERE id=1",[],|r|Ok((r.get(0)?,r.get(1)?,r.get(2)?)))?;
+    if epoch!=EPOCH {return Err(protocol::error("STATE_CRYSTAL_EPOCH_STALE"));}
+    let mut processed=0;
+    let mut decoded=0i64;
+    let mut reason=None;
+    while processed<max_rows && start.elapsed()<Duration::from_millis(max_ms as u64) {
+        let pending:Option<String>=c.query_row("SELECT key FROM crystal_dirty ORDER BY key LIMIT 1",[],|r|r.get(0)).optional()?;
+        let is_dirty=pending.is_some();
+        let next=if is_dirty {pending} else if scanned {None} else {
+            c.query_row("SELECT key FROM state_values WHERE scope=?1 AND key>?2 ORDER BY key LIMIT 1",params![SCOPE,key],|r|r.get(0)).optional()?
+        };
+        let Some(next)=next else {scanned=true;break;};
+        let logical:i64=c.query_row("SELECT COALESCE((SELECT value_bytes FROM state_values WHERE scope=?1 AND key=?2 AND live=1),0)",params![SCOPE,next],|r|r.get(0))?;
+        // Report the required larger cut without silently losing a valid source.
+        if logical>max_bytes as i64 && logical<=SOURCE_MAX {
+            reason=Some("source_exceeds_preparation_bytes");break;
+        }
+        if logical>0 && logical<=SOURCE_MAX && decoded.saturating_add(logical)>max_bytes as i64 {break;}
+        decoded+=projection::replace(c,&next)?;
+        if !is_dirty {key=next;}
+        processed+=1;
+    }
+    c.execute("UPDATE crystal_meta SET key_cursor=?1,scanned=?2 WHERE id=1",params![key,scanned])?;
+    let mut result=status(c)?;
+    result["processed"]=json!(processed);
+    result["decodedBytes"]=json!(decoded);
+    if let Some(reason)=reason {result["reason"]=json!(reason);}
+    Ok(result)
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/crystals/projection.rs b/engine/src/workers/state/adapters/sqlite/retrieval/crystals/projection.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/crystals/projection.rs
@@ -0,0 +1,42 @@
+use super::*;
+
+pub(super) fn fields<'a>(value:&'a Value,key:&str) -> Option<(Option<&'a str>,Option<&'a str>,i64)> {
+    let object=value.as_object()?;
+    if object.get("id")?.as_str()?!=key || value.get("narrative")?.as_str().is_none() {return None;}
+    for field in ["keyOutcomes","filesAffected","lessons","sourceActionIds"] {
+        if !value.get(field)?.as_array()?.iter().all(Value::is_string) {return None;}
+    }
+    let project=match value.get("project") {None=>None,Some(v)=>Some(v.as_str()?)};
+    let session=match value.get("sessionId") {None=>None,Some(v)=>Some(v.as_str()?)};
+    if key.is_empty() || key.len()>1024 || project.is_some_and(|v|v.is_empty() || v.len()>256)
+        || session.is_some_and(|v|v.is_empty() || v.len()>256) {return None;}
+    let stamp=chrono::DateTime::parse_from_rfc3339(value.get("createdAt")?.as_str()?).ok()?.timestamp_micros();
+    Some((project,session,stamp))
+}
+
+pub(super) fn replace(c:&Connection,key:&str) -> anyhow::Result<i64> {
+    c.execute("DELETE FROM crystal_rows WHERE key=?1",[key])?;
+    c.execute("DELETE FROM crystal_issues WHERE key=?1",[key])?;
+    let mut bytes=0;
+    let result=load(c,key,None);
+    match result {
+        Ok(Some((value,version,logical)))=> {
+            bytes=logical;
+            if value.get("deleted")!=Some(&Value::Bool(true)) {
+                if let Some((project,session,stamp))=fields(&value,key) {
+                    c.execute("INSERT INTO crystal_rows VALUES(?1,?2,?3,?4,?5,?6)",params![key,project,session,stamp,version,EPOCH])?;
+                } else {issue(c,key,"invalid_crystal_source")?;}
+            }
+        }
+        Ok(None)=>{}
+        Err(cause) if cause.downcast_ref::<protocol::TxError>().is_some_and(|v|["STATE_CRYSTAL_SOURCE_TOO_LARGE","STATE_CRYSTAL_SOURCE_INVALID"].contains(&v.0))=>issue(c,key,"unreadable_crystal_source")?,
+        Err(cause)=>return Err(cause),
+    }
+    c.execute("DELETE FROM crystal_dirty WHERE key=?1",[key])?;
+    Ok(bytes)
+}
+
+fn issue(c:&Connection,key:&str,reason:&str) -> anyhow::Result<()> {
+    c.execute("INSERT INTO crystal_issues VALUES(?1,?2)",params![key,reason])?;
+    Ok(())
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/crystals/tests.rs b/engine/src/workers/state/adapters/sqlite/retrieval/crystals/tests.rs
