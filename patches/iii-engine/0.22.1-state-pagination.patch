+use super::{need, PRIVATE};
+use std::{ffi::c_void, fs::File, mem::{size_of, size_of_val, zeroed}, os::windows::io::{AsRawHandle, FromRawHandle, OwnedHandle}, ptr::{null_mut, addr_of_mut}};
+use windows_sys::Win32::{
+    Foundation::LocalFree,
+    Security::{Authorization::{GetSecurityInfo, SE_FILE_OBJECT}, GetTokenInformation, TokenUser, TOKEN_QUERY,
+        TOKEN_USER, PSID, ACL, ACE_HEADER, ACCESS_ALLOWED_ACE, ACL_SIZE_INFORMATION, GetAclInformation,
+        AclSizeInformation, GetAce, IsValidSid, EqualSid, CreateWellKnownSid,
+        WinLocalSystemSid, WinBuiltinAdministratorsSid, OWNER_SECURITY_INFORMATION, DACL_SECURITY_INFORMATION},
+    System::Threading::{GetCurrentProcess, OpenProcessToken},
+};
+#[cfg(test)]
+mod tests;
+struct Descriptor(*mut c_void);
+impl Drop for Descriptor {
+    fn drop(&mut self) { if !self.0.is_null() { unsafe { LocalFree(self.0); } } }
+}
+fn valid(value: bool) -> anyhow::Result<()> { need(value, PRIVATE) }
+
+pub(super) fn check(file: &File) -> anyhow::Result<()> {
+    inspect(file.as_raw_handle())
+}
+fn inspect(handle: windows_sys::Win32::Foundation::HANDLE) -> anyhow::Result<()> {
+    // Inspect the opened object, not a path that could name another object.
+    unsafe {
+        let mut token = null_mut();
+        valid(OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &mut token) != 0)?;
+        let token = OwnedHandle::from_raw_handle(token);
+        let mut needed = 0;
+        GetTokenInformation(token.as_raw_handle(), TokenUser, null_mut(), 0, &mut needed);
+        valid((size_of::<TOKEN_USER>() as u32..=65536).contains(&needed))?;
+        let mut user = vec![0u64; (needed as usize).div_ceil(8)];
+        valid(GetTokenInformation(token.as_raw_handle(), TokenUser, user.as_mut_ptr().cast(), needed, &mut needed) != 0)?;
+        let identity = (*user.as_ptr().cast::<TOKEN_USER>()).User.Sid;
+        valid(!identity.is_null() && IsValidSid(identity) != 0)?;
+        let mut system = [0u64; 16]; let mut administrators = [0u64; 16];
+        let mut system_bytes = size_of_val(&system) as u32;
+        let mut admin_bytes = size_of_val(&administrators) as u32;
+        valid(CreateWellKnownSid(WinLocalSystemSid, null_mut(), system.as_mut_ptr().cast(), &mut system_bytes) != 0)?;
+        valid(CreateWellKnownSid(WinBuiltinAdministratorsSid, null_mut(), administrators.as_mut_ptr().cast(), &mut admin_bytes) != 0)?;
+        let system_sid = system.as_mut_ptr().cast();
+        let administrators_sid = administrators.as_mut_ptr().cast();
+        let allowed = |sid: PSID| !sid.is_null() && IsValidSid(sid) != 0 &&
+            [identity, system_sid, administrators_sid].into_iter().any(|trusted| EqualSid(sid, trusted) != 0);
+        let mut owner: PSID = null_mut(); let mut dacl: *mut ACL = null_mut();
+        let mut descriptor = Descriptor(null_mut());
+        valid(GetSecurityInfo(handle, SE_FILE_OBJECT, OWNER_SECURITY_INFORMATION | DACL_SECURITY_INFORMATION,
+            &mut owner, null_mut(), &mut dacl, null_mut(), &mut descriptor.0) == 0)?;
+        valid(!descriptor.0.is_null() && allowed(owner) && !dacl.is_null())?;
+        let mut info: ACL_SIZE_INFORMATION = zeroed();
+        valid(GetAclInformation(dacl, addr_of_mut!(info).cast(), size_of::<ACL_SIZE_INFORMATION>() as u32, AclSizeInformation) != 0)?;
+        valid(info.AceCount <= 64 && info.AclBytesInUse >= size_of::<ACL>() as u32)?;
+        for index in 0..info.AceCount {
+            let mut ace = null_mut();
+            valid(GetAce(dacl, index, &mut ace) != 0 && !ace.is_null())?;
+            let header = &*ace.cast::<ACE_HEADER>();
+            let end = (dacl as usize).checked_add(info.AclBytesInUse as usize).ok_or_else(|| super::super::error(PRIVATE))?;
+            valid((ace as usize) >= dacl as usize && (ace as usize).checked_add(header.AceSize as usize).is_some_and(|v| v <= end))?;
+            // Object/callback/unknown ACE layouts are denied rather than guessed.
+            valid([0, 1].contains(&header.AceType) && header.AceSize as usize >= size_of::<ACCESS_ALLOWED_ACE>())?;
+            let entry = ace.cast::<ACCESS_ALLOWED_ACE>();
+            let sid: PSID = addr_of_mut!((*entry).SidStart).cast();
+            let subauthorities = *sid.cast::<u8>().add(1) as usize;
+            valid(subauthorities <= 15 && 8 + 8 + 4 * subauthorities <= header.AceSize as usize)?;
+            valid(allowed(sid))?;
+        }
+        Ok(())
+    }
+}
