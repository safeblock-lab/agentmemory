+use super::*;
+use super::super::super::{SqliteAdapter, StateAdapter};
+use rusqlite::{params, Connection};
+use std::{
+    fs,
+    path::PathBuf,
+    sync::{
+        atomic::{AtomicU64, Ordering},
+        Arc,
+    },
+    time::Instant,
+};
+
+const ROWS: usize = 4096;
+const BATCH_ROWS: usize = 64;
+const BATCH_BYTES: usize = 8 * 1024 * 1024;
+
+fn replace_vm_steps(connection: &Connection, key: &str, value: &Value, position: i64) -> u64 {
+    let steps = Arc::new(AtomicU64::new(0));
+    let callback_steps = Arc::clone(&steps);
+    connection
+        .progress_handler(1, Some(move || {
+            callback_steps.fetch_add(1, Ordering::Relaxed);
+            false
+        }))
+        .unwrap();
+    graph::replace(connection, graph::NODES, key, Some(value), Some(position), 1).unwrap();
+    connection
+        .progress_handler(0, None::<fn() -> bool>)
+        .unwrap();
+    steps.load(Ordering::Relaxed)
+}
+
+#[test]
+fn graph_replace_vm_cost_does_not_scan_existing_name_grams() {
+    let connection = fresh();
+    let target_key = "performance-node-0000";
+    let target_value = node(
+        target_key,
+        "Synthetic graph preparation concept for constant-work regression",
+        &["synthetic-observation"],
+    );
+    let transaction = connection.unchecked_transaction().unwrap();
+    graph::replace(
+        &transaction,
+        graph::NODES,
+        target_key,
+        Some(&target_value),
+        Some(0),
+        1,
+    )
+    .unwrap();
+    for position in 1..16_i64 {
+        let id = format!("performance-node-{position:04}");
+        let name = format!(
+            "Synthetic graph search concept {position:04} uses independent amber olive cobalt lexicon"
+        );
+        let value = node(&id, &name, &["synthetic-observation"]);
+        graph::replace(
+            &transaction,
+            graph::NODES,
+            &id,
+            Some(&value),
+            Some(position),
+            1,
+        )
+        .unwrap();
+    }
+    transaction.commit().unwrap();
+    let small_index_steps = replace_vm_steps(&connection, target_key, &target_value, 0);
+
+    let transaction = connection.unchecked_transaction().unwrap();
+    for position in 16..256_i64 {
+        let id = format!("performance-node-{position:04}");
+        let name = format!(
+            "Synthetic graph search concept {position:04} uses independent amber olive cobalt lexicon"
+        );
+        let value = node(&id, &name, &["synthetic-observation"]);
+        graph::replace(
+            &transaction,
+            graph::NODES,
+            &id,
+            Some(&value),
+            Some(position),
+            1,
+        )
+        .unwrap();
+    }
+    transaction.commit().unwrap();
+    let large_index_steps = replace_vm_steps(&connection, target_key, &target_value, 0);
+
+    assert!(small_index_steps > 0);
+    assert!(
+        large_index_steps < small_index_steps * 3,
+        "graph replacement VM work scaled from {small_index_steps} to {large_index_steps} steps"
+    );
+}
+
+fn output_dir() -> PathBuf {
+    let path = PathBuf::from(env!("CARGO_MANIFEST_DIR"))
+        .ancestors()
+        .nth(3)
+        .unwrap()
+        .join(".native-pagination-build/native-preparation-performance");
+    fs::create_dir_all(&path).unwrap();
+    path
+}
+
+fn explain(connection: &Connection, sql: &str) -> Vec<String> {
+    let mut statement = connection
+        .prepare(&format!("EXPLAIN QUERY PLAN {sql}"))
+        .unwrap();
+    let parameters = vec![rusqlite::types::Value::Null; statement.parameter_count()];
+    statement
+        .query_map(rusqlite::params_from_iter(parameters), |row| {
+            row.get::<_, String>(3)
+        })
+        .unwrap()
+        .map(Result::unwrap)
+        .collect()
+}
+
+fn seed_synthetic_graph(connection: &Connection) {
+    let transaction = connection.unchecked_transaction().unwrap();
+    transaction
+        .execute(
+            "INSERT INTO state_scopes(scope,revision,next_position) VALUES(?1,?2,?3)",
+            params![graph::NODES, ROWS.to_string(), ROWS as i64],
+        )
+        .unwrap();
+    let mut insert = transaction
+        .prepare_cached("INSERT INTO state_rows VALUES(?1,?2,?3,'1',?4,?5)")
+        .unwrap();
+    for position in 0..ROWS {
+        let id = format!("synthetic-node-{position:05}");
+        let name = format!("Synthetic graph preparation concept {position:05} index scaling");
+        let value = node(&id, &name, &["synthetic-observation"]);
+        let raw = serde_json::to_string(&value).unwrap();
+        insert
+            .execute(params![graph::NODES, id, raw, position as i64, raw.len() as i64])
+            .unwrap();
+    }
+    drop(insert);
+    metadata::initialize_graph(&transaction, graph::NODES).unwrap();
+    transaction.commit().unwrap();
+}
+
+#[tokio::test]
+#[ignore = "bounded synthetic SQLite preparation growth diagnostic"]
+async fn indexed_prepare_growth_diagnostic() {
+    let probe_id = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .unwrap()
+        .as_millis();
+    let path = output_dir().join(format!("synthetic-baseline-{probe_id}.sqlite3"));
+    let adapter = SqliteAdapter::new(Some(serde_json::json!({
+        "file_path": path.display().to_string()
+    })))
+    .unwrap();
+    let connection = database::open_for_migration(&path).unwrap();
+    seed_synthetic_graph(&connection);
+
+    let prepare_plan = explain(
+        &connection,
+        "SELECT key,position,json_object('id',json_extract(value,'$.id'),'name',json_extract(value,'$.name'),'stale',COALESCE(json_extract(value,'$.stale'),json('false')),'sourceObservationIds',json_extract(value,'$.sourceObservationIds')) FROM state_rows INDEXED BY state_rows_order WHERE scope=?1 AND value IS NOT NULL AND position>?2 ORDER BY position LIMIT ?3",
+    );
+    let gram_delete_plan = explain(
+        &connection,
+        "DELETE FROM retrieval_name_grams WHERE epoch=?1 AND key=?2",
+    );
+    let membership_delete_plan = explain(
+        &connection,
+        "DELETE FROM retrieval_membership WHERE epoch=?1 AND key=?2",
+    );
+
+    let mut elapsed_ms = Vec::new();
+    let mut processed_rows = 0usize;
+    loop {
+        let started = Instant::now();
+        let result = StateAdapter::retrieval(
+            &adapter,
+            serde_json::json!({
+                "action":"index_prepare",
+                "scope":graph::NODES,
+                "max_rows":BATCH_ROWS,
+                "max_bytes":BATCH_BYTES
+            }),
+        )
+        .await
+        .unwrap();
+        let millis = started.elapsed().as_secs_f64() * 1000.0;
+        processed_rows += result["processed"].as_u64().unwrap() as usize;
+        let done = result["status"] == "ready";
+        elapsed_ms.push(millis);
+        if done {
+            break;
+        }
+    }
+    let db_bytes = fs::metadata(&path).unwrap().len();
+    assert_eq!(processed_rows, ROWS);
+    let report = serde_json::json!({
+        "rows": ROWS,
+        "processed_rows": processed_rows,
+        "batch_rows": BATCH_ROWS,
+        "batches": elapsed_ms.len(),
+        "first_8_batch_ms": &elapsed_ms[..8.min(elapsed_ms.len())],
+        "last_8_batch_ms": &elapsed_ms[elapsed_ms.len().saturating_sub(8)..],
+        "mean_first_8_ms": elapsed_ms.iter().take(8).sum::<f64>() / 8.0,
+        "mean_last_8_ms": elapsed_ms.iter().rev().take(8).sum::<f64>() / 8.0,
+        "sqlite_bytes": db_bytes,
+        "prepare_query_plan": prepare_plan,
+        "gram_delete_query_plan": gram_delete_plan,
+        "membership_delete_query_plan": membership_delete_plan,
+        "retrieval_rows": connection.query_row("SELECT count(*) FROM retrieval_nodes", [], |r| r.get::<_, i64>(0)).unwrap(),
+        "gram_rows": connection.query_row("SELECT count(*) FROM retrieval_name_grams", [], |r| r.get::<_, i64>(0)).unwrap(),
+        "membership_rows": connection.query_row("SELECT count(*) FROM retrieval_membership", [], |r| r.get::<_, i64>(0)).unwrap(),
+        "index_status": prepare::prepare(&connection, graph::NODES, 1, BATCH_BYTES).unwrap()["status"],
+    });
+    let report_path = output_dir().join(format!("synthetic-baseline-{probe_id}.json"));
+    fs::write(&report_path, serde_json::to_vec_pretty(&report).unwrap()).unwrap();
+    eprintln!("PREPARATION_DIAGNOSTIC={}", report_path.display());
+    eprintln!("PREPARATION_DIAGNOSTIC_RESULT={report}");
+}
