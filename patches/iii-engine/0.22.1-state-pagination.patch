+#[test]
+fn project_catalog_unknowns_reports_size_encoding_json_and_authority_reasons() {
+    let connection = fresh();
+    unknown_summary(
+        &connection,
+        "invalid-json",
+        json!({"sessionId":"session-json","body":"private"}),
+    );
+    unknown_summary(
+        &connection,
+        "invalid-compression",
+        json!({"sessionId":"session-compression","body":"private"}),
+    );
+    unknown_summary(
+        &connection,
+        "invalid-authority",
+        json!({"sessionId":42,"project":"private-project"}),
+    );
+    unknown_summary(
+        &connection,
+        "missing-authority",
+        json!({"sessionId":"session-missing","body":"private"}),
+    );
+    unknown_summary(
+        &connection,
+        "oversized",
+        json!({"sessionId":"session-large","body":"x".repeat(70_000)}),
+    );
+    replace_raw_summary(&connection, "invalid-json", b"{notjson", 8);
+    let mut invalid_compression = b"\x89AMV2Z\x01".to_vec();
+    invalid_compression.extend_from_slice(b"broken");
+    replace_raw_summary(&connection, "invalid-compression", &invalid_compression, 32);
+
+    let page = diagnostics(&connection, "summaries", None, 16, 65_536).unwrap();
+    let reasons: std::collections::HashMap<_, _> = page["items"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .map(|item| {
+            (
+                item["key"].as_str().unwrap().to_owned(),
+                item["reason"].as_str().unwrap().to_owned(),
+            )
+        })
+        .collect();
+    assert_eq!(reasons["invalid-json"], "invalid_json");
+    assert_eq!(reasons["invalid-compression"], "invalid_compression");
+    assert_eq!(reasons["invalid-authority"], "invalid_authority");
+    assert_eq!(reasons["missing-authority"], "missing_authority");
+    assert_eq!(reasons["oversized"], "oversized");
+    let oversized = page["items"]
+        .as_array()
