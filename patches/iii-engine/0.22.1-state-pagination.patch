+++ b/engine/src/workers/state/adapters/sqlite/graph_automatic_recovery/terminal.rs
@@ -0,0 +1,463 @@
+use super::{adoption, authority, binding, grouped, need, policy, store, wire::{Anchor, Binding, TerminalAnchor}, CAPABILITY, error};
+use super::super::{commit, database, protocol::{self, Checkpoint, JOBS}};
+use rusqlite::{params, Connection, OptionalExtension};
+use serde_json::{json, Value};
+use std::path::Path;
+
+const UNPROVEN:&str="STATE_GRAPH_AUTOMATIC_SOURCE_UNIT_UNPROVEN";
+const SCOPE:&str="STATE_GRAPH_AUTOMATIC_SCOPE_UNPROVEN";
+const SOURCE_PROOF_REVISION:&str="applied-receipt-postcommit-v1";
+fn reason(cause:&anyhow::Error)->&'static str {
+    match cause.downcast_ref::<protocol::TxError>().map(|cause|cause.0) {
+        Some("STATE_GRAPH_AUTOMATIC_SCOPE_UNPROVEN")=>"GRAPH_AUTOMATIC_SCOPE_UNPROVEN",
+        Some("STATE_GRAPH_AUTOMATIC_SOURCE_UNIT_UNPROVEN")=>"GRAPH_AUTOMATIC_SOURCE_UNIT_UNPROVEN",
+        Some("STATE_GRAPH_AUTOMATIC_SOURCE_INCOMPLETE")=>"GRAPH_AUTOMATIC_SOURCE_INCOMPLETE",
+        Some("STATE_GRAPH_AUTOMATIC_SOURCE_CHANGED")=>"GRAPH_AUTOMATIC_SOURCE_CHANGED",
+        Some("STATE_GRAPH_AUTOMATIC_SOURCE_LIMIT"|"STATE_RETRIEVAL_RESOURCE_LIMIT"|"STATE_TX_LIMIT_EXCEEDED"|"STATE_RECORD_TOO_LARGE")=>"GRAPH_AUTOMATIC_SOURCE_LIMIT",
+        _=>"GRAPH_AUTOMATIC_BINDING_INCOMPATIBLE",
+    }
+}
+fn string<'a>(value:&'a Value,code:&'static str)->anyhow::Result<&'a str> {value.as_str().filter(|value|!value.is_empty()).ok_or_else(||error(code))}
+fn ordinal(value:&Value)->anyhow::Result<u64> {value.as_u64().filter(|value|*value<9_007_199_254_740_991).ok_or_else(||error(UNPROVEN))}
+fn sql_counter(value:u64)->anyhow::Result<i64> {i64::try_from(value).map_err(|_|error("STATE_TX_LIMIT_EXCEEDED"))}
+pub(super) fn capture(connection:&Connection,anchor:&Anchor,job:&Value)->anyhow::Result<Value> {
+    binding::source_capture(connection,anchor,job)?;
+    let mut text=String::new();
+    for part in 0..job["captureParts"].as_u64().ok_or_else(||error(UNPROVEN))? {
+        let row=database::row(connection,&format!("mem:graph:inputs:{}",anchor.job_id),&format!("capture:{part}"))?;
+        text.push_str(row.value.as_ref().and_then(Value::as_str).ok_or_else(||error(UNPROVEN))?);
+    }
+    protocol::strict_value(&text).map_err(|_|error(UNPROVEN))
+}
+fn normalized(mut capture:Value)->anyhow::Result<Value> {
+    let object=capture.as_object_mut().ok_or_else(||error(UNPROVEN))?;
+    object.remove("graphJobId");object.remove("replacementOf"); Ok(capture)
+}
+fn receipt(connection:&Connection,generation:&str,job:&str,delta:u64,chunk:u64,version:&str)->anyhow::Result<()> {
+    let identity=json!({"generation":generation,"job_id":job,"logical_delta_id":format!("delta:{delta}"),"chunk_ordinal":chunk});
+    let key=serde_json::to_string(&(generation,job,format!("delta:{delta}"),chunk))?;
+    let row=database::row(connection,database::RECEIPT_SCOPE,&key)?;
+    let value=row.value.ok_or_else(||error(UNPROVEN))?;
+    need(value["identity"]==identity && value["checkpoint_version"]==version
+        && value["payload_digest"].as_str().is_some_and(|digest|digest.len()==64 && digest.bytes().all(|b|b.is_ascii_hexdigit()))
+        && value["row_versions"].is_array(),UNPROVEN)
+}
+pub(super) fn applied(connection:&Connection,anchor:&Anchor,manifest:&Value,checkpoint:&Checkpoint,checkpoint_version:&str)->anyhow::Result<()> {
+    let count=ordinal(&manifest["templateCount"])?; need(count>0,UNPROVEN)?;
+    let chunk=ordinal(&manifest["applyOrdinal"])?.checked_add(count-1).ok_or_else(||error(UNPROVEN))?;
+    let next_chunk=chunk.checked_add(1).ok_or_else(||error(UNPROVEN))?;
+    let version=protocol::counter(string(&manifest["applyCheckpointVersion"],UNPROVEN)?)?.checked_add(count).ok_or_else(||error(UNPROVEN))?;
+    let generation=anchor.source_generation.as_deref().unwrap_or(&anchor.guard.generation);
+    need(checkpoint.delta_ordinal>anchor.delta_ordinal || checkpoint.delta_ordinal==anchor.delta_ordinal
+        && checkpoint.visibility=="complete" && checkpoint.next_chunk_ordinal==next_chunk && protocol::counter(checkpoint_version)?==version,UNPROVEN)?;
+    need(protocol::counter(checkpoint_version)?>=version && manifest.get("result").is_some(),UNPROVEN)?;
+    receipt(connection,generation,&anchor.job_id,anchor.delta_ordinal,chunk,&version.to_string())
+}
+fn selected(connection:&Connection,anchor:&Anchor,job:&Value,input:&Value)->anyhow::Result<Value> {
+    let mut selection=job.get("selectedOrigin").cloned().unwrap_or(Value::Null);
+    if selection.is_null() {
+        if let Some((_,proof))=lineage(connection,&anchor.job_id)? {selection=proof["selection"].clone();}
+    }
+    if selection.is_null() {return Ok(selection);}
+    let project=string(&selection["project"],SCOPE)?;let session=string(&selection["sessionId"],SCOPE)?;
+    let fingerprint=string(&selection["sourceFingerprint"],SCOPE)?;
+    if job.get("selectedOrigin").is_some() {
+        need(job["captureDigest"]==fingerprint && input["sessionId"]==session && input["graphWorkGroupsVersion"]==2,SCOPE)?;
+        let intent_id=string(&selection["intentId"],SCOPE)?;
+        need(selection["jobId"]==anchor.job_id,SCOPE)?;
+        let intent=database::row(connection,"mem:graph-dispatch:intents",intent_id)?.value.ok_or_else(||error(SCOPE))?;
+        need(intent["version"]==1 && intent["id"]==intent_id && intent["jobId"]==anchor.job_id
+            && intent["digest"]==fingerprint && intent["captureParts"]==job["captureParts"] && intent["executionOrigin"]=="selected",SCOPE)?;
+    }
+    let session_row=database::row(connection,"mem:sessions",session)?.value.ok_or_else(||error(SCOPE))?;
+    need(session_row["project"]==project && input["sessionId"]==session,SCOPE)?;
+    let observations=input["observations"].as_array().filter(|items|!items.is_empty()).ok_or_else(||error(SCOPE))?;
+    for observation in observations {
+        need(observation["sessionId"]==session,SCOPE)?;
+        let current=database::row(connection,&format!("mem:obs:{session}"),string(&observation["id"],SCOPE)?)?.value.ok_or_else(||error(SCOPE))?;
+        let fields=observation.as_object().ok_or_else(||error(SCOPE))?;
+        need(fields.iter().all(|(key,value)|current.get(key)==Some(value)),SCOPE)?;
+    }
