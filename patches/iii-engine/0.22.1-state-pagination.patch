+use super::*;
+use rkyv::{Archive, Serialize as RkyvSerialize};
+
+#[derive(Archive, RkyvSerialize)]
+struct KeyStorage(String);
+fn fixture(json: &str) -> (tempfile::TempDir, MigrationArgs) {
+    let root = std::env::var_os("III_SQLITE_TEST_ROOT").expect("III_SQLITE_TEST_ROOT required");
+    let directory = tempfile::tempdir_in(root).unwrap();
+    let source = directory.path().join("legacy");
+    fs::create_dir(&source).unwrap();
+    fs::write(
+        source.join("mem%3Agraph%3Anodes.bin"),
+        rkyv::to_bytes::<rkyv::rancor::Error>(&KeyStorage(json.into())).unwrap(),
+    )
+    .unwrap();
+    let args = MigrationArgs {
+        source,
+        target: directory.path().join("shadow.sqlite3"),
+        disk_budget_bytes: 128 * 1024 * 1024,
+        reverse: false,
+    };
+    (directory, args)
+}
+fn rows(args: &MigrationArgs) -> Vec<(String, String)> {
+    let connection = database::open(&args.target).unwrap();
+    connection
+        .prepare("SELECT key,state_json(value,value_bytes) FROM state_rows WHERE scope='mem:graph:nodes' ORDER BY position")
+        .unwrap()
+        .query_map([], |r| Ok((r.get(0)?, r.get(1)?)))
+        .unwrap()
+        .collect::<rusqlite::Result<_>>()
+        .unwrap()
+}
+
+#[test]
+fn migration_order_values_scope_and_immutable_source() {
+    let (_dir, args) = fixture(r#"{"z":null,"ñ":{"x":"😀","n":1.5},"a":[false,3]}"#);
+    let before = manifest(&fs::canonicalize(&args.source).unwrap()).unwrap();
+    let result = run(&args).unwrap();
+    assert_eq!(result.records, 3);
+    assert_eq!(
+        rows(&args),
+        vec![
+            ("z".into(), "null".into()),
+            ("ñ".into(), r#"{"n":1.5,"x":"😀"}"#.into()),
+            ("a".into(), "[false,3]".into())
+        ]
+    );
+    assert_eq!(
+        manifest(&fs::canonicalize(&args.source).unwrap()).unwrap(),
+        before
+    );
+    assert_eq!(run(&args).unwrap().records, 3);
+}
+
+#[test]
+fn migration_inline_empty_scope() {
+    let (_dir, args) = fixture("{}");
+    assert_eq!(run(&args).unwrap().records, 0);
+    assert!(rows(&args).is_empty());
+}
+
+#[test]
+fn migration_interruption_checkpoint_and_resume() {
+    let (_dir, args) = fixture(r#"{"b":1,"a":2,"c":3}"#);
+    assert!(
+        run_segment(&args, Some(2), None)
+            .unwrap_err()
+            .to_string()
+            .contains("interruption")
+    );
+    let prior = archive::file_digest(&args.target).unwrap();
+    assert!(
+        database::open(&args.target)
+            .unwrap_err()
+            .to_string()
+            .contains("INCOMPLETE")
+    );
+    assert_eq!(archive::file_digest(&args.target).unwrap(), prior);
+    let connection =
+        Connection::open_with_flags(&args.target, OpenFlags::SQLITE_OPEN_READ_ONLY).unwrap();
+    assert_eq!(
+        connection
+            .query_row("SELECT ordinal FROM state_migration_scopes", [], |r| r
+                .get::<_, i64>(0))
+            .unwrap(),
+        2
+    );
+    drop(connection);
+    assert_eq!(run(&args).unwrap().records, 3);
+    assert_eq!(
+        rows(&args).iter().map(|r| r.0.as_str()).collect::<Vec<_>>(),
+        ["b", "a", "c"]
+    );
+}
+
+#[test]
+fn migration_changed_source_rejects_resume() {
+    let (_dir, args) = fixture(r#"{"b":1,"a":2}"#);
+    assert!(run_segment(&args, Some(1), None).is_err());
+    fs::write(
+        args.source.join("mem%3Agraph%3Anodes.bin"),
+        rkyv::to_bytes::<rkyv::rancor::Error>(&KeyStorage(r#"{"b":9,"a":2}"#.into())).unwrap(),
+    )
+    .unwrap();
+    assert!(
+        run(&args).unwrap_err().to_string().contains("identity")
+            || run(&args).unwrap_err().to_string().contains("manifest")
+    );
+    assert!(database::open(&args.target).is_err());
+}
+
+#[test]
+fn migration_corrupt_archives_and_duplicate_keys_never_ready() {
+    for json in [r#"{"a":1,"a":2}"#, "[]", r#"{"a":1}{}"#] {
+        let (_dir, args) = fixture(json);
+        assert!(run(&args).is_err());
+        assert!(database::open(&args.target).is_err());
+    }
+    let (_dir, args) = fixture(r#"{"long-enough":1}"#);
+    let path = args.source.join("mem%3Agraph%3Anodes.bin");
+    let mut bytes = fs::read(&path).unwrap();
+    let end = bytes.len();
+    bytes[end - 4..].copy_from_slice(&1i32.to_le_bytes());
+    fs::write(path, bytes).unwrap();
+    assert!(run(&args).is_err());
+    assert!(database::open(&args.target).is_err());
+}
+
+#[test]
+fn migration_target_boundaries_budget_and_existing_database() {
+    let (_dir, mut args) = fixture("{}");
+    args.target = args.source.join("bad.sqlite3");
+    assert!(run(&args).is_err());
+    assert!(!args.target.exists());
+    args.target = args.source.parent().unwrap().join("unrelated.sqlite3");
+    let connection = Connection::open(&args.target).unwrap();
+    connection
+        .execute_batch(
+            "CREATE TABLE unrelated(value TEXT); INSERT INTO unrelated VALUES('retained')",
+        )
+        .unwrap();
+    drop(connection);
+    let before = archive::file_digest(&args.target).unwrap();
+    assert!(run(&args).is_err());
+    assert_eq!(archive::file_digest(&args.target).unwrap(), before);
+    args.target = args.source.parent().unwrap().join("budget.sqlite3");
+    args.disk_budget_bytes = 1;
+    assert!(run(&args).is_err());
+    assert!(!args.target.exists());
+}
+
+#[test]
+fn migration_sqlite_full_rolls_back_and_can_resume() {
+    let json = format!("{{\"a\":\"{}\",\"b\":1}}", "x".repeat(1024 * 1024));
+    let (_dir, args) = fixture(&json);
+    assert!(
+        run_segment(&args, None, Some(16))
+            .unwrap_err()
+            .to_string()
+            .contains("full")
+    );
+    assert!(database::open(&args.target).is_err());
+    let connection = Connection::open(&args.target).unwrap();
+    assert_eq!(
+        connection
+            .query_row(
+                "SELECT count(*) FROM state_rows WHERE scope='mem:graph:nodes'",
+                [],
+                |r| r.get::<_, i64>(0)
+            )
+            .unwrap(),
+        0
+    );
+    drop(connection);
+    assert_eq!(run(&args).unwrap().records, 2);
+}
+
+#[test]
+fn migration_concurrent_importer_lock_released_on_drop() {
+    let (_dir, args) = fixture("{}");
+    let lock = importer_lock(&args.target).unwrap();
+    assert!(run(&args).unwrap_err().to_string().contains("importer"));
+    drop(lock);
+    assert!(run(&args).is_ok());
+}
+
+#[test]
+fn migration_multiple_batches_reconcile_ordered_content() {
+    let mut json = String::from("{");
+    for index in 0..1025 {
+        if index > 0 {
+            json.push(',');
+        }
+        json.push_str(&format!("\"key-{index}\":{{\"value\":{index}}}"));
+    }
+    json.push('}');
+    let (_dir, args) = fixture(&json);
+    assert!(run_segment(&args, Some(513), None).is_err());
+    assert_eq!(run(&args).unwrap().records, 1025);
+    assert_eq!(rows(&args).last().unwrap().0, "key-1024");
+}
+
+#[test]
+fn migration_record_quota_rejects_before_value_callback() {
+    let (_dir, args) = fixture(&format!("{{\"oversized\":\"{}\"}}", "x".repeat(1024)));
+    let mut effects = 0;
+    let error = archive::visit_bounded(&args.source.join("mem%3Agraph%3Anodes.bin"), 64, |_, _| {
+        effects += 1;
+        Ok(())
+    })
+    .unwrap_err();
+    assert!(
+        error
+            .to_string()
+            .contains("STATE_MIGRATION_RECORD_TOO_LARGE")
+    );
+    assert_eq!(effects, 0);
+    assert!(!args.target.exists());
+}
+
+#[test]
+fn migration_resume_initial_marker_and_ready_marker_crash_boundaries() {
+    for initial_empty_database in [false, true] {
+        let (_dir, args) = fixture(r#"{"a":1}"#);
+        let input = manifest(&fs::canonicalize(&args.source).unwrap()).unwrap();
+        let mut pending = args.target.as_os_str().to_owned();
+        pending.push(".migration-pending");
+        let pending = PathBuf::from(pending);
+        fs::write(&pending, serde_json::to_vec(&input).unwrap()).unwrap();
+        if initial_empty_database {
+            drop(Connection::open(&args.target).unwrap());
+        }
+        assert_eq!(run(&args).unwrap().records, 1);
+        assert!(!pending.exists());
+        let before = rows(&args);
+        fs::write(&pending, serde_json::to_vec(&input).unwrap()).unwrap();
+        assert!(database::open(&args.target).is_err());
+        assert_eq!(run(&args).unwrap().records, 1);
+        assert!(!pending.exists());
+        assert_eq!(rows(&args), before);
+    }
+}
+
+#[test]
+fn migration_pending_metadata_refusal_does_not_write_without_sidecar() {
+    let (_dir, args) = fixture(r#"{"a":1,"b":2}"#);
+    assert!(run_segment(&args, Some(1), None).is_err());
+    let mut pending = args.target.as_os_str().to_owned();
+    pending.push(".migration-pending");
+    fs::remove_file(PathBuf::from(pending)).unwrap();
+    let before = archive::file_digest(&args.target).unwrap();
+    assert!(
+        database::open(&args.target)
+            .unwrap_err()
+            .to_string()
+            .contains("INCOMPLETE")
+    );
+    assert_eq!(archive::file_digest(&args.target).unwrap(), before);
+    let connection =
+        Connection::open_with_flags(&args.target, OpenFlags::SQLITE_OPEN_READ_ONLY).unwrap();
+    assert_eq!(
+        connection
+            .query_row(
+                "SELECT version FROM state_rows WHERE scope=?1 AND key='current'",
+                [database::CONTROL_SCOPE],
+                |r| r.get::<_, String>(0)
+            )
+            .unwrap(),
+        "1"
+    );
+}
diff --git a/engine/src/state_migration/transfer.rs b/engine/src/state_migration/transfer.rs
new file mode 100644
index 0000000..fe17f77
--- /dev/null
+++ b/engine/src/state_migration/transfer.rs
@@ -0,0 +1,161 @@
+use super::{Manifest, SourceFile, archive};
+use crate::workers::state::adapters::sqlite::{codec, database};
+use anyhow::{Context, ensure};
+use rusqlite::{Connection, OptionalExtension, params};
+use sha2::{Digest, Sha256};
+use std::{fs, path::Path};
+
+pub fn scope(
+    connection: &mut Connection,
+    source: &Path,
+    file: &SourceFile,
+    target: &Path,
+    budget: u64,
+    stop_after: Option<u64>,
+) -> anyhow::Result<u64> {
+    let path = source.join(&file.name);
+    ensure!(
+        archive::file_digest(&path)? == file.sha256,
+        "Frozen source scope changed"
+    );
+    let checkpoint: Option<(i64, String)> = connection
+        .query_row(
+            "SELECT ordinal,digest FROM state_migration_scopes WHERE scope=?1",
+            [&file.scope],
+            |r| Ok((r.get(0)?, r.get(1)?)),
+        )
+        .optional()?;
+    let (skip, prefix) = checkpoint.unwrap_or((0, format!("{:x}", Sha256::new().finalize())));
+    let skip = u64::try_from(skip).context("Invalid negative checkpoint ordinal")?;
+    let mut hash = Sha256::new();
+    let mut ordinal = 0u64;
+    let mut batch_rows = 0u64;
+    let mut batch_bytes = 0usize;
+    connection.execute_batch("BEGIN IMMEDIATE")?;
+    let result = archive::visit(&path, |key, value| {
+        let serialized = serde_json::to_string(&value)?;
+        archive::content_digest(&mut hash, &key, &serialized);
+        ordinal = ordinal.checked_add(1).context("Record count overflow")?;
+        ensure!(
+            ordinal <= 9_007_199_254_740_990,
+            "Migration record position exceeds supported state range"
+        );
+        if ordinal <= skip {
+            if ordinal == skip {
+                ensure!(
+                    format!("{:x}", hash.clone().finalize()) == prefix,
+                    "Checkpoint prefix does not match source"
+                );
+            }
+            return Ok(());
+        }
+        let duplicate: bool = connection.query_row(
+            "SELECT EXISTS(SELECT 1 FROM state_rows WHERE scope=?1 AND key=?2)",
+            params![file.scope, key],
+            |r| r.get(0),
+        )?;
+        ensure!(!duplicate, "Duplicate key or shadow content conflict");
+        let encoded = codec::encode(&serialized)?;
+        connection.execute("INSERT INTO state_rows(scope,key,value,version,position,value_bytes) VALUES(?1,?2,?3,'1',?4,?5)",
+            params![file.scope,key,encoded,i64::try_from(ordinal-1)?, i64::try_from(serialized.len())?])?;
+        batch_rows += 1;
+        batch_bytes = batch_bytes
+            .saturating_add(key.len())
+            .saturating_add(serialized.len());
+        if batch_rows >= 256
+            || batch_bytes >= 4 * 1024 * 1024
+            || stop_after.is_some_and(|limit| ordinal >= limit)
+        {
+            checkpoint_scope(connection, file, ordinal, &hash, false)?;
+            connection.execute_batch("COMMIT")?;
+            check_budget(target, budget)?;
+            if stop_after.is_some_and(|limit| ordinal >= limit) {
+                anyhow::bail!("Synthetic segment interruption at durable checkpoint");
+            }
+            connection.execute_batch("PRAGMA wal_checkpoint(TRUNCATE); BEGIN IMMEDIATE")?;
+            batch_rows = 0;
+            batch_bytes = 0;
+        }
+        Ok(())
+    });
+    if let Err(error) = result {
+        if !connection.is_autocommit() {
+            connection.execute_batch("ROLLBACK")?;
+        }
+        return Err(error);
+    }
+    ensure!(ordinal >= skip, "Checkpoint exceeds source scope");
+    ensure!(
+        archive::file_digest(&path)? == file.sha256,
+        "Frozen source changed during scope import"
+    );
+    checkpoint_scope(connection, file, ordinal, &hash, true)?;
+    connection.execute_batch("COMMIT; PRAGMA wal_checkpoint(TRUNCATE)")?;
+    check_budget(target, budget)?;
+    Ok(ordinal)
+}
+
+fn checkpoint_scope(
+    connection: &Connection,
+    file: &SourceFile,
+    ordinal: u64,
+    hash: &Sha256,
+    complete: bool,
+) -> anyhow::Result<()> {
+    let digest = format!("{:x}", hash.clone().finalize());
+    connection.execute("INSERT INTO state_migration_scopes VALUES(?1,?2,?3,?4) ON CONFLICT(scope) DO UPDATE SET ordinal=excluded.ordinal,digest=excluded.digest,complete=excluded.complete",
+        params![file.scope,i64::try_from(ordinal)?,digest,complete])?;
+    connection.execute("INSERT INTO state_scopes VALUES(?1,?2,?3) ON CONFLICT(scope) DO UPDATE SET revision=excluded.revision,next_position=excluded.next_position",
+        params![file.scope,ordinal.to_string(),i64::try_from(ordinal)?])?;
+    Ok(())
+}
+
+pub(super) fn check_budget(target: &Path, budget: u64) -> anyhow::Result<()> {
+    let mut wal = target.as_os_str().to_owned();
+    wal.push("-wal");
+    let bytes = fs::metadata(target)?
+        .len()
+        .checked_add(match fs::metadata(Path::new(&wal)) {
+            Ok(metadata) => metadata.len(),
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => 0,
+            Err(error) => return Err(error.into()),
+        })
+        .context("Target size overflow")?;
+    ensure!(
+        bytes <= budget,
+        "Shadow target exceeded reserved disk budget; source retained and target remains unavailable"
+    );
+    Ok(())
+}
+
+pub fn reconcile(connection: &Connection, input: &Manifest) -> anyhow::Result<()> {
+    for file in &input.files {
+        let (count, digest, complete): (i64, String, bool) = connection.query_row(
+            "SELECT ordinal,digest,complete FROM state_migration_scopes WHERE scope=?1",
+            [&file.scope],
+            |r| Ok((r.get(0)?, r.get(1)?, r.get(2)?)),
+        )?;
+        let count = u64::try_from(count).context("Invalid negative reconciliation count")?;
+        ensure!(complete, "Scope checkpoint incomplete");
+        let mut query = connection.prepare(
+            "SELECT key,value,position,value_bytes FROM state_rows WHERE scope=?1 ORDER BY position",
+        )?;
+        let mut rows = query.query([&file.scope])?;
+        let mut observed = 0u64;
+        let mut hash = Sha256::new();
+        while let Some(row) = rows.next()? {
+            let key: String = row.get(0)?;
+            let value = database::decode_value(&row.get::<_, Vec<u8>>(1)?, row.get(3)?)?;
+            let position =
+                u64::try_from(row.get::<_, i64>(2)?).context("Invalid negative row position")?;
+            ensure!(position == observed, "Target insertion order mismatch");
+            archive::content_digest(&mut hash, &key, &value);
+            observed += 1;
+        }
+        ensure!(
+            observed == count && format!("{:x}", hash.finalize()) == digest,
+            "Target ordered content/count mismatch"
+        );
+    }
+    Ok(())
+}
