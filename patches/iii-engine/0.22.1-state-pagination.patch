diff --git a/engine/src/workers/state/adapters/sqlite/commit.rs b/engine/src/workers/state/adapters/sqlite/commit.rs
new file mode 100644
index 0000000000000000000000000000000000000000..cff155911263ba70f2a09929eee7d04550c2b5b3
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/commit.rs
@@ -0,0 +1,311 @@
+use super::{
+    database::{self, CHECKPOINT_SCOPE, CONTROL_SCOPE, RECEIPT_SCOPE},
+    protocol::{
+        self, Checkpoint, CommitBody, CommitRequest, Guard, JOBS, LeaseRequest, Operation,
+        SNAPSHOT, WORKING, error, require,
+    },
+};
+use rusqlite::Connection;
+use serde::{Deserialize, Serialize};
+use serde_json::{Value, json};
+
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Lease {
+    owner_id: String,
+    generation: String,
+    fence: String,
+    expires_at_ms: i64,
+}
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Control {
+    version: u8,
+    generation: String,
+    fence: String,
+    lease: Option<Lease>,
+    recovery: Option<Checkpoint>,
+}
+fn control(connection: &Connection) -> anyhow::Result<Control> {
+    let value = database::row(connection, CONTROL_SCOPE, "current")?
+        .value
+        .ok_or_else(|| error("STATE_TX_FAILED"))?;
+    let control: Control = serde_json::from_value(value)?;
+    require(control.version == 1 && protocol::counter(&control.generation)? > 0)?;
+    protocol::counter(&control.fence)?;
+    Ok(control)
+}
+fn save_control(connection: &Connection, control: &Control) -> anyhow::Result<()> {
+    database::write(
+        connection,
+        CONTROL_SCOPE,
+        "current",
+        Some(&serde_json::to_value(control)?),
+    )?;
+    Ok(())
+}
+fn validate_guard(control: &Control, guard: &Guard) -> anyhow::Result<()> {
+    guard.validate()?;
+    if control.generation != guard.generation {
+        return Err(error("STATE_TX_GENERATION_STALE"));
+    }
+    if !control.lease.as_ref().is_some_and(|lease| {
+        lease.generation == guard.generation
+            && lease.fence == guard.fence
+            && lease.owner_id == guard.owner_id
+            && lease.expires_at_ms > chrono::Utc::now().timestamp_millis()
+            && control.fence == guard.fence
+    }) {
+        return Err(error("STATE_TX_FENCED"));
+    }
+    Ok(())
+}
+pub fn read_allowed(
+    connection: &Connection,
+    scope: &str,
+    key: &str,
+    guard: Option<&Guard>,
+) -> anyhow::Result<()> {
+    let control = control(connection)?;
+    if let Some(guard) = guard {
+        validate_guard(&control, guard)?;
+    }
+    if control.recovery.is_some()
+        && guard.is_none()
+        && (protocol::guarded(scope, key) || (scope == "mem:batch-callbacks" && key.is_empty()))
+        && ![CONTROL_SCOPE, CHECKPOINT_SCOPE, RECEIPT_SCOPE].contains(&scope)
+        && !(scope == SNAPSHOT && key == "current")
+    {
+        return Err(error("STATE_GRAPH_RECOVERY_REQUIRED"));
+    }
+    Ok(())
+}
+pub fn lease(connection: &Connection, request: LeaseRequest) -> anyhow::Result<Value> {
+    let mut control = control(connection)?;
+    let now = chrono::Utc::now().timestamp_millis();
+    let (owner_id, generation, ttl_ms, fence) = match request {
+        LeaseRequest::Acquire {
+            owner_id,
+            generation,
+            ttl_ms,
+        } => (owner_id, generation, Some(ttl_ms), None),
+        LeaseRequest::Renew {
+            owner_id,
+            generation,
+            fence,
+            ttl_ms,
+        } => (owner_id, generation, Some(ttl_ms), Some(fence)),
+        LeaseRequest::Release {
+            owner_id,
+            generation,
+            fence,
+        } => (owner_id, generation, None, Some(fence)),
+    };
+    if generation != control.generation {
+        return Err(error("STATE_TX_GENERATION_STALE"));
+    }
+    if let Some(fence) = fence {
+        validate_guard(
+            &control,
+            &Guard {
+                owner_id: owner_id.clone(),
+                generation: generation.clone(),
+                fence,
+            },
+        )?;
+        if ttl_ms.is_none() {
+            control.lease = None;
+            save_control(connection, &control)?;
+            return Ok(json!({"released":true}));
+        }
+    } else if let Some(lease) = &control.lease {
+        if lease.expires_at_ms > now {
+            if lease.owner_id != owner_id {
+                return Err(error("STATE_TX_LEASE_BUSY"));
+            }
+            return Ok(serde_json::to_value(lease)?);
+        }
+    }
+    if control
+        .lease
+        .as_ref()
+        .is_none_or(|lease| lease.expires_at_ms <= now)
+    {
+        control.fence = protocol::next(protocol::counter(&control.fence)?)?.to_string();
+    }
+    let expires_at_ms = now
+        .checked_add(ttl_ms.unwrap_or(0) as i64)
+        .filter(|time| *time > 0 && *time <= 9_007_199_254_740_991)
+        .ok_or_else(|| error("STATE_TX_LIMIT_EXCEEDED"))?;
+    let lease = Lease {
+        owner_id,
+        generation,
+        fence: control.fence.clone(),
+        expires_at_ms,
+    };
+    control.lease = Some(lease.clone());
+    save_control(connection, &control)?;
+    Ok(serde_json::to_value(lease)?)
+}
+fn progression(old: Option<&Value>, body: &CommitBody) -> anyhow::Result<()> {
+    let point = &body.checkpoint;
+    let id = &body.identity;
+    let valid = match old {
+        None => id.chunk_ordinal == 0 && point.delta_ordinal == 0,
+        Some(old) => {
+            let previous: Checkpoint = serde_json::from_value(old.clone())?;
+            if previous.generation != id.generation || previous.job_id != id.job_id {
+                false
+            } else if previous.logical_delta_id == id.logical_delta_id {
+                previous.visibility != "complete"
+                    && previous.next_chunk_ordinal == id.chunk_ordinal
+                    && previous.delta_ordinal == point.delta_ordinal
+                    && !(previous.visibility == "applying" && point.visibility == "staging")
+            } else {
+                previous.visibility == "complete"
+                    && id.chunk_ordinal == 0
+                    && point.delta_ordinal == previous.delta_ordinal + 1
+            }
+        }
+    };
+    if !valid {
+        return Err(error("STATE_TX_CHECKPOINT_CONFLICT"));
+    }
+    Ok(())
+}
+fn pending_value(
+    connection: &Connection,
+    body: &CommitBody,
+    scope: &str,
+    key: &str,
+) -> anyhow::Result<Option<Value>> {
+    match body.operations.iter().find(|op| {
+        let (s, k, _) = op.row();
+        s == scope && k == key
+    }) {
+        Some(Operation::Set { value, .. }) => Ok(Some(value.clone())),
+        Some(Operation::Delete { .. }) => Ok(None),
+        _ => Ok(database::row(connection, scope, key)?.value),
+    }
+}
+fn job_ownership(connection: &Connection, body: &CommitBody) -> anyhow::Result<()> {
+    let job = pending_value(connection, body, JOBS, &body.identity.job_id)?
+        .ok_or_else(|| error("STATE_TX_INVALID_REQUEST"))?;
+    require(
+        job["version"] == 1
+            && job["id"] == body.identity.job_id
+            && job["generation"] == body.identity.generation,
+    )?;
+    if let Some(count) = job.get("logicalDeltaCount").and_then(Value::as_u64) {
+        require(body.checkpoint.delta_ordinal < count)?;
+    }
+    Ok(())
+}
+fn completion(connection: &Connection, body: &CommitBody) -> anyhow::Result<()> {
+    let working = pending_value(connection, body, WORKING, &body.identity.job_id)?
+        .ok_or_else(|| error("STATE_TX_INVALID_REQUEST"))?;
+    require(
+        working.as_object().is_some_and(|object| object.len() == 6)
+            && working["version"] == 1
+            && working["generation"] == body.identity.generation
+            && working["jobId"] == body.identity.job_id
+            && working["logicalDeltaId"] == body.identity.logical_delta_id,
+    )?;
+    let exists = working
+        .get("snapshotExists")
+        .and_then(Value::as_bool)
+        .ok_or_else(|| error("STATE_TX_INVALID_REQUEST"))?;
+    let snapshot = working
+        .get("snapshot")
+        .ok_or_else(|| error("STATE_TX_INVALID_REQUEST"))?;
+    let published = pending_value(connection, body, SNAPSHOT, "current")?;
+    require(
+        exists == published.is_some()
+            && (if exists {
+                published.as_ref() == Some(snapshot)
+            } else {
+                snapshot.is_null()
+            }),
+    )
+}
+
+pub fn commit(
+    connection: &Connection,
+    request: CommitRequest,
+    body: CommitBody,
+) -> anyhow::Result<Value> {
+    let mut control = control(connection)?;
+    // A historical lost acknowledgment is authorized by today's lease, not the old identity.
+    validate_guard(&control, &request.guard)?;
+    let receipt_key = serde_json::to_string(&json!([
+        body.identity.generation,
+        body.identity.job_id,
+        body.identity.logical_delta_id,
+        body.identity.chunk_ordinal
+    ]))?;
+    if let Some(receipt) = database::row(connection, RECEIPT_SCOPE, &receipt_key)?.value {
+        if receipt["payload_digest"] != request.payload_digest {
+            return Err(error("STATE_TX_REPLAY_CONFLICT"));
+        }
+        return Ok(receipt);
+    }
+    if body.identity.generation != control.generation {
+        return Err(error("STATE_TX_GENERATION_STALE"));
+    }
+    if let Some(barrier) = &control.recovery {
+        if barrier.job_id != body.identity.job_id
+            || barrier.logical_delta_id != body.identity.logical_delta_id
+            || barrier.generation != body.identity.generation
+        {
+            return Err(error("STATE_GRAPH_RECOVERY_REQUIRED"));
+        }
+    }
+    let checkpoint = database::row(connection, CHECKPOINT_SCOPE, &body.identity.job_id)?;
+    if checkpoint.version != protocol::counter(&body.expected_checkpoint_version)? {
+        return Err(error("STATE_TX_CHECKPOINT_CONFLICT"));
+    }
+    progression(checkpoint.value.as_ref(), &body)?;
+    job_ownership(connection, &body)?;
+    for op in &body.operations {
+        let (scope, key, version) = op.row();
+        if database::row(connection, scope, key)?.version != protocol::counter(version)? {
+            return Err(error("STATE_TX_CONFLICT"));
+        }
+    }
+    if body.checkpoint.visibility == "complete" {
+        completion(connection, &body)?;
+    }
+    let live_effect = body.operations.iter().any(|op| {
+        let (scope, key, _) = op.row();
+        op.changed() && protocol::live(scope, key)
+    });
+    let mut row_versions = Vec::with_capacity(body.operations.len());
+    for op in &body.operations {
+        let (scope, key, version) = op.row();
+        let version = match op {
+            Operation::Set { value, .. } => database::write(connection, scope, key, Some(value))?,
+            Operation::Delete { .. } => database::write(connection, scope, key, None)?,
+            Operation::Check { .. } => protocol::counter(version)?,
+        };
+        row_versions.push(json!({"scope":scope,"key":key,"version":version.to_string()}));
+    }
+    let checkpoint_version = database::write(
+        connection,
+        CHECKPOINT_SCOPE,
+        &body.identity.job_id,
+        Some(&serde_json::to_value(&body.checkpoint)?),
+    )?;
+    if body.checkpoint.visibility == "complete" {
+        control.recovery = None;
+    } else if live_effect || control.recovery.is_some() {
+        control.recovery = Some(body.checkpoint.clone());
+    }
+    if body.advance_generation == Some(true) {
+        control.generation = protocol::next(protocol::counter(&control.generation)?)?.to_string();
+        control.lease = None;
+    }
+    save_control(connection, &control)?;
+    let receipt = json!({"identity":body.identity,"payload_digest":request.payload_digest,"generation":control.generation,"checkpoint_version":checkpoint_version.to_string(),"row_versions":row_versions});
+    database::write(connection, RECEIPT_SCOPE, &receipt_key, Some(&receipt))?;
+    Ok(receipt)
+}
diff --git a/engine/src/workers/state/adapters/sqlite/crash_tests.rs b/engine/src/workers/state/adapters/sqlite/crash_tests.rs
new file mode 100644
index 0000000000000000000000000000000000000000..98a5d383dab350a3f2157ec3dca2282dfc49a587
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/crash_tests.rs
@@ -0,0 +1,242 @@
+use super::*;
+
+#[test]
+#[ignore = "only run as an isolated crash subprocess"]
+fn sqlite_crash_probe() {
+    let path = match std::env::var("III_SQLITE_CRASH_PATH") {
+        Ok(path) => path,
+        Err(std::env::VarError::NotPresent) => return,
+        Err(std::env::VarError::NotUnicode(_)) => {
+            panic!("isolated crash subprocess path must be valid UTF-8")
+        }
+    };
+    let mode = std::env::var("III_SQLITE_CRASH_MODE").unwrap();
+    let runtime = tokio::runtime::Runtime::new().unwrap();
+    runtime.block_on(async {
+        let adapter = SqliteAdapter::new(Some(json!({"file_path":path}))).unwrap();
+        assert_eq!(adapter.path, std::path::PathBuf::from(&path));
+        let owner = guard(&adapter, "crash-owner", "1").await;
+        eprintln!("sqlite crash fixture path={}", adapter.path.display());
+        eprintln!("sqlite crash fixture lease={owner}");
+        let request = batch(
+            owner.clone(),
+            "crash-job",
+            "crash-delta",
+            0,
+            "0",
+            "applying",
+            vec![
+                op(JOBS, "crash-job", "0", job("crash-job", "1")),
+                op("mem:graph:nodes", "a", "0", json!({"weight":7})),
+            ],
+        );
+        if mode == "committed" {
+            let receipt = adapter.commit_batch(request).await.unwrap();
+            eprintln!("sqlite crash fixture receipt={receipt}");
+            std::process::exit(72);
+        }
+        let bytes = protocol::size(&request).unwrap();
+        let request: protocol::CommitRequest = protocol::decode(request).unwrap();
+        let body = request.validate(bytes).unwrap();
+        adapter
+            .mutate(bytes, move |connection| -> anyhow::Result<()> {
+                commit::commit(connection, request, body)?;
+                // Exit after graph/checkpoint/receipt SQL writes, before transaction COMMIT or destructor rollback.
+                std::process::exit(71);
+            })
+            .await
+            .unwrap();
+    });
+}
+
+#[tokio::test]
+async fn sqlite_process_crash_atomicity_and_committed_recovery() {
+    let root = std::env::var("III_SQLITE_TEST_ROOT").unwrap();
+    for (mode, exit) in [("uncommitted", 71), ("committed", 72)] {
+        let directory = tempfile::tempdir_in(&root).unwrap();
+        let path = directory.path().join("crash-synthetic.sqlite3");
+        assert!(!path.exists());
+        eprintln!("fresh crash database: {}", path.display());
+        let result = std::process::Command::new(std::env::current_exe().unwrap())
+            .args([
+                "--exact",
+                "workers::state::adapters::sqlite::tests::crash_tests::sqlite_crash_probe",
+                "--ignored",
+                "--nocapture",
+            ])
+            .env("III_SQLITE_CRASH_PATH", &path)
+            .env("III_SQLITE_CRASH_MODE", mode)
+            .output()
+            .unwrap();
+        let stderr = String::from_utf8_lossy(&result.stderr);
+        assert_eq!(result.status.code(), Some(exit), "{}", stderr);
+        let child_path = stderr
+            .lines()
+            .find_map(|line| line.strip_prefix("sqlite crash fixture path="))
+            .expect("crash child must report its effective fixture path");
+        assert_eq!(std::path::PathBuf::from(child_path), path);
+        let child_lease: Value = serde_json::from_str(
+            stderr
+                .lines()
+                .find_map(|line| line.strip_prefix("sqlite crash fixture lease="))
+                .expect("crash child must report its acquired lease before exiting"),
+        )
+        .unwrap();
+        assert_eq!(child_lease["owner_id"], "crash-owner");
+        assert_eq!(child_lease["generation"], "1");
+        assert_eq!(child_lease["fence"], "1");
+        let adapter = SqliteAdapter::new(Some(json!({"file_path":path}))).unwrap();
+        assert_eq!(adapter.path, path);
+        let control = adapter
+            .get(database::CONTROL_SCOPE, "current")
+            .await
+            .unwrap()
+            .unwrap();
+        assert!(
+            contains_lease(&control, &child_lease),
+            "fixture control record must persist the child lease: {control}"
+        );
+        assert_eq!(!control["recovery"].is_null(), mode == "committed");
+        if mode == "uncommitted" {
+            assert_eq!(
+                version(
+                    &adapter,
+                    "mem:graph:nodes",
+                    "a",
+                    Some(child_lease.clone())
+                )
+                .await["exists"],
+                false
+            );
+            assert_eq!(
+                version(
+                    &adapter,
+                    JOBS,
+                    "crash-job",
+                    Some(child_lease.clone())
+                )
+                .await["exists"],
+                false
+            );
+            assert_eq!(
+                version(
+                    &adapter,
+                    database::CHECKPOINT_SCOPE,
+                    "crash-job",
+                    Some(child_lease.clone())
+                )
+                .await["exists"],
+                false
+            );
+            assert!(adapter.list("mem:graph:receipts").await.unwrap().is_empty());
+        } else {
+            let receipt: Value = serde_json::from_str(
+                stderr
+                    .lines()
+                    .find_map(|line| line.strip_prefix("sqlite crash fixture receipt="))
+                    .expect("committed child must report its receipt before exiting"),
+            )
+            .unwrap();
+            assert_eq!(receipt["checkpoint_version"], "1");
+            adapter
+                .lease(json!({
+                    "action":"release",
+                    "owner_id":child_lease["owner_id"],
+                    "generation":child_lease["generation"],
+                    "fence":child_lease["fence"]
+                }))
+                .await
+                .unwrap();
+            let recovery = guard(&adapter, "recovery", "1").await;
+            assert_ne!(recovery["fence"], child_lease["fence"]);
+            let request = batch(
+                recovery.clone(),
+                "crash-job",
+                "crash-delta",
+                0,
+                "0",
+                "applying",
+                vec![
+                    op(JOBS, "crash-job", "0", job("crash-job", "1")),
+                    op("mem:graph:nodes", "a", "0", json!({"weight":7})),
+                ],
+            );
+            let original_request = batch(
+                child_lease.clone(),
+                "crash-job",
+                "crash-delta",
+                0,
+                "0",
+                "applying",
+                vec![
+                    op(JOBS, "crash-job", "0", job("crash-job", "1")),
+                    op("mem:graph:nodes", "a", "0", json!({"weight":7})),
+                ],
+            );
+            let checkpoint_before = version(
+                &adapter,
+                database::CHECKPOINT_SCOPE,
+                "crash-job",
+                Some(recovery.clone()),
+            )
+            .await;
+            assert_eq!(checkpoint_before["exists"], true);
+            assert_eq!(checkpoint_before["version"], "1");
+            let job_before = version(&adapter, JOBS, "crash-job", Some(recovery.clone())).await;
+            assert_eq!(job_before["value"], job("crash-job", "1"));
+            let graph_before = version(
+                &adapter,
+                "mem:graph:nodes",
+                "a",
+                Some(recovery.clone()),
+            )
+            .await;
+            assert_eq!(graph_before["value"], json!({"weight":7}));
+            let replay_receipt = adapter.commit_batch(request).await.unwrap();
+            assert_eq!(replay_receipt, receipt);
+            let checkpoint_after = version(
+                &adapter,
+                database::CHECKPOINT_SCOPE,
+                "crash-job",
+                Some(recovery.clone()),
+            )
+            .await;
+            assert_eq!(checkpoint_after["version"], checkpoint_before["version"]);
+            let job_after = version(&adapter, JOBS, "crash-job", Some(recovery.clone())).await;
+            assert_eq!(job_after["version"], job_before["version"]);
+            let graph_after = version(
+                &adapter,
+                "mem:graph:nodes",
+                "a",
+                Some(recovery.clone()),
+            )
+            .await;
+            assert_eq!(
+                graph_after["value"],
+                json!({"weight":7})
+            );
+            assert_eq!(graph_after["version"], graph_before["version"]);
+            assert_eq!(
+                code(adapter.commit_batch(original_request).await.unwrap_err()),
+                "STATE_TX_FENCED"
+            );
+        }
+    }
+}
+
+fn contains_lease(control: &Value, expected: &Value) -> bool {
+    let fields = ["owner_id", "generation", "fence"];
+    if fields
+        .iter()
+        .all(|field| control.get(field) == expected.get(field))
+    {
+        return true;
+    }
+    match control {
+        Value::Array(values) => values.iter().any(|value| contains_lease(value, expected)),
+        Value::Object(values) => values
+            .values()
+            .any(|value| contains_lease(value, expected)),
+        _ => false,
+    }
+}
diff --git a/engine/src/workers/state/adapters/sqlite/database.rs b/engine/src/workers/state/adapters/sqlite/database.rs
new file mode 100644
index 0000000000000000000000000000000000000000..924cb5685d231d1d3ec80cbd214388916611d7d8
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/database.rs
@@ -0,0 +1,179 @@
+use super::protocol;
+use rusqlite::{Connection, OptionalExtension, params};
+use serde_json::Value;
+use std::{path::Path, time::Duration};
+
+pub(crate) const APPLICATION_ID: i64 = 0x49494953;
+pub const CONTROL_SCOPE: &str = "mem:graph:control";
+pub const CHECKPOINT_SCOPE: &str = "mem:graph:checkpoints";
+pub const RECEIPT_SCOPE: &str = "mem:graph:receipts";
+
+pub fn open(path: &Path) -> anyhow::Result<Connection> {
+    let mut marker = path.as_os_str().to_owned(); marker.push(".migration-pending");
+    if Path::new(&marker).exists() { anyhow::bail!("STATE_MIGRATION_INCOMPLETE: shadow target is not ready"); }
+    if path.is_file() {
+        let prior = Connection::open_with_flags(path, rusqlite::OpenFlags::SQLITE_OPEN_READ_ONLY)?;
+        let exists: i64 = prior.query_row("SELECT count(*) FROM sqlite_master WHERE type='table' AND name='state_migration'", [], |r| r.get(0))?;
+        if exists != 0 {
+            let ready: String = prior.query_row("SELECT status FROM state_migration WHERE id=1", [], |r| r.get(0))?;
+            if ready != "ready" { anyhow::bail!("STATE_MIGRATION_INCOMPLETE: shadow target is not ready"); }
+        }
+    }
+    let connection = open_for_migration(path)?;
+    let pending: i64 = connection.query_row(
+        "SELECT count(*) FROM sqlite_master WHERE type='table' AND name='state_migration'", [], |r| r.get(0),
+    )?;
+    if pending != 0 {
+        let ready: String = connection.query_row("SELECT status FROM state_migration WHERE id=1", [], |r| r.get(0))?;
+        if ready != "ready" { anyhow::bail!("STATE_MIGRATION_INCOMPLETE: shadow target is not ready"); }
+    }
+    Ok(connection)
+}
+
+pub(crate) fn open_for_migration(path: &Path) -> anyhow::Result<Connection> {
+    if path.is_dir() {
+        anyhow::bail!(
+            "SQLite file_path must name a database file; migration is required for legacy directories"
+        );
+    }
+    if let Some(parent) = path.parent().filter(|p| !p.as_os_str().is_empty()) {
+        std::fs::create_dir_all(parent)?;
+    }
+    let connection = Connection::open(path)?;
+    let application: i64 = connection.pragma_query_value(None, "application_id", |r| r.get(0))?;
+    let version: i64 = connection.pragma_query_value(None, "user_version", |r| r.get(0))?;
+    let tables: i64 = connection.query_row(
+        "SELECT count(*) FROM sqlite_master WHERE type='table'",
+        [],
+        |r| r.get(0),
+    )?;
+    if (tables > 0 && (application != APPLICATION_ID || version != 1)) || version > 1 {
+        anyhow::bail!("Unsupported SQLite state format; explicit migration is required");
+    }
+    connection.busy_timeout(Duration::from_secs(5))?;
+    connection.execute_batch("PRAGMA journal_mode=WAL; PRAGMA synchronous=FULL; PRAGMA cache_size=-65536; PRAGMA mmap_size=0; PRAGMA temp_store=FILE; PRAGMA wal_autocheckpoint=1024; PRAGMA journal_size_limit=67108864; PRAGMA foreign_keys=ON;
+        CREATE TABLE IF NOT EXISTS state_scopes(scope TEXT PRIMARY KEY, revision TEXT NOT NULL, next_position INTEGER NOT NULL) WITHOUT ROWID;
+        CREATE TABLE IF NOT EXISTS state_rows(scope TEXT NOT NULL, key TEXT NOT NULL, value TEXT, version TEXT NOT NULL, position INTEGER, value_bytes INTEGER NOT NULL, PRIMARY KEY(scope,key)) WITHOUT ROWID;
+        CREATE INDEX IF NOT EXISTS state_rows_order ON state_rows(scope,position) WHERE value IS NOT NULL;")?;
+    connection.pragma_update(None, "application_id", APPLICATION_ID)?;
+    connection.pragma_update(None, "user_version", 1)?;
+    {
+        let transaction = rusqlite::Transaction::new_unchecked(
+            &connection,
+            rusqlite::TransactionBehavior::Immediate,
+        )?;
+        if row(&transaction, CONTROL_SCOPE, "current")?.value.is_none() {
+            write(
+                &transaction,
+                CONTROL_SCOPE,
+                "current",
+                Some(
+                    &serde_json::json!({"version":1,"generation":"1","fence":"0","lease":null,"recovery":null}),
+                ),
+            )?;
+        }
+        transaction.commit()?;
+    }
+    Ok(connection)
+}
+
+pub fn wal_pressure(connection: &Connection, path: &Path) -> anyhow::Result<()> {
+    let wal = std::path::PathBuf::from(format!("{}-wal", path.display()));
+    let bytes = match std::fs::metadata(&wal) {
+        Ok(metadata) => metadata.len(),
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => 0,
+        Err(error) => return Err(error.into()),
+    };
+    if bytes >= 32 * 1024 * 1024 {
+        let (busy, _, _): (i64, i64, i64) =
+            connection.query_row("PRAGMA wal_checkpoint(TRUNCATE)", [], |r| {
+                Ok((r.get(0)?, r.get(1)?, r.get(2)?))
+            })?;
+        if busy != 0 && bytes >= 64 * 1024 * 1024 {
+            return Err(protocol::error("STATE_TX_LIMIT_EXCEEDED"));
+        }
+    }
+    Ok(())
+}
+
+pub struct Row {
+    pub value: Option<Value>,
+    pub version: u64,
+    pub position: Option<i64>,
+}
+pub fn row(connection: &Connection, scope: &str, key: &str) -> anyhow::Result<Row> {
+    let raw: Option<(Option<String>, String, Option<i64>)> = connection
+        .query_row(
+            "SELECT value,version,position FROM state_rows WHERE scope=?1 AND key=?2",
+            params![scope, key],
+            |r| Ok((r.get(0)?, r.get(1)?, r.get(2)?)),
+        )
+        .optional()?;
+    match raw {
+        None => Ok(Row {
+            value: None,
+            version: 0,
+            position: None,
+        }),
+        Some((value, version, position)) => Ok(Row {
+            value: value.map(|v| serde_json::from_str(&v)).transpose()?,
+            version: protocol::counter(&version)?,
+            position,
+        }),
+    }
+}
+pub fn revision(connection: &Connection, scope: &str) -> anyhow::Result<u64> {
+    let version: Option<String> = connection
+        .query_row(
+            "SELECT revision FROM state_scopes WHERE scope=?1",
+            [scope],
+            |r| r.get(0),
+        )
+        .optional()?;
+    version.map_or(Ok(0), |v| protocol::counter(&v))
+}
+pub fn write(
+    connection: &Connection,
+    scope: &str,
+    key: &str,
+    value: Option<&Value>,
+) -> anyhow::Result<u64> {
+    let old = row(connection, scope, key)?;
+    let version = protocol::next(old.version)?;
+    let revision = protocol::next(revision(connection, scope)?)?;
+    connection.execute(
+        "INSERT OR IGNORE INTO state_scopes VALUES(?1,'0',0)",
+        [scope],
+    )?;
+    let position = if value.is_some() {
+        match old.position.filter(|_| old.value.is_some()) {
+            Some(position) => Some(position),
+            None => {
+                let position: i64 = connection.query_row(
+                    "SELECT next_position FROM state_scopes WHERE scope=?1",
+                    [scope],
+                    |r| r.get(0),
+                )?;
+                if position >= 9_007_199_254_740_990 {
+                    return Err(protocol::error("STATE_TX_LIMIT_EXCEEDED"));
+                }
+                connection.execute(
+                    "UPDATE state_scopes SET next_position=?2 WHERE scope=?1",
+                    params![scope, position + 1],
+                )?;
+                Some(position)
+            }
+        }
+    } else {
+        None
+    };
+    let serialized = value.map(serde_json::to_string).transpose()?;
+    let bytes = serialized.as_ref().map_or(0, String::len);
+    connection.execute("INSERT INTO state_rows VALUES(?1,?2,?3,?4,?5,?6) ON CONFLICT(scope,key) DO UPDATE SET value=excluded.value,version=excluded.version,position=excluded.position,value_bytes=excluded.value_bytes",
+        params![scope,key,serialized,version.to_string(),position,bytes as i64])?;
+    connection.execute(
+        "UPDATE state_scopes SET revision=?2 WHERE scope=?1",
+        params![scope, revision.to_string()],
+    )?;
+    Ok(version)
+}
diff --git a/engine/src/workers/state/adapters/sqlite/mod.rs b/engine/src/workers/state/adapters/sqlite/mod.rs
new file mode 100644
index 0000000000000000000000000000000000000000..554ae3af5685148000b89c07ec2a31e24fdead8f
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/mod.rs
@@ -0,0 +1,279 @@
+mod commit;
+pub(crate) mod database;
+mod paging;
+mod protocol;
+#[cfg(test)]
+mod tests;
+
+use super::{StateAdapter, StatePageError};
+use crate::{
+    engine::Engine,
+    workers::state::{
+        registry::{StateAdapterFuture, StateAdapterRegistration},
+        structs::StateListPageResult,
+    },
+};
+use async_trait::async_trait;
+use iii_helpers::stream::{StreamSetResult, StreamUpdateResult, UpdateOp};
+pub use protocol::{error_body, guarded};
+use rusqlite::Connection;
+use serde_json::Value;
+use std::{
+    path::PathBuf,
+    sync::{Arc, mpsc},
+};
+use tokio::sync::{Semaphore, oneshot};
+pub fn protocol_error_unsupported() -> anyhow::Error {
+    protocol::error("STATE_TX_UNSUPPORTED")
+}
+pub fn plain_write(scope: &str, key: &str) -> anyhow::Result<()> {
+    protocol::plain_write(scope, key)
+}
+
+pub const ADMISSION_BYTES: usize = 64 * 1024 * 1024;
+pub const MAX_ENVELOPE_BYTES: usize = 16 * 1024 * 1024 - 64 * 1024;
+pub const LEGACY_LIST_BYTES: usize = 4 * 1024 * 1024;
+const DEFAULT_DATABASE_PATH: &str = "state_store.sqlite3";
+type Job = Box<dyn FnOnce(&mut Connection) + Send>;
+
+fn configured_path(config: Option<&Value>) -> anyhow::Result<PathBuf> {
+    let path = match config.and_then(|config| config.get("file_path")) {
+        Some(Value::String(path)) => path.as_str(),
+        Some(_) => return Err(protocol::error("STATE_TX_INVALID_REQUEST")),
+        None => DEFAULT_DATABASE_PATH,
+    };
+    if path.is_empty() {
+        return Err(protocol::error("STATE_TX_INVALID_REQUEST"));
+    }
+    Ok(PathBuf::from(path))
+}
+
+pub struct SqliteAdapter {
+    sender: mpsc::SyncSender<Job>,
+    admission: Arc<Semaphore>,
+    generation: uuid::Uuid,
+    path: PathBuf,
+}
+
+impl SqliteAdapter {
+    pub fn new(config: Option<Value>) -> anyhow::Result<Self> {
+        let path = configured_path(config.as_ref())?;
+        let mut connection = database::open(&path)?;
+        let (sender, receiver) = mpsc::sync_channel::<Job>(32);
+        std::thread::Builder::new()
+            .name("iii-state-sqlite".into())
+            .spawn(move || {
+                for job in receiver {
+                    job(&mut connection);
+                }
+                if let Err(cause) = connection.execute_batch("PRAGMA wal_checkpoint(TRUNCATE)") {
+                    tracing::warn!(error = %cause, "state SQLite shutdown checkpoint failed");
+                }
+            })?;
+        Ok(Self {
+            sender,
+            admission: Arc::new(Semaphore::new(ADMISSION_BYTES)),
+            generation: uuid::Uuid::new_v4(),
+            path,
+        })
+    }
+
+    async fn run<T: Send + 'static>(
+        &self,
+        bytes: usize,
+        job: impl FnOnce(&mut Connection) -> anyhow::Result<T> + Send + 'static,
+    ) -> anyhow::Result<T> {
+        if bytes > MAX_ENVELOPE_BYTES {
+            return Err(protocol::error("STATE_RECORD_TOO_LARGE"));
+        }
+        let permit = self
+            .admission
+            .clone()
+            .try_acquire_many_owned(bytes.max(4096) as u32)
+            .map_err(|_| protocol::error("STATE_TX_LIMIT_EXCEEDED"))?;
+        let (sender, receiver) = oneshot::channel();
+        self.sender
+            .try_send(Box::new(move |connection| {
+                let result = job(connection);
+                let _ = sender.send(result);
+                drop(permit);
+            }))
+            .map_err(|error| match error {
+                mpsc::TrySendError::Full(_) => protocol::error("STATE_TX_LIMIT_EXCEEDED"),
+                mpsc::TrySendError::Disconnected(_) => protocol::error("STATE_TX_FAILED"),
+            })?;
+        receiver
+            .await
+            .map_err(|_| protocol::error("STATE_TX_FAILED"))?
+    }
+
+    async fn mutate<T: Send + 'static>(
+        &self,
+        bytes: usize,
+        job: impl FnOnce(&rusqlite::Transaction<'_>) -> anyhow::Result<T> + Send + 'static,
+    ) -> anyhow::Result<T> {
+        let path = self.path.clone();
+        self.run(bytes, move |connection| {
+            database::wal_pressure(connection, &path)?;
+            let transaction =
+                connection.transaction_with_behavior(rusqlite::TransactionBehavior::Immediate)?;
+            let result = job(&transaction)?;
+            transaction.commit()?;
+            Ok(result)
+        })
+        .await
+    }
+}
+
+#[async_trait]
+impl StateAdapter for SqliteAdapter {
+    async fn set(&self, scope: &str, key: &str, value: Value) -> anyhow::Result<StreamSetResult> {
+        protocol::plain_write(scope, key)?;
+        let bytes = protocol::size(&value)?.saturating_add(scope.len() + key.len() + 4096);
+        let (scope, key) = (scope.to_owned(), key.to_owned());
+        self.mutate(bytes, move |connection| {
+            let old_value = database::row(connection, &scope, &key)?.value;
+            database::write(connection, &scope, &key, Some(&value))?;
+            Ok(StreamSetResult {
+                old_value,
+                new_value: value,
+            })
+        })
+        .await
+    }
+    async fn get(&self, scope: &str, key: &str) -> anyhow::Result<Option<Value>> {
+        let (scope, key) = (scope.to_owned(), key.to_owned());
+        self.run(scope.len() + key.len(), move |connection| {
+            let transaction = connection.unchecked_transaction()?;
+            commit::read_allowed(&transaction, &scope, &key, None)?;
+            Ok(database::row(&transaction, &scope, &key)?.value)
+        })
+        .await
+    }
+    async fn delete(&self, scope: &str, key: &str) -> anyhow::Result<()> {
+        protocol::plain_write(scope, key)?;
+        let (scope, key) = (scope.to_owned(), key.to_owned());
+        self.mutate(scope.len() + key.len(), move |connection| {
+            if database::row(connection, &scope, &key)?.value.is_some() {
+                database::write(connection, &scope, &key, None)?;
+            }
+            Ok(())
+        })
+        .await
+    }
+    async fn update(
+        &self,
+        scope: &str,
+        key: &str,
+        ops: Vec<UpdateOp>,
+    ) -> anyhow::Result<StreamUpdateResult> {
+        protocol::plain_write(scope, key)?;
+        let bytes = protocol::size(&ops)?.saturating_add(scope.len() + key.len() + 4096);
+        let (scope, key) = (scope.to_owned(), key.to_owned());
+        self.mutate(bytes, move |connection| {
+            let old_value = database::row(connection, &scope, &key)?.value;
+            let (new_value, errors) = crate::update_ops::apply_update_ops(old_value.clone(), &ops);
+            if protocol::size(&new_value)? > MAX_ENVELOPE_BYTES - 4096 {
+                return Err(protocol::error("STATE_RECORD_TOO_LARGE"));
+            }
+            database::write(connection, &scope, &key, Some(&new_value))?;
+            Ok(StreamUpdateResult {
+                old_value,
+                new_value,
+                errors,
+            })
+        })
+        .await
+    }
+    async fn list(&self, scope: &str) -> anyhow::Result<Vec<Value>> {
+        let scope = scope.to_owned();
+        self.run(scope.len(), move |connection| {
+            paging::list(connection, &scope)
+        })
+        .await
+    }
+    async fn list_page(
+        &self,
+        scope: &str,
+        cursor: Option<&str>,
+        limit: u32,
+        max_bytes: u32,
+    ) -> Result<StateListPageResult, StatePageError> {
+        let (scope, cursor, generation) =
+            (scope.to_owned(), cursor.map(str::to_owned), self.generation);
+        self.run(
+            scope.len() + cursor.as_ref().map_or(0, String::len),
+            move |connection| {
+                Ok(paging::page(
+                    connection,
+                    &scope,
+                    cursor.as_deref(),
+                    limit,
+                    max_bytes,
+                    generation,
+                ))
+            },
+        )
+        .await
+        .map_err(|_| StatePageError::Internal)?
+    }
+    async fn list_groups(&self) -> anyhow::Result<Vec<String>> {
+        self.run(4096, |connection| {
+            let bytes: i64 = connection.query_row(
+                "SELECT COALESCE(SUM(length(CAST(scope AS BLOB)) + 4), 0) FROM state_scopes",
+                [],
+                |r| r.get(0),
+            )?;
+            if bytes > LEGACY_LIST_BYTES as i64 {
+                return Err(protocol::error("STATE_TX_LIMIT_EXCEEDED"));
+            }
+            let mut statement =
+                connection.prepare("SELECT scope FROM state_scopes ORDER BY scope")?;
+            Ok(statement
+                .query_map([], |row| row.get(0))?
+                .collect::<rusqlite::Result<Vec<_>>>()?)
+        })
+        .await
+    }
+    async fn get_versioned(&self, input: Value) -> anyhow::Result<Value> {
+        let bytes = protocol::size(&input)?;
+        if input.get("guard").is_some_and(Value::is_null) {
+            return Err(protocol::error("STATE_TX_INVALID_REQUEST"));
+        }
+        let request: protocol::VersionedRequest = protocol::decode(input)?;
+        request.validate()?;
+        self.run(bytes, move |connection| {
+            let transaction=connection.unchecked_transaction()?;
+            commit::read_allowed(&transaction, &request.scope, &request.key, request.guard.as_ref())?;
+            let row = database::row(&transaction, &request.scope, &request.key)?;
+            Ok(serde_json::json!({"exists": row.value.is_some(), "value": row.value, "version": row.version.to_string()}))
+        }).await
+    }
+    async fn lease(&self, input: Value) -> anyhow::Result<Value> {
+        let bytes = protocol::size(&input)?;
+        let request = protocol::lease_request(input)?;
+        self.mutate(bytes, move |connection| commit::lease(connection, request))
+            .await
+    }
+    async fn commit_batch(&self, input: Value) -> anyhow::Result<Value> {
+        let bytes = protocol::size(&input)?;
+        let request: protocol::CommitRequest = protocol::decode(input)?;
+        self.mutate(bytes, move |connection| {
+            let body = request.validate(bytes)?;
+            commit::commit(connection, request, body)
+        })
+        .await
+    }
+    async fn destroy(&self) -> anyhow::Result<()> {
+        self.run(4096, |connection| {
+            connection.execute_batch("PRAGMA wal_checkpoint(TRUNCATE)")?;
+            Ok(())
+        })
+        .await
+    }
+}
+
+fn make_adapter(_engine: Arc<Engine>, config: Option<Value>) -> StateAdapterFuture {
+    Box::pin(async move { Ok(Arc::new(SqliteAdapter::new(config)?) as Arc<dyn StateAdapter>) })
+}
+crate::register_adapter!(<StateAdapterRegistration> name: "sqlite", make_adapter);
