+use super::need;
+use serde::{Deserialize, Serialize, Deserializer};
+use std::{collections::HashSet, fs::File, io::Read, path::Path};
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct Context {
+    pub workflow: String,
+    #[serde(rename = "functionId")]
+    pub function_id: String,
+    #[serde(rename = "sourceId", default, deserialize_with = "optional_string", skip_serializing_if = "Option::is_none")]
+    pub source_id: Option<String>,
+    #[serde(rename = "jobId", default, deserialize_with = "optional_string", skip_serializing_if = "Option::is_none")]
+    pub job_id: Option<String>,
+    #[serde(rename = "unitId", default, deserialize_with = "optional_string", skip_serializing_if = "Option::is_none")]
+    pub unit_id: Option<String>,
+    pub phase: String,
+    #[serde(rename = "continuationId", default, deserialize_with = "optional_string", skip_serializing_if = "Option::is_none")]
+    pub continuation_id: Option<String>,
+}
+impl Context {
+    pub fn valid(&self) -> bool {
+        [&self.workflow, &self.function_id, &self.phase].into_iter().all(|id| valid_id(id))
+            && [&self.source_id, &self.job_id, &self.unit_id, &self.continuation_id].into_iter()
+                .all(|id| id.as_ref().is_none_or(|id| valid_id(id)))
+    }
+}
+#[derive(PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(super) struct Window {
+    pub id: String,
+    #[serde(rename = "startsAt")]
+    pub starts_at: String,
+    #[serde(rename = "expiresAt")]
+    pub expires_at: String,
+    pub ceiling: u32,
+}
+#[derive(PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(super) struct Operation {
+    pub id: String, pub ceiling: u32,
+    #[serde(default, deserialize_with = "optional_context", skip_serializing_if = "Option::is_none")]
+    pub context: Option<Context>,
+}
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(super) struct Grant {
+    pub version: u32, pub window: Window,
+    #[serde(rename = "allowedEndpoints")]
+    pub allowed_endpoints: Vec<String>,
+    pub operations: Vec<Operation>,
+}
+pub(super) struct Trusted {
+    pub grant: Grant, pub canonical: String, pub starts: i64, pub expires: i64,
+    _handles: Vec<File>,
+}
+pub(crate) fn optional_context<'de, D: Deserializer<'de>>(deserializer: D) -> Result<Option<Context>, D::Error> {
+    Context::deserialize(deserializer).map(Some)
+}
+fn optional_string<'de, D: Deserializer<'de>>(deserializer: D) -> Result<Option<String>, D::Error> {
+    String::deserialize(deserializer).map(Some)
+}
+pub(super) fn valid_id(value: &str) -> bool {
+    !value.is_empty() && value.len() <= 128 && value.as_bytes()[0].is_ascii_alphanumeric()
+        && value.bytes().all(|v| v.is_ascii_alphanumeric() || b"._:-".contains(&v))
+}
+pub(super) fn endpoint(value: &str) -> anyhow::Result<String> {
+    let invalid = "STATE_PROVIDER_BUDGET_ENDPOINT_INVALID";
+    need(value.len() <= 2048, invalid)?;
+    let (method, address) = value.split_once(' ').ok_or_else(|| super::error(invalid))?;
+    need((3..=10).contains(&method.len()) && method.bytes().all(|c| c.is_ascii_uppercase()), invalid)?;
+    let url = reqwest::Url::parse(address).map_err(|_| super::error(invalid))?;
+    need(["http", "https"].contains(&url.scheme()) && url.host_str().is_some()
+        && url.username().is_empty() && url.password().is_none() && url.query().is_none() && url.fragment().is_none(), invalid)?;
+    let canonical = format!("{method} {}{}", url.origin().ascii_serialization(), url.path());
+    need(value == canonical, invalid)?;
+    Ok(canonical)
+}
+fn timestamp(value: &str) -> anyhow::Result<i64> {
+    let code = "STATE_PROVIDER_BUDGET_CONFIG_INVALID";
+    let parsed = chrono::DateTime::parse_from_rfc3339(value).map_err(|_| super::error(code))?;
+    need(parsed.to_rfc3339_opts(chrono::SecondsFormat::Millis, true) == value, code)?;
+    Ok(parsed.timestamp_millis())
+}
+impl Trusted {
+    pub fn read(database: &Path) -> anyhow::Result<Self> {
+        let (mut file, directory) = super::private_file::open(database)?;
+        let mut raw = Vec::new();
+        file.by_ref().take(65537).read_to_end(&mut raw).map_err(|_| super::error("STATE_PROVIDER_BUDGET_CONFIG_UNAVAILABLE"))?;
+        let mut trusted = Self::parse(&raw)?;
+        trusted._handles = vec![file, directory];
+        Ok(trusted)
+    }
+    pub(super) fn parse(raw: &[u8]) -> anyhow::Result<Self> {
+        let code = "STATE_PROVIDER_BUDGET_CONFIG_INVALID";
+        need(!raw.is_empty() && raw.len() <= 65536, code)?;
+        let grant: Grant = serde_json::from_slice(raw).map_err(|_| super::error(code))?;
+        need(grant.version == 1 && valid_id(&grant.window.id) && (1..=10000).contains(&grant.window.ceiling)
+            && (1..=64).contains(&grant.allowed_endpoints.len()) && (1..=256).contains(&grant.operations.len()), code)?;
+        let starts = timestamp(&grant.window.starts_at)?;
+        let expires = timestamp(&grant.window.expires_at)?;
+        need(expires > starts && expires.checked_sub(starts).is_some_and(|ms| ms <= 604800000), code)?;
+        let mut endpoints = HashSet::new();
+        for value in &grant.allowed_endpoints { need(endpoints.insert(endpoint(value)?), code)?; }
+        let mut operations = HashSet::new();
+        for operation in &grant.operations {
+            need(valid_id(&operation.id) && operations.insert(&operation.id) && (1..=1000).contains(&operation.ceiling)
+                && operation.ceiling <= grant.window.ceiling && operation.context.as_ref().is_none_or(Context::valid), code)?;
+        }
+        let canonical = serde_json::to_string(&grant)?;
+        Ok(Self { grant, canonical, starts, expires, _handles: vec![] })
+    }
+    pub fn operation(&self, id: &str) -> anyhow::Result<&Operation> {
+        self.grant.operations.iter().find(|op| op.id == id).ok_or_else(|| super::error("STATE_PROVIDER_BUDGET_NOT_APPROVED"))
+    }
+    pub fn extends(&self, prior: &Self) -> bool {
+        self.grant.window == prior.grant.window
+            && self.grant.allowed_endpoints.len() == prior.grant.allowed_endpoints.len()
+            && prior.grant.allowed_endpoints.iter().all(|endpoint|self.grant.allowed_endpoints.contains(endpoint))
+            && prior.grant.operations.iter().all(|prior|self.grant.operations.iter().find(|current|current.id==prior.id)==Some(prior))
+    }
+    pub fn open(&self) -> anyhow::Result<()> {
+        let now = chrono::Utc::now().timestamp_millis();
+        need(now >= self.starts && now < self.expires, "STATE_PROVIDER_BUDGET_WINDOW_CLOSED")
+    }
+}
