+fn seed_synthetic_graph(connection: &Connection) {
+    let transaction = connection.unchecked_transaction().unwrap();
+    transaction
+        .execute(
+            "INSERT INTO state_scopes(scope,revision,next_position) VALUES(?1,?2,?3)",
+            params![graph::NODES, ROWS.to_string(), ROWS as i64],
+        )
+        .unwrap();
+    let mut insert = transaction
+        .prepare_cached("INSERT INTO state_rows VALUES(?1,?2,?3,'1',?4,?5)")
+        .unwrap();
+    for position in 0..ROWS {
+        let id = format!("synthetic-node-{position:05}");
+        let name = format!("Synthetic graph preparation concept {position:05} index scaling");
+        let value = node(&id, &name, &["synthetic-observation"]);
+        let raw = serde_json::to_string(&value).unwrap();
+        insert
+            .execute(params![graph::NODES, id, raw, position as i64, raw.len() as i64])
+            .unwrap();
+    }
+    drop(insert);
+    metadata::initialize_graph(&transaction, graph::NODES).unwrap();
+    transaction.commit().unwrap();
+}
