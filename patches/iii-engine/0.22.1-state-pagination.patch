+        Step::Cut=>("SELECT id,length(CAST(scope AS BLOB))+length(CAST(key AS BLOB))+length(CAST(version AS BLOB)) FROM compact_roots WHERE id>?1 AND id<=?2 AND id IN(SELECT root FROM compact_root_fields WHERE job=(SELECT json_extract(value,'$.id') FROM compact_root_job WHERE singleton=1)) ORDER BY id LIMIT ?3","cutting","cut"),
