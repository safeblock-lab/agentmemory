+use super::*;
+use rusqlite::params;
+
+fn fixture() -> (tempfile::TempDir, MigrationArgs) {
+    let root = std::env::var_os("III_SQLITE_TEST_ROOT").unwrap();
+    let directory = tempfile::tempdir_in(root).unwrap();
+    let args = MigrationArgs {
+        source: directory.path().join("frozen # & ñ.sqlite3"),
+        target: directory.path().join("shadow.sqlite3"),
+        disk_budget_bytes: 128 * 1024 * 1024,
+        reverse: false,
+    };
+    let connection = Connection::open(&args.source).unwrap();
+    connection.execute_batch("CREATE TABLE state_scopes(scope TEXT PRIMARY KEY,revision TEXT NOT NULL,next_position INTEGER NOT NULL) WITHOUT ROWID; CREATE TABLE state_rows(scope TEXT NOT NULL,key TEXT NOT NULL,value TEXT,version TEXT NOT NULL,position INTEGER,value_bytes INTEGER NOT NULL,PRIMARY KEY(scope,key)) WITHOUT ROWID; CREATE INDEX state_rows_order ON state_rows(scope,position) WHERE value IS NOT NULL; CREATE TABLE retrieval_membership(epoch INTEGER NOT NULL,observation TEXT NOT NULL,key TEXT NOT NULL,position INTEGER NOT NULL,PRIMARY KEY(epoch,observation,key)) WITHOUT ROWID; CREATE INDEX retrieval_membership_key ON retrieval_membership(epoch,key);").unwrap();
+    for index in 0..16i64 {
+        connection
+            .execute(
+                "INSERT INTO retrieval_membership VALUES(?1,?2,?3,?4)",
+                params![
+                    index % 3,
+                    format!("obs-{}", index / 4),
+                    ["shared", "obs-1", "key-ñ😀", "key-z"][index as usize % 4],
+                    index - 8
+                ],
+            )
+            .unwrap();
+    }
+    connection
+        .pragma_update(None, "application_id", database::APPLICATION_ID)
+        .unwrap();
+    connection.pragma_update(None, "user_version", 1).unwrap();
+    drop(connection);
+    (directory, args)
+}
+
+#[test]
+fn sqlite_bulk_attachment_is_readonly_and_uri_escapes_paths() {
+    let (directory, args) = fixture();
+    let digest = archive::file_digest(&args.source).unwrap();
+    let target = Connection::open_with_flags(
+        directory.path().join("attachment.sqlite3"),
+        OpenFlags::default() | OpenFlags::SQLITE_OPEN_URI,
+    )
+    .unwrap();
+    target
+        .execute(
+            "ATTACH DATABASE ?1 AS frozen",
+            [sqlite_bulk::readonly_uri(&args.source).unwrap()],
+        )
+        .unwrap();
+    assert_eq!(
+        target
+            .query_row(
+                "SELECT count(*) FROM frozen.retrieval_membership",
+                [],
+                |row| row.get::<_, i64>(0)
+            )
+            .unwrap(),
+        16
+    );
+    assert!(
+        target
+            .execute("DELETE FROM frozen.retrieval_membership", [])
+            .unwrap_err()
+            .to_string()
+            .contains("readonly")
+    );
+    assert_eq!(archive::file_digest(&args.source).unwrap(), digest);
+    run(&args).unwrap();
+    let reverse = MigrationArgs {
+        source: args.target.clone(),
+        target: directory.path().join("rollback.sqlite3"),
+        reverse: true,
+        ..args
+    };
+    run(&reverse).unwrap();
+}
+
+#[test]
+fn sqlite_bulk_aborted_secondary_index_build_resumes_without_recopy() {
+    let (_directory, args) = fixture();
+    let source_before = archive::file_digest(&args.source).unwrap();
+    assert!(
+        run_segment(&args, Some(16), None)
+            .unwrap_err()
+            .to_string()
+            .contains("interruption")
+    );
+    {
+        let pending = Connection::open(&args.target).unwrap();
+        let count: i64 = pending
+            .query_row("SELECT count(*) FROM retrieval_membership", [], |row| {
+                row.get(0)
+            })
+            .unwrap();
+        assert_eq!(count, 16);
+        assert!(!pending.query_row("SELECT EXISTS(SELECT 1 FROM sqlite_master WHERE name='retrieval_membership_key')",[],|row|row.get::<_,bool>(0)).unwrap());
+        pending
+            .execute(
+                "UPDATE shadow_transfer_progress SET complete=1 WHERE name='retrieval_membership'",
+                [],
+            )
+            .unwrap();
+        pending.execute_batch("BEGIN IMMEDIATE; CREATE INDEX retrieval_membership_key ON retrieval_membership(epoch,key); ROLLBACK;").unwrap();
+        assert!(!pending.query_row("SELECT EXISTS(SELECT 1 FROM sqlite_master WHERE name='retrieval_membership_key')",[],|row|row.get::<_,bool>(0)).unwrap());
+        assert_eq!(
+            pending
+                .query_row("SELECT status FROM state_migration", [], |row| row
+                    .get::<_, String>(0))
+                .unwrap(),
+            "pending"
+        );
+    }
+    run(&args).unwrap();
+    assert_eq!(archive::file_digest(&args.source).unwrap(), source_before);
+    let ready = Connection::open(&args.target).unwrap();
+    let plan: String = ready.query_row("EXPLAIN QUERY PLAN SELECT observation,position FROM retrieval_membership INDEXED BY retrieval_membership_key WHERE epoch=1 AND key=1",[],|row|row.get(3)).unwrap();
+    assert!(plan.contains("retrieval_membership_key"));
+    assert_eq!(
+        ready
+            .query_row("SELECT status FROM state_migration", [], |row| row
+                .get::<_, String>(0))
+            .unwrap(),
+        "ready"
+    );
+    assert_eq!(
+        ready
+            .query_row("PRAGMA synchronous", [], |row| row.get::<_, i64>(0))
+            .unwrap(),
+        2
+    );
+}
+
+#[test]
+fn sqlite_bulk_invalid_membership_type_rolls_back_chunk_and_keeps_pending() {
+    let (_directory, args) = fixture();
+    {
+        let input = Connection::open(&args.source).unwrap();
+        input
+            .execute(
+                "INSERT INTO retrieval_membership VALUES(0.5,'invalid','invalid',0)",
+                [],
+            )
+            .unwrap();
+    }
+    let before = archive::file_digest(&args.source).unwrap();
+    assert!(
+        run(&args)
+            .unwrap_err()
+            .to_string()
+            .contains("Invalid frozen membership value type")
+    );
+    assert_eq!(archive::file_digest(&args.source).unwrap(), before);
+    let pending = Connection::open(&args.target).unwrap();
+    assert_eq!(
+        pending
+            .query_row("SELECT count(*) FROM retrieval_membership", [], |row| row
+                .get::<_, i64>(
+                0
+            ))
+            .unwrap(),
+        0
+    );
+    assert_eq!(
+        pending
+            .query_row("SELECT status FROM state_migration", [], |row| row
+                .get::<_, String>(0))
+            .unwrap(),
+        "pending"
+    );
+    assert!(
+        database::open(&args.target)
+            .unwrap_err()
+            .to_string()
+            .contains("INCOMPLETE")
+    );
+}
+
+#[test]
+fn sqlite_shadow_checkpoint_rejects_reader_blocking_truncation() {
+    let root = std::env::var_os("III_SQLITE_TEST_ROOT").unwrap();
+    let directory = tempfile::tempdir_in(root).unwrap();
+    let path = directory.path().join("blocked.sqlite3");
+    let writer = Connection::open(&path).unwrap();
+    writer.execute_batch("PRAGMA journal_mode=WAL; CREATE TABLE example(id INTEGER PRIMARY KEY); INSERT INTO example VALUES(1);").unwrap();
+    sqlite_wal::checkpoint(&writer).unwrap();
+    let reader = Connection::open(&path).unwrap();
+    reader
+        .execute_batch("BEGIN; SELECT * FROM example;")
+        .unwrap();
+    writer.execute("INSERT INTO example VALUES(2)", []).unwrap();
+    assert!(
+        sqlite_wal::checkpoint(&writer)
+            .unwrap_err()
+            .to_string()
+            .contains("checkpoint blocked")
+    );
+    drop(reader);
+    sqlite_wal::full(&writer).unwrap();
+}
diff --git a/engine/src/state_migration/sqlite_file.rs b/engine/src/state_migration/sqlite_file.rs
new file mode 100644
index 0000000..9da2b48
--- /dev/null
+++ b/engine/src/state_migration/sqlite_file.rs
@@ -0,0 +1,301 @@
+use super::{
+    MigrationArgs, MigrationResult, archive, importer_lock, sqlite_parity,
+    sqlite_tables::{self, Table},
+    target_path, transfer,
+};
+use crate::workers::state::adapters::sqlite::database;
+use anyhow::{Context, ensure};
+use rusqlite::{Connection, OpenFlags, params, types::Value};
+use sha2::{Digest, Sha256};
+use std::{
+    fs::{self, OpenOptions},
+    io::Write,
+    path::{Path, PathBuf},
+};
+
+fn sidecar(path: &Path, suffix: &str) -> PathBuf {
+    let mut name = path.as_os_str().to_owned();
+    name.push(suffix);
+    PathBuf::from(name)
+}
+
+fn frozen(source: &Path) -> anyhow::Result<()> {
+    for suffix in ["-wal", "-journal"] {
+        let file = sidecar(source, suffix);
+        let bytes = match fs::metadata(&file) {
+            Ok(metadata) => metadata.len(),
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => 0,
+            Err(error) => {
+                return Err(error)
+                    .with_context(|| format!("Cannot inspect frozen journal {}", file.display()));
+            }
+        };
+        ensure!(
+            bytes == 0,
+            "Frozen source has a nonempty journal; stop writers and checkpoint before migration"
+        );
+    }
+    ensure!(
+        !sidecar(source, ".migration-pending").exists(),
+        "Source migration is incomplete"
+    );
+    Ok(())
+}
+
+fn copy_table(
+    input: &Connection,
+    output: &mut Connection,
+    table: &Table,
+    args: &MigrationArgs,
+    target: &Path,
+    stop_after: Option<u64>,
+    total: &mut u64,
+) -> anyhow::Result<()> {
+    if table.name == "state_rows" {
+        return super::sqlite_state::copy(input, output, table, args, target, stop_after, total);
+    }
+    if table.name == "retrieval_name_grams" {
+        return super::sqlite_simple::copy(input, output, table, args, target, stop_after, total);
+    }
+    if table.name == "retrieval_membership" {
+        ensure!(
+            table.columns == ["epoch", "observation", "key", "position"] && table.keys == [0, 1, 2],
+            "Unsupported membership table layout"
+        );
+        return super::sqlite_bulk::copy(
+            input,
+            output,
+            args,
+            &args.source,
+            target,
+            stop_after,
+            total,
+        );
+    }
+    let (last, count, complete) = sqlite_tables::checkpoint(output, &table.name)?;
+    *total += count;
+    if complete {
+        return Ok(());
+    }
+    super::sqlite_indexes::defer_table(input, output, &table.name)?;
+    super::sqlite_wal::pending_normal(output)?;
+    let started = std::time::Instant::now();
+    let mut peak_wal = 0;
+    let mut cursor = sqlite_tables::parse_cursor(&last)?;
+    let mut count = count;
+    let mut writer = sqlite_tables::Writer::new();
+    loop {
+        let sql = format!("{} LIMIT 4096", table.select(false, !cursor.is_empty()));
+        let mut query = input.prepare(&sql)?;
+        let mut rows = query.query(rusqlite::params_from_iter(&cursor))?;
+        let transaction = output.transaction()?;
+        let mut batch = 0u64;
+        let mut bytes = 0usize;
+        while let Some(row) = rows.next()? {
+            let values = (0..table.columns.len())
+                .map(|i| row.get::<_, Value>(i))
+                .collect::<rusqlite::Result<Vec<_>>>()?;
+            bytes += values
+                .iter()
+                .map(|v| match v {
+                    Value::Text(v) => v.len(),
+                    Value::Blob(v) => v.len(),
+                    _ => 8,
+                })
+                .sum::<usize>();
+            ensure!(
+                bytes <= 32 * 1024 * 1024,
+                "Migration row exceeds bounded batch memory"
+            );
+            cursor = table.keys.iter().map(|i| values[*i].clone()).collect();
+            writer.write(input, &transaction, table, values, args.reverse)?;
+            count += 1;
+            batch += 1;
+            if bytes >= 4 * 1024 * 1024 || stop_after.is_some_and(|limit| *total + batch >= limit) {
+                break;
+            }
+        }
+        drop(rows);
+        drop(query);
+        transaction.execute("INSERT INTO shadow_transfer_progress(name,cursor,count,complete) VALUES(?1,?2,?3,?4) ON CONFLICT(name) DO UPDATE SET cursor=excluded.cursor,count=excluded.count,complete=excluded.complete",params![table.name,sqlite_tables::cursor(&cursor)?,i64::try_from(count)?,batch==0])?;
+        transaction.commit()?;
+        *total += batch;
+        transfer::check_budget(target, args.disk_budget_bytes)?;
+        let interrupted = stop_after.is_some_and(|limit| *total >= limit);
+        peak_wal = peak_wal.max(super::sqlite_wal::after_commit(
+            output,
+            target,
+            batch == 0 || interrupted,
+        )?);
+        if interrupted {
+            super::sqlite_wal::full(output)?;
+            anyhow::bail!("Synthetic segment interruption at durable checkpoint");
+        }
+        if batch == 0 {
+            break;
+        }
+    }
+    eprintln!(
+        "shadow migration table={} rows={count} seconds={:.3} peak_wal_bytes={peak_wal}",
+        table.name,
+        started.elapsed().as_secs_f64()
+    );
+    Ok(())
+}
+
+pub(super) fn run(
+    args: &MigrationArgs,
+    source: &Path,
+    stop_after: Option<u64>,
+) -> anyhow::Result<MigrationResult> {
+    frozen(source)?;
+    let target = target_path(source, &args.target)?;
+    ensure!(target != source, "Shadow target must differ from source");
+    let _lock = importer_lock(&target)?;
+    let required = fs::metadata(source)?
+        .len()
+        .saturating_mul(2)
+        .saturating_add(64 * 1024 * 1024);
+    ensure!(
+        args.disk_budget_bytes >= required,
+        "Reserve at least twice frozen file bytes plus 64 MiB"
+    );
+    let source_digest = archive::file_digest(source)?;
+    let identity = serde_json::to_string(
+        &serde_json::json!({"format":"sqlite-shadow-transfer-v2","source":source.to_string_lossy(),"bytes":fs::metadata(source)?.len(),"sha256":source_digest,"reverse":args.reverse}),
+    )?;
+    let input = Connection::open_with_flags(source, OpenFlags::SQLITE_OPEN_READ_ONLY)?;
+    input.execute_batch("PRAGMA query_only=ON; PRAGMA cache_size=-16384; PRAGMA mmap_size=0; PRAGMA temp_store=FILE; BEGIN")?;
+    let version: i64 = input.pragma_query_value(None, "user_version", |r| r.get(0))?;
+    let application: i64 = input.pragma_query_value(None, "application_id", |r| r.get(0))?;
+    ensure!(
+        application == database::APPLICATION_ID && version == if args.reverse { 2 } else { 1 },
+        "Source storage version does not match migration direction"
+    );
+    for name in ["state_migration", "shadow_transfer"] {
+        let exists: bool = input.query_row(
+            "SELECT EXISTS(SELECT 1 FROM sqlite_master WHERE name=?1)",
+            [name],
+            |r| r.get(0),
+        )?;
+        if exists {
+            let status: String = input.query_row(
+                &format!(
+                    "SELECT status FROM {} WHERE id=1",
+                    sqlite_tables::quote(name)
+                ),
+                [],
+                |r| r.get(0),
+            )?;
+            ensure!(status == "ready", "Source migration metadata is incomplete");
+        }
+    }
+    let tables = sqlite_tables::tables(&input, args.reverse)?;
+    ensure!(
+        tables.iter().any(|t| t.name == "state_rows")
+            && tables.iter().any(|t| t.name == "state_scopes"),
+        "Source lacks state tables"
+    );
+    let marker = sidecar(&target, ".migration-pending");
+    if marker.exists() {
+        ensure!(
+            fs::read_to_string(&marker)? == identity,
+            "Frozen source identity changed"
+        );
+    }
+    if target.exists() {
+        let prior = Connection::open_with_flags(&target, OpenFlags::SQLITE_OPEN_READ_ONLY)?;
+        let count: i64 = prior.query_row(
+            "SELECT count(*) FROM sqlite_master WHERE type='table'",
+            [],
+            |r| r.get(0),
+        )?;
+        if count == 0 {
+            ensure!(
+                marker.exists(),
+                "Existing empty target is not an owned shadow"
+            );
+        } else {
+            let prior_identity: String = prior
+                .query_row("SELECT identity FROM shadow_transfer WHERE id=1", [], |r| {
+                    r.get(0)
+                })
+                .context("Existing target is not an owned resumable shadow")?;
+            ensure!(
+                prior_identity == identity,
+                "Frozen source identity changed; retain old shadow"
+            );
+        }
+    }
+    if !marker.exists() {
+        let mut file = OpenOptions::new()
+            .create_new(true)
+            .write(true)
+            .open(&marker)?;
+        file.write_all(identity.as_bytes())?;
+        file.sync_all()?;
+    }
+    let mut output =
+        Connection::open_with_flags(&target, OpenFlags::default() | OpenFlags::SQLITE_OPEN_URI)?;
+    output.execute_batch("PRAGMA journal_mode=WAL; PRAGMA synchronous=FULL; PRAGMA cache_size=-65536; PRAGMA mmap_size=0; PRAGMA temp_store=FILE; PRAGMA wal_autocheckpoint=1024; PRAGMA foreign_keys=OFF;")?;
+    let page_size: i64 = output.pragma_query_value(None, "page_size", |r| r.get(0))?;
+    output.pragma_update(
+        None,
+        "max_page_count",
+        i64::try_from(args.disk_budget_bytes / u64::try_from(page_size)?)?,
+    )?;
+    let exists: bool = output.query_row(
+        "SELECT EXISTS(SELECT 1 FROM sqlite_master WHERE name='shadow_transfer')",
+        [],
+        |r| r.get(0),
+    )?;
+    if !exists {
+        let transaction = output.transaction()?;
+        super::sqlite_schema::initialize(&input, &transaction, args.reverse)?;
+        super::sqlite_schema::fence(&input, &transaction, &identity)?;
+        transaction.execute_batch("CREATE TABLE shadow_transfer(id INTEGER PRIMARY KEY CHECK(id=1),identity TEXT NOT NULL,status TEXT NOT NULL); CREATE TABLE shadow_transfer_progress(name TEXT PRIMARY KEY,cursor TEXT NOT NULL,count INTEGER NOT NULL,complete INTEGER NOT NULL) WITHOUT ROWID;")?;
+        transaction.execute(
+            "INSERT INTO shadow_transfer VALUES(1,?1,'pending')",
+            [&identity],
+        )?;
+        transaction.pragma_update(None, "application_id", database::APPLICATION_ID)?;
+        transaction.pragma_update(None, "user_version", if args.reverse { 1 } else { 2 })?;
+        transaction.commit()?;
+    }
+    output.execute_batch("BEGIN IMMEDIATE; UPDATE state_migration SET status='pending' WHERE id=1; UPDATE shadow_transfer SET status='pending' WHERE id=1; COMMIT")?;
+    let mut total = 0;
+    for table in &tables {
+        copy_table(
+            &input,
+            &mut output,
+            table,
+            args,
+            &target,
+            stop_after,
+            &mut total,
+        )?;
+    }
+    super::sqlite_indexes::finish(&input, &output, &target, args.disk_budget_bytes)?;
+    super::sqlite_wal::full(&output)?;
+    sqlite_parity::verify(&input, &output, &tables, args.reverse)?;
+    frozen(source)?;
+    ensure!(
+        archive::file_digest(source)? == source_digest,
+        "Frozen source changed during migration"
+    );
+    output.execute_batch("BEGIN IMMEDIATE; UPDATE state_migration SET status='ready' WHERE id=1; UPDATE shadow_transfer SET status='ready' WHERE id=1; COMMIT")?;
+    super::sqlite_wal::checkpoint(&output)?;
+    transfer::check_budget(&target, args.disk_budget_bytes)?;
+    let scopes: i64 = output.query_row("SELECT count(*) FROM state_scopes", [], |r| r.get(0))?;
+    drop(output);
+    drop(input);
+    fs::remove_file(marker)?;
+    Ok(MigrationResult {
+        status: "ready",
+        target: target.to_string_lossy().into_owned(),
+        scopes: usize::try_from(scopes)?,
+        records: total,
+        source_retained: true,
+        source_manifest_sha256: format!("{:x}", Sha256::digest(identity.as_bytes())),
+    })
+}
diff --git a/engine/src/state_migration/sqlite_indexes.rs b/engine/src/state_migration/sqlite_indexes.rs
new file mode 100644
index 0000000..2c54993
--- /dev/null
+++ b/engine/src/state_migration/sqlite_indexes.rs
@@ -0,0 +1,164 @@
+use super::{sqlite_tables, sqlite_wal, transfer};
+use anyhow::ensure;
+use rusqlite::{Connection, OptionalExtension};
+use std::path::Path;
+
+const INDEXES: [(&str, &str, [&str; 2], bool); 3] = [
+    (
+        "retrieval_membership_key",
+        "retrieval_membership",
+        ["epoch", "key"],
+        false,
+    ),
+    (
+        "retrieval_name_grams_key",
+        "retrieval_name_grams",
+        ["epoch", "key"],
+        false,
+    ),
+    (
+        "state_rows_order",
+        "state_rows",
+        ["scope", "position"],
+        true,
+    ),
+];
+
+pub(super) fn deferred(name: &str) -> bool {
+    INDEXES.iter().any(|index| index.0 == name)
+}
+
+fn definition(
+    input: &Connection,
+    index: (&str, &str, [&str; 2], bool),
+) -> anyhow::Result<Option<String>> {
+    let (name, table, expected, partial) = index;
+    let sql: Option<String> = input
+        .query_row(
+            "SELECT sql FROM sqlite_master WHERE type='index' AND name=?1 AND tbl_name=?2",
+            [name, table],
+            |row| row.get(0),
+        )
+        .optional()?;
+    if sql.is_some() {
+        let columns = input
+            .prepare(&format!(
+                "PRAGMA index_info({})",
+                sqlite_tables::quote(name)
+            ))?
+            .query_map([], |row| row.get::<_, String>(2))?
+            .collect::<rusqlite::Result<Vec<_>>>()?;
+        ensure!(
+            columns == expected,
+            "Unsupported secondary index columns: {name}"
+        );
+        let flags = input
+            .prepare(&format!(
+                "PRAGMA index_list({})",
+                sqlite_tables::quote(table)
+            ))?
+            .query_map([], |row| {
+                Ok((
+                    row.get::<_, String>(1)?,
+                    row.get::<_, bool>(2)?,
+                    row.get::<_, String>(3)?,
+                    row.get::<_, bool>(4)?,
+                ))
+            })?
+            .collect::<rusqlite::Result<Vec<_>>>()?;
+        ensure!(
+            flags
+                .iter()
+                .any(|flag| flag == &(name.into(), false, "c".into(), partial)),
+            "Unsupported secondary index constraint: {name}"
+        );
+        let sql = sql.as_ref().unwrap();
+        ensure!(!sql.contains(';'), "Unsupported secondary index statement");
+        if partial {
+            let normalized = sql
+                .split_whitespace()
+                .collect::<Vec<_>>()
+                .join(" ")
+                .to_ascii_uppercase();
+            ensure!(
+                normalized.ends_with("WHERE VALUE IS NOT NULL"),
+                "Unsupported state order predicate"
+            );
+        }
+    }
+    Ok(sql)
+}
+
+pub(super) fn defer(input: &Connection, output: &Connection) -> anyhow::Result<()> {
+    defer_table(input, output, "retrieval_membership")
+}
+
+pub(super) fn defer_table(
+    input: &Connection,
+    output: &Connection,
+    table: &str,
+) -> anyhow::Result<()> {
+    for index in INDEXES.iter().copied().filter(|index| index.1 == table) {
+        if definition(input, index)?.is_some() {
+            output.execute_batch(&format!(
+                "DROP INDEX IF EXISTS {}",
+                sqlite_tables::quote(index.0)
+            ))?;
+        }
+    }
+    Ok(())
+}
+
+pub(super) fn finish(
+    input: &Connection,
+    output: &Connection,
+    target: &Path,
+    budget: u64,
+) -> anyhow::Result<()> {
+    for index in INDEXES {
+        finish_one(input, output, target, budget, index)?;
+    }
+    Ok(())
+}
+
+fn finish_one(
+    input: &Connection,
+    output: &Connection,
+    target: &Path,
+    budget: u64,
+    index: (&str, &str, [&str; 2], bool),
+) -> anyhow::Result<()> {
+    let name = index.0;
+    let Some(sql) = definition(input, index)? else {
+        return Ok(());
+    };
+    ensure!(!sql.contains(';'), "Unsupported secondary index statement");
+    let exists: bool = output.query_row(
+        "SELECT EXISTS(SELECT 1 FROM sqlite_master WHERE type='index' AND name=?1)",
+        [name],
+        |row| row.get(0),
+    )?;
+    if !exists {
+        let started = std::time::Instant::now();
+        sqlite_wal::full(output)?;
+        // A large atomic index sort must not create an unbounded WAL. DELETE journals retain FULL durability.
+        let mode: String =
+            output.query_row("PRAGMA main.journal_mode=DELETE", [], |row| row.get(0))?;
+        ensure!(mode == "delete", "Cannot enter durable index build mode");
+        output.execute_batch(&sql)?;
+        transfer::check_budget(target, budget)?;
+        let mode: String =
+            output.query_row("PRAGMA main.journal_mode=WAL", [], |row| row.get(0))?;
+        ensure!(mode == "wal", "Cannot restore shadow WAL mode");
+        sqlite_wal::checkpoint(output)?;
+        eprintln!(
+            "shadow migration index={name} seconds={:.3}",
+            started.elapsed().as_secs_f64()
+        );
+    }
+    ensure!(
+        definition(output, index)?.is_some(),
+        "Restored secondary index missing: {name}"
+    );
+    Ok(())
+}
diff --git a/engine/src/state_migration/sqlite_parity.rs b/engine/src/state_migration/sqlite_parity.rs
new file mode 100644
index 0000000..0bc5b0d
--- /dev/null
+++ b/engine/src/state_migration/sqlite_parity.rs
@@ -0,0 +1,93 @@
+use super::sqlite_tables::{self, Table};
+use anyhow::ensure;
+use rusqlite::{Connection, types::Value};
+
+fn compare(
+    input: &Connection,
+    output: &Connection,
+    table: &Table,
+    input_sql: &str,
+    output_sql: &str,
+    reverse: bool,
+) -> anyhow::Result<u64> {
+    let mut left = input.prepare(input_sql)?;
+    let mut right = output.prepare(output_sql)?;
+    let mut left = left.query([])?;
+    let mut right = right.query([])?;
+    let mut count = 0;
+    loop {
+        let a = left.next()?;
+        let b = right.next()?;
+        match (a, b) {
+            (None, None) => break,
+            (Some(a), Some(b)) => {
+                let values = |row: &rusqlite::Row<'_>| {
+                    (0..table.columns.len())
+                        .map(|i| row.get::<_, Value>(i))
+                        .collect::<rusqlite::Result<Vec<_>>>()
+                };
+                let a = sqlite_tables::logical_row(table, values(a)?, reverse)?;
+                let mut b = sqlite_tables::logical_row(table, values(b)?, !reverse)?;
+                if table.name == "state_migration" {
+                    ensure!(
+                        a[2] == Value::Text("ready".into())
+                            && b[2] == Value::Text("pending".into()),
+                        "Migration metadata fence is not held during parity"
+                    );
+                    b[2] = a[2].clone();
+                }
+                ensure!(
+                    a == b,
+                    "Exact streaming parity mismatch in {} at ordinal {}",
+                    table.name,
+                    count
+                );
+                count += 1;
+            }
+            _ => anyhow::bail!(
+                "Exact row count mismatch in {} at ordinal {}",
+                table.name,
+                count
+            ),
+        }
+    }
+    Ok(count)
+}
+
+pub(super) fn verify(
+    input: &Connection,
+    output: &Connection,
+    tables: &[Table],
+    reverse: bool,
+) -> anyhow::Result<()> {
+    input.execute_batch("PRAGMA cache_size=-65536")?;
+    output.execute_batch("PRAGMA cache_size=-1048576")?;
+    for table in tables {
+        let started = std::time::Instant::now();
+        let count = compare(
+            input,
+            output,
+            table,
+            &table.select(reverse, false),
+            &table.select(!reverse, false),
+            reverse,
+        )?;
+        eprintln!("exact parity table={} rows={count}", table.name);
+        eprintln!(
+            "shadow verification parity_table={} seconds={:.3}",
+            table.name,
+            started.elapsed().as_secs_f64()
+        );
+        if table.name == "retrieval_membership" {
+            // Equal logical tuples and simultaneous EOF prove both inclusions, including every position.
+            eprintln!(
+                "exact bidirectional membership parity source_to_target={count} target_to_source={count} simultaneous_eof=true"
+            );
+        }
+    }
+    // Frozen source identity is checked before and after transfer. Exact decoded
+    // streams above prove both inclusions; target indexes are built atomically.
+    // A second source/index full walk adds HDD I/O without changing that proof.
+    super::sqlite_verification::target_checks(output)?;
+    Ok(())
+}
diff --git a/engine/src/state_migration/sqlite_replay_tests.rs b/engine/src/state_migration/sqlite_replay_tests.rs
