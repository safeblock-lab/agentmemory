 const MIN_SAVE_INTERVAL_MS: u64 = 100;
+const STATE_PAGE_CURSOR_VERSION: u8 = 1;
+
+#[derive(Debug, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct StatePageCursor {
+    version: u8,
+    generation: Uuid,
+    scope_fingerprint: String,
+    revision: u64,
+    next_offset: u64,
+}
+
+#[derive(Default)]
+struct JsonSizeCounter(usize);
+
+impl Write for JsonSizeCounter {
+    fn write(&mut self, bytes: &[u8]) -> std::io::Result<usize> {
+        self.0 = self.0.saturating_add(bytes.len());
+        Ok(bytes.len())
+    }
+
+    fn flush(&mut self) -> std::io::Result<()> {
+        Ok(())
+    }
+}
+
+fn serialized_json_len<T: Serialize>(value: &T) -> Result<usize, StatePageError> {
+    let mut counter = JsonSizeCounter::default();
+    serde_json::to_writer(&mut counter, value).map_err(|_| StatePageError::Internal)?;
+    Ok(counter.0)
+}
+
+fn state_page_scope_fingerprint(scope: &str) -> String {
+    URL_SAFE_NO_PAD.encode(Sha256::digest(scope.as_bytes()))
+}
+
+fn encode_state_page_cursor(cursor: &StatePageCursor) -> Result<String, StatePageError> {
+    let bytes = serde_json::to_vec(cursor).map_err(|_| StatePageError::Internal)?;
+    let encoded = URL_SAFE_NO_PAD.encode(bytes);
+    if encoded.len() > STATE_PAGE_MAX_CURSOR_BYTES {
+        return Err(StatePageError::Internal);
+    }
+    Ok(encoded)
+}
+
+fn decode_state_page_cursor(cursor: &str) -> Result<StatePageCursor, StatePageError> {
+    if cursor.len() > STATE_PAGE_MAX_CURSOR_BYTES {
+        return Err(StatePageError::InvalidCursor);
+    }
+    let bytes = URL_SAFE_NO_PAD
+        .decode(cursor)
+        .map_err(|_| StatePageError::InvalidCursor)?;
+    let decoded: StatePageCursor =
+        serde_json::from_slice(&bytes).map_err(|_| StatePageError::InvalidCursor)?;
+    if decoded.version != STATE_PAGE_CURSOR_VERSION {
+        return Err(StatePageError::InvalidCursor);
+    }
+    Ok(decoded)
+}
 
