+use super::*;
+
+fn oversized_summary(session: &str, project: &str, bytes: usize) -> Value {
+    json!({
+        "sessionId": session,
+        "project": project,
+        "body": "x".repeat(bytes),
+    })
+}
+
+fn prepare_oversized_catalog(connection: &Connection) {
+    connection
+        .execute(
+            "UPDATE retrieval_project_catalog SET revision='0' WHERE source='summaries'",
+            [],
+        )
+        .unwrap();
+    call(
+        connection,
+        json!({
+            "action": "project_catalog_prepare",
+            "source": "summaries",
+            "max_rows": 16,
+            "max_bytes": 65_536,
+        }),
+    )
+    .unwrap();
+}
+
+fn unknown_page(connection: &Connection) -> Value {
+    call(
+        connection,
+        json!({
+            "action": "project_catalog_unknowns",
+            "source": "summaries",
+            "limit": 16,
+            "max_bytes": 65_536,
+        }),
+    )
+    .unwrap()
+}
+
+fn repair_request(page: &Value, key: &str) -> Value {
+    let unknown = page["items"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .find(|item| item["key"] == key)
+        .unwrap();
+    json!({
+        "action": "project_catalog_repair_unknown",
+        "source": "summaries",
+        "key": key,
+        "expected_version": unknown["version"],
+        "expected_revision": page["revision"],
+        "expected_epoch": page["epoch"].as_str().unwrap().parse::<i64>().unwrap(),
+        "expected_cursor": page["catalog_cursor"].as_str().unwrap().parse::<i64>().unwrap(),
+    })
+}
+
+fn source_snapshot(connection: &Connection, key: &str) -> (String, i64, Vec<u8>, i64) {
+    connection
+        .query_row(
+            "SELECT CAST(version AS TEXT),value_bytes,value,position FROM state_rows WHERE scope='mem:summaries' AND key=?1",
+            [key],
+            |row| Ok((row.get(0)?, row.get(1)?, row.get(2)?, row.get(3)?)),
+        )
+        .unwrap()
+}
+
+fn catalog_snapshot(connection: &Connection) -> (String, i64, String, i64, i64) {
+    super::super::project_catalog::catalog_row(connection, "summaries").unwrap()
+}
+
+fn project_count(connection: &Connection, project: &str) -> i64 {
+    connection
+        .query_row(
+            "SELECT COALESCE((SELECT ref_count FROM retrieval_project_counts WHERE source='summaries' AND epoch=(SELECT epoch FROM retrieval_project_catalog WHERE source='summaries') AND project=?1),0)",
+            [project],
+            |row| row.get(0),
+        )
+        .unwrap()
+}
+
+#[test]
+fn project_catalog_repair_oversized_summaries_one_at_a_time_preserves_sources_and_snapshot() {
+    let connection = fresh();
+    write(
+        &connection,
+        "mem:summaries",
+        "summary-a",
+        Some(&oversized_summary("session-a", "project-a", 70_000)),
+    );
+    write(
+        &connection,
+        "mem:summaries",
+        "summary-b",
+        Some(&oversized_summary("session-b", "project-b", 150_000)),
+    );
+    prepare_oversized_catalog(&connection);
+
+    let source_a_before = source_snapshot(&connection, "summary-a");
+    let source_b_before = source_snapshot(&connection, "summary-b");
+    assert!(source_a_before.1 > 65_536);
+    assert!(source_b_before.1 > 65_536);
+    let page_before = unknown_page(&connection);
+    assert_eq!(page_before["items"].as_array().unwrap().len(), 2);
+    assert_eq!(page_before["incomplete_rows"], "2");
+    let catalog_before = catalog_snapshot(&connection);
+    let epoch = catalog_before.3;
+    let cursor = catalog_before.1;
+
+    let first_request = repair_request(&page_before, "summary-a");
+    let first = call(&connection, first_request.clone()).unwrap();
+    assert_eq!(first["repaired"], true);
+    assert_eq!(first["project"], "project-a");
+    assert_eq!(first["incomplete_rows"], "1");
+    assert_eq!(source_snapshot(&connection, "summary-a"), source_a_before);
+    assert_eq!(source_snapshot(&connection, "summary-b"), source_b_before);
+    assert_eq!(project_count(&connection, "project-a"), 1);
+    assert_eq!(project_count(&connection, "project-b"), 0);
+    assert_eq!(catalog_snapshot(&connection).1, cursor);
+    assert_eq!(catalog_snapshot(&connection).3, epoch);
+
+    let page_after_first = unknown_page(&connection);
+    assert_eq!(page_after_first["items"].as_array().unwrap().len(), 1);
+    assert_eq!(page_after_first["items"][0]["key"], "summary-b");
+    let second = call(&connection, repair_request(&page_after_first, "summary-b")).unwrap();
+    assert_eq!(second["repaired"], true);
+    assert_eq!(second["project"], "project-b");
+    assert_eq!(second["incomplete_rows"], "0");
+    assert_eq!(source_snapshot(&connection, "summary-a"), source_a_before);
+    assert_eq!(source_snapshot(&connection, "summary-b"), source_b_before);
+    assert_eq!(project_count(&connection, "project-a"), 1);
+    assert_eq!(project_count(&connection, "project-b"), 1);
+    let catalog_after = catalog_snapshot(&connection);
+    assert_eq!(catalog_after.1, cursor);
+    assert_eq!(catalog_after.2, catalog_before.2);
+    assert_eq!(catalog_after.3, epoch);
+    assert_eq!(catalog_after.4, 0);
+
+    let writes_before_replay = connection.total_changes();
+    let replay = call(&connection, first_request).unwrap();
+    assert_eq!(replay["status"], "already_repaired");
+    assert_eq!(replay["repaired"], false);
+    assert_eq!(connection.total_changes(), writes_before_replay);
+    assert_eq!(project_count(&connection, "project-a"), 1);
+}
+
+#[test]
+fn project_catalog_repair_rejects_stale_missing_and_invalid_selection_without_effects() {
+    let connection = fresh();
+    write(
+        &connection,
+        "mem:summaries",
+        "summary-a",
+        Some(&oversized_summary("session-a", "project-a", 70_000)),
+    );
+    prepare_oversized_catalog(&connection);
+    let page = unknown_page(&connection);
+    let valid = repair_request(&page, "summary-a");
+
+    let writes_before_stale = connection.total_changes();
+    let mut stale = valid.clone();
+    stale["expected_version"] = json!("999");
+    assert_eq!(
+        code(call(&connection, stale).unwrap_err()),
+        "STATE_RETRIEVAL_STALE_CURSOR"
+    );
+    assert_eq!(connection.total_changes(), writes_before_stale);
+
+    let mut missing = valid.clone();
+    missing["key"] = json!("not-selected");
+    assert_eq!(
+        code(call(&connection, missing).unwrap_err()),
+        "STATE_RETRIEVAL_STALE_CURSOR"
+    );
+    assert_eq!(connection.total_changes(), writes_before_stale);
+
+    for (field, value) in [("expected_epoch", json!(0)), ("expected_cursor", json!(-2))] {
+        let mut invalid = valid.clone();
+        invalid[field] = value;
+        assert_eq!(
+            code(call(&connection, invalid).unwrap_err()),
+            "STATE_TX_INVALID_REQUEST"
+        );
+        assert_eq!(connection.total_changes(), writes_before_stale);
+    }
+    let mut invalid_version = valid;
+    invalid_version["expected_version"] = json!("not-a-counter");
+    assert_eq!(
+        code(call(&connection, invalid_version).unwrap_err()),
+        "STATE_TX_INVALID_REQUEST"
+    );
+    assert_eq!(connection.total_changes(), writes_before_stale);
+}
+
+#[test]
+fn project_catalog_repair_rejects_malformed_authority_and_logical_size_over_limit() {
+    let connection = fresh();
+    write(
+        &connection,
+        "mem:summaries",
+        "summary-malformed",
+        Some(&json!({"sessionId":"session-malformed","project":42,"body":"x".repeat(70_000)})),
+    );
+    write(
+        &connection,
+        "mem:summaries",
+        "summary-too-large",
+        Some(&oversized_summary(
+            "session-large",
+            "project-large",
+            270_000,
+        )),
+    );
+    prepare_oversized_catalog(&connection);
+    let page = unknown_page(&connection);
+    assert_eq!(page["items"].as_array().unwrap().len(), 2);
+
+    for (key, expected_error) in [
+        ("summary-malformed", "STATE_TX_INVALID_REQUEST"),
+        ("summary-too-large", "STATE_RETRIEVAL_RESOURCE_LIMIT"),
+    ] {
+        let request = repair_request(&page, key);
+        let writes_before = connection.total_changes();
+        assert_eq!(
+            code(call(&connection, request).unwrap_err()),
+            expected_error
+        );
+        assert_eq!(connection.total_changes(), writes_before);
+    }
+    assert_eq!(catalog_snapshot(&connection).4, 2);
+    assert_eq!(project_count(&connection, "project-malformed"), 0);
+    assert_eq!(project_count(&connection, "project-large"), 0);
+}
+
+#[test]
+fn project_catalog_repair_preserves_partial_status_before_terminal_cursor() {
+    let connection = fresh();
+    write(
+        &connection,
+        "mem:summaries",
+        "summary-a",
+        Some(&oversized_summary("session-a", "project-a", 70_000)),
+    );
+    prepare_oversized_catalog(&connection);
+    let position = source_snapshot(&connection, "summary-a").3;
+    connection
+        .execute(
+            "UPDATE retrieval_project_catalog SET cursor=?1,status='partial' WHERE source='summaries'",
+            [position - 1],
+        )
+        .unwrap();
+    let page = unknown_page(&connection);
+    assert_eq!(page["status"], "partial");
+
+    let repaired = call(&connection, repair_request(&page, "summary-a")).unwrap();
+
+    assert_eq!(repaired["status"], "partial");
+    assert_eq!(catalog_snapshot(&connection).0, "partial");
+    assert_eq!(catalog_snapshot(&connection).1, position - 1);
+    assert_eq!(catalog_snapshot(&connection).4, 0);
+}
