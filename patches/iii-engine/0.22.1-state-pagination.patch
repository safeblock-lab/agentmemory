+    }
+    job.ordinal=job.ordinal.checked_add(1).ok_or_else(||anyhow::anyhow!("STATE_TX_LIMIT_EXCEEDED"))?;
+    let result=json!({"job":job,"physical_reclaimed_bytes":null});
+    c.execute("INSERT INTO compact_root_job VALUES(1,?1) ON CONFLICT(singleton) DO UPDATE SET value=excluded.value",[serde_json::to_string(&job)?])?;
+    c.execute("INSERT INTO compact_root_receipts VALUES(?1,?2,?3)",params![r.operation_id,serde_json::to_string(&r)?,serde_json::to_string(&result)?])?;
+    Ok(result)
+}
+fn page(c:&Connection,r:&Request,j:&mut Job)->anyhow::Result<()> {
