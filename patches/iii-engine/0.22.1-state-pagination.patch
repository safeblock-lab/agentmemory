+    adapter.run(4096,|connection|{connection.execute("UPDATE state_rows SET version='18446744073709551615' WHERE scope='s' AND key='precise'",[])?;Ok(())}).await.unwrap();
+    assert_eq!(
+        code(adapter.set("s", "precise", json!(3)).await.unwrap_err()),
