@@ -0,0 +1,124 @@
+use super::{lsh, semantic};
+use rusqlite::{Connection, params};
+use serde_json::{Value, json};
+use std::collections::HashSet;
+struct Match {
+    id: String,
+    session: String,
+    score: f64,
+}
+fn rank(a: &Match, b: &Match) -> std::cmp::Ordering {
+    b.score.total_cmp(&a.score).then(a.id.cmp(&b.id))
+}
+pub fn search(
+    c: &Connection,
+    id: &str,
+    model: &str,
+    dimensions: usize,
+    generation: &str,
+    embedding: &str,
+    limit: usize,
+    max_candidates: usize,
+    probes: usize,
+    options: super::search_projection::Options<'_>,
+) -> anyhow::Result<Value> {
+    let meta = semantic::get(c, id)?;
+    meta.identity(model, dimensions, generation)?;
+    if options.source_scope.is_some() || options.source_kind.is_some() || options.include_text {
+        super::super::protocol::require(super::source::kind(c, id)?.is_some())?;
+    }
+    if options.project.is_some() {
+        return super::scoped::semantic_search(
+            c,
+            &meta,
+            embedding,
+            limit,
+            max_candidates,
+            probes,
+            options,
+        );
+    }
+    meta.ready(c)?;
+    let query = lsh::decode(embedding, dimensions)?;
+    let buckets: Vec<_> = lsh::signatures(&query)
+        .iter()
+        .map(|signature| lsh::buckets(signature, probes))
+        .collect();
+    let sql = format!(
+        "SELECT p.id,v.session_id,v.embedding FROM retrieval_vector_postings p CROSS JOIN retrieval_vectors v WHERE p.index_id=?1 AND p.epoch=?2 AND p.table_id=?3 AND p.bucket=?4 AND v.index_id=p.index_id AND v.epoch=p.epoch AND v.id=p.id AND (?5 IS NULL OR v.session_id=?5) {} ORDER BY p.id LIMIT ?8",
+        super::search_projection::filter("?6", "?7")
+    );
+    let mut statement = c.prepare_cached(&sql)?;
+    let mut seen = HashSet::with_capacity(max_candidates.min(4096));
+    let mut matches: Vec<Match> = Vec::with_capacity(limit);
+    let mut bytes = 0;
+    let mut visits = 0;
+    let max_visits = max_candidates.saturating_mul(lsh::TABLES);
+    let bucket_limit = (max_candidates / lsh::TABLES).max(16);
+    let mut exhausted = false;
+    'probe: for probe in 0..probes {
+        for (table, buckets) in buckets.iter().enumerate() {
+            let mut rows = statement.query(params![
+                id,
+                meta.epoch,
+                table as i64,
+                buckets[probe],
+                options.session_id,
+                options.source_scope,
+                options.source_kind,
+                (bucket_limit + 1) as i64
+            ])?;
+            let mut count = 0;
+            while let Some(row) = rows.next()? {
+                visits += 1;
+                count += 1;
+                if visits > max_visits {
+                    exhausted = true;
+                    break 'probe;
+                }
+                if count > bucket_limit {
+                    exhausted = true;
+                    break;
+                }
+                let id: String = row.get(0)?;
+                if seen.contains(&id) {
+                    continue;
+                }
+                if seen.len() >= max_candidates || bytes + id.len() > 4 * 1024 * 1024 {
+                    exhausted = true;
+                    break 'probe;
+                }
+                bytes += id.len();
+                seen.insert(id.clone());
+                let vector = lsh::from_blob(&row.get::<_, Vec<u8>>(2)?, dimensions)?;
+                let candidate = Match {
+                    id,
+                    session: row.get(1)?,
+                    score: lsh::cosine(&query, &vector),
+                };
+                if matches.len() < limit
+                    || rank(&candidate, matches.last().expect("bounded top results")).is_lt()
+                {
+                    matches.push(candidate);
+                    matches.sort_unstable_by(rank);
+                    matches.truncate(limit);
+                }
+            }
+        }
+    }
+    let mut items: Vec<Value> = matches
+        .into_iter()
+        .map(|v| json!({"obsId":v.id,"sessionId":v.session,"score":v.score}))
+        .collect();
+    let projection = super::search_projection::enrich(c, id, &mut items, options)?;
+    let reason = if projection.is_some() {
+        projection
+    } else if exhausted {
+        Some("candidate_budget")
+    } else {
+        None
+    };
+    Ok(
+        json!({"items":items,"approximate":true,"candidates":seen.len(),"budget_exhausted":exhausted,"status":if reason.is_some(){"partial"}else{"ready"},"reason":reason,"model":model,"dimensions":dimensions,"generation":generation}),
+    )
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/shared_source_projection.rs b/engine/src/workers/state/adapters/sqlite/retrieval/shared_source_projection.rs
new file mode 100644
index 0000000..27bb0e6
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/shared_source_projection.rs
@@ -0,0 +1,201 @@
+use super::super::{database, protocol};
+use super::{
+    project_catalog, reflect_sources, request::ReflectSource, source_lexical::project_fields,
+};
+use rusqlite::Connection;
+use serde_json::{Value, json};
+use sha2::{Digest, Sha256};
+use std::collections::HashSet;
+
+const FIELDS: &[&str] = &[
+    "id",
+    "project",
+    "sessionId",
+    "title",
+    "narrative",
+    "content",
+    "fact",
+    "confidence",
+    "strength",
+    "concepts",
+    "files",
+    "tags",
+    "sourceMemoryIds",
+    "sourceObservationIds",
+    "sourceIds",
+    "lessons",
+    "keyOutcomes",
+    "filesAffected",
+    "sourceActionIds",
+    "createdAt",
+    "updatedAt",
+    "timestamp",
+    "type",
+    "deleted",
+    "stale",
+    "isLatest",
+    "supersededBy",
+    "forgetAfter",
+];
+
+fn session_ids(value: &Value) -> anyhow::Result<Result<Vec<String>, &'static str>> {
+    let mut ids = Vec::new();
+    let mut seen = HashSet::new();
+    for field in ["sessionId", "sessionIds", "sourceSessionIds"] {
+        let Some(reference) = value.get(field) else {
+            continue;
+        };
+        let references: Vec<&Value> = if field == "sessionId" {
+            vec![reference]
+        } else {
+            let Some(values) = reference.as_array() else {
+                return Ok(Err("audience_unknown"));
+            };
+            values.iter().collect()
+        };
+        for reference in references {
+            let Some(id) = reference
+                .as_str()
+                .filter(|id| !id.trim().is_empty() && id.len() <= 256)
+            else {
+                return Ok(Err("audience_unknown"));
+            };
+            if seen.insert(id.to_owned()) {
+                ids.push(id.to_owned());
+                if ids.len() > 2048 {
+                    return Ok(Err("resource_limit"));
+                }
+            }
+        }
+    }
+    Ok(Ok(ids))
+}
+
+fn fingerprint(version: &str, value: &Value) -> anyhow::Result<String> {
+    let bytes = serde_json::to_vec(&json!({"version":version,"value":value}))?;
+    Ok(format!("{:x}", Sha256::digest(bytes)))
+}
+
+fn cursor_digest(scope: &str, key: &str, version: &str) -> String {
+    format!(
+        "{:x}",
+        Sha256::digest(format!("{scope}\0{key}\0{version}").as_bytes())
+    )
+}
+
+fn parse_cursor(cursor: &str, scope: &str, key: &str, version: &str) -> anyhow::Result<usize> {
+    let mut parts = cursor.split(':');
+    let prefix = parts.next();
+    let offset = parts.next().and_then(|value| value.parse::<usize>().ok());
+    let saved_version = parts.next();
+    let digest = parts.next();
+    protocol::require(prefix == Some("v1") && parts.next().is_none())?;
+    protocol::require(
+        saved_version == Some(version)
+            && digest == Some(cursor_digest(scope, key, version).as_str()),
+    )?;
+    let offset = offset.ok_or_else(|| super::request::resource())?;
+    protocol::require(offset > 0)?;
+    Ok(offset)
+}
+
+fn next_cursor(scope: &str, key: &str, version: &str, offset: usize) -> String {
+    format!(
+        "v1:{offset}:{version}:{}",
+        cursor_digest(scope, key, version)
+    )
+}
+
+fn project_source(
+    connection: &Connection,
+    source: &ReflectSource,
+) -> anyhow::Result<Result<Value, &'static str>> {
+    let loaded = reflect_sources::load(connection, &source.scope, &source.key)?;
+    let (version, value) = match loaded {
+        Ok(value) => value,
+        Err(reason) => return Ok(Err(reason)),
+    };
+    if source
+        .expected_version
+        .as_ref()
+        .is_some_and(|expected| expected != &version)
+    {
+        return Ok(Err("stale"));
+    }
+    if !reflect_sources::fresh(&value) {
+        return Ok(Err("stale"));
+    }
+    let refs = match session_ids(&value)? {
+        Ok(refs) => refs,
+        Err(reason) => return Ok(Err(reason)),
+    };
+    if value
+        .get("project")
+        .and_then(Value::as_str)
+        .is_none_or(|p| p.trim().is_empty())
+        && refs.is_empty()
+    {
+        return Ok(Err("audience_unknown"));
+    }
+    let offset = source
+        .provenance_cursor
+        .as_deref()
+        .map_or(Ok(0), |cursor| {
+            parse_cursor(cursor, &source.scope, &source.key, &version)
+        })?;
+    if offset >= refs.len() && offset != 0 {
+        return Ok(Err("stale"));
+    }
+    let end = offset.saturating_add(12).min(refs.len());
+    let mut provenance = Vec::with_capacity(end - offset);
+    for session_id in &refs[offset..end] {
+        match project_catalog::resolve_session(connection, session_id)? {
+            Ok(project) => provenance.push(json!({"session_id":session_id,"project":project})),
+            Err(reason) => return Ok(Err(reason)),
+        }
+    }
+    let projected = project_fields(&value, FIELDS);
+    let fp = fingerprint(&version, &projected)?;
+    let cursor = (end < refs.len()).then(|| next_cursor(&source.scope, &source.key, &version, end));
+    let status = if cursor.is_some() { "partial" } else { "ready" };
+    let mut item = json!({"scope":source.scope,"key":source.key,"version":version,"fingerprint":fp,
+        "value":projected,"provenance":provenance,"status":status});
+    if let Some(cursor) = cursor {
+        item["next_cursor"] = json!(cursor);
+    }
+    if status == "partial" {
+        item["reason"] = json!("provenance_page");
+    }
+    Ok(Ok(item))
+}
+
+pub fn execute(
+    connection: &Connection,
+    sources: &[ReflectSource],
+    max_bytes: usize,
+) -> anyhow::Result<Value> {
+    let mut items = Vec::with_capacity(sources.len());
+    let mut deferred = Vec::new();
+    let mut bytes = 128usize;
+    for source in sources {
+        match project_source(connection, source)? {
+            Ok(item) => {
+                let item_bytes = protocol::size(&item)? + 1;
+                if bytes.saturating_add(item_bytes) > max_bytes {
+                    deferred.push(
+                        json!({"scope":source.scope,"key":source.key,"reason":"response_limit"}),
+                    );
+                    continue;
+                }
+                bytes += item_bytes;
+                items.push(item);
+            }
+            Err(reason) => {
+                deferred.push(json!({"scope":source.scope,"key":source.key,"reason":reason}))
+            }
+        }
+    }
+    Ok(
+        json!({"items":items,"deferred":deferred,"status":if deferred.is_empty(){"ready"}else{"partial"},"revision":database::revision(connection,"mem:sessions")?.to_string()}),
+    )
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/source.rs b/engine/src/workers/state/adapters/sqlite/retrieval/source.rs
