@@ -0,0 +1,24 @@
+CREATE TABLE IF NOT EXISTS compact_root_dictionary(id INTEGER PRIMARY KEY,token TEXT NOT NULL UNIQUE);
+CREATE TABLE IF NOT EXISTS compact_root_fields(root INTEGER PRIMARY KEY,scope INTEGER NOT NULL,key INTEGER NOT NULL,version INTEGER NOT NULL,job TEXT NOT NULL);
+CREATE INDEX IF NOT EXISTS compact_root_fields_identity ON compact_root_fields(scope,key,version,root);
+CREATE INDEX IF NOT EXISTS compact_root_job_fields ON compact_root_fields(job,root);
+CREATE INDEX IF NOT EXISTS compact_root_scope_references ON compact_root_fields(scope);
+CREATE INDEX IF NOT EXISTS compact_root_key_references ON compact_root_fields(key);
+CREATE INDEX IF NOT EXISTS compact_root_version_references ON compact_root_fields(version);
+CREATE TABLE IF NOT EXISTS compact_root_originals(root INTEGER PRIMARY KEY,scope TEXT NOT NULL,key TEXT NOT NULL,version TEXT NOT NULL);
+CREATE TABLE IF NOT EXISTS compact_root_sequence(singleton INTEGER PRIMARY KEY CHECK(singleton=1),last_id INTEGER NOT NULL CHECK(last_id>=0));
+INSERT OR IGNORE INTO compact_root_sequence SELECT 1,coalesce(max(n),0) FROM (
+ SELECT max(id) AS n FROM compact_roots UNION ALL SELECT max(root) FROM compact_root_fields UNION ALL SELECT max(root) FROM compact_root_originals
+);
+CREATE TABLE IF NOT EXISTS compact_root_job(singleton INTEGER PRIMARY KEY CHECK(singleton=1),value TEXT NOT NULL);
+CREATE TABLE IF NOT EXISTS compact_root_closed_jobs(job TEXT PRIMARY KEY) WITHOUT ROWID;
+CREATE TABLE IF NOT EXISTS compact_root_receipts(operation_id TEXT PRIMARY KEY,request TEXT NOT NULL,result TEXT NOT NULL) WITHOUT ROWID;
+DROP VIEW IF EXISTS compact_root_values;
+CREATE VIEW compact_root_values AS
+ SELECT r.id,r.scope,r.key,r.version,r.logical_bytes FROM compact_roots r
+ WHERE r.scope<>'' OR r.key<>'' OR r.version<>'' OR NOT EXISTS(SELECT 1 FROM compact_root_fields f WHERE f.root=r.id)
+ UNION ALL
+ SELECT r.id,s.token,k.token,v.token,r.logical_bytes
+ FROM compact_root_fields f JOIN compact_roots r ON r.id=f.root
+ JOIN compact_root_dictionary s ON s.id=f.scope JOIN compact_root_dictionary k ON k.id=f.key JOIN compact_root_dictionary v ON v.id=f.version
+ WHERE r.scope='' AND r.key='' AND r.version='';
diff --git a/engine/src/workers/state/adapters/sqlite/root_fields.rs b/engine/src/workers/state/adapters/sqlite/root_fields.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/root_fields.rs
@@ -0,0 +1,45 @@
+use rusqlite::{params, Connection};
+use serde_json::{json, Value};
+use std::{collections::BTreeSet, time::Instant};
+
+pub(super) fn page(c: &Connection, after: i64, limit: usize, started: &Instant) -> anyhow::Result<Value> {
+    let headers = c.prepare_cached(
+        "SELECT id,length(CAST(scope AS BLOB))+length(CAST(key AS BLOB))+length(CAST(version AS BLOB)) FROM compact_root_values WHERE id>?1 ORDER BY id LIMIT ?2",
+    )?.query_map(params![after, limit as i64], |r| Ok((r.get::<_, i64>(0)?, r.get::<_, i64>(1)?)))?
+        .collect::<rusqlite::Result<Vec<_>>>()?;
+    let mut dictionaries = [BTreeSet::new(), BTreeSet::new(), BTreeSet::new()];
+    let mut source_bytes = 0usize;
+    let mut cursor = after;
+    let mut inspected = 0usize;
+    let mut skipped_large = 0usize;
+    for (id, bytes) in &headers {
+        super::super::database::check_preparation()?;
+        if started.elapsed().as_millis() >= 2200 { break; }
+        anyhow::ensure!(*bytes >= 0, "STATE_COMPACT_CORRUPT");
+        let bytes = usize::try_from(*bytes)?;
+        if bytes > 256 * 1024 {
+            cursor = *id;
+            inspected += 1;
+            skipped_large += 1;
+            continue;
+        }
+        if source_bytes + bytes > 1024 * 1024 { break; }
+        let fields: [String; 3] = c.query_row("SELECT scope,key,version FROM compact_root_values WHERE id=?1", [id], |r| Ok([r.get(0)?, r.get(1)?, r.get(2)?]))?;
+        anyhow::ensure!(fields.iter().map(String::len).sum::<usize>() == bytes, "STATE_COMPACT_CORRUPT");
+        source_bytes += bytes;
+        for (dictionary, field) in dictionaries.iter_mut().zip(fields) { dictionary.insert(field); }
+        cursor = *id;
+        inspected += 1;
+    }
+    let unique_bytes = dictionaries.iter().flat_map(|d| d.iter()).map(String::len).sum::<usize>();
+    Ok(json!({
+        "cursor": cursor, "done": headers.len() < limit && inspected == headers.len(),
+        "inspected": inspected, "skippedLarge": skipped_large,
+        "fieldBytes": source_bytes, "uniqueFieldBytes": unique_bytes,
+        "duplicateFieldBytesUpperBound": source_bytes.saturating_sub(unique_bytes),
+        "dictionaryEntries": dictionaries.iter().map(BTreeSet::len).collect::<Vec<_>>(),
+        "eligibleSavingsLowerBoundBytes": 0,
+        "excludedCosts": ["dictionary rows and indexes", "identity lookup", "root IDs and logical lengths", "migration receipts", "SQLite pages"],
+        "projectionPermitted": false,
+    }))
+}
diff --git a/engine/src/workers/state/adapters/sqlite/search_packed/blocks.rs b/engine/src/workers/state/adapters/sqlite/search_packed/blocks.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/search_packed/blocks.rs
@@ -0,0 +1,35 @@
+use rusqlite::{params, Connection};
+use super::BLOCK;
+
+// Exact ordered compact list v1, unlike numeric-sorted forward delta blocks.
+fn encode(ids: &[i64]) -> anyhow::Result<Vec<u8>> {
+    anyhow::ensure!(!ids.is_empty() && ids.len()<=BLOCK && ids.iter().all(|v| *v>0), "STATE_SEARCH_PACKED_CORRUPT");
+    let width = if ids.iter().all(|v| *v<1<<24) {3} else {8};
+    let mut bytes=vec![1,width as u8];
+    bytes.extend_from_slice(&u32::try_from(ids.len())?.to_le_bytes());
+    for id in ids {bytes.extend_from_slice(&id.to_le_bytes()[..width]);}
+    Ok(bytes)
+}
+
+pub(super) fn members(c: &Connection, payload: &[u8]) -> anyhow::Result<Vec<(String,i64)>> {
+    anyhow::ensure!(payload.len()<=6+BLOCK*8, "STATE_SEARCH_PACKED_CORRUPT");
+    let ids: String=c.query_row("SELECT state_compact_ids(?1)",[payload],|r|r.get(0))?;
+    let expected: Vec<i64>=serde_json::from_str(&ids)?;
+    anyhow::ensure!(!expected.is_empty() && expected.len()<=BLOCK, "STATE_SEARCH_PACKED_CORRUPT");
+    let text_bytes:i64=c.query_row("SELECT COALESCE(sum(length(CAST(i.token AS BLOB))),0) FROM json_each(?1) j JOIN compact_identifiers i ON i.id=j.value",[&ids],|r|r.get(0))?;
+    anyhow::ensure!(text_bytes<=4*1024*1024,"STATE_TX_LIMIT_EXCEEDED");
+    let rows=c.prepare_cached("SELECT json_extract(i.token,'$'),i.id FROM json_each(?1) j CROSS JOIN compact_identifiers i ON i.id=j.value WHERE json_type(i.token,'$')='text' ORDER BY CAST(j.key AS INTEGER)")?
+        .query_map([ids],|r|Ok((r.get::<_,String>(0)?,r.get::<_,i64>(1)?)))?
+        .collect::<rusqlite::Result<Vec<_>>>()?;
+    anyhow::ensure!(rows.len()==expected.len() && rows.iter().map(|r|r.1).eq(expected) && rows.windows(2).all(|r|r[0].0.as_bytes()<r[1].0.as_bytes()), "STATE_SEARCH_PACKED_CORRUPT");
+    Ok(rows)
+}
+
+pub(super) fn save(c: &Connection, index: &str, epoch: i64, table: usize, bucket: u16, rows: &[(String,i64)]) -> anyhow::Result<()> {
+    anyhow::ensure!(table<12 && bucket<4096 && rows.windows(2).all(|r|r[0].0.as_bytes()<r[1].0.as_bytes()), "STATE_SEARCH_PACKED_CORRUPT");
+    for part in rows.chunks(BLOCK) {
+        let payload=encode(&part.iter().map(|r|r.1).collect::<Vec<_>>())?;
+        c.execute("INSERT INTO search_packed_blocks VALUES(?1,?2,?3,?4,?5,?6)", params![index,epoch,table as i64,bucket,part[0].0,payload])?;
+    }
+    Ok(())
+}
diff --git a/engine/src/workers/state/adapters/sqlite/search_packed/buckets.rs b/engine/src/workers/state/adapters/sqlite/search_packed/buckets.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/search_packed/buckets.rs
@@ -0,0 +1,57 @@
+use rusqlite::{params, Connection, OptionalExtension};
+use serde::{Deserialize, Serialize};
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+pub struct Cursor {pub revision: i64, pub after: String}
+pub struct Page {pub ids: Vec<String>, pub cursor: Option<Cursor>}
+
+pub(super) fn edit(c: &Connection,index: &str,epoch: i64,table: usize,bucket: u16,id: &str,identifier: i64,remove: bool) -> anyhow::Result<()> {
+    let mut block:Option<(String,Vec<u8>)>=c.query_row("SELECT first,payload FROM search_packed_blocks WHERE index_id=?1 AND epoch=?2 AND table_id=?3 AND bucket=?4 AND first<=?5 COLLATE BINARY ORDER BY first DESC LIMIT 1",params![index,epoch,table as i64,bucket,id],|r|Ok((r.get(0)?,r.get(1)?))).optional()?;
+    if block.is_none() {
+        block=c.query_row("SELECT first,payload FROM search_packed_blocks WHERE index_id=?1 AND epoch=?2 AND table_id=?3 AND bucket=?4 ORDER BY first LIMIT 1",params![index,epoch,table as i64,bucket],|r|Ok((r.get(0)?,r.get(1)?))).optional()?;
+    }
+    let mut rows=block.as_ref().map(|(_,b)|super::blocks::members(c,b)).transpose()?.unwrap_or_default();
+    match (rows.binary_search_by(|r|r.0.as_bytes().cmp(id.as_bytes())),remove) {
+        (Ok(at),true)=>{anyhow::ensure!(rows[at].1==identifier,"STATE_SEARCH_PACKED_CORRUPT");rows.remove(at);},
+        (Err(at),false)=>rows.insert(at,(id.to_owned(),identifier)),
+        (Ok(at),false)=>anyhow::ensure!(rows[at].1==identifier,"STATE_SEARCH_PACKED_CORRUPT"),
+        _=>return Ok(()),
+    }
+    if let Some((first,_))=block {c.execute("DELETE FROM search_packed_blocks WHERE index_id=?1 AND epoch=?2 AND table_id=?3 AND bucket=?4 AND first=?5",params![index,epoch,table as i64,bucket,first])?;}
+    // Split overflowing blocks in halves so repeated middle insertions stay bounded.
+    if rows.len()>super::BLOCK {
+        super::blocks::save(c,index,epoch,table,bucket,&rows[..32])?;
+        super::blocks::save(c,index,epoch,table,bucket,&rows[32..])?;
+    } else {super::blocks::save(c,index,epoch,table,bucket,&rows)?;}
+    Ok(())
+}
+
+// Continue inside one read snapshot. Apply eligibility before bucket limit/visits.
+// A cursor is bound to its caller's index/epoch/table/bucket/filter and snapshot.
+pub fn read_page(c: &Connection,index: &str,epoch: i64,table: usize,bucket: u16,cursor: Option<&Cursor>,max_blocks: usize,mut eligible: impl FnMut(&str)->anyhow::Result<bool>) -> anyhow::Result<Page> {
+    super::require_transaction(c)?;
+    anyhow::ensure!(table<12 && bucket<4096 && (1..=64).contains(&max_blocks),"STATE_TX_INVALID_REQUEST");
+    let revision=super::revision(c)?;
+    anyhow::ensure!(cursor.is_none_or(|v|v.revision==revision),"STATE_SEARCH_PACKED_STALE");
+    let row=|r:&rusqlite::Row<'_>|Ok((r.get::<_,String>(0)?,r.get::<_,Vec<u8>>(1)?));
+    let blocks=if let Some(cursor)=cursor {
+        c.prepare_cached("SELECT first,payload FROM search_packed_blocks WHERE index_id=?1 AND epoch=?2 AND table_id=?3 AND bucket=?4 AND first>?5 COLLATE BINARY ORDER BY first LIMIT ?6")?
+            .query_map(params![index,epoch,table as i64,bucket,cursor.after,(max_blocks+1) as i64],row)?.collect::<rusqlite::Result<Vec<_>>>()?
+    } else {
+        c.prepare_cached("SELECT first,payload FROM search_packed_blocks WHERE index_id=?1 AND epoch=?2 AND table_id=?3 AND bucket=?4 ORDER BY first LIMIT ?5")?
+            .query_map(params![index,epoch,table as i64,bucket,(max_blocks+1) as i64],row)?.collect::<rusqlite::Result<Vec<_>>>()?
+    };
+    let more=blocks.len()>max_blocks;
+    let mut ids=Vec::new();let mut bytes=0usize;
+    for (first,payload) in blocks.iter().take(max_blocks) {
+        let rows=super::blocks::members(c,payload)?;
+        anyhow::ensure!(rows.first().is_some_and(|r|&r.0==first),"STATE_SEARCH_PACKED_CORRUPT");
+        for (id,_) in rows {if eligible(&id)? {
+            bytes=bytes.saturating_add(id.len());
+            anyhow::ensure!(bytes<=4*1024*1024,"STATE_TX_LIMIT_EXCEEDED");
+            ids.push(id);
+        }}
+    }
+    let cursor=if more {Some(Cursor{revision,after:blocks[max_blocks-1].0.clone()})} else {None};
+    Ok(Page{ids,cursor})
+}
diff --git a/engine/src/workers/state/adapters/sqlite/search_packed/maintenance.rs b/engine/src/workers/state/adapters/sqlite/search_packed/maintenance.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/search_packed/maintenance.rs
@@ -0,0 +1,166 @@
+mod proof;
+use rusqlite::{params,Connection,OptionalExtension};
+use serde::{Deserialize,Serialize};
+use serde_json::{json,Value};
+use std::time::{Duration,Instant};
+use super::super::{protocol::Guard,storage_repack};
+
+#[derive(Clone,Serialize,Deserialize)]
+#[serde(rename_all="snake_case")]
+pub enum Step {Begin,Copy,Verify,Activate,Rollback,Retire,Collect}
+#[derive(Clone,Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Request {
+    pub operation_id:String,pub job_id:String,pub expected_ordinal:u64,pub step:Step,
+    pub max_ms:u64,pub max_bytes:usize,pub limit:usize,
+    pub owner_id:String,pub fence:u64,pub guard:Guard,
+}
+impl Request {
+    pub fn validate(&self)->anyhow::Result<()> {
+        anyhow::ensure!((1..=100000).contains(&self.limit) && (1..=3000).contains(&self.max_ms)
+            && (16384..=4*1024*1024).contains(&self.max_bytes)
+            && !self.operation_id.is_empty() && self.operation_id.len()<=128
+            && !self.job_id.is_empty() && self.job_id.len()<=96,"STATE_TX_INVALID_REQUEST");
+        Ok(())
+    }
+}
+#[derive(Default,Serialize,Deserialize)]
+struct Job {
+    id:String,phase:String,ordinal:u64,
+    source_cursor:Option<(String,i64,String)>,
+    inverse_cursor:Option<(String,i64,i64)>,
+    block_cursor:Option<(String,i64,i64,i64,String)>,
+    previous_last:Option<String>,proof_revision:Option<i64>,
+    #[serde(default)] gc_complete:bool,
+}
+
+fn load(c:&Connection)->anyhow::Result<Job> {
+    let raw:Option<String>=c.query_row("SELECT value FROM search_packed_job WHERE singleton=1",[],|r|r.get(0)).optional()?;
+    Ok(raw.map(|v|serde_json::from_str(&v)).transpose()?.unwrap_or_default())
+}
+pub fn status(c:&Connection)->anyhow::Result<Value> {
+    Ok(serde_json::to_value(load(c)?)?)
+}
+
+pub fn execute(c:&Connection,r:Request)->anyhow::Result<Value> {
+    super::require_transaction(c)?;
+    r.validate()?;
+    let lease=storage_repack::Request{operation_id:r.operation_id.clone(),job_id:r.job_id.clone(),expected_ordinal:r.expected_ordinal,
+        step:if matches!(r.step,Step::Activate|Step::Rollback|Step::Retire){storage_repack::Step::Cut}else{storage_repack::Step::Copy},
+        max_ms:r.max_ms,max_bytes:r.max_bytes,limit:r.limit,owner_id:r.owner_id.clone(),fence:r.fence,guard:r.guard.clone()};
+    storage_repack::leases(c,&lease)?;
+    let request=serde_json::to_string(&r)?;
+    let prior:Option<(String,String)>=c.query_row("SELECT request,result FROM search_packed_receipts WHERE operation_id=?1",[&r.operation_id],|r|Ok((r.get(0)?,r.get(1)?))).optional()?;
+    if let Some((saved,result))=prior {
+        anyhow::ensure!(saved==request,"STATE_TX_REPLAY_CONFLICT");
+        return Ok(serde_json::from_str(&result)?);
+    }
+    let mut job=load(c)?;
+    anyhow::ensure!(job.ordinal==r.expected_ordinal,"STATE_TX_CONFLICT");
+    if matches!(r.step,Step::Begin) {
+        anyhow::ensure!(job.phase.is_empty(),"STATE_TX_CONFLICT");
+        let empty:bool=c.query_row("SELECT NOT EXISTS(SELECT 1 FROM search_packed_blocks) AND NOT EXISTS(SELECT 1 FROM search_packed_inverse)",[],|r|r.get(0))?;
+        anyhow::ensure!(empty,"STATE_SEARCH_PACKED_CORRUPT");
+        job.id=r.job_id.clone();job.phase="copy".into();
+        c.execute("UPDATE search_packed_config SET writing=1,active=0 WHERE singleton=1",[])?;
+    } else {
+        anyhow::ensure!(job.id==r.job_id,"STATE_TX_CONFLICT");
+        match r.step {
+            Step::Copy=>copy(c,&r,&mut job)?,
+            Step::Verify=>proof::verify(c,&r,&mut job)?,
+            Step::Activate=>{
+                anyhow::ensure!(job.phase=="ready" && job.proof_revision==Some(super::revision(c)?),"STATE_SEARCH_PACKED_PROOF_REQUIRED");
+                c.execute("UPDATE search_packed_config SET active=1 WHERE singleton=1",[])?;
+                job.phase="cut".into();
+            },
+            Step::Rollback=>{
+                anyhow::ensure!(job.phase=="cut" && !super::retiring(c)?,"STATE_SEARCH_PACKED_ROLLBACK_RETIRED");
+                c.execute("UPDATE search_packed_config SET active=0 WHERE singleton=1",[])?;
+                job.phase="rollback".into();
+            },
+            Step::Retire=>{
+                super::super::database::combined_format(c)?;
+                anyhow::ensure!(["cut","retiring"].contains(&job.phase.as_str()),"STATE_TX_CONFLICT");
+                c.execute("UPDATE search_packed_retirement SET retired=1 WHERE singleton=1",[])?;
+                c.execute("DELETE FROM retrieval_vector_postings WHERE (index_id,epoch,table_id,bucket,id) IN(SELECT index_id,epoch,table_id,bucket,id FROM retrieval_vector_postings ORDER BY index_id,epoch,table_id,bucket,id LIMIT ?1)",[r.limit as i64])?;
+                let more:bool=c.query_row("SELECT EXISTS(SELECT 1 FROM retrieval_vector_postings)",[],|v|v.get(0))?;
+                job.phase=if more {"retiring"}else{"retired"}.into();
+            },
+            Step::Collect=>collect(c,&r,&mut job)?,
+            Step::Begin=>unreachable!(),
+        }
+    }
+    job.ordinal=job.ordinal.checked_add(1).ok_or_else(||anyhow::anyhow!("STATE_TX_LIMIT_EXCEEDED"))?;
+    let result=json!({"job":job,"original_retained":!super::retiring(c)?,"physical_reclaimed_bytes":null});
+    c.execute("INSERT INTO search_packed_job VALUES(1,?1) ON CONFLICT(singleton) DO UPDATE SET value=excluded.value",[serde_json::to_string(&job)?])?;
+    c.execute("INSERT INTO search_packed_receipts VALUES(?1,?2,?3)",params![r.operation_id,request,serde_json::to_string(&result)?])?;
+    Ok(result)
+}
+
+fn bounded_collect<T>(rows:impl Iterator<Item=rusqlite::Result<T>>,maximum:usize,cost:impl Fn(&T)->usize)->anyhow::Result<(Vec<T>,bool)> {
+    let mut values=Vec::new();let mut bytes=0usize;
+    for value in rows {
+        let value=value?;let size=cost(&value);
+        anyhow::ensure!(size<=maximum,"STATE_TX_LIMIT_EXCEEDED");
+        if bytes.saturating_add(size)>maximum {return Ok((values,false));}
+        bytes+=size;values.push(value);
+    }
+    Ok((values,true))
+}
+fn source_page(c:&Connection,job:&Job,limit:usize,maximum:usize)->anyhow::Result<(Vec<(String,i64,String)>,bool)> {
+    let row=|r:&rusqlite::Row<'_>|Ok((r.get::<_,String>(0)?,r.get::<_,i64>(1)?,r.get::<_,String>(2)?));
+    let cost=|v:&(String,i64,String)|v.0.len()+v.2.len()+24;
+    if let Some((index,epoch,id))=&job.source_cursor {
+        bounded_collect(c.prepare_cached("SELECT DISTINCT index_id,epoch,id FROM retrieval_vector_postings INDEXED BY retrieval_vector_postings_id WHERE (index_id,epoch,id)>(?1,?2,?3) ORDER BY index_id,epoch,id LIMIT ?4")?
+            .query_map(params![index,epoch,id,limit as i64],row)?,maximum,cost)
+    } else {
+        bounded_collect(c.prepare_cached("SELECT DISTINCT index_id,epoch,id FROM retrieval_vector_postings INDEXED BY retrieval_vector_postings_id ORDER BY index_id,epoch,id LIMIT ?1")?
+            .query_map([limit as i64],row)?,maximum,cost)
+    }
+}
+
+fn copy(c:&Connection,r:&Request,job:&mut Job)->anyhow::Result<()> {
+    anyhow::ensure!(job.phase=="copy","STATE_TX_CONFLICT");
+    let start=Instant::now();let mut bytes=0usize;let mut processed=0;
+    let (rows,exhausted)=source_page(c,job,r.limit,r.max_bytes)?;
+    for (index,epoch,id) in &rows {
+        let cost=id.len().saturating_add(index.len()).saturating_add(24);
+        anyhow::ensure!(cost<=r.max_bytes,"STATE_TX_LIMIT_EXCEEDED");
+        if start.elapsed()>=Duration::from_millis(r.max_ms.saturating_sub(500).max(1)) || bytes.saturating_add(cost)>r.max_bytes {break;}
+        let signatures=super::signatures::source(c,index,*epoch,id)?;
+        super::signatures::apply(c,index,*epoch,id,signatures.as_ref())?;
+        job.source_cursor=Some((index.clone(),*epoch,id.clone()));bytes+=cost;processed+=1;
+    }
+    if exhausted && processed==rows.len() && rows.len()<r.limit {
+        job.phase="verify_source".into();job.source_cursor=None;
+        job.proof_revision=Some(super::revision(c)?);
+    }
+    Ok(())
+}
+
+pub fn receipt(c:&Connection,r:&Request)->anyhow::Result<Value> {
+    let prior:Option<(String,String)>=c.query_row("SELECT request,result FROM search_packed_receipts WHERE operation_id=?1",[&r.operation_id],|v|Ok((v.get(0)?,v.get(1)?))).optional()?;
+    if let Some((saved,result))=prior {
+        anyhow::ensure!(saved==serde_json::to_string(r)?,"STATE_TX_REPLAY_CONFLICT");
+        return Ok(json!({"status":"applied","result":serde_json::from_str::<Value>(&result)?}));
+    }
+    Ok(json!({"status":"not_found"}))
+}
+
+fn collect(c:&Connection,r:&Request,job:&mut Job)->anyhow::Result<()> {
+    anyhow::ensure!(["retired","collecting"].contains(&job.phase.as_str()) && super::retiring(c)?,"STATE_TX_CONFLICT");
+    if job.phase=="retired" {job.phase="collecting".into();job.inverse_cursor=None;job.gc_complete=false;}
+    let cursor=job.inverse_cursor.clone().unwrap_or_default();
+    let mut statement=c.prepare_cached("SELECT p.index_id,p.epoch,p.identifier,json_extract(i.token,'$') FROM search_packed_inverse p JOIN compact_identifiers i ON i.id=p.identifier WHERE (p.index_id,p.epoch,p.identifier)>(?1,?2,?3) ORDER BY p.index_id,p.epoch,p.identifier LIMIT ?4")?;
+    let (rows,exhausted)=bounded_collect(statement.query_map(params![cursor.0,cursor.1,cursor.2,r.limit as i64],|v|Ok((v.get::<_,String>(0)?,v.get::<_,i64>(1)?,v.get::<_,i64>(2)?,v.get::<_,String>(3)?)))?,r.max_bytes,|v|v.0.len()+v.3.len()+32)?;
+    let start=Instant::now();let mut processed=0;
+    for (index,epoch,identifier,id) in &rows {
+        super::super::database::check_preparation()?;
+        if start.elapsed()>=Duration::from_millis(r.max_ms.saturating_sub(500).max(1)){break;}
+        let live:bool=c.query_row("SELECT EXISTS(SELECT 1 FROM retrieval_vectors WHERE index_id=?1 AND epoch=?2 AND id=?3)",params![index,epoch,id],|v|v.get(0))?;
+        if !live {super::signatures::apply(c,index,*epoch,id,None)?;}
+        job.inverse_cursor=Some((index.clone(),*epoch,*identifier));processed+=1;
+    }
+    if exhausted && processed==rows.len() && rows.len()<r.limit {job.phase="retired".into();job.gc_complete=true;job.inverse_cursor=None;}
+    Ok(())
+}
diff --git a/engine/src/workers/state/adapters/sqlite/search_packed/maintenance/proof.rs b/engine/src/workers/state/adapters/sqlite/search_packed/maintenance/proof.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/search_packed/maintenance/proof.rs
@@ -0,0 +1,78 @@
+use super::{Job,Request,source_page,bounded_collect};
+use rusqlite::{params,Connection};
+use std::time::{Duration,Instant};
+
+pub(super) fn verify(c:&Connection,r:&Request,job:&mut Job)->anyhow::Result<()> {
+    anyhow::ensure!(["verify_source","verify_inverse","verify_blocks","ready","rollback"].contains(&job.phase.as_str()),"STATE_TX_CONFLICT");
+    let revision=super::super::revision(c)?;
+    if job.phase=="rollback" || job.proof_revision!=Some(revision) {
+        job.phase="verify_source".into();job.source_cursor=None;job.inverse_cursor=None;
+        job.block_cursor=None;job.previous_last=None;job.proof_revision=Some(revision);
+    }
+    let started=Instant::now();let mut bytes=0usize;
+    let mut allowed=|cost:usize|->anyhow::Result<bool> {
+        anyhow::ensure!(cost<=r.max_bytes,"STATE_TX_LIMIT_EXCEEDED");
+        if started.elapsed()>=Duration::from_millis(r.max_ms.saturating_sub(500).max(1)) || bytes.saturating_add(cost)>r.max_bytes {return Ok(false);}
+        bytes+=cost;Ok(true)
+    };
+    if job.phase=="verify_source" {
+        let (rows,exhausted)=source_page(c,job,r.limit,r.max_bytes)?;let mut done=0;
+        for (index,epoch,id) in &rows {
+            if !allowed(index.len()+id.len()+24)? {break;}
+            super::super::signatures::compare(c,index,*epoch,id)?;
+            job.source_cursor=Some((index.clone(),*epoch,id.clone()));done+=1;
+        }
+        if exhausted && done==rows.len() && rows.len()<r.limit {job.phase="verify_inverse".into();}
+    } else if job.phase=="verify_inverse" {
+        let row=|r:&rusqlite::Row<'_>|Ok((r.get::<_,String>(0)?,r.get::<_,i64>(1)?,r.get::<_,i64>(2)?,r.get::<_,Option<String>>(3)?));
+        let (rows,exhausted)=if let Some((index,epoch,identifier))=&job.inverse_cursor {
+            bounded_collect(c.prepare_cached("SELECT p.index_id,p.epoch,p.identifier,CASE WHEN json_type(i.token,'$')='text' THEN json_extract(i.token,'$') END FROM search_packed_inverse p LEFT JOIN compact_identifiers i ON i.id=p.identifier WHERE (p.index_id,p.epoch,p.identifier)>(?1,?2,?3) ORDER BY p.index_id,p.epoch,p.identifier LIMIT ?4")?
+                .query_map(params![index,epoch,identifier,r.limit as i64],row)?,r.max_bytes,|v:&(String,i64,i64,Option<String>)|v.0.len()+v.3.as_ref().map_or(0,String::len)+32)?
+        } else {
+            bounded_collect(c.prepare_cached("SELECT p.index_id,p.epoch,p.identifier,CASE WHEN json_type(i.token,'$')='text' THEN json_extract(i.token,'$') END FROM search_packed_inverse p LEFT JOIN compact_identifiers i ON i.id=p.identifier ORDER BY p.index_id,p.epoch,p.identifier LIMIT ?1")?
+                .query_map([r.limit as i64],row)?,r.max_bytes,|v:&(String,i64,i64,Option<String>)|v.0.len()+v.3.as_ref().map_or(0,String::len)+32)?
+        };
+        let mut done=0;
+        for (index,epoch,identifier,id) in &rows {
+            let id=id.as_deref().ok_or_else(||anyhow::anyhow!("STATE_SEARCH_PACKED_PROOF_FAILED"))?;
+            if !allowed(index.len()+id.len()+24)? {break;}
+            // Catch dangling dictionary roots as well as extra inverse records.
+            anyhow::ensure!(super::super::signatures::source(c,index,*epoch,id)?.is_some(),"STATE_SEARCH_PACKED_PROOF_FAILED");
+            super::super::signatures::compare(c,index,*epoch,id)?;
+            job.inverse_cursor=Some((index.clone(),*epoch,*identifier));done+=1;
+        }
+        if exhausted && done==rows.len() && rows.len()<r.limit {job.phase="verify_blocks".into();}
+    } else if job.phase=="verify_blocks" {
+        verify_blocks(c,r,job,&mut allowed)?;
+    }
+    Ok(())
+}
+
+fn verify_blocks(c:&Connection,r:&Request,job:&mut Job,allowed:&mut impl FnMut(usize)->anyhow::Result<bool>)->anyhow::Result<()> {
+    let row=|r:&rusqlite::Row<'_>|Ok((r.get::<_,String>(0)?,r.get::<_,i64>(1)?,r.get::<_,i64>(2)?,r.get::<_,i64>(3)?,r.get::<_,String>(4)?,r.get::<_,Vec<u8>>(5)?));
+    let (rows,exhausted)=if let Some((index,epoch,table,bucket,first))=&job.block_cursor {
+        bounded_collect(c.prepare_cached("SELECT index_id,epoch,table_id,bucket,first,payload FROM search_packed_blocks WHERE (index_id,epoch,table_id,bucket,first)>(?1,?2,?3,?4,?5) ORDER BY index_id,epoch,table_id,bucket,first LIMIT ?6")?
+            .query_map(params![index,epoch,table,bucket,first,r.limit as i64],row)?,r.max_bytes,|v:&(String,i64,i64,i64,String,Vec<u8>)|v.0.len()+v.4.len()+v.5.len()+48)?
+    } else {
+        bounded_collect(c.prepare_cached("SELECT index_id,epoch,table_id,bucket,first,payload FROM search_packed_blocks ORDER BY index_id,epoch,table_id,bucket,first LIMIT ?1")?
+            .query_map([r.limit as i64],row)?,r.max_bytes,|v:&(String,i64,i64,i64,String,Vec<u8>)|v.0.len()+v.4.len()+v.5.len()+48)?
+    };
+    let mut done=0;
+    for (index,epoch,table,bucket,first,payload) in &rows {
+        if !allowed(index.len()+first.len()+payload.len())? {break;}
+        let members=super::super::blocks::members(c,payload)?;
+        anyhow::ensure!(members[0].0==*first,"STATE_SEARCH_PACKED_PROOF_FAILED");
+        if job.block_cursor.as_ref().is_some_and(|k|k.0==*index && k.1==*epoch && k.2==*table && k.3==*bucket) {
+            anyhow::ensure!(job.previous_last.as_ref().is_some_and(|s|s.as_bytes()<first.as_bytes()),"STATE_SEARCH_PACKED_PROOF_FAILED");
+        }
+        for (id,identifier) in &members {
+            let bytes:Vec<u8>=c.query_row("SELECT signatures FROM search_packed_inverse WHERE index_id=?1 AND epoch=?2 AND identifier=?3",params![index,epoch,identifier],|r|r.get(0))?;
+            let signatures=super::super::signatures::decode(&bytes)?;
+            anyhow::ensure!((0..12).contains(table) && signatures[*table as usize] as i64==*bucket && super::super::signatures::source(c,index,*epoch,id)?==Some(signatures),"STATE_SEARCH_PACKED_PROOF_FAILED");
+        }
+        job.previous_last=members.last().map(|r|r.0.clone());
+        job.block_cursor=Some((index.clone(),*epoch,*table,*bucket,first.clone()));done+=1;
+    }
+    if exhausted && done==rows.len() && rows.len()<r.limit {job.phase="ready".into();}
+    Ok(())
+}
diff --git a/engine/src/workers/state/adapters/sqlite/search_packed/mod.rs b/engine/src/workers/state/adapters/sqlite/search_packed/mod.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/search_packed/mod.rs
@@ -0,0 +1,53 @@
+mod blocks;
+mod buckets;
+mod maintenance;
+mod physical;
+mod signatures;
+
+use rusqlite::Connection;
+pub use buckets::{Page, Cursor, read_page};
+pub use maintenance::{Request, Step, execute, status, receipt};
+pub use physical::measure;
+pub use signatures::{replace,packed_signature};
+
+pub const BLOCK: usize = 64;
+pub const TABLES: usize = 12;
+
+// Loaded as a sibling of compact and storage_maintenance_lease by Main.
+pub fn schema(c: &Connection) -> anyhow::Result<()> {
+    anyhow::ensure!(!c.is_autocommit(), "STATE_TX_INVALID_REQUEST");
+    c.execute_batch(include_str!("schema.sql"))?;
+    Ok(())
+}
+
+pub fn active(c: &Connection) -> anyhow::Result<bool> {
+    Ok(c.query_row("SELECT active FROM search_packed_config WHERE singleton=1",[],|r|r.get(0))?)
+}
+
+// A large bucket uses the unchanged source reader, not a truncated packed scan.
+// These are conservative work ceilings, not measured latency or RSS guarantees.
+pub fn retiring(c:&Connection)->anyhow::Result<bool> {
+    Ok(c.query_row("SELECT retired FROM search_packed_retirement WHERE singleton=1",[],|r|r.get(0))?)
+}
+
+pub fn bounded_bucket(c:&Connection,index:&str,epoch:i64,table:usize,bucket:u16,dimensions:usize)->anyhow::Result<bool> {
+    if retiring(c)? {return Ok(true);}
+    let (count,text):(i64,i64)=c.query_row("SELECT count(*),COALESCE(sum(n),0) FROM (SELECT length(CAST(id AS BLOB)) AS n FROM retrieval_vector_postings WHERE index_id=?1 AND epoch=?2 AND table_id=?3 AND bucket=?4 LIMIT 4097)",rusqlite::params![index,epoch,table as i64,bucket],|r|Ok((r.get(0)?,r.get(1)?)))?;
+    let vector_bytes=usize::try_from(count)?.checked_mul(dimensions).and_then(|v|v.checked_mul(4));
+    Ok(count<=4096 && text<=1024*1024 && vector_bytes.is_some_and(|v|v<=16*1024*1024))
+}
+
+fn require_transaction(c: &Connection) -> anyhow::Result<()> {
+    anyhow::ensure!(!c.is_autocommit(), "STATE_TX_INVALID_REQUEST");
+    Ok(())
+}
+
+fn revision(c: &Connection) -> anyhow::Result<i64> {
+    Ok(c.query_row("SELECT revision FROM search_packed_config WHERE singleton=1", [], |r| r.get(0))?)
+}
+
+fn changed(c: &Connection) -> anyhow::Result<()> {
+    c.execute("UPDATE search_packed_config SET revision=revision+1 WHERE singleton=1 AND revision<9223372036854775807", [])?;
+    anyhow::ensure!(c.changes()==1, "STATE_TX_LIMIT_EXCEEDED");
+    Ok(())
+}
diff --git a/engine/src/workers/state/adapters/sqlite/search_packed/physical.rs b/engine/src/workers/state/adapters/sqlite/search_packed/physical.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/search_packed/physical.rs
@@ -0,0 +1,19 @@
+use rusqlite::{Connection,params};
+use serde_json::{json,Value};
+
+// Diagnostic only: Main supplies measured union retention/index costs from the
+// same snapshot. None means no net claim, never zero-cost identifier retention.
+pub fn measure(c: &Connection, union_retention_bytes: Option<u64>) -> anyhow::Result<Value> {
+    super::require_transaction(c)?;
+    let bytes=|prefix:&str| -> anyhow::Result<u64> {
+        let value:i64=c.query_row("SELECT COALESCE(sum(pgsize),0) FROM dbstat WHERE name GLOB ?1",params![prefix],|r|r.get(0))?;
+        Ok(u64::try_from(value)?)
+    };
+    let source=bytes("retrieval_vector_postings*")?;
+    let packed=bytes("search_packed_*")?;
+    let net=union_retention_bytes.map(|cost|i128::from(source)-i128::from(packed)-i128::from(cost));
+    Ok(json!({"source_allocation_bytes":source,"packed_allocation_bytes":packed,
+        "union_retention_bytes":union_retention_bytes,"conditional_net_bytes":net.map(|n|n.to_string()),
+        "physical_reclaimed_bytes":null,"source_retained":true,
+        "qualification":"Conditional steady projection; source retirement, churn fragmentation, complete dictionary/index union and peak overlap require Main admission/measurement."}))
+}
diff --git a/engine/src/workers/state/adapters/sqlite/search_packed/schema.sql b/engine/src/workers/state/adapters/sqlite/search_packed/schema.sql
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/search_packed/schema.sql
@@ -0,0 +1,31 @@
+CREATE TABLE IF NOT EXISTS search_packed_config(
+ singleton INTEGER PRIMARY KEY CHECK(singleton=1),
+ version INTEGER NOT NULL CHECK(version=1),
+ active INTEGER NOT NULL CHECK(active IN(0,1)),
+ writing INTEGER NOT NULL CHECK(writing IN(0,1)),
+ revision INTEGER NOT NULL CHECK(revision>=0)
+);
+INSERT OR IGNORE INTO search_packed_config VALUES(1,1,0,0,0);
+CREATE TABLE IF NOT EXISTS search_packed_blocks(
+ index_id TEXT NOT NULL, epoch INTEGER NOT NULL,
+ table_id INTEGER NOT NULL CHECK(table_id BETWEEN 0 AND 11),
+ bucket INTEGER NOT NULL CHECK(bucket BETWEEN 0 AND 4095),
+ first TEXT COLLATE BINARY NOT NULL, payload BLOB NOT NULL,
+ PRIMARY KEY(index_id,epoch,table_id,bucket,first)
+) WITHOUT ROWID;
+CREATE TABLE IF NOT EXISTS search_packed_inverse(
+ index_id TEXT NOT NULL, epoch INTEGER NOT NULL,
+ identifier INTEGER NOT NULL CHECK(identifier>0), signatures BLOB NOT NULL CHECK(length(signatures)=24),
+ PRIMARY KEY(index_id,epoch,identifier)
+) WITHOUT ROWID;
+CREATE VIEW IF NOT EXISTS search_packed_identifier_roots AS SELECT DISTINCT identifier FROM search_packed_inverse;
+CREATE TRIGGER IF NOT EXISTS search_packed_gc_insert AFTER INSERT ON search_packed_inverse
+BEGIN UPDATE compact_gc_progress SET invalidated=1,done=0 WHERE singleton=1 AND invalidated=0; END;
+CREATE TRIGGER IF NOT EXISTS search_packed_gc_delete AFTER DELETE ON search_packed_inverse
+BEGIN UPDATE compact_gc_progress SET invalidated=1,done=0 WHERE singleton=1 AND invalidated=0; END;
+CREATE TABLE IF NOT EXISTS search_packed_job(singleton INTEGER PRIMARY KEY CHECK(singleton=1),value TEXT NOT NULL);
+CREATE TABLE IF NOT EXISTS search_packed_receipts(
+ operation_id TEXT PRIMARY KEY, request TEXT NOT NULL, result TEXT NOT NULL
+) WITHOUT ROWID;
+
+CREATE TABLE IF NOT EXISTS search_packed_retirement(singleton INTEGER PRIMARY KEY CHECK(singleton=1),retired INTEGER NOT NULL CHECK(retired IN(0,1))); INSERT OR IGNORE INTO search_packed_retirement VALUES(1,0);
diff --git a/engine/src/workers/state/adapters/sqlite/search_packed/signatures.rs b/engine/src/workers/state/adapters/sqlite/search_packed/signatures.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/search_packed/signatures.rs
@@ -0,0 +1,79 @@
+use rusqlite::{params, Connection, OptionalExtension};
+
+pub(super) fn decode(bytes: &[u8]) -> anyhow::Result<[u16;12]> {
+    anyhow::ensure!(bytes.len()==24,"STATE_SEARCH_PACKED_CORRUPT");
+    let mut buckets=[0;12];
+    for (i,part) in bytes.chunks_exact(2).enumerate() {
+        buckets[i]=u16::from_le_bytes([part[0],part[1]]);
+        anyhow::ensure!(buckets[i]<4096,"STATE_SEARCH_PACKED_CORRUPT");
+    }
+    Ok(buckets)
+}
+
+pub(super) fn source(c: &Connection,index: &str,epoch: i64,id: &str) -> anyhow::Result<Option<[u16;12]>> {
+    let rows=c.prepare_cached("SELECT table_id,bucket FROM retrieval_vector_postings WHERE index_id=?1 AND epoch=?2 AND id=?3 ORDER BY table_id,bucket LIMIT 13")?
+        .query_map(params![index,epoch,id],|r|Ok((r.get::<_,i64>(0)?,r.get::<_,i64>(1)?)))?
+        .collect::<rusqlite::Result<Vec<_>>>()?;
+    if rows.is_empty() {return Ok(None);}
+    anyhow::ensure!(rows.len()==12,"STATE_SEARCH_PACKED_INCOMPATIBLE");
+    let mut signatures=[0;12];
+    for (table,(actual,bucket)) in rows.into_iter().enumerate() {
+        anyhow::ensure!(actual==table as i64 && (0..4096).contains(&bucket),"STATE_SEARCH_PACKED_INCOMPATIBLE");
+        signatures[table]=u16::try_from(bucket)?;
+    }
+    Ok(Some(signatures))
+}
+
+fn identifier(c: &Connection,id: &str,create: bool) -> anyhow::Result<Option<i64>> {
+    // SQLite json_quote is the accepted compact identifier's exact spelling.
+    if create {c.execute("INSERT OR IGNORE INTO compact_identifiers(token) VALUES(json_quote(?1))",[id])?;}
+    Ok(c.query_row("SELECT id FROM compact_identifiers WHERE token=json_quote(?1)",[id],|r|r.get(0)).optional()?)
+}
+
+pub(super) fn apply(c: &Connection,index: &str,epoch: i64,id: &str,signatures: Option<&[u16;12]>) -> anyhow::Result<()> {
+    super::require_transaction(c)?;
+    anyhow::ensure!(id.len()<=4*1024*1024 && signatures.is_none_or(|v|v.iter().all(|b|*b<4096)),"STATE_TX_INVALID_REQUEST");
+    let Some(identifier)=identifier(c,id,signatures.is_some())? else {return Ok(())};
+    let previous:Option<Vec<u8>>=c.query_row("SELECT signatures FROM search_packed_inverse WHERE index_id=?1 AND epoch=?2 AND identifier=?3",params![index,epoch,identifier],|r|r.get(0)).optional()?;
+    let old=previous.as_deref().map(decode).transpose()?;
+    if old.as_ref()==signatures {return Ok(());}
+    if let Some(buckets)=old {
+        for (table,bucket) in buckets.into_iter().enumerate() {super::buckets::edit(c,index,epoch,table,bucket,id,identifier,true)?;}
+    }
+    c.execute("DELETE FROM search_packed_inverse WHERE index_id=?1 AND epoch=?2 AND identifier=?3",params![index,epoch,identifier])?;
+    if let Some(buckets)=signatures {
+        for (table,bucket) in buckets.iter().enumerate() {super::buckets::edit(c,index,epoch,table,*bucket,id,identifier,false)?;}
+        let bytes:Vec<u8>=buckets.iter().flat_map(|b|b.to_le_bytes()).collect();
+        c.execute("INSERT INTO search_packed_inverse VALUES(?1,?2,?3,?4)",params![index,epoch,identifier,bytes])?;
+    }
+    super::changed(c)
+}
+
+// Main calls after original posting mutations, in that SAME transaction, also
+// for rebuild/epoch expiry/scoped maintenance. Failure rolls back both sides.
+pub fn replace(c: &Connection,index: &str,epoch: i64,id: &str) -> anyhow::Result<()> {
+    super::require_transaction(c)?;
+    let writing:bool=c.query_row("SELECT writing FROM search_packed_config WHERE singleton=1",[],|r|r.get(0))?;
+    if writing {apply(c,index,epoch,id,source(c,index,epoch,id)?.as_ref())?;}
+    Ok(())
+}
+
+pub(super) fn compare(c: &Connection,index: &str,epoch: i64,id: &str) -> anyhow::Result<()> {
+    let expected=source(c,index,epoch,id)?;
+    let actual:Option<Vec<u8>>=c.query_row("SELECT p.signatures FROM search_packed_inverse p WHERE p.index_id=?1 AND p.epoch=?2 AND p.identifier=(SELECT id FROM compact_identifiers WHERE token=json_quote(?3))",params![index,epoch,id],|r|r.get(0)).optional()?;
+    let actual=actual.as_deref().map(decode).transpose()?;
+    anyhow::ensure!(expected==actual,"STATE_SEARCH_PACKED_PROOF_FAILED");
+    if let Some(buckets)=actual {
+        for (table,bucket) in buckets.into_iter().enumerate() {
+            let payload:Option<Vec<u8>>=c.query_row("SELECT payload FROM search_packed_blocks WHERE index_id=?1 AND epoch=?2 AND table_id=?3 AND bucket=?4 AND first<=?5 COLLATE BINARY ORDER BY first DESC LIMIT 1",params![index,epoch,table as i64,bucket,id],|r|r.get(0)).optional()?;
+            let rows=payload.as_deref().map(|b|super::blocks::members(c,b)).transpose()?.unwrap_or_default();
+            anyhow::ensure!(rows.iter().any(|r|r.0==id),"STATE_SEARCH_PACKED_PROOF_FAILED");
+        }
+    }
+    Ok(())
+}
+
+pub fn packed_signature(c:&Connection,index:&str,epoch:i64,id:&str)->anyhow::Result<Vec<u8>> {
+    let bytes:Vec<u8>=c.query_row("SELECT p.signatures FROM search_packed_inverse p WHERE p.index_id=?1 AND p.epoch=?2 AND p.identifier=(SELECT id FROM compact_identifiers WHERE token=json_quote(?3))",params![index,epoch,id],|r|r.get(0))?;
+    decode(&bytes)?;Ok(bytes)
+}
diff --git a/engine/src/workers/state/adapters/sqlite/snapshot_read_view.rs b/engine/src/workers/state/adapters/sqlite/snapshot_read_view.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/snapshot_read_view.rs
@@ -0,0 +1,328 @@
+use super::{commit, database, protocol::{error, require}};
+use rusqlite::{backup::{Backup, StepResult}, Connection, OpenFlags, OptionalExtension, params};
+use serde::Deserialize;
+use serde_json::{Value, json};
+use std::{collections::HashMap, path::{Path, PathBuf}, time::{Duration, Instant}};
+
+pub(super) const CAPTURE_MS: u64 = 300_000;
+pub(super) const EXPORT_MS: u64 = 600_000;
+pub(super) const CALL_MS: u64 = 10_000;
+pub(super) const NATIVE_BYTES: u64 = 12 * 1024 * 1024 * 1024;
+const PUBLICATION_BYTES: u64 = 4 * 1024 * 1024 * 1024;
+const STEP_BYTES: u64 = 1024 * 1024;
+const ROW_BYTES: usize = 16 * 1024 * 1024 - 128 * 1024;
+const PAGE_BYTES: usize = 1024 * 1024;
+const DECODE_BYTES: usize = 32 * 1024 * 1024;
+const MAX_STEPS: usize = 1_000_000;
+const MAX_PAGES: usize = 100_000;
+const MAX_ROWS: usize = 10_000_000;
+
+#[derive(Clone, Deserialize)]
+#[serde(tag = "action", deny_unknown_fields)]
+pub(super) enum Request {
+    #[serde(rename = "snapshot_open")]
+    Open { owner_id: String, request_id: String },
+    #[serde(rename = "snapshot_cancel")]
+    Cancel { owner_id: String, request_id: String },
+    #[serde(rename = "snapshot_keys")]
+    Keys { owner_id: String, request_id: String, handle: String, generation: String, scope: String, cursor: Option<String> },
+    #[serde(rename = "snapshot_get")]
+    Get { owner_id: String, request_id: String, handle: String, generation: String, scope: String, key: String },
+}
+impl Request {
+    pub fn validate(&self) -> anyhow::Result<()> {
+        let (owner, request) = match self {
+            Self::Open {owner_id,request_id} | Self::Cancel {owner_id,request_id}
+            | Self::Keys {owner_id,request_id,..} | Self::Get {owner_id,request_id,..} => (owner_id,request_id),
+        };
+        require(uuid::Uuid::parse_str(owner).is_ok() && uuid::Uuid::parse_str(request).is_ok())?;
+        match self {
+            Self::Keys {scope,handle,generation,cursor,..} => {
+                valid_scope(scope)?; valid_tokens(handle,generation)?;
+                require(cursor.as_ref().is_none_or(|v| uuid::Uuid::parse_str(v).is_ok()))
+            },
+            Self::Get {scope,handle,generation,key,..} => {
+                valid_scope(scope)?; valid_tokens(handle,generation)?;
+                require(!key.is_empty() && key.len() <= 4096)
+            },
+            _ => Ok(()),
+        }
+    }
+}
+fn valid_scope(scope: &str) -> anyhow::Result<()> {
+    require(scope.len() <= 4096 && (matches!(scope, "mem:sessions" | "mem:memories" | "mem:graph:nodes" | "mem:access")
+        || scope.strip_prefix("mem:obs:").is_some_and(|id| !id.is_empty())))
+}
+fn valid_tokens(handle: &str, generation: &str) -> anyhow::Result<()> {
+    require(uuid::Uuid::parse_str(handle).is_ok() && uuid::Uuid::parse_str(generation).is_ok())
+}
+struct View {
+    owner: String,
+    request: String,
+    handle: String,
+    reader: Option<Connection>,
+    expires: Instant,
+    cursors: HashMap<String, (String, String)>,
+    pages: usize,
+    rows: usize,
+    directory: PathBuf,
+    cancelled: bool,
+    preparing: bool,
+}
+pub(super) struct Views {
+    generation: uuid::Uuid,
+    root: PathBuf,
+    _root_lock: std::fs::File,
+    active: Option<View>,
+    #[cfg(test)]
+    pub fixture: Fixture,
+}
+#[cfg(test)]
+pub(super) struct Fixture {
+    pub copy_limit: u64, pub free_bytes: Option<u64>, pub failure: Option<&'static str>,
+    pub steps: Option<std::sync::Arc<std::sync::atomic::AtomicUsize>>,
+}
+fn size(path: &Path) -> anyhow::Result<u64> {
+    match std::fs::symlink_metadata(path) {
+        Ok(metadata) => { require(metadata.is_file() && !metadata.file_type().is_symlink())?; Ok(metadata.len()) },
+        Err(cause) if cause.kind() == std::io::ErrorKind::NotFound => Ok(0),
+        Err(cause) => Err(cause.into()),
+    }
+}
+fn footprint(directory: &Path) -> anyhow::Result<u64> {
+    let mut total = 0u64;
+    for name in ["cut.sqlite3", "cut.sqlite3-journal", "cut.sqlite3-wal", "cut.sqlite3-shm"] {
+        total = total.checked_add(size(&directory.join(name))?).ok_or_else(|| error("STATE_SNAPSHOT_RESOURCE_LIMIT"))?;
+    }
+    require(total <= NATIVE_BYTES)?;
+    Ok(total)
+}
+impl Views {
+    pub fn new(source: &Path, generation: uuid::Uuid) -> anyhow::Result<Self> {
+        let mut root = source.as_os_str().to_owned(); root.push(".snapshot-readviews");
+        let root = PathBuf::from(root);
+        if root.exists() { require(!std::fs::symlink_metadata(&root)?.file_type().is_symlink())?; }
+        std::fs::create_dir_all(&root)?;
+        let lock_path=root.join(".owner.lock");
+        if lock_path.exists() { require(std::fs::symlink_metadata(&lock_path)?.is_file() && !std::fs::symlink_metadata(&lock_path)?.file_type().is_symlink())?; }
+        let root_lock=std::fs::OpenOptions::new().create(true).read(true).write(true).open(lock_path)?;
+        fs2::FileExt::try_lock_exclusive(&root_lock).map_err(|_| error("STATE_SNAPSHOT_BUSY"))?;
+        let entries = std::fs::read_dir(&root)?.take(3).collect::<std::io::Result<Vec<_>>>()?;
+        require(entries.len() <= 2)?;
+        for entry in entries {
+            let name = entry.file_name(); let name = name.to_str().ok_or_else(|| error("STATE_SNAPSHOT_CLEANUP_FAILED"))?;
+            if name == ".owner.lock" { continue; }
+            require(name.strip_prefix(".view-").is_some_and(|id| uuid::Uuid::parse_str(id).is_ok())
+                && entry.file_type()?.is_dir() && !entry.file_type()?.is_symlink())?;
+            std::fs::remove_dir_all(entry.path())?;
+        }
+        Ok(Self { generation, root, _root_lock:root_lock, active: None,
+            #[cfg(test)] fixture: Fixture { copy_limit: NATIVE_BYTES, free_bytes: None, failure: None, steps: None },
+        })
+    }
+    fn native_limit(&self) -> u64 {
+        #[cfg(test)] { return self.fixture.copy_limit.min(NATIVE_BYTES).max(2 * STEP_BYTES); }
+        #[cfg(not(test))] { NATIVE_BYTES }
+    }
+    fn available(&self) -> anyhow::Result<u64> {
+        #[cfg(test)] if let Some(bytes) = self.fixture.free_bytes { return Ok(bytes); }
+        Ok(fs2::available_space(&self.root)?)
+    }
+    fn fault(&self, stage: &str) -> anyhow::Result<()> {
+        #[cfg(test)] if self.fixture.failure == Some(stage) { return Err(error("STATE_SNAPSHOT_INJECTED_FAILURE")); }
+        let _ = stage;
+        Ok(())
+    }
+    #[cfg(test)]
+    pub fn expire_fixture(&mut self) { self.active.as_mut().expect("fixture view").expires = Instant::now(); }
+    pub fn reap(&mut self) -> anyhow::Result<()> {
+        if self.active.as_ref().is_some_and(|v| v.cancelled || Instant::now() >= v.expires) {
+            if self.active.as_ref().is_some_and(|v| v.preparing && !v.cancelled) {
+                self.active.as_mut().expect("preparing view").cancelled = true;
+                return Ok(());
+            }
+            if self.active.as_ref().is_some_and(|v| v.preparing) { return Ok(()); }
+            self.cleanup()?;
+        }
+        Ok(())
+    }
+    pub fn busy(&self) -> bool { self.active.is_some() }
+    pub fn cleanup(&mut self) -> anyhow::Result<()> {
+        self.fault("cleanup")?;
+        if let Some(view) = self.active.as_mut() {
+            view.cancelled = true;
+            view.preparing = false;
+            view.reader.take();
+            // Keep the slot occupied if deletion fails; never hide an archive.
+            match std::fs::remove_dir_all(&view.directory) {
+                Ok(()) => {},
+                Err(cause) if cause.kind() == std::io::ErrorKind::NotFound => {},
+                Err(_) => return Err(error("STATE_SNAPSHOT_CLEANUP_FAILED")),
+            }
+            self.active = None;
+        }
+        Ok(())
+    }
+    fn authenticate(&mut self, owner: &str, request: &str, handle: &str, generation: &str) -> anyhow::Result<&mut View> {
+        if generation != self.generation.to_string() { return Err(error("STATE_SNAPSHOT_STALE")); }
+        self.reap()?;
+        let view = self.active.as_mut().ok_or_else(|| error("STATE_SNAPSHOT_EXPIRED"))?;
+        if view.owner != owner || view.request != request || view.handle != handle {
+            return Err(error("STATE_SNAPSHOT_FOREIGN"));
+        }
+        require(view.reader.is_some() && !view.cancelled)?;
+        Ok(view)
+    }
+    pub fn execute(&mut self, request: Request) -> anyhow::Result<Value> {
+        request.validate()?;
+        match request {
+            Request::Cancel {owner_id,request_id} => {
+                if self.active.as_ref().is_some_and(|v| v.owner == owner_id && v.request == request_id) {
+                    if self.active.as_ref().is_some_and(|v| v.preparing) {
+                        self.active.as_mut().expect("matched preparing view").cancelled = true;
+                        return Err(error("STATE_SNAPSHOT_CLEANUP_PENDING"));
+                    }
+                    self.cleanup()?;
+                }
+                Ok(json!({"closed":true}))
+            },
+            Request::Keys {owner_id,request_id,handle,generation,scope,cursor} => {
+                let view = self.authenticate(&owner_id,&request_id,&handle,&generation)?;
+                view.pages += 1;
+                if view.pages > MAX_PAGES { return Err(error("STATE_SNAPSHOT_RESOURCE_LIMIT")); }
+                let after = if let Some(cursor) = &cursor {
+                    let (old_scope,key) = view.cursors.get(cursor).ok_or_else(|| error("STATE_SNAPSHOT_CURSOR_INVALID"))?;
+                    if old_scope != &scope { return Err(error("STATE_SNAPSHOT_CURSOR_INVALID")); }
+                    key.clone()
+                } else { String::new() };
+                let reader = view.reader.as_ref().expect("authenticated reader");
+                let value = super::storage::bounded(reader, CALL_MS.min(3000), || {
+                    let mut statement = reader.prepare("SELECT key FROM state_values WHERE scope=?1 AND key>?2 AND live=1 ORDER BY key LIMIT 257")?;
+                    let mut rows = statement.query(params![scope,after])?;
+                    let mut keys = Vec::<String>::new(); let mut bytes = 128usize; let mut more = false;
+                    while let Some(row) = rows.next()? {
+                        let raw = row.get_ref(0)?.as_str()?;
+                        if raw.is_empty() || raw.len() > 4096 { return Err(error("STATE_RECORD_TOO_LARGE")); }
+                        let needed = serde_json::to_string(raw)?.len() + 1;
+                        if keys.len() == 256 || bytes + needed > PAGE_BYTES {
+                            if keys.is_empty() { return Err(error("STATE_RECORD_TOO_LARGE")); }
+                            more = true; break;
+                        }
+                        keys.push(raw.to_owned()); bytes += needed;
+                    }
+                    Ok((keys,more))
+                })?;
+                if Instant::now() >= view.expires { return Err(error("STATE_SNAPSHOT_EXPIRED")); }
+                if let Some(cursor) = cursor { view.cursors.remove(&cursor); }
+                view.rows = view.rows.saturating_add(value.0.len());
+                if view.rows > MAX_ROWS { return Err(error("STATE_SNAPSHOT_RESOURCE_LIMIT")); }
+                let next = if value.1 {
+                    if view.cursors.len() >= 16 { return Err(error("STATE_SNAPSHOT_RESOURCE_LIMIT")); }
+                    let cursor = uuid::Uuid::new_v4().to_string();
+                    view.cursors.insert(cursor.clone(),(scope,value.0.last().expect("nonempty continuation").clone()));
+                    Some(cursor)
+                } else { None };
+                Ok(json!({"keys":value.0,"next_cursor":next}))
+            },
+            Request::Get {owner_id,request_id,handle,generation,scope,key} => {
+                let view = self.authenticate(&owner_id,&request_id,&handle,&generation)?;
+                let reader = view.reader.as_ref().expect("authenticated reader");
+                let result = super::storage::bounded(reader, 3000, || {
+                    let work = database::row_work(reader,&scope,&key)?;
+                    let logical: Option<i64> = reader.query_row("SELECT value_bytes FROM state_values WHERE scope=?1 AND key=?2 AND live=1",params![scope,key],|row| row.get(0)).optional()?;
+                    if logical.is_none() { return Err(error("STATE_SNAPSHOT_RECORD_MISSING")); }
+                    if work > DECODE_BYTES || logical.is_none_or(|n| n < 1 || n as usize > ROW_BYTES) {
+                        return Err(error("STATE_RECORD_TOO_LARGE"));
+                    }
+                    let _decode = database::DecodeWorkGuard::new(DECODE_BYTES);
+                    let value = database::row(reader,&scope,&key)?.value.ok_or_else(|| error("STATE_SNAPSHOT_RECORD_MISSING"))?;
+                    Ok(json!({"value":value}))
+                });
+                if Instant::now() >= view.expires { return Err(error("STATE_SNAPSHOT_EXPIRED")); }
+                result
+            },
+            Request::Open {..} => Err(error("STATE_TX_INVALID_REQUEST")),
+        }
+    }
+    pub fn capture(&mut self, source: &Connection, owner: String, request: String,
+        budget: &database::PreparationBudget,
+        mut foreground: impl FnMut(&Connection, &mut Views) -> anyhow::Result<()>) -> anyhow::Result<Value> {
+        self.reap()?;
+        if self.active.is_some() { return Err(error("STATE_SNAPSHOT_BUSY")); }
+        budget.check()?;
+        require(source.is_autocommit())?;
+        // Reserve the complete native+publication ceiling before any copy is made.
+        if self.available()? < NATIVE_BYTES + PUBLICATION_BYTES + 64 * 1024 * 1024 {
+            return Err(error("STATE_SNAPSHOT_DISK_LIMIT"));
+        }
+        let directory = self.root.join(format!(".view-{}",uuid::Uuid::new_v4()));
+        std::fs::create_dir(&directory)?;
+        self.active = Some(View { owner, request, handle: uuid::Uuid::new_v4().to_string(), reader: None,
+            expires: budget.deadline, cursors: HashMap::new(),pages:0,rows:0,directory:directory.clone(),cancelled:false,preparing:true });
+        let result = (|| {
+            let native_limit = self.native_limit();
+            let path = directory.join("cut.sqlite3");
+            let mut destination = Connection::open(&path)?;
+            destination.execute_batch("PRAGMA journal_mode=OFF; PRAGMA synchronous=OFF; PRAGMA cache_size=-8192; PRAGMA mmap_size=0; PRAGMA temp_store=MEMORY")?;
+            destination.busy_timeout(Duration::from_millis(100))?;
+            let page_size = u64::try_from(source.pragma_query_value(None,"page_size",|row| row.get::<_,i64>(0))?)?;
+            require(page_size > 0 && page_size <= 65536)?;
+            destination.pragma_update(None,"max_page_count",i64::try_from((native_limit - STEP_BYTES) / page_size)?)?;
+            let pages = (STEP_BYTES / page_size).max(1) as i32;
+            let backup = Backup::new(source,&mut destination)?;
+            let mut completed = false;
+            let mut cut_at = None;
+            let mut cut_instant = None;
+            for _ in 0..MAX_STEPS {
+                #[cfg(test)] if let Some(steps) = &self.fixture.steps { steps.fetch_add(1,std::sync::atomic::Ordering::AcqRel); }
+                budget.check()?;
+                source.busy_timeout(Duration::from_millis(100))?;
+                if self.active.as_ref().is_none_or(|view| view.cancelled) { return Err(error("STATE_SNAPSHOT_CANCELLED")); }
+                let source_pages = u64::try_from(source.pragma_query_value(None,"page_count",|row| row.get::<_,i64>(0))?)?;
+                if source_pages.saturating_mul(page_size) > native_limit - STEP_BYTES
+                    || footprint(&directory)?.saturating_add(STEP_BYTES) > native_limit
+                    || self.available()? < PUBLICATION_BYTES + STEP_BYTES + 64 * 1024 * 1024 {
+                    return Err(error("STATE_SNAPSHOT_DISK_LIMIT"));
+                }
+                self.fault("step")?;
+                match backup.step(pages)? {
+                    StepResult::Done => { completed = true; cut_at = Some(chrono::Utc::now()); cut_instant = Some(Instant::now()); break; },
+                    StepResult::More => {},
+                    StepResult::Busy | StepResult::Locked => return Err(error("STATE_SNAPSHOT_CAPTURE_BUSY")),
+                    _ => return Err(error("STATE_SNAPSHOT_FAILED")),
+                }
+                // This is the same source Connection. SQLite updates the backup for
+                // its own writes; no source read transaction spans foreground work.
+                source.busy_timeout(Duration::from_secs(5))?;
+                foreground(source,self)?;
+                require(source.is_autocommit())?;
+            }
+            if !completed { return Err(error("STATE_SNAPSHOT_RESOURCE_LIMIT")); }
+            // No foreground work between SQLITE_DONE, completed-cut checks and
+            // dropping Backup. Check the copy, never today's live generation.
+            drop(backup);
+            destination.execute_batch("PRAGMA journal_mode=DELETE")?;
+            drop(destination);
+            footprint(&directory)?;
+            self.fault("reader")?;
+            let reader = Connection::open_with_flags(&path,OpenFlags::SQLITE_OPEN_READ_ONLY | OpenFlags::SQLITE_OPEN_NO_MUTEX)?;
+            database::configure_snapshot_reader(&reader)?;
+            super::storage::bounded(&reader,3000,|| commit::snapshot_read_allowed(&reader))?;
+            budget.check()?;
+            let cut_at = cut_at.expect("backup completed");
+            let expires_at = cut_at + chrono::Duration::milliseconds(EXPORT_MS as i64);
+            let view = self.active.as_mut().expect("active capture");
+            view.expires = cut_instant.expect("backup completed") + Duration::from_millis(EXPORT_MS);
+            view.reader = Some(reader);
+            view.preparing = false;
+            Ok(json!({"handle":view.handle,"generation":self.generation.to_string(),
+                "cut_at":cut_at.to_rfc3339(),"expires_at":expires_at.to_rfc3339()}))
+        })();
+        let restored = source.busy_timeout(Duration::from_secs(5));
+        if result.is_err() || restored.is_err() {
+            if let Err(cleanup) = self.cleanup() { return Err(cleanup); }
+        }
+        restored?;
+        result
+    }
+}
