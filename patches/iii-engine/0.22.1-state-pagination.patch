+        if !job.id.is_empty(){c.execute("INSERT OR IGNORE INTO compact_root_closed_jobs VALUES(?1)",[&job.id])?;}
+        job.cursor=0;job.gc_stage=0;job.gc_cursor=0;job.gc_complete=false;
+        job.id=r.job_id.clone();job.phase="copy".into();job.admission=r.admission_id.clone();
+        job.cutoff=c.query_row("SELECT coalesce(max(id),0) FROM compact_roots",[],|v|v.get(0))?;
+    } else {
+        anyhow::ensure!(job.id==r.job_id && job.admission==r.admission_id,"STATE_TX_CONFLICT");
