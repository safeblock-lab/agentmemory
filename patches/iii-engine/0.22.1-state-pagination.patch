+            .set(
+                "s",
+                &i.to_string(),
+                json!({"i":i,"text":"quote \" slash \\ café 東京 😀"}),
+            )
+            .await
+            .unwrap();
+    }
+    let mut cursor = None;
+    let mut collected = vec![];
+    loop {
+        let page = adapter
+            .list_page("s", cursor.as_deref(), 7, 1024)
+            .await
+            .unwrap();
+        assert!(protocol::size(&page).unwrap() <= 1024);
+        collected.extend(page.items);
+        cursor = page.next_cursor;
+        if cursor.is_none() {
+            break;
+        }
+    }
+    assert_eq!(
+        collected
+            .iter()
+            .map(|v| v["i"].as_u64().unwrap())
+            .collect::<Vec<_>>(),
+        (0..50).collect::<Vec<_>>()
+    );
+    let cursor = adapter
+        .list_page("s", None, 1, 1024)
+        .await
+        .unwrap()
+        .next_cursor
+        .unwrap();
+    assert!(matches!(
+        adapter.list_page("other", Some(&cursor), 1, 1024).await,
+        Err(StatePageError::InvalidCursor)
+    ));
+    let reopened = SqliteAdapter::new(Some(
+        json!({"file_path":directory.path().join("synthetic.sqlite3")}),
+    ))
+    .unwrap();
+    assert!(matches!(
+        reopened.list_page("s", Some(&cursor), 1, 1024).await,
+        Err(StatePageError::StaleCursor)
+    ));
+    adapter.set("s", "0", json!(99)).await.unwrap();
+    assert!(matches!(
+        adapter.list_page("s", Some(&cursor), 1, 1024).await,
+        Err(StatePageError::StaleCursor)
+    ));
+    adapter
+        .set("big", "one", json!("x".repeat(1200)))
+        .await
+        .unwrap();
+    let page = adapter.list_page("big", None, 1, 1_048_576).await.unwrap();
+    let exact = protocol::size(&page).unwrap() as u32;
+    assert_eq!(
+        adapter
+            .list_page("big", None, 1, exact)
+            .await
+            .unwrap()
+            .items,
+        page.items
+    );
+    assert!(
+        matches!(adapter.list_page("big",None,1,exact-1).await,Err(StatePageError::RecordTooLarge{required_bytes}) if required_bytes==exact as usize)
