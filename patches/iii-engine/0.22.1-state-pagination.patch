+            json!({"id":"numeric","title":"title","narrative":3}),
+        ),
+    ] {
+        write(&connection, OBS, id, Some(&value));
+    }
+    write(
+        &connection,
+        "mem:memories",
+        "old",
+        Some(&json!({"id":"old","title":"old","content":"body","isLatest":false})),
+    );
+    tracked(&connection);
+    finish_preparation(&connection);
+    assert_eq!(status(&connection)["dirty_count"], "0");
+    assert_eq!(status(&connection)["coverage_ready"], true);
+    let mut value = observation("a", "valid");
+    write(&connection, OBS, "a", Some(&value));
+    upsert(&connection, vec![source_item(&connection, OBS, "a")]).unwrap();
+    value["narrative"] = json!(" \u{feff}");
+    write(&connection, OBS, "a", Some(&value));
+    assert_eq!(status(&connection)["count"], 0);
+    assert_eq!(status(&connection)["dirty_count"], "0");
+    assert_eq!(
+        code(upsert(&connection, vec![source_item(&connection, OBS, "a")]).unwrap_err()),
+        "STATE_SEMANTIC_SOURCE_STALE"
+    );
+    for value in [
+        json!({"title":"title","narrative":"\u{0085}"}),
+        json!({"title":"title","narrative":"\u{feff}"}),
+        json!({"title":1,"narrative":"body"}),
+    ] {
+        let rust = eligibility::value(OBS, Some(&value));
+        let sql: bool=connection.query_row("SELECT retrieval_source_eligible(?1,json_extract(?2,'$.title'),json_extract(?2,'$.narrative'),NULL)",params![OBS,value.to_string()],|r|r.get(0)).unwrap();
+        assert_eq!(rust, sql);
+    }
+}
+
+#[test]
+fn memory_session_ids_changes_require_identity_refresh() {
+    let connection = fresh();
+    tracked(&connection);
+    let mut memory = json!({"id":"m","title":"title","content":"content","isLatest":true,"sessionIds":["first"]});
+    write(&connection, "mem:memories", "m", Some(&memory));
+    upsert(
+        &connection,
+        vec![source_item(&connection, "mem:memories", "m")],
+    )
+    .unwrap();
+    memory["sessionIds"] = json!(["second"]);
+    write(&connection, "mem:memories", "m", Some(&memory));
+    assert_eq!(status(&connection)["dirty_count"], "1");
+    assert_eq!(status(&connection)["coverage_ready"], false);
+    upsert(
+        &connection,
+        vec![source_item(&connection, "mem:memories", "m")],
+    )
+    .unwrap();
+    assert_eq!(status(&connection)["coverage_ready"], true);
+}
+
+#[test]
+fn sqlite_execution_deadline_rolls_back_canonical_and_index_mutations() {
+    let connection = fresh();
+    let transaction = connection.unchecked_transaction().unwrap();
+    let cause=bounded_for(&transaction,std::time::Duration::ZERO,|| {
+        database::write(&transaction,graph::NODES,"a",Some(&node("a","rollback",&[])))?;
+        transaction.query_row("WITH RECURSIVE n(x) AS (VALUES(0) UNION ALL SELECT x+1 FROM n WHERE x<100000000) SELECT sum(x) FROM n",[],|r|r.get::<_,i64>(0))?;
+        Ok(())
+    }).unwrap_err();
+    assert_eq!(code(cause), "STATE_RETRIEVAL_RESOURCE_LIMIT");
+    drop(transaction);
+    assert!(
+        database::row(&connection, graph::NODES, "a")
+            .unwrap()
+            .value
+            .is_none()
+    );
+    assert!(
+        ids(&call(
+            &connection,
+            json!({"action":"graph_seeds","entity_names":["rollback"]})
+        )
+        .unwrap())
+        .is_empty()
+    );
+}
