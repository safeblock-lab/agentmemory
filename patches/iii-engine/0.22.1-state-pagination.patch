+pub struct SqliteAdapter {
+    sender: Option<mpsc::SyncSender<Job>>,
+    worker: Option<std::thread::JoinHandle<()>>,
+    admission: Arc<Semaphore>,
+    queue_waiters: Arc<Semaphore>,
+    foreground_pending: Arc<AtomicUsize>,
+    reclaim_slot: Arc<Semaphore>,
+    reclaim_schedule: Arc<Mutex<storage_reclaim::Schedule>>,
+    generation: uuid::Uuid,
+    path: PathBuf,
+}
+
+impl SqliteAdapter {
+    pub fn new(config: Option<Value>) -> anyhow::Result<Self> {
+        let path = configured_path(config.as_ref())?;
+        let mut connection = database::open(&path)?;
+        let (sender, receiver) = mpsc::sync_channel::<Job>(SQLITE_QUEUE_CAPACITY);
+        let worker = std::thread::Builder::new()
+            .name("iii-state-sqlite".into())
+            .spawn(move || {
+                for job in receiver {
+                    job(&mut connection);
+                }
+                if let Err(cause) = connection.execute_batch("PRAGMA wal_checkpoint(TRUNCATE)") {
+                    tracing::warn!(error = %cause, "state SQLite shutdown checkpoint failed");
+                }
+            })?;
+        Ok(Self {
+            sender: Some(sender),
+            worker: Some(worker),
+            admission: Arc::new(Semaphore::new(ADMISSION_BYTES)),
+            queue_waiters: Arc::new(Semaphore::new(MAX_SQLITE_QUEUE_WAITERS)),
+            foreground_pending: Arc::new(AtomicUsize::new(0)),
+            reclaim_slot: Arc::new(Semaphore::new(1)),
+            reclaim_schedule: Arc::new(Mutex::new(storage_reclaim::Schedule::default())),
+            generation: uuid::Uuid::new_v4(),
+            path,
+        })
+    }
+
+    async fn run<T: Send + 'static>(
+        &self,
+        bytes: usize,
+        job: impl FnOnce(&mut Connection) -> anyhow::Result<T> + Send + 'static,
+    ) -> anyhow::Result<T> {
+        self.run_priority(bytes, false, job).await
+    }
+
+    async fn run_priority<T: Send + 'static>(
+        &self,
+        bytes: usize,
+        maintenance: bool,
+        job: impl FnOnce(&mut Connection) -> anyhow::Result<T> + Send + 'static,
+    ) -> anyhow::Result<T> {
+        self.run_controlled(bytes, maintenance, None, job).await
+    }
+
+    async fn run_controlled<T: Send + 'static>(
+        &self,
+        bytes: usize,
+        maintenance: bool,
+        budget: Option<database::PreparationBudget>,
+        job: impl FnOnce(&mut Connection) -> anyhow::Result<T> + Send + 'static,
+    ) -> anyhow::Result<T> {
+        let _cancellation = CancelPreparation(budget.clone());
+        if let Some(budget) = &budget { budget.enter(0)?; }
+        let pending = if maintenance { None } else {
+            self.foreground_pending.fetch_add(1, Ordering::AcqRel);
+            Some(Pending(self.foreground_pending.clone()))
+        };
+        if bytes > MAX_ENVELOPE_BYTES {
+            tracing::warn!(
+                failure_class = "sqlite_structural_envelope",
+                request_bytes = bytes,
+                limit_bytes = MAX_ENVELOPE_BYTES,
+                "state SQLite structural envelope rejected"
+            );
+            return Err(protocol::error("STATE_RECORD_TOO_LARGE"));
+        }
+        let accounted_bytes = bytes.max(4096);
+        let permit = self
+            .admission
+            .clone()
+            .try_acquire_many_owned(accounted_bytes as u32)
+            .map_err(|_| {
+                if let Some(budget) = &budget {
+                    budget.trace_event_at("queue", "byte_admission", "error", Duration::ZERO, database::PreparationProgress::default());
+                }
+                tracing::warn!(
+                    failure_class = "sqlite_admission_bytes",
+                    request_bytes = accounted_bytes,
+                    limit_bytes = ADMISSION_BYTES,
+                    "state SQLite pre-enqueue admission rejected"
+                );
+                protocol::error("STATE_TX_LIMIT_EXCEEDED")
+            })?;
+        let (reply_sender, receiver) = oneshot::channel();
+        let sender = self.sender.as_ref().ok_or_else(|| protocol::error("STATE_TX_FAILED"))?;
+        let worker_budget = budget.clone();
+        let queue_started = Instant::now();
+        if let Some(budget) = &budget {
+            budget.trace_event_at("queue", "queue_enqueue", "entry", Duration::ZERO, database::PreparationProgress {
+                bytes_processed: accounted_bytes,
+                ..database::PreparationProgress::default()
+            });
+        }
+        let dequeue_started = queue_started;
+        let mut queued: Job = Box::new(move |connection| {
+            if let Some(budget) = &worker_budget {
+                budget.trace_event_at("queue", "queue_dequeue", "exit", dequeue_started.elapsed(), database::PreparationProgress {
+                    bytes_processed: accounted_bytes,
+                    ..database::PreparationProgress::default()
+                });
+            }
+            let result = if worker_budget.is_some() && reply_sender.is_closed() {
+                Err(protocol::error("STATE_RETRIEVAL_RESOURCE_LIMIT"))
+            } else if let Some(budget) = &worker_budget {
+                budget.check().and_then(|_| job(connection))
+            } else { job(connection) };
+            if let Some(budget) = &worker_budget {
+                if result.is_err() {
+                    budget.trace_event("operation_result", "error", Duration::ZERO, database::PreparationProgress::default());
+                }
+                budget.trace_event_at("ack", "reply_delivery", "entry", Duration::ZERO, database::PreparationProgress::default());
+            }
+            let delivered = reply_sender.send(result).is_ok();
+            if let Some(budget) = &worker_budget {
+                budget.trace_event_at("ack", "reply_delivery", if delivered { "exit" } else { "error" }, Duration::ZERO, database::PreparationProgress::default());
+                budget.finish_stage();
+            }
+            if !delivered {
+                if let Some(budget) = &worker_budget { budget.failure("reply_delivery_lost_unknown_outcome"); }
+            }
+            drop(permit);
+            drop(pending);
+        });
+        match sender.try_send(queued) {
+            Ok(()) => {
+                if let Some(budget) = &budget {
+                    budget.trace_event_at("queue", "queue_enqueue", "exit", queue_started.elapsed(), database::PreparationProgress {
+                        bytes_processed: accounted_bytes,
+                        ..database::PreparationProgress::default()
+                    });
+                }
+            }
+            Err(mpsc::TrySendError::Disconnected(_)) => {
+                if let Some(budget) = &budget {
+                    budget.trace_event_at("queue", "queue_enqueue", "error", queue_started.elapsed(), database::PreparationProgress::default());
+                }
+                return Err(protocol::error("STATE_TX_FAILED"));
+            }
+            Err(mpsc::TrySendError::Full(returned)) => {
+                queued = returned;
+                let _waiter = self.queue_waiters.clone().try_acquire_owned().map_err(|_| {
+                    if let Some(budget) = &budget {
+                        budget.trace_event_at("queue", "queue_waiter_admission", "error", queue_started.elapsed(), database::PreparationProgress::default());
+                    }
+                    tracing::warn!(
+                        failure_class = "sqlite_queue_waiter_limit",
+                        request_bytes = accounted_bytes,
+                        waiters = MAX_SQLITE_QUEUE_WAITERS,
+                        "state SQLite pre-enqueue queue wait rejected"
+                    );
+                    protocol::error("STATE_TX_LIMIT_EXCEEDED")
+                })?;
+                let started = Instant::now();
+                let deadline = budget.as_ref().map_or(started + SQLITE_QUEUE_WAIT_TIMEOUT, |b| b.deadline);
+                loop {
+                    if Instant::now() >= deadline {
+                        tracing::warn!(
+                            failure_class = "sqlite_queue_wait_timeout",
+                            wait_ms = started.elapsed().as_millis() as u64,
+                            request_bytes = accounted_bytes,
+                            "state SQLite pre-enqueue queue wait expired"
+                        );
+                        if let Some(budget) = &budget {
+                            budget.trace_event_at("queue", "queue_enqueue", "error", queue_started.elapsed(), database::PreparationProgress::default());
+                        }
+                        if let Some(budget) = &budget { budget.check()?; }
+                        return Err(protocol::error("STATE_TX_LIMIT_EXCEEDED"));
+                    }
+                    match sender.try_send(queued) {
+                        Ok(()) => {
+                            if let Some(budget) = &budget {
+                                budget.trace_event_at("queue", "queue_enqueue", "exit", queue_started.elapsed(), database::PreparationProgress {
+                                    bytes_processed: accounted_bytes,
+                                    ..database::PreparationProgress::default()
+                                });
+                            }
+                            tracing::debug!(
+                                failure_class = "sqlite_queue_backpressure",
+                                wait_ms = started.elapsed().as_millis() as u64,
+                                request_bytes = accounted_bytes,
+                                "state SQLite transaction admitted after bounded queue wait"
+                            );
+                            break;
+                        }
+                        Err(mpsc::TrySendError::Disconnected(_)) => {
+                            if let Some(budget) = &budget {
+                                budget.trace_event_at("queue", "queue_enqueue", "error", queue_started.elapsed(), database::PreparationProgress::default());
+                            }
+                            return Err(protocol::error("STATE_TX_FAILED"));
+                        }
+                        Err(mpsc::TrySendError::Full(returned)) => {
+                            queued = returned;
+                            let remaining = deadline.checked_duration_since(Instant::now()).unwrap_or_default();
+                            sleep(SQLITE_QUEUE_RETRY_DELAY.min(remaining)).await;
+                        }
+                    }
+                }
+            }
+        }
+        if let Some(budget) = &budget {
+            match tokio::time::timeout_at(tokio::time::Instant::from_std(budget.deadline), receiver).await {
+                Ok(result) => result.map_err(|_| protocol::error("STATE_TX_FAILED"))?,
+                Err(_) => { budget.cancel(); budget.failure("response_deadline_unknown_outcome");
+                    Err(protocol::error("STATE_RETRIEVAL_RESOURCE_LIMIT")) }
+            }
+        } else { receiver.await.map_err(|_| protocol::error("STATE_TX_FAILED"))? }
+    }
+
+    async fn mutate<T: Send + 'static>(
+        &self,
+        bytes: usize,
+        job: impl FnOnce(&rusqlite::Transaction<'_>) -> anyhow::Result<T> + Send + 'static,
+    ) -> anyhow::Result<T> {
+        let path = self.path.clone();
+        self.run(bytes, move |connection| {
+            database::wal_pressure(connection, &path)?;
+            let transaction =
+                connection.transaction_with_behavior(rusqlite::TransactionBehavior::Immediate)?;
+            let result = job(&transaction)?;
+            transaction.commit()?;
+            Ok(result)
+        })
+        .await
+    }
+}
