+    if let Some(existing)=existing {
+        let existing=protocol::strict_value(&existing)?;
+        need(["capture","source_digest","selection","progress","pages","reference"].iter().all(|key|existing[*key]==proof[*key]),"STATE_GRAPH_AUTOMATIC_SOURCE_CHANGED")?;
+    } else {connection.execute("INSERT INTO engine_graph_auto_terminal_sources(root_id,proof_json) VALUES(?1,?2)",params![root,serde_json::to_string(&proof)?])?;}
