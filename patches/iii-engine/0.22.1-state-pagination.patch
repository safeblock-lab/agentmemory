+use super::{need, wire::{Anchor, Binding}, INVALID};
+use super::super::{commit, database, protocol::{self, Checkpoint, JOBS}};
+use rusqlite::Connection;
+use serde_json::Value;
+use sha2::{Digest, Sha256};
+use std::collections::HashSet;
+
+pub(super) fn digest(value: &[u8]) -> String { hex::encode(Sha256::digest(value)) }
+pub(super) fn slot_id(anchor: &Anchor) -> anyhow::Result<String> {
+    Ok(format!("ga:{}", digest(serde_json::to_string(&(anchor.source_generation.as_ref().unwrap_or(&anchor.guard.generation), &anchor.job_id, anchor.delta_ordinal, &anchor.value_name))?.as_bytes())))
+}
+pub(super) fn secret_free(value: &Value) -> bool {
+    match value {
+        Value::Object(map) => map.iter().all(|(key,value)| {
+            let normalized = key.to_ascii_lowercase().chars().filter(|character| !['_','-'].contains(character)).collect::<String>();
+            !["authorization","apikey","accesstoken","refreshtoken","password","secret","credentials","cookie","headers"].contains(&normalized.as_str()) && secret_free(value)
+        }),
+        Value::Array(values) => values.iter().all(secret_free),
+        _ => true,
+    }
+}
+impl Binding {
+    pub fn validate(&self) -> anyhow::Result<()> {
+        need(protocol::size(self)?<=6*1024*1024,INVALID)?;
+        let body = protocol::strict_value(&self.request_json).map_err(|_|super::error(INVALID))?;
+        let schema = protocol::strict_value(&self.contract.schema_json).map_err(|_|super::error(INVALID))?;
+        need(self.request_json.len() <= 4*1024*1024 && body.is_object() && secret_free(&body)
+            && self.contract.schema_json.len() <= 256*1024 && schema.is_object() && secret_free(&schema)
+            && !self.model.is_empty() && self.model.len() <= 128 && !self.model.chars().any(char::is_control) && super::wire::id(&self.contract.id,128)
+            && super::wire::id(&self.contract.version,128) && super::wire::id(&self.contract.parser_version,128)
+            && (1..=120_000).contains(&self.timeout_ms) && (1..=8*1024*1024).contains(&self.max_response_bytes)
+            && (1..=32).contains(&self.segments.len()), INVALID)?;
+        endpoint(&self.endpoint)?;
+        let mut pointers = HashSet::new();
+        let mut sources = 0;
+        for segment in &self.segments {
+            need(super::wire::pointer(&segment.request_pointer) && pointers.insert(&segment.request_pointer)
+                && (1..=512).contains(&segment.sources.len()) && segment.prefix.len() <= 1024*1024
+                && segment.suffix.len() <= 1024*1024 && segment.separator.len() <= 1024*1024, INVALID)?;
+            sources += segment.sources.len();
+            for source in &segment.sources {
+                need(!source.scope.is_empty() && source.scope.len() <= 512 && !source.key.is_empty() && source.key.len() <= 2048
+                    && super::wire::pointer(&source.pointer) && protocol::counter(&source.version)? > 0, INVALID)?;
+            }
+        }
+        need(sources <= 512, INVALID)
+    }
+}
+pub(super) fn endpoint(value:&str)->anyhow::Result<()> {
+        need(value.len() <= 2048 && value.starts_with("POST "), INVALID)?;
+        let endpoint = reqwest::Url::parse(&value[5..]).map_err(|_|super::error(INVALID))?;
+        need(["http","https"].contains(&endpoint.scheme()) && endpoint.host_str().is_some() && endpoint.username().is_empty()
+            && endpoint.password().is_none() && endpoint.query().is_none() && endpoint.fragment().is_none()
+            && value == format!("POST {}{}",endpoint.origin().ascii_serialization(),endpoint.path()), INVALID)
+}
+pub(super) fn anchor(connection: &Connection, expected: &Anchor, staging: bool) -> anyhow::Result<Value> {
+    commit::read_allowed(connection, JOBS, &expected.job_id, Some(&expected.guard))?;
+    let job = database::row(connection, JOBS, &expected.job_id)?;
+    need(job.version.to_string() == expected.job_version, "STATE_TX_CONFLICT")?;
+    let job = job.value.ok_or_else(|| super::error("STATE_GRAPH_AUTOMATIC_JOB_MISSING"))?;
+    let source_generation=expected.source_generation.as_ref().unwrap_or(&expected.guard.generation);
+    need(job["version"] == 1 && job["id"] == expected.job_id && job["generation"] == *source_generation
+        && job["kind"] == "extraction", "STATE_GRAPH_AUTOMATIC_BINDING_MISMATCH")?;
+    let point = database::row(connection, database::CHECKPOINT_SCOPE, &expected.job_id)?;
+    need(point.version.to_string() == expected.checkpoint_version, "STATE_TX_CHECKPOINT_CONFLICT")?;
+    let checkpoint: Checkpoint = protocol::decode(point.value.ok_or_else(|| super::error("STATE_TX_CHECKPOINT_CONFLICT"))?)?;
+    need(checkpoint.generation == *source_generation && checkpoint.job_id == expected.job_id
+        && checkpoint.delta_ordinal == expected.delta_ordinal && checkpoint.logical_delta_id == format!("delta:{}", expected.delta_ordinal),
+        "STATE_GRAPH_AUTOMATIC_BINDING_MISMATCH")?;
+    let manifest = database::row(connection, &expected.manifest_scope(), &expected.manifest_key())?;
+    need(manifest.version.to_string() == expected.manifest_version, "STATE_TX_CONFLICT")?;
+    let manifest = manifest.value.ok_or_else(|| super::error("STATE_GRAPH_AUTOMATIC_MANIFEST_MISSING"))?;
+    need(manifest["id"] == checkpoint.logical_delta_id && manifest["ordinal"] == expected.delta_ordinal
+        && manifest["attempt"] == expected.manifest_attempt, "STATE_GRAPH_AUTOMATIC_BINDING_MISMATCH")?;
+    if staging {
+        need(source_generation==&expected.guard.generation && checkpoint.visibility == "staging" && manifest["phase"] == "preparing"
+            && ["templateCount","applyOrdinal","applyCheckpointVersion","result"].iter().all(|key| manifest.get(key).is_none())
+            && manifest["advanceGeneration"] != true && !["completed","invalidated"].iter().any(|state|job["state"]==*state),
+            "STATE_GRAPH_AUTOMATIC_ALREADY_APPLYING")?;
+    }
+    Ok(job)
+}
+pub(super) fn source_capture(connection: &Connection, anchor: &Anchor, job: &Value) -> anyhow::Result<String> {
+    need(job["captureComplete"] == true, "STATE_GRAPH_AUTOMATIC_SOURCE_INCOMPLETE")?;
+    let parts = job["captureParts"].as_u64().filter(|n| (1..=512).contains(n)).ok_or_else(|| super::error("STATE_GRAPH_AUTOMATIC_SOURCE_INCOMPLETE"))?;
+    let mut hasher = Sha256::new();
+    let mut binding_hasher=Sha256::new();
+    binding_hasher.update(serde_json::to_string(&(&anchor.job_id,anchor.source_generation.as_ref().unwrap_or(&anchor.guard.generation),parts,&job["captureDigest"]))?.as_bytes());
+    let mut bytes = 0usize;
+    let mut capture = String::new();
+    for ordinal in 0..parts {
+        let row = database::row(connection, &format!("mem:graph:inputs:{}",anchor.job_id), &format!("capture:{ordinal}"))?;
+        let value = row.value.ok_or_else(|| super::error("STATE_GRAPH_AUTOMATIC_SOURCE_INCOMPLETE"))?;
+        let text = value.as_str().ok_or_else(|| super::error("STATE_GRAPH_AUTOMATIC_SOURCE_INCOMPLETE"))?;
+        bytes = bytes.checked_add(text.len()).ok_or_else(||super::error(INVALID))?;
+        need(bytes <= 64*1024*1024, "STATE_GRAPH_AUTOMATIC_SOURCE_LIMIT")?;
+        hasher.update(text.as_bytes()); capture.push_str(text);
+        binding_hasher.update(serde_json::to_string(&(ordinal,row.version,text.len()))?.as_bytes());
+        binding_hasher.update(text.as_bytes());
+    }
+    need(serde_json::from_str::<Value>(&capture).is_ok(), "STATE_GRAPH_AUTOMATIC_SOURCE_INCOMPLETE")?;
+    let digest = hex::encode(hasher.finalize());
+    need(job["captureDigest"] == digest, "STATE_GRAPH_AUTOMATIC_SOURCE_CHANGED")?;
+    Ok(hex::encode(binding_hasher.finalize()))
+}
+pub(super) fn binding(connection: &Connection, anchor: &Anchor, binding: &Binding) -> anyhow::Result<()> {
+    binding.validate()?;
+    let body: Value = serde_json::from_str(&binding.request_json)?;
+    for segment in &binding.segments {
+        let mut rebuilt = segment.prefix.clone();
+        for (index, source) in segment.sources.iter().enumerate() {
+            let input_scope = format!("mem:graph:inputs:{}",anchor.job_id);
+            let provider_scope = anchor.provider_scope();
+            need(source.scope == input_scope || source.scope == provider_scope && source.key.starts_with("value:") && !source.key.contains(":part:"), "STATE_GRAPH_AUTOMATIC_SOURCE_SCOPE")?;
+            let row = database::row(connection, &source.scope, &source.key)?;
+            need(row.version.to_string() == source.version, "STATE_GRAPH_AUTOMATIC_SOURCE_CHANGED")?;
+            let mut value = row.value.ok_or_else(|| super::error("STATE_GRAPH_AUTOMATIC_SOURCE_INCOMPLETE"))?;
+            if source.scope == provider_scope {
+                need(source.key != anchor.value_key(), "STATE_GRAPH_AUTOMATIC_SOURCE_SCOPE")?;
+                need(value.get("failure").is_none(),"STATE_GRAPH_AUTOMATIC_SOURCE_INCOMPLETE")?;
+                value = frozen(connection, &source.scope, &source.key, &value)?;
+            }
+            let selected = value.pointer(&source.pointer).ok_or_else(|| super::error("STATE_GRAPH_AUTOMATIC_SOURCE_INCOMPLETE"))?;
+            if index > 0 { rebuilt.push_str(&segment.separator); }
+            match selected { Value::String(text) => rebuilt.push_str(text), _ => rebuilt.push_str(&serde_json::to_string(selected)?) }
+            need(rebuilt.len() <= 4*1024*1024, "STATE_GRAPH_AUTOMATIC_SOURCE_LIMIT")?;
+        }
+        rebuilt.push_str(&segment.suffix);
+        need(body.pointer(&segment.request_pointer).and_then(Value::as_str) == Some(rebuilt.as_str()), "STATE_GRAPH_AUTOMATIC_BINDING_MISMATCH")?;
+    }
+    Ok(())
+}
+
+pub(super) fn frozen(connection: &Connection, scope: &str, key: &str, reference: &Value) -> anyhow::Result<Value> {
+    let parts=reference["parts"].as_u64().filter(|parts|(1..=512).contains(parts)).ok_or_else(||super::error("STATE_GRAPH_AUTOMATIC_SOURCE_INCOMPLETE"))?;
+    let mut text=String::new();
+    for ordinal in 0..parts {
+        let row=database::row(connection,scope,&format!("{key}:part:{ordinal}"))?;
+        let value=row.value.ok_or_else(||super::error("STATE_GRAPH_AUTOMATIC_SOURCE_INCOMPLETE"))?;
+        text.push_str(value.as_str().ok_or_else(||super::error("STATE_GRAPH_AUTOMATIC_SOURCE_INCOMPLETE"))?);
+        need(text.len()<=64*1024*1024,"STATE_GRAPH_AUTOMATIC_SOURCE_LIMIT")?;
+    }
+    need(reference["digest"]==digest(text.as_bytes()),"STATE_GRAPH_AUTOMATIC_SOURCE_CHANGED")?;
+    serde_json::from_str(&text).map_err(|_|super::error("STATE_GRAPH_AUTOMATIC_SOURCE_INCOMPLETE"))
+}
