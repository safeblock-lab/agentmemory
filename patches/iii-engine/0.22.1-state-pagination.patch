+++ b/engine/src/workers/state/adapters/sqlite/paging.rs
@@ -0,0 +1,347 @@
+use super::{LEGACY_LIST_BYTES, commit, database, protocol};
+use crate::workers::state::{
+    adapters::StatePageError,
+    structs::{STATE_PAGE_MAX_CURSOR_BYTES, StateListPageResult},
+};
+use base64::{Engine as _, engine::general_purpose::URL_SAFE_NO_PAD};
+use rusqlite::{Connection, OptionalExtension, params};
+use serde::{
+    Deserialize, Serialize,
+    de::{DeserializeSeed, IgnoredAny, MapAccess, Visitor},
+};
+use serde_json::{Map, Value};
+use sha2::{Digest, Sha256};
+use std::fmt;
+
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Cursor {
+    version: u8,
+    generation: uuid::Uuid,
+    scope_fingerprint: String,
+    revision: String,
+    after_position: i64,
+}
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct ProjectedCursor {
+    version: u8,
+    mode: String,
+    generation: uuid::Uuid,
+    scope_fingerprint: String,
+    revision: String,
+    after_position: i64,
+    fields: Vec<String>,
+}
+enum DecodedCursor {
+    Full(Cursor),
+    Projected(ProjectedCursor),
+}
+fn encode(cursor: &Cursor) -> Result<String, StatePageError> {
+    let encoded =
+        URL_SAFE_NO_PAD.encode(serde_json::to_vec(cursor).map_err(|_| StatePageError::Internal)?);
+    if encoded.len() > STATE_PAGE_MAX_CURSOR_BYTES {
+        return Err(StatePageError::Internal);
+    }
+    Ok(encoded)
+}
+fn encode_projected(cursor: &ProjectedCursor) -> Result<String, StatePageError> {
+    let encoded =
+        URL_SAFE_NO_PAD.encode(serde_json::to_vec(cursor).map_err(|_| StatePageError::Internal)?);
+    if encoded.len() > STATE_PAGE_MAX_CURSOR_BYTES {
+        return Err(StatePageError::Internal);
+    }
+    Ok(encoded)
+}
+
+struct ProjectedSeed<'a>(&'a [String]);
+impl<'de> DeserializeSeed<'de> for ProjectedSeed<'_> {
+    type Value = Value;
+
+    fn deserialize<D>(self, deserializer: D) -> Result<Self::Value, D::Error>
+    where
+        D: serde::Deserializer<'de>,
+    {
+        deserializer.deserialize_map(ProjectedVisitor(self.0))
+    }
+}
+
+struct ProjectedVisitor<'a>(&'a [String]);
+impl<'de> Visitor<'de> for ProjectedVisitor<'_> {
+    type Value = Value;
+
+    fn expecting(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter.write_str("a JSON object")
+    }
+
+    fn visit_map<A>(self, mut object: A) -> Result<Self::Value, A::Error>
+    where
+        A: MapAccess<'de>,
+    {
+        let mut projected = Map::new();
+        while let Some(key) = object.next_key::<String>()? {
+            if self.0.binary_search(&key).is_ok() {
+                projected.insert(key, object.next_value()?);
+            } else {
+                object.next_value::<IgnoredAny>()?;
+            }
+        }
+        Ok(Value::Object(projected))
+    }
+}
+
+fn project_value(value: &str, fields: &[String]) -> Result<Value, StatePageError> {
+    if !value.trim_start().starts_with('{') {
+        return Err(StatePageError::ProjectedRecordNotObject);
+    }
+    let mut deserializer = serde_json::Deserializer::from_str(value);
+    let projected = ProjectedSeed(fields)
+        .deserialize(&mut deserializer)
+        .map_err(|_| StatePageError::Internal)?;
+    deserializer.end().map_err(|_| StatePageError::Internal)?;
+    Ok(projected)
+}
+pub fn list(connection: &Connection, scope: &str) -> anyhow::Result<Vec<Value>> {
+    let transaction = connection.unchecked_transaction()?;
+    commit::read_allowed(&transaction, scope, "", None)?;
+    let bytes:i64=transaction.query_row("SELECT COALESCE(SUM(value_bytes+1),0)+2 FROM state_rows WHERE scope=?1 AND value IS NOT NULL",[scope],|r|r.get(0))?;
+    if bytes > LEGACY_LIST_BYTES as i64 - 4096 {
+        return Err(protocol::error("STATE_TX_LIMIT_EXCEEDED"));
+    }
+    let mut statement = transaction.prepare(
+        "SELECT value,value_bytes FROM state_rows WHERE scope=?1 AND value IS NOT NULL ORDER BY position",
+    )?;
+    let mut rows = statement.query([scope])?;
+    let mut values = Vec::new();
+    while let Some(row) = rows.next()? {
+        let encoded: Vec<u8> = row.get(0)?;
+        let logical_bytes: i64 = row.get(1)?;
+        values.push(serde_json::from_str(&database::decode_value(
+            &encoded,
+            logical_bytes,
+        )?)?);
+    }
+    Ok(values)
+}
+pub fn page(
+    connection: &Connection,
+    scope: &str,
+    cursor: Option<&str>,
+    limit: u32,
+    max_bytes: u32,
+    generation: uuid::Uuid,
+) -> Result<StateListPageResult, StatePageError> {
+    page_inner(
+        connection, scope, cursor, limit, max_bytes, None, generation,
+    )
+    .map_err(|error| {
+        if let Some(page) = error.downcast_ref::<PageFailure>() {
+            return page.0.clone();
+        }
+        if error
+            .downcast_ref::<protocol::TxError>()
+            .is_some_and(|e| e.0 == "STATE_GRAPH_RECOVERY_REQUIRED")
+        {
+            return StatePageError::RecoveryRequired;
+        }
+        tracing::warn!(error=?error,"SQLite state page failed");
+        StatePageError::Internal
+    })
+}
+pub fn page_projected(
+    connection: &Connection,
+    scope: &str,
+    cursor: Option<&str>,
+    limit: u32,
+    max_bytes: u32,
+    fields: &[String],
+    generation: uuid::Uuid,
+) -> Result<StateListPageResult, StatePageError> {
+    let fields = crate::workers::state::structs::canonical_state_page_fields(fields)
+        .ok_or(StatePageError::InvalidProjection)?;
+    page_inner(
+        connection,
+        scope,
+        cursor,
+        limit,
+        max_bytes,
+        Some(&fields),
+        generation,
+    )
+    .map_err(|error| {
+        if let Some(page) = error.downcast_ref::<PageFailure>() {
+            return page.0.clone();
+        }
+        if error
+            .downcast_ref::<protocol::TxError>()
+            .is_some_and(|e| e.0 == "STATE_GRAPH_RECOVERY_REQUIRED")
+        {
+            return StatePageError::RecoveryRequired;
+        }
+        tracing::warn!(error=?error,"SQLite projected state page failed");
+        StatePageError::Internal
+    })
+}
+#[derive(Debug, thiserror::Error)]
+#[error("state page rejected")]
+struct PageFailure(StatePageError);
+fn reject(error: StatePageError) -> anyhow::Error {
+    PageFailure(error).into()
+}
+fn page_inner(
+    connection: &Connection,
+    scope: &str,
+    cursor: Option<&str>,
+    limit: u32,
+    max_bytes: u32,
+    fields: Option<&[String]>,
+    generation: uuid::Uuid,
+) -> anyhow::Result<StateListPageResult> {
+    if limit == 0 || limit > 1024 || max_bytes == 0 || max_bytes > 1_048_576 {
+        return Err(reject(StatePageError::InvalidCursor));
+    }
+    let decoded = cursor
+        .map(|cursor| {
+            if cursor.len() > STATE_PAGE_MAX_CURSOR_BYTES {
+                return Err(reject(StatePageError::InvalidCursor));
+            }
+            let bytes = URL_SAFE_NO_PAD
+                .decode(cursor)
+                .map_err(|_| reject(StatePageError::InvalidCursor))?;
+            match fields {
+                Some(fields) => {
+                    let decoded = serde_json::from_slice::<ProjectedCursor>(&bytes)
+                        .map_err(|_| reject(StatePageError::InvalidCursor))?;
+                    if decoded.version != 3
+                        || decoded.mode != "projected"
+                        || decoded.fields.as_slice() != fields
+                    {
+                        return Err(reject(StatePageError::InvalidCursor));
+                    }
+                    Ok(DecodedCursor::Projected(decoded))
+                }
+                None => {
+                    let decoded = serde_json::from_slice::<Cursor>(&bytes)
+                        .map_err(|_| reject(StatePageError::InvalidCursor))?;
+                    if decoded.version != 2 {
+                        return Err(reject(StatePageError::InvalidCursor));
+                    }
+                    Ok(DecodedCursor::Full(decoded))
+                }
+            }
+        })
+        .transpose()?;
+    let transaction = connection.unchecked_transaction()?;
+    commit::read_allowed(&transaction, scope, "", None)?;
+    let fingerprint = URL_SAFE_NO_PAD.encode(Sha256::digest(scope.as_bytes()));
+    let revision = database::revision(&transaction, scope)?.to_string();
+    let start = if let Some(decoded) = decoded {
+        let (cursor_generation, cursor_scope, cursor_revision, after_position) = match decoded {
+            DecodedCursor::Full(decoded) => (
+                decoded.generation,
+                decoded.scope_fingerprint,
+                decoded.revision,
+                decoded.after_position,
+            ),
+            DecodedCursor::Projected(decoded) => (
+                decoded.generation,
+                decoded.scope_fingerprint,
+                decoded.revision,
+                decoded.after_position,
+            ),
+        };
+        if cursor_scope != fingerprint || after_position < 0 {
+            return Err(reject(StatePageError::InvalidCursor));
+        }
+        if cursor_generation != generation || cursor_revision != revision {
+            return Err(reject(StatePageError::StaleCursor));
+        }
+        let exists: bool = transaction.query_row(
+            "SELECT EXISTS(SELECT 1 FROM state_rows INDEXED BY state_rows_order WHERE scope=?1 AND position=?2 AND value IS NOT NULL)",
+            params![scope, after_position],
+            |row| row.get(0),
+        )?;
+        if !exists {
+            return Err(reject(StatePageError::InvalidCursor));
+        }
+        after_position
+    } else {
+        -1
+    };
+    let last_live_position: Option<i64> = transaction
+        .query_row(
+            "SELECT position FROM state_rows INDEXED BY state_rows_order WHERE scope=?1 AND value IS NOT NULL ORDER BY position DESC LIMIT 1",
+            [scope],
+            |row| row.get(0),
+        )
+        .optional()?;
+    let mut statement=transaction.prepare("SELECT position,value,value_bytes FROM state_rows INDEXED BY state_rows_order WHERE scope=?1 AND position>?2 AND value IS NOT NULL ORDER BY position LIMIT ?3")?;
+    let mut rows = statement.query(params![scope, start, limit])?;
+    let mut items = Vec::with_capacity(limit as usize);
+    let mut next_cursor = None;
+    let mut item_bytes = 0usize;
+    while let Some(row) = rows.next()? {
+        let position: i64 = row.get(0)?;
+        let logical_bytes: i64 = row.get(2)?;
+        let logical_bytes = usize::try_from(logical_bytes)?;
+        let projected = fields
+            .map(|fields| {
+                let encoded: Vec<u8> = row.get(1)?;
+                let value = database::decode_value(&encoded, logical_bytes as i64)?;
+                project_value(&value, fields).map_err(reject)
+            })
+            .transpose()?;
+        let value_bytes = match &projected {
+            Some(value) => protocol::size(value)?,
+            None => logical_bytes,
+        };
+        let more = last_live_position.is_some_and(|last_position| position < last_position);
+        let candidate_cursor = if more {
+            Some(match fields {
+                Some(fields) => encode_projected(&ProjectedCursor {
+                    version: 3,
+                    mode: "projected".to_string(),
+                    generation,
+                    scope_fingerprint: fingerprint.clone(),
+                    revision: revision.clone(),
+                    after_position: position,
+                    fields: fields.to_vec(),
+                })
+                .map_err(reject)?,
+                None => encode(&Cursor {
+                    version: 2,
+                    generation,
+                    scope_fingerprint: fingerprint.clone(),
+                    revision: revision.clone(),
+                    after_position: position,
+                })
+                .map_err(reject)?,
+            })
+        } else {
+            None
+        };
+        let candidate_bytes = item_bytes + value_bytes + usize::from(!items.is_empty());
+        let bytes = protocol::size(&StateListPageResult {
+            items: vec![],
+            next_cursor: candidate_cursor.clone(),
+        })? + candidate_bytes;
+        if bytes > max_bytes as usize {
+            if items.is_empty() {
+                return Err(reject(StatePageError::RecordTooLarge {
+                    required_bytes: bytes,
+                }));
+            }
+            break;
+        }
+        if let Some(projected) = projected {
+            items.push(projected);
+        } else {
+            let encoded: Vec<u8> = row.get(1)?;
+            let value = database::decode_value(&encoded, logical_bytes as i64)?;
+            items.push(serde_json::from_str(&value)?);
+        }
+        item_bytes = candidate_bytes;
+        next_cursor = candidate_cursor;
+    }
+    Ok(StateListPageResult { items, next_cursor })
+}
