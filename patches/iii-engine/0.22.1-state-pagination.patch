+#[tokio::test]
+#[ignore = "bounded synthetic SQLite preparation growth diagnostic"]
+async fn indexed_prepare_growth_diagnostic() {
+    let probe_id = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .unwrap()
+        .as_millis();
+    let path = output_dir().join(format!("synthetic-baseline-{probe_id}.sqlite3"));
+    let adapter = SqliteAdapter::new(Some(serde_json::json!({
+        "file_path": path.display().to_string()
+    })))
+    .unwrap();
+    let connection = database::open_for_migration(&path).unwrap();
+    seed_synthetic_graph(&connection);
+
+    let prepare_plan = explain(
+        &connection,
+        "SELECT key,position,json_object('id',json_extract(value,'$.id'),'name',json_extract(value,'$.name'),'stale',COALESCE(json_extract(value,'$.stale'),json('false')),'sourceObservationIds',json_extract(value,'$.sourceObservationIds')) FROM state_rows INDEXED BY state_rows_order WHERE scope=?1 AND value IS NOT NULL AND position>?2 ORDER BY position LIMIT ?3",
+    );
+    let gram_delete_plan = explain(
+        &connection,
+        "DELETE FROM retrieval_name_grams WHERE epoch=?1 AND key=?2",
+    );
+    let membership_delete_plan = explain(
+        &connection,
+        "DELETE FROM retrieval_membership WHERE epoch=?1 AND key=?2",
+    );
+
+    let mut elapsed_ms = Vec::new();
+    let mut processed_rows = 0usize;
+    loop {
+        let started = Instant::now();
+        let result = StateAdapter::retrieval(
+            &adapter,
+            serde_json::json!({
+                "action":"index_prepare",
+                "scope":graph::NODES,
+                "max_rows":BATCH_ROWS,
+                "max_bytes":BATCH_BYTES
+            }),
+        )
+        .await
+        .unwrap();
+        let millis = started.elapsed().as_secs_f64() * 1000.0;
+        processed_rows += result["processed"].as_u64().unwrap() as usize;
+        let done = result["status"] == "ready";
+        elapsed_ms.push(millis);
+        if done {
+            break;
+        }
+    }
+    let db_bytes = fs::metadata(&path).unwrap().len();
+    assert_eq!(processed_rows, ROWS);
+    let report = serde_json::json!({
+        "rows": ROWS,
+        "processed_rows": processed_rows,
+        "batch_rows": BATCH_ROWS,
+        "batches": elapsed_ms.len(),
+        "first_8_batch_ms": &elapsed_ms[..8.min(elapsed_ms.len())],
+        "last_8_batch_ms": &elapsed_ms[elapsed_ms.len().saturating_sub(8)..],
+        "mean_first_8_ms": elapsed_ms.iter().take(8).sum::<f64>() / 8.0,
+        "mean_last_8_ms": elapsed_ms.iter().rev().take(8).sum::<f64>() / 8.0,
+        "sqlite_bytes": db_bytes,
+        "prepare_query_plan": prepare_plan,
+        "gram_delete_query_plan": gram_delete_plan,
+        "membership_delete_query_plan": membership_delete_plan,
+        "retrieval_rows": connection.query_row("SELECT count(*) FROM retrieval_nodes", [], |r| r.get::<_, i64>(0)).unwrap(),
+        "gram_rows": connection.query_row("SELECT count(*) FROM retrieval_name_grams", [], |r| r.get::<_, i64>(0)).unwrap(),
+        "membership_rows": connection.query_row("SELECT count(*) FROM retrieval_membership", [], |r| r.get::<_, i64>(0)).unwrap(),
+        "index_status": prepare::prepare(&connection, graph::NODES, 1, BATCH_BYTES).unwrap()["status"],
+    });
+    let report_path = output_dir().join(format!("synthetic-baseline-{probe_id}.json"));
+    fs::write(&report_path, serde_json::to_vec_pretty(&report).unwrap()).unwrap();
+    eprintln!("PREPARATION_DIAGNOSTIC={}", report_path.display());
