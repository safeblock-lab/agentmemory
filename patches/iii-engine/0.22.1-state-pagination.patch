+
+pub fn vector(c: &Connection,index: &str,epoch:i64,key:&str,bytes:&[u8]) -> anyhow::Result<Vec<u8>> {
+    let active:bool=c.query_row("SELECT mode=1 FROM compact_config WHERE singleton=1",[],|r|r.get(0))?;
+    if !active {
+        c.execute("DELETE FROM compact_vector_refs WHERE index_id=?1 AND epoch=?2 AND id=?3",params![index,epoch,key])?;
+        return Ok(bytes.to_vec());
+    }
+    anyhow::ensure!(!c.is_autocommit() && bytes.len()<=LIMIT && bytes.len()%4==0,"STATE_TX_INVALID_REQUEST");
+    let blob=intern(c,1,bytes,bytes.len())?;
+    c.execute("INSERT INTO compact_vector_refs VALUES(?1,?2,?3,?4) ON CONFLICT(index_id,epoch,id) DO UPDATE SET blob=excluded.blob",params![index,epoch,key,blob])?;
+    Ok(marker(blob))
+}
+
+fn intern(c: &Connection, kind: i64, bytes: &[u8], logical: usize) -> anyhow::Result<i64> {
+    let digest = Sha256::digest(bytes).to_vec();
+    let found: Option<i64> = c.prepare_cached("SELECT id FROM compact_blobs WHERE kind=?1 AND digest=?2 AND logical_bytes=?3 AND (payload=?4 OR (kind=0 AND length(payload)=0 AND state_text_encode((SELECT value FROM compact_piece_values WHERE id=compact_blobs.id))=?4)) LIMIT 1")?.query_row(params![kind,digest,i64::try_from(logical)?,bytes],|r|r.get(0)).optional()?;
+    if let Some(id) = found { return Ok(id); }
+    c.prepare_cached("INSERT INTO compact_blobs(kind,digest,logical_bytes,payload) VALUES(?1,?2,?3,?4)")?.execute(params![kind,digest,i64::try_from(logical)?,bytes])?;
+    Ok(c.last_insert_rowid())
+}
+
+pub(super) struct BuiltList {
+    blob: i64,
+    packed: Vec<u8>,
+    canonical: String,
+}
+
+pub fn store(c: &Connection, scope: &str, key: &str, version: &str, text: &str) -> anyhow::Result<Vec<u8>> {
+    Ok(store_for_copy(c,scope,key,version,text,None)?.0)
+}
+
+fn store_for_copy(c: &Connection, scope: &str, key: &str, version: &str, text: &str, target_list: Option<&str>) -> anyhow::Result<(Vec<u8>,Option<BuiltList>)> {
+    anyhow::ensure!(!c.is_autocommit() && text.len() <= LIMIT,"STATE_TX_INVALID_REQUEST");
+    if maintenance_control(scope,key) {return Ok((super::codec::encode(text)?,None));}
+    collector::invalidate(c)?;
+    let id = super::root_layout::insert(c,scope,key,version,text.len())?;
+    let mut built_list=None;
+    for (ordinal,piece) in layout::pieces(c,text)?.into_iter().enumerate() {
+        let blob = intern(c,piece.kind,&piece.bytes,piece.logical)?;
+        if piece.kind == 2 {
+            membership::list_members(c,blob,&layout::unpack(&piece.bytes)?)?;
+        }
+        c.execute("INSERT INTO compact_segments VALUES(?1,?2,?3)",params![id,i64::try_from(ordinal)?,blob])?;
+        if target_list.is_some() && piece.canonical_list.as_deref()==target_list {
+            built_list=Some(BuiltList{blob,packed:piece.bytes,canonical:piece.canonical_list.unwrap()});
+        }
+    }
+    Ok((marker(id),built_list))
+}
+
+pub fn encode(c: &Connection, scope: &str, key: &str, version: &str, text: &str) -> anyhow::Result<Vec<u8>> {
+    if maintenance_control(scope,key) {return super::codec::encode(text);}
+    let active: bool = c.query_row("SELECT mode=1 FROM compact_config WHERE singleton=1",[],|r|r.get(0))?;
+    if active { store(c,scope,key,version,text) } else { super::codec::encode(text) }
+}
+
+pub use maintenance::{Request, Step, execute, status, receipt};
diff --git a/engine/src/workers/state/adapters/sqlite/compact/checkpoint.rs b/engine/src/workers/state/adapters/sqlite/compact/checkpoint.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/compact/checkpoint.rs
@@ -0,0 +1,83 @@
+use rusqlite::{Connection,OptionalExtension,Transaction,TransactionBehavior,params};
+use serde_json::{Value,json};
+use sha2::{Digest,Sha256};
+use std::{path::Path,time::{Duration,Instant}};
+
+pub fn execute(c:&Connection,path:&Path,request:super::Request)->anyhow::Result<Value> {
+    use super::super::{protocol::{require,error},storage_maintenance_lease};
+    require(c.is_autocommit() && matches!(request.step,super::Step::Checkpoint|super::Step::EnableIncremental|super::Step::Rebuild)
+        && !request.operation_id.is_empty() && request.operation_id.len()<=128
+        && (1..=128).contains(&request.limit) && (1024..=super::LIMIT).contains(&request.max_bytes)
+        && (1..=if matches!(request.step,super::Step::Rebuild) {600_000}else if matches!(request.step,super::Step::EnableIncremental) {86_400_000}else{25}).contains(&request.max_ms))?;
+    let digest=Sha256::digest(serde_json::to_vec(&request)?).to_vec();
+    let tx=Transaction::new_unchecked(c,TransactionBehavior::Immediate)?;
+    storage_maintenance_lease::validate_in_transaction(&tx,&request.lease_owner_id,request.lease_fence)?;
+    let prior:Option<(Vec<u8>,Option<String>)>=tx.query_row("SELECT digest,result FROM compact_checkpoints WHERE operation_id=?1",[&request.operation_id],|r|Ok((r.get(0)?,r.get(1)?))).optional()?;
+    if let Some((prior,result))=prior {
+        if prior!=digest {return Err(error("STATE_TX_REPLAY_CONFLICT"));}
+        let mut value=match result {Some(result)=>serde_json::from_str(&result)?,None=>super::status(&tx)?};
+        if value.get("operation_id").is_none() {
+            value["operation_id"]=json!(request.operation_id);value["processed_count"]=json!(0);value["input_bytes"]=json!(0);value["checkpoint_state"]=json!("pending");
+        }
+        tx.commit()?;
+        return Ok(value);
+    }
+    let pending:bool=tx.query_row("SELECT EXISTS(SELECT 1 FROM compact_checkpoints WHERE result IS NULL)",[],|r|r.get(0))?;
+    require(!pending)?;
+    let before=super::status(&tx)?;
+    require(before["phase"]=="compact" && before["generation"].as_str()==Some(request.expected_generation.as_str()))?;
+    let generation=super::super::protocol::next(super::super::protocol::counter(&request.expected_generation)?)?.to_string();
+    tx.execute("INSERT INTO compact_checkpoints(operation_id,digest,result) VALUES(?1,?2,NULL)",params![request.operation_id,digest])?;
+    tx.execute("UPDATE compact_config SET generation=?1 WHERE singleton=1",[generation])?;
+    tx.commit()?;
+
+    let started=Instant::now();
+    let before=super::super::storage_diagnostics::physical(c,path)?;
+    let (busy,frames,checkpointed)=if matches!(request.step,super::Step::EnableIncremental|super::Step::Rebuild) {
+        if let Err(cause)=super::super::storage_reclaim::migrate_rebuild(c,path,true,request.max_ms,matches!(request.step,super::Step::Rebuild)) {
+            super::checkpoint_recovery::persist_failure(c,path,&request,&cause)?;
+            return Err(cause);
+        }
+        (0,0,0)
+    }else {
+        let mut settings=super::super::storage_reclaim::Settings::begin(c,started,Duration::from_millis(request.max_ms))?;
+        let outcome=c.query_row("PRAGMA wal_checkpoint(TRUNCATE)",[],|r|Ok((r.get::<_,i64>(0)?,r.get::<_,i64>(1)?,r.get::<_,i64>(2)?)));
+        settings.restore()?;
+        outcome?
+    };
+    let after=super::super::storage_diagnostics::physical(c,path)?;
+    let tx=Transaction::new_unchecked(c,TransactionBehavior::Immediate)?;
+    storage_maintenance_lease::validate_in_transaction(&tx,&request.lease_owner_id,request.lease_fence)?;
+    let mut value=super::status(&tx)?;
+    value["operation_id"]=json!(request.operation_id);
+    value["processed_count"]=json!(0);value["input_bytes"]=json!(0);
+    value["checkpoint_state"]=json!(if busy==0 {"complete"}else{"deferred"});
+    value["checkpoint_performed"]=json!(matches!(request.step,super::Step::Checkpoint));
+    value["rebuild_performed"]=json!(matches!(request.step,super::Step::Rebuild));
+    value["incremental_enable_performed"]=json!(matches!(request.step,super::Step::EnableIncremental));value["checkpoint_busy"]=json!(busy!=0);
+    value["wal_frames"]=json!(frames);value["checkpointed_frames"]=json!(checkpointed);
+    value["before"]=before;value["after"]=after;
+    value["elapsed_ms"]=json!(started.elapsed().as_millis() as u64);
+    tx.execute("UPDATE compact_checkpoints SET result=?2 WHERE operation_id=?1 AND digest=?3",params![request.operation_id,serde_json::to_string(&value)?,digest])?;
+    tx.commit()?;
+    Ok(value)
+}
+
+pub fn receipt(c:&Connection,request:&super::Request)->anyhow::Result<Value> {
+    let digest=Sha256::digest(serde_json::to_vec(request)?).to_vec();
+    let saved:Option<(Vec<u8>,Option<String>)>=c.query_row("SELECT digest,result FROM compact_checkpoints WHERE operation_id=?1",[&request.operation_id],|r|Ok((r.get(0)?,r.get(1)?))).optional()?;
+    match saved {
+        None=>Ok(json!({"status":"not_found","operation_id":request.operation_id,"result":null})),
+        Some((prior,result))=>{
+            anyhow::ensure!(prior==digest,"STATE_TX_REPLAY_CONFLICT");
+            Ok(match result {
+                Some(value)=>{
+                    let result:Value=serde_json::from_str(&value)?;
+                    let outcome=match result["checkpoint_state"].as_str(){Some("failed")=>"failed",Some("unknown")=>"unknown",_=>"applied"};
+                    json!({"status":outcome,"operation_id":request.operation_id,"result":result})
+                },
+                None=>json!({"status":"pending","operation_id":request.operation_id,"result":null}),
+            })
+        }
+    }
+}
diff --git a/engine/src/workers/state/adapters/sqlite/compact/checkpoint_recovery.rs b/engine/src/workers/state/adapters/sqlite/compact/checkpoint_recovery.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/compact/checkpoint_recovery.rs
@@ -0,0 +1,72 @@
+use rusqlite::{params,Connection,OptionalExtension,Transaction,TransactionBehavior};
+use serde::{Deserialize,Serialize};
+use serde_json::{json,Value};
+use sha2::{Digest,Sha256};
+use std::path::Path;
+use super::super::{protocol::{require,error},storage_maintenance_lease};
+
+#[derive(Deserialize,Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct Request {
+    pub operation_id:String,pub original:super::Request,pub expected_current_generation:String,
+    pub lease_owner_id:String,pub lease_fence:u64,
+    pub exclusive_state_writer:bool,pub source_writers_quiescent:bool,
+    pub expected_auto_vacuum:i64,pub expected_user_version:i64,
+}
+
+pub fn recover(c:&Connection,path:&Path,r:Request)->anyhow::Result<Value> {
+    require(c.is_autocommit() && r.exclusive_state_writer && r.source_writers_quiescent
+        && matches!(r.original.step,super::Step::Rebuild)
+        && !r.operation_id.is_empty() && r.operation_id.len()<=128
+        && r.operation_id!=r.original.operation_id && r.lease_fence>r.original.lease_fence
+        && r.expected_auto_vacuum==2 && r.expected_user_version==4)?;
+    let original_digest=Sha256::digest(serde_json::to_vec(&r.original)?).to_vec();
+    let recovery_digest=format!("{:x}",Sha256::digest(serde_json::to_vec(&r)?));
+    let tx=Transaction::new_unchecked(c,TransactionBehavior::Immediate)?;
+    storage_maintenance_lease::validate_in_transaction(&tx,&r.lease_owner_id,r.lease_fence)?;
+    let (digest,result):(Vec<u8>,Option<String>)=tx.query_row(
+        "SELECT digest,result FROM compact_checkpoints WHERE operation_id=?1",[&r.original.operation_id],|v|Ok((v.get(0)?,v.get(1)?)))?;
+    anyhow::ensure!(digest==original_digest,"STATE_TX_REPLAY_CONFLICT");
+    if let Some(result)=result {
+        let value:Value=serde_json::from_str(&result)?;
+        anyhow::ensure!(value["recovery_operation_id"]==r.operation_id && value["recovery_digest"]==recovery_digest,"STATE_TX_REPLAY_CONFLICT");
+        tx.commit()?;return Ok(value);
+    }
+    let mut value=super::status(&tx)?;
+    require(value["phase"]=="compact" && value["generation"]==r.expected_current_generation
+        && super::super::protocol::next(super::super::protocol::counter(&r.original.expected_generation)?)?.to_string()==r.expected_current_generation)?;
+    let pending:i64=tx.query_row("SELECT count(*) FROM compact_checkpoints WHERE result IS NULL",[],|v|v.get(0))?;
+    require(pending==1)?;
+    let physical=super::super::storage_diagnostics::physical(&tx,path)?;
+    let version:i64=tx.pragma_query_value(None,"user_version",|v|v.get(0))?;
+    require(physical["auto_vacuum"]==r.expected_auto_vacuum && physical["page_size"]==4096 && version==r.expected_user_version)?;
+    // A historical NULL receipt cannot establish whether its physical action ran.
+    // Preserve that uncertainty; resolving the receipt never claims a rebuild.
+    value["operation_id"]=json!(r.original.operation_id);
+    value["checkpoint_state"]=json!("unknown");value["physical_outcome"]=json!("unknown");
+    value["original_request"]=serde_json::to_value(&r.original)?;
+    value["recovery_operation_id"]=json!(r.operation_id);value["recovery_digest"]=json!(recovery_digest);
+    value["recovery_request"]=serde_json::to_value(&r)?;value["reconciled_physical"]=physical;
+    value["recovered_at_ms"]=json!(chrono::Utc::now().timestamp_millis());
+    let changed=tx.execute("UPDATE compact_checkpoints SET result=?2 WHERE operation_id=?1 AND digest=?3 AND result IS NULL",
+        params![r.original.operation_id,serde_json::to_string(&value)?,original_digest])?;
+    require(changed==1)?;tx.commit()?;Ok(value)
+}
+
+pub fn persist_failure(c:&Connection,path:&Path,r:&super::Request,cause:&anyhow::Error)->anyhow::Result<()> {
+    let digest=Sha256::digest(serde_json::to_vec(r)?).to_vec();
+    let tx=Transaction::new_unchecked(c,TransactionBehavior::Immediate)?;
+    storage_maintenance_lease::validate_in_transaction(&tx,&r.lease_owner_id,r.lease_fence)?;
+    let mut value=super::status(&tx)?;
+    let interrupted=cause.chain().any(|e|matches!(e.downcast_ref::<rusqlite::Error>(),Some(rusqlite::Error::SqliteFailure(code,_)) if code.code==rusqlite::ErrorCode::OperationInterrupted));
+    value["operation_id"]=json!(r.operation_id);value["checkpoint_state"]=json!("failed");
+    value["physical_outcome"]=json!("unknown");
+    value["failure_code"]=json!(if interrupted {"SQLITE_INTERRUPT"}else{"STATE_STORAGE_MIGRATION_FAILED"});
+    value["original_request"]=serde_json::to_value(r)?;
+    value["observed_physical"]=super::super::storage_diagnostics::physical(&tx,path)?;
+    value["failed_at_ms"]=json!(chrono::Utc::now().timestamp_millis());
+    let changed=tx.execute("UPDATE compact_checkpoints SET result=?2 WHERE operation_id=?1 AND digest=?3 AND result IS NULL",
+        params![r.operation_id,serde_json::to_string(&value)?,digest])?;
+    if changed!=1{return Err(error("STATE_TX_REPLAY_CONFLICT"));}
+    tx.commit()?;Ok(())
+}
diff --git a/engine/src/workers/state/adapters/sqlite/compact/collector.rs b/engine/src/workers/state/adapters/sqlite/compact/collector.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/compact/collector.rs
@@ -0,0 +1,72 @@
+mod sets;
+mod concurrent;
+use rusqlite::{Connection,params};
+use serde_json::{Value,json};
+use std::time::{Duration,Instant};
+
+#[cfg(test)]
+pub(super) fn forward_blob_fixture(c:&Connection,request:&super::maintenance::Request)->anyhow::Result<(usize,usize,usize)> {
+    concurrent::begin(c)?;
+    let mut b=Budget {units:request.limit,inspected:0,deleted:0,bytes:0,max_bytes:request.max_bytes,yielded:false,started:Instant::now(),max_time:Duration::from_millis(request.max_ms),last:Duration::ZERO,queued:false};
+    sets::blobs(c,&mut b)?;
+    Ok((b.inspected,b.deleted,b.bytes))
+}
+
+pub(super) struct Budget {pub units:usize,pub inspected:usize,pub deleted:usize,pub bytes:usize,pub max_bytes:usize,pub yielded:bool,pub queued:bool,started:Instant,max_time:Duration,last:Duration}
+impl Budget {
+    pub fn chunk(&self)->usize {128.min(self.units.saturating_sub(self.inspected)).min(self.units.saturating_sub(self.deleted))}
+    pub fn deletes(&self)->usize {128.min(self.units.saturating_sub(self.deleted))}
+    fn available(&self)->bool {!self.yielded && self.chunk()>0 && self.bytes<self.max_bytes && (self.inspected==0 || self.started.elapsed().saturating_add(self.last.saturating_mul(2)).saturating_add(Duration::from_millis(50))<self.max_time)}
+}
+pub fn schema(c:&Connection)->anyhow::Result<()> {
+    c.execute_batch("CREATE TABLE IF NOT EXISTS compact_gc_progress(singleton INTEGER PRIMARY KEY CHECK(singleton=1),stage INTEGER NOT NULL,cycle_deleted INTEGER NOT NULL,done INTEGER NOT NULL,invalidated INTEGER NOT NULL,cycles INTEGER NOT NULL,inspected_total INTEGER NOT NULL,deleted_total INTEGER NOT NULL,inline_scope TEXT NOT NULL,inline_key TEXT NOT NULL,inline_version TEXT NOT NULL);
+    INSERT OR IGNORE INTO compact_gc_progress VALUES(1,0,0,0,1,0,0,0,'','',''); CREATE TABLE IF NOT EXISTS compact_gc_metrics(stage INTEGER PRIMARY KEY,inspected INTEGER NOT NULL,deleted INTEGER NOT NULL,bytes INTEGER NOT NULL); INSERT OR IGNORE INTO compact_gc_metrics VALUES(0,0,0,0),(1,0,0,0),(2,0,0,0),(3,0,0,0),(4,0,0,0);")?;Ok(())
+}
+pub fn invalidate(c:&Connection)->anyhow::Result<()> {c.execute("UPDATE compact_gc_progress SET invalidated=1,done=0 WHERE singleton=1 AND invalidated=0",[])?;Ok(())}
+pub fn collect(c:&Connection,request:&super::maintenance::Request)->anyhow::Result<(usize,usize,usize)> {
+    anyhow::ensure!(!super::super::storage_repack::protected(c)?,"STATE_REPACK_ORIGINAL_PROTECTED");
+    anyhow::ensure!(!super::super::storage_lexical_repack::protected(c)?,"STATE_LEXICAL_ORIGINAL_PROTECTED");
+    concurrent::begin(c)?;
+    let mut b=Budget {units:request.limit,inspected:0,deleted:0,bytes:0,max_bytes:request.max_bytes,yielded:false,started:Instant::now(),max_time:Duration::from_millis(request.max_ms),last:Duration::ZERO,queued:false};
+    let mut prefer_queue=false;
+    while b.available() {
+        let mut stage:i64=c.query_row("SELECT stage FROM compact_gc_progress WHERE singleton=1",[],|r|r.get(0))?;
+        if stage==5 {concurrent::boundary(c)?;stage=c.query_row("SELECT stage FROM compact_gc_progress WHERE singleton=1",[],|r|r.get(0))?;}
+        let done:bool=c.query_row("SELECT done FROM compact_gc_progress WHERE singleton=1",[],|r|r.get(0))?;
+        if done {break;}
+        let clock=super::super::storage_profile::Clock::start();let started=Instant::now();let before=(b.inspected,b.deleted,b.bytes);
+        let queued=if prefer_queue || stage==5 {concurrent::drain(c,&mut b)?} else {None};
+        let complete=if queued.is_some() {false} else {match stage {0=>sets::graph(c,&mut b)?,1=>sets::maps(c,&mut b)?,2=>sets::roots(c,&mut b)?,3=>sets::blobs(c,&mut b)?,4=>sets::inline(c,&mut b)?,5=>{concurrent::boundary(c)?;break;},_=>anyhow::bail!("STATE_COMPACT_CORRUPT")}};
+        prefer_queue=queued.is_none();
+        let work_stage=queued.unwrap_or(stage);
+        b.last=b.last.max(started.elapsed());c.execute("UPDATE compact_gc_progress SET stage=stage+?1,cycle_deleted=cycle_deleted+?2,inspected_total=inspected_total+?3,deleted_total=deleted_total+?2 WHERE singleton=1",params![i64::from(complete),i64::try_from(b.deleted-before.1)?,i64::try_from(b.inspected-before.0)?])?;
+        c.execute("UPDATE compact_gc_metrics SET inspected=inspected+?1,deleted=deleted+?2,bytes=bytes+?3 WHERE stage=?4",params![i64::try_from(b.inspected-before.0)?,i64::try_from(b.deleted-before.1)?,i64::try_from(b.bytes-before.2)?,work_stage])?;
+        super::super::storage_profile::emit(match work_stage{0=>"collect_graph",1=>"collect_map",2=>"collect_root",3=>"collect_blob",_=>"collect_inline"},clock,b.inspected-before.0,b.bytes-before.2);
+        if !complete && b.inspected==before.0 && b.deleted==before.1 {break;}
+    }
+    if c.query_row("SELECT stage=5 FROM compact_gc_progress WHERE singleton=1",[],|r|r.get::<_,bool>(0))? {concurrent::boundary(c)?;}
+    anyhow::ensure!(b.inspected<=request.limit && b.deleted<=request.limit && b.bytes<=request.max_bytes,"STATE_COMPACT_CORRUPT");Ok((b.inspected,b.deleted,b.bytes))
+}
+pub fn progress(c:&Connection)->anyhow::Result<Value> {
+    let stages=c.prepare_cached("SELECT stage,inspected,deleted,bytes FROM compact_gc_metrics ORDER BY stage")?.query_map([],|r|Ok(json!({"stage":r.get::<_,i64>(0)?,"inspected":r.get::<_,i64>(1)?,"deleted":r.get::<_,i64>(2)?,"bytes":r.get::<_,i64>(3)?})))?.collect::<rusqlite::Result<Vec<_>>>()?;
+    let concurrency=concurrent::progress(c)?;
+    c.query_row("SELECT stage,done,invalidated,cycles,cycle_deleted,inspected_total,deleted_total,inline_scope,inline_key,inline_version FROM compact_gc_progress WHERE singleton=1",[],|r|Ok(json!({"stages":stages,"concurrent_gc":concurrency,"unit_definition":"inspected candidates and bounded queue expansion; separately bounded deleted payload/reference rows", "stage":r.get::<_,i64>(0)?,"complete":r.get::<_,bool>(1)? && concurrency["seed_complete"]==true && concurrency["queue_pending"]==0,"invalidated":r.get::<_,bool>(2)?,"cycles":r.get::<_,i64>(3)?,"cycle_deleted":r.get::<_,i64>(4)?,"inspected_total":r.get::<_,i64>(5)?,"deleted_total":r.get::<_,i64>(6)?,"inline_cursor":{"scope":r.get::<_,String>(7)?,"key":r.get::<_,String>(8)?,"version":r.get::<_,String>(9)?}}))).map_err(Into::into)
+}
+
+pub fn reference_schema(c:&Connection)->anyhow::Result<()> {
+    concurrent::schema(c)?;
+    for (table,columns,condition) in [
+        ("state_rows","scope,key,version,value","OLD.scope IS NOT NEW.scope OR OLD.key IS NOT NEW.key OR OLD.version IS NOT NEW.version OR OLD.value IS NOT NEW.value"),
+        ("retrieval_vectors","index_id,epoch,id,embedding","OLD.index_id IS NOT NEW.index_id OR OLD.epoch IS NOT NEW.epoch OR OLD.id IS NOT NEW.id OR OLD.embedding IS NOT NEW.embedding"),
+        ("retrieval_nodes","epoch,key","OLD.epoch IS NOT NEW.epoch OR OLD.key IS NOT NEW.key"),
+    ] {
+        for operation in ["INSERT","DELETE"] {c.execute_batch(&format!("CREATE TRIGGER IF NOT EXISTS compact_gc_{table}_{operation} AFTER {operation} ON {table} BEGIN UPDATE compact_gc_progress SET invalidated=1,done=0 WHERE singleton=1 AND invalidated=0; END;"))?;}
+        if table=="state_rows" {
+            let inline_control="CASE WHEN OLD.scope='mem:storage-maintenance' AND OLD.key='current' AND NEW.scope='mem:storage-maintenance' AND NEW.key='current' AND OLD.value IS NOT NULL AND NEW.value IS NOT NULL THEN CASE WHEN state_compact_root(OLD.value) IS NULL AND state_compact_root(NEW.value) IS NULL THEN json_valid(state_json(OLD.value,OLD.value_bytes)) AND json_valid(state_json(NEW.value,NEW.value_bytes)) ELSE 0 END ELSE 0 END";
+            c.execute_batch(&format!("SAVEPOINT compact_gc_control_inline_v1; DROP TRIGGER IF EXISTS compact_gc_state_rows_UPDATE; CREATE TRIGGER compact_gc_state_rows_UPDATE AFTER UPDATE OF {columns} ON state_rows WHEN ({condition}) AND NOT ({inline_control}) BEGIN UPDATE compact_gc_progress SET invalidated=1,done=0 WHERE singleton=1 AND invalidated=0; END; RELEASE compact_gc_control_inline_v1;"))?;
+        } else {
+            c.execute_batch(&format!("CREATE TRIGGER IF NOT EXISTS compact_gc_{table}_UPDATE AFTER UPDATE OF {columns} ON {table} WHEN {condition} BEGIN UPDATE compact_gc_progress SET invalidated=1,done=0 WHERE singleton=1 AND invalidated=0; END;"))?;
+        }
+    }
+    Ok(())
+}
diff --git a/engine/src/workers/state/adapters/sqlite/compact/collector/concurrent.rs b/engine/src/workers/state/adapters/sqlite/compact/collector/concurrent.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/compact/collector/concurrent.rs
@@ -0,0 +1,118 @@
+use super::{sets,Budget};
+use rusqlite::{params,Connection,OptionalExtension};
+use serde_json::{json,Value};
+
+pub(super) fn schema(c:&Connection)->anyhow::Result<()> {
+    c.execute_batch(include_str!("concurrent.sql"))?;
+    let physical:bool=c.query_row("SELECT EXISTS(SELECT 1 FROM sqlite_schema WHERE type='table' AND name='compact_list_members')",[],|r|r.get(0))?;
+    if physical {
+        c.execute_batch("CREATE TRIGGER IF NOT EXISTS compact_gc_member_retired AFTER DELETE ON compact_list_members BEGIN INSERT INTO compact_gc_queue(stage,epoch,id) VALUES(5,-1,OLD.identifier) ON CONFLICT(stage,epoch,id) DO UPDATE SET dirty_again=1; END; CREATE TRIGGER IF NOT EXISTS compact_gc_member_replaced AFTER UPDATE OF identifier,list_id ON compact_list_members BEGIN INSERT INTO compact_gc_queue(stage,epoch,id) VALUES(5,-1,OLD.identifier) ON CONFLICT(stage,epoch,id) DO UPDATE SET dirty_again=1; END;")?;
+    }
+    Ok(())
+}
+fn bounds(c:&Connection)->anyhow::Result<()> {
+    c.execute_batch("UPDATE compact_gc_seed SET initialized=1,
+      graph_epoch=coalesce((SELECT epoch FROM compact_graph_lists ORDER BY epoch DESC,key DESC LIMIT 1),-1),
+      graph_key=coalesce((SELECT key FROM compact_graph_lists ORDER BY epoch DESC,key DESC LIMIT 1),0),
+      map_epoch=coalesce((SELECT epoch FROM compact_graph_identifiers ORDER BY epoch DESC,identifier DESC LIMIT 1),-1),
+      map_identifier=coalesce((SELECT identifier FROM compact_graph_identifiers ORDER BY epoch DESC,identifier DESC LIMIT 1),0),
+      root=coalesce((SELECT max(id) FROM compact_roots),0),blob=coalesce((SELECT max(id) FROM compact_blobs),0),
+      inline_scope=coalesce((SELECT scope FROM compact_rollback ORDER BY scope DESC,key DESC,version DESC LIMIT 1),''),
+      inline_key=coalesce((SELECT key FROM compact_rollback ORDER BY scope DESC,key DESC,version DESC LIMIT 1),''),
+      inline_version=coalesce((SELECT version FROM compact_rollback ORDER BY scope DESC,key DESC,version DESC LIMIT 1),'') WHERE singleton=1;")?;
+    Ok(())
+}
+pub(super) fn begin(c:&Connection)->anyhow::Result<()> {
+    let initialized:bool=c.query_row("SELECT initialized FROM compact_gc_seed WHERE singleton=1",[],|r|r.get(0))?;
+    if initialized {return Ok(());}
+    bounds(c)?;
+    let stage:i64=c.query_row("SELECT stage FROM compact_gc_progress WHERE singleton=1",[],|r|r.get(0))?;
+    c.execute("UPDATE compact_gc_progress SET done=0 WHERE singleton=1",[])?;
+    if stage==5 {fresh_seed(c)?;}
+    Ok(())
+}
+fn fresh_seed(c:&Connection)->anyhow::Result<()> {
+    bounds(c)?;
+    c.execute("UPDATE compact_gc_seed SET legacy_resume=0,complete=0 WHERE singleton=1",[])?;
+    c.execute("UPDATE compact_gc_cursor SET root=0,graph_epoch=-1,graph_key=0,map_epoch=-1,map_identifier=0,blob=0 WHERE singleton=1",[])?;
+    c.execute("UPDATE compact_gc_progress SET stage=0,cycle_deleted=0,done=0,cycles=cycles+1 WHERE singleton=1",[])?;
+    Ok(())
+}
+pub(super) fn boundary(c:&Connection)->anyhow::Result<()> {
+    let legacy:bool=c.query_row("SELECT legacy_resume FROM compact_gc_seed WHERE singleton=1",[],|r|r.get(0))?;
+    if legacy {return fresh_seed(c);}
+    c.execute("UPDATE compact_gc_seed SET complete=1 WHERE singleton=1",[])?;
+    let pending:bool=c.query_row("SELECT EXISTS(SELECT 1 FROM compact_gc_queue)",[],|r|r.get(0))?;
+    c.execute("UPDATE compact_gc_progress SET done=?1,invalidated=?2 WHERE singleton=1",params![!pending,pending])?;
+    Ok(())
+}
+pub(super) fn pairs(c:&Connection,stage:i64,limit:usize)->anyhow::Result<Vec<[i64;2]>> {
+    Ok(c.prepare_cached("SELECT epoch,id FROM compact_gc_queue WHERE stage=?1 ORDER BY ticket LIMIT ?2")?.query_map(params![stage,i64::try_from(limit)?],|r|Ok([r.get(0)?,r.get(1)?]))?.collect::<rusqlite::Result<_>>()?)
+}
+pub(super) fn ids(c:&Connection,stage:i64,limit:usize)->anyhow::Result<Vec<i64>> {Ok(pairs(c,stage,limit)?.into_iter().map(|pair|pair[1]).collect())}
+pub(super) fn acknowledge_pairs(c:&Connection,stage:i64,rows:&[[i64;2]])->anyhow::Result<()> {
+    c.execute("DELETE FROM compact_gc_queue WHERE stage=?1 AND (epoch,id) IN(SELECT json_extract(value,'$[0]'),json_extract(value,'$[1]') FROM json_each(?2))",params![stage,serde_json::to_string(rows)?])?;Ok(())
+}
+pub(super) fn acknowledge_ids(c:&Connection,stage:i64,rows:&[i64],blocked:&[i64])->anyhow::Result<()> {
+    let rows=rows.iter().copied().filter(|id|!blocked.contains(id)).map(|id|[0,id]).collect::<Vec<_>>();
+    acknowledge_pairs(c,stage,&rows)
+}
+pub(super) fn member_retired(c:&Connection,identifier:i64)->anyhow::Result<()> {
+    c.execute("INSERT INTO compact_gc_queue(stage,epoch,id) VALUES(5,-1,?1) ON CONFLICT(stage,epoch,id) DO UPDATE SET dirty_again=1",[identifier])?;Ok(())
+}
+fn list_entries(c:&Connection,b:&mut Budget,ticket:i64,id:i64,cursor:i64,upper:i64,block_cursor:i64)->anyhow::Result<Option<(Vec<i64>,Option<i64>)>> {
+    let physical:bool=c.query_row("SELECT EXISTS(SELECT 1 FROM sqlite_schema WHERE type='table' AND name='compact_list_members')",[],|r|r.get(0))?;
+    if physical {
+        return Ok(Some((c.prepare_cached("SELECT identifier FROM compact_list_members WHERE list_id=?1 AND identifier>?2 AND identifier<=?3 ORDER BY identifier LIMIT ?4")?.query_map(params![id,cursor,upper,i64::try_from(b.chunk())?],|r|r.get::<_,i64>(0))?.collect::<rusqlite::Result<Vec<_>>>()?,None)));
+    }
+    for (sql,next) in [("SELECT edge,length(payload) FROM compact_forward_blocks WHERE list_id=?1 AND edge<=?2 AND edge>?3 ORDER BY edge DESC LIMIT 1",false),("SELECT edge,length(payload) FROM compact_forward_blocks WHERE list_id=?1 AND edge>?2 AND edge<=?3 ORDER BY edge LIMIT 1",true)] {
+        let block:Option<(i64,i64)>=c.query_row(sql,params![id,cursor,if next {upper}else{block_cursor}],|r|Ok((r.get(0)?,r.get(1)?))).optional()?;
+        let Some((edge,bytes))=block else {continue;};let bytes=usize::try_from(bytes)?;
+        if bytes>b.max_bytes.saturating_sub(b.bytes) {anyhow::ensure!(b.bytes>0,"STATE_TX_LIMIT_EXCEEDED");b.yielded=true;return Ok(None);}
+        let raw:String=c.query_row("SELECT state_forward_ids(payload) FROM compact_forward_blocks WHERE list_id=?1 AND edge=?2",params![id,edge],|r|r.get(0))?;
+        let entries:Vec<i64>=serde_json::from_str(&raw)?;b.bytes+=bytes;
+        let mut selected=entries.into_iter().filter(|value|*value>cursor && *value<=upper).collect::<Vec<_>>();
+        if selected.len()<=b.chunk() {c.execute("UPDATE compact_gc_queue SET block_cursor=?2 WHERE ticket=?1",params![ticket,edge])?;}
+        selected.truncate(b.chunk());
+        if !selected.is_empty() {return Ok(Some((selected,None)));}
+        if edge>cursor {return Ok(Some((Vec::new(),Some(edge))));}
+    }
+    Ok(Some((Vec::new(),None)))
+}
+fn expand_maps(c:&Connection,b:&mut Budget,ticket:i64,stage:i64,epoch:i64,id:i64,cursor:i64,upper:i64,block_cursor:i64)->anyhow::Result<()> {
+    let upper=if upper<0 {
+        let upper:i64=if stage==5 {c.query_row("SELECT coalesce(max(epoch),-1) FROM compact_graph_identifiers WHERE identifier=?1",[id],|r|r.get(0))?} else {c.query_row("SELECT coalesce(max(id),-1) FROM compact_identifiers",[],|r|r.get(0))?};
+        c.execute("UPDATE compact_gc_queue SET upper_bound=?2 WHERE ticket=?1",params![ticket,upper])?;upper
+    } else {upper};
+    let entries=if stage==5 {c.prepare_cached("SELECT epoch FROM compact_graph_identifiers INDEXED BY compact_gc_map_identifier WHERE identifier=?1 AND epoch>?2 AND epoch<=?3 ORDER BY epoch LIMIT ?4")?.query_map(params![id,cursor,upper,i64::try_from(b.chunk())?],|r|r.get::<_,i64>(0))?.collect::<rusqlite::Result<Vec<_>>>()?} else {
+        let Some((entries,advance))=list_entries(c,b,ticket,id,cursor,upper,block_cursor)? else {return Ok(());};
+        if let Some(advance)=advance {c.execute("UPDATE compact_gc_queue SET cursor=?2 WHERE ticket=?1",params![ticket,advance])?;b.inspected+=1;return Ok(());}
+        entries
+    };
+    if let Some(last)=entries.last() {
+        for entry in &entries {let pair=if stage==5 {[*entry,id]} else {[epoch,*entry]};c.execute("INSERT INTO compact_gc_queue(stage,epoch,id) VALUES(1,?1,?2) ON CONFLICT(stage,epoch,id) DO NOTHING",params![pair[0],pair[1]])?;}
+        c.execute("UPDATE compact_gc_queue SET cursor=?2 WHERE ticket=?1",params![ticket,last])?;
+        b.inspected+=entries.len();
+    } else {
+        let again:bool=c.query_row("SELECT dirty_again FROM compact_gc_queue WHERE ticket=?1",[ticket],|r|r.get(0))?;
+        if again {c.execute("UPDATE compact_gc_queue SET cursor=-1,upper_bound=-1,block_cursor=-1,dirty_again=0 WHERE ticket=?1",[ticket])?;}
+        else {c.execute("DELETE FROM compact_gc_queue WHERE ticket=?1",[ticket])?;}
+        b.inspected+=1;
+    }
+    Ok(())
+}
+pub(super) fn drain(c:&Connection,b:&mut Budget)->anyhow::Result<Option<i64>> {
+    let first:Option<(i64,i64,i64,i64,i64,i64,i64)>=c.query_row("SELECT ticket,stage,epoch,id,cursor,upper_bound,block_cursor FROM compact_gc_queue ORDER BY ticket LIMIT 1",[],|r|Ok((r.get(0)?,r.get(1)?,r.get(2)?,r.get(3)?,r.get(4)?,r.get(5)?,r.get(6)?))).optional()?;
+    let Some((ticket,stage,epoch,id,cursor,upper,block_cursor))=first else {return Ok(None);};
+    b.queued=true;
+    let result=match stage {
+        0=>sets::graph(c,b).map(|_|()),1=>sets::maps(c,b).map(|_|()),2=>sets::roots(c,b).map(|_|()),3=>sets::blobs(c,b).map(|_|()),
+        4=>sets::inline(c,b).and_then(|complete|{if complete {c.execute("DELETE FROM compact_gc_queue WHERE stage=4",[])?;b.inspected+=1;}Ok(())}),
+        5|6=>expand_maps(c,b,ticket,stage,epoch,id,cursor,upper,block_cursor),_=>Err(super::super::super::protocol::error("STATE_COMPACT_CORRUPT")),
+    };
+    b.queued=false;result?;Ok(Some(if stage>=5 {1}else{stage}))
+}
+pub(super) fn progress(c:&Connection)->anyhow::Result<Value> {
+    let pending:i64=c.query_row("SELECT pending FROM compact_gc_queue_meta WHERE singleton=1",[],|r|r.get(0))?;
+    c.query_row("SELECT complete,legacy_resume,graph_epoch,graph_key,map_epoch,map_identifier,root,blob FROM compact_gc_seed WHERE singleton=1",[],|r|Ok(json!({"version":1,"mode":"finite_seed_and_retirement_queue","seed_complete":r.get::<_,bool>(0)?,"legacy_resume":r.get::<_,bool>(1)?,"queue_pending":pending,"watermarks":{"graph_epoch":r.get::<_,i64>(2)?,"graph_key":r.get::<_,i64>(3)?,"map_epoch":r.get::<_,i64>(4)?,"map_identifier":r.get::<_,i64>(5)?,"root":r.get::<_,i64>(6)?,"blob":r.get::<_,i64>(7)?}}))).map_err(Into::into)
+}
diff --git a/engine/src/workers/state/adapters/sqlite/compact/collector/concurrent.sql b/engine/src/workers/state/adapters/sqlite/compact/collector/concurrent.sql
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/compact/collector/concurrent.sql
@@ -0,0 +1,113 @@
+CREATE TABLE IF NOT EXISTS compact_gc_seed (
+ singleton INTEGER PRIMARY KEY CHECK(singleton=1), initialized INTEGER NOT NULL DEFAULT 0,
+ complete INTEGER NOT NULL DEFAULT 0, legacy_resume INTEGER NOT NULL DEFAULT 1,
+ graph_epoch INTEGER NOT NULL DEFAULT -1, graph_key INTEGER NOT NULL DEFAULT 0,
+ map_epoch INTEGER NOT NULL DEFAULT -1, map_identifier INTEGER NOT NULL DEFAULT 0,
+ root INTEGER NOT NULL DEFAULT 0, blob INTEGER NOT NULL DEFAULT 0,
+ inline_scope TEXT NOT NULL DEFAULT '', inline_key TEXT NOT NULL DEFAULT '', inline_version TEXT NOT NULL DEFAULT '');
+INSERT OR IGNORE INTO compact_gc_seed(singleton) VALUES(1);
+CREATE TABLE IF NOT EXISTS compact_gc_queue (
+ ticket INTEGER PRIMARY KEY AUTOINCREMENT, stage INTEGER NOT NULL CHECK(stage BETWEEN 0 AND 6),
+ epoch INTEGER NOT NULL, id INTEGER NOT NULL, cursor INTEGER NOT NULL DEFAULT -1,
+ upper_bound INTEGER NOT NULL DEFAULT -1, block_cursor INTEGER NOT NULL DEFAULT -1, dirty_again INTEGER NOT NULL DEFAULT 0,
+ UNIQUE(stage,epoch,id));
+CREATE INDEX IF NOT EXISTS compact_gc_queue_stage ON compact_gc_queue(stage,ticket);
+CREATE TABLE IF NOT EXISTS compact_gc_queue_meta(singleton INTEGER PRIMARY KEY CHECK(singleton=1),pending INTEGER NOT NULL CHECK(pending>=0));
+INSERT INTO compact_gc_queue_meta SELECT 1,(SELECT count(*) FROM compact_gc_queue) WHERE NOT EXISTS(SELECT 1 FROM compact_gc_queue_meta WHERE singleton=1) ON CONFLICT(singleton) DO NOTHING;
+CREATE INDEX IF NOT EXISTS compact_gc_map_identifier ON compact_graph_identifiers(identifier,epoch);
+CREATE TRIGGER IF NOT EXISTS compact_gc_queue_pending AFTER INSERT ON compact_gc_queue BEGIN
+ UPDATE compact_gc_queue_meta SET pending=pending+1 WHERE singleton=1;
+ UPDATE compact_gc_progress SET done=0,invalidated=1 WHERE singleton=1;
+END;
+CREATE TRIGGER IF NOT EXISTS compact_gc_queue_acknowledged AFTER DELETE ON compact_gc_queue BEGIN
+ UPDATE compact_gc_queue_meta SET pending=pending-1 WHERE singleton=1;
+END;
+SAVEPOINT compact_gc_enqueue_upsert_v1;
+DROP TRIGGER IF EXISTS compact_gc_root_new;
+DROP TRIGGER IF EXISTS compact_gc_blob_new;
+DROP TRIGGER IF EXISTS compact_gc_segment_retired;
+DROP TRIGGER IF EXISTS compact_gc_segment_replaced;
+DROP TRIGGER IF EXISTS compact_gc_state_root_retired;
+DROP TRIGGER IF EXISTS compact_gc_state_root_replaced;
+DROP TRIGGER IF EXISTS compact_gc_graph_new;
+DROP TRIGGER IF EXISTS compact_gc_graph_retired;
+DROP TRIGGER IF EXISTS compact_gc_graph_replaced;
+DROP TRIGGER IF EXISTS compact_gc_map_new;
+DROP TRIGGER IF EXISTS compact_gc_map_replaced;
+DROP TRIGGER IF EXISTS compact_gc_vector_retired;
+DROP TRIGGER IF EXISTS compact_gc_vector_replaced;
+DROP TRIGGER IF EXISTS compact_gc_text_retired;
+DROP TRIGGER IF EXISTS compact_gc_text_replaced;
+DROP TRIGGER IF EXISTS compact_gc_inline_new;
+DROP TRIGGER IF EXISTS compact_gc_inverse_retired;
+DROP TRIGGER IF EXISTS compact_gc_inverse_replaced;
+DROP TRIGGER IF EXISTS compact_gc_node_retired;
+DROP TRIGGER IF EXISTS compact_gc_node_replaced;
+CREATE TRIGGER IF NOT EXISTS compact_gc_root_new AFTER INSERT ON compact_roots BEGIN
+ INSERT INTO compact_gc_queue(stage,epoch,id) VALUES(2,0,NEW.id) ON CONFLICT(stage,epoch,id) DO NOTHING;
+END;
+CREATE TRIGGER IF NOT EXISTS compact_gc_blob_new AFTER INSERT ON compact_blobs BEGIN
+ INSERT INTO compact_gc_queue(stage,epoch,id) VALUES(3,0,NEW.id) ON CONFLICT(stage,epoch,id) DO NOTHING;
+END;
+CREATE TRIGGER IF NOT EXISTS compact_gc_segment_retired AFTER DELETE ON compact_segments BEGIN
+ INSERT INTO compact_gc_queue(stage,epoch,id) VALUES(3,0,OLD.blob) ON CONFLICT(stage,epoch,id) DO NOTHING;
+END;
+CREATE TRIGGER IF NOT EXISTS compact_gc_segment_replaced AFTER UPDATE OF blob ON compact_segments WHEN OLD.blob IS NOT NEW.blob BEGIN
+ INSERT INTO compact_gc_queue(stage,epoch,id) VALUES(3,0,OLD.blob) ON CONFLICT(stage,epoch,id) DO NOTHING;
+END;
+CREATE TRIGGER IF NOT EXISTS compact_gc_state_root_retired AFTER DELETE ON state_rows WHEN state_compact_root(OLD.value) IS NOT NULL BEGIN
+ INSERT INTO compact_gc_queue(stage,epoch,id) VALUES(2,0,state_compact_root(OLD.value)) ON CONFLICT(stage,epoch,id) DO NOTHING;
+END;
+CREATE TRIGGER IF NOT EXISTS compact_gc_state_root_replaced AFTER UPDATE OF scope,key,version,value ON state_rows WHEN state_compact_root(OLD.value) IS NOT NULL BEGIN
+ INSERT INTO compact_gc_queue(stage,epoch,id) VALUES(2,0,state_compact_root(OLD.value)) ON CONFLICT(stage,epoch,id) DO NOTHING;
+END;
+CREATE TRIGGER IF NOT EXISTS compact_gc_graph_new AFTER INSERT ON compact_graph_lists BEGIN
+ INSERT INTO compact_gc_queue(stage,epoch,id) VALUES(0,NEW.epoch,NEW.key) ON CONFLICT(stage,epoch,id) DO NOTHING;
+END;
+CREATE TRIGGER IF NOT EXISTS compact_gc_graph_retired AFTER DELETE ON compact_graph_lists BEGIN
+ INSERT INTO compact_gc_queue(stage,epoch,id) VALUES(3,0,OLD.list) ON CONFLICT(stage,epoch,id) DO NOTHING;
+ INSERT INTO compact_gc_queue(stage,epoch,id) VALUES(6,OLD.epoch,OLD.list) ON CONFLICT(stage,epoch,id) DO UPDATE SET dirty_again=1;
+END;
+CREATE TRIGGER IF NOT EXISTS compact_gc_graph_replaced AFTER UPDATE ON compact_graph_lists BEGIN
+ INSERT INTO compact_gc_queue(stage,epoch,id) VALUES(0,NEW.epoch,NEW.key) ON CONFLICT(stage,epoch,id) DO NOTHING;
+ INSERT INTO compact_gc_queue(stage,epoch,id) VALUES(3,0,OLD.list) ON CONFLICT(stage,epoch,id) DO NOTHING;
+ INSERT INTO compact_gc_queue(stage,epoch,id) VALUES(6,OLD.epoch,OLD.list) ON CONFLICT(stage,epoch,id) DO UPDATE SET dirty_again=1;
+END;
+CREATE TRIGGER IF NOT EXISTS compact_gc_map_new AFTER INSERT ON compact_graph_identifiers BEGIN
+ INSERT INTO compact_gc_queue(stage,epoch,id) VALUES(1,NEW.epoch,NEW.identifier) ON CONFLICT(stage,epoch,id) DO NOTHING;
+END;
+CREATE TRIGGER IF NOT EXISTS compact_gc_map_replaced AFTER UPDATE ON compact_graph_identifiers BEGIN
+ INSERT INTO compact_gc_queue(stage,epoch,id) VALUES(1,NEW.epoch,NEW.identifier) ON CONFLICT(stage,epoch,id) DO NOTHING;
+ INSERT INTO compact_gc_queue(stage,epoch,id) VALUES(1,OLD.epoch,OLD.identifier) ON CONFLICT(stage,epoch,id) DO NOTHING;
+END;
+CREATE TRIGGER IF NOT EXISTS compact_gc_vector_retired AFTER DELETE ON compact_vector_refs BEGIN
+ INSERT INTO compact_gc_queue(stage,epoch,id) VALUES(3,0,OLD.blob) ON CONFLICT(stage,epoch,id) DO NOTHING;
+END;
+CREATE TRIGGER IF NOT EXISTS compact_gc_vector_replaced AFTER UPDATE OF blob ON compact_vector_refs WHEN OLD.blob IS NOT NEW.blob BEGIN
+ INSERT INTO compact_gc_queue(stage,epoch,id) VALUES(3,0,OLD.blob) ON CONFLICT(stage,epoch,id) DO NOTHING;
+END;
+CREATE TRIGGER IF NOT EXISTS compact_gc_text_retired AFTER DELETE ON compact_text_locators BEGIN
+ INSERT INTO compact_gc_queue(stage,epoch,id) VALUES(3,0,OLD.blob) ON CONFLICT(stage,epoch,id) DO NOTHING;
+END;
+CREATE TRIGGER IF NOT EXISTS compact_gc_text_replaced AFTER UPDATE OF blob ON compact_text_locators WHEN OLD.blob IS NOT NEW.blob BEGIN
+ INSERT INTO compact_gc_queue(stage,epoch,id) VALUES(3,0,OLD.blob) ON CONFLICT(stage,epoch,id) DO NOTHING;
+END;
+CREATE TRIGGER IF NOT EXISTS compact_gc_inline_new AFTER INSERT ON compact_rollback BEGIN
+ INSERT INTO compact_gc_queue(stage,epoch,id) VALUES(4,0,0) ON CONFLICT(stage,epoch,id) DO NOTHING;
+END;
+CREATE TRIGGER IF NOT EXISTS compact_gc_inverse_retired AFTER DELETE ON compact_inverse_blocks BEGIN
+ INSERT INTO compact_gc_queue(stage,epoch,id) VALUES(5,-1,OLD.identifier) ON CONFLICT(stage,epoch,id) DO UPDATE SET dirty_again=1;
+END;
+CREATE TRIGGER IF NOT EXISTS compact_gc_inverse_replaced AFTER UPDATE OF identifier,payload ON compact_inverse_blocks BEGIN
+ INSERT INTO compact_gc_queue(stage,epoch,id) VALUES(5,-1,OLD.identifier) ON CONFLICT(stage,epoch,id) DO UPDATE SET dirty_again=1;
+END;
+CREATE TRIGGER IF NOT EXISTS compact_gc_node_retired AFTER DELETE ON retrieval_nodes BEGIN
+ INSERT INTO compact_gc_queue(stage,epoch,id)
+ SELECT 0,OLD.epoch,id FROM retrieval_identifiers WHERE epoch=OLD.epoch AND value=OLD.key ON CONFLICT(stage,epoch,id) DO NOTHING;
+END;
+CREATE TRIGGER IF NOT EXISTS compact_gc_node_replaced AFTER UPDATE OF epoch,key ON retrieval_nodes BEGIN
+ INSERT INTO compact_gc_queue(stage,epoch,id)
+ SELECT 0,OLD.epoch,id FROM retrieval_identifiers WHERE epoch=OLD.epoch AND value=OLD.key ON CONFLICT(stage,epoch,id) DO NOTHING;
+END;
+
+RELEASE compact_gc_enqueue_upsert_v1;
diff --git a/engine/src/workers/state/adapters/sqlite/compact/collector/sets.rs b/engine/src/workers/state/adapters/sqlite/compact/collector/sets.rs
