+#[test]
+fn shared_source_provenance_pages_twelve_at_a_time_and_rejects_stale_resume() {
+    let connection=fresh();
+    let refs=(0..20).map(|index|format!("session-{index:02}")).collect::<Vec<_>>();
+    for session in &refs {
+        write(&connection,"mem:sessions",session,Some(&json!({"id":session,"project":"shared"})));
+    }
+    let source=json!({"id":"memory","sessionIds":refs,"content":"shared evidence"});
+    write(&connection,"mem:memories","memory",Some(&source));
+    let first=call(&connection,json!({"action":"shared_source_projection","sources":[{"scope":"mem:memories","key":"memory"}]})).unwrap();
+    let item=&first["items"][0];
+    assert_eq!(item["status"],"partial");
+    assert_eq!(item["provenance"].as_array().unwrap().len(),12);
+    let cursor=item["next_cursor"].as_str().unwrap().to_owned();
+    let version=item["version"].as_str().unwrap().to_owned();
+    let fingerprint=item["fingerprint"].as_str().unwrap().to_owned();
+
+    let second=call(&connection,json!({"action":"shared_source_projection","sources":[{"scope":"mem:memories","key":"memory",
+        "expected_version":version,"provenance_cursor":cursor}]})).unwrap();
+    let next=&second["items"][0];
+    assert_eq!(next["status"],"ready");
+    assert_eq!(next["provenance"].as_array().unwrap().len(),8);
+    assert_eq!(next["fingerprint"],fingerprint);
+    assert!(next.get("next_cursor").is_none());
+
+    let mut changed=source;
+    changed["content"]=json!("changed evidence");
+    write(&connection,"mem:memories","memory",Some(&changed));
+    let stale=call(&connection,json!({"action":"shared_source_projection","sources":[{"scope":"mem:memories","key":"memory",
+        "expected_version":version,"provenance_cursor":cursor}]})).unwrap();
+    assert_eq!(stale["items"].as_array().unwrap().len(),0);
+    assert_eq!(stale["deferred"][0]["reason"],"stale");
+}
