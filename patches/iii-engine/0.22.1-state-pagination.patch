@@ -0,0 +1,48 @@
+use rusqlite::{Connection, functions::FunctionFlags};
+use serde_json::Value;
+
+pub const SQL: &str = "retrieval_source_eligible(scope,json_extract(state_value,'$.title'),CASE WHEN scope='mem:memories' THEN json_extract(state_value,'$.content') ELSE json_extract(state_value,'$.narrative') END,json_type(state_value,'$.isLatest'))";
+
+fn has_content(value: Option<&str>) -> bool {
+    value.is_some_and(|value|value.chars().any(|c|!matches!(c,'\u{0009}'..='\u{000d}'|'\u{0020}'|'\u{00a0}'|'\u{1680}'|'\u{2000}'..='\u{200a}'|'\u{2028}'|'\u{2029}'|'\u{202f}'|'\u{205f}'|'\u{3000}'|'\u{feff}')))
+}
+
+fn eligible(scope: &str, title: Option<&str>, body: Option<&str>, latest: bool) -> bool {
+    (scope != "mem:memories" || latest) && has_content(title) && has_content(body)
+}
+
+pub fn value(scope: &str, value: Option<&Value>) -> bool {
+    let Some(value) = value else {
+        return false;
+    };
+    let body = if scope == "mem:memories" {
+        "content"
+    } else {
+        "narrative"
+    };
+    eligible(
+        scope,
+        value["title"].as_str(),
+        value[body].as_str(),
+        value.get("isLatest") != Some(&Value::Bool(false)),
+    )
+}
+
+pub fn register(connection: &Connection) -> anyhow::Result<()> {
+    connection.create_scalar_function(
+        "retrieval_source_eligible",
+        4,
+        FunctionFlags::SQLITE_UTF8
+            | FunctionFlags::SQLITE_DETERMINISTIC
+            | FunctionFlags::SQLITE_INNOCUOUS,
+        |context| {
+            Ok(eligible(
+                context.get_raw(0).as_str().unwrap_or(""),
+                context.get_raw(1).as_str().ok(),
+                context.get_raw(2).as_str().ok(),
+                context.get_raw(3).as_str().ok() != Some("false"),
+            ))
+        },
+    )?;
+    Ok(())
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/graph.rs b/engine/src/workers/state/adapters/sqlite/retrieval/graph.rs
new file mode 100644
index 0000000..533227c
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/graph.rs
@@ -0,0 +1,213 @@
+use super::{metadata, request};
+use rusqlite::{Connection, OptionalExtension, params};
+use serde_json::Value;
+use std::collections::BTreeSet;
+
+mod incremental;
+
+pub const NODES: &str = "mem:graph:nodes";
+pub const EDGES: &str = "mem:graph:edges";
+
+pub fn schema(connection: &Connection) -> anyhow::Result<()> {
+    connection.execute_batch("CREATE TABLE IF NOT EXISTS retrieval_graph_meta(scope TEXT PRIMARY KEY,status TEXT NOT NULL,cursor INTEGER NOT NULL,revision TEXT NOT NULL,epoch INTEGER NOT NULL) WITHOUT ROWID;
+        CREATE TABLE IF NOT EXISTS retrieval_nodes(epoch INTEGER NOT NULL,key TEXT NOT NULL,id TEXT NOT NULL,name TEXT NOT NULL,prefix TEXT NOT NULL,position INTEGER NOT NULL,PRIMARY KEY(epoch,key)) WITHOUT ROWID;
+        CREATE INDEX IF NOT EXISTS retrieval_nodes_name ON retrieval_nodes(epoch,name,position);
+        CREATE INDEX IF NOT EXISTS retrieval_nodes_prefix ON retrieval_nodes(epoch,prefix,position);
+        CREATE TABLE IF NOT EXISTS retrieval_name_grams(epoch INTEGER NOT NULL,gram TEXT NOT NULL,key TEXT NOT NULL,position INTEGER NOT NULL,PRIMARY KEY(epoch,gram,key)) WITHOUT ROWID;
+        CREATE INDEX IF NOT EXISTS retrieval_name_grams_key ON retrieval_name_grams(epoch,key);
+        CREATE TABLE IF NOT EXISTS retrieval_identifiers(id INTEGER PRIMARY KEY,epoch INTEGER NOT NULL,value TEXT NOT NULL,UNIQUE(epoch,id),UNIQUE(epoch,value));
+        CREATE TEMP TABLE IF NOT EXISTS retrieval_orphans(id INTEGER PRIMARY KEY);
+        CREATE TABLE IF NOT EXISTS retrieval_membership(epoch INTEGER NOT NULL,observation INTEGER NOT NULL,key INTEGER NOT NULL,position INTEGER NOT NULL,PRIMARY KEY(epoch,observation,key),FOREIGN KEY(epoch,observation) REFERENCES retrieval_identifiers(epoch,id) ON DELETE CASCADE,FOREIGN KEY(epoch,key) REFERENCES retrieval_identifiers(epoch,id) ON DELETE CASCADE) WITHOUT ROWID;
+        CREATE INDEX IF NOT EXISTS retrieval_membership_key ON retrieval_membership(epoch,key);
+        CREATE TABLE IF NOT EXISTS retrieval_edges(epoch INTEGER NOT NULL,key TEXT NOT NULL,source TEXT NOT NULL,target TEXT NOT NULL,position INTEGER NOT NULL,PRIMARY KEY(epoch,key)) WITHOUT ROWID;
+        CREATE INDEX IF NOT EXISTS retrieval_edges_source ON retrieval_edges(epoch,source,position);
+        CREATE INDEX IF NOT EXISTS retrieval_edges_target ON retrieval_edges(epoch,target,position);")?;
+    for scope in [NODES, EDGES] {
+        metadata::initialize_graph(connection, scope)?;
+    }
+    Ok(())
+}
+
+fn identifier_id(connection: &Connection, epoch: i64, value: &str) -> anyhow::Result<Option<i64>> {
+    Ok(connection
+        .query_row(
+            "SELECT id FROM retrieval_identifiers WHERE epoch=?1 AND value=?2",
+            params![epoch, value],
+            |row| row.get(0),
+        )
+        .optional()?)
+}
+
+fn ensure_identifier_id(connection: &Connection, epoch: i64, value: &str) -> anyhow::Result<i64> {
+    connection.execute(
+        "INSERT OR IGNORE INTO retrieval_identifiers(epoch,value) VALUES(?1,?2)",
+        params![epoch, value],
+    )?;
+    identifier_id(connection, epoch, value)?
+        .ok_or_else(|| super::super::protocol::error("STATE_TX_FAILED"))
+}
+
+fn remove_old_memberships(connection: &Connection, epoch: i64, key: &str) -> anyhow::Result<()> {
+    connection.execute("DELETE FROM retrieval_orphans", [])?;
+    if let Some(key_id) = identifier_id(connection, epoch, key)? {
+        connection.execute(
+            "INSERT OR IGNORE INTO retrieval_orphans(id) SELECT observation FROM retrieval_membership WHERE epoch=?1 AND key=?2",
+            params![epoch, key_id],
+        )?;
+        connection.execute(
+            "INSERT OR IGNORE INTO retrieval_orphans(id) VALUES(?1)",
+            [key_id],
+        )?;
+        connection.execute(
+            "DELETE FROM retrieval_membership INDEXED BY retrieval_membership_key WHERE epoch=?1 AND key=?2",
+            params![epoch, key_id],
+        )?;
+        connection.execute(
+            "DELETE FROM retrieval_identifiers AS i WHERE i.epoch=?1 AND i.id IN (SELECT id FROM retrieval_orphans) AND NOT EXISTS(SELECT 1 FROM retrieval_membership WHERE epoch=i.epoch AND observation=i.id) AND NOT EXISTS(SELECT 1 FROM retrieval_membership INDEXED BY retrieval_membership_key WHERE epoch=i.epoch AND key=i.id)",
+            params![epoch],
+        )?;
+    }
+    connection.execute("DELETE FROM retrieval_orphans", [])?;
+    Ok(())
+}
+
+pub fn grams(name: &str, width: usize) -> BTreeSet<String> {
+    let chars: Vec<char> = name.chars().collect();
+    if chars.len() < width {
+        return BTreeSet::new();
+    }
+    chars
+        .windows(width)
+        .map(|part| part.iter().collect())
+        .collect()
+}
+
+fn indexable(value: &Value, key: &str) -> anyhow::Result<bool> {
+    request::identifier(key)?;
+    super::super::protocol::require(value.is_object() && value["id"].as_str() == Some(key))?;
+    match value.get("stale") {
+        None | Some(Value::Bool(false)) => Ok(true),
+        Some(Value::Bool(true)) => Ok(false),
+        _ => Err(super::super::protocol::error("STATE_TX_INVALID_REQUEST")),
+    }
+}
+
+pub fn replace(
+    connection: &Connection,
+    scope: &str,
+    key: &str,
+    value: Option<&Value>,
+    position: Option<i64>,
+    epoch: i64,
+) -> anyhow::Result<()> {
+    if scope == NODES {
+        connection.execute(
+            "DELETE FROM retrieval_name_grams INDEXED BY retrieval_name_grams_key WHERE epoch=?1 AND key=?2",
+            params![epoch, key],
+        )?;
+        remove_old_memberships(connection, epoch, key)?;
+        connection.execute(
+            "DELETE FROM retrieval_nodes WHERE epoch=?1 AND key=?2",
+            params![epoch, key],
+        )?;
+        let Some(value) = value.filter(|_| position.is_some()) else {
+            return Ok(());
+        };
+        if !indexable(value, key)? {
+            return Ok(());
+        }
+        let name = value["name"]
+            .as_str()
+            .ok_or_else(|| super::super::protocol::error("STATE_TX_INVALID_REQUEST"))?;
+        if name.len() > 16 * 1024 {
+            return Err(request::resource());
+        }
+        let name = name.to_lowercase();
+        let prefix: String = name.chars().take(3).collect();
+        let members = value["sourceObservationIds"]
+            .as_array()
+            .ok_or_else(|| super::super::protocol::error("STATE_TX_INVALID_REQUEST"))?;
+        let compact = super::graph_browse::compact::node(value);
+        connection.execute(
+            "INSERT INTO retrieval_nodes(epoch,key,id,name,prefix,position,display_name,display_type) VALUES(?1,?2,?2,?3,?4,?5,?6,?7)",
+            params![epoch, key, name, prefix, position, compact.as_ref().map(|v|&v.0), compact.as_ref().map(|v|&v.1)],
+        )?;
+        let mut insert =
+            connection.prepare_cached("INSERT INTO retrieval_name_grams VALUES(?1,?2,?3,?4)")?;
+        for width in 1..=3 {
+            for gram in grams(&name, width) {
+                insert.execute(params![epoch, gram, key, position])?;
+            }
+        }
+        let mut bytes = 0usize;
+        for member in members {
+            let member = member
+                .as_str()
+                .ok_or_else(|| super::super::protocol::error("STATE_TX_INVALID_REQUEST"))?;
+            request::identifier(member)?;
+            bytes = bytes.saturating_add(member.len());
+            if bytes > 2 * 1024 * 1024 {
+                return Err(request::resource());
+            }
+        }
+        if !members.is_empty() {
+            let key_id = ensure_identifier_id(connection, epoch, key)?;
+            let members_json = serde_json::to_string(members)?;
+            connection.execute(
+                "INSERT OR IGNORE INTO retrieval_identifiers(epoch,value) SELECT ?1,value FROM json_each(?2) WHERE type='text'",
+                params![epoch, members_json],
+            )?;
+            connection.execute(
+                "INSERT OR IGNORE INTO retrieval_membership(epoch,observation,key,position) SELECT ?1,observation.id,?3,?4 FROM json_each(?2) source CROSS JOIN retrieval_identifiers observation ON observation.epoch=?1 AND observation.value=source.value WHERE source.type='text'",
+                params![epoch, members_json, key_id, position],
+            )?;
+        }
+    } else if scope == EDGES {
+        connection.execute(
+            "DELETE FROM retrieval_edges WHERE epoch=?1 AND key=?2",
+            params![epoch, key],
+        )?;
+        let Some(value) = value.filter(|_| position.is_some()) else {
+            return Ok(());
+        };
+        if !indexable(value, key)? {
+            return Ok(());
+        }
+        let source = value["sourceNodeId"]
+            .as_str()
+            .ok_or_else(|| super::super::protocol::error("STATE_TX_INVALID_REQUEST"))?;
+        let target = value["targetNodeId"]
+            .as_str()
+            .ok_or_else(|| super::super::protocol::error("STATE_TX_INVALID_REQUEST"))?;
+        request::identifier(source)?;
+        request::identifier(target)?;
+        let compact = super::graph_browse::compact::edge(value);
+        connection.execute(
+            "INSERT INTO retrieval_edges(epoch,key,source,target,position,display_type,display_weight) VALUES(?1,?2,?3,?4,?5,?6,?7)",
+            params![epoch, key, source, target, position, compact.as_ref().map(|v|&v.0), compact.as_ref().map(|v|v.1)],
+        )?;
+    }
+    Ok(())
+}
+
+pub fn replace_incremental(
+    connection: &Connection,
+    scope: &str,
+    key: &str,
+    previous: Option<&Value>,
+    previous_position: Option<i64>,
+    value: Option<&Value>,
+    position: Option<i64>,
+    epoch: i64,
+) -> anyhow::Result<()> {
+    incremental::replace(
+        connection,
+        scope,
+        key,
+        previous,
+        previous_position,
+        value,
+        position,
+        epoch,
+    )
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/graph/incremental.rs b/engine/src/workers/state/adapters/sqlite/retrieval/graph/incremental.rs
new file mode 100644
index 0000000..5259fba
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/graph/incremental.rs
@@ -0,0 +1,234 @@
+use rusqlite::{Connection, OptionalExtension, params};
+use serde_json::Value;
+use std::collections::{BTreeSet, HashSet};
+
+mod membership;
+
+const MAX_INCREMENTAL_GRAPH_INDEX_CHANGES: usize = 128;
+
+struct NodeIndex {
+    name: String,
+    prefix: String,
+    members: HashSet<String>,
+}
+
+struct EdgeIndex {
+    source: String,
+    target: String,
+}
+
+fn node_index(value: &Value, key: &str) -> anyhow::Result<Option<NodeIndex>> {
+    if !super::indexable(value, key)? {
+        return Ok(None);
+    }
+    let name = value["name"]
+        .as_str()
+        .ok_or_else(|| super::super::super::protocol::error("STATE_TX_INVALID_REQUEST"))?;
+    if name.len() > 16 * 1024 {
+        return Err(super::super::request::resource());
+    }
+    let mut members = HashSet::new();
+    let mut bytes = 0usize;
+    for member in value["sourceObservationIds"]
+        .as_array()
+        .ok_or_else(|| super::super::super::protocol::error("STATE_TX_INVALID_REQUEST"))?
+    {
+        let member = member
+            .as_str()
+            .ok_or_else(|| super::super::super::protocol::error("STATE_TX_INVALID_REQUEST"))?;
+        super::request::identifier(member)?;
+        bytes = bytes.saturating_add(member.len());
+        if bytes > 2 * 1024 * 1024 {
+            return Err(super::super::request::resource());
+        }
+        members.insert(member.to_owned());
+    }
+    let name = name.to_lowercase();
+    let prefix = name.chars().take(3).collect();
+    Ok(Some(NodeIndex {
+        name,
+        prefix,
+        members,
+    }))
+}
+
+fn edge_index(value: &Value, key: &str) -> anyhow::Result<Option<EdgeIndex>> {
+    if !super::indexable(value, key)? {
+        return Ok(None);
+    }
+    let source = value["sourceNodeId"]
+        .as_str()
+        .ok_or_else(|| super::super::super::protocol::error("STATE_TX_INVALID_REQUEST"))?;
+    let target = value["targetNodeId"]
+        .as_str()
+        .ok_or_else(|| super::super::super::protocol::error("STATE_TX_INVALID_REQUEST"))?;
+    super::request::identifier(source)?;
+    super::request::identifier(target)?;
+    Ok(Some(EdgeIndex {
+        source: source.to_owned(),
+        target: target.to_owned(),
+    }))
+}
+
+fn all_grams(name: &str) -> BTreeSet<String> {
+    (1..=3).flat_map(|width| super::grams(name, width)).collect()
+}
+
+fn replace_node(
+    connection: &Connection,
+    key: &str,
+    previous: Option<&Value>,
+    previous_position: Option<i64>,
+    value: Option<&Value>,
+    position: Option<i64>,
+    epoch: i64,
+) -> anyhow::Result<()> {
+    let (Some(previous), Some(previous_position), Some(value), Some(position)) =
+        (previous, previous_position, value, position)
+    else {
+        return super::replace(connection, super::NODES, key, value, position, epoch);
+    };
+    let previous = match node_index(previous, key) {
+        Ok(Some(previous)) => previous,
+        Ok(None) | Err(_) => {
+            // The existing writer can replace legacy rows that do not satisfy today's index schema.
+            return super::replace(connection, super::NODES, key, Some(value), Some(position), epoch);
+        }
+    };
+    let Some(next) = node_index(value, key)? else {
+        return super::replace(connection, super::NODES, key, Some(value), Some(position), epoch);
+    };
+
+    let indexed: Option<(String, String, String, i64)> = connection
+        .query_row(
+            "SELECT id,name,prefix,position FROM retrieval_nodes WHERE epoch=?1 AND key=?2",
+            params![epoch, key],
+            |row| Ok((row.get(0)?, row.get(1)?, row.get(2)?, row.get(3)?)),
+        )
+        .optional()?;
+    if !indexed.as_ref().is_some_and(|(id, name, prefix, indexed_position)| {
+        id == key
+            && name == &previous.name
+            && prefix == &previous.prefix
+            && *indexed_position == previous_position
+    }) {
+        return super::replace(connection, super::NODES, key, Some(value), Some(position), epoch);
+    }
+
+    let previous_grams = all_grams(&previous.name);
+    let next_grams = all_grams(&next.name);
+    let changed_rows = previous_grams
+        .symmetric_difference(&next_grams)
+        .count()
+        .saturating_add(previous.members.symmetric_difference(&next.members).count());
+    if changed_rows > MAX_INCREMENTAL_GRAPH_INDEX_CHANGES {
+        return super::replace(connection, super::NODES, key, Some(value), Some(position), epoch);
+    }
+    if !membership::apply_delta(connection, epoch, key, &previous.members, &next.members, position)? {
+        return super::replace(connection, super::NODES, key, Some(value), Some(position), epoch);
+    }
+    let mut delete_gram = connection.prepare_cached(
+        "DELETE FROM retrieval_name_grams WHERE epoch=?1 AND gram=?2 AND key=?3",
+    )?;
+    for gram in previous_grams.difference(&next_grams) {
+        delete_gram.execute(params![epoch, gram, key])?;
+    }
+    let mut insert_gram = connection.prepare_cached(
+        "INSERT OR IGNORE INTO retrieval_name_grams(epoch,gram,key,position) VALUES(?1,?2,?3,?4)",
+    )?;
+    for gram in next_grams.difference(&previous_grams) {
+        insert_gram.execute(params![epoch, gram, key, position])?;
+    }
+    if previous_position != position && !next_grams.is_empty() {
+        connection.execute(
+            "UPDATE retrieval_name_grams SET position=?3 WHERE epoch=?1 AND key=?2 AND position<>?3",
+            params![epoch, key, position],
+        )?;
+    }
+    if previous.name != next.name || previous.prefix != next.prefix || previous_position != position {
+        connection.execute(
+            "UPDATE retrieval_nodes SET name=?3,prefix=?4,position=?5 WHERE epoch=?1 AND key=?2",
+            params![epoch, key, next.name, next.prefix, position],
+        )?;
+    }
+    let compact = super::super::graph_browse::compact::node(value);
+    connection.execute("UPDATE retrieval_nodes SET display_name=?3,display_type=?4 WHERE epoch=?1 AND key=?2",params![epoch,key,compact.as_ref().map(|v|&v.0),compact.as_ref().map(|v|&v.1)])?;
+    if previous_position != position && !next.members.is_empty() {
+        let key_id = super::identifier_id(connection, epoch, key)?
+            .ok_or_else(|| super::super::super::protocol::error("STATE_TX_FAILED"))?;
+        connection.execute(
+            "UPDATE retrieval_membership INDEXED BY retrieval_membership_key SET position=?3 WHERE epoch=?1 AND key=?2 AND position<>?3",
+            params![epoch, key_id, position],
+        )?;
+    }
+    Ok(())
+}
+
+fn replace_edge(
+    connection: &Connection,
+    key: &str,
+    previous: Option<&Value>,
+    previous_position: Option<i64>,
+    value: Option<&Value>,
+    position: Option<i64>,
+    epoch: i64,
+) -> anyhow::Result<()> {
+    let (Some(previous), Some(previous_position), Some(value), Some(position)) =
+        (previous, previous_position, value, position)
+    else {
+        return super::replace(connection, super::EDGES, key, value, position, epoch);
+    };
+    let previous = match edge_index(previous, key) {
+        Ok(Some(previous)) => previous,
+        Ok(None) | Err(_) => {
+            return super::replace(connection, super::EDGES, key, Some(value), Some(position), epoch);
+        }
+    };
+    let Some(next) = edge_index(value, key)? else {
+        return super::replace(connection, super::EDGES, key, Some(value), Some(position), epoch);
+    };
+    let indexed: Option<(String, String, String, i64)> = connection
+        .query_row(
+            "SELECT key,source,target,position FROM retrieval_edges WHERE epoch=?1 AND key=?2",
+            params![epoch, key],
+            |row| Ok((row.get(0)?, row.get(1)?, row.get(2)?, row.get(3)?)),
+        )
+        .optional()?;
+    if !indexed.as_ref().is_some_and(|(id, source, target, indexed_position)| {
+        id == key
+            && source == &previous.source
+            && target == &previous.target
+            && *indexed_position == previous_position
+    }) {
+        return super::replace(connection, super::EDGES, key, Some(value), Some(position), epoch);
+    }
+    if previous.source != next.source || previous.target != next.target || previous_position != position {
+        connection.execute(
+            "UPDATE retrieval_edges SET source=?3,target=?4,position=?5 WHERE epoch=?1 AND key=?2",
+            params![epoch, key, next.source, next.target, position],
+        )?;
+    }
+    let compact = super::super::graph_browse::compact::edge(value);
+    connection.execute("UPDATE retrieval_edges SET display_type=?3,display_weight=?4 WHERE epoch=?1 AND key=?2",params![epoch,key,compact.as_ref().map(|v|&v.0),compact.as_ref().map(|v|v.1)])?;
+    Ok(())
+}
+
+pub(super) fn replace(
+    connection: &Connection,
+    scope: &str,
+    key: &str,
+    previous: Option<&Value>,
+    previous_position: Option<i64>,
+    value: Option<&Value>,
+    position: Option<i64>,
+    epoch: i64,
+) -> anyhow::Result<()> {
+    if previous.is_some() && previous == value && previous_position == position {
+        return Ok(());
+    }
+    match scope {
+        super::NODES => replace_node(connection, key, previous, previous_position, value, position, epoch),
+        super::EDGES => replace_edge(connection, key, previous, previous_position, value, position, epoch),
+        _ => super::replace(connection, scope, key, value, position, epoch),
+    }
+}
