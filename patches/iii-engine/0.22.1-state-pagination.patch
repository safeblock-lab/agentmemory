+use super::{observation, provider_attempt_budget, protocol::{error, require}, storage_diagnostics, storage_graph_metadata, storage_operations, storage_prune, storage_reclaim, storage_maintenance_lease};
+use rusqlite::Connection;
+use serde::Deserialize;
+use serde_json::Value;
+use std::{path::Path, time::{Duration, Instant}};
+
+#[derive(Deserialize)]
+#[serde(tag = "action", rename_all = "snake_case", deny_unknown_fields)]
+pub enum Request {
+    GraphAutomaticRecovery { request: super::graph_automatic_recovery::Request },
+    ProviderBudgetClaim { operation_id: String, window_id: String, expected_ceiling: u32, claim_id: String,
+        #[serde(default, deserialize_with = "provider_attempt_budget::optional_context")] context: Option<provider_attempt_budget::BindingContext> },
+    ProviderBudgetConsume { operation_id: String, window_id: String, claim_id: String, attempt_id: String, endpoint: String },
+    ProviderBudgetFinish { operation_id: String, window_id: String, claim_id: String, outcome: String },
+    ProviderBudgetStatus { operation_id: String },
+    Physical,
+    BlobMeasure { after_blob: i64, limit: usize },
+    TtlPage { request: super::storage_ttl::Request },
+    TtlRecordContextUse { request: super::storage_ttl::ContextUse },
+    RetentionContextDelivery {
+        event_id: String, task_id: String, project: String,
+        resources: Vec<super::retention_use::Resource>,
+    },
+    CompactStatus,
+    CompactCheckpointReceipt { request: super::compact::Request },
+    CompactCheckpointRecover { request: super::compact::checkpoint_recovery::Request },
+    RepackStatus,
+    RepackProof,
+    RepackReceipt { request: super::storage_repack::Request },
+    RepackApply { request: super::storage_repack::Request },
+    RootLayoutStatus,
+    RootLayoutApply { request: super::text_layout::Request },
+    RootLayoutReceipt { request: super::text_layout::Request },
+    TextLayoutStatus,
+    TextLayoutApply { request: super::text_layout::Request },
+    TextLayoutReceipt { request: super::text_layout::Request },
+    SearchPackedStatus,
+    SearchPackedReceipt { request: super::search_packed::Request },
+    SearchPackedApply { request: super::search_packed::Request },
+    ForwardRepackStatus,
+    ForwardRepackProof,
+    ForwardRepackReceipt { request: super::storage_forward_repack::Request },
+    ForwardRepackApply { request: super::storage_forward_repack::Request },
+    MembershipRepackStatus,
+    MembershipRepackProof,
+    MembershipRepackReceipt { request: super::storage_membership_repack::Request },
+    MembershipRepackApply { request: super::storage_membership_repack::Request },
+    LexicalRepackStatus,
+    LexicalRepackProof,
+    LexicalRepackProofPage { request: super::storage_lexical_repack::proof::PageRequest },
+    LexicalRepackReceipt { request: super::storage_repack::Request },
+    LexicalRepackApply { request: super::storage_repack::Request },
+    CompactReceipt { request: super::compact::Request },
+    CompactApply { request: super::compact::Request },
+    MigrateIncremental { allow_blocking: bool, max_ms: u64 },
+    Diagnostics { cursor: Option<storage_diagnostics::Cursor>, limit: usize, max_bytes: u64, max_ms: u64 },
+    GraphMetadata,
+    GraphMetadataPrepare { limit: usize, max_bytes: u64, max_ms: u64 },
+    PruneTechnical { candidates: Vec<storage_prune::Candidate>, max_bytes: u64, max_ms: u64 },
+    PruneOperations { expected_version: String, max_ms: u64 },
+    MaintenanceLeaseAcquire { owner_id: String, lease_ms: u64 },
+    MaintenanceLeaseRefresh { owner_id: String, fence: u64, lease_ms: u64 },
+    MaintenanceLeaseRelease { owner_id: String, fence: u64 },
+    MaintenanceStateSave { owner_id: String, fence: u64, value: Value, release: bool },
+    Reclaim { #[serde(default)] maintenance: bool, #[serde(default = "default_pages")] max_pages: u32, #[serde(default = "default_ms")] max_ms: u64, #[serde(default = "default_checkpoint")] checkpoint: String, lease_owner_id: String, lease_fence: u64 },
+    ObservationIndex { session_id: String, observation_id: String, identity_digest: String, canonical_identity: String, expected_version: String },
+}
+fn default_pages() -> u32 { 1 }
+fn default_ms() -> u64 { 25 }
+fn default_checkpoint() -> String { "passive".into() }
+impl Request {
+    pub fn provider_budget(&self) -> bool { matches!(self, Self::ProviderBudgetClaim { .. } | Self::ProviderBudgetConsume { .. } | Self::ProviderBudgetFinish { .. } | Self::ProviderBudgetStatus { .. }) }
+    pub fn into_provider_budget(self) -> anyhow::Result<provider_attempt_budget::Request> {
+        use provider_attempt_budget::{Identity, Request as Budget};
+        Ok(match self {
+            Self::ProviderBudgetClaim {operation_id,window_id,expected_ceiling,claim_id,context} => Budget::Claim {identity:Identity {operation_id,window_id,claim_id},expected_ceiling,context},
+            Self::ProviderBudgetConsume {operation_id,window_id,claim_id,attempt_id,endpoint} => Budget::Consume {identity:Identity {operation_id,window_id,claim_id},attempt_id,endpoint},
+            Self::ProviderBudgetFinish {operation_id,window_id,claim_id,outcome} => Budget::Finish {identity:Identity {operation_id,window_id,claim_id},outcome},
+            Self::ProviderBudgetStatus {operation_id} => Budget::Status {operation_id},
+            _ => return Err(error("STATE_PROVIDER_BUDGET_INVALID_REQUEST")),
+        })
+    }
+    pub fn maintenance_lease(&self) -> bool { matches!(self, Self::MaintenanceLeaseAcquire { .. } | Self::MaintenanceLeaseRefresh { .. } | Self::MaintenanceLeaseRelease { .. } | Self::MaintenanceStateSave { .. }) }
+    pub fn read_only(&self) -> bool { matches!(self, Self::Diagnostics { .. } | Self::GraphMetadata | Self::Physical | Self::CompactCheckpointReceipt {..} | Self::CompactStatus | Self::CompactReceipt { .. } | Self::BlobMeasure { .. } | Self::RepackStatus | Self::RepackProof | Self::RepackReceipt { .. } | Self::RootLayoutStatus | Self::RootLayoutReceipt {..} | Self::TextLayoutStatus | Self::TextLayoutReceipt {..} | Self::SearchPackedReceipt {..} | Self::SearchPackedStatus | Self::ForwardRepackStatus | Self::ForwardRepackProof | Self::ForwardRepackReceipt { .. } | Self::MembershipRepackStatus | Self::MembershipRepackProof | Self::MembershipRepackReceipt { .. } | Self::LexicalRepackStatus | Self::LexicalRepackProof | Self::LexicalRepackProofPage { .. } | Self::LexicalRepackReceipt { .. }) }
+    pub fn reclamation(&self) -> bool { matches!(self, Self::Reclaim { .. } | Self::MigrateIncremental { .. }) }
+}
+pub fn bounded<T>(connection: &Connection, max_ms: u64, job: impl FnOnce() -> anyhow::Result<T>) -> anyhow::Result<T> {
+    require((1..=3000).contains(&max_ms))?;
+    let started = Instant::now();
+    let duration = Duration::from_millis(max_ms);
+    connection.progress_handler(1000, Some(move || started.elapsed() >= duration))?;
+    let result = job();
+    connection.progress_handler(0, None::<fn() -> bool>)?;
+    if started.elapsed() >= duration || result.as_ref().err().is_some_and(|cause| {
+        cause.downcast_ref::<rusqlite::Error>().is_some_and(|cause| matches!(cause,
+            rusqlite::Error::SqliteFailure(code, _) if code.code == rusqlite::ErrorCode::OperationInterrupted))
+    }) { return Err(error("STATE_TX_LIMIT_EXCEEDED")); }
+    result
+}
+pub fn execute(connection: &Connection, path: &Path, request: Request) -> anyhow::Result<Value> {
+    match request {
+        Request::RootLayoutStatus => super::root_layout::status(connection),
+        Request::RootLayoutReceipt {request} => super::root_layout::receipt(connection,&request),
+        Request::RootLayoutApply {request} => bounded(connection,request.max_ms,||super::root_layout::execute(connection,request)),
+        Request::TextLayoutStatus => super::text_layout::status(connection),
+        Request::TextLayoutReceipt {request} => super::text_layout::receipt(connection,&request),
+        Request::TextLayoutApply {request} => bounded(connection,request.max_ms,||super::text_layout::execute(connection,request)),
+        Request::SearchPackedReceipt {request} => super::search_packed::receipt(connection,&request),
+        Request::SearchPackedStatus => super::search_packed::status(connection),
+        Request::SearchPackedApply {..} => Err(error("STATE_TX_INVALID_REQUEST")),
+        Request::ForwardRepackStatus => super::storage_forward_repack::status(connection),
+        Request::ForwardRepackProof => super::storage_forward_repack::proof(connection),
+        Request::ForwardRepackReceipt {request} => super::storage_forward_repack::receipt(connection,&request),
+        Request::ForwardRepackApply {..} => Err(error("STATE_TX_INVALID_REQUEST")),
+        Request::MembershipRepackStatus => super::storage_membership_repack::status(connection),
+        Request::MembershipRepackProof => super::storage_membership_repack::proof(connection),
+        Request::MembershipRepackReceipt {request} => super::storage_membership_repack::receipt(connection,&request),
+        Request::MembershipRepackApply {..} => Err(error("STATE_TX_INVALID_REQUEST")),
+        Request::LexicalRepackStatus => super::storage_lexical_repack::status(connection),
+        Request::LexicalRepackProof => bounded(connection,3000,||super::storage_lexical_repack::proof(connection)),
+        Request::LexicalRepackReceipt {request} => super::storage_lexical_repack::receipt(connection,&request),
+        Request::LexicalRepackProofPage {..} => Err(error("STATE_TX_INVALID_REQUEST")),
+        Request::LexicalRepackApply {..} => Err(error("STATE_TX_INVALID_REQUEST")),
+        Request::RepackStatus => super::storage_repack::status(connection),
+        Request::RepackProof => bounded(connection,1000,||super::storage_repack::proof(connection)),
+        Request::RepackReceipt {request} => super::storage_repack::receipt(connection,&request),
+        Request::RepackApply {..} => Err(error("STATE_TX_INVALID_REQUEST")),
+        Request::CompactCheckpointReceipt {request} => super::compact::checkpoint::receipt(connection,&request),
+        Request::CompactCheckpointRecover {..} => Err(error("STATE_TX_INVALID_REQUEST")),
+        Request::CompactStatus => super::compact::status(connection),
+        Request::BlobMeasure {after_blob,limit} => bounded(connection,3000,||super::storage_blob_measure::page(connection,after_blob,limit)),
+        Request::CompactReceipt {request} => super::compact::receipt(connection,request),
+        Request::CompactApply {request} => bounded(connection,request.max_ms,||super::compact::execute(connection,request)),
+        Request::GraphAutomaticRecovery {..} => Err(error("STATE_GRAPH_AUTOMATIC_TRANSACTION_INVALID")),
+        Request::ProviderBudgetClaim {..} | Request::ProviderBudgetConsume {..} | Request::ProviderBudgetFinish {..} | Request::ProviderBudgetStatus {..} => Err(error("STATE_PROVIDER_BUDGET_TRANSACTION_INVALID")),
+        Request::MaintenanceLeaseAcquire {owner_id, lease_ms} => storage_maintenance_lease::acquire(connection, &owner_id, lease_ms),
+        Request::MaintenanceLeaseRefresh {owner_id, fence, lease_ms} => storage_maintenance_lease::refresh(connection, &owner_id, fence, lease_ms),
+        Request::MaintenanceLeaseRelease {owner_id, fence} => storage_maintenance_lease::release(connection, &owner_id, fence),
+        Request::MaintenanceStateSave {owner_id, fence, value, release} => storage_maintenance_lease::save_state(connection, &owner_id, fence, value, release),
+        Request::Diagnostics {cursor, limit, max_bytes, max_ms} => bounded(connection, max_ms, || storage_diagnostics::page(connection, path, cursor, limit, max_bytes)),
+        Request::GraphMetadata => bounded(connection, 1000, || storage_graph_metadata::read(connection)),
+        Request::GraphMetadataPrepare {limit, max_bytes, max_ms} => bounded(connection, max_ms, || storage_graph_metadata::prepare(connection, limit, max_bytes)),
+        Request::PruneTechnical {candidates, max_bytes, max_ms} => bounded(connection, max_ms, || storage_prune::prune(connection, candidates, max_bytes)),
+        Request::PruneOperations {expected_version, max_ms} => bounded(connection, max_ms, || storage_operations::prune(connection, &expected_version)),
+        Request::ObservationIndex {session_id,observation_id,identity_digest,canonical_identity,expected_version} => bounded(connection, 3000, || observation::index(connection, observation::Index {session_id,observation_id,identity_digest,canonical_identity,expected_version})),
+        Request::Physical => storage_reclaim::physical(connection, path),
+        Request::TtlPage {request} => bounded(connection, 3000, || super::storage_ttl::page(connection,request)),
+        Request::TtlRecordContextUse {request} => bounded(connection, 3000, || super::storage_ttl::record_use(connection,request)),
+        Request::RetentionContextDelivery {event_id,task_id,project,resources} => bounded(connection,3000,||
+            super::retention_use::admit(connection,super::retention_use::Request {event_id,task_id,project,resources})),
+        Request::MigrateIncremental {allow_blocking, max_ms} => storage_reclaim::migrate(connection, path, allow_blocking, max_ms),
+        Request::Reclaim {..} => Err(error("STATE_TX_INVALID_REQUEST")),
+    }
+}
+
+pub(super) fn snapshot_request(input: &Value) -> anyhow::Result<Option<super::snapshot_read_view::Request>> {
+    if input.get("action").and_then(Value::as_str).is_some_and(|action| action.starts_with("snapshot_")) {
+        return Ok(Some(super::protocol::decode(input.clone())?));
+    }
+    Ok(None)
+}
