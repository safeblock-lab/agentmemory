+++ b/engine/src/workers/state/adapters/sqlite/retrieval/graph_read/browse.rs
@@ -0,0 +1,100 @@
+use super::super::{graph_browse, protocol};
+use rusqlite::{Connection, params};
+use serde::{Deserialize, Serialize};
+use serde_json::{Value, json};
+
+#[derive(Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+struct Cursor {
+    version: u8,
+    project: String,
+    revision: String,
+    key: String,
+}
+
+fn page(project: &str, revision: Option<&str>, status: &str, reason: Option<&str>) -> Value {
+    json!({"status":status,"project":project,"items":[],"edges":[],"has_more":false,"next_cursor":null,
+        "revision":revision,"edgeScope":"page","crossPageEdges":"not_loaded","edgesTruncated":false,"reason":reason})
+}
+
+fn parse_cursor(project: &str, cursor: Option<&str>) -> anyhow::Result<Option<Cursor>> {
+    cursor.map(|raw| {
+        protocol::require(!raw.is_empty() && raw.len() <= 4096)?;
+        let value: Cursor = serde_json::from_str(raw).map_err(|_|protocol::error("STATE_TX_INVALID_REQUEST"))?;
+        protocol::require(value.version == 1 && value.project == project && !value.key.is_empty() && value.key.len() <= 4096 && !value.revision.is_empty() && value.revision.len() <= 64)?;
+        Ok(value)
+    }).transpose()
+}
+
+pub(super) fn execute(c: &Connection, project: &str, cursor: Option<&str>, limit: usize, max_bytes: usize) -> anyhow::Result<Value> {
+    protocol::require((1..=128).contains(&limit) && (1024..=65_536).contains(&max_bytes))?;
+    let cursor = parse_cursor(project,cursor)?;
+    super::super::super::commit::read_allowed(c,super::common::NODES,"",None)?;
+    super::super::super::commit::read_allowed(c,super::common::EDGES,"",None)?;
+    let Some(saved) = graph_browse::project(c,project)? else {
+        return Ok(page(project,None,"preparing",Some("graph_projection_not_prepared")));
+    };
+    let revision = graph_browse::revision(&saved);
+    if cursor.as_ref().is_some_and(|v|v.revision != revision) {
+        return Ok(page(project,Some(&revision),"preparing",Some("stale_graph_revision")));
+    }
+    if saved.status == "error" {
+        return Ok(page(project,Some(&revision),"error",saved.last_error.as_deref()));
+    }
+    let epochs = graph_browse::epochs(c)?;
+    if saved.status != "ready" || saved.input_epochs != epochs {
+        let mut result = page(project,Some(&revision),"preparing",Some("graph_projection_pending"));
+        result["progress"] = json!({"phase":if saved.status=="ready" {"dirty"} else {&saved.phase},"processed":saved.progress});
+        return Ok(result);
+    }
+    let epochs = epochs.unwrap();
+    let after = cursor.as_ref().map_or("",|v|v.key.as_str());
+    let mut statement = c.prepare_cached("SELECT b.key,n.id,n.display_type,n.display_name FROM browse_nodes b LEFT JOIN retrieval_nodes n ON n.epoch=?3 AND n.key=b.key WHERE b.project=?1 AND b.generation=?2 AND b.key>?4 ORDER BY b.key LIMIT ?5")?;
+    let rows = statement.query_map(params![project,saved.generation,epochs.nodes,after,(limit+1) as i64],|r|Ok((r.get::<_,String>(0)?,r.get::<_,Option<String>>(1)?,r.get::<_,Option<String>>(2)?,r.get::<_,Option<String>>(3)?)))?.collect::<rusqlite::Result<Vec<_>>>()?;
+    let mut result = page(project,Some(&revision),"ready",None);
+    let mut keys = Vec::new();
+    for (index,(key,id,kind,name)) in rows.iter().take(limit).enumerate() {
+        let (Some(id),Some(kind),Some(name)) = (id,kind,name) else { return Err(protocol::error("STATE_INDEX_RECORD_INVALID")) };
+        protocol::require(id == key && !kind.is_empty() && kind.len() <= 64 && name.chars().count() <= 256)?;
+        let next = if index+1 < rows.len() { Some(serde_json::to_string(&Cursor {version:1,project:project.to_owned(),revision:revision.clone(),key:key.clone()})?) } else { None };
+        if next.as_ref().is_some_and(|v|v.len()>4096) { return Err(protocol::error("STATE_GRAPH_DISPLAY_ROW_TOO_LARGE")); }
+        let previous_cursor = result["next_cursor"].clone();
+        let previous_more = result["has_more"].clone();
+        result["items"].as_array_mut().unwrap().push(json!({"id":id,"type":kind,"name":name}));
+        result["next_cursor"] = json!(next);
+        result["has_more"] = json!(next.is_some());
+        if protocol::size(&result)? > max_bytes {
+            result["items"].as_array_mut().unwrap().pop();
+            result["next_cursor"] = previous_cursor;
+            result["has_more"] = previous_more;
+            if keys.is_empty() { return Err(protocol::error("STATE_GRAPH_DISPLAY_ROW_TOO_LARGE")); }
+            break;
+        }
+        keys.push(key.clone());
+    }
+    let mut retrieved = 0;
+    'pairs: for source in &keys {
+        for target in &keys {
+            let mut statement = c.prepare_cached("SELECT key,display_type,display_weight FROM retrieval_edges INDEXED BY retrieval_edges_pair WHERE epoch=?1 AND source=?2 AND target=?3 ORDER BY key LIMIT ?4")?;
+            let mut rows = statement.query(params![epochs.edges,source,target,(257-retrieved) as i64])?;
+            while let Some(row) = rows.next()? {
+                retrieved += 1;
+                if retrieved > 256 { result["edgesTruncated"] = json!(true); break 'pairs; }
+                let key: String = row.get(0)?;
+                let kind: Option<String> = row.get(1)?;
+                let weight: Option<f64> = row.get(2)?;
+                let (Some(kind),Some(weight)) = (kind,weight) else { return Err(protocol::error("STATE_INDEX_RECORD_INVALID")) };
+                protocol::require(!kind.is_empty() && kind.len() <= 64 && weight.is_finite())?;
+                result["edges"].as_array_mut().unwrap().push(json!({"id":key,"type":kind,"sourceNodeId":source,"targetNodeId":target,"weight":weight}));
+                if protocol::size(&result)? > max_bytes {
+                    result["edges"].as_array_mut().unwrap().pop();
+                    result["edgesTruncated"] = json!(true);
+                    break 'pairs;
+                }
+            }
+        }
+    }
+    if protocol::size(&result)? > max_bytes { return Err(protocol::error("STATE_GRAPH_DISPLAY_ROW_TOO_LARGE")); }
+    Ok(result)
+}
+
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/graph_read/common.rs b/engine/src/workers/state/adapters/sqlite/retrieval/graph_read/common.rs
new file mode 100644
index 0000000..4882e20
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/graph_read/common.rs
@@ -0,0 +1,327 @@
+use super::super::{database, metadata, protocol};
+use rusqlite::{params, Connection, OptionalExtension};
+use serde_json::{json, Value};
+
+pub(super) const NODES: &str = "mem:graph:nodes";
+pub(super) const EDGES: &str = "mem:graph:edges";
+pub(super) const HISTORY: &str = "mem:graph:edge-history";
+pub(super) const VECTOR_INDEX: &str = "observations";
+pub(super) const MAX_ROWS: usize = 16;
+pub(super) const MAX_BYTES: usize = 65_536;
+
+pub(super) struct Context {
+    pub node_epoch: i64,
+    pub edge_epoch: i64,
+    pub vector_epoch: i64,
+    pub node_revision: String,
+    pub edge_revision: String,
+    pub vector_revision: String,
+    pub authority_incomplete: bool,
+    pub summary_authority_ready: bool,
+    pub projection_incomplete: bool,
+}
+
+pub(super) enum RowLoad {
+    Value(Value),
+    Missing,
+    Oversized,
+    Stale,
+    Invalid,
+}
+
+pub(super) fn context(connection: &Connection, project: &str) -> anyhow::Result<Option<Context>> {
+    let nodes = metadata::graph(connection, NODES)?;
+    let edges = metadata::graph(connection, EDGES)?;
+    if nodes.status != "ready"
+        || nodes.revision != database::revision(connection, NODES)?.to_string()
+        || edges.status != "ready"
+        || edges.revision != database::revision(connection, EDGES)?.to_string()
+    {
+        return Ok(None);
+    }
+    let Ok(vector_meta) = super::super::semantic::get(connection, VECTOR_INDEX) else {
+        return Ok(None);
+    };
+    if vector_meta.status != "ready"
+        || vector_meta.revision != database::revision(connection, &vector_meta.scope())?.to_string()
+    {
+        return Ok(None);
+    }
+    let projection_ready =
+        super::super::scoped::ready(connection, VECTOR_INDEX, vector_meta.epoch, project, true)?;
+    if !projection_ready
+        && !progressive_subset_ready(connection, VECTOR_INDEX, vector_meta.epoch, project)?
+    {
+        return Ok(None);
+    }
+    let summary_authority_ready =
+        super::super::project_catalog::summary_authority_ready(connection)?;
+    Ok(Some(Context {
+        node_epoch: nodes.epoch,
+        edge_epoch: edges.epoch,
+        vector_epoch: vector_meta.epoch,
+        node_revision: nodes.revision,
+        edge_revision: edges.revision,
+        vector_revision: vector_meta.revision,
+        authority_incomplete: !summary_authority_ready
+            || super::super::project_catalog::has_incomplete_session_authority(connection)?,
+        summary_authority_ready,
+        projection_incomplete: !projection_ready,
+    }))
+}
+
+fn progressive_subset_ready(
+    connection: &Connection,
+    index: &str,
+    epoch: i64,
+    project: &str,
+) -> anyhow::Result<bool> {
+    if super::super::project_catalog::has_incomplete_session_authority(connection)? {
+        return Ok(false);
+    }
+    let Some(project_token) = super::super::scoped::project_token(connection, project)? else {
+        return Ok(false);
+    };
+    let generation = super::super::scoped::generation(connection, project_token)?;
+    connection
+        .query_row(
+            "SELECT EXISTS(SELECT 1 FROM retrieval_scoped_coverage c JOIN retrieval_project_catalog sessions ON sessions.source='sessions' JOIN retrieval_project_catalog summaries ON summaries.source='summaries' WHERE c.index_id=?1 AND c.epoch=?2 AND c.project=?3 AND c.kind=0 AND c.generation=?4 AND c.source IN (0,1,2) AND c.status IN ('pending','partial','ready') AND c.sessions_epoch=sessions.epoch AND c.summaries_epoch=summaries.epoch)",
+            params![index, epoch, project_token, generation],
+            |row| row.get(0),
+        )
+        .map_err(Into::into)
+}
+
+pub(super) fn partial(reason: &str, project: &str, context: Option<&Context>) -> Value {
+    let revision = context.map_or_else(|| json!({}), |ctx| json!({"nodes":ctx.node_revision,"edges":ctx.edge_revision,"vectors":ctx.vector_revision}));
+    let result = json!({"status":"partial","reason":reason,"project":project,"items":[],"has_more":false,"next_cursor":null,"revision":revision});
+    if let Some(context) = context {
+        with_projection_status(result, context)
+    } else {
+        result
+    }
+}
+
+pub(super) fn node_project_predicate(node_expr: &str, summary_fallback: bool) -> String {
+    let mapping = observation_project_predicate("pv");
+    let currentness = observation_source_currentness("pv", "scoped_session");
+    let authority = observation_session_authority("scoped_session.name", summary_fallback);
+    format!(
+        "EXISTS(SELECT 1 FROM retrieval_identifiers nid CROSS JOIN retrieval_membership m ON m.epoch=nid.epoch AND m.key=nid.id CROSS JOIN retrieval_identifiers obs ON obs.epoch=m.epoch AND obs.id=m.observation CROSS JOIN retrieval_scoped_vectors pv ON pv.id=obs.value AND {mapping} CROSS JOIN retrieval_scoped_sessions scoped_session ON scoped_session.token=pv.session WHERE nid.epoch=?1 AND nid.value={node_expr} AND {currentness} AND {authority})"
+    )
+}
+
+pub(super) fn observation_project_predicate(alias: &str) -> String {
+    format!(
+        "{alias}.index_id='observations' AND {alias}.epoch=?2 AND {alias}.kind=0 AND {alias}.project=(SELECT token FROM retrieval_scoped_projects WHERE name=?3) AND {alias}.project_generation=1"
+    )
+}
+
+pub(super) fn observation_posting_predicate(alias: &str) -> String {
+    format!(
+        "{alias}.index_id='observations' AND {alias}.epoch=?2 AND {alias}.kind=0 AND {alias}.project=(SELECT token FROM retrieval_scoped_projects WHERE name=?3) AND {alias}.project_generation=1"
+    )
+}
+
+pub(super) fn observation_session_authority(session_expr: &str, summary_fallback: bool) -> String {
+    if summary_fallback {
+        super::super::project_catalog::session_project_predicate(session_expr, "?3")
+    } else {
+        format!(
+            "EXISTS(SELECT 1 FROM retrieval_project_refs r INDEXED BY retrieval_project_refs_session WHERE r.source='sessions' AND r.epoch=(SELECT epoch FROM retrieval_project_catalog WHERE source='sessions') AND r.session_id={session_expr} AND r.project=?3)"
+        )
+    }
+}
+
+pub(super) fn observation_source_currentness(vector: &str, session: &str) -> String {
+    format!(
+        "{vector}.generation={session}.generation AND EXISTS(SELECT 1 FROM retrieval_source_items si JOIN state_rows source_row ON source_row.scope=si.scope AND source_row.key=si.key AND source_row.version=si.version AND source_row.value IS NOT NULL WHERE si.index_id={vector}.index_id AND si.scope='mem:obs:'||{session}.name AND si.key={vector}.id AND si.dirty=0)"
+    )
+}
+
+pub(super) fn selector_hash(selector: &Value) -> anyhow::Result<String> {
+    use sha2::{Digest, Sha256};
+    Ok(format!(
+        "{:x}",
+        Sha256::digest(serde_json::to_vec(selector)?)
+    ))
+}
+
+fn cursor_text(hash: &str, context: &Context, position: i64) -> String {
+    format!(
+        "v1:{hash}:{}:{}:{}:{}",
+        context.node_revision, context.edge_revision, context.vector_revision, position
+    )
+}
+
+pub(super) fn cursor_position(
+    cursor: Option<&str>,
+    hash: &str,
+    context: &Context,
+) -> anyhow::Result<i64> {
+    reject_partial_projection_cursor(cursor, context)?;
+    let Some(cursor) = cursor else {
+        return Ok(-1);
+    };
+    let parts = cursor.split(':').collect::<Vec<_>>();
+    protocol::require(
+        parts.len() == 6
+            && parts[0] == "v1"
+            && parts[1] == hash
+            && parts[2] == context.node_revision
+            && parts[3] == context.edge_revision
+            && parts[4] == context.vector_revision,
+    )?;
+    protocol::counter(parts[5]).map(|value| i64::try_from(value).unwrap_or(i64::MAX))
+}
+
+pub(super) fn reject_partial_projection_cursor(
+    cursor: Option<&str>,
+    context: &Context,
+) -> anyhow::Result<()> {
+    protocol::require(!context.projection_incomplete || cursor.is_none())
+}
+
+pub(super) fn next_cursor(hash: &str, context: &Context, position: i64) -> String {
+    cursor_text(hash, context, position)
+}
+
+pub(super) fn load_row(
+    connection: &Connection,
+    scope: &str,
+    key: &str,
+    max_bytes: usize,
+) -> anyhow::Result<RowLoad> {
+    let meta:Option<(String,i64,i64)>=connection.query_row(
+        "SELECT version,value_bytes,CASE typeof(value) WHEN 'blob' THEN length(value) WHEN 'text' THEN length(value)*4 ELSE 0 END FROM state_rows WHERE scope=?1 AND key=?2 AND value IS NOT NULL",
+        params![scope,key],|row|Ok((row.get(0)?,row.get(1)?,row.get(2)?))).optional()?;
+    let Some((version, logical, stored)) = meta else {
+        return Ok(RowLoad::Missing);
+    };
+    if logical <= 0 || stored <= 0 || logical as usize > max_bytes || stored as usize > max_bytes {
+        return Ok(RowLoad::Oversized);
+    }
+    let encoded:Option<Vec<u8>>=connection.query_row(
+        "SELECT value FROM state_rows WHERE scope=?1 AND key=?2 AND version=?3 AND value IS NOT NULL AND value_bytes=?4 AND CASE typeof(value) WHEN 'blob' THEN length(value) WHEN 'text' THEN length(value)*4 ELSE 0 END=?5",
+        params![scope,key,version,logical,stored],|row|Ok(row.get_ref(0)?.as_bytes()?.to_vec())).optional()?;
+    let Some(encoded) = encoded else {
+        return Ok(RowLoad::Stale);
+    };
+    let raw = database::decode_value(&encoded, logical)?;
+    match serde_json::from_str(&raw) {
+        Ok(value) => Ok(RowLoad::Value(value)),
+        Err(_) => Ok(RowLoad::Invalid),
+    }
+}
+
+pub(super) fn item_bytes(value: &Value) -> anyhow::Result<usize> {
+    protocol::size(value)
+}
+
+pub(super) fn ready_context(
+    connection: &Connection,
+    project: &str,
+) -> anyhow::Result<Result<Context, Value>> {
+    let context = context(connection, project)?;
+    let Some(context) = context else {
+        return Ok(Err(partial("index_not_ready", project, None)));
+    };
+    Ok(Ok(context))
+}
+
+pub(super) fn check_bounds(limit: usize, max_bytes: usize) -> anyhow::Result<()> {
+    protocol::require((1..=MAX_ROWS).contains(&limit) && (1024..=MAX_BYTES).contains(&max_bytes))
+}
+
+pub(super) fn as_partial(
+    reason: &str,
+    project: &str,
+    context: &Context,
+    items: Vec<Value>,
+) -> Value {
+    with_projection_status(
+        json!({"status":"partial","reason":reason,"project":project,"items":items,"has_more":false,"next_cursor":null,"revision":{"nodes":context.node_revision,"edges":context.edge_revision,"vectors":context.vector_revision}}),
+        context,
+    )
+}
+
+pub(super) fn with_projection_status(mut result: Value, context: &Context) -> Value {
+    result["projection_incomplete"] = json!(context.projection_incomplete);
+    if context.projection_incomplete {
+        result["status"] = json!("partial");
+        if result["reason"].is_null() {
+            result["reason"] = json!("project_projection_incomplete");
+        }
+        if result.get("has_more").is_some() {
+            result["has_more"] = json!(false);
+        }
+        if result.get("next_cursor").is_some() {
+            result["next_cursor"] = Value::Null;
+        }
+        if result.get("approximate").is_some() {
+            result["approximate"] = json!(true);
+        }
+    }
+    result
+}
