@@ -0,0 +1,45 @@
+use super::common::*;
+use rusqlite::{params,Connection};
+use serde_json::{json,Value};
+
+fn authorized_sql(summary_authority_ready:bool) -> String {
+    let mapping=observation_project_predicate("pv");
+    let currentness=observation_source_currentness("pv","scoped_session");
+    let authority=observation_session_authority("scoped_session.name",summary_authority_ready);
+    // Membership authority also covers endpoints without a projected graph node.
+    format!("SELECT DISTINCT nid.value FROM retrieval_scoped_vectors pv INDEXED BY retrieval_scoped_vectors_project CROSS JOIN retrieval_scoped_sessions scoped_session ON scoped_session.token=pv.session CROSS JOIN retrieval_identifiers obs ON obs.epoch=?1 AND obs.value=pv.id CROSS JOIN retrieval_membership m ON m.epoch=obs.epoch AND m.observation=obs.id CROSS JOIN retrieval_identifiers nid ON nid.epoch=m.epoch AND nid.id=m.key WHERE {mapping} AND {currentness} AND {authority}")
+}
+
+fn ranking_sql(summary_authority_ready:bool) -> String {
+    let authorized=authorized_sql(summary_authority_ready);
+    let degree="(SELECT count(*) FROM retrieval_edges e INDEXED BY retrieval_edges_source WHERE e.epoch=?4 AND e.source=n.key AND e.target IN (SELECT value FROM authorized))+(SELECT count(*) FROM retrieval_edges e INDEXED BY retrieval_edges_target WHERE e.epoch=?4 AND e.target=n.key AND e.source IN (SELECT value FROM authorized))";
+    format!("WITH authorized AS MATERIALIZED ({authorized}) SELECT n.key,n.position,n.display_name,({degree}) AS degree FROM authorized a CROSS JOIN retrieval_nodes n ON n.epoch=?1 AND n.key=a.value CROSS JOIN state_rows s ON s.scope='mem:graph:nodes' AND s.key=n.key AND s.value IS NOT NULL WHERE n.display_type='concept' AND length(trim(n.display_name))>0 ORDER BY degree DESC,n.position,n.key LIMIT ?5")
+}
+
+pub(super) fn execute(c:&Connection,project:&str,top_n:usize,max_bytes:usize) -> anyhow::Result<Value> {
+    check_bounds(top_n,max_bytes)?;
+    let context=match ready_context(c,project)? {Ok(context)=>context,Err(page)=>return Ok(page)};
+    let authorized=authorized_sql(context.summary_authority_ready);
+    let incomplete:bool=c.query_row(&format!("WITH authorized AS MATERIALIZED ({authorized}) SELECT EXISTS(SELECT 1 FROM authorized a CROSS JOIN retrieval_nodes n ON n.epoch=?1 AND n.key=a.value WHERE n.display_type IS NULL OR n.display_name IS NULL)"),params![context.node_epoch,context.vector_epoch,project],|r|r.get(0))?;
+    if incomplete {return Ok(partial("graph_concept_projection_not_ready",project,Some(&context)));}
+    // SQLite ranks compact metadata using disk-backed temporary storage, never node bodies.
+    let sql=ranking_sql(context.summary_authority_ready);
+    let mut statement=c.prepare(&sql)?;
+    let mut rows=statement.query(params![context.node_epoch,context.vector_epoch,project,context.edge_epoch,top_n as i64])?;
+    let mut items=Vec::new();
+    while let Some(row)=rows.next()? {
+        let id:String=row.get(0)?;
+        let position:i64=row.get(1)?;
+        let name:String=row.get(2)?;
+        let degree:i64=row.get(3)?;
+        items.push(json!({"key":id,"id":id,"position":position.to_string(),"degree":degree,"value":{"id":id,"type":"concept","name":name,"stale":false}}));
+    }
+    let reason=context.authority_incomplete.then_some("project_authority_incomplete");
+    let result=with_projection_status(json!({"status":if reason.is_some(){"partial"}else{"ready"},"reason":reason,"approximate":reason.is_some(),"project":project,"items":items,"has_more":false,"next_cursor":null,"revision":{"nodes":context.node_revision,"edges":context.edge_revision,"vectors":context.vector_revision}}),&context);
+    if item_bytes(&result)?>max_bytes {return Ok(partial("concept_seed_response_budget",project,Some(&context)));}
+    Ok(result)
+}
+
+#[cfg(test)]
+#[path = "concept_seed_tests.rs"]
+mod tests;
