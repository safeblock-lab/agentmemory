+                require(cursor.len() <= super::request::MAX_PROJECT_CATALOG_UNKNOWN_CURSOR_BYTES)?;
+            }
+        }
+        Request::ProjectCatalogRepairUnknown {
+            source,
+            key,
+            expected_version,
+            expected_revision,
+            expected_epoch,
+            expected_cursor,
+        } => {
+            require(["sessions", "summaries"].contains(&source.as_str()))?;
+            require(!key.trim().is_empty() && key.len() <= 4096)?;
+            super::super::protocol::counter(expected_version)?;
+            super::super::protocol::counter(expected_revision)?;
+            require(*expected_epoch > 0 && *expected_cursor >= -1)?;
+        }
+        Request::ProjectVectorPrepare {
+            index_id,
+            project,
+            source_kind,
+            max_rows,
+            max_bytes,
+        } => {
+            identity(index_id, "index", 1, "generation")?;
+            if let Some(project) = project {
+                require(!project.trim().is_empty() && project.len() <= 256)?;
+            }
+            require(
+                source_kind
+                    .as_ref()
+                    .is_none_or(|kind| kind == "observation" && project.is_some()),
+            )?;
+            require((1..=16).contains(max_rows) && (1024..=65_536).contains(max_bytes))?;
+        }
+        Request::GraphRead {
+            project,
+            mode,
+            query,
+            observation_ids,
+            node_ids,
+            edge_ids,
+            from_time,
+            through_time,
+            since_revision,
+            cursor,
+            limit,
+            max_bytes,
+            top_n,
+        } => {
+            require(!project.trim().is_empty() && project.len() <= 256)?;
+            require(
+                (1..=if *mode == GraphReadMode::Browse { 128 } else { 16 }).contains(limit)
+                    && (1..=16).contains(top_n)
+                    && (1024..=65_536).contains(max_bytes),
+            )?;
+            require(node_ids.len() <= 12 && edge_ids.len() <= 12 && observation_ids.len() <= 12)?;
+            identifiers(node_ids, false)?;
+            identifiers(edge_ids, false)?;
+            identifiers(observation_ids, false)?;
+            if let Some(query) = query {
+                require(!query.trim().is_empty() && query.len() <= 512)?;
+            }
+            if let Some(cursor) = cursor {
+                require(cursor.len() <= if *mode == GraphReadMode::Browse { 4096 } else { 512 })?;
+            }
+            if let Some(revision) = since_revision {
+                super::super::protocol::counter(revision)?;
+            }
+            match mode {
+                GraphReadMode::Browse => require(node_ids.is_empty() && edge_ids.is_empty()
+                    && observation_ids.is_empty() && query.is_none() && from_time.is_none()
+                    && through_time.is_none() && since_revision.is_none())?,
+                GraphReadMode::Search => require(
+                    (query.is_some() || !observation_ids.is_empty())
+                        && node_ids.is_empty()
+                        && edge_ids.is_empty()
+                        && from_time.is_none()
+                        && through_time.is_none()
+                        && since_revision.is_none(),
+                )?,
+                GraphReadMode::Neighbors => require(
+                    !node_ids.is_empty()
+                        && edge_ids.is_empty()
+                        && from_time.is_none()
+                        && through_time.is_none(),
+                )?,
+                GraphReadMode::ConceptSeeds => require(node_ids.is_empty() && edge_ids.is_empty()
+                    && observation_ids.is_empty() && query.is_none() && cursor.is_none()
+                    && from_time.is_none() && through_time.is_none() && since_revision.is_none())?,
+                GraphReadMode::TopN => require(
+                    edge_ids.is_empty()
+                        && observation_ids.is_empty()
+                        && query.is_none()
+                        && from_time.is_none()
+                        && through_time.is_none(),
+                )?,
+                GraphReadMode::History => require(
+                    !edge_ids.is_empty()
+                        && node_ids.is_empty()
+                        && from_time.is_none()
+                        && through_time.is_none(),
+                )?,
+                GraphReadMode::Differential => require(
+                    !edge_ids.is_empty()
+                        && node_ids.is_empty()
+                        && from_time.is_none()
+                        && through_time.is_none()
+                        && since_revision.is_some(),
+                )?,
+                GraphReadMode::Time => {
+                    require(
+                        (!node_ids.is_empty() || !edge_ids.is_empty())
+                            && observation_ids.is_empty()
+                            && query.is_none()
+                            && since_revision.is_none(),
+                    )?;
+                    let from = from_time
+                        .as_ref()
+                        .and_then(|v| chrono::DateTime::parse_from_rfc3339(v).ok());
+                    let through = through_time
+                        .as_ref()
+                        .and_then(|v| chrono::DateTime::parse_from_rfc3339(v).ok());
+                    require(from.is_some() && through.is_some() && from <= through)?;
+                }
+                GraphReadMode::Aggregate => require(
+                    (!node_ids.is_empty() || !edge_ids.is_empty())
+                        && observation_ids.is_empty()
+                        && query.is_none()
+                        && from_time.is_none()
+                        && through_time.is_none()
+                        && since_revision.is_none(),
+                )?,
+            }
+        }
+        Request::IndexStatus {
+            index_id,
+            metadata_only,
+        } => {
+            require(index_id.is_some() == *metadata_only)?;
+            if let Some(index) = index_id {
+                identity(index, "index", 1, "generation")?;
+            }
+        }
+        Request::IndexPrepare {
+            scope,
+            project,
+            max_rows,
+            max_bytes,
+        } => {
+            identifier(scope)?;
+            if scope == super::graph_browse::SCOPE {
+                require(project.as_ref().is_some_and(|p| !p.trim().is_empty() && p.len() <= 256))?;
+                require((1..=1024).contains(max_rows) && (1024..=MAX_GRAPH_PREPARATION_WORK_BYTES).contains(max_bytes))?;
+            } else {
+                require(project.is_none())?;
+                bounds(*max_rows, *max_bytes)?;
+            }
+            require((1..=1024).contains(max_rows))?;
+        }
+        Request::GraphSeeds {
+            entity_names,
+            observation_ids,
+            max_items,
+            max_bytes,
+            ..
+        } => {
+            identifiers(entity_names, true)?;
+            identifiers(observation_ids, false)?;
+            bounds(*max_items, *max_bytes)?;
+        }
+        Request::GraphEdges {
+            node_ids,
+            max_items,
+            max_bytes,
+        } => {
+            identifiers(node_ids, false)?;
+            bounds(*max_items, *max_bytes)?;
+        }
+        Request::SemanticConfigure {
+            index_id,
+            model,
+            dimensions,
+            generation,
+            source_kind,
+        } => {
+            identity(index_id, model, *dimensions, generation)?;
+            require(
+                source_kind
+                    .as_ref()
+                    .is_none_or(|kind| kind == "agentmemory"),
+            )?;
+        }
+        Request::SourcePrepare {
+            index_id,
+            model,
+            dimensions,
+            generation,
+            max_rows,
+            max_bytes,
+        } => {
+            identity(index_id, model, *dimensions, generation)?;
+            require((1..=1024).contains(max_rows))?;
+            bounds(*max_rows, *max_bytes)?;
+        }
+        Request::SemanticUpsert {
+            index_id,
+            model,
+            dimensions,
+            generation,
+            items,
+        } => {
+            identity(index_id, model, *dimensions, generation)?;
+            require(!items.is_empty() && items.len() <= 256)?;
+            for item in items {
+                identifier(&item.id)?;
+                identifier(&item.session_id)?;
+                if let Some(text) = &item.text {
+                    require(!text.trim().is_empty() && text.len() <= 65_536)?;
+                }
+                require(item.source_scope.is_some() == item.source_version.is_some())?;
+                if let Some(scope) = &item.source_scope {
+                    identifier(scope)?;
+                }
+                if let Some(version) = &item.source_version {
+                    super::super::protocol::counter(version)?;
+                }
+            }
+        }
+        Request::SemanticDelete {
+            index_id,
+            model,
+            dimensions,
+            generation,
+            ids,
+        } => {
+            identity(index_id, model, *dimensions, generation)?;
+            identifiers(ids, false)?;
+            require(!ids.is_empty() && ids.len() <= 256)?;
+        }
+        Request::SemanticSearch {
+            index_id,
+            model,
+            dimensions,
+            generation,
+            limit,
+            max_candidates,
+            probes,
+            project,
+            global,
+            session_id,
+            source_scope,
+            source_kind,
+            include_text,
+            max_bytes,
+            ..
+        } => {
+            identity(index_id, model, *dimensions, generation)?;
+            scoped_search(project.as_deref(), *global)?;
+            session_filter(session_id.as_deref())?;
+            source_filter(source_scope.as_deref(), session_id.as_deref())?;
+            projection(source_kind.as_deref(), *include_text, *limit, *max_bytes)?;
+            require(
+                (1..=100).contains(limit)
+                    && (*limit..=MAX_ITEMS).contains(max_candidates)
+                    && (1..=256).contains(probes),
+            )?;
+        }
+        Request::KeywordSearch {
+            index_id,
+            model,
+            dimensions,
+            generation,
+            query,
+            project,
+            global,
+            session_id,
+            source_scope,
+            source_kind,
+            include_text,
+            max_bytes,
+            limit,
+            max_candidates,
+        } => {
+            identity(index_id, model, *dimensions, generation)?;
+            scoped_search(project.as_deref(), *global)?;
+            session_filter(session_id.as_deref())?;
+            source_filter(source_scope.as_deref(), session_id.as_deref())?;
+            projection(source_kind.as_deref(), *include_text, *limit, *max_bytes)?;
+            require(
+                query.len() <= 4096
+                    && (1..=100).contains(limit)
+                    && (*limit..=4096).contains(max_candidates),
+            )?;
+        }
+    }
+    Ok(request)
+}
+
+fn scoped_search(project: Option<&str>, global: Option<bool>) -> anyhow::Result<()> {
+    if let Some(project) = project {
+        require(!project.trim().is_empty() && project.len() <= 256)?;
+    }
+    require(project.is_some() != (global == Some(true)))
+}
+fn session_filter(value: Option<&str>) -> anyhow::Result<()> {
+    if let Some(value) = value {
+        require(!value.is_empty() && value.len() <= 256)?;
+    }
+    Ok(())
+}
+fn source_filter(scope: Option<&str>, session: Option<&str>) -> anyhow::Result<()> {
+    if let Some(scope) = scope {
+        require(session.is_some_and(|id| scope == format!("mem:obs:{id}")))?;
+    }
+    Ok(())
+}
+fn projection(
+    kind: Option<&str>,
+    include: bool,
+    limit: usize,
+    max_bytes: usize,
+) -> anyhow::Result<()> {
+    if let Some(kind) = kind {
+        require(kind == "observation")?;
+    }
+    require((1024..=65_536).contains(&max_bytes) && (!include || limit <= 12))
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/scoped/ann.rs b/engine/src/workers/state/adapters/sqlite/retrieval/scoped/ann.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/scoped/ann.rs
@@ -0,0 +1,483 @@
+use super::query::{
+    SMALL_PROJECT_MAX_CANDIDATES, SMALL_PROJECT_MAX_ID_BYTES, available, batch_page_size,
+    batch_params, batch_statement, batch_window_count, guarded_semantic, kinds, partial, rank, SemanticDiagnostics,
+    small_project_params, small_project_statement, vector_batch_size, vector_params,
+    vector_statement,
+};
+use super::*;
+use rusqlite::params_from_iter;
+use std::collections::{HashMap, HashSet};
+
+struct Candidate {
+    id: String,
+    session: String,
+}
+
+fn small_project_candidates(
+    c: &Connection,
+    meta: &semantic::Meta,
+    project: i64,
+    session: Option<i64>,
+    project_name: &str,
+    kinds: &[i64],
+    max_candidates: usize,
+    diagnostics: &SemanticDiagnostics,
+) -> anyhow::Result<Option<Vec<Candidate>>> {
+    diagnostics.subpath.set("small_project");
+    let _small_project_time = diagnostics.time(&diagnostics.small_project_ms);
+    let threshold = max_candidates.min(SMALL_PROJECT_MAX_CANDIDATES);
+    if threshold == 0 {
+        diagnostics.fallback_reason.set(Some("small_project_disabled"));
+        return Ok(None);
+    }
+    let mut candidates = Vec::with_capacity(threshold);
+    let mut seen = HashSet::with_capacity(threshold);
+    let mut id_bytes = 0usize;
+    for kind in kinds {
+        let remaining = threshold.saturating_sub(candidates.len());
+        let query_limit = remaining + 1;
+        let values = small_project_params(
+            &meta.index_id,
+            meta.epoch,
+            project,
+            *kind,
+            session,
+            project_name,
+            query_limit,
+            SMALL_PROJECT_MAX_ID_BYTES.saturating_sub(id_bytes),
+        );
+        let sql = small_project_statement(*kind, session.is_some());
+        diagnostics.subpath.set("small_project_prepare_sql");
+        let mut statement = {
+            let _prepare_time = diagnostics.time(&diagnostics.prepare_sql_ms);
+            c.prepare_cached(&sql)?
+        };
+        diagnostics.subpath.set("small_project_candidate_read");
+        let _read_time = diagnostics.time(&diagnostics.candidate_read_ms);
+        let mut rows = statement.query(params_from_iter(values.iter()))?;
+        while let Some(row) = rows.next()? {
+            diagnostics.visited.set(diagnostics.visited.get().saturating_add(1));
+            if candidates.len() == threshold || row.get::<_, bool>(10)? {
+                diagnostics.fallback_reason.set(Some("small_project_bound"));
+                return Ok(None);
+            }
+            let id: String = row.get(0)?;
+            let posting_generation: i64 = row.get(2)?;
+            let session_name: String = row.get(3)?;
+            let session_generation: i64 = row.get(4)?;
+            let vector_present: bool = row.get(9)?;
+            if posting_generation != session_generation
+                || !vector_present
+                || !{
+                    let inserted = seen.insert(id.clone());
+                    if !inserted {
+                        diagnostics.duplicate.set(diagnostics.duplicate.get().saturating_add(1));
+                    }
+                    inserted
+                }
+            {
+                diagnostics.fallback_reason.set(Some("small_project_candidate_invalid"));
+                return Ok(None);
+            }
+            if *kind != 2
+                && (row.get::<_, Option<String>>(5)?.is_none()
+                    || row.get::<_, Option<bool>>(6)? != Some(false)
+                    || row.get::<_, Option<String>>(7)? != row.get::<_, Option<String>>(5)?
+                    || !row.get::<_, bool>(8)?)
+            {
+                diagnostics.fallback_reason.set(Some("small_project_source_invalid"));
+                return Ok(None);
+            }
+            id_bytes = id_bytes.saturating_add(id.len());
+            if id_bytes > SMALL_PROJECT_MAX_ID_BYTES {
+                diagnostics.fallback_reason.set(Some("small_project_id_bytes"));
+                return Ok(None);
+            }
+            diagnostics.unique.set(candidates.len() + 1);
+            diagnostics.id_bytes.set(id_bytes);
+            candidates.push(Candidate {
+                id,
+                session: session_name,
+            });
+        }
+    }
+    Ok(Some(candidates))
+}
+
+fn small_project_search(
+    c: &Connection,
+    meta: &semantic::Meta,
+    query: &[f32],
+    project: i64,
+    session: Option<i64>,
+    project_name: &str,
+    kinds: &[i64],
+    limit: usize,
+    max_candidates: usize,
+    options: super::super::search_projection::Options<'_>,
+    readiness_reason: Option<&'static str>,
+    phase: &std::cell::Cell<&'static str>,
+    diagnostics: &SemanticDiagnostics,
+) -> anyhow::Result<Option<Value>> {
+    let Some(candidates) = small_project_candidates(
+        c,
+        meta,
+        project,
+        session,
+        project_name,
+        kinds,
+        max_candidates,
+        diagnostics,
+    )?
+    else {
+        return Ok(None);
+    };
+    let candidate_count = candidates.len();
+    let mut matches = Vec::with_capacity(limit);
+    if !score_candidates(
+        c,
+        meta,
+        query,
+        meta.dimensions,
+        &candidates,
+        limit,
+        &mut matches,
+        phase,
+        diagnostics,
+    )?
+    .is_empty()
+    {
+        diagnostics.fallback_reason.set(Some("small_project_vector_missing"));
+        return Ok(None);
+    }
+    phase.set("enrichment");
+    diagnostics.subpath.set("enrichment");
+    let projection =
+        super::super::search_projection::enrich(c, &meta.index_id, &mut matches, options)?;
+    let partial_reason = if projection.is_some() {
+        projection
+    } else {
+        readiness_reason
+    };
+    let status = if partial_reason.is_some() {
+        "partial"
+    } else {
+        "ready"
+    };
+    Ok(Some(json!({
+        "items":matches,
+        "approximate":false,
+        "candidates":candidate_count,
+        "raw_visits":candidate_count,
+        "budget_exhausted":false,
+        "status":status,
+        "reason":partial_reason,
+        "model":meta.model,
+        "dimensions":meta.dimensions,
+        "generation":meta.generation
+    })))
+}
+
+fn score_candidates(
+    c: &Connection,
+    meta: &semantic::Meta,
+    query: &[f32],
+    dimensions: usize,
+    candidates: &[Candidate],
+    limit: usize,
+    matches: &mut Vec<Value>,
+    phase: &std::cell::Cell<&'static str>,
+    diagnostics: &SemanticDiagnostics,
+) -> anyhow::Result<Vec<String>> {
+    phase.set("scoring");
+    diagnostics.subpath.set("scoring");
+    if candidates.is_empty() {
+        return Ok(Vec::new());
+    }
+    let batch_size = vector_batch_size(dimensions);
+    diagnostics.subpath.set("vector_prepare_sql");
+    let sql = vector_statement(batch_size);
+    let mut statement = {
+        let _prepare_time = diagnostics.time(&diagnostics.prepare_sql_ms);
+        c.prepare_cached(&sql)?
+    };
+    diagnostics.subpath.set("scoring");
+    let mut missing = Vec::new();
+    for batch in candidates.chunks(batch_size) {
+        let ids: Vec<_> = batch.iter().map(|candidate| candidate.id.clone()).collect();
+        let mut sessions: HashMap<_, _> = batch
+            .iter()
+            .map(|candidate| (candidate.id.as_str(), candidate.session.as_str()))
+            .collect();
+        let values = vector_params(&meta.index_id, meta.epoch, &ids, batch_size);
+        let mut rows = statement.query(params_from_iter(values.iter()))?;
+        while let Some(row) = rows.next()? {
+            let id: String = row.get(0)?;
+            let Some(session_id) = sessions.remove(id.as_str()) else {
+                return Err(protocol::error("STATE_INDEX_NOT_READY"));
+            };
+            let embedding: Vec<u8> = row.get(1)?;
+            let score = lsh::cosine(query, &lsh::from_blob(&embedding, dimensions)?);
+            matches.push(json!({"obsId":id,"sessionId":session_id,"score":score}));
+            matches.sort_unstable_by(rank);
+            matches.truncate(limit);
+        }
+        missing.extend(sessions.into_keys().map(str::to_owned));
+    }
+    Ok(missing)
+}
+
+pub fn semantic_search(
+    c: &Connection,
+    meta: &semantic::Meta,
+    embedding: &str,
+    limit: usize,
+    max_candidates: usize,
+    probes: usize,
+    options: super::super::search_projection::Options<'_>,
+) -> anyhow::Result<Value> {
+    let availability = available(c, meta, options)?;
+    if !availability.usable {
+        return Ok(partial(meta, "project_index_not_ready"));
+    }
+    guarded_semantic(c, meta, |phase, diagnostics| {
+        semantic_inner(c, meta, embedding, limit, max_candidates, probes, options, availability.partial_reason, phase, diagnostics)
+    })
+}
+fn semantic_inner(
+    c: &Connection,
+    meta: &semantic::Meta,
+    embedding: &str,
+    limit: usize,
+    max_candidates: usize,
+    probes: usize,
+    options: super::super::search_projection::Options<'_>,
+    readiness_reason: Option<&'static str>,
+    phase: &std::cell::Cell<&'static str>,
+    diagnostics: &SemanticDiagnostics,
+) -> anyhow::Result<Value> {
+    let project = project_token(c, options.project.unwrap())?
+        .ok_or_else(|| protocol::error("STATE_INDEX_NOT_READY"))?;
+    let project_name = options.project.unwrap();
+    let session = options
+        .session_id
+        .map(|s| session_token(c, s))
+        .transpose()?
+        .flatten();
+    if options.session_id.is_some() && session.is_none() {
+        return Ok(json!({"items":[],"status":if readiness_reason.is_some(){"partial"}else{"ready"},"reason":readiness_reason,"candidates":0,"approximate":true,"budget_exhausted":false,"model":meta.model,"dimensions":meta.dimensions,"generation":meta.generation}));
+    }
+    let query = lsh::decode(embedding, meta.dimensions)?;
+    let kinds = kinds(c, &meta.index_id, options)?;
+    if let Some(result) = small_project_search(
+        c,
+        meta,
+        &query,
+        project,
+        session,
+        project_name,
+        &kinds,
+        limit,
+        max_candidates,
+        options,
+        readiness_reason,
+        phase,
+        diagnostics,
+    )? {
+        return Ok(result);
+    }
+    phase.set("candidate_selection");
+    let buckets: Vec<_> = lsh::signatures(&query)
+        .iter()
+        .map(|signature| lsh::buckets(signature, probes))
+        .collect();
+    let bucket_limit = (max_candidates / lsh::TABLES / kinds.len()).max(16);
+    let max_visits = max_candidates
+        .saturating_mul(lsh::TABLES)
+        .saturating_mul(kinds.len());
+    let batch_windows = batch_window_count(bucket_limit);
+    let bucket_rows = bucket_limit.saturating_add(1);
+    let page_size = batch_page_size(bucket_limit);
+    let paged_window = bucket_rows > page_size;
+    diagnostics.unique.set(0);
+    diagnostics.id_bytes.set(0);
+    diagnostics.subpath.set("ann_prepare_sql");
+    let sql = batch_statement(session.is_some(), batch_windows);
+    let mut statement = {
+        let _prepare_time = diagnostics.time(&diagnostics.prepare_sql_ms);
+        c.prepare_cached(&sql)?
+    };
+    let mut seen = HashSet::with_capacity(max_candidates.min(4096));
+    let mut matches: Vec<Value> = Vec::with_capacity(limit);
+    let mut visits = 0;
+    let mut exhausted = false;
+    let mut incomplete = false;
+    let mut id_bytes = 0;
+    let selectors_per_probe = lsh::TABLES * kinds.len();
+    let total_windows = probes * selectors_per_probe;
+    let mut window_start = 0;
+    'windows: while window_start < total_windows {
+        diagnostics.window.set(window_start + 1);
+        diagnostics.page.set(0);
+        let active_windows = batch_windows.min(total_windows - window_start);
+        let mut selectors = Vec::with_capacity(active_windows);
+        for offset in 0..active_windows {
+            let position = window_start + offset;
+            let probe = position / selectors_per_probe;
+            let within_probe = position % selectors_per_probe;
+            let table = within_probe / kinds.len();
+            let kind = kinds[within_probe % kinds.len()];
+            selectors.push((kind, table as i64, Some(buckets[table][probe])));
+        }
+        let values = batch_params(
+            &meta.index_id,
+            meta.epoch,
+            project,
+            session,
+            project_name,
+            if paged_window { page_size } else { bucket_rows },
+            None,
+            &selectors,
+            batch_windows,
+        );
+        let mut stop = false;
+        let mut page_cursor: Option<(i64, String)> = None;
+        let mut current_window: Option<i64> = None;
+        let mut bucket_seen = 0;
+        loop {
+            let page_values = if let Some((cursor_session, cursor_id)) = &page_cursor {
+                batch_params(
+                    &meta.index_id,
+                    meta.epoch,
+                    project,
+                    session,
+                    project_name,
+                    if paged_window { page_size } else { bucket_rows },
+                    Some((*cursor_session, cursor_id.as_str())),
+                    &selectors,
+                    batch_windows,
+                )
+            } else {
+                values.clone()
+            };
+            let query_page_size = if paged_window { page_size } else { bucket_rows };
+            let mut page_rows = 0;
+            let mut last_cursor = None;
+            let mut page_candidates = Vec::new();
+            let mut bucket_done = false;
+            {
+                phase.set("candidate_selection");
+                diagnostics.subpath.set("ann_candidate_read");
+                diagnostics.page.set(diagnostics.page.get().saturating_add(1));
+                let _read_time = diagnostics.time(&diagnostics.candidate_read_ms);
+                let mut rows = statement.query(params_from_iter(page_values.iter()))?;
+                while let Some(row) = rows.next()? {
+                    page_rows += 1;
+                    diagnostics.visited.set(diagnostics.visited.get().saturating_add(1));
+                    let window: i64 = row.get(0)?;
+                    diagnostics.window.set(window_start.saturating_add(window as usize).saturating_add(1));
+                    if current_window != Some(window) {
+                        current_window = Some(window);
+                        if !paged_window {
+                            bucket_seen = 0;
+                        }
+                    }
+                    let id: String = row.get(1)?;
+                    let posting_session: i64 = row.get(2)?;
+                    last_cursor = Some((posting_session, id.clone()));
+                    visits += 1;
+                    if visits > max_visits {
+                        exhausted = true;
+                        stop = true;
+                        break;
+                    }
+                    bucket_seen += 1;
+                    if bucket_seen > bucket_limit {
+                        exhausted = true;
+                        bucket_done = true;
+                        if paged_window {
+                            break;
+                        }
+                        continue;
+                    }
+                    if seen.contains(&id) {
+                        diagnostics.duplicate.set(diagnostics.duplicate.get().saturating_add(1));
+                        continue;
+                    }
+                    if seen.len() >= max_candidates || id_bytes + id.len() > 4 * 1024 * 1024 {
+                        exhausted = true;
+                        stop = true;
+                        break;
+                    }
+                    let kind: i64 = row.get(3)?;
+                    let posting_generation: i64 = row.get(4)?;
+                    let session_generation: Option<i64> = row.get(6)?;
+                    let source_version: Option<String> = row.get(7)?;
+                    let dirty: Option<bool> = row.get(8)?;
+                    let vector_present: bool = row.get(9)?;
+                    if !vector_present
+                        || session_generation != Some(posting_generation)
+                        || (kind != 2 && (source_version.is_none() || dirty != Some(false)))
+                    {
+                        incomplete = true;
+                        continue;
+                    }
+                    let session_id: String = row.get(5)?;
+                    id_bytes += id.len();
+                    seen.insert(id.clone());
+                    diagnostics.unique.set(seen.len());
+                    diagnostics.id_bytes.set(id_bytes);
+                    page_candidates.push(Candidate {
+                        id,
+                        session: session_id,
+                    });
+                }
+            }
+            for id in score_candidates(
+                c,
+                meta,
+                &query,
+                meta.dimensions,
+                &page_candidates,
+                limit,
+                &mut matches,
+                phase,
+                diagnostics,
+            )? {
+                incomplete = true;
+                if seen.remove(&id) {
+                    id_bytes = id_bytes.saturating_sub(id.len());
+                    diagnostics.unique.set(seen.len());
+                    diagnostics.id_bytes.set(id_bytes);
+                }
+            }
+            if stop || !paged_window || bucket_done || page_rows < query_page_size {
+                break;
+            }
+            page_cursor = last_cursor;
+            if page_cursor.is_none() {
+                break;
+            }
+        }
+        if stop {
+            break 'windows;
+        }
+        window_start += active_windows;
+    }
+    phase.set("enrichment");
+    diagnostics.subpath.set("enrichment");
+    let projection =
+        super::super::search_projection::enrich(c, &meta.index_id, &mut matches, options)?;
+    let reason = if incomplete {
+        Some("projection_source_missing")
+    } else if projection.is_some() {
+        projection
+    } else if exhausted {
+        Some("candidate_budget")
+    } else {
+        readiness_reason
+    };
+    Ok(
+        json!({"items":matches,"approximate":true,"candidates":seen.len(),"raw_visits":visits,"budget_exhausted":exhausted,"status":if reason.is_some(){"partial"}else{"ready"},"reason":reason,"model":meta.model,"dimensions":meta.dimensions,"generation":meta.generation}),
+    )
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/scoped/background.rs b/engine/src/workers/state/adapters/sqlite/retrieval/scoped/background.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/scoped/background.rs
@@ -0,0 +1,69 @@
+use super::*;
+pub fn gc(c: &Connection, index: &str, epoch: i64, limit: usize) -> anyhow::Result<usize> {
+    let mut s=c.prepare("SELECT epoch,id FROM retrieval_scoped_vectors WHERE index_id=?1 AND epoch<?2 ORDER BY epoch,id LIMIT ?3")?;
+    let rows = s
+        .query_map(params![index, epoch, limit as i64], |r| {
+            Ok((r.get::<_, i64>(0)?, r.get::<_, String>(1)?))
+        })?
+        .collect::<rusqlite::Result<Vec<_>>>()?;
+    for (old, id) in &rows {
+        remove(c, index, *old, id)?;
+    }
+    Ok(rows.len())
+}
+pub fn global_prepare(
+    c: &Connection,
+    index: &str,
+    max_rows: usize,
+    max_bytes: usize,
+) -> anyhow::Result<Value> {
+    let mut value = super::super::project_vectors::prepare(c, index, max_rows, max_bytes)?;
+    if value["status"] != "ready" {
+        return Ok(value);
+    }
+    let mut processed = value["processed"].as_u64().unwrap_or(0) as usize;
+    let meta = semantic::get(c, index)?;
+    ensure(c, index, meta.epoch)?;
+    let (status, mut cursor): (String, String) = c.query_row(
+        "SELECT status,cursor FROM retrieval_scoped_meta WHERE index_id=?1 AND epoch=?2",
+        params![index, meta.epoch],
+        |r| Ok((r.get(0)?, r.get(1)?)),
+    )?;
+    let mut complete = status == "ready";
+    let mut bytes = 0;
+    while !complete && processed < max_rows {
+        let next:Option<(String,String)>=c.query_row("SELECT id,session_id FROM retrieval_vector_values WHERE index_id=?1 AND epoch=?2 AND id>?3 ORDER BY id LIMIT 1",params![index,meta.epoch,cursor],|r|Ok((r.get(0)?,r.get(1)?))).optional()?;
+        let Some((id, session)) = next else {
+            complete = true;
+            break;
+        };
+        let body = text(c, index, meta.epoch, &id)?;
+        let needed = body.as_ref().map_or(0, String::len);
+        if bytes + needed > 1_048_576 {
+            break;
+        }
+        replace(c, index, meta.epoch, &id, &session, body.as_deref())?;
+        cursor = id;
+        processed += 1;
+        bytes += needed;
+    }
+    if complete && processed < max_rows {
+        processed += gc(c, index, meta.epoch, max_rows - processed)?;
+    }
+    c.execute(
+        "UPDATE retrieval_scoped_meta SET status=?3,cursor=?4 WHERE index_id=?1 AND epoch=?2",
+        params![
+            index,
+            meta.epoch,
+            if complete { "ready" } else { "pending" },
+            cursor
+        ],
+    )?;
+    value["status"] = json!(if complete { "ready" } else { "pending" });
+    value["has_more"] = json!(!complete);
+    value["processed"] = json!(processed);
+    value["scoped_status"] = value["status"].clone();
+    value["scoped_cursor"] = json!(cursor);
+    value["text_bytes"] = json!(bytes);
+    Ok(value)
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/scoped/keyword.rs b/engine/src/workers/state/adapters/sqlite/retrieval/scoped/keyword.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/scoped/keyword.rs
@@ -0,0 +1,124 @@
+use super::query::{available, guarded_keyword, kinds, lexical_statement, partial, rank};
+use super::*;
+pub fn keyword_search(
+    c: &Connection,
+    meta: &semantic::Meta,
+    expression: Option<&str>,
+    limit: usize,
+    max_candidates: usize,
+    options: super::super::search_projection::Options<'_>,
+) -> anyhow::Result<Value> {
+    let availability = available(c, meta, options)?;
+    if !availability.usable {
+        return Ok(partial(meta, "project_index_not_ready"));
+    }
+    guarded_keyword(c, meta, limit.min(max_candidates), |phase, diagnostics| {
+        keyword_inner(c, meta, expression, limit, max_candidates, options, availability.partial_reason, phase, diagnostics)
+    })
+}
+#[cfg(test)]
+pub const LEXICAL_SQL: &str = "SELECT retrieval_scoped_lexical.rowid,1.0,scoped.id,session.name,scoped.generation,session.generation,scoped.project_generation,vector.id FROM retrieval_scoped_lexical CROSS JOIN retrieval_scoped_vectors scoped ON scoped.document=retrieval_scoped_lexical.rowid JOIN retrieval_scoped_sessions session ON session.token=scoped.session JOIN retrieval_vector_values vector ON vector.index_id=scoped.index_id AND vector.epoch=scoped.epoch AND vector.id=scoped.id LEFT JOIN retrieval_source_items source_item ON source_item.index_id=scoped.index_id AND source_item.key=scoped.id AND source_item.scope=CASE scoped.kind WHEN 0 THEN 'mem:obs:'||session.name WHEN 1 THEN 'mem:memories' ELSE '' END LEFT JOIN state_values current_source ON current_source.scope=CASE scoped.kind WHEN 0 THEN 'mem:obs:'||session.name WHEN 1 THEN 'mem:memories' ELSE '' END AND current_source.key=scoped.id WHERE retrieval_scoped_lexical MATCH ?1 AND scoped.index_id=?3 AND scoped.epoch=?4 AND scoped.project=?5 AND scoped.project_generation=1 AND scoped.generation=session.generation AND (scoped.kind=2 OR (source_item.version=current_source.version AND source_item.dirty=0 AND current_source.live=1)) AND (scoped.kind=2 OR (EXISTS(SELECT 1 FROM state_values authority_session WHERE authority_session.scope='mem:sessions' AND authority_session.key=session.name AND authority_session.live=1 AND CASE WHEN authority_session.value_bytes BETWEEN 1 AND 65536 AND CASE typeof(authority_session.value) WHEN 'blob' THEN authority_session.stored_bytes WHEN 'text' THEN authority_session.stored_bytes*4 ELSE 0 END BETWEEN 1 AND 65536 THEN state_project(authority_session.value,authority_session.value_bytes,NULL) END=?6) OR (NOT EXISTS(SELECT 1 FROM state_values authority_session WHERE authority_session.scope='mem:sessions' AND authority_session.key=session.name AND authority_session.live=1) AND EXISTS(SELECT 1 FROM state_values authority_summary WHERE authority_summary.scope='mem:summaries' AND authority_summary.key=session.name AND authority_summary.live=1 AND CASE WHEN authority_summary.value_bytes BETWEEN 1 AND 65536 AND CASE typeof(authority_summary.value) WHEN 'blob' THEN authority_summary.stored_bytes WHEN 'text' THEN authority_summary.stored_bytes*4 ELSE 0 END BETWEEN 1 AND 65536 THEN state_project(authority_summary.value,authority_summary.value_bytes,session.name) END=?6)))) LIMIT ?2";
+fn keyword_inner(
+    c: &Connection,
+    meta: &semantic::Meta,
+    expression: Option<&str>,
+    limit: usize,
+    max_candidates: usize,
+    options: super::super::search_projection::Options<'_>,
+    readiness_reason: Option<&'static str>,
+    phase: &std::cell::Cell<&'static str>,
+    diagnostics: &super::super::search_projection::KeywordDiagnostics,
+) -> anyhow::Result<Value> {
+    let pre_enrichment = diagnostics.pre_enrichment();
+    if source::kind(c, &meta.index_id)?.is_none() && meta.lexical_count != meta.count {
+        return Err(protocol::error("STATE_LEXICAL_INDEX_NOT_READY"));
+    }
+    let project = project_token(c, options.project.unwrap())?
+        .ok_or_else(|| protocol::error("STATE_INDEX_NOT_READY"))?;
+    let project_generation = 1;
+    let session = options
+        .session_id
+        .map(|s| session_token(c, s))
+        .transpose()?
+        .flatten();
+    let mut output = Vec::with_capacity(limit);
+    let mut candidates = 0;
+    let mut exhausted = false;
+    let mut incomplete = false;
+    if options.session_id.is_none() || session.is_some() {
+        if let Some(expression) = expression {
+            let sql = lexical_statement();
+            let mut statement = c.prepare_cached(&sql)?;
+            for kind in kinds(c, &meta.index_id, options)? {
+                let (project_scope, session_scope) = terms(
+                    &meta.index_id,
+                    meta.epoch,
+                    project,
+                    project_generation,
+                    kind,
+                    session.unwrap_or(0),
+                );
+                let scope = if session.is_some() {
+                    format!("session_scope:\"{session_scope}\"")
+                } else {
+                    format!("project_scope:\"{project_scope}\"")
+                };
+                let query = format!("({scope}) AND body:({expression})");
+                let remaining = max_candidates.saturating_sub(candidates);
+                let mut rows = statement.query(params![
+                    query,
+                    (remaining + 1) as i64,
+                    meta.index_id,
+                    meta.epoch,
+                    project,
+                    options.project.unwrap()
+                ])?;
+                while let Some(row) = rows.next()? {
+                    if candidates >= max_candidates {
+                        exhausted = true;
+                        break;
+                    }
+                    candidates += 1;
+                    let id: Option<String> = row.get(2)?;
+                    let current: Option<i64> = row.get(5)?;
+                    let source: Option<i64> = row.get(4)?;
+                    let indexed_project: Option<i64> = row.get(6)?;
+                    let session_id: Option<String> = row.get(3)?;
+                    if id.is_none()
+                        || current != source
+                        || indexed_project != Some(project_generation)
+                        || session_id.is_none()
+                        || row.get::<_, Option<String>>(7)?.is_none()
+                    {
+                        incomplete = true;
+                        continue;
+                    }
+                    let session_id = session_id.unwrap();
+                    output.push(json!({"obsId":id.unwrap(),"sessionId":session_id,"score":1.0}));
+                }
+                if exhausted {
+                    break;
+                }
+            }
+        }
+    }
+    phase.set("scoring");
+    output.sort_unstable_by(rank);
+    output.truncate(limit);
+    phase.set("enrichment");
+    let projection = super::super::search_projection::enrich_keyword(
+        c, &meta.index_id, &mut output, options, diagnostics, pre_enrichment,
+    )?;
+    let reason = if incomplete {
+        Some("projection_source_missing")
+    } else if projection.is_some() {
+        projection
+    } else if exhausted {
+        Some("candidate_budget")
+    } else {
+        readiness_reason
+    };
+    Ok(
+        json!({"items":output,"candidates":candidates,"budget_exhausted":exhausted,"approximate":true,"status":if reason.is_some(){"partial"}else{"ready"},"reason":reason,"model":meta.model,"dimensions":meta.dimensions,"generation":meta.generation}),
+    )
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/scoped/membership.rs b/engine/src/workers/state/adapters/sqlite/retrieval/scoped/membership.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/scoped/membership.rs
@@ -0,0 +1,117 @@
+use super::*;
+#[derive(Clone, Copy)]
+pub struct Member {
+    pub token: i64,
+    pub project: Option<i64>,
+    pub generation: i64,
+}
+pub fn project_token(c: &Connection, name: &str) -> anyhow::Result<Option<i64>> {
+    c.query_row(
+        "SELECT token FROM retrieval_scoped_projects WHERE name=?1",
+        [name],
+        |r| r.get(0),
+    )
+    .optional()
+    .map_err(Into::into)
+}
+pub fn session_token(c: &Connection, name: &str) -> anyhow::Result<Option<i64>> {
+    c.query_row(
+        "SELECT token FROM retrieval_scoped_sessions WHERE name=?1",
+        [name],
+        |r| r.get(0),
+    )
+    .optional()
+    .map_err(Into::into)
+}
+pub fn project(c: &Connection, name: &str) -> anyhow::Result<i64> {
+    c.execute(
+        "INSERT OR IGNORE INTO retrieval_scoped_projects(name) VALUES(?1)",
+        [name],
+    )?;
+    Ok(project_token(c, name)?.unwrap())
+}
+pub fn get(c: &Connection, name: &str) -> anyhow::Result<Member> {
+    get_bounded(c, name, usize::MAX)?
+        .map(|(member, _)| member)
+        .ok_or_else(|| protocol::error("STATE_TX_INVALID_REQUEST"))
+}
+pub fn get_bounded(
+    c: &Connection,
+    name: &str,
+    max_bytes: usize,
+) -> anyhow::Result<Option<(Member, usize)>> {
+    let (authority, bytes) = project_catalog::resolve_session_bounded(c, name, max_bytes)?;
+    if authority == Err("budget") {
+        return Ok(None);
+    }
+    let next = match authority {
+        Ok(name) => Some(project(c, &name)?),
+        Err(_) => None,
+    };
+    let saved: Option<(i64, Option<i64>, i64)> = c
+        .query_row(
+            "SELECT token,project,generation FROM retrieval_scoped_sessions WHERE name=?1",
+            [name],
+            |r| Ok((r.get(0)?, r.get(1)?, r.get(2)?)),
+        )
+        .optional()?;
+    if let Some((token, previous, generation)) = saved {
+        if previous == next {
+            return Ok(Some((Member {
+                token,
+                project: next,
+                generation,
+            }, bytes)));
+        }
+        super::super::graph_browse::session(c,name)?;
+        let generation = generation
+            .checked_add(1)
+            .ok_or_else(|| protocol::error("STATE_TX_LIMIT_EXCEEDED"))?;
+        c.execute("UPDATE retrieval_scoped_sessions SET project=?2,generation=?3,status='pending',cursor_index='',cursor_epoch=0,cursor_id='' WHERE token=?1",params![token,next,generation])?;
+        return Ok(Some((Member {
+            token,
+            project: next,
+            generation,
+        }, bytes)));
+    }
+    c.execute("INSERT INTO retrieval_scoped_sessions(name,project,generation,status,cursor_index,cursor_epoch,cursor_id) VALUES(?1,?2,1,?3,'',0,'')",params![name,next,if next.is_some(){"ready"}else{"unknown"}])?;
+    Ok(Some((Member {
+        token: session_token(c, name)?.unwrap(),
+        project: next,
+        generation: 1,
+    }, bytes)))
+}
+pub fn changed(c: &Connection, scope: &str, key: &str) -> anyhow::Result<()> {
+    if ["mem:sessions", "mem:summaries"].contains(&scope) {
+        let old: Option<Option<i64>> = c
+            .query_row(
+                "SELECT project FROM retrieval_scoped_sessions WHERE name=?1",
+                [key],
+                |r| r.get(0),
+            )
+            .optional()?;
+        let next = get(c, key)?;
+        if old != Some(next.project) {
+            let populated:bool=c.query_row("SELECT EXISTS(SELECT 1 FROM state_values WHERE scope=?1 AND live=1)",[format!("mem:obs:{key}")],|r|r.get(0))?;
+            let queue = old.is_some() || populated;
+            let mut indices = c.prepare(
+                "SELECT index_id FROM retrieval_semantic_meta ORDER BY index_id LIMIT 128",
+            )?;
+            let indices = indices
+                .query_map([], |r| r.get::<_, String>(0))?
+                .collect::<rusqlite::Result<Vec<_>>>()?;
+            for project in old.into_iter().flatten().chain(next.project) {
+                protocol::require(c.execute("UPDATE retrieval_scoped_projects SET generation=generation+1 WHERE token=?1 AND generation<9007199254740990",[project])?==1)?;
+                if queue {
+                    for index in &indices {
+                        for kind in [0, 3] {
+                            c.execute("INSERT INTO retrieval_scoped_work VALUES(?1,?2,?3,'pending',-1,'') ON CONFLICT(index_id,session,kind) DO UPDATE SET status='pending',position=-1,cursor=''",params![index,next.token,kind])?;
+                            c.execute("INSERT OR IGNORE INTO retrieval_scoped_affected VALUES(?1,?2,?3,?4)",params![index,next.token,kind,project])?;
+                        }
+                    }
+                }
+            }
+        }
+    }
+    Ok(())
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/scoped/mod.rs b/engine/src/workers/state/adapters/sqlite/retrieval/scoped/mod.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/scoped/mod.rs
@@ -0,0 +1,129 @@
+mod ann;
+pub(super) mod background;
+mod keyword;
+mod membership;
+mod pending;
+mod prepare;
+mod projection;
+mod query;
+mod write;
+use super::super::{database, protocol};
+use super::{lsh, project_catalog, semantic, source};
+pub use background::global_prepare;
+pub use membership::{changed, project_token, session_token};
+pub use pending::{source_changed, source_removed};
+pub use prepare::{prepare, prepare_browse, status};
+#[cfg(test)]
+pub use query::{LEXICAL_SQL, statement};
+pub use query::{keyword_search, semantic_search, terms};
+use rusqlite::{Connection, OptionalExtension, params};
+use serde_json::{Value, json};
+pub use write::{remove, replace, text};
+
+pub fn schema(c: &Connection) -> anyhow::Result<()> {
+    c.execute_batch("CREATE TABLE IF NOT EXISTS retrieval_scoped_projects(token INTEGER PRIMARY KEY,name TEXT NOT NULL UNIQUE,generation INTEGER NOT NULL DEFAULT 1);
+        CREATE TABLE IF NOT EXISTS retrieval_scoped_sessions(token INTEGER PRIMARY KEY,name TEXT NOT NULL UNIQUE,project INTEGER,generation INTEGER NOT NULL,status TEXT NOT NULL,cursor_index TEXT NOT NULL,cursor_epoch INTEGER NOT NULL,cursor_id TEXT NOT NULL);
+        CREATE INDEX IF NOT EXISTS retrieval_scoped_sessions_pending ON retrieval_scoped_sessions(status,token);
+        CREATE TABLE IF NOT EXISTS retrieval_scoped_dirty(index_id TEXT NOT NULL,session INTEGER NOT NULL,id TEXT NOT NULL,project INTEGER NOT NULL,PRIMARY KEY(index_id,session,id)) WITHOUT ROWID;
+        CREATE INDEX IF NOT EXISTS retrieval_scoped_dirty_project ON retrieval_scoped_dirty(index_id,project,session,id);
+        CREATE TABLE IF NOT EXISTS retrieval_scoped_work(index_id TEXT NOT NULL,session INTEGER NOT NULL,kind INTEGER NOT NULL,status TEXT NOT NULL,position INTEGER NOT NULL,cursor TEXT NOT NULL,PRIMARY KEY(index_id,session,kind)) WITHOUT ROWID;
+        CREATE TABLE IF NOT EXISTS retrieval_scoped_affected(index_id TEXT NOT NULL,session INTEGER NOT NULL,kind INTEGER NOT NULL,project INTEGER NOT NULL,PRIMARY KEY(index_id,session,kind,project)) WITHOUT ROWID;
+        CREATE INDEX IF NOT EXISTS retrieval_scoped_affected_project ON retrieval_scoped_affected(index_id,project,kind,session);
+        CREATE TABLE IF NOT EXISTS retrieval_scoped_meta(index_id TEXT PRIMARY KEY,epoch INTEGER NOT NULL,status TEXT NOT NULL,cursor TEXT NOT NULL,unknown INTEGER NOT NULL CHECK(unknown>=0)) WITHOUT ROWID;
+        CREATE TABLE IF NOT EXISTS retrieval_scoped_coverage(index_id TEXT NOT NULL,epoch INTEGER NOT NULL,project INTEGER NOT NULL,kind INTEGER NOT NULL,generation INTEGER NOT NULL,status TEXT NOT NULL,source INTEGER NOT NULL,session_cursor TEXT NOT NULL,key_cursor TEXT NOT NULL,active_session TEXT NOT NULL,position INTEGER NOT NULL,vector_cursor TEXT NOT NULL,sessions_epoch INTEGER NOT NULL,summaries_epoch INTEGER NOT NULL,PRIMARY KEY(index_id,epoch,project,kind)) WITHOUT ROWID;
+        CREATE TABLE IF NOT EXISTS retrieval_scoped_vectors(index_id TEXT NOT NULL,epoch INTEGER NOT NULL,id TEXT NOT NULL,project INTEGER,project_generation INTEGER NOT NULL,kind INTEGER NOT NULL,session INTEGER NOT NULL,generation INTEGER NOT NULL,buckets BLOB NOT NULL,document INTEGER UNIQUE,PRIMARY KEY(index_id,epoch,id)) WITHOUT ROWID;
+        CREATE TABLE IF NOT EXISTS retrieval_scoped_postings(index_id TEXT NOT NULL,epoch INTEGER NOT NULL,project INTEGER NOT NULL,project_generation INTEGER NOT NULL,kind INTEGER NOT NULL,table_id INTEGER NOT NULL,bucket INTEGER NOT NULL,session INTEGER NOT NULL,id TEXT NOT NULL,generation INTEGER NOT NULL,PRIMARY KEY(index_id,epoch,project,project_generation,kind,table_id,bucket,session,id)) WITHOUT ROWID;
+        CREATE VIRTUAL TABLE IF NOT EXISTS retrieval_scoped_lexical USING fts5(project_scope,session_scope,body,content='',contentless_delete=1,tokenize='unicode61 tokenchars ''_''');")?;
+    Ok(())
+}
+pub fn ensure(c: &Connection, index: &str, epoch: i64) -> anyhow::Result<()> {
+    let saved: Option<i64> = c
+        .query_row(
+            "SELECT epoch FROM retrieval_scoped_meta WHERE index_id=?1",
+            [index],
+            |r| r.get(0),
+        )
+        .optional()?;
+    if saved == Some(epoch) {
+        return Ok(());
+    }
+    let exists: bool = c.query_row(
+        "SELECT EXISTS(SELECT 1 FROM retrieval_vector_values WHERE index_id=?1 AND epoch=?2)",
+        params![index, epoch],
+        |r| r.get(0),
+    )?;
+    c.execute("INSERT INTO retrieval_scoped_meta VALUES(?1,?2,?3,'',0) ON CONFLICT(index_id) DO UPDATE SET epoch=excluded.epoch,status=excluded.status,cursor='',unknown=0",params![index,epoch,if exists{"pending"}else{"ready"}])?;
+    Ok(())
+}
+pub fn generation(c: &Connection, project: i64) -> anyhow::Result<i64> {
+    c.query_row(
+        "SELECT generation FROM retrieval_scoped_projects WHERE token=?1",
+        [project],
+        |r| r.get(0),
+    )
+    .map_err(Into::into)
+}
+pub fn ready(
+    c: &Connection,
+    index: &str,
+    epoch: i64,
+    project: &str,
+    observation: bool,
+) -> anyhow::Result<bool> {
+    let authority_incomplete = if observation {
+        project_catalog::has_incomplete_session_authority(c)?
+    } else {
+        project_catalog::has_incomplete_authority(c)?
+    };
+    if authority_incomplete {
+        return Ok(false);
+    }
+    let Some(project) = project_token(c, project)? else {
+        return Ok(false);
+    };
+    let generation = generation(c, project)?;
+    if pending::has(c, index, project, if observation { 0 } else { 3 })? {
+        return Ok(false);
+    }
+    let covered: Option<i64> = c
+        .query_row("SELECT source FROM retrieval_scoped_coverage WHERE index_id=?1 AND epoch=?2 AND project=?3 AND generation=?4 AND status='ready' AND kind=?5 AND sessions_epoch=(SELECT epoch FROM retrieval_project_catalog WHERE source='sessions') AND summaries_epoch=(SELECT epoch FROM retrieval_project_catalog WHERE source='summaries')",params![index,epoch,project,generation,if observation{0}else{3}],|row|row.get(0))
+        .optional()?;
+    if observation {
+        if let Some(source) = covered {
+            return Ok(source >= 2
+                || (source == 1 && !project_catalog::summary_authority_ready(c)?));
+        }
+    }
+    if covered.is_some()
+        && source::status(c, index)?["coverage_ready"] == true
+        && super::project_vectors::ready(c, index, epoch)?
+    {
+        return Ok(true);
+    }
+    let meta: Option<(String, i64)> = c
+        .query_row(
+            "SELECT status,unknown FROM retrieval_scoped_meta WHERE index_id=?1 AND epoch=?2",
+            params![index, epoch],
+            |r| Ok((r.get(0)?, r.get(1)?)),
+        )
+        .optional()?;
+    if !meta.is_some_and(|(status, unknown)| status == "ready" && unknown == 0) {
+        return Ok(false);
+    }
+    let meta = semantic::get(c, index)?;
+    if meta.status != "ready" || meta.revision != database::revision(c, &meta.scope())?.to_string()
+    {
+        return Ok(false);
+    }
+    match source::ready(c, index) {
+        Ok(()) => Ok(true),
+        Err(error)
+            if error
+                .downcast_ref::<protocol::TxError>()
+                .is_some_and(|e| e.0 == "STATE_SEMANTIC_SOURCE_NOT_READY") =>
+        {
+            Ok(false)
+        }
+        Err(error) => Err(error),
+    }
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/scoped/pending.rs b/engine/src/workers/state/adapters/sqlite/retrieval/scoped/pending.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/scoped/pending.rs
@@ -0,0 +1,137 @@
+use super::*;
+pub fn source_changed(
+    c: &Connection,
+    index: &str,
+    scope: &str,
+    id: &str,
+    dirty: bool,
+) -> anyhow::Result<()> {
+    let Some(session) = scope.strip_prefix("mem:obs:") else {
+        return Ok(());
+    };
+    let member = membership::get(c, session)?;
+    if dirty {
+        c.execute("INSERT INTO retrieval_scoped_dirty VALUES(?1,?2,?3,?4) ON CONFLICT(index_id,session,id) DO UPDATE SET project=excluded.project",params![index,member.token,id,member.project.unwrap_or(0)])?;
+    } else {
+        c.execute(
+            "DELETE FROM retrieval_scoped_dirty WHERE index_id=?1 AND session=?2 AND id=?3",
+            params![index, member.token, id],
+        )?;
+    }
+    Ok(())
+}
+pub fn source_removed(c: &Connection, index: &str, scope: &str, id: &str) -> anyhow::Result<()> {
+    if let Some(session) = scope.strip_prefix("mem:obs:") {
+        if let Some(session) = session_token(c, session)? {
+            c.execute(
+                "DELETE FROM retrieval_scoped_dirty WHERE index_id=?1 AND session=?2 AND id=?3",
+                params![index, session, id],
+            )?;
+        }
+    }
+    Ok(())
+}
+pub fn has(c: &Connection, index: &str, project: i64, kind: i64) -> anyhow::Result<bool> {
+    let dirty:bool=c.query_row("SELECT EXISTS(SELECT 1 FROM retrieval_scoped_dirty INDEXED BY retrieval_scoped_dirty_project WHERE index_id=?1 AND project=?2)",params![index,project],|r|r.get(0))?;
+    if dirty {
+        return Ok(true);
+    }
+    c.query_row("SELECT EXISTS(SELECT 1 FROM retrieval_scoped_affected INDEXED BY retrieval_scoped_affected_project WHERE index_id=?1 AND project=?2 AND kind=?3)",params![index,project,kind],|r|r.get(0)).map_err(Into::into)
+}
+pub fn drain(
+    c: &Connection,
+    meta: &semantic::Meta,
+    project: i64,
+    kind: i64,
+    processed: &mut usize,
+    visits: &mut usize,
+    bytes: &mut usize,
+    max_rows: usize,
+    max_bytes: usize,
+    sessions_only: bool,
+) -> anyhow::Result<bool> {
+    while *processed < max_rows && *visits < 16 {
+        let next:Option<(i64,String,i64,String,String)>=c.query_row("SELECT w.session,s.name,w.position,w.cursor,w.status FROM retrieval_scoped_affected a INDEXED BY retrieval_scoped_affected_project JOIN retrieval_scoped_work w ON w.index_id=a.index_id AND w.session=a.session AND w.kind=a.kind JOIN retrieval_scoped_sessions s ON s.token=w.session WHERE a.index_id=?1 AND a.project=?2 AND a.kind=?3 ORDER BY a.session LIMIT 1",params![meta.index_id,project,kind],|r|Ok((r.get(0)?,r.get(1)?,r.get(2)?,r.get(3)?,r.get(4)?))).optional()?;
+        let Some((token, session, mut position, mut cursor, status)) = next else {
+            break;
+        };
+        *visits += 1;
+        if sessions_only && !project_catalog::session_is_authoritative_for_project(c, &session, project)? {
+            return Ok(true);
+        }
+        if status == "ready" {
+            c.execute("DELETE FROM retrieval_scoped_affected WHERE index_id=?1 AND session=?2 AND kind=?3 AND project=?4",params![meta.index_id,token,kind,project])?;
+            continue;
+        }
+        loop {
+            if *processed >= max_rows {
+                return Ok(false);
+            }
+            let next: Option<(String, i64, String, i64)> = if kind == 0 {
+                c.query_row("SELECT key,position,version,value_bytes FROM state_values WHERE scope=?1 AND live=1 AND position>?2 ORDER BY position LIMIT 1",params![format!("mem:obs:{session}"),position],|r|Ok((r.get(0)?,r.get(1)?,r.get(2)?,r.get(3)?))).optional()?
+            } else {
+                c.query_row("SELECT id,0,'',0 FROM retrieval_project_vectors INDEXED BY retrieval_project_vectors_session WHERE session_id=?1 AND index_id=?2 AND epoch=?3 AND id>?4 ORDER BY id LIMIT 1",params![session,meta.index_id,meta.epoch,cursor],|r|Ok((r.get(0)?,r.get(1)?,r.get(2)?,r.get(3)?))).optional()?
+            };
+            let Some((id, next_position, version, logical)) = next else {
+                if kind == 3 && !super::super::project_vectors::ready(c, &meta.index_id, meta.epoch)? {
+                    return Ok(false);
+                }
+                c.execute("UPDATE retrieval_scoped_work SET status='ready' WHERE index_id=?1 AND session=?2 AND kind=?3",params![meta.index_id,token,kind])?;
+                break;
+            };
+            match projection::project_row(
+                c,
+                meta,
+                &session,
+                &id,
+                &version,
+                logical,
+                kind == 0,
+                *processed,
+                *bytes,
+                max_bytes,
+            )? {
+                projection::RowResult::Blocked => return Ok(true),
+                projection::RowResult::Budget => return Ok(false),
+                projection::RowResult::Done(needed) => {
+                    *bytes += needed;
+                    *processed += 1;
+                }
+            }
+            position = next_position;
+            cursor = id;
+            c.execute("UPDATE retrieval_scoped_work SET position=?4,cursor=?5 WHERE index_id=?1 AND session=?2 AND kind=?3",params![meta.index_id,token,kind,position,cursor])?;
+            if logical > 65_536 {
+                return Ok(false);
+            }
+        }
+    }
+    // Exact dirty keys survive root completion and never force rewalking covered rows.
+    while *processed < max_rows {
+        let next:Option<(i64,String,String)>=c.query_row("SELECT d.session,s.name,d.id FROM retrieval_scoped_dirty d INDEXED BY retrieval_scoped_dirty_project JOIN retrieval_scoped_sessions s ON s.token=d.session WHERE d.index_id=?1 AND d.project=?2 ORDER BY d.session,d.id LIMIT 1",params![meta.index_id,project],|r|Ok((r.get(0)?,r.get(1)?,r.get(2)?))).optional()?;
+        let Some((token, session, id)) = next else {
+            break;
+        };
+        if sessions_only && !project_catalog::session_is_authoritative_for_project(c, &session, project)? {
+            return Ok(true);
+        }
+        let scope = format!("mem:obs:{session}");
+        let row:Option<(String,i64)>=c.query_row("SELECT version,value_bytes FROM state_values WHERE scope=?1 AND key=?2 AND live=1",params![scope,id],|r|Ok((r.get(0)?,r.get(1)?))).optional()?;
+        if let Some((version, logical)) = row {
+            match projection::project_row(
+                c, meta, &session, &id, &version, logical, true, *processed, *bytes,
+                max_bytes,
+            )? {
+                projection::RowResult::Blocked => return Ok(true),
+                projection::RowResult::Budget => return Ok(false),
+                projection::RowResult::Done(needed) => *bytes += needed,
+            }
+        }
+        c.execute(
+            "DELETE FROM retrieval_scoped_dirty WHERE index_id=?1 AND session=?2 AND id=?3",
+            params![meta.index_id, token, id],
+        )?;
+        *processed += 1;
+    }
+    Ok(false)
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/scoped/prepare.rs b/engine/src/workers/state/adapters/sqlite/retrieval/scoped/prepare.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/scoped/prepare.rs
@@ -0,0 +1,344 @@
+use super::*;
+use sha2::{Digest, Sha256};
+struct Cursor {
+    source: i64,
+    session: String,
+    key: String,
+    active: String,
+    position: i64,
+    vector: String,
+}
+fn cursor(
+    c: &Connection,
+    index: &str,
+    epoch: i64,
+    project: i64,
+    kind: i64,
+) -> anyhow::Result<Cursor> {
+    c.query_row("SELECT source,session_cursor,key_cursor,active_session,position,vector_cursor FROM retrieval_scoped_coverage WHERE index_id=?1 AND epoch=?2 AND project=?3 AND kind=?4",params![index,epoch,project,kind],|r|Ok(Cursor{source:r.get(0)?,session:r.get(1)?,key:r.get(2)?,active:r.get(3)?,position:r.get(4)?,vector:r.get(5)?})).map_err(Into::into)
+}
+
+pub fn status(c: &Connection, index: &str, project: &str, observation: bool) -> anyhow::Result<Value> {
+    let meta = semantic::get(c,index)?;
+    let kind = if observation {0} else {3};
+    let Some(project_id) = membership::project_token(c,project)? else {
+        return Ok(json!({"target":"project_vector","index_id":index,"project":project,
+            "status":"pending","ready":false,"checkpoint":null,"coverage_epoch":meta.epoch.to_string(),
+            "project_generation":null,"dirty":0,"pending":0,"reason":"project_not_prepared"}));
+    };
+    let generation = generation(c,project_id)?;
+    let saved: Option<(String,i64,i64,i64)> = c.query_row(
+        "SELECT status,generation,sessions_epoch,summaries_epoch FROM retrieval_scoped_coverage WHERE index_id=?1 AND epoch=?2 AND project=?3 AND kind=?4",
+        params![index,meta.epoch,project_id,kind],|r|Ok((r.get(0)?,r.get(1)?,r.get(2)?,r.get(3)?))).optional()?;
+    let dirty:i64=c.query_row("SELECT count(*) FROM retrieval_scoped_dirty INDEXED BY retrieval_scoped_dirty_project WHERE index_id=?1 AND project=?2",params![index,project_id],|r|r.get(0))?;
+    let pending:i64=c.query_row("SELECT count(*) FROM retrieval_scoped_affected INDEXED BY retrieval_scoped_affected_project WHERE index_id=?1 AND project=?2 AND kind=?3",params![index,project_id,kind],|r|r.get(0))?;
+    let mut checkpoint = None;
+    if let Some((_,saved_generation,sessions,summaries))=&saved {
+        let state=cursor(c,index,meta.epoch,project_id,kind)?;
+        checkpoint=Some(hex::encode(Sha256::digest(serde_json::to_vec(&(index,meta.epoch,project_id,kind,saved_generation,sessions,summaries,dirty,pending,
+            state.source,&state.session,&state.key,&state.active,state.position,&state.vector))?)));
+    }
+    let ready = super::ready(c,index,meta.epoch,project,observation)?
+        && super::super::project_vectors::ready(c,index,meta.epoch)?
+        && source::status(c,index)?["coverage_ready"]==true;
+    let saved_status=saved.as_ref().map(|row|row.0.as_str()).unwrap_or("pending");
+    Ok(json!({"target":"project_vector","index_id":index,"project":project,
+        "source_kind":if observation{Some("observation")}else{None},"status":if ready{"ready"}else if saved_status=="ready"{"pending"}else{saved_status},
+        "ready":ready,"checkpoint":checkpoint,"coverage_epoch":meta.epoch.to_string(),
+        "project_generation":generation.to_string(),"dirty":dirty,"pending":pending,"has_more":!ready}))
+}
+fn save(
+    c: &Connection,
+    index: &str,
+    epoch: i64,
+    project: i64,
+    kind: i64,
+    state: &Cursor,
+    status: &str,
+) -> anyhow::Result<()> {
+    c.execute("UPDATE retrieval_scoped_coverage SET status=?5,source=?6,session_cursor=?7,key_cursor=?8,active_session=?9,position=?10,vector_cursor=?11 WHERE index_id=?1 AND epoch=?2 AND project=?3 AND kind=?4",params![index,epoch,project,kind,status,state.source,state.session,state.key,state.active,state.position,state.vector])?;
+    Ok(())
+}
+fn response(
+    index: &str,
+    project: &str,
+    epoch: i64,
+    generation: i64,
+    kind: i64,
+    state: &Cursor,
+    status: &str,
+    reason: Option<&str>,
+    processed: usize,
+    visits: usize,
+    bytes: usize,
+) -> Value {
+    let cursor = hex::encode(Sha256::digest(
+        serde_json::to_vec(&(
+            state.source,
+            &state.session,
+            &state.key,
+            &state.active,
+            state.position,
+            &state.vector,
+        ))
+        .unwrap(),
+    ));
+    json!({"status":status,"index_id":index,"project":project,"source_kind":if kind==0{Some("observation")}else{None},"processed":processed,"session_visits":visits,"text_bytes":bytes,"cursor":cursor,"coverage_epoch":epoch.to_string(),"project_generation":generation.to_string(),"has_more":status!="ready","reason":reason})
+}
+use super::projection::{RowResult, project_row};
+pub fn prepare(
+    c: &Connection,
+    index: &str,
+    project: &str,
+    observation: bool,
+    max_rows: usize,
+    max_bytes: usize,
+) -> anyhow::Result<Value> {
+    protocol::require((1..=16).contains(&max_rows) && (1024..=65_536).contains(&max_bytes))?;
+    prepare_inner(c,index,project,observation,max_rows,max_bytes,false)
+}
+
+pub fn prepare_browse(c: &Connection, index: &str, project: &str, max_rows: usize, max_bytes: usize) -> anyhow::Result<Value> {
+    protocol::require((1..=1024).contains(&max_rows) && (1024..=super::super::request::MAX_GRAPH_PREPARATION_WORK_BYTES).contains(&max_bytes))?;
+    prepare_inner(c,index,project,true,max_rows,max_bytes,true)
+}
+
+fn prepare_inner(c: &Connection, index: &str, project: &str, observation: bool, max_rows: usize, max_bytes: usize, browse: bool) -> anyhow::Result<Value> {
+    let meta = semantic::get(c, index)?;
+    ensure(c, index, meta.epoch)?;
+    let project_id = membership::project(c, project)?;
+    let generation = generation(c, project_id)?;
+    let kind = if observation { 0 } else { 3 };
+    let sessions: i64 = c.query_row(
+        "SELECT epoch FROM retrieval_project_catalog WHERE source='sessions'",
+        [],
+        |r| r.get(0),
+    )?;
+    let summaries: i64 = c.query_row(
+        "SELECT epoch FROM retrieval_project_catalog WHERE source='summaries'",
+        [],
+        |r| r.get(0),
+    )?;
+    // Maintained writes enqueue exact deltas; moves do not rewind covered peers.
+    c.execute("INSERT INTO retrieval_scoped_coverage VALUES(?1,?2,?3,?4,?5,'pending',0,'','','',-1,'',?6,?7) ON CONFLICT(index_id,epoch,project,kind) DO UPDATE SET generation=excluded.generation,status='pending',source=CASE WHEN sessions_epoch<>excluded.sessions_epoch OR summaries_epoch<>excluded.summaries_epoch THEN 0 ELSE source END,session_cursor=CASE WHEN sessions_epoch<>excluded.sessions_epoch OR summaries_epoch<>excluded.summaries_epoch THEN '' ELSE session_cursor END,key_cursor=CASE WHEN sessions_epoch<>excluded.sessions_epoch OR summaries_epoch<>excluded.summaries_epoch THEN '' ELSE key_cursor END,active_session=CASE WHEN sessions_epoch<>excluded.sessions_epoch OR summaries_epoch<>excluded.summaries_epoch THEN '' ELSE active_session END,position=CASE WHEN sessions_epoch<>excluded.sessions_epoch OR summaries_epoch<>excluded.summaries_epoch THEN -1 ELSE position END,vector_cursor=CASE WHEN sessions_epoch<>excluded.sessions_epoch OR summaries_epoch<>excluded.summaries_epoch THEN '' ELSE vector_cursor END,sessions_epoch=excluded.sessions_epoch,summaries_epoch=excluded.summaries_epoch WHERE generation<>excluded.generation OR sessions_epoch<>excluded.sessions_epoch OR summaries_epoch<>excluded.summaries_epoch",params![index,meta.epoch,project_id,kind,generation,sessions,summaries])?;
+    let mut state = cursor(c, index, meta.epoch, project_id, kind)?;
+    let authority_incomplete = project_catalog::has_incomplete_authority(c)?;
+    let mapping_ready = super::super::project_vectors::ready(c, index, meta.epoch)?;
+    let source_ready = source::status(c, index)?["coverage_ready"] == true;
+    if observation {
+        protocol::require(source::kind(c, index)?.is_some())?;
+    }
+    let mut processed = 0;
+    let mut visits = 0;
+    let mut bytes = 0;
+    let mut blocked_reason = None;
+    let mut blocked = pending::drain(
+        c,
+        &meta,
+        project_id,
+        kind,
+        &mut processed,
+        &mut visits,
+        &mut bytes,
+        max_rows,
+        max_bytes,
+        false,
+    )?;
+    if blocked {
+        blocked_reason = Some("project_source_not_ready");
+    }
+    while !blocked && processed < max_rows && visits < 16 && bytes < max_bytes && state.source < 2 {
+        if !state.active.is_empty() {
+            let (authority, read_bytes) = project_catalog::resolve_session_bounded(
+                c,
+                &state.active,
+                max_bytes.saturating_sub(bytes),
+            )?;
+            if authority == Err("budget") {
+                blocked = true;
+                blocked_reason = Some("project_projection_pending");
+                break;
+            }
+            bytes = bytes.saturating_add(read_bytes);
+            match authority {
+                Ok(owner) if owner == project => {}
+                Ok(_) => {
+                    state.active.clear();
+                    state.position = -1;
+                    state.vector.clear();
+                    continue;
+                }
+                Err("stale") => {
+                    state.active.clear();
+                    state.position = -1;
+                    state.vector.clear();
+                    continue;
+                }
+                Err("audience_unknown") if !authority_incomplete && project_catalog::session_has_current_exclusion(c,&state.active)? => {
+                    state.active.clear();
+                    state.position = -1;
+                    state.vector.clear();
+                    continue;
+                }
+                Err(_) => {
+                    blocked = true;
+                    blocked_reason = Some("catalog_not_ready");
+                    break;
+                }
+            }
+        }
+        if state.active.is_empty() {
+            let source_name = if state.source == 0 { "sessions" } else { "summaries" };
+            let source_epoch = if state.source == 0 { sessions } else { summaries };
+            let next: Option<(String, String)> = c.query_row(
+                "SELECT session_id,source_key FROM retrieval_project_refs INDEXED BY retrieval_project_refs_project WHERE source=?1 AND epoch=?2 AND project=?3 AND (session_id,source_key)>(?4,?5) ORDER BY session_id,source_key LIMIT 1",
+                params![source_name, source_epoch, project, state.session, state.key],
+                |row| Ok((row.get(0)?, row.get(1)?)),
+            ).optional()?;
+            let Some((session, key)) = next else {
+                state.source += 1;
+                state.session.clear();
+                state.key.clear();
+                continue;
+            };
+            visits += 1;
+            let (authority, read_bytes) = project_catalog::resolve_session_bounded(
+                c,
+                &session,
+                max_bytes.saturating_sub(bytes),
+            )?;
+            if authority == Err("budget") {
+                blocked = true;
+                blocked_reason = Some("project_projection_pending");
+                break;
+            }
+            bytes = bytes.saturating_add(read_bytes);
+            let authoritative = match authority {
+                Ok(owner) => owner,
+                Err("stale") => {
+                    state.session = session;
+                    state.key = key;
+                    continue;
+                }
+                Err("audience_unknown") if !authority_incomplete && project_catalog::session_has_current_exclusion(c,&session)? => {
+                    state.session = session;
+                    state.key = key;
+                    continue;
+                }
+                Err(_) => {
+                    blocked = true;
+                    blocked_reason = Some("catalog_not_ready");
+                    break;
+                }
+            };
+            state.session = session.clone();
+            state.key = key.clone();
+            if authoritative != project {
+                continue;
+            }
+            let has_session: bool = c.query_row(
+                "SELECT EXISTS(SELECT 1 FROM state_values WHERE scope='mem:sessions' AND key=?1 AND live=1)",
+                [&session],
+                |row| row.get(0),
+            )?;
+            if state.source == 1 && (has_session || key != session) {
+                continue;
+            }
+            state.active = session;
+            state.position = -1;
+            state.vector.clear();
+        }
+        let next: Option<(String, i64, String, i64)> = if observation {
+            c.query_row(
+                "SELECT key,position,version,value_bytes FROM state_values WHERE scope=?1 AND live=1 AND position>?2 ORDER BY position LIMIT 1",
+                params![format!("mem:obs:{}", state.active), state.position],
+                |row| Ok((row.get(0)?, row.get(1)?, row.get(2)?, row.get(3)?)),
+            ).optional()?
+        } else {
+            c.query_row(
+                "SELECT id,0,'',0 FROM retrieval_project_vectors INDEXED BY retrieval_project_vectors_session WHERE session_id=?1 AND index_id=?2 AND epoch=?3 AND id>?4 ORDER BY id LIMIT 1",
+                params![state.active, index, meta.epoch, state.vector],
+                |row| Ok((row.get(0)?, row.get(1)?, row.get(2)?, row.get(3)?)),
+            ).optional()?
+        };
+        let Some((id, position, version, logical)) = next else {
+            if !observation && !mapping_ready {
+                blocked = true;
+                blocked_reason = Some("project_mapping_not_ready");
+                break;
+            }
+            state.active.clear();
+            state.position = -1;
+            state.vector.clear();
+            continue;
+        };
+        match project_row(
+            c,
+            &meta,
+            &state.active,
+            &id,
+            &version,
+            logical,
+            observation,
+            processed,
+            bytes,
+            max_bytes,
+        )? {
+            RowResult::Blocked => {
+                blocked = true;
+                blocked_reason = Some("project_source_not_ready");
+                break;
+            }
+            RowResult::Budget => break,
+            RowResult::Done(needed) => bytes = bytes.saturating_add(needed),
+        }
+        state.position = position;
+        state.vector = id;
+        processed += 1;
+        if !browse && logical > 65_536 {
+            blocked = true;
+            blocked_reason = Some("project_source_not_ready");
+            break;
+        }
+    }
+    let selected_complete = state.source >= 2 && !pending::has(c, index, project_id, kind)?;
+    let status = if blocked || authority_incomplete || !mapping_ready || !source_ready {
+        "partial"
+    } else if selected_complete {
+        "ready"
+    } else {
+        "pending"
+    };
+    save(c, index, meta.epoch, project_id, kind, &state, status)?;
+    if status == "ready" && processed < max_rows {
+        processed += background::gc(c, index, meta.epoch, max_rows - processed)?;
+    }
+    let reason = blocked_reason.or_else(|| {
+        if authority_incomplete {
+            Some("catalog_not_ready")
+        } else if !mapping_ready {
+            Some("project_mapping_not_ready")
+        } else if !source_ready {
+            Some("project_source_not_ready")
+        } else if status == "pending" {
+            Some("project_projection_pending")
+        } else {
+            None
+        }
+    });
+    let mut output=response(
+        index,
+        project,
+        meta.epoch,
+        generation,
+        kind,
+        &state,
+        status,
+        reason,
+        processed,
+        visits,
+        bytes,
+    );
+    output["preparation"]=self::status(c,index,project,observation)?;
+    Ok(output)
+}
