+                [],
+            )?;
+            Ok(())
+        })
+        .await
+        .unwrap();
+    assert!(matches!(adapter.list_page("metadata", None, 1, 1024).await,
+        Err(StatePageError::RecordTooLarge { required_bytes }) if required_bytes > 1201));
+    adapter.run(4096, |connection| {
+        connection.execute("UPDATE state_rows SET value=NULL,position=NULL,value_bytes=0 WHERE scope='metadata'", [])?;
+        Ok(())
+    }).await.unwrap();
+    assert!(
+        adapter
+            .list_page("metadata", None, 1, 1024)
+            .await
+            .unwrap()
