+            assert!(prune(&transaction,vec![first,invalid],4096).is_err());
+        }
+        for key in ["a","b"] { assert!(database::row(&connection,"mem:audit",key).unwrap().value.is_some()); }
+    }
+}
diff --git a/engine/src/workers/state/adapters/sqlite/storage_reclaim.rs b/engine/src/workers/state/adapters/sqlite/storage_reclaim.rs
new file mode 100644
index 0000000..78184bb
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/storage_reclaim.rs
@@ -0,0 +1,168 @@
+use super::{protocol::{error, require}, storage_diagnostics};
+use rusqlite::Connection;
+use serde_json::{Value, json};
+use std::{path::Path, time::{Duration, Instant}};
+
+const WAL_LIMIT: u64 = 16 * 1024 * 1024;
+const COOLDOWN: Duration = Duration::from_secs(5);
+
+pub struct Schedule {
+    last_cut: Option<Instant>,
+    pages: u32,
+}
+impl Default for Schedule {
+    fn default() -> Self { Self {last_cut: None, pages: 1} }
+}
+
+// The serialized worker owns this temporary handler. Restore on every exit path,
+// including unwinding; ordinary operations retain their existing timeout policy.
+struct Settings<'a> {
+    connection: &'a Connection,
+    busy_ms: u64,
+    restored: bool,
+}
+impl<'a> Settings<'a> {
+    fn begin(connection: &'a Connection, started: Instant, budget: Duration) -> anyhow::Result<Self> {
+        let busy_ms: i64 = connection.pragma_query_value(None, "busy_timeout", |row| row.get(0))?;
+        let busy_ms = u64::try_from(busy_ms)?;
+        let guard = Self {connection, busy_ms, restored: false};
+        connection.busy_timeout(Duration::from_millis(1))?;
+        connection.progress_handler(100, Some(move || started.elapsed() >= budget))?;
+        Ok(guard)
+    }
+    fn restore(&mut self) -> anyhow::Result<()> {
+        let progress = self.connection.progress_handler(0, None::<fn() -> bool>);
+        let busy = self.connection.busy_timeout(Duration::from_millis(self.busy_ms));
+        progress?;
+        busy?;
+        self.restored = true;
+        Ok(())
+    }
+}
+impl Drop for Settings<'_> {
+    fn drop(&mut self) {
+        if !self.restored {
+            if let Err(cause) = self.restore() {
+                tracing::error!(error = %cause, "state SQLite maintenance settings restore failed");
+            }
+        }
+    }
+}
+
+pub fn physical(connection: &Connection, path: &Path) -> anyhow::Result<Value> {
+    let mut result = storage_diagnostics::physical(connection, path)?;
+    result["sampled_at"] = json!(chrono::Utc::now().to_rfc3339_opts(chrono::SecondsFormat::Millis,true));
+    result["consistency"] = json!("physical_live");
+    Ok(result)
+}
+fn number(value: &Value, key: &str) -> u64 { value[key].as_u64().unwrap_or(0) }
+fn response(before: Value, after: Value, started: Instant, status: &str, reason: &str) -> Value {
+    let mode = number(&before, "auto_vacuum");
+    let pages = number(&before, "page_count").saturating_sub(number(&after, "page_count"));
+    let physical = number(&before, "database_bytes").saturating_sub(number(&after, "database_bytes"));
+    json!({"mode":if mode == 2 {"incremental"} else {"checkpoint_only"},
+        "requires_explicit_full_rebuild":mode == 0,"checkpoint_busy":false,
+        "wal_frames":0,"checkpointed_frames":0,"checkpoint_performed":false,
+        "status":status,"reason":reason,"elapsed_ms":started.elapsed().as_millis() as u64,
+        "pages_reclaimed":pages,"physical_bytes_reclaimed":physical,
+        "before":before,"after":after})
+}
+fn interrupted(cause: &rusqlite::Error) -> bool {
+    matches!(cause, rusqlite::Error::SqliteFailure(code, _)
+        if code.code == rusqlite::ErrorCode::OperationInterrupted)
+}
+fn busy(cause: &rusqlite::Error) -> bool {
+    matches!(cause, rusqlite::Error::SqliteFailure(code, _)
+        if matches!(code.code, rusqlite::ErrorCode::DatabaseBusy | rusqlite::ErrorCode::DatabaseLocked))
+}
+
+pub fn cut(connection: &Connection, path: &Path, schedule: &mut Schedule,
+    max_pages: u32, max_ms: u64, reserved: bool, pressure: impl Fn() -> bool,
+    lease_owner_id: &str, lease_fence: u64) -> anyhow::Result<Value> {
+    require((1..=16).contains(&max_pages) && (1..=25).contains(&max_ms)
+        && super::storage_maintenance_lease::valid_owner(lease_owner_id) && lease_fence > 0)?;
+    let started = Instant::now();
+    let budget = Duration::from_millis(max_ms);
+    let mut settings = Settings::begin(connection, started, budget)?;
+    if let Err(cause) = super::storage_maintenance_lease::validate_current(connection, lease_owner_id, lease_fence) {
+        let reason = if cause.downcast_ref::<rusqlite::Error>().is_some_and(busy) { Some("sqlite_busy") }
+            else if cause.downcast_ref::<rusqlite::Error>().is_some_and(interrupted) { Some("time_budget") }
+            else { None };
+        settings.restore()?;
+        if let Some(reason) = reason {
+            let before = physical(connection, path)?;
+            return Ok(response(before.clone(), before, started, "deferred", reason));
+        }
+        return Err(cause);
+    }
+    let before = physical(connection, path)?;
+    let defer = if number(&before, "auto_vacuum") == 0 { Some(("migration_required", "auto_vacuum_none")) }
+        else if number(&before, "auto_vacuum") != 2 { Some(("deferred", "auto_vacuum_not_incremental")) }
+        else if !reserved { Some(("deferred", "reclaim_in_flight")) }
+        else if pressure() { Some(("deferred", "foreground_pressure")) }
+        else if schedule.last_cut.is_some_and(|last| last.elapsed() < COOLDOWN) { Some(("deferred", "cooldown")) }
+        else if number(&before, "wal_bytes") > WAL_LIMIT { Some(("deferred", "wal_pressure")) }
+        else if number(&before, "freelist_count") == 0 { Some(("complete", "no_free_pages")) }
+        else { None };
+    if let Some((status, reason)) = defer {
+        settings.restore()?;
+        return Ok(response(before.clone(), before, started, status, reason));
+    }
+    let pages = schedule.pages.min(max_pages).clamp(1,16);
+    schedule.last_cut = Some(Instant::now());
+    let mut reason = "page_cut_complete";
+    let mut completed = 0;
+    let mut failure = None;
+    for _ in 0..pages {
+        if started.elapsed() >= budget { reason = "time_budget"; break; }
+        if pressure() { reason = "foreground_pressure"; break; }
+        let current = storage_diagnostics::physical(connection, path)?;
+        if number(&current, "wal_bytes") > WAL_LIMIT { reason = "wal_pressure"; break; }
+        if number(&current, "freelist_count") == 0 { reason = "no_free_pages"; break; }
+        match super::storage_maintenance_lease::reclaim_page(connection, lease_owner_id, lease_fence) {
+            Ok(()) => completed += 1,
+            Err(cause) if cause.downcast_ref::<rusqlite::Error>().is_some_and(interrupted) => { reason = "time_budget"; break; }
+            Err(cause) if cause.downcast_ref::<rusqlite::Error>().is_some_and(busy) => { reason = "sqlite_busy"; break; }
+            Err(cause) => { failure = Some(cause); break; }
+        }
+    }
+    settings.restore()?;
+    if let Some(cause) = failure { return Err(cause.into()); }
+    let after = physical(connection, path)?;
+    schedule.pages = if completed == pages && started.elapsed() < budget / 2 {
+        pages.saturating_mul(2).min(16)
+    } else { (pages / 2).max(1) };
+    let status = if number(&after, "freelist_count") == 0 { "complete" }
+        else if number(&before, "page_count") > number(&after, "page_count") { "progress" }
+        else { "deferred" };
+    let mut result = response(before, after, started, status, reason);
+    result["next_max_pages"] = json!(schedule.pages);
+    result["min_interval_ms"] = json!(COOLDOWN.as_millis() as u64);
+    Ok(result)
+}
+
+// Explicit maintenance-window operation only. VACUUM is an atomic SQLite rebuild;
+// it blocks this worker and requires temporary disk space proportional to the DB.
+pub fn migrate(connection: &Connection, path: &Path, allow_blocking: bool, max_ms: u64) -> anyhow::Result<Value> {
+    require(allow_blocking && (1..=86_400_000).contains(&max_ms))?;
+    let started = Instant::now();
+    let before = physical(connection, path)?;
+    let prior = number(&before, "auto_vacuum");
+    if prior == 2 { return Ok(json!({"status":"complete","reason":"already_incremental","before":before,"after":before,"elapsed_ms":0})); }
+    require(connection.is_autocommit())?;
+    let mut settings = Settings::begin(connection, started, Duration::from_millis(max_ms))?;
+    let outcome = (|| -> anyhow::Result<()> {
+        connection.execute_batch("PRAGMA auto_vacuum=INCREMENTAL")?;
+        if prior == 0 { connection.execute_batch("VACUUM")?; }
+        Ok(())
+    })();
+    settings.restore()?;
+    if let Err(cause) = outcome {
+        connection.pragma_update(None, "auto_vacuum", i64::try_from(prior)?)?;
+        return Err(cause.context("STATE_STORAGE_MIGRATION_FAILED: inspect current physical mode before retry; no migration progress offset is persisted"));
+    }
+    let after = physical(connection, path)?;
+    if number(&after, "auto_vacuum") != 2 { return Err(error("STATE_STORAGE_MIGRATION_FAILED")); }
+    Ok(json!({"status":"complete","reason":"incremental_enabled","before":before,"after":after,
+        "elapsed_ms":started.elapsed().as_millis() as u64,"blocking_rebuild":prior == 0}))
+}
