+    Ok(Outcome::Adopted)
+}
+
+pub(super) fn prepare_child(c:&Connection,anchor:&Anchor,job:&Value,token:&str,now:i64,trusted:Option<&authority::Trusted>)->anyhow::Result<Option<String>> {
+    let reservation:Option<(String,String,i64,Option<String>)>=c.query_row("SELECT root_id,regeneration_id,deadline_ms,claimed_slot_id FROM engine_graph_auto_regenerations WHERE new_job_id=?1",[&anchor.job_id],|r|Ok((r.get(0)?,r.get(1)?,r.get(2)?,r.get(3)?))).optional()?;
+    let Some((root,current,deadline,claimed))=reservation else {return Ok(None);};
+    if claimed.is_some() || deadline>now {return Ok(None);}
+    need(current==token,"STATE_GRAPH_AUTOMATIC_ADOPTION_EPOCH_CONFLICT")?;
+    let mut parent=store::slot(c,&root)?.ok_or_else(||error("STATE_GRAPH_AUTOMATIC_SLOT_MISSING"))?.anchor;
+    parent.guard=anchor.guard.clone();
+    let parent_job=database::row(c,protocol::JOBS,&parent.job_id)?;
+    let point=database::row(c,database::CHECKPOINT_SCOPE,&parent.job_id)?;
+    parent.job_version=parent_job.version.to_string();parent.checkpoint_version=point.version.to_string();
+    let parent_job=parent_job.value.ok_or_else(||error("STATE_GRAPH_AUTOMATIC_JOB_MISSING"))?;
+    let checkpoint:protocol::Checkpoint=protocol::decode(point.value.ok_or_else(||error("STATE_TX_CHECKPOINT_CONFLICT"))?)?;
+    let current=TerminalAnchor {guard:anchor.guard.clone(),job_id:parent.job_id.clone(),job_version:parent.job_version.clone(),checkpoint_version:parent.checkpoint_version.clone()};
+    let (parent,proof,_)=terminal::derive(c,&current,&parent_job,&checkpoint)?;
+    store::reconcile(c,now,Some(&root))?;
+    let retained:String=c.query_row("SELECT proof_json FROM engine_graph_auto_terminal_sources WHERE root_id=?1 AND local_value_digest IS NULL",[&root],|r|r.get(0))?;
+    let retained=protocol::strict_value(&retained)?;
+    need(["capture","source_digest","selection","progress","pages","reference"].iter().all(|key|retained[*key]==proof[*key]),"STATE_GRAPH_AUTOMATIC_SOURCE_CHANGED")?;
+    let proven=child::prove(c,&parent,&proof,&anchor.job_id,token,Some(anchor))?;
+    need(&proven["job"]==job,"STATE_TX_CONFLICT")?;
+    let attempt=store::attempt(c,&format!("{root}:1"))?.ok_or_else(||error("STATE_GRAPH_AUTOMATIC_ATTEMPT_MISSING"))?;
+    let parts:bool=c.query_row("SELECT EXISTS(SELECT 1 FROM engine_graph_auto_parts WHERE attempt_id=?1)",[&attempt.id],|r|r.get(0))?;
+    need(attempt.slot==root && attempt.ordinal==1 && attempt.state=="expired" && !attempt.consumed
+        && attempt.reason.as_deref()==Some("GRAPH_AUTOMATIC_PREPARED_DEADLINE") && attempt.deadline==deadline
+        && attempt.parts.is_none() && attempt.bytes.is_none() && attempt.digest.is_none() && !parts,"STATE_GRAPH_AUTOMATIC_UNSPENT_CHILD_UNPROVEN")?;
+    let (authority_id,_)=trusted.ok_or_else(||error("STATE_GRAPH_AUTOMATIC_AUTHORITY_UNAVAILABLE"))?.authorize_terminal(c,&parent,&parent_job)?;
+    prepare(c,&root,token,&authority_id)?;
+    if wait(c,now)?.is_some() {return Err(error("STATE_GRAPH_AUTOMATIC_UNSPENT_PREPARE_WAIT_V1"));}
+    let new_deadline=now.checked_add(120_000).filter(|value|*value<=9_007_199_254_740_991).ok_or_else(||error("STATE_GRAPH_AUTOMATIC_CLOCK_INVALID"))?;
+    let epoch=latest(c,&root)?.map_or(0,|record|record.0);
+    c.execute("INSERT INTO engine_graph_auto_prepare_renewals(root_id,epoch,admitted_at_ms,prior_deadline_ms,deadline_ms,regeneration_id,proof_json) VALUES(?1,?2,?3,?4,?5,?6,?7)",params![root,epoch,now,deadline,new_deadline,token,serde_json::to_string(&proven)?])?;
+    need(c.execute("UPDATE engine_graph_auto_attempts SET state='prepared',reason=NULL,deadline_ms=?2,updated_at_ms=?3 WHERE attempt_id=?1 AND slot_id=?4 AND consumed=0 AND state='expired' AND deadline_ms=?5",params![attempt.id,new_deadline,now,root,deadline])?==1,"STATE_GRAPH_AUTOMATIC_ADOPTION_EPOCH_CONFLICT")?;
+    need(c.execute("UPDATE engine_graph_auto_regenerations SET deadline_ms=?2 WHERE root_id=?1 AND regeneration_id=?3 AND claimed_slot_id IS NULL AND deadline_ms=?4",params![root,new_deadline,token,deadline])?==1,"STATE_GRAPH_AUTOMATIC_ADOPTION_EPOCH_CONFLICT")?;
+    c.execute("UPDATE engine_graph_auto_slots SET terminal_reason='GRAPH_AUTOMATIC_REGENERATION_READY',updated_at_ms=?2 WHERE slot_id=?1",params![root,now])?;
+    need(c.execute("UPDATE engine_graph_auto_policy SET total_admitted=total_admitted+1,last_admitted_ms=?1 WHERE singleton=1 AND total_admitted<9007199254740990",[now])?==1,"STATE_GRAPH_AUTOMATIC_COUNTER_EXHAUSTED")?;
+    store::event(c,&root,Some(&attempt.id),"unspent_prepare_renewed",now,json!({"revision":child::REVISION,"epoch":epoch,"same_token":true,"same_attempt":true,"prior_deadline_ms":deadline,"deadline_ms":new_deadline}))?;
+    Ok(Some(token.to_owned()))
+}
