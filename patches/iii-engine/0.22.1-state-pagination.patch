+use super::*;
+
+pub const CUT:usize=256;
+pub struct Row {pub epoch:String,pub count:i64,pub version:String}
+pub fn row(c:&Connection,scope:&str,key:&str)->anyhow::Result<Option<Row>> {
+    c.query_row("SELECT membership_epoch,source_count,row_version FROM retrieval_canonical_rows WHERE scope=?1 AND key=?2",params![scope,key],|r|Ok(Row{epoch:r.get(0)?,count:r.get(1)?,version:r.get(2)?})).optional().map_err(Into::into)
+}
+pub fn has_pending(c:&Connection,scope:&str)->anyhow::Result<bool> {c.query_row("SELECT EXISTS(SELECT 1 FROM retrieval_canonical_pending WHERE scope=?1)",[scope],|r|r.get(0)).map_err(Into::into)}
+fn bump(c:&Connection,scope:&str)->anyhow::Result<()> {
+    let next=protocol::next(protocol::counter(&meta(c,scope)?.generation)?)?;
+    c.execute("UPDATE retrieval_canonical_meta SET generation=?2 WHERE scope=?1",params![scope,next.to_string()])?;Ok(())
+}
+fn queue(c:&Connection,scope:&str,key:&str,epoch:&str)->anyhow::Result<()> {if epoch!="0" {c.execute("INSERT OR IGNORE INTO retrieval_canonical_gc VALUES(?1,?2,?3)",params![scope,key,epoch])?;}Ok(())}
+pub fn remove(c:&Connection,scope:&str,key:&str,old:Option<&Row>)->anyhow::Result<()> {
+    if let Some(old)=old {queue(c,scope,key,&old.epoch)?;if old.count>0 {bump(c,scope)?;}}
+    let pending:Option<String>=c.query_row("SELECT epoch FROM retrieval_canonical_pending WHERE scope=?1 AND key=?2",params![scope,key],|r|r.get(0)).optional()?;
+    if let Some(epoch)=pending {queue(c,scope,key,&epoch)?;c.execute("DELETE FROM retrieval_canonical_pending WHERE scope=?1 AND key=?2",params![scope,key])?;}
+    Ok(())
+}
+pub fn stage(c:&Connection,scope:&str,key:&str,previous:Option<&Value>,value:&Value,version:u64,old:Option<&Row>)->anyhow::Result<()> {
+    let array=value[index::source_field(scope)].as_array().unwrap();
+    let pending:Option<String>=c.query_row("SELECT epoch FROM retrieval_canonical_pending WHERE scope=?1 AND key=?2",params![scope,key],|r|r.get(0)).optional()?;
+    if pending.is_none() {
+        if let (Some(old),Some(previous))=(old,previous) {
+            if let Some(before)=previous[index::source_field(scope)].as_array() {
+                if array.len()>=before.len() && array.len()-before.len()<=CUT && array[..before.len()]==before[..] {
+                    let mut added=0;
+                    for item in &array[before.len()..] {added+=insert(c,scope,key,&old.epoch,item.as_str().unwrap())?;}
+                    c.execute("UPDATE retrieval_canonical_rows SET source_count=source_count+?3 WHERE scope=?1 AND key=?2",params![scope,key,added as i64])?;
+                    if added>0 {bump(c,scope)?;}return Ok(());
+                }
+            }
+        }
+    }
+    if let Some(epoch)=pending {queue(c,scope,key,&epoch)?;}
+    let old_epoch=old.map(|v|v.epoch.as_str()).unwrap_or("0");let old_count=old.map(|v|v.count).unwrap_or(0);
+    c.execute("INSERT INTO retrieval_canonical_pending VALUES(?1,?2,?3,0,0,?4,?5,0,0,?3) ON CONFLICT(scope,key) DO UPDATE SET epoch=excluded.epoch,cursor=0,member_count=0,old_epoch=excluded.old_epoch,old_count=excluded.old_count,changed=0,byte_cursor=0,byte_version=excluded.byte_version",params![scope,key,version.to_string(),old_epoch,old_count])?;
+    if array.len()<=CUT {advance(c,scope,key,value)?;}else{c.execute("UPDATE retrieval_canonical_meta SET status='pending' WHERE scope=?1",[scope])?;}
+    Ok(())
+}
+fn insert(c:&Connection,scope:&str,key:&str,epoch:&str,session:&str)->anyhow::Result<usize> {
+    c.execute("INSERT OR IGNORE INTO retrieval_canonical_sources SELECT scope,?3,key,position,?4 FROM retrieval_canonical_rows WHERE scope=?1 AND key=?2",params![scope,key,session,epoch]).map_err(Into::into)
+}
+pub fn advance(c:&Connection,scope:&str,key:&str,value:&Value)->anyhow::Result<usize> {
+    let array=value[index::source_field(scope)].as_array().ok_or_else(||protocol::error("STATE_TX_INVALID_REQUEST"))?;
+    protocol::require(array.len()<=CUT)?;
+    let items=array.iter().map(|v|v.as_str().map(str::to_owned).ok_or_else(||protocol::error("STATE_TX_INVALID_REQUEST"))).collect::<anyhow::Result<Vec<_>>>()?;
+    apply_cut(c,scope,key,&items,0,true,"")
+}
+fn apply_cut(c:&Connection,scope:&str,key:&str,items:&[String],byte_cursor:usize,done:bool,byte_version:&str)->anyhow::Result<usize> {
+    let (epoch,cursor,mut count,old_epoch,old_count,mut changed):(String,i64,i64,String,i64,bool)=c.query_row("SELECT epoch,cursor,member_count,old_epoch,old_count,changed FROM retrieval_canonical_pending WHERE scope=?1 AND key=?2",params![scope,key],|r|Ok((r.get(0)?,r.get(1)?,r.get(2)?,r.get(3)?,r.get(4)?,r.get(5)?)))?;
+    let cursor=usize::try_from(cursor).map_err(|_|protocol::error("STATE_INDEX_NOT_READY"))?;
+    protocol::require(items.len()<=CUT)?;let end=cursor.checked_add(items.len()).ok_or_else(||protocol::error("STATE_INDEX_NOT_READY"))?;
+    for session in items {
+        protocol::require(!session.is_empty() && session.len()<=256)?;
+        if insert(c,scope,key,&epoch,session)?>0 {
+            count+=1;
+            if !changed {changed=!c.query_row("SELECT EXISTS(SELECT 1 FROM retrieval_canonical_sources WHERE scope=?1 AND key=?2 AND membership_epoch=?3 AND session_id=?4)",params![scope,key,old_epoch,session],|r|r.get::<_,bool>(0))?;}
+        }
+    }
+    if done {
+        c.execute("UPDATE retrieval_canonical_rows SET membership_epoch=?3,source_count=?4 WHERE scope=?1 AND key=?2",params![scope,key,epoch,count])?;
+        c.execute("DELETE FROM retrieval_canonical_pending WHERE scope=?1 AND key=?2",params![scope,key])?;
+        if changed || count!=old_count {bump(c,scope)?;}
+        queue(c,scope,key,&old_epoch)?;
+    }else{c.execute("UPDATE retrieval_canonical_pending SET cursor=?3,member_count=?4,changed=?5,byte_cursor=?6,byte_version=?7 WHERE scope=?1 AND key=?2",params![scope,key,end as i64,count,changed,byte_cursor as i64,byte_version])?;}
+    Ok(end-cursor)
+}
+pub fn prepare_one(c:&Connection,scope:&str)->anyhow::Result<Option<usize>> {
+    let key:Option<String>=c.query_row("SELECT key FROM retrieval_canonical_pending WHERE scope=?1 ORDER BY key LIMIT 1",[scope],|r|r.get(0)).optional()?;
+    let Some(key)=key else{return Ok(None);};
+    let (offset,version,members):(i64,String,i64)=c.query_row("SELECT byte_cursor,byte_version,cursor FROM retrieval_canonical_pending WHERE scope=?1 AND key=?2",params![scope,key],|r|Ok((r.get(0)?,r.get(1)?,r.get(2)?)))?;
+    let offset=usize::try_from(offset).map_err(|_|protocol::error("STATE_INDEX_NOT_READY"))?;
+    let members=usize::try_from(members).map_err(|_|protocol::error("STATE_INDEX_NOT_READY"))?;
+    match source_cut::read(c,scope,&key,offset,&version,members).and_then(|(items,offset,done,version)|apply_cut(c,scope,&key,&items,offset,done,&version)) {
+        Ok(processed)=>Ok(Some(processed)),Err(cause) if cause.downcast_ref::<protocol::TxError>().is_some_and(|e|e.0=="STATE_TX_INVALID_REQUEST")=>{index::invalid(c,scope,&key)?;Ok(Some(0))},Err(cause)=>Err(cause)
+    }
+}
+pub fn gc_one(c:&Connection,scope:&str)->anyhow::Result<usize> {
+    let entry:Option<(String,String)>=c.query_row("SELECT key,epoch FROM retrieval_canonical_gc WHERE scope=?1 ORDER BY key,epoch LIMIT 1",[scope],|r|Ok((r.get(0)?,r.get(1)?))).optional()?;
+    let Some((key,epoch))=entry else{return Ok(0);};
+    let live:bool=c.query_row("SELECT EXISTS(SELECT 1 FROM retrieval_canonical_rows WHERE scope=?1 AND key=?2 AND membership_epoch=?3) OR EXISTS(SELECT 1 FROM retrieval_canonical_pending WHERE scope=?1 AND key=?2 AND epoch=?3)",params![scope,key,epoch],|r|r.get(0))?;
+    if live {c.execute("DELETE FROM retrieval_canonical_gc WHERE scope=?1 AND key=?2 AND epoch=?3",params![scope,key,epoch])?;return Ok(0);}
+    let deleted=c.execute("DELETE FROM retrieval_canonical_sources WHERE scope=?1 AND key=?2 AND membership_epoch=?3 AND session_id IN(SELECT session_id FROM retrieval_canonical_sources WHERE scope=?1 AND key=?2 AND membership_epoch=?3 ORDER BY session_id LIMIT ?4)",params![scope,key,epoch,CUT as i64])?;
+    if deleted<CUT {c.execute("DELETE FROM retrieval_canonical_gc WHERE scope=?1 AND key=?2 AND epoch=?3",params![scope,key,epoch])?;}
+    Ok(deleted)
+}
