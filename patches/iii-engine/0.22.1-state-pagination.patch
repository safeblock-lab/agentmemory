+    let item=&projected["items"][0];
+    let patch=json!({"action":"batch_work_submission_patch","batch_job_id":"job","updated_at":now,
+        "items":[{"key":"work","expected_version":item["version"],"expected_fingerprint":item["fingerprint"]}]});
+    let applied=call(&connection,patch.clone()).unwrap();
+    assert_eq!(applied["applied"],true);
