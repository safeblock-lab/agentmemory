+++ b/engine/src/workers/state/adapters/sqlite/provider_attempt_budget/tests.rs
@@ -0,0 +1,169 @@
+use super::*;
+use super::super::{database, storage, storage_prune, storage_operations, StateAdapter, SqliteAdapter};
+use std::{path::PathBuf, sync::{Arc, Barrier}};
+#[path = "tests_config.rs"]
+mod tests_config;
+
+fn fixture() -> (tempfile::TempDir, PathBuf, Connection) {
+    let root = std::env::var("III_SQLITE_TEST_ROOT").expect("isolated III_SQLITE_TEST_ROOT must be set");
+    assert!(Path::new(&root).is_absolute());
+    let directory = tempfile::tempdir_in(root).unwrap();
+    let path = directory.path().join("provider-budget.sqlite3");
+    let mut connection = database::open(&path).unwrap(); initialize(&mut connection).unwrap();
+    (directory, path, connection)
+}
+fn grant(ceiling: u32) -> Trusted {
+    let now = chrono::Utc::now();
+    Trusted::parse(&serde_json::to_vec(&json!({"version":1,
+        "window":{"id":"window-1","startsAt":(now-chrono::Duration::minutes(1)).to_rfc3339_opts(chrono::SecondsFormat::Millis,true),
+            "expiresAt":(now+chrono::Duration::minutes(5)).to_rfc3339_opts(chrono::SecondsFormat::Millis,true),"ceiling":ceiling},
+        "allowedEndpoints":["POST https://provider.test/v1/chat"],
+        "operations":[{"id":"operation-1","ceiling":ceiling},{"id":"operation-2","ceiling":ceiling}]})).unwrap()).unwrap()
+}
+fn identity(operation: &str) -> Identity { Identity {operation_id:operation.into(), window_id:"window-1".into(), claim_id:format!("claim-{operation}")} }
+fn claim(connection: &mut Connection, grant: &Trusted, id: &Identity) -> Value {
+    apply(connection, grant, Request::Claim {identity:id.clone(), expected_ceiling:grant.operation(&id.operation_id).unwrap().ceiling,context:None}).unwrap()
+}
+fn consume(connection: &mut Connection, grant: &Trusted, id: &Identity, attempt: &str) -> anyhow::Result<Value> {
+    apply(connection, grant, Request::Consume {identity:id.clone(), attempt_id:attempt.into(),endpoint:"POST https://provider.test/v1/chat".into()})
+}
+fn status(connection: &mut Connection, grant: &Trusted, operation: &str) -> Value {
+    apply(connection, grant, Request::Status {operation_id:operation.into()}).unwrap()
+}
+
+#[test]
+fn two_connections_one_window_slot_admit_exactly_one() {
+    let (_directory,path,mut first) = fixture();
+    let mut second = database::open(&path).unwrap(); initialize(&mut second).unwrap();
+    let grant = grant(1); let raw = grant.canonical.as_bytes().to_vec();
+    let one = identity("operation-1"); let two = identity("operation-2");
+    claim(&mut first,&grant,&one); claim(&mut second,&grant,&two);
+    let barrier = Arc::new(Barrier::new(2));
+    let jobs = [(first,one,"attempt-one"),(second,two,"attempt-two")].into_iter().map(|(mut connection,id,attempt)| {
+        let raw=raw.clone(); let barrier=barrier.clone();
+        std::thread::spawn(move || { let grant=Trusted::parse(&raw).unwrap(); barrier.wait();
+            consume(&mut connection,&grant,&id,attempt).is_ok_and(|ack|ack["fresh"]==true) })
+    }).collect::<Vec<_>>();
+    assert_eq!(jobs.into_iter().map(|job|job.join().unwrap()).filter(|admitted|*admitted).count(),1);
+    let mut reopened=database::open(&path).unwrap();
+    assert_eq!(status(&mut reopened,&grant,"operation-1")["receipt"]["window_consumed"],1);
+}
+#[test]
+fn lost_ack_reopen_duplicate_and_conflicting_ids_never_reauthorize() {
+    let (_directory,path,mut connection)=fixture(); let grant=grant(2); let id=identity("operation-1");
+    claim(&mut connection,&grant,&id);
+    let lost=consume(&mut connection,&grant,&id,"attempt-lost").unwrap(); assert_eq!(lost["fresh"],true);
+    drop(connection);
+    let mut reopened=database::open(&path).unwrap(); initialize(&mut reopened).unwrap();
+    let receipt=status(&mut reopened,&grant,&id.operation_id);
+    assert_eq!(receipt["receipt"]["consumed"],1); assert_eq!(receipt["receipt"]["state"],"started");
+    let duplicate=consume(&mut reopened,&grant,&id,"attempt-lost").unwrap();
+    assert_eq!(duplicate["fresh"],false); assert_eq!(duplicate["status"],"duplicate");
+    assert_eq!(claim(&mut reopened,&grant,&id)["fresh"],false);
+    let mut conflicting=id.clone(); conflicting.claim_id="different-claim".into();
+    assert!(apply(&mut reopened,&grant,Request::Claim {identity:conflicting,expected_ceiling:2,context:None}).is_err());
+    let second=identity("operation-2"); claim(&mut reopened,&grant,&second);
+    assert!(consume(&mut reopened,&grant,&second,"attempt-lost").is_err());
+    apply(&mut reopened,&grant,Request::Finish {identity:id.clone(),outcome:"unknown".into()}).unwrap();
+    assert!(consume(&mut reopened,&grant,&id,"attempt-new").is_err());
+    assert_eq!(status(&mut reopened,&grant,&id.operation_id)["receipt"]["consumed"],1);
+}
+#[test]
+fn rolled_back_attempt_has_no_partial_count_or_positive_ack() {
+    let (_directory,_path,mut connection)=fixture(); let grant=grant(2); let id=identity("operation-1");
+    claim(&mut connection,&grant,&id);
+    connection.execute_batch("CREATE TRIGGER fixture_reject_attempt BEFORE INSERT ON engine_provider_budget_attempts BEGIN SELECT RAISE(ABORT,'fixture rollback'); END;").unwrap();
+    assert!(consume(&mut connection,&grant,&id,"attempt-failed").is_err());
+    let receipt=status(&mut connection,&grant,&id.operation_id);
+    assert_eq!(receipt["receipt"]["consumed"],0); assert_eq!(receipt["receipt"]["window_consumed"],0);
+    connection.execute_batch("DROP TRIGGER fixture_reject_attempt;").unwrap();
+    assert_eq!(consume(&mut connection,&grant,&id,"attempt-after").unwrap()["fresh"],true);
+}
+#[test]
+fn immutable_window_operation_and_context_survive_rotation() {
+    let (_directory,_path,mut connection)=fixture(); let grant=grant(2); let id=identity("operation-1");
+    claim(&mut connection,&grant,&id);
+    let mut changed: Value=serde_json::from_str(&grant.canonical).unwrap(); changed["allowedEndpoints"]=json!(["POST https://other.test/v1/chat"]);
+    let changed=Trusted::parse(&serde_json::to_vec(&changed).unwrap()).unwrap();
+    assert!(consume(&mut connection,&changed,&id,"attempt-changed").is_err());
+    assert!(apply(&mut connection,&changed,Request::Status {operation_id:id.operation_id.clone()}).is_err());
+    let mut rotated: Value=serde_json::from_str(&grant.canonical).unwrap(); rotated["window"]["id"]=json!("window-2");
+    let rotated=Trusted::parse(&serde_json::to_vec(&rotated).unwrap()).unwrap(); let mut another=id.clone(); another.window_id="window-2".into();
+    assert!(apply(&mut connection,&rotated,Request::Claim {identity:another,expected_ceiling:2,context:None}).is_err());
+}
+#[test]
+fn new_grants_append_without_restarting_or_expanding_the_window_ceiling() {
+    let (_directory,_path,mut connection)=fixture(); let original=grant(2); let id=identity("operation-1");
+    claim(&mut connection,&original,&id); consume(&mut connection,&original,&id,"first").unwrap();
+    let mut appended: Value=serde_json::from_str(&original.canonical).unwrap();
+    appended["operations"].as_array_mut().unwrap().push(json!({"id":"judge-after-generation","ceiling":1}));
+    appended["operations"].as_array_mut().unwrap().reverse();
+    let appended=Trusted::parse(&serde_json::to_vec(&appended).unwrap()).unwrap();
+    let judge=identity("judge-after-generation");
+    assert_eq!(status(&mut connection,&appended,&judge.operation_id)["receipt"]["state"],"available");
+    claim(&mut connection,&appended,&judge);
+    consume(&mut connection,&appended,&judge,"judge-first").unwrap();
+    assert!(consume(&mut connection,&appended,&id,"over-window").is_err());
+    assert_eq!(status(&mut connection,&appended,&id.operation_id)["receipt"]["window_consumed"],2);
+    assert!(apply(&mut connection,&original,Request::Status {operation_id:id.operation_id}).is_err());
+}
+#[test]
+fn equivalent_declaration_order_is_not_authority_and_removal_or_change_denies() {
+    let (_directory,_path,mut connection)=fixture();let original=grant(2);let id=identity("operation-1");
+    claim(&mut connection,&original,&id);
+    let mut reordered: Value=serde_json::from_str(&original.canonical).unwrap();
+    reordered["operations"].as_array_mut().unwrap().reverse();
+    let reordered=Trusted::parse(&serde_json::to_vec(&reordered).unwrap()).unwrap();
+    assert_eq!(status(&mut connection,&reordered,&id.operation_id)["receipt"]["consumed"],0);
+    consume(&mut connection,&reordered,&id,"after-reorder").unwrap();
+    let mut changed: Value=serde_json::from_str(&reordered.canonical).unwrap(); changed["operations"][0]["ceiling"]=json!(1);
+    let changed=Trusted::parse(&serde_json::to_vec(&changed).unwrap()).unwrap();
+    assert!(apply(&mut connection,&changed,Request::Status {operation_id:id.operation_id.clone()}).is_err());
+    let mut removed: Value=serde_json::from_str(&reordered.canonical).unwrap(); removed["operations"].as_array_mut().unwrap().pop();
+    let removed=Trusted::parse(&serde_json::to_vec(&removed).unwrap()).unwrap();
+    assert!(consume(&mut connection,&removed,&id,"after-remove").is_err());
+}
+#[test]
+fn even_unclaimed_grant_id_cannot_be_reused_in_another_window() {
+    let (_directory,_path,mut connection)=fixture();let trusted=grant(2);
+    claim(&mut connection,&trusted,&identity("operation-1"));
+    let mut rotated: Value=serde_json::from_str(&trusted.canonical).unwrap();
+    rotated["window"]["id"]=json!("window-2");
+    rotated["operations"]=json!([{"id":"operation-2","ceiling":1}]);
