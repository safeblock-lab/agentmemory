+#[cfg(test)]
+mod preparation_queue_tests {
+    use super::*;
+    #[tokio::test]
+    async fn expired_and_dropped_queued_preparations_never_execute() {
+        for cancel in [false,true] {
+            let root=std::env::var("III_SQLITE_TEST_ROOT").expect("isolated III_SQLITE_TEST_ROOT must be set");
+            let directory=tempfile::tempdir_in(root).unwrap();
+            let adapter=Arc::new(SqliteAdapter::new(Some(serde_json::json!({
+                "file_path":directory.path().join("queued-preparation.sqlite3")
+            }))).unwrap());
+            let (started,ready)=oneshot::channel();
+            let (release,blocked)=mpsc::channel();
+            let owner=adapter.clone();
+            let blocker=tokio::spawn(async move { owner.run(0,move |_| {
+                let _=started.send(());
+                blocked.recv_timeout(Duration::from_secs(2))?;
+                Ok(())
+            }).await });
+            ready.await.unwrap();
+            let executed=Arc::new(AtomicUsize::new(0));
+            let observed=executed.clone();
+            let owner=adapter.clone();
+            let budget=database::PreparationBudget::new("fixture",if cancel {
+                Duration::from_secs(1)
+            }else{Duration::from_millis(20)});
+            let waiting=tokio::spawn(async move { owner.run_controlled(0,false,Some(budget),move |_| {
+                observed.fetch_add(1,Ordering::AcqRel); Ok(())
+            }).await });
+            if cancel {
+                tokio::time::timeout(Duration::from_secs(1),async {
+                    while adapter.foreground_pending.load(Ordering::Acquire)<2 {
+                        tokio::task::yield_now().await;
+                    }
+                }).await.unwrap();
+                waiting.abort();
+                assert!(waiting.await.unwrap_err().is_cancelled());
+            } else {
+                let error=waiting.await.unwrap().unwrap_err();
+                assert_eq!(error.downcast_ref::<protocol::TxError>().unwrap().0,
+                    "STATE_RETRIEVAL_RESOURCE_LIMIT");
+            }
+            release.send(()).unwrap();
+            blocker.await.unwrap().unwrap();
+            // A barrier on the same worker observes the skipped preparation.
+            adapter.run(0,|_|Ok(())).await.unwrap();
+            assert_eq!(executed.load(Ordering::Acquire),0);
+        }
+    }
+}
+
+pub struct SqliteAdapter {
+    sender: Option<mpsc::SyncSender<Job>>,
+    worker: Option<std::thread::JoinHandle<()>>,
+    admission: Arc<Semaphore>,
+    queue_waiters: Arc<Semaphore>,
+    foreground_pending: Arc<AtomicUsize>,
+    reclaim_slot: Arc<Semaphore>,
+    snapshot_slot: Arc<Semaphore>,
+    reclaim_schedule: Arc<Mutex<storage_reclaim::Schedule>>,
+    generation: uuid::Uuid,
+    path: PathBuf,
+}
+
+impl SqliteAdapter {
+    pub fn new(config: Option<Value>) -> anyhow::Result<Self> {
+        let path = configured_path(config.as_ref())?;
+        storage_profile::configure(&path);
+        let open_clock=storage_profile::Clock::start();
+        let connection = database::open(&path)?;
+        provider_attempt_budget::initialize(&connection)?;
+        graph_automatic_recovery::initialize(&connection)?;
+        let generation = uuid::Uuid::new_v4();
+        let mut views = snapshot_read_view::Views::new(&path, generation)?;
+        storage_profile::emit("connection_open",open_clock,0,0);
+        let (sender, receiver) = mpsc::sync_channel::<Job>(SQLITE_QUEUE_CAPACITY);
+        let worker = std::thread::Builder::new()
+            .name("iii-state-sqlite".into())
+            .spawn(move || {
+                let mut cleanup_reported = false;
+                loop {
+                    match views.reap() {
+                        Ok(()) => cleanup_reported = false,
+                        Err(_) if !cleanup_reported => {
+                            tracing::warn!(failure_class="snapshot_cleanup_failed", "state snapshot cleanup pending");
+                            cleanup_reported = true;
+                        },
+                        Err(_) => {},
+                    }
+                    match receiver.recv_timeout(Duration::from_millis(100)) {
+                        Ok(job) => if let Some(capture) = job(&connection, &mut views) {
+                            (capture.0)(&connection, &receiver, &mut views);
+                        },
+                        Err(mpsc::RecvTimeoutError::Timeout) => continue,
+                        Err(mpsc::RecvTimeoutError::Disconnected) => break,
+                    }
+                }
+                if views.cleanup().is_err() { tracing::warn!(failure_class="snapshot_cleanup_failed", "state snapshot shutdown cleanup pending"); }
+                if let Err(cause) = connection.execute_batch("PRAGMA wal_checkpoint(TRUNCATE)") {
+                    tracing::warn!(error = %cause, "state SQLite shutdown checkpoint failed");
+                }
+            })?;
+        Ok(Self {
+            sender: Some(sender),
+            worker: Some(worker),
+            admission: Arc::new(Semaphore::new(ADMISSION_BYTES)),
+            queue_waiters: Arc::new(Semaphore::new(MAX_SQLITE_QUEUE_WAITERS)),
+            foreground_pending: Arc::new(AtomicUsize::new(0)),
+            reclaim_slot: Arc::new(Semaphore::new(1)),
+            snapshot_slot: Arc::new(Semaphore::new(1)),
+            reclaim_schedule: Arc::new(Mutex::new(storage_reclaim::Schedule::default())),
+            generation,
+            path,
+        })
+    }
+
+    async fn run<T: Send + 'static>(
+        &self,
+        bytes: usize,
+        job: impl FnOnce(&Connection) -> anyhow::Result<T> + Send + 'static,
+    ) -> anyhow::Result<T> {
+        self.run_priority(bytes, false, job).await
+    }
+
+    async fn run_priority<T: Send + 'static>(
+        &self,
+        bytes: usize,
+        maintenance: bool,
+        job: impl FnOnce(&Connection) -> anyhow::Result<T> + Send + 'static,
+    ) -> anyhow::Result<T> {
+        self.run_controlled(bytes, maintenance, None, job).await
+    }
+
+    async fn run_controlled<T: Send + 'static>(
+        &self,
+        bytes: usize,
+        maintenance: bool,
+        budget: Option<database::PreparationBudget>,
+        job: impl FnOnce(&Connection) -> anyhow::Result<T> + Send + 'static,
+    ) -> anyhow::Result<T> {
+        self.run_controlled_view(bytes, maintenance, budget, move |connection, _views| job(connection)).await
+    }
+
+    async fn run_controlled_view<T: Send + 'static>(
+        &self, bytes: usize, maintenance: bool, budget: Option<database::PreparationBudget>,
+        job: impl FnOnce(&Connection, &mut snapshot_read_view::Views) -> anyhow::Result<T> + Send + 'static,
+    ) -> anyhow::Result<T> {
+        let _cancellation = CancelPreparation(budget.clone());
+        if let Some(budget) = &budget { budget.enter(0)?; }
+        let pending = if maintenance { None } else {
+            self.foreground_pending.fetch_add(1, Ordering::AcqRel);
+            Some(Pending(self.foreground_pending.clone()))
+        };
+        if bytes > MAX_ENVELOPE_BYTES {
+            tracing::warn!(
+                failure_class = "sqlite_structural_envelope",
+                request_bytes = bytes,
+                limit_bytes = MAX_ENVELOPE_BYTES,
+                "state SQLite structural envelope rejected"
+            );
+            return Err(protocol::error("STATE_RECORD_TOO_LARGE"));
+        }
+        let accounted_bytes = bytes.max(4096);
+        let permit = self
+            .admission
+            .clone()
+            .try_acquire_many_owned(accounted_bytes as u32)
+            .map_err(|_| {
+                tracing::warn!(
+                    failure_class = "sqlite_admission_bytes",
+                    request_bytes = accounted_bytes,
+                    limit_bytes = ADMISSION_BYTES,
+                    "state SQLite pre-enqueue admission rejected"
+                );
+                protocol::error("STATE_TX_LIMIT_EXCEEDED")
+            })?;
+        let (reply_sender, receiver) = oneshot::channel();
+        let sender = self.sender.as_ref().ok_or_else(|| protocol::error("STATE_TX_FAILED"))?;
+        let worker_budget = budget.clone();
+        let mut queued: Job = Box::new(move |connection, views| {
+            let result = if worker_budget.is_some() && reply_sender.is_closed() {
+                Err(protocol::error("STATE_RETRIEVAL_RESOURCE_LIMIT"))
+            } else if let Some(budget) = &worker_budget {
+                budget.check().and_then(|_| job(connection, views))
+            } else { job(connection, views) };
+            if reply_sender.send(result).is_err() {
+                if let Some(budget) = &worker_budget { budget.failure("reply_delivery_lost_unknown_outcome"); }
+            }
+            drop(permit);
+            drop(pending);
+            None
+        });
+        match sender.try_send(queued) {
+            Ok(()) => {}
+            Err(mpsc::TrySendError::Disconnected(_)) => {
+                return Err(protocol::error("STATE_TX_FAILED"));
+            }
+            Err(mpsc::TrySendError::Full(returned)) => {
+                queued = returned;
+                let _waiter = self.queue_waiters.clone().try_acquire_owned().map_err(|_| {
+                    tracing::warn!(
+                        failure_class = "sqlite_queue_waiter_limit",
+                        request_bytes = accounted_bytes,
+                        waiters = MAX_SQLITE_QUEUE_WAITERS,
+                        "state SQLite pre-enqueue queue wait rejected"
+                    );
+                    protocol::error("STATE_TX_LIMIT_EXCEEDED")
+                })?;
+                let started = Instant::now();
+                let deadline = budget.as_ref().map_or(started + SQLITE_QUEUE_WAIT_TIMEOUT, |b| b.deadline);
+                loop {
+                    if Instant::now() >= deadline {
+                        tracing::warn!(
+                            failure_class = "sqlite_queue_wait_timeout",
+                            wait_ms = started.elapsed().as_millis() as u64,
+                            request_bytes = accounted_bytes,
+                            "state SQLite pre-enqueue queue wait expired"
+                        );
+                        if let Some(budget) = &budget { budget.check()?; }
+                        return Err(protocol::error("STATE_TX_LIMIT_EXCEEDED"));
+                    }
+                    match sender.try_send(queued) {
+                        Ok(()) => {
+                            tracing::debug!(
+                                failure_class = "sqlite_queue_backpressure",
