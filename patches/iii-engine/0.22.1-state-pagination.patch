+#[tokio::test]
+async fn sqlite_signed_byte_metadata_and_preflight_before_json_materialization() {
+    let (_directory, adapter) = fresh();
+    adapter
+        .set("metadata", "one", json!("x".repeat(1200)))
+        .await
+        .unwrap();
