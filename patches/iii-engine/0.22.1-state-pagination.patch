+use super::*;
+use rusqlite::functions::FunctionFlags;
+
+#[test]
+fn browse_large_provenance_unicode_and_equal_positions_reaches_every_project_node() {
+    let c = fixture();
+    observation(&c,"foreign-session","foreign","foreign-obs");
+    for index in 0..133 {
+        let id = format!("n{index:04}");
+        let mut value = node(&id,&"😀".repeat(300),&[if index==132 {"foreign-obs"} else {"obs"}]);
+        value["properties"] = json!({"raw":"x".repeat(100000)});
+        write(&c,graph::NODES,&id,Some(&value));
+    }
+    ready(&c,"target");
+    c.create_scalar_function("state_json",2,FunctionFlags::SQLITE_UTF8,|_| -> rusqlite::Result<String> { panic!("prepared Browse decoded original") }).unwrap();
+    let mut cursor = None;
+    let mut found = Vec::new();
+    loop {
+        let page = browse(&c,"target",cursor.as_deref(),128,65536).unwrap();
+        assert_eq!(page["status"],"ready");
+        assert!(protocol::size(&page).unwrap()<=65536);
+        for item in page["items"].as_array().unwrap() {
+            assert_eq!(item["name"].as_str().unwrap().chars().count(),256);
+            assert!(item.get("properties").is_none());
+        }
+        found.extend(ids(&page));
+        if page["has_more"]==false { break; }
+        let next = page["next_cursor"].as_str().unwrap().to_owned();
+        assert_ne!(cursor,Some(next.clone()));
+        cursor=Some(next);
+    }
+    assert_eq!(found.len(),132);
+    assert_eq!(found.iter().collect::<std::collections::BTreeSet<_>>().len(),132);
+    assert!(!found.contains(&"n0132".into()));
+}
+
+#[test]
+fn browse_rejects_foreign_and_malformed_cursors_and_exposes_stale_revision() {
+    let c = fixture();
+    for id in ["a","b"] { write(&c,graph::NODES,id,Some(&node(id,id,&["obs"]))); }
+    ready(&c,"target");
+    let page = browse(&c,"target",None,1,65536).unwrap();
+    let cursor = page["next_cursor"].as_str().unwrap();
+    for invalid in ["garbage",&"x".repeat(4097)] { assert!(browse(&c,"target",Some(invalid),1,65536).is_err()); }
+    assert!(browse(&c,"foreign",Some(cursor),1,65536).is_err());
+    let mut changed = node("a","Changed",&["obs"]);
+    changed["type"] = json!("file");
+    write(&c,graph::NODES,"a",Some(&changed));
+    assert_eq!(browse(&c,"target",Some(cursor),1,65536).unwrap()["reason"],"stale_graph_revision");
+    let fresh = browse(&c,"target",None,1,65536).unwrap();
+    assert_eq!(fresh["status"],"ready");
+    assert_eq!(fresh["items"][0]["name"],"Changed");
+    assert_eq!(fresh["items"][0]["type"],"file");
+}
+
+#[test]
+fn browse_dense_edges_are_projected_and_byte_bounded_with_honest_omission_flags() {
+    let c = fixture();
+    for id in ["a","b","z"] { write(&c,graph::NODES,id,Some(&node(id,id,&["obs"]))); }
+    for index in 0..1000 { let id=format!("e{index:04}"); write(&c,graph::EDGES,&id,Some(&edge(&id,"a","b"))); }
+    write(&c,graph::EDGES,"cross",Some(&edge("cross","a","z")));
+    ready(&c,"target");
+    let page=browse(&c,"target",None,2,65536).unwrap();
+    assert_eq!(page["edgeScope"],"page");
+    assert_eq!(page["crossPageEdges"],"not_loaded");
+    assert_eq!(page["edgesTruncated"],true);
+    assert_eq!(page["edges"].as_array().unwrap().len(),256);
+    assert!(protocol::size(&page).unwrap()<=65536);
+    assert!(page["edges"].as_array().unwrap().iter().all(|e|e["sourceNodeId"]=="a" && e["targetNodeId"]=="b"));
+    let mut update=edge("e0000","a","b"); update["type"]=json!("uses"); update["weight"]=json!(2.0);
+    write(&c,graph::EDGES,"e0000",Some(&update));
+    let updated=browse(&c,"target",None,2,65536).unwrap();
+    assert_eq!(updated["status"],"ready");
+    assert_eq!(updated["edges"][0]["type"],"uses");
+    assert_eq!(updated["edges"][0]["weight"],2.0);
+}
+
+#[test]
+fn browse_empty_and_unrepresentable_rows_are_explicit() {
+    let c=fixture();
+    write(&c,graph::NODES,"n",Some(&node("n",&"😀".repeat(256),&["obs"])));
+    ready(&c,"target");
+    assert_eq!(code(browse(&c,"target",None,128,1024).unwrap_err()),"STATE_GRAPH_DISPLAY_ROW_TOO_LARGE");
+    let page=browse(&c,"target",None,128,2048).unwrap();
+    assert_eq!(ids(&page),vec!["n"]);
+    assert_eq!(page["has_more"],false);
+}
+
+#[test]
+fn prepared_page_work_does_not_grow_with_foreign_nodes_or_hub_edges() {
+    use std::sync::{Arc,atomic::{AtomicUsize,Ordering}};
+    let c=fixture();
+    write(&c,graph::NODES,"a",Some(&node("a","a",&["obs"])));
+    ready(&c,"target");
+    let measure=|| {
+        let count=Arc::new(AtomicUsize::new(0)); let counted=Arc::clone(&count);
+        c.progress_handler(1,Some(move || {counted.fetch_add(1,Ordering::Relaxed);false})).unwrap();
+        assert_eq!(ids(&graph_read::execute(&c,"target",request::GraphReadMode::Browse,&[],&[],None,&[],None,None,None,None,128,65536,12).unwrap()),vec!["a"]);
+        c.progress_handler(0,None::<fn()->bool>).unwrap(); count.load(Ordering::Relaxed)
+    };
+    let before=measure();
+    c.execute("WITH RECURSIVE n(i) AS (VALUES(1) UNION ALL SELECT i+1 FROM n WHERE i<20000) INSERT INTO retrieval_edges(epoch,key,source,target,position,display_type,display_weight) SELECT ?1,'hub-'||i,'a','foreign-'||i,i,'uses',1 FROM n",[metadata::graph(&c,graph::EDGES).unwrap().epoch]).unwrap();
