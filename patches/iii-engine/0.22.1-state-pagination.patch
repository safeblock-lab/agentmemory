+            1,
+        )
+        .unwrap();
+    }
+    transaction.commit().unwrap();
+    let small_index_steps = replace_vm_steps(&connection, target_key, &target_value, 0);
+
+    let transaction = connection.unchecked_transaction().unwrap();
+    for position in 16..256_i64 {
+        let id = format!("performance-node-{position:04}");
+        let name = format!(
+            "Synthetic graph search concept {position:04} uses independent amber olive cobalt lexicon"
+        );
+        let value = node(&id, &name, &["synthetic-observation"]);
+        graph::replace(
+            &transaction,
+            graph::NODES,
+            &id,
+            Some(&value),
+            Some(position),
+            1,
+        )
+        .unwrap();
+    }
+    transaction.commit().unwrap();
+    let large_index_steps = replace_vm_steps(&connection, target_key, &target_value, 0);
