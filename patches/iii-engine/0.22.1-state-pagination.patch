+        1,
+    )
+    .unwrap();
+    for position in 1..16_i64 {
+        let id = format!("performance-node-{position:04}");
+        let name = format!(
+            "Synthetic graph search concept {position:04} uses independent amber olive cobalt lexicon"
+        );
