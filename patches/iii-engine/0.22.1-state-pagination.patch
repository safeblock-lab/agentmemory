+fn compact_membership_preserves_shared_identifiers_both_directions_and_rollback() {
+    let connection = fresh();
+    for (id, members) in [
+        ("z", vec!["z", "shared", "shared", "東京"]),
+        ("a", vec!["shared", "z"]),
+    ] {
+        write(&connection, graph::NODES, id, Some(&node(id, id, &members)));
+    }
+    let before = decoded_memberships(&connection);
+    assert_eq!(before.len(), 5);
+    assert_eq!(
+        before
+            .iter()
+            .map(|p| (p.1.as_str(), p.2.as_str(), p.3))
+            .collect::<Vec<_>>(),
+        vec![
+            ("shared", "a", 1),
+            ("shared", "z", 0),
+            ("z", "a", 1),
+            ("z", "z", 0),
+            ("東京", "z", 0)
+        ]
+    );
+    assert_eq!(
+        ids(&call(
+            &connection,
+            json!({"action":"graph_seeds","observation_ids":["shared"]})
+        )
+        .unwrap()),
+        vec!["z", "a"]
+    );
+    {
+        let transaction = connection.unchecked_transaction().unwrap();
+        database::write(&transaction, graph::NODES, "z", None).unwrap();
+        assert_eq!(decoded_memberships(&transaction).len(), 2);
+        transaction.rollback().unwrap();
+    }
+    assert_eq!(decoded_memberships(&connection), before);
+    write(&connection, graph::NODES, "z", None);
+    assert_eq!(decoded_memberships(&connection).len(), 2);
+    assert_eq!(
+        ids(&call(
+            &connection,
+            json!({"action":"graph_seeds","observation_ids":["z"]})
+        )
+        .unwrap()),
+        vec!["a"]
+    );
+    write(&connection, graph::NODES, "a", None);
+    assert!(decoded_memberships(&connection).is_empty());
+    assert_eq!(
+        connection
+            .query_row("SELECT count(*) FROM retrieval_identifiers", [], |r| r
+                .get::<_, i64>(0))
+            .unwrap(),
+        0
+    );
+    assert_eq!(
+        connection
+            .query_row("PRAGMA integrity_check", [], |r| r.get::<_, String>(0))
+            .unwrap(),
+        "ok"
+    );
+    assert!(
+        connection
+            .prepare("PRAGMA foreign_key_check")
+            .unwrap()
+            .query([])
+            .unwrap()
+            .next()
+            .unwrap()
+            .is_none()
+    );
+}
