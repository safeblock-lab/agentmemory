+fn account(stats:&mut Value,category:&str,reason:&str,band:&str,logical:u64,stored:u64) {
+    if !stats[category].is_object() {stats[category]=json!({});}
+    if !stats[category][reason].is_object() {stats[category][reason]=json!({});}
+    if !stats[category][reason][band].is_object() {stats[category][reason][band]=json!({"rows":0,"logicalBytes":0,"storedBytes":0});}
+    let slot=&mut stats[category][reason][band];
+    for (field,delta) in [("rows",1),("logicalBytes",logical),("storedBytes",stored)] {slot[field]=json!(slot[field].as_u64().unwrap_or(0)+delta);}
+}
