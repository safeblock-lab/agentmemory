+    assert_eq!(saved["state"],"submitted");
+    assert_eq!(saved["batchJobId"],"job");
+    assert_eq!(saved["unknownProviderField"],work["unknownProviderField"]);
+    assert_eq!(call(&connection,patch).unwrap()["idempotent"],true);
+
+    let mut stale=json!({"action":"batch_work_submission_patch","batch_job_id":"job","updated_at":now,
+        "items":[{"key":"work","expected_version":"1","expected_fingerprint":"stale"}]});
+    let rejected=call(&connection,stale.take()).unwrap();
+    assert_eq!(rejected["applied"],false);
