index 0000000..5a2b0c7
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/graph_browse/dirty.rs
@@ -0,0 +1,200 @@
+use super::{membership, state};
+use super::super::{graph, metadata};
+use super::super::super::database;
+use rusqlite::{Connection, OptionalExtension, params};
+use serde::{Deserialize, Serialize};
+use serde_json::Value;
+
+fn enqueue(c: &Connection, kind: &str, key: &str) -> anyhow::Result<()> {
+    if database::trace_preparation("graph_dirty_invalidate", || invalidate(c,kind,key))? == 0 { return Ok(()); }
+    let changed = database::trace_preparation("graph_dirty_enqueue", || Ok(c.execute("INSERT INTO browse_dirty VALUES(?1,?2,1,'') ON CONFLICT(kind,key) DO UPDATE SET version=version+1,cursor='' WHERE version<9007199254740990",params![kind,key])?))?;
+    super::super::super::protocol::require(changed == 1)
+}
+
+fn invalidate(c: &Connection, kind: &str, key: &str) -> anyhow::Result<usize> {
+    let Some(epochs) = state::epochs(c)? else {
+        return c.execute("UPDATE browse_projects SET status='preparing' WHERE project IN(SELECT project FROM browse_nodes INDEXED BY browse_nodes_key WHERE key=?1)",[key]).map_err(Into::into);
+    };
+    let nodes = match kind {
+        "node" => "SELECT ?6 AS key".to_owned(),
+        "observation" => "SELECT node.value AS key FROM retrieval_membership m CROSS JOIN retrieval_identifiers node ON node.epoch=m.epoch AND node.id=m.key WHERE m.epoch=?1 AND m.observation=(SELECT id FROM retrieval_identifiers WHERE epoch=?1 AND value=?6)".to_owned(),
+        "session" => "SELECT node.value AS key FROM retrieval_scoped_sessions session CROSS JOIN retrieval_scoped_vectors v INDEXED BY retrieval_scoped_vectors_session ON v.index_id='observations' AND v.epoch=?2 AND v.session=session.token CROSS JOIN retrieval_identifiers o ON o.epoch=?1 AND o.value=v.id CROSS JOIN retrieval_membership m ON m.epoch=o.epoch AND m.observation=o.id CROSS JOIN retrieval_identifiers node ON node.epoch=m.epoch AND node.id=m.key WHERE session.name=?6".to_owned(),
+        _ => return Err(super::super::super::protocol::error("STATE_TX_FAILED")),
+    };
+    let active = membership::current("v","s").replace("?3","p.name");
+    let authority = if kind == "session" {
+        "UNION SELECT a.project FROM retrieval_project_refs a INDEXED BY retrieval_project_refs_session WHERE EXISTS(SELECT 1 FROM affected_nodes) AND a.session_id=?6 AND ((a.source='sessions' AND a.epoch=?4) OR (a.source='summaries' AND a.epoch=?5 AND a.source_key=?6 AND NOT EXISTS(SELECT 1 FROM state_rows r WHERE r.scope='mem:sessions' AND r.key=?6 AND r.value IS NOT NULL)))"
+    } else { "" };
+    let sql = format!("WITH affected_nodes AS MATERIALIZED ({nodes}),
+        cached_projects AS MATERIALIZED (
+            SELECT DISTINCT b.project FROM affected_nodes affected
+            CROSS JOIN browse_nodes b INDEXED BY browse_nodes_key ON b.key=affected.key
+        ),
+        affected_node_ids AS MATERIALIZED (
+            SELECT DISTINCT node.id FROM affected_nodes affected
+            CROSS JOIN retrieval_identifiers node ON node.epoch=?1 AND node.value=affected.key
+        ),
+        candidate_memberships AS MATERIALIZED (
+            SELECT m.observation FROM affected_node_ids affected
+            CROSS JOIN retrieval_membership m INDEXED BY retrieval_membership_key
+                ON m.epoch=?1 AND m.key=affected.id
+            LIMIT 257
+        ),
+        candidate_observations AS MATERIALIZED (
+            SELECT DISTINCT observation FROM candidate_memberships
+        ),
+        candidate_mode AS MATERIALIZED (
+            SELECT COUNT(*)<=256 AS small FROM candidate_memberships
+        )
+        UPDATE browse_projects SET status='preparing' WHERE project IN(
+            SELECT project FROM cached_projects
+            UNION SELECT p.name FROM candidate_mode mode
+            CROSS JOIN candidate_observations candidate
+            CROSS JOIN retrieval_identifiers o ON o.epoch=?1 AND o.id=candidate.observation
+            CROSS JOIN retrieval_scoped_vectors v ON v.index_id='observations' AND v.epoch=?2 AND v.id=o.value
+            CROSS JOIN retrieval_scoped_sessions s ON s.token=v.session
+            CROSS JOIN retrieval_scoped_projects p ON p.token=v.project
+            WHERE mode.small=1 AND v.kind=0 AND CASE
+                WHEN EXISTS(SELECT 1 FROM cached_projects cached WHERE cached.project=p.name)
+                THEN 0 ELSE ({active}) END
+            UNION SELECT p.name FROM candidate_mode mode CROSS JOIN retrieval_scoped_projects p
+            WHERE CASE WHEN mode.small=0 AND NOT EXISTS(
+                SELECT 1 FROM cached_projects cached WHERE cached.project=p.name
+            ) THEN EXISTS(SELECT 1 FROM affected_node_ids) AND EXISTS(
+                SELECT 1 FROM retrieval_scoped_vectors v INDEXED BY retrieval_scoped_vectors_project
+                CROSS JOIN retrieval_scoped_sessions s ON s.token=v.session
+                WHERE v.index_id='observations' AND v.epoch=?2 AND v.project=p.token AND v.kind=0
+                AND EXISTS(SELECT 1 FROM retrieval_membership m
+                    WHERE m.epoch=?1
+                    AND m.observation=(SELECT id FROM retrieval_identifiers WHERE epoch=?1 AND value=v.id)
+                    AND m.key IN(SELECT id FROM affected_node_ids))
+                AND {active}
+            ) ELSE 0 END {authority})");
+    database::trace_preparation("graph_dirty_invalidate_execute", || c.execute(&sql,params![epochs.nodes,epochs.vectors,key,epochs.sessions,epochs.summaries,key]).map_err(Into::into))
+}
+
+pub fn after_changed(c: &Connection, scope: &str, key: &str, previous: Option<&Value>, value: Option<&Value>) -> anyhow::Result<()> {
+    if scope == graph::NODES {
+        let same = previous.is_some() && value.is_some() && ["stale","sourceObservationIds"].iter().all(|f|previous.and_then(|v|v.get(f))==value.and_then(|v|v.get(f)));
+        if !same { enqueue(c,"node",key)?; }
+    } else if ["mem:sessions","mem:summaries"].contains(&scope) {
+        session(c,key)?;
+    }
+    Ok(())
+}
+
+fn node_applies(key: &str) -> String {
+    let current = membership::node_current(key);
+    format!("(EXISTS(SELECT 1 FROM browse_nodes b INDEXED BY browse_nodes_key JOIN browse_projects p ON p.project=b.project AND p.generation=b.generation WHERE b.key={key} AND b.project=?3) OR {current})")
+}
+
+fn applicability() -> String {
+    let node = node_applies("d.key");
+    let expanded = node_applies("dirty_node.value");
+    format!("(json_extract(NULLIF(d.cursor,''),'$.owner')=?3 OR (d.kind='node' AND {node}) OR (d.kind='observation' AND EXISTS(SELECT 1 FROM retrieval_identifiers dirty_observation CROSS JOIN retrieval_membership dirty_member ON dirty_member.epoch=dirty_observation.epoch AND dirty_member.observation=dirty_observation.id CROSS JOIN retrieval_identifiers dirty_node ON dirty_node.epoch=dirty_member.epoch AND dirty_node.id=dirty_member.key WHERE dirty_observation.epoch=?1 AND dirty_observation.value=d.key AND {expanded})) OR (d.kind='session' AND EXISTS(SELECT 1 FROM retrieval_scoped_sessions dirty_session CROSS JOIN retrieval_scoped_vectors dirty_vector INDEXED BY retrieval_scoped_vectors_session ON dirty_vector.index_id='observations' AND dirty_vector.epoch=?2 AND dirty_vector.session=dirty_session.token CROSS JOIN retrieval_identifiers dirty_observation ON dirty_observation.epoch=?1 AND dirty_observation.value=dirty_vector.id CROSS JOIN retrieval_membership dirty_member ON dirty_member.epoch=dirty_observation.epoch AND dirty_member.observation=dirty_observation.id CROSS JOIN retrieval_identifiers dirty_node ON dirty_node.epoch=dirty_member.epoch AND dirty_node.id=dirty_member.key WHERE dirty_session.name=d.key AND ({expanded} OR EXISTS(SELECT 1 FROM retrieval_project_refs a INDEXED BY retrieval_project_refs_session WHERE a.source='sessions' AND a.epoch=?4 AND a.session_id=d.key AND a.project=?3) OR (NOT EXISTS(SELECT 1 FROM state_rows r WHERE r.scope='mem:sessions' AND r.key=d.key AND r.value IS NOT NULL) AND EXISTS(SELECT 1 FROM retrieval_project_refs a INDEXED BY retrieval_project_refs_session WHERE a.source='summaries' AND a.epoch=?5 AND a.source_key=d.key AND a.session_id=d.key AND a.project=?3))))))")
+}
+
+pub fn pending(c: &Connection, project: &str) -> anyhow::Result<bool> {
+    let Some(epochs) = state::epochs(c)? else { return Ok(false) };
+    let sql=format!("SELECT EXISTS(SELECT 1 FROM browse_dirty d WHERE {})",applicability());
+    c.query_row(&sql,params![epochs.nodes,epochs.vectors,project,epochs.sessions,epochs.summaries],|r|r.get(0)).map_err(Into::into)
+}
+
+pub fn observation(c: &Connection, key: &str) -> anyhow::Result<()> {
+    let epoch = database::trace_preparation("graph_observation_metadata", || metadata::graph(c, graph::NODES))?.epoch;
+    let linked: bool = database::trace_preparation("graph_observation_linked", || Ok(c.query_row("SELECT EXISTS(SELECT 1 FROM retrieval_membership m WHERE m.epoch=?1 AND m.observation=(SELECT id FROM retrieval_identifiers WHERE epoch=?1 AND value=?2))",params![epoch,key],|r|r.get(0))?))?;
+    if linked { database::trace_preparation("graph_observation_enqueue", || enqueue(c,"observation",key))?; }
+    Ok(())
+}
+
+pub fn session(c: &Connection, name: &str) -> anyhow::Result<()> {
+    let Some(epochs) = state::epochs(c)? else { return Ok(()) };
+    let linked: bool = c.query_row("SELECT EXISTS(SELECT 1 FROM retrieval_scoped_sessions s CROSS JOIN retrieval_scoped_vectors v INDEXED BY retrieval_scoped_vectors_session ON v.index_id='observations' AND v.epoch=?2 AND v.session=s.token CROSS JOIN retrieval_identifiers o ON o.epoch=?1 AND o.value=v.id CROSS JOIN retrieval_membership m ON m.epoch=o.epoch AND m.observation=o.id WHERE s.name=?3)",params![epochs.nodes,epochs.vectors,name],|r|r.get(0))?;
+    if linked { enqueue(c,"session",name)?; }
+    Ok(())
+}
+
+fn bump(c: &Connection, key: &str) -> anyhow::Result<()> {
+    c.execute("UPDATE browse_projects SET revision=revision+1 WHERE project IN(SELECT project FROM browse_nodes INDEXED BY browse_nodes_key WHERE key=?1) AND revision<9007199254740990",[key])?;
+    Ok(())
+}
+
+pub fn changed(c: &Connection, scope: &str, key: &str, previous: Option<&Value>, value: Option<&Value>) -> anyhow::Result<()> {
+    if scope == graph::NODES {
+        let same_membership = previous.is_some() && value.is_some() && ["stale","sourceObservationIds"].iter().all(|field| previous.and_then(|v|v.get(field)) == value.and_then(|v|v.get(field)));
+        if same_membership { bump(c,key)?; } else { enqueue(c,"node",key)?; }
+    } else if scope == graph::EDGES {
+        for value in previous.into_iter().chain(value) {
+            if let Some(source) = value.get("sourceNodeId").and_then(Value::as_str) { bump(c,source)?; }
+            if let Some(target) = value.get("targetNodeId").and_then(Value::as_str) { bump(c,target)?; }
+        }
+    } else if scope.starts_with("mem:obs:") || scope == "mem:semantic:observations" {
+        observation(c,key)?;
+    } else if ["mem:sessions","mem:summaries"].contains(&scope) {
+        session(c,key)?;
+    }
+    Ok(())
+}
+
+#[derive(Deserialize, Serialize)]
+struct Cursor {
+    epochs: state::Epochs,
+    project: String,
+    generation: i64,
+    node: i64,
+    observation: String,
+    owner: String,
+    end_project: String,
+}
+
+pub fn drain(c: &Connection, project: &str, max_rows: usize) -> anyhow::Result<usize> {
+    let Some(epochs) = state::epochs(c)? else { return Ok(0) };
+    let mut processed = 0;
+    while processed < max_rows {
+        let sql=format!("SELECT d.kind,d.key,d.version,d.cursor FROM browse_dirty d WHERE {} ORDER BY d.kind,d.key LIMIT 1",applicability());
+        let next: Option<(String,String,i64,String)> = c.query_row(&sql,params![epochs.nodes,epochs.vectors,project,epochs.sessions,epochs.summaries],|r|Ok((r.get(0)?,r.get(1)?,r.get(2)?,r.get(3)?))).optional()?;
+        let Some((kind,key,version,raw)) = next else { break };
+        let mut cursor = if raw.is_empty() { None } else { Some(serde_json::from_str::<Cursor>(&raw)?) };
+        if cursor.as_ref().is_none_or(|v|v.epochs != epochs) {
+            let end_project: String = c.query_row("SELECT project FROM browse_projects ORDER BY project DESC LIMIT 1",[],|r|r.get(0))?;
+            cursor = Some(Cursor { epochs: epochs.clone(),project:String::new(),generation:0,node:0,observation:String::new(),owner:project.to_owned(),end_project });
+        }
+        let mut cursor = cursor.unwrap();
+        let complete = match kind.as_str() {
+            "node" => {
+                let next: Option<(String,i64,Option<String>)> = c.query_row("SELECT project,generation,input_epochs FROM browse_projects WHERE project>?1 AND project<=?2 ORDER BY project LIMIT 1",params![cursor.project,cursor.end_project],|r|Ok((r.get(0)?,r.get(1)?,r.get(2)?))).optional()?;
+                if let Some((project,generation,inputs)) = next {
+                    let compatible = inputs.map(|v|serde_json::from_str::<state::Epochs>(&v)).transpose()?.as_ref() == Some(&epochs);
+                    if compatible {
+                        let active = membership::contains(c,&epochs,&project,&key)?;
+                        if active {
+                            c.execute("INSERT OR IGNORE INTO browse_nodes VALUES(?1,?2,?3)",params![project,generation,key])?;
+                        } else {
+                            c.execute("DELETE FROM browse_nodes WHERE project=?1 AND generation=?2 AND key=?3",params![project,generation,key])?;
+                        }
+                        c.execute("UPDATE browse_projects SET revision=revision+1 WHERE project=?1 AND generation=?2 AND revision<9007199254740990",params![project,generation])?;
+                    }
+                    cursor.project = project;
+                    cursor.generation = generation;
+                    false
+                } else { true }
+            }
+            "observation" => {
+                let next: Option<(i64,String)> = c.query_row("SELECT m.key,node.value FROM retrieval_identifiers o CROSS JOIN retrieval_membership m ON m.epoch=o.epoch AND m.observation=o.id CROSS JOIN retrieval_identifiers node ON node.epoch=m.epoch AND node.id=m.key WHERE o.epoch=?1 AND o.value=?2 AND m.key>?3 ORDER BY m.key LIMIT 1",params![epochs.nodes,key,cursor.node],|r|Ok((r.get(0)?,r.get(1)?))).optional()?;
+                if let Some((id,key)) = next { enqueue(c,"node",&key)?; cursor.node=id; false } else { true }
+            }
+            "session" => {
+                let next: Option<String> = c.query_row("SELECT v.id FROM retrieval_scoped_sessions s CROSS JOIN retrieval_scoped_vectors v INDEXED BY retrieval_scoped_vectors_session ON v.index_id='observations' AND v.epoch=?1 AND v.session=s.token WHERE s.name=?2 AND v.id>?3 ORDER BY v.id LIMIT 1",params![epochs.vectors,key,cursor.observation],|r|r.get(0)).optional()?;
+                if let Some(id) = next { observation(c,&id)?; cursor.observation=id; false } else { true }
+            }
+            _ => return Err(super::super::super::protocol::error("STATE_TX_FAILED")),
+        };
+        if complete {
+            c.execute("DELETE FROM browse_dirty WHERE kind=?1 AND key=?2 AND version=?3",params![kind,key,version])?;
+        } else {
+            c.execute("UPDATE browse_dirty SET cursor=?4 WHERE kind=?1 AND key=?2 AND version=?3",params![kind,key,version,serde_json::to_string(&cursor)?])?;
+        }
+        processed += 1;
+    }
+    Ok(processed)
+}
