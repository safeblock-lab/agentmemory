+
+fn scoped_search(project: Option<&str>, global: Option<bool>) -> anyhow::Result<()> {
+    if let Some(project) = project {
+        require(!project.trim().is_empty() && project.len() <= 256)?;
+    }
+    require(project.is_some() != (global == Some(true)))
+}
+fn session_filter(value: Option<&str>) -> anyhow::Result<()> {
+    if let Some(value) = value {
+        require(!value.is_empty() && value.len() <= 256)?;
+    }
+    Ok(())
+}
+fn source_filter(scope: Option<&str>, session: Option<&str>) -> anyhow::Result<()> {
+    if let Some(scope) = scope {
+        require(session.is_some_and(|id| scope == format!("mem:obs:{id}")))?;
+    }
+    Ok(())
+}
+fn projection(
+    kind: Option<&str>,
+    include: bool,
+    limit: usize,
+    max_bytes: usize,
+) -> anyhow::Result<()> {
+    if let Some(kind) = kind {
+        require(kind == "observation")?;
+    }
+    require((1024..=65_536).contains(&max_bytes) && (!include || limit <= 12))
+}
