+#[test]
+fn canonical_scoped_legacy_version_change_between_cuts_stays_pending_until_current_embedding() {
+    let c = fixture();
+    observe(&c, "b", "needle before");
+    embed(&c, "b");
+    forget_derived(&c, "b");
+    let first = call(&c, request(1)).unwrap();
+    assert_eq!(first["processed"], 1);
+    assert_eq!(first["status"], "pending");
+    observe(&c, "b", "needle after");
