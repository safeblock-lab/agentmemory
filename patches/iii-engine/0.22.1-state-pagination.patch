+use super::{content,status,protected,validate_schema};
+use super::super::{database,protocol::{require,Guard},storage_repack::{self,Request,Step}};
+use rusqlite::{Connection,params};
+use serde::{Deserialize,Serialize};
+use serde_json::{Value,json};
+
+#[derive(Clone,Debug,Deserialize,Serialize,PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct Anchor {
+    pub generation:String,pub data_version:i64,pub schema_version:i64,pub total_changes:i64,
+    pub job_id:String,pub phase:String,pub ordinal:u64,pub owner_id:String,pub fence:u64,
+    pub guard_generation:String,pub guard_fence:String,pub cursor:Option<i64>,
+}
+#[derive(Clone,Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct PageRequest {
+    pub job_id:String,pub phase:String,pub ordinal:u64,pub owner_id:String,pub fence:u64,pub guard:Guard,
+    pub after_rowid:Option<i64>,pub limit:usize,pub max_bytes:usize,pub anchor:Option<Anchor>,
+}
+fn tables(job:&Value)->anyhow::Result<(&'static str,&'static str)> {
+    require(["ready","cut"].contains(&job["phase"].as_str().unwrap_or("")))?;
+    Ok(if job["phase"]=="cut"{("lexical_repack_original","retrieval_lexical")}else{("retrieval_lexical","lexical_repack_stage")})
+}
+pub(super) fn equality_sql(original:&str,stage:&str)->String {
+    format!("FROM {original} f LEFT JOIN {stage} s ON s.rowid=f.rowid LEFT JOIN retrieval_lexical_links l ON l.rowid=f.rowid LEFT JOIN retrieval_lexical_content_proof p ON p.rowid=f.rowid")
+}
+const MISMATCH:&str="s.rowid IS NULL OR l.rowid IS NULL OR p.rowid IS NULL OR f.index_id IS NOT l.index_id OR f.epoch IS NOT l.epoch OR f.id IS NOT l.id";
+pub(super) fn page_sql(original:&str,stage:&str,after:bool)->String {
+    format!("SELECT f.rowid,coalesce(length(CAST(f.text AS BLOB)),0)+coalesce(length(CAST(f.index_id AS BLOB)),0)+coalesce(length(CAST(f.id AS BLOB)),0)+128,({MISMATCH}) {} {} ORDER BY f.rowid LIMIT ?{}",equality_sql(original,stage),if after{"WHERE f.rowid>?1"}else{""},if after{2}else{1})
+}
+fn summary(c:&Connection,job:Value)->anyhow::Result<Value> {
+    let (original,stage)=tables(&job)?;
+    let original_schema=validate_schema(c,original,false)?;let active_schema=validate_schema(c,stage,true)?;
+    let count=|table:&str|->anyhow::Result<i64>{Ok(c.query_row(&format!("SELECT count(*) FROM {table}"),[],|r|r.get(0))?)};
+    let original_rows=count(original)?;let stage_rows=count(stage)?;let proof_rows=count("retrieval_lexical_content_proof")?;
+    let (lazy,literal,literal_bytes,canonical_bytes):(i64,i64,i64,i64)=c.query_row("SELECT coalesce(sum(literal IS NULL),0),coalesce(sum(literal IS NOT NULL),0),coalesce(sum(length(CAST(literal AS BLOB))),0),coalesce(sum(CASE WHEN literal IS NULL THEN bytes ELSE 0 END),0) FROM retrieval_lexical_content_proof",[],|r|Ok((r.get(0)?,r.get(1)?,r.get(2)?,r.get(3)?)))?;
+    Ok(json!({"job":job,"counts_exact":original_rows==stage_rows&&stage_rows==proof_rows,"schema_exact":true,"original_create_sql":original_schema,"active_create_sql":active_schema,"columns":["index_id","epoch","id","text"],"tokenizer":"unicode61 tokenchars '_'","original_rows":original_rows,"stage_rows":stage_rows,"proof_rows":proof_rows,"lazy_rows":lazy,"fallback_rows":literal,"fallback_bytes":literal_bytes,"canonical_text_bytes":canonical_bytes,"total_text_bytes":canonical_bytes+literal_bytes,"original_protected":protected(c)?,"format":c.pragma_query_value(None,"user_version",|r|r.get::<_,i64>(0))?}))
+}
+pub fn full(c:&Connection)->anyhow::Result<Value> {
+    let job=status(c)?;let (original,stage)=tables(&job)?;
+    let missing:i64=c.query_row(&format!("SELECT count(*) {} WHERE {MISMATCH}",equality_sql(original,stage)),[],|r|r.get(0))?;
+    let mut result=summary(c,job)?;result["rowids_and_metadata_exact"]=json!(missing==0&&result["counts_exact"]==true);result["mismatched_rows"]=json!(missing);Ok(result)
+}
+fn stamp(c:&Connection,generation:&str,r:&PageRequest)->anyhow::Result<Anchor> {
+    Ok(Anchor{generation:generation.into(),data_version:c.pragma_query_value(None,"data_version",|r|r.get(0))?,schema_version:c.pragma_query_value(None,"schema_version",|r|r.get(0))?,total_changes:c.query_row("SELECT total_changes()",[],|r|r.get(0))?,job_id:r.job_id.clone(),phase:r.phase.clone(),ordinal:r.ordinal,owner_id:r.owner_id.clone(),fence:r.fence,guard_generation:r.guard.generation.clone(),guard_fence:r.guard.fence.clone(),cursor:r.after_rowid})
+}
+fn validate(c:&Connection,r:&PageRequest)->anyhow::Result<Value> {
+    require((1..=4096).contains(&r.limit)&&(1024..=4*1024*1024).contains(&r.max_bytes))?;r.guard.validate()?;
+    storage_repack::leases(c,&Request{operation_id:"lexical-proof-observation".into(),job_id:r.job_id.clone(),expected_ordinal:r.ordinal,step:Step::Copy,max_ms:3000,max_bytes:r.max_bytes,limit:r.limit,owner_id:r.owner_id.clone(),fence:r.fence,guard:r.guard.clone()})?;
+    let job=status(c)?;require(job["job_id"]==r.job_id&&job["owner_id"]==r.owner_id&&job["phase"]==r.phase&&job["ordinal"].as_u64()==Some(r.ordinal))?;
+    let (original,stage)=tables(&job)?;validate_schema(c,original,false)?;validate_schema(c,stage,true)?;Ok(job)
+}
+pub fn inside(c:&Connection,generation:&str,r:&PageRequest)->anyhow::Result<Value> {
+    require(!c.is_autocommit())?;let job=validate(c,r)?;let mut anchor=stamp(c,generation,r)?;
+    if let Some(prior)=&r.anchor {anyhow::ensure!(prior==&anchor,"STATE_LEXICAL_PROOF_CHANGED");}else{require(r.after_rowid.is_none())?;}
+    let (original,stage)=tables(&job)?;let sql=page_sql(original,stage,r.after_rowid.is_some());let mut statement=c.prepare(&sql)?;
+    let mut rows=if let Some(after)=r.after_rowid{statement.query(params![after,r.limit as i64])?}else{statement.query([r.limit as i64])?};
+    let (mut processed,mut bytes,mut mismatched)=(0usize,0usize,0usize);let mut saw_row=false;
+    while let Some(row)=rows.next()? {
+        saw_row=true;let rowid:i64=row.get(0)?;let work=usize::try_from(row.get::<_,i64>(1)?)?;
+        if bytes.saturating_add(work)>r.max_bytes {anyhow::ensure!(processed>0,"STATE_LEXICAL_PROOF_ROW_EXCEEDS_BUDGET");break;}
+        require(anchor.cursor.is_none_or(|cursor|rowid>cursor))?;
+        mismatched+=usize::from(row.get::<_,bool>(2)?);bytes+=work;processed+=1;anchor.cursor=Some(rowid);
+    }
+    drop(rows);drop(statement);
+    let terminal=!saw_row;let summary=if terminal{Some(summary(c,job)?)}else{None};
+    Ok(json!({"anchor":anchor,"processed_rows":processed,"work_bytes":bytes,"mismatched_rows":mismatched,"terminal":terminal,"next_after_rowid":anchor.cursor,"summary":summary}))
+}
+// Revalidate guards in a bounded read transaction, then reject commits during either read.
+pub fn after(c:&Connection,path:&std::path::Path,generation:&str,r:&PageRequest,value:&Value,budget:&database::PreparationBudget)->anyhow::Result<()> {
+    let saved:Anchor=serde_json::from_value(value["anchor"].clone())?;
+    database::run_preparation(c,path,budget,true,|tx| {
+        validate(tx,r)?;let mut current=stamp(tx,generation,r)?;current.cursor=saved.cursor;
+        anyhow::ensure!(current==saved,"STATE_LEXICAL_PROOF_CHANGED");Ok(())
+    })?;
+    bounded_stamps(c,budget,|| {
+        let mut current=stamp(c,generation,r)?;current.cursor=saved.cursor;
+        anyhow::ensure!(current==saved,"STATE_LEXICAL_PROOF_CHANGED");Ok(())
+    })
+}
+fn bounded_stamps<T>(c:&Connection,budget:&database::PreparationBudget,read:impl FnOnce()->anyhow::Result<T>)->anyhow::Result<T> {
+    let result=(||{budget.install(c)?;let value=read()?;budget.check()?;Ok(value)})();
+    database::clear_preparation_budget(c)?;result
+}
+pub fn page(c:&Connection,path:&std::path::Path,generation:&str,r:&PageRequest,budget:&database::PreparationBudget)->anyhow::Result<Value> {
+    let mut before=bounded_stamps(c,budget,||{let stamp=stamp(c,generation,r)?;
+        if let Some(anchor)=&r.anchor {anyhow::ensure!(*anchor==stamp,"STATE_LEXICAL_PROOF_CHANGED");}else{require(r.after_rowid.is_none())?;}Ok(stamp)})?;
+    let value=database::run_preparation(c,path,budget,true,|tx| {
+        let value=inside(tx,generation,r)?;let observed:Anchor=serde_json::from_value(value["anchor"].clone())?;
+        before.cursor=observed.cursor;anyhow::ensure!(before==observed,"STATE_LEXICAL_PROOF_CHANGED");Ok(value)
+    })?;
+    after(c,path,generation,r,&value,budget)?;Ok(value)
+}
