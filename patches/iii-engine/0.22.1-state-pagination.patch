+            c.execute("INSERT INTO compact_root_fields SELECT r.id,s.id,k.id,v.id,?2 FROM compact_roots r JOIN compact_root_dictionary s ON s.token=r.scope JOIN compact_root_dictionary k ON k.token=r.key JOIN compact_root_dictionary v ON v.token=r.version WHERE r.id IN(SELECT value FROM json_each(?1)) ON CONFLICT(root) DO UPDATE SET scope=excluded.scope,key=excluded.key,version=excluded.version,job=excluded.job",params![ids,j.id])?;
+        },
+        Step::Verify=>{
