@@ -0,0 +1,30 @@
+use super::super::super::{codec, database};
+use rusqlite::{Connection, OptionalExtension, params};
+use serde_json::Value;
+
+pub(super) enum Authority {
+    Project(String, String),
+    Excluded(&'static str),
+}
+
+pub(super) fn read(c: &Connection, scope: &str, key: &str, version: &str, logical: i64, stored: i64) -> anyhow::Result<Option<Value>> {
+    let maximum = codec::MAX_LOGICAL_VALUE_BYTES as i64;
+    if !(1..=maximum).contains(&logical) || !(1..=maximum).contains(&stored) { return Ok(None); }
+    let encoded: Option<Vec<u8>> = c.query_row(
+        "SELECT value FROM state_rows WHERE scope=?1 AND key=?2 AND CAST(version AS TEXT)=?3 AND value_bytes=?4 AND length(CAST(value AS BLOB))=?5 AND value IS NOT NULL",
+        params![scope,key,version,logical,stored], |r| Ok(r.get_ref(0)?.as_bytes()?.to_vec()),
+    ).optional()?;
+    Ok(encoded.and_then(|bytes| database::decode_value(&bytes,logical).ok()).and_then(|raw| serde_json::from_str(&raw).ok()))
+}
+
+pub(super) fn project(c: &Connection, source: &str, epoch: i64, key: &str, value: &Value, version: &str, position: i64) -> anyhow::Result<()> {
+    match super::authority_fields(source,key,value) {
+        Ok(Authority::Project(session,project)) => super::set_ref(c,source,epoch,key,&session,&project,version,position),
+        Ok(Authority::Excluded(reason)) => {
+            super::remove_ref(c,source,epoch,key)?;
+            c.execute("INSERT INTO retrieval_project_exclusions VALUES(?1,?2,?3,?4,?5) ON CONFLICT(source,epoch,source_key) DO UPDATE SET version=excluded.version,reason=excluded.reason",params![source,epoch,key,version,reason])?;
+            Ok(())
+        }
+        Err(_) => { super::remove_ref(c,source,epoch,key)?; super::set_unknown(c,source,epoch,key,version) }
+    }
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/project_catalog/mod.rs b/engine/src/workers/state/adapters/sqlite/retrieval/project_catalog/mod.rs
new file mode 100644
index 0000000..514c1e4
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/project_catalog/mod.rs
@@ -0,0 +1,495 @@
+mod authority;
+mod diagnostics;
+mod prepare;
+mod repair;
+mod session_page;
+mod extraction;
+
+use super::super::{database, protocol};
+use rusqlite::{Connection, OptionalExtension, params};
+use serde_json::Value;
+
+pub const MAX_PAGE_ROWS: usize = 16;
+pub const MAX_PAGE_BYTES: usize = 65_536;
+const SOURCES: [(&str, &str); 2] = [("sessions", "mem:sessions"), ("summaries", "mem:summaries")];
+
+pub fn schema(connection: &Connection) -> anyhow::Result<()> {
+    connection.execute_batch("CREATE TABLE IF NOT EXISTS retrieval_project_catalog(source TEXT PRIMARY KEY,status TEXT NOT NULL,cursor INTEGER NOT NULL,revision TEXT NOT NULL,epoch INTEGER NOT NULL,incomplete_rows INTEGER NOT NULL) WITHOUT ROWID;
+        CREATE TABLE IF NOT EXISTS retrieval_project_refs(source TEXT NOT NULL,epoch INTEGER NOT NULL,source_key TEXT NOT NULL,session_id TEXT NOT NULL,project TEXT NOT NULL,version TEXT NOT NULL,position INTEGER NOT NULL,PRIMARY KEY(source,epoch,source_key)) WITHOUT ROWID;
+        CREATE INDEX IF NOT EXISTS retrieval_project_refs_session ON retrieval_project_refs(source,epoch,session_id,project);
+        CREATE INDEX IF NOT EXISTS retrieval_project_refs_project ON retrieval_project_refs(source,epoch,project,session_id,source_key);
+        CREATE TABLE IF NOT EXISTS retrieval_project_counts(source TEXT NOT NULL,epoch INTEGER NOT NULL,project TEXT NOT NULL,ref_count INTEGER NOT NULL CHECK(ref_count>0),PRIMARY KEY(source,epoch,project)) WITHOUT ROWID;
+        CREATE TABLE IF NOT EXISTS retrieval_project_unknown(source TEXT NOT NULL,epoch INTEGER NOT NULL,source_key TEXT NOT NULL,version TEXT NOT NULL,PRIMARY KEY(source,epoch,source_key)) WITHOUT ROWID;
+        CREATE TABLE IF NOT EXISTS retrieval_project_exclusions(source TEXT NOT NULL,epoch INTEGER NOT NULL,source_key TEXT NOT NULL,version TEXT NOT NULL,reason TEXT NOT NULL,PRIMARY KEY(source,epoch,source_key)) WITHOUT ROWID;
+        CREATE TABLE IF NOT EXISTS retrieval_project_format(id INTEGER PRIMARY KEY,version INTEGER NOT NULL);")?;
+    for (source, scope) in SOURCES {
+        initialize_source(connection, source, scope)?;
+    }
+    let format: Option<i64> = connection.query_row("SELECT version FROM retrieval_project_format WHERE id=1", [], |row| row.get(0)).optional()?;
+    if format != Some(2) {
+        connection.execute_batch("SAVEPOINT project_authority_migration")?;
+        let result = (|| -> anyhow::Result<()> {
+            for (source, scope) in SOURCES {
+                let (_, _, _, epoch, _) = catalog_row(connection, source)?;
+                reset_epoch(connection, source, &database::revision(connection, scope)?.to_string(), epoch)?;
+            }
+            connection.execute("INSERT INTO retrieval_project_format VALUES(1,2) ON CONFLICT(id) DO UPDATE SET version=excluded.version", [])?;
+            Ok(())
+        })();
+        if let Err(error) = result {
+            connection.execute_batch("ROLLBACK TO project_authority_migration; RELEASE project_authority_migration")?;
+            return Err(error);
+        }
+        connection.execute_batch("RELEASE project_authority_migration")?;
+    }
+    Ok(())
+}
+
+fn initialize_source(connection: &Connection, source: &str, scope: &str) -> anyhow::Result<()> {
+    let revision = database::revision(connection, scope)?.to_string();
+    let saved: Option<(String, i64, String)> = connection
+        .query_row(
+            "SELECT revision,epoch,status FROM retrieval_project_catalog WHERE source=?1",
+            [source],
+            |row| Ok((row.get(0)?, row.get(1)?, row.get(2)?)),
+        )
+        .optional()?;
+    if let Some((previous, epoch, status)) = saved {
+        if previous != revision {
+            reset_epoch(connection, source, &revision, epoch)?;
+        } else if status == "ready" {
+            return Ok(());
+        }
+        return Ok(());
+    }
+    let populated: bool = connection.query_row(
+        "SELECT EXISTS(SELECT 1 FROM state_rows INDEXED BY state_rows_order WHERE scope=?1 AND value IS NOT NULL)",
+        [scope],
+        |row| row.get(0),
+    )?;
+    connection.execute(
+        "INSERT INTO retrieval_project_catalog VALUES(?1,?2,-1,?3,1,0)",
+        params![
+            source,
+            if populated { "pending" } else { "ready" },
+            revision
+        ],
+    )?;
+    Ok(())
+}
+
+fn reset_epoch(
+    connection: &Connection,
+    source: &str,
+    revision: &str,
+    epoch: i64,
+) -> anyhow::Result<()> {
+    let next = epoch
+        .checked_add(1)
+        .ok_or_else(|| protocol::error("STATE_TX_LIMIT_EXCEEDED"))?;
+    connection.execute(
+        "UPDATE retrieval_project_catalog SET status='pending',cursor=-1,revision=?2,epoch=?3,incomplete_rows=0 WHERE source=?1",
+        params![source, revision, next],
+    )?;
+    Ok(())
+}
+
+fn change_count(
+    connection: &Connection,
+    source: &str,
+    epoch: i64,
+    project: &str,
+    delta: i64,
+) -> anyhow::Result<()> {
+    if delta == 0 {
+        return Ok(());
+    }
+    if delta > 0 {
+        connection.execute("INSERT INTO retrieval_project_counts VALUES(?1,?2,?3,?4) ON CONFLICT(source,epoch,project) DO UPDATE SET ref_count=ref_count+excluded.ref_count", params![source, epoch, project, delta])?;
+    } else {
+        let previous: Option<i64> = connection
+            .query_row(
+                "SELECT ref_count FROM retrieval_project_counts WHERE source=?1 AND epoch=?2 AND project=?3",
+                params![source, epoch, project],
+                |row| row.get(0),
+            )
+            .optional()?;
+        if let Some(previous) = previous {
+            let next = previous
+                .checked_add(delta)
+                .ok_or_else(|| protocol::error("STATE_TX_LIMIT_EXCEEDED"))?;
+            if next < 0 {
+                return Err(protocol::error("STATE_TX_INVALID_REQUEST"));
+            }
+            if next == 0 {
+                connection.execute(
+                    "DELETE FROM retrieval_project_counts WHERE source=?1 AND epoch=?2 AND project=?3",
+                    params![source, epoch, project],
+                )?;
+            } else {
+                connection.execute(
+                    "UPDATE retrieval_project_counts SET ref_count=?4 WHERE source=?1 AND epoch=?2 AND project=?3",
+                    params![source, epoch, project, next],
+                )?;
+            }
+        }
+    }
+    Ok(())
+}
+
+fn remove_unknown(
+    connection: &Connection,
+    source: &str,
+    epoch: i64,
+    key: &str,
+) -> anyhow::Result<()> {
+    let removed = connection.execute(
+        "DELETE FROM retrieval_project_unknown WHERE source=?1 AND epoch=?2 AND source_key=?3",
+        params![source, epoch, key],
+    )?;
+    if removed > 0 {
+        connection.execute("UPDATE retrieval_project_catalog SET incomplete_rows=MAX(0,incomplete_rows-1) WHERE source=?1", [source])?;
+        let scope =
+            source_scope(source).ok_or_else(|| protocol::error("STATE_TX_INVALID_REQUEST"))?;
+        let cursor: i64 = connection.query_row(
+            "SELECT cursor FROM retrieval_project_catalog WHERE source=?1",
+            [source],
+            |row| row.get(0),
+        )?;
+        let last_position:i64=connection.query_row("SELECT COALESCE(MAX(position),-1) FROM state_rows WHERE scope=?1 AND value IS NOT NULL",[scope],|row|row.get(0))?;
+        connection.execute("UPDATE retrieval_project_catalog SET status='ready' WHERE source=?1 AND status='partial' AND incomplete_rows=0 AND ?2>=?3",params![source,cursor,last_position])?;
+    }
+    Ok(())
+}
+
+fn set_unknown(
+    connection: &Connection,
+    source: &str,
+    epoch: i64,
+    key: &str,
+    version: &str,
+) -> anyhow::Result<()> {
+    connection.execute("DELETE FROM retrieval_project_exclusions WHERE source=?1 AND epoch=?2 AND source_key=?3", params![source,epoch,key])?;
+    let exists:bool=connection.query_row("SELECT EXISTS(SELECT 1 FROM retrieval_project_unknown WHERE source=?1 AND epoch=?2 AND source_key=?3)",params![source,epoch,key],|row|row.get(0))?;
+    let inserted = connection.execute("INSERT INTO retrieval_project_unknown VALUES(?1,?2,?3,?4) ON CONFLICT(source,epoch,source_key) DO UPDATE SET version=excluded.version", params![source, epoch, key, version])?;
+    if inserted > 0 && !exists {
+        connection.execute("UPDATE retrieval_project_catalog SET incomplete_rows=incomplete_rows+1,status=CASE WHEN status='ready' THEN 'partial' ELSE status END WHERE source=?1", [source])?;
+    }
+    Ok(())
+}
+
+fn set_ref(
+    connection: &Connection,
+    source: &str,
+    epoch: i64,
+    key: &str,
+    session: &str,
+    project: &str,
+    version: &str,
+    position: i64,
+) -> anyhow::Result<()> {
+    connection.execute("DELETE FROM retrieval_project_exclusions WHERE source=?1 AND epoch=?2 AND source_key=?3", params![source,epoch,key])?;
+    let previous: Option<(String, String)> = connection.query_row(
+        "SELECT session_id,project FROM retrieval_project_refs WHERE source=?1 AND epoch=?2 AND source_key=?3",
+        params![source, epoch, key],
+        |row| Ok((row.get(0)?, row.get(1)?)),
+    ).optional()?;
+    if previous
+        .as_ref()
+        .is_some_and(|(old_session, old_project)| old_session == session && old_project == project)
+    {
+        connection.execute("UPDATE retrieval_project_refs SET version=?4,position=?5 WHERE source=?1 AND epoch=?2 AND source_key=?3", params![source, epoch, key, version, position])?;
+        remove_unknown(connection, source, epoch, key)?;
+        return Ok(());
+    }
+    if let Some((old_session, old_project)) = previous {
+        let _ = old_session;
+        connection.execute(
+            "DELETE FROM retrieval_project_refs WHERE source=?1 AND epoch=?2 AND source_key=?3",
+            params![source, epoch, key],
+        )?;
+        change_count(connection, source, epoch, &old_project, -1)?;
+    }
+    connection.execute(
+        "INSERT INTO retrieval_project_refs VALUES(?1,?2,?3,?4,?5,?6,?7)",
+        params![source, epoch, key, session, project, version, position],
+    )?;
+    change_count(connection, source, epoch, project, 1)?;
+    remove_unknown(connection, source, epoch, key)?;
+    Ok(())
+}
+
+fn remove_ref(connection: &Connection, source: &str, epoch: i64, key: &str) -> anyhow::Result<()> {
+    let previous: Option<String> = connection.query_row(
+        "SELECT project FROM retrieval_project_refs WHERE source=?1 AND epoch=?2 AND source_key=?3",
+        params![source, epoch, key], |row| row.get(0),
+    ).optional()?;
+    if let Some(project) = previous {
+        connection.execute(
+            "DELETE FROM retrieval_project_refs WHERE source=?1 AND epoch=?2 AND source_key=?3",
+            params![source, epoch, key],
+        )?;
+        change_count(connection, source, epoch, &project, -1)?;
+    }
+    remove_unknown(connection, source, epoch, key)
+}
+
+fn authority_fields(
+    source: &str,
+    key: &str,
+    value: &Value,
+) -> Result<extraction::Authority, &'static str> {
+    if !value.is_object() || key.trim().is_empty() || key.len() > 256 {
+        return Err("audience_unknown");
+    }
+    let session = if source == "sessions" {
+        key
+    } else {
+        value
+            .get("sessionId")
+            .and_then(Value::as_str)
+            .filter(|id| !id.is_empty() && id.len() <= 256)
+            .ok_or("audience_unknown")?
+    };
+    if session != key { return Err("audience_unknown"); }
+    if value.get("deleted") == Some(&Value::Bool(true))
+        || value.get("stale") == Some(&Value::Bool(true)) {
+        return Ok(extraction::Authority::Excluded("stale"));
+    }
+    match value.get("project") {
+        Some(Value::String(project)) if !project.trim().is_empty() && project.len() <= 256 => {
+            Ok(extraction::Authority::Project(session.to_owned(), project.to_owned()))
+        }
+        Some(Value::Null) => Ok(extraction::Authority::Excluded("audience_unknown")),
+        Some(Value::String(project)) if project.trim().is_empty() => Ok(extraction::Authority::Excluded("audience_unknown")),
+        None => Err("audience_unknown"),
+        _ => Err("audience_unknown"),
+    }
+}
+
+pub fn prepare(
+    connection: &Connection,
+    source: &str,
+    max_rows: usize,
+    max_bytes: usize,
+) -> anyhow::Result<Value> {
+    prepare::prepare(connection, source, max_rows, max_bytes)
+}
+
+pub fn page(
+    connection: &Connection,
+    cursor: Option<&str>,
+    limit: usize,
+    max_bytes: usize,
+) -> anyhow::Result<Value> {
+    prepare::page(connection, cursor, limit, max_bytes)
+}
+
+pub fn sessions_page(
+    connection: &Connection,
+    project: &str,
+    cursor: Option<&str>,
+    limit: usize,
+    max_bytes: usize,
+) -> anyhow::Result<Value> {
+    session_page::page(connection, project, cursor, limit, max_bytes)
+}
+
+pub fn unknowns(
+    connection: &Connection,
+    source: &str,
+    cursor: Option<&str>,
+    limit: usize,
+    max_bytes: usize,
+) -> anyhow::Result<Value> {
+    diagnostics::page(connection, source, cursor, limit, max_bytes)
+}
+
+pub fn repair_unknown(
+    connection: &Connection,
+    source: &str,
+    key: &str,
+    expected_version: &str,
+    expected_revision: &str,
+    expected_epoch: i64,
+    expected_cursor: i64,
+) -> anyhow::Result<Value> {
+    repair::repair_unknown(
+        connection,
+        source,
+        key,
+        expected_version,
+        expected_revision,
+        expected_epoch,
+        expected_cursor,
+    )
+}
+
+pub fn status(connection: &Connection) -> anyhow::Result<Value> {
+    let mut output = serde_json::Map::new();
+    for (source, _) in SOURCES {
+        let value: Value = connection.query_row(
+            "SELECT json_object('status',status,'cursor',CAST(cursor AS TEXT),'revision',revision,'epoch',CAST(epoch AS TEXT),'incomplete_rows',CAST(incomplete_rows AS TEXT)) FROM retrieval_project_catalog WHERE source=?1",
+            [source], |row| row.get::<_, String>(0),
+        ).and_then(|raw| serde_json::from_str(&raw).map_err(|_| rusqlite::Error::InvalidQuery))?;
+        output.insert(source.to_owned(), value);
+    }
+    Ok(Value::Object(output))
+}
+
+pub fn maintain(
+    connection: &Connection,
+    scope: &str,
+    key: &str,
+    value: Option<&Value>,
+    version: u64,
+    position: Option<i64>,
+) -> anyhow::Result<()> {
+    let Some((source, _)) = SOURCES.iter().find(|(_, candidate)| *candidate == scope) else {
+        return Ok(());
+    };
+    let source = *source;
+    let revision = database::revision(connection, scope)?.to_string();
+    let (mut epoch, saved_revision): (i64, String) = connection.query_row(
+        "SELECT epoch,revision FROM retrieval_project_catalog WHERE source=?1",
+        [source],
+        |row| Ok((row.get(0)?, row.get(1)?)),
+    )?;
+    if protocol::counter(&saved_revision)?.checked_add(1) != Some(protocol::counter(&revision)?) {
+        reset_epoch(connection, source, &revision, epoch)?;
+        epoch += 1;
+    }
+    if let Some(value) = value {
+        extraction::project(connection,source,epoch,key,value,&version.to_string(),position.unwrap_or(0))?;
+    } else {
+        remove_ref(connection, source, epoch, key)?;
+        connection.execute("DELETE FROM retrieval_project_exclusions WHERE source=?1 AND epoch=?2 AND source_key=?3",params![source,epoch,key])?;
+    }
+    connection.execute(
+        "UPDATE retrieval_project_catalog SET revision=?2 WHERE source=?1",
+        params![source, revision],
+    )?;
+    Ok(())
+}
+
+pub fn resolve_session(
+    connection: &Connection,
+    session_id: &str,
+) -> anyhow::Result<Result<String, &'static str>> {
+    authority::resolve_session(connection, session_id)
+}
+
+pub fn resolve_session_bounded(
+    connection: &Connection,
+    session_id: &str,
+    max_bytes: usize,
+) -> anyhow::Result<(Result<String, &'static str>, usize)> {
+    authority::resolve_session_bounded(connection, session_id, max_bytes)
+}
+
+pub fn session_has_current_exclusion(connection: &Connection, session_id: &str) -> anyhow::Result<bool> {
+    connection.query_row("SELECT EXISTS(SELECT 1 FROM retrieval_project_exclusions x JOIN retrieval_project_catalog c ON c.source=x.source AND c.epoch=x.epoch JOIN state_rows s ON s.scope=CASE x.source WHEN 'sessions' THEN 'mem:sessions' ELSE 'mem:summaries' END AND s.key=x.source_key AND CAST(s.version AS TEXT)=x.version AND s.value IS NOT NULL WHERE x.source_key=?1 AND x.reason='audience_unknown' AND (x.source='sessions' OR NOT EXISTS(SELECT 1 FROM state_rows existing WHERE existing.scope='mem:sessions' AND existing.key=?1 AND existing.value IS NOT NULL)))",[session_id],|row|row.get(0)).map_err(Into::into)
+}
+
+pub fn has_incomplete_authority(connection: &Connection) -> anyhow::Result<bool> {
+    for (source, scope) in SOURCES {
+        let (status, _, revision, _, incomplete) = catalog_row(connection, source)?;
+        if status != "ready"
+            || incomplete > 0
+            || revision != database::revision(connection, scope)?.to_string()
+        {
+            return Ok(true);
+        }
+    }
+    Ok(false)
+}
+
+pub fn has_incomplete_session_authority(connection: &Connection) -> anyhow::Result<bool> {
+    let (status, _, revision, _, incomplete) = catalog_row(connection, "sessions")?;
+    Ok(status != "ready"
+        || incomplete != 0
+        || revision != database::revision(connection, "mem:sessions")?.to_string())
+}
+
+pub fn summary_authority_ready(connection: &Connection) -> anyhow::Result<bool> {
+    let (status, _, revision, _, incomplete) = catalog_row(connection, "summaries")?;
+    Ok(status == "ready"
+        && incomplete == 0
+        && revision == database::revision(connection, "mem:summaries")?.to_string())
+}
+
+pub fn session_is_authoritative_for_project(
+    connection: &Connection,
+    session_id: &str,
+    project: i64,
+) -> anyhow::Result<bool> {
+    let (status, _, revision, epoch, incomplete) = catalog_row(connection, "sessions")?;
+    if status != "ready"
+        || incomplete != 0
+        || revision != database::revision(connection, "mem:sessions")?.to_string()
+    {
+        return Ok(false);
+    }
+    connection
+        .query_row(
+            "SELECT EXISTS(SELECT 1 FROM retrieval_project_refs r JOIN retrieval_scoped_projects p ON p.token=?3 AND p.name=r.project JOIN state_rows s ON s.scope='mem:sessions' AND s.key=r.source_key AND CAST(s.version AS TEXT)=r.version AND s.value IS NOT NULL WHERE r.source='sessions' AND r.epoch=?1 AND r.session_id=?2 AND r.source_key=r.session_id)",
+            params![epoch, session_id, project],
+            |row| row.get(0),
+        )
+        .map_err(Into::into)
+}
+
+pub fn session_project_predicate(session_expr: &str, project_expr: &str) -> String {
+    format!(
+        "(EXISTS(SELECT 1 FROM retrieval_project_refs r JOIN retrieval_project_catalog c ON c.source=r.source AND c.epoch=r.epoch JOIN state_rows s ON s.scope='mem:sessions' AND s.key=r.source_key AND CAST(s.version AS TEXT)=r.version AND s.value IS NOT NULL WHERE r.source='sessions' AND r.source_key={session_expr} AND r.session_id=r.source_key AND r.project={project_expr}) OR (NOT EXISTS(SELECT 1 FROM state_rows s WHERE s.scope='mem:sessions' AND s.key={session_expr} AND s.value IS NOT NULL) AND EXISTS(SELECT 1 FROM retrieval_project_refs r JOIN retrieval_project_catalog c ON c.source=r.source AND c.epoch=r.epoch JOIN state_rows s ON s.scope='mem:summaries' AND s.key=r.source_key AND CAST(s.version AS TEXT)=r.version AND s.value IS NOT NULL WHERE r.source='summaries' AND r.source_key={session_expr} AND r.session_id=r.source_key AND r.project={project_expr})))"
+    )
+}
+
+pub(super) fn source_scope(source: &str) -> Option<&'static str> {
+    SOURCES
+        .iter()
+        .find(|(name, _)| *name == source)
+        .map(|(_, scope)| *scope)
+}
+
+pub(super) fn set_scanned(
+    connection: &Connection,
+    source: &str,
+    epoch: i64,
+    key: &str,
+    session: &str,
+    project: &str,
+    version: &str,
+    position: i64,
+) -> anyhow::Result<()> {
+    set_ref(
+        connection, source, epoch, key, session, project, version, position,
+    )
+}
+
+pub(super) fn set_scanned_unknown(
+    connection: &Connection,
+    source: &str,
+    epoch: i64,
+    key: &str,
+    version: &str,
+) -> anyhow::Result<()> {
+    remove_ref(connection,source,epoch,key)?;
+    set_unknown(connection, source, epoch, key, version)
+}
+
+pub(super) fn remove_scanned(
+    connection: &Connection,
+    source: &str,
+    epoch: i64,
+    key: &str,
+) -> anyhow::Result<()> {
+    remove_ref(connection, source, epoch, key)
+}
+
+pub(super) fn catalog_row(
+    connection: &Connection,
+    source: &str,
+) -> anyhow::Result<(String, i64, String, i64, i64)> {
+    Ok(connection.query_row("SELECT status,cursor,revision,epoch,incomplete_rows FROM retrieval_project_catalog WHERE source=?1", [source], |r| Ok((r.get(0)?,r.get(1)?,r.get(2)?,r.get(3)?,r.get(4)?)))?)
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/project_catalog/prepare.rs b/engine/src/workers/state/adapters/sqlite/retrieval/project_catalog/prepare.rs
