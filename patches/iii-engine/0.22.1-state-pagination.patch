+    let admission=call(&connection,json!({"action":"reflect_legacy_work","key":"legacy-work"})).unwrap();
+    let version=admission["version"].as_str().unwrap();
+    let fingerprint=admission["fingerprint"].as_str().unwrap();
+    let (job,mut receipt)=continuation("legacy-work",version,fingerprint);
+    write(&connection,"mem:reflect:jobs","reflect-job",Some(&job));
+    receipt["completedUnits"]=json!(2);
+    write(&connection,"mem:reflect:control","legacy-adoption:legacy-work",Some(&receipt));
+    let rejected=call(&connection,json!({"action":"batch_work_bridge_ack","key":"legacy-work","expected_version":version,
+        "expected_fingerprint":fingerprint,"receipt_key":"legacy-adoption:legacy-work"})).unwrap();
+    assert_eq!(rejected["acknowledged"],false);
+    assert!(database::row(&connection,"mem:reflect:control","legacy-ack:legacy-work").unwrap().value.is_none());
+
+    let (job,receipt)=continuation("legacy-work",version,fingerprint);
+    write(&connection,"mem:reflect:jobs","reflect-job",Some(&job));
+    write(&connection,"mem:reflect:control","legacy-adoption:legacy-work",Some(&receipt));
+    let accepted=call(&connection,json!({"action":"batch_work_bridge_ack","key":"legacy-work","expected_version":version,
