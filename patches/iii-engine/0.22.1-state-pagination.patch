+fn connections() -> (tempfile::TempDir, std::path::PathBuf, Connection, Connection) {
+    let root = std::env::var("III_SQLITE_TEST_ROOT").unwrap();
+    let directory = tempfile::tempdir_in(root).unwrap();
+    let path = directory.path().join("maintenance.sqlite3");
+    let first = database::open(&path).unwrap();
+    let second = database::open(&path).unwrap();
+    (directory, path, first, second)
+}
+fn expire(connection: &Connection) {
+    connection.execute("UPDATE state_storage_maintenance_lease SET expires_at_ms=1", []).unwrap();
+}
+fn state(marker: &str) -> Value {
+    json!({"version":1,"updatedAt":"2026-10-13T00:00:00.000Z","compaction":{"overlap":null},
+        "totals":{},"diagnostics":{},"observationIndex":{"cursor":marker},"technical":{},"maintenanceHistory":[]})
+}
