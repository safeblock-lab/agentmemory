+    assert_eq!(a["status"], "pending");
+    assert!(a["text_bytes"].as_u64().unwrap() <= 1048576);
+    let b = cut(&c, "p", 16);
+    assert_eq!(b["processed"], 1);
+    assert!(b["text_bytes"].as_u64().unwrap() <= 1048576);
+    prepared(&c, "p");
+}
