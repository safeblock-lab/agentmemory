+pub fn status(c: &Connection) -> anyhow::Result<Value> {
+    let job:Option<String>=c.query_row("SELECT value FROM membership_repack_job WHERE singleton=1",[],|r|r.get(0)).optional()?;
+    Ok(job.map(|s|serde_json::from_str(&s)).transpose()?.unwrap_or(json!({"phase":"absent","ordinal":0})))
+}
+fn revision(c: &Connection) -> anyhow::Result<i64> {
+    Ok(c.query_row("SELECT revision FROM compact_inverse_config WHERE singleton=1",[],|r|r.get(0))?)
+}
+fn source(c: &Connection) -> anyhow::Result<Option<String>> {
+    Ok(c.query_row("SELECT sql FROM sqlite_schema WHERE name='compact_list_inverse' AND type='index' AND tbl_name='compact_list_members'",[],|r|r.get(0)).optional()?)
+}
+pub fn receipt(c: &Connection,r: &Request) -> anyhow::Result<Value> {
+    let saved:Option<(Vec<u8>,String)>=c.query_row("SELECT digest,result FROM membership_repack_receipts WHERE operation_id=?1",[&r.operation_id],|r|Ok((r.get(0)?,r.get(1)?))).optional()?;
+    match saved {
+        None=>Ok(json!({"status":"not_found","operation_id":r.operation_id})),
+        Some((digest,result))=>{
+            anyhow::ensure!(digest==Sha256::digest(serde_json::to_vec(r)?).to_vec(),"STATE_TX_REPLAY_CONFLICT");
+            Ok(json!({"status":"applied","operation_id":r.operation_id,"result":serde_json::from_str::<Value>(&result)?}))
+        },
+    }
+}
+pub fn proof(c: &Connection) -> anyhow::Result<Value> {
+    let job=status(c)?;
+    let current=revision(c)?;
+    Ok(json!({"job":job,"revision":current,"exact_pairs_verified":job["proof_complete"]==true && job["proof_revision"].as_i64()==Some(current),"original_index_protected":source(c)?.is_some(),"physical_bytes_reclaimed":null}))
+}
+
+pub fn execute(c: &Connection,r: Request) -> anyhow::Result<Value> {
+    r.validate()?;require(!c.is_autocommit())?;
+    let lease=storage_repack::Request {operation_id:r.operation_id.clone(),job_id:r.job_id.clone(),expected_ordinal:r.expected_ordinal,
+        step:if matches!(r.step,Step::Cut|Step::Retire|Step::Abort){storage_repack::Step::Cut}else{storage_repack::Step::Copy},max_ms:r.max_ms,max_bytes:r.max_bytes,limit:r.limit,owner_id:r.owner_id.clone(),fence:r.fence,guard:r.guard.clone()};
+    storage_repack::leases(c,&lease)?;
+    let prior=receipt(c,&r)?;if prior["status"]=="applied" {return Ok(prior["result"].clone());}
+    let mut job=status(c)?;require(job["ordinal"].as_u64()==Some(r.expected_ordinal))?;
+    if r.step==Step::Begin {
+        require(job["phase"]=="absent" && !storage_repack::protected(c)? && !super::storage_lexical_repack::protected(c)?)?;
+        let sql=source(c)?.ok_or_else(||error("STATE_INVERSE_SOURCE_MISSING"))?;
+        let first:Option<(i64,i64)>=c.prepare_cached("SELECT identifier,list_id FROM compact_list_members INDEXED BY compact_list_inverse ORDER BY identifier,list_id LIMIT 1")?.query_row([],|r|Ok((r.get(0)?,r.get(1)?))).optional()?;
+        require(first.is_none_or(|(identifier,list)|identifier>0 && list>0))?;
+        require(c.query_row("SELECT NOT EXISTS(SELECT 1 FROM compact_inverse_blocks)",[],|r|r.get::<_,bool>(0))?)?;
+        c.execute("UPDATE compact_inverse_config SET writing=1 WHERE singleton=1",[])?;
+        job=json!({"job_id":r.job_id,"owner_id":r.owner_id,"phase":"copy","ordinal":0,"cursor":null,"source_sql":sql,"copied_pairs":0,"proof_complete":false});
+    } else if r.step==Step::Abort && job["phase"]=="absent" {
+        let sql=source(c)?.ok_or_else(||error("STATE_INVERSE_SOURCE_MISSING"))?;
+        job=json!({"job_id":r.job_id,"owner_id":r.owner_id,"phase":"absent","ordinal":0,"source_sql":sql,"proof_complete":false});
+    } else {
+        require(job["job_id"]==r.job_id && job["owner_id"]==r.owner_id)?;
+        if job["phase"]!="retired" {require(source(c)?.as_deref()==job["source_sql"].as_str())?;}
+    }
+    let mut processed=0;let mut bytes=0;
+    match r.step {
+        Step::Begin=>(),
+        Step::Copy=>{require(job["phase"]=="copy")?;(processed,bytes)=copy(c,&r,&mut job)?;},
+        Step::Verify=>{
+            require(["ready","cut"].contains(&job["phase"].as_str().unwrap_or("")))?;
+            (processed,bytes)=verify(c,&r,&mut job)?;
+        },
+        Step::Cancel=>{
+            require(["copy","ready"].contains(&job["phase"].as_str().unwrap_or("")))?;
+            job["resume_phase"]=job["phase"].clone();job["phase"]=json!("cancelled");
+        },
+        Step::Resume=>{
+            require(job["phase"]=="cancelled" && ["copy","ready"].contains(&job["resume_phase"].as_str().unwrap_or("")))?;
+            job["phase"]=job["resume_phase"].clone();
+        },
+        Step::Cut|Step::Retire=>{
+            require(job["phase"]==if r.step==Step::Cut{"ready"}else{"cut"})?;
+            require(job["proof_complete"]==true && job["proof_revision"].as_i64()==Some(revision(c)?))?;
+            c.flush_prepared_statement_cache();
+            if r.step==Step::Cut {c.execute("UPDATE compact_inverse_config SET active=1 WHERE singleton=1",[])?;job["phase"]=json!("cut");}
+            else {c.execute_batch("DROP INDEX compact_list_inverse;")?;job["phase"]=json!("retired");}
+        },
+        Step::Rollback=>{
+            require(job["phase"]=="cut")?;
+            c.execute("UPDATE compact_inverse_config SET active=0 WHERE singleton=1",[])?;
+            job["phase"]=json!("ready");job["proof_complete"]=json!(false);job["proof_revision"]=Value::Null;
+        },
+        Step::Abort=>{
+            require(["absent","copy","ready","cancelled","cut"].contains(&job["phase"].as_str().unwrap_or("")))?;
+            require(job["source_sql"].is_string() && source(c)?.as_deref()==job["source_sql"].as_str())?;
+            c.flush_prepared_statement_cache();
+            c.execute("UPDATE compact_inverse_config SET active=0,writing=0,revision=revision+1 WHERE singleton=1",[])?;
+            legacy(c)?;
+            job["aborted_from_phase"]=job["phase"].clone();job["phase"]=json!("aborted");
+            job["proof_complete"]=json!(false);job["proof_revision"]=Value::Null;
+        },
+    }
+    job["ordinal"]=json!(r.expected_ordinal.checked_add(1).ok_or_else(||error("STATE_TX_LIMIT_EXCEEDED"))?);
+    c.execute("INSERT INTO membership_repack_job VALUES(1,?1) ON CONFLICT(singleton) DO UPDATE SET value=excluded.value",[serde_json::to_string(&job)?])?;
+    let result=json!({"operation_id":r.operation_id,"job":job,"processed_units":processed,"work_bytes":bytes,"original_index_protected":source(c)?.is_some(),"physical_bytes_reclaimed":null});
+    c.execute("INSERT INTO membership_repack_receipts VALUES(?1,?2,?3)",params![r.operation_id,Sha256::digest(serde_json::to_vec(&r)?).to_vec(),serde_json::to_string(&result)?])?;
+    Ok(result)
+}
+
+fn time(r: &Request, started: Instant) -> bool {
+    started.elapsed()<Duration::from_millis(r.max_ms.saturating_sub(200).min(1500))
+}
+fn pair_page(c: &Connection,cursor: &Value,limit: usize) -> anyhow::Result<Vec<(i64,i64)>> {
+    let mut statement=c.prepare_cached("SELECT identifier,list_id FROM compact_list_members INDEXED BY compact_list_inverse WHERE (identifier,list_id)>(?1,?2) ORDER BY identifier,list_id LIMIT ?3")?;
+    Ok(statement.query_map(params![cursor[0].as_i64().unwrap_or(0),cursor[1].as_i64().unwrap_or(0),i64::try_from(limit.min(512))?],|r|Ok((r.get(0)?,r.get(1)?)))?.collect::<rusqlite::Result<_>>()?)
+}
+fn copy(c: &Connection,r: &Request,job: &mut Value) -> anyhow::Result<(usize,usize)> {
+    let started=Instant::now();let mut rows=0;let mut bytes=0;
+    while rows<r.limit && (rows==0 || time(r,started)) {
+        // Reserve worst-case existing blocks and new encoded blocks per pair, then charge actual work.
+        let reserve=4*MAX_PAYLOAD+4*BLOCK*8+256;
+        if bytes+reserve>r.max_bytes {require(rows>0)?;break;}
+        let page=pair_page(c,&job["cursor"],(r.limit-rows).min((r.max_bytes-bytes)/reserve))?;
+        if page.is_empty() {job["phase"]=json!("ready");break;}
+        let mut offset=0;
+        while offset<page.len() {
+            let identifier=page[offset].0;let end=offset+page[offset..].iter().take_while(|p|p.0==identifier).count();
+            let ids=page[offset..end].iter().map(|p|p.1).collect::<Vec<_>>();
+            bytes+=merge(c,identifier,&ids)?;rows+=ids.len();
+            job["cursor"]=json!([identifier,*ids.last().unwrap()]);offset=end;
+            if !time(r,started) {break;}
+        }
+    }
+    job["copied_pairs"]=json!(job["copied_pairs"].as_u64().unwrap_or(0)+rows as u64);
+    require(bytes<=r.max_bytes)?;
+    Ok((rows,bytes))
+}
+fn merge(c: &Connection,identifier:i64,ids:&[i64]) -> anyhow::Result<usize> {
+    let mut offset=0;let mut work=ids.len()*16;
+    while offset<ids.len() {
+        let first=ids[offset];
+        let prior:Option<(i64,Vec<u8>)>=c.prepare_cached("SELECT edge,payload FROM compact_inverse_blocks WHERE identifier=?1 AND edge<=?2 ORDER BY edge DESC LIMIT 1")?
+            .query_row(params![identifier,first],|r|Ok((r.get(0)?,r.get(1)?))).optional()?;
+        let edge=prior.as_ref().map_or(0,|p|p.0);
+        let next:Option<i64>=c.prepare_cached("SELECT edge FROM compact_inverse_blocks WHERE identifier=?1 AND edge>?2 ORDER BY edge LIMIT 1")?
+            .query_row(params![identifier,edge],|r|r.get(0)).optional()?;
+        let end=offset+ids[offset..].iter().take_while(|&&id|next.is_none_or(|next|id<next)).count();
+        require(end>offset)?;
+        let mut combined=prior.as_ref().map(|p|decode(&p.1)).transpose()?.unwrap_or_default();
+        require(combined.len()<=BLOCK)?;
+        work+=prior.as_ref().map_or(0,|p|p.1.len())+combined.len()*8;
+        combined.extend_from_slice(&ids[offset..end]);combined.sort_unstable();combined.dedup();
+        for (ordinal,part) in combined.chunks(BLOCK).enumerate() {
+            let boundary=if ordinal==0{edge}else{part[0]};let payload=encode(part)?;
+            work+=payload.len()+part.len()*8+64;
+            c.prepare_cached("INSERT INTO compact_inverse_blocks VALUES(?1,?2,?3) ON CONFLICT(identifier,edge) DO UPDATE SET payload=excluded.payload")?
+                .execute(params![identifier,boundary,payload])?;
+        }
+        offset=end;
+    }
+    Ok(work)
+}
+fn verify(c: &Connection,r: &Request,job: &mut Value) -> anyhow::Result<(usize,usize)> {
+    let current=revision(c)?;
+    if job["proof_revision"].as_i64()!=Some(current) {
+        job["proof_revision"]=json!(current);job["proof_cursor"]=Value::Null;job["packed_cursor"]=Value::Null;
+        job["proof_complete"]=json!(false);job["verified_forward_pairs"]=json!(0);job["verified_inverse_pairs"]=json!(0);
+    }
+    if job["proof_complete"]==true {return Ok((0,0));}
+    let started=Instant::now();let mut pairs=0;let mut bytes=0;
+    while pairs<r.limit && (pairs==0 || time(r,started)) {
+        let reserve=4*MAX_PAYLOAD+4*BLOCK*8+256;
+        if bytes+reserve>r.max_bytes {require(pairs>0)?;break;}
+        let limit=(r.limit-pairs).min((r.max_bytes-bytes)/reserve).min(512);
+        let source=pair_page(c,&job["proof_cursor"],limit)?;
+        let (packed,cursor,work)=packed_page(c,&job["packed_cursor"],limit)?;
+        // Sorted pair equality plus simultaneous exhaustion proves inclusion in both directions.
+        anyhow::ensure!(source==packed,"STATE_INVERSE_PAIR_MISMATCH");
+        bytes+=work+source.len()*16;
+        if source.is_empty() {job["proof_complete"]=json!(true);break;}
+        let last=source.last().unwrap();job["proof_cursor"]=json!([last.0,last.1]);job["packed_cursor"]=cursor;
+        pairs+=source.len();
+        job["verified_forward_pairs"]=json!(job["verified_forward_pairs"].as_u64().unwrap_or(0)+source.len() as u64);
+        job["verified_inverse_pairs"]=json!(job["verified_inverse_pairs"].as_u64().unwrap_or(0)+packed.len() as u64);
+    }
+    require(bytes<=r.max_bytes)?;Ok((pairs,bytes))
+}
+fn packed_page(c: &Connection,after: &Value,limit: usize) -> anyhow::Result<(Vec<(i64,i64)>,Value,usize)> {
+    let mut cursor=after.clone();let mut pairs=Vec::with_capacity(limit);let mut work=0;
+    while pairs.len()<limit {
+        let identifier=cursor["identifier"].as_i64().unwrap_or(0);let edge=cursor["edge"].as_i64().unwrap_or(-1);
+        let offset=usize::try_from(cursor["offset"].as_u64().unwrap_or(0))?;
+        let partial=cursor["partial"].as_bool().unwrap_or(false);
+        let row:Option<(i64,i64,Vec<u8>)>=if partial {
+            c.prepare_cached("SELECT identifier,edge,payload FROM compact_inverse_blocks WHERE identifier=?1 AND edge=?2")?
+                .query_row(params![identifier,edge],|r|Ok((r.get(0)?,r.get(1)?,r.get(2)?))).optional()?
+        } else {
+            c.prepare_cached("SELECT identifier,edge,payload FROM compact_inverse_blocks WHERE (identifier,edge)>(?1,?2) ORDER BY identifier,edge LIMIT 1")?
+                .query_row(params![identifier,edge],|r|Ok((r.get(0)?,r.get(1)?,r.get(2)?))).optional()?
+        };
+        let Some((identifier,edge,payload))=row else {require(!partial)?;break;};
+        let ids=decode(&payload)?;require(!ids.is_empty() && ids.len()<=BLOCK && ids[0]>=edge)?;
+        let start=if partial{offset}else{0};require(start<ids.len())?;
+        let end=ids.len().min(start+limit-pairs.len());
+        work+=payload.len()+ids.len()*8+64;
+        pairs.extend(ids[start..end].iter().map(|&list|(identifier,list)));
+        cursor=json!({"identifier":identifier,"edge":edge,"offset":end,"partial":end<ids.len()});
+    }
+    Ok((pairs,cursor,work))
+}
+
+pub(super) fn forward_proof_page(c: &Connection, cursor: &Value, limit: usize) -> anyhow::Result<(Vec<(i64,i64)>,Value,usize)> {
+    packed_page(c,cursor,limit)
+}
