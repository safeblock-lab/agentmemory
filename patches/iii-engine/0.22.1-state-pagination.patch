+use super::*;
+use rusqlite::params;
+
+fn diagnostics(
+    connection: &Connection,
+    source: &str,
+    cursor: Option<&str>,
+    limit: usize,
+    max_bytes: usize,
+) -> anyhow::Result<Value> {
+    call(
+        connection,
+        json!({
+            "action": "project_catalog_unknowns",
+            "source": source,
+            "cursor": cursor,
+            "limit": limit,
+            "max_bytes": max_bytes,
+        }),
+    )
+}
+
+fn unknown_summary(connection: &Connection, key: &str, value: Value) {
+    write(connection, "mem:summaries", key, Some(&value));
+}
+
+fn replace_raw_summary(connection: &Connection, key: &str, raw: &[u8], logical_bytes: i64) {
+    connection
+        .execute(
+            "UPDATE state_rows SET value=?2,value_bytes=?3 WHERE scope='mem:summaries' AND key=?1",
+            params![key, raw, logical_bytes],
+        )
+        .unwrap();
+}
