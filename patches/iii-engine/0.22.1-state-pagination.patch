new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/search_projection.rs
@@ -0,0 +1,302 @@
+use super::super::protocol;
+use rusqlite::{params, Connection, OptionalExtension};
+use serde_json::{json, Value};
+use std::cell::Cell;
+use std::time::{Duration, Instant};
+
+const MAX_SAFE_DIAGNOSTIC_INTEGER: u64 = 9_007_199_254_740_991;
+
+#[derive(Clone, Copy)]
+pub struct Options<'a> {
+    pub project: Option<&'a str>,
+    pub session_id: Option<&'a str>,
+    pub source_scope: Option<&'a str>,
+    pub source_kind: Option<&'a str>,
+    pub include_text: bool,
+    pub max_bytes: usize,
+}
+
+pub(super) struct KeywordDiagnostics {
+    subpath: Cell<&'static str>,
+    pre_enrichment_ms: Cell<Duration>,
+    enrichment_ms: Cell<Duration>,
+    projection_lookup_ms: Cell<Duration>,
+    proof_lookup_ms: Cell<Duration>,
+    literal_validation_ms: Cell<Duration>,
+    decode_validation_ms: Cell<Duration>,
+    hits_started: Cell<usize>,
+    hits_completed: Cell<usize>,
+    literal_started: Cell<usize>,
+    recipe1_started: Cell<usize>,
+    full_bytes_validated: Cell<usize>,
+    hit_budget: usize,
+    full_bytes_budget: usize,
+}
+
+pub(super) struct KeywordDiagnosticTimer<'a> {
+    elapsed: &'a Cell<Duration>,
+    started: Instant,
+}
+
+impl Drop for KeywordDiagnosticTimer<'_> {
+    fn drop(&mut self) {
+        self.elapsed
+            .set(self.elapsed.get().saturating_add(self.started.elapsed()));
+    }
+}
+
+impl KeywordDiagnostics {
+    pub(super) fn new(hit_budget: usize) -> Self {
+        let safe_integer_limit = usize::try_from(MAX_SAFE_DIAGNOSTIC_INTEGER).unwrap_or(usize::MAX);
+        let full_bytes_budget = hit_budget
+            .saturating_mul(super::lexical_content::MAX_TEXT)
+            .min(safe_integer_limit);
+        Self {
+            subpath: Cell::new("pre_enrichment"),
+            pre_enrichment_ms: Cell::new(Duration::ZERO),
+            enrichment_ms: Cell::new(Duration::ZERO),
+            projection_lookup_ms: Cell::new(Duration::ZERO),
+            proof_lookup_ms: Cell::new(Duration::ZERO),
+            literal_validation_ms: Cell::new(Duration::ZERO),
+            decode_validation_ms: Cell::new(Duration::ZERO),
+            hits_started: Cell::new(0),
+            hits_completed: Cell::new(0),
+            literal_started: Cell::new(0),
+            recipe1_started: Cell::new(0),
+            full_bytes_validated: Cell::new(0),
+            hit_budget,
+            full_bytes_budget,
+        }
+    }
+
+    fn timer<'a>(elapsed: &'a Cell<Duration>) -> KeywordDiagnosticTimer<'a> {
+        KeywordDiagnosticTimer {
+            elapsed,
+            started: Instant::now(),
+        }
+    }
+
+    fn millis(elapsed: Duration) -> u64 {
+        elapsed
+            .as_millis()
+            .min(u128::from(MAX_SAFE_DIAGNOSTIC_INTEGER)) as u64
+    }
+
+    fn step<'a>(
+        &self,
+        subpath: &'static str,
+        elapsed: &'a Cell<Duration>,
+    ) -> KeywordDiagnosticTimer<'a> {
+        self.subpath.set(subpath);
+        Self::timer(elapsed)
+    }
+
+    pub(super) fn pre_enrichment(&self) -> KeywordDiagnosticTimer<'_> {
+        self.step("pre_enrichment", &self.pre_enrichment_ms)
+    }
+
+    pub(super) fn enrichment(&self) -> KeywordDiagnosticTimer<'_> {
+        Self::timer(&self.enrichment_ms)
+    }
+
+    pub(super) fn projection_lookup(&self) -> KeywordDiagnosticTimer<'_> {
+        self.step("projection_lookup", &self.projection_lookup_ms)
+    }
+
+    pub(super) fn proof_lookup(&self) -> KeywordDiagnosticTimer<'_> {
+        self.step("proof_lookup", &self.proof_lookup_ms)
+    }
+
+    pub(super) fn literal_validation(&self) -> KeywordDiagnosticTimer<'_> {
+        self.step("literal_validation", &self.literal_validation_ms)
+    }
+
+    pub(super) fn decode_validation(&self) -> KeywordDiagnosticTimer<'_> {
+        self.step("decode_validation", &self.decode_validation_ms)
+    }
+
+    pub(super) fn complete(&self) {
+        self.subpath.set("complete");
+    }
+
+    pub(super) fn set_subpath(&self, subpath: &'static str) {
+        self.subpath.set(subpath);
+    }
+
+    fn increment(&self, counter: &Cell<usize>) {
+        counter.set(counter.get().saturating_add(1).min(self.hit_budget));
+    }
+
+    pub(super) fn hit_started(&self) {
+        self.increment(&self.hits_started);
+    }
+
+    pub(super) fn hit_completed(&self) {
+        self.increment(&self.hits_completed);
+    }
+
+    pub(super) fn literal_started(&self) {
+        self.increment(&self.literal_started);
+    }
+
+    pub(super) fn recipe1_started(&self) {
+        self.increment(&self.recipe1_started);
+    }
+
+    pub(super) fn full_bytes_validated(&self, bytes: usize) {
+        if bytes > super::lexical_content::MAX_TEXT {
+            return;
+        }
+        let current = self.full_bytes_validated.get();
+        let remaining = self.full_bytes_budget.saturating_sub(current);
+        self.full_bytes_validated
+            .set(current.saturating_add(bytes.min(remaining)));
+    }
+
+    pub(super) fn snapshot(&self) -> Value {
+        json!({
+            "subpath": self.subpath.get(),
+            "pre_enrichment_ms": Self::millis(self.pre_enrichment_ms.get()),
+            "enrichment_ms": Self::millis(self.enrichment_ms.get()),
+            "projection_lookup_ms": Self::millis(self.projection_lookup_ms.get()),
+            "proof_lookup_ms": Self::millis(self.proof_lookup_ms.get()),
+            "literal_validation_ms": Self::millis(self.literal_validation_ms.get()),
+            "decode_validation_ms": Self::millis(self.decode_validation_ms.get()),
+            "hits_started": self.hits_started.get(),
+            "hits_completed": self.hits_completed.get(),
+            "literal_started": self.literal_started.get(),
+            "recipe1_started": self.recipe1_started.get(),
+            "full_bytes_validated": self.full_bytes_validated.get(),
+        })
+    }
+}
+
+pub fn filter(scope_parameter: &str, kind_parameter: &str) -> String {
+    format!(" AND ({scope_parameter} IS NULL OR EXISTS(SELECT 1 FROM retrieval_source_items si WHERE si.index_id=v.index_id AND si.scope={scope_parameter} AND si.key=v.id AND si.dirty=0)) AND ({kind_parameter} IS NULL OR EXISTS(SELECT 1 FROM retrieval_source_items si INDEXED BY retrieval_source_items_id WHERE si.index_id=v.index_id AND si.key=v.id AND si.scope>='mem:obs:' AND si.scope<'mem:obs;' AND si.dirty=0)) ")
+}
+
+pub fn enrich(
+    connection: &Connection,
+    index: &str,
+    items: &mut Vec<Value>,
+    options: Options<'_>,
+) -> anyhow::Result<Option<&'static str>> {
+    enrich_inner(connection, index, items, options, None)
+}
+
+pub(super) fn enrich_keyword(
+    connection: &Connection,
+    index: &str,
+    items: &mut Vec<Value>,
+    options: Options<'_>,
+    diagnostics: &KeywordDiagnostics,
+    pre_enrichment: KeywordDiagnosticTimer<'_>,
+) -> anyhow::Result<Option<&'static str>> {
+    drop(pre_enrichment);
+    let _enrichment_timer = diagnostics.enrichment();
+    let result = enrich_inner(connection, index, items, options, Some(diagnostics));
+    if result.is_ok() {
+        diagnostics.complete();
+    }
+    result
+}
+
+fn enrich_inner(
+    connection: &Connection,
+    index: &str,
+    items: &mut Vec<Value>,
+    options: Options<'_>,
+    diagnostics: Option<&KeywordDiagnostics>,
+) -> anyhow::Result<Option<&'static str>> {
+    if !options.include_text {
+        return Ok(None);
+    }
+    let projection_sql = "SELECT l.rowid,s.scope,s.version FROM retrieval_source_items s INDEXED BY retrieval_source_items_id CROSS JOIN retrieval_lexical_links l ON l.index_id=s.index_id AND l.id=s.key CROSS JOIN retrieval_semantic_meta m ON m.index_id=l.index_id AND m.epoch=l.epoch WHERE s.index_id=?1 AND s.key=?2 AND s.dirty=0 AND (?3 IS NULL OR s.scope=?3) AND (?4 IS NULL OR (s.scope>='mem:obs:' AND s.scope<'mem:obs;')) AND (?5 IS NULL OR s.scope<'mem:obs:' OR s.scope>='mem:obs;' OR s.scope='mem:obs:'||?5) LIMIT 1";
+    let mut statement = {
+        let _timer = diagnostics.map(|value| value.projection_lookup());
+        connection.prepare(projection_sql)?
+    };
+    let mut output = Vec::with_capacity(items.len());
+    let mut bytes = 2048usize;
+    let mut partial = None;
+    for mut item in items.drain(..) {
+        let id = item["obsId"]
+            .as_str()
+            .ok_or_else(|| protocol::error("STATE_INDEX_NOT_READY"))?;
+        if let Some(diagnostics) = diagnostics {
+            diagnostics.hit_started();
+        }
+        let projection = {
+            let _timer = diagnostics.map(|value| value.projection_lookup());
+            statement
+                .query_row(
+                    params![
+                        index,
+                        id,
+                        options.source_scope,
+                        options.source_kind,
+                        options.session_id
+                    ],
+                    |row| {
+                        Ok((
+                            row.get::<_, i64>(0)?,
+                            row.get::<_, String>(1)?,
+                            row.get::<_, String>(2)?,
+                        ))
+                    },
+                )
+                .optional()?
+        };
+        let Some((rowid, scope, version)) = projection else {
+            partial = Some("projection_source_missing");
+            if let Some(diagnostics) = diagnostics {
+                diagnostics.hit_completed();
+            }
+            continue;
+        };
+        let (text, full_bytes) = match diagnostics {
+            Some(diagnostics) => match super::lexical_content::text_prefix_for_keyword(
+                connection,
+                rowid,
+                2048,
+                diagnostics,
+            )? {
+                Some(text) => text,
+                None => {
+                    partial = Some("projection_source_missing");
+                    diagnostics.hit_completed();
+                    continue;
+                }
+            },
+            None => match super::lexical_content::text_prefix(connection, rowid, 2048)? {
+                Some(text) => (text, 0),
+                None => {
+                    partial = Some("projection_source_missing");
+                    continue;
+                }
+            },
+        };
+        if let Some(diagnostics) = diagnostics {
+            diagnostics.full_bytes_validated(full_bytes);
+        }
+        protocol::counter(&version)?;
+        item["text"] = json!(text);
+        item["source_scope"] = json!(scope);
+        item["source_version"] = json!(version);
+        let needed = protocol::size(&item)? + 1;
+        if bytes + needed > options.max_bytes {
+            partial = Some("projection_budget");
+            if let Some(diagnostics) = diagnostics {
+                diagnostics.hit_completed();
+            }
+            break;
+        }
+        bytes += needed;
+        output.push(item);
+        if let Some(diagnostics) = diagnostics {
+            diagnostics.hit_completed();
+        }
+    }
+    *items = output;
+    Ok(partial)
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/semantic.rs b/engine/src/workers/state/adapters/sqlite/retrieval/semantic.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/semantic.rs
@@ -0,0 +1,237 @@
+use super::super::{database, protocol};
+use super::{lexical, lsh, request, source};
+use rusqlite::{Connection, params};
+use serde_json::{Value, json};
+
+pub const PREFIX: &str = "mem:semantic:";
+pub fn rebuild(connection: &Connection, meta: &Meta, revision: &str) -> anyhow::Result<()> {
+    let epoch = meta
+        .epoch
+        .checked_add(1)
+        .ok_or_else(|| protocol::error("STATE_TX_LIMIT_EXCEEDED"))?;
+    connection.execute("UPDATE retrieval_semantic_meta SET status='pending',cursor=-1,revision=?2,epoch=?3,count=0,lexical_count=0 WHERE index_id=?1", params![meta.index_id,revision,epoch])?;
+    Ok(())
+}
+
+pub fn schema(connection: &Connection) -> anyhow::Result<()> {
+    connection.execute_batch("CREATE TABLE IF NOT EXISTS retrieval_semantic_meta(index_id TEXT PRIMARY KEY,model TEXT NOT NULL,dimensions INTEGER NOT NULL,generation TEXT NOT NULL,status TEXT NOT NULL,cursor INTEGER NOT NULL,revision TEXT NOT NULL,epoch INTEGER NOT NULL,count INTEGER NOT NULL,lexical_count INTEGER NOT NULL) WITHOUT ROWID;
+        CREATE TABLE IF NOT EXISTS retrieval_vectors(index_id TEXT NOT NULL,epoch INTEGER NOT NULL,id TEXT NOT NULL,session_id TEXT NOT NULL,embedding BLOB NOT NULL,PRIMARY KEY(index_id,epoch,id)) WITHOUT ROWID;
+        CREATE TABLE IF NOT EXISTS retrieval_vector_postings(index_id TEXT NOT NULL,epoch INTEGER NOT NULL,table_id INTEGER NOT NULL,bucket INTEGER NOT NULL,id TEXT NOT NULL,PRIMARY KEY(index_id,epoch,table_id,bucket,id)) WITHOUT ROWID;
+        CREATE INDEX IF NOT EXISTS retrieval_vector_postings_id ON retrieval_vector_postings(index_id,epoch,id);")?;
+    connection.execute_batch("CREATE TRIGGER IF NOT EXISTS compact_vector_delete AFTER DELETE ON retrieval_vectors BEGIN DELETE FROM compact_vector_refs WHERE index_id=OLD.index_id AND epoch=OLD.epoch AND id=OLD.id; END; CREATE TRIGGER IF NOT EXISTS compact_vector_inline_insert AFTER INSERT ON retrieval_vectors WHEN state_compact_vector_root(NEW.embedding) IS NULL BEGIN UPDATE compact_vector_cursor SET index_id='',epoch=-1,id='',complete=0 WHERE singleton=1; UPDATE compact_config SET complete=0,phase='copy' WHERE singleton=1 AND mode=1; END;")?;
+    connection.execute_batch("CREATE TRIGGER IF NOT EXISTS compact_vector_inline_update AFTER UPDATE OF embedding ON retrieval_vectors WHEN state_compact_vector_root(NEW.embedding) IS NULL BEGIN DELETE FROM compact_vector_refs WHERE index_id=OLD.index_id AND epoch=OLD.epoch AND id=OLD.id; UPDATE compact_vector_cursor SET index_id='',epoch=-1,id='',complete=0 WHERE singleton=1; UPDATE compact_config SET complete=0,phase='copy' WHERE singleton=1 AND mode=1; END;")?;
+    let mut statement = connection.prepare("SELECT index_id FROM retrieval_semantic_meta")?;
+    let ids = statement
+        .query_map([], |r| r.get::<_, String>(0))?
+        .collect::<rusqlite::Result<Vec<_>>>()?;
+    for id in ids {
+        let meta = get(connection, &id)?;
+        let revision = database::revision(connection, &meta.scope())?.to_string();
+        if meta.revision != revision {
+            rebuild(connection, &meta, &revision)?;
+        }
+    }
+    Ok(())
+}
+
+pub fn configure(
+    connection: &Connection,
+    id: &str,
+    model: &str,
+    dimensions: usize,
+    generation: &str,
+    source_kind: Option<&str>,
+) -> anyhow::Result<Value> {
+    let exists: bool = connection.query_row(
+        "SELECT EXISTS(SELECT 1 FROM retrieval_semantic_meta WHERE index_id=?1)",
+        [id],
+        |r| r.get(0),
+    )?;
+    if exists {
+        let meta = get(connection, id)?;
+        meta.identity(model, dimensions, generation)?;
+        source::configure(connection, id, source_kind, true)?;
+        super::scoped::ensure(connection,id,meta.epoch)?;
+        return source::decorate(connection, id, meta.status_value());
+    }
+    let count: i64 =
+        connection.query_row("SELECT count(*) FROM retrieval_semantic_meta", [], |r| {
+            r.get(0)
+        })?;
+    if count >= 128 {
+        return Err(request::resource());
+    }
+    let scope = format!("{PREFIX}{id}");
+    let populated: bool = connection.query_row("SELECT EXISTS(SELECT 1 FROM state_values WHERE scope=?1 AND live=1)", [&scope], |r| r.get(0))?;
+    let revision = database::revision(connection, &scope)?.to_string();
+    connection.execute(
+        "INSERT INTO retrieval_semantic_meta VALUES(?1,?2,?3,?4,?5,-1,?6,1,0,0)",
+        params![
+            id,
+            model,
+            dimensions as i64,
+            generation,
+            if populated { "pending" } else { "ready" },
+            revision
+        ],
+    )?;
+    super::project_vectors::ensure_index(connection,id,1,&revision)?;
+    super::scoped::ensure(connection,id,1)?;
+    source::configure(connection, id, source_kind, false)?;
+    source::decorate(connection, id, get(connection, id)?.status_value())
+}
+
+pub fn replace(
+    connection: &Connection,
+    meta: &Meta,
+    key: &str,
+    value: Option<&Value>,
+) -> anyhow::Result<()> {
+    if let Some(value) = value {
+        source::validate(connection, &meta.index_id, key, value)?;
+    } else {
+        source::embedding_deleted(connection, &meta.index_id, key)?;
+    }
+    super::scoped::remove(connection,&meta.index_id,meta.epoch,key)?;
+    lexical::replace(connection, meta, key, value)?;
+    let exists: bool = connection.query_row(
+        "SELECT EXISTS(SELECT 1 FROM retrieval_vector_values WHERE index_id=?1 AND epoch=?2 AND id=?3)",
+        params![meta.index_id, meta.epoch, key],
+        |r| r.get(0),
+    )?;
+    connection.execute(
+        "DELETE FROM retrieval_vector_postings WHERE index_id=?1 AND epoch=?2 AND id=?3",
+        params![meta.index_id, meta.epoch, key],
+    )?;
+    connection.execute(
+        "DELETE FROM retrieval_vectors WHERE index_id=?1 AND epoch=?2 AND id=?3",
+        params![meta.index_id, meta.epoch, key],
+    )?;
+    super::project_vectors::replace(connection,&meta.index_id,meta.epoch,key,None)?;
+    if exists {
+        connection.execute(
+            "UPDATE retrieval_semantic_meta SET count=count-1 WHERE index_id=?1",
+            [&meta.index_id],
+        )?;
+    }
+    let Some(value) = value else {
+        super::super::search_packed::replace(connection,&meta.index_id,meta.epoch,key)?;
+        return Ok(());
+    };
+    protocol::require(value.is_object() && value["id"].as_str() == Some(key))?;
+    let model = value["model"]
+        .as_str()
+        .ok_or_else(|| protocol::error("STATE_TX_INVALID_REQUEST"))?;
+    let dimensions = value["dimensions"]
+        .as_u64()
+        .ok_or_else(|| protocol::error("STATE_TX_INVALID_REQUEST"))?;
+    let generation = value["generation"]
+        .as_str()
+        .ok_or_else(|| protocol::error("STATE_TX_INVALID_REQUEST"))?;
+    meta.identity(model, dimensions as usize, generation)?;
+    let session = value["sessionId"]
+        .as_str()
+        .ok_or_else(|| protocol::error("STATE_TX_INVALID_REQUEST"))?;
+    request::identifier(session)?;
+    request::identifier(key)?;
+    let encoded = value["embedding"]
+        .as_str()
+        .ok_or_else(|| protocol::error("STATE_TX_INVALID_REQUEST"))?;
+    let vector = lsh::decode(encoded, meta.dimensions)?;
+    connection.execute(
+        "INSERT INTO retrieval_vectors VALUES(?1,?2,?3,?4,?5)",
+        params![meta.index_id, meta.epoch, key, session, super::super::compact::vector(connection,&meta.index_id,meta.epoch,key,&lsh::blob(&vector))?],
+    )?;
+    super::project_vectors::replace(connection,&meta.index_id,meta.epoch,key,Some(session))?;
+    let mut insert = connection
+        .prepare_cached("INSERT INTO retrieval_vector_postings VALUES(?1,?2,?3,?4,?5)")?;
+    for (table, signature) in lsh::signatures(&vector).iter().enumerate() {
+        insert.execute(params![
+            meta.index_id,
+            meta.epoch,
+            table as i64,
+            signature.bucket,
+            key
+        ])?;
+    }
+    super::super::search_packed::replace(connection,&meta.index_id,meta.epoch,key)?;
+    let body=super::scoped::text(connection,&meta.index_id,meta.epoch,key)?;
+    super::scoped::replace(connection,&meta.index_id,meta.epoch,key,session,body.as_deref())?;
+    if super::super::search_packed::retiring(connection)? {
+        connection.execute("DELETE FROM retrieval_vector_postings WHERE index_id=?1 AND epoch=?2 AND id=?3",params![meta.index_id,meta.epoch,key])?;
+    }
+    connection.execute(
+        "UPDATE retrieval_semantic_meta SET count=count+1 WHERE index_id=?1",
+        [&meta.index_id],
+    )?;
+    Ok(())
+}
+
+pub fn maintain(
+    connection: &Connection,
+    id: &str,
+    key: &str,
+    value: Option<&Value>,
+) -> anyhow::Result<()> {
+    let mut meta = get(connection, id)?;
+    let revision = database::revision(connection, &meta.scope())?;
+    if protocol::counter(&meta.revision)?.checked_add(1) != Some(revision) {
+        rebuild(connection, &meta, &revision.to_string())?;
+        meta = get(connection, id)?;
+    }
+    replace(connection, &meta, key, value)?;
+    connection.execute(
+        "UPDATE retrieval_semantic_meta SET revision=?2 WHERE index_id=?1",
+        params![id, revision.to_string()],
+    )?;
+    super::project_vectors::mark_revision(connection,id,meta.epoch,&revision.to_string())?;
+    Ok(())
+}
+
+pub fn upsert(
+    connection: &Connection,
+    id: &str,
+    model: &str,
+    dimensions: usize,
+    generation: &str,
+    items: Vec<request::VectorInput>,
+) -> anyhow::Result<Value> {
+    let meta = get(connection, id)?;
+    meta.identity(model, dimensions, generation)?;
+    let mut ids = std::collections::HashSet::new();
+    for item in &items {
+        protocol::require(ids.insert(&item.id))?;
+    }
+    for item in &items {
+        let mut value = json!({"id":item.id,"sessionId":item.session_id,"embedding":item.embedding,"model":model,"dimensions":dimensions,"generation":generation});
+        if let Some(text) = &item.text {
+            value["text"] = json!(text);
+        }
+        if let Some(scope) = &item.source_scope {
+            value["sourceScope"] = json!(scope);
+        }
+        if let Some(version) = &item.source_version {
+            value["sourceVersion"] = json!(version);
+        }
+        database::write(connection, &meta.scope(), &item.id, Some(&value))?;
+    }
+    Ok(json!({"updated":items.len(),"generation":generation}))
+}
+
+pub fn delete(
+    connection: &Connection,
+    id: &str,
+    model: &str,
+    dimensions: usize,
+    generation: &str,
+    ids: &[String],
+) -> anyhow::Result<Value> {
+    let meta = get(connection, id)?;
+    meta.identity(model, dimensions, generation)?;
+    for key in ids {
+        database::write(connection, &meta.scope(), key, None)?;
+    }
+    Ok(json!({"deleted":ids.len(),"generation":generation}))
+}
+
+pub use super::semantic_meta::{Meta, get};
