+    }).unwrap_err();
+    assert_eq!(code(cause), "STATE_RETRIEVAL_RESOURCE_LIMIT");
+    drop(transaction);
+    assert!(
+        database::row(&connection, graph::NODES, "a")
+            .unwrap()
+            .value
+            .is_none()
+    );
+    assert!(
+        ids(&call(
+            &connection,
+            json!({"action":"graph_seeds","entity_names":["rollback"]})
+        )
+        .unwrap())
+        .is_empty()
+    );
+}
