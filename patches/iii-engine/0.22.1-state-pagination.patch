+use super::protocol::require;
+use rusqlite::{Connection,params};
+use serde_json::{Value,json};
+use std::collections::BTreeSet;
+
+fn category(scope:&str)->&'static str {
+    if super::storage_legacy_cache::family(scope){"legacyVectorCache"}
+    else if scope.starts_with("mem:obs:"){"toolBodies"}
+    else if scope.starts_with("mem:graph:prepared:") || scope.starts_with("mem:graph:remaps:"){"graphAuxiliary"}
+    else if scope.starts_with("mem:summary-queue:units:"){"summaryAuxiliary"}
+    else if scope=="mem:recent-searches"{"viewer"}
+    else if ["mem:routine-runs","mem:temporal-graph-work","mem:temporal-graph-pending"].contains(&scope){"completedBodies"}
+    else if scope=="retrieval:vector"{"vectorKnowledge"}
+    else if scope=="retrieval:graph-list"{"graphKnowledge"}
+    else{"otherDurableKnowledge"}
+}
+
+// Only live roots own payload occupancy. Historical roots and shared payloads
+// must not be charged repeatedly to the rows that happen to reference them.
+pub fn page(c:&Connection,after:i64,limit:usize)->anyhow::Result<Value> {
+    require(after>=0 && (1..=128).contains(&limit))?;
+    let started=std::time::Instant::now();
+    let rows=c.prepare_cached("SELECT id,kind,logical_bytes,length(payload) FROM compact_blobs WHERE id>?1 ORDER BY id LIMIT ?2")?
+        .query_map(params![after,limit as i64],|r|Ok((r.get::<_,i64>(0)?,r.get::<_,i64>(1)?,r.get::<_,i64>(2)?,r.get::<_,i64>(3)?)))?.collect::<rusqlite::Result<Vec<_>>>()?;
+    let mut categories=json!({});let mut cursor=after;let mut inspected=0;
+    for(id,kind,logical,stored)in &rows {
+        if inspected>0 && started.elapsed().as_millis()>2200{break;}
+        let mut scopes=c.prepare_cached("SELECT DISTINCT t.scope FROM compact_segments s JOIN compact_root_values t ON t.id=s.root JOIN state_rows r ON r.scope=t.scope AND r.key=t.key AND r.version=t.version WHERE s.blob=?1 AND state_compact_root(r.value)=t.id LIMIT 129")?
+            .query_map([id],|r|r.get::<_,String>(0))?.collect::<rusqlite::Result<Vec<_>>>()?;
+        let truncated=scopes.len()>128;
+        if *kind==1 {
+            let vectors:bool=c.query_row("SELECT EXISTS(SELECT 1 FROM compact_vector_refs f JOIN retrieval_vectors v ON v.index_id=f.index_id AND v.epoch=f.epoch AND v.id=f.id WHERE f.blob=?1 AND state_compact_vector_root(v.embedding)=f.blob)",[id],|r|r.get(0))?;
+            if vectors{scopes.push("retrieval:vector".to_owned());}
+        }
+        if *kind==2 {
+            let graph:bool=c.query_row("SELECT EXISTS(SELECT 1 FROM compact_graph_lists g JOIN retrieval_identifiers i ON i.epoch=g.epoch AND i.id=g.key JOIN retrieval_nodes n ON n.epoch=i.epoch AND n.key=i.value WHERE g.list=?1)",[id],|r|r.get(0))?;
+            if graph{scopes.push("retrieval:graph-list".to_owned());}
+        }
+        // This is exactly the native collector's incoming-reference predicate.
+        // Absence of live row ownership alone cannot authorize collection.
+        let collectible:bool=c.query_row("SELECT NOT EXISTS(SELECT 1 FROM compact_segments WHERE blob=?1) AND NOT EXISTS(SELECT 1 FROM compact_vector_refs WHERE blob=?1) AND NOT EXISTS(SELECT 1 FROM compact_graph_lists WHERE list=?1)",[id],|r|r.get(0))?;
+        let owners:BTreeSet<_>=scopes.iter().map(|scope|category(scope)).collect();
+        let owner=if truncated || owners.len()>1{"sharedAcrossCategories"}else{owners.first().copied().unwrap_or("unreferenced")};
+        if !categories[owner].is_object(){categories[owner]=json!({"blobs":0,"logicalBytes":0,"compressedPayloadBytes":0,"lists":0,"collectorCandidateBlobs":0,"collectorCandidatePayloadBytes":0});}
+        let slot=&mut categories[owner];
+        for(field,delta)in[("blobs",1),("logicalBytes",*logical),("compressedPayloadBytes",*stored),("lists",i64::from(*kind==2)),("collectorCandidateBlobs",i64::from(collectible)),("collectorCandidatePayloadBytes",if collectible{*stored}else{0})]{slot[field]=json!(slot[field].as_i64().unwrap_or(0)+delta);}
+        cursor=*id;inspected+=1;
+    }
+    Ok(json!({"afterBlob":after,"cursor":cursor,"done":rows.len()<limit && inspected==rows.len(),"inspected":inspected,"categories":categories,"elapsedMs":started.elapsed().as_millis(),"coverage":"unique compact blob payloads; excludes SQLite pages, indexes, root/segment metadata, identifier dictionary and inline rollback images","consistency":"keyset_live"}))
+}
diff --git a/engine/src/workers/state/adapters/sqlite/storage_diagnostics.rs b/engine/src/workers/state/adapters/sqlite/storage_diagnostics.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/storage_diagnostics.rs
@@ -0,0 +1,77 @@
+use super::protocol::require;
+use rusqlite::{Connection, params};
+use serde::{Deserialize, Serialize};
+use serde_json::{Value, json};
+use std::{collections::BTreeMap, path::{Path, PathBuf}};
+
+#[derive(Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct Cursor { pub scope: String, pub key: String }
+fn file_bytes(path: &Path) -> anyhow::Result<u64> {
+    match std::fs::metadata(path) {
+        Ok(metadata) => Ok(metadata.len()),
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => Ok(0),
+        Err(error) => Err(error.into()),
+    }
+}
+pub fn physical(connection: &Connection, path: &Path) -> anyhow::Result<Value> {
+    let page_size: i64 = connection.pragma_query_value(None, "page_size", |row| row.get(0))?;
+    let page_count: i64 = connection.pragma_query_value(None, "page_count", |row| row.get(0))?;
+    let free: i64 = connection.pragma_query_value(None, "freelist_count", |row| row.get(0))?;
+    let auto: i64 = connection.pragma_query_value(None, "auto_vacuum", |row| row.get(0))?;
+    let journal: String = connection.pragma_query_value(None, "journal_mode", |row| row.get(0))?;
+    Ok(json!({"page_size":page_size,"page_count":page_count,"freelist_count":free,
+        "reusable_bytes":free.saturating_mul(page_size),"allocated_page_bytes":page_count.saturating_mul(page_size),
+        "auto_vacuum":auto,"journal_mode":journal,"database_bytes":file_bytes(path)?,
+        "wal_bytes":file_bytes(&PathBuf::from(format!("{}-wal",path.display())))?}))
+}
+fn category(scope: &str) -> &'static str {
+    if scope.starts_with("mem:obs-identity:") || scope.starts_with("mem:obs-events:") { "observation_identity" }
+    else if scope.starts_with("mem:obs:") { "observations" }
+    else if scope.starts_with("mem:emb:") || scope.starts_with("mem:latent:") || scope.starts_with("mem:image-embeddings") { "embeddings" }
+    else if scope.starts_with("mem:semantic") || scope.starts_with("mem:index:") { "search_state" }
+    else if ["mem:graph:nodes","mem:graph:edges","mem:graph:snapshot","mem:graph:name-index","mem:graph:edge-key","mem:graph:node-degree","mem:graph:edge-history"].contains(&scope) { "durable_graph" }
+    else if scope.starts_with("mem:graph:") { "graph_technical" }
+    else if scope == "mem:audit" { "audit" }
+    else if scope == "mem:recent-operations" { "operations" }
+    else if scope.starts_with("mem:summary-queue:") { "summary_queue" }
+    else if scope.starts_with("mem:fireworks-batch:") || scope == "mem:batch-callbacks" { "provider_queue" }
+    else if ["mem:metrics","mem:health","mem:access","mem:recent-searches","mem:routine-runs","mem:signals"].contains(&scope) { "technical_history" }
+    else if ["mem:memories","mem:summaries","mem:lessons","mem:insights","mem:decisions","mem:procedural","mem:profiles","mem:crystals"].contains(&scope) { "useful_memory" }
+    else if scope == "mem:sessions" { "sessions" }
+    else { "other_state" }
+}
+pub fn page(connection: &Connection, path: &Path, cursor: Option<Cursor>, limit: usize, max_bytes: u64) -> anyhow::Result<Value> {
+    require((1..=1024).contains(&limit) && (1024..=1024*1024).contains(&max_bytes))?;
+    let cursor = cursor.unwrap_or(Cursor {scope:String::new(), key:String::new()});
+    require(cursor.scope.len() <= 4096 && cursor.key.len() <= 4096)?;
+    let mut statement = connection.prepare_cached("SELECT scope,key,value_bytes,COALESCE(length(value),0),value IS NULL FROM state_rows WHERE (scope,key)>(?1,?2) ORDER BY scope,key LIMIT ?3")?;
+    let mut rows = statement.query(params![cursor.scope,cursor.key,(limit+1) as i64])?;
+    let mut groups: BTreeMap<&str, [u64;4]> = BTreeMap::new();
+    let mut scanned = 0;
+    let mut cursor_bytes = 0u64;
+    let mut next = cursor;
+    let mut done = true;
+    while let Some(row) = rows.next()? {
+        let scope: String = row.get(0)?;
+        let key: String = row.get(1)?;
+        let cost = (scope.len()+key.len()+64) as u64;
+        if scanned == limit || (scanned > 0 && cursor_bytes.saturating_add(cost) > max_bytes) { done = false; break; }
+        let logical: i64 = row.get(2)?;
+        let stored: i64 = row.get(3)?;
+        let tombstone: bool = row.get(4)?;
+        let counts = groups.entry(category(&scope)).or_default();
+        counts[0] += 1;
+        counts[1] += u64::try_from(logical)?;
+        counts[2] += u64::try_from(stored)?;
+        counts[3] += u64::from(tombstone);
+        next = Cursor {scope,key};
+        scanned += 1;
+        cursor_bytes += cost;
+    }
+    let categories: Vec<Value> = groups.into_iter().map(|(category,counts)|json!({"category":category,"rows":counts[0],"logical_bytes":counts[1],"stored_bytes":counts[2],"tombstones":counts[3]})).collect();
+    Ok(json!({"category_version":1,"sampled_at":chrono::Utc::now().to_rfc3339_opts(chrono::SecondsFormat::Millis,true),
+        "consistency":"keyset_live","complete":done,"done":done,"rows_scanned":scanned,"categories":categories,
+        "cursor":if done {Value::Null} else {serde_json::to_value(next)?},"physical":physical(connection,path)?,
+        "coverage":"state_rows only; shared compact payload, rollback copies, native indexes and SQLite overhead excluded from categories and included in physical bytes"}))
+}
diff --git a/engine/src/workers/state/adapters/sqlite/storage_forward_repack.rs b/engine/src/workers/state/adapters/sqlite/storage_forward_repack.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/storage_forward_repack.rs
@@ -0,0 +1,361 @@
+#[cfg(test)]
+mod tests;
+
+use super::{protocol::{error, require, Guard}, storage_repack};
+use rusqlite::{Connection, OptionalExtension, params, functions::FunctionFlags};
+use serde::{Deserialize, Serialize};
+use serde_json::{Value, json};
+use sha2::{Digest, Sha256};
+use std::time::{Duration, Instant};
+
+const BLOCK: usize = 64;
+const MAX_PAYLOAD: usize = 2 + 2 + 9 * (BLOCK + 1);
+
+#[derive(Clone, Copy, Deserialize, Serialize, PartialEq)]
+#[serde(rename_all="snake_case")]
+pub enum Step { Begin, Copy, Verify, Layout, Cancel, Resume, Cut, Rollback, Abort, Discard, Retire, Measure }
+#[derive(Clone, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct Request {
+    pub operation_id: String, pub job_id: String, pub expected_ordinal: u64,
+    pub step: Step,
+    #[serde(default="default_ms")] pub max_ms: u64,
+    #[serde(default="default_bytes")] pub max_bytes: usize,
+    #[serde(default="default_limit")] pub limit: usize,
+    pub owner_id: String, pub fence: u64, pub guard: Guard,
+}
+fn default_ms() -> u64 { 3000 }
+fn default_bytes() -> usize { 4*1024*1024 }
+fn default_limit() -> usize { 1_000_000 }
+impl Request {
+    pub fn validate(&self) -> anyhow::Result<()> {
+        require(!self.operation_id.is_empty() && self.operation_id.len()<=128 && !self.job_id.is_empty() && self.job_id.len()<=96
+            && (1..=1_000_000).contains(&self.limit) && (16384..=4*1024*1024).contains(&self.max_bytes)
+            && (1..=if matches!(self.step,Step::Cut|Step::Retire|Step::Layout){60_000}else{3000}).contains(&self.max_ms))
+    }
+}
+
+fn put(mut value: u64, bytes: &mut Vec<u8>) {
+    while value>=128 {bytes.push((value as u8 & 127)|128);value>>=7;}
+    bytes.push(value as u8);
+}
+fn take(bytes: &[u8], offset: &mut usize) -> anyhow::Result<u64> {
+    let mut value=0u64;
+    for shift in (0..=56).step_by(7) {
+        let byte=*bytes.get(*offset).ok_or_else(||error("STATE_FORWARD_CORRUPT"))?;
+        *offset+=1;value|=u64::from(byte&127)<<shift;
+        if byte&128==0 {
+            require(shift==0 || byte!=0)?;
+            return Ok(value);
+        }
+    }
+    Err(error("STATE_FORWARD_CORRUPT"))
+}
+fn encode(ids: &[i64]) -> anyhow::Result<Vec<u8>> {
+    require(ids.len()<=BLOCK+1)?;
+    let mut bytes=vec![1];put(ids.len() as u64,&mut bytes);
+    let mut previous=0i64;
+    for &id in ids {require(id>previous)?;put(u64::try_from(id-previous)?,&mut bytes);previous=id;}
+    Ok(bytes)
+}
+fn decode(bytes: &[u8]) -> anyhow::Result<Vec<i64>> {
+    require(bytes.len()<=MAX_PAYLOAD && bytes.first()==Some(&1))?;
+    let mut offset=1;let count=usize::try_from(take(bytes,&mut offset)?)?;
+    require(count<=BLOCK+1)?;
+    let mut ids=Vec::with_capacity(count);let mut previous=0i64;
+    for _ in 0..count {
+        let delta=i64::try_from(take(bytes,&mut offset)?)?;require(delta>0)?;
+        previous=previous.checked_add(delta).ok_or_else(||error("STATE_FORWARD_CORRUPT"))?;
+        ids.push(previous);
+    }
+    require(offset==bytes.len())?;Ok(ids)
+}
+fn sql_error(e: impl Into<anyhow::Error>) -> rusqlite::Error {
+    rusqlite::Error::UserFunctionError(e.into().into())
+}
+pub fn register(c: &Connection) -> anyhow::Result<()> {
+    let flags=FunctionFlags::SQLITE_UTF8|FunctionFlags::SQLITE_DETERMINISTIC|FunctionFlags::SQLITE_INNOCUOUS;
+    c.create_scalar_function("state_forward_ids",1,flags,|ctx| {
+        serde_json::to_string(&decode(&ctx.get::<Vec<u8>>(0)?).map_err(sql_error)?).map_err(sql_error)
+    })?;
+    c.create_scalar_function("state_forward_count",1,flags,|ctx| {
+        Ok(decode(&ctx.get::<Vec<u8>>(0)?).map_err(sql_error)?.len() as i64)
+    })?;
+    c.create_scalar_function("state_forward_edit",3,flags,|ctx| {
+        let mut ids=ctx.get::<Option<Vec<u8>>>(0)?.map(|b|decode(&b)).transpose().map_err(sql_error)?.unwrap_or_default();
+        let id=ctx.get::<i64>(1)?;let remove=ctx.get::<bool>(2)?;
+        if id<=0 || ids.len()>BLOCK {return Err(sql_error(error("STATE_FORWARD_CORRUPT")));}
+        match (ids.binary_search(&id),remove) {
+            (Err(at),false)=>ids.insert(at,id), (Ok(at),true)=>{ids.remove(at);}, _=>(),
+        }
+        encode(&ids).map_err(sql_error)
+    })?;
+    c.create_scalar_function("state_forward_slice",2,flags,|ctx| {
+        let ids=decode(&ctx.get::<Vec<u8>>(0)?).map_err(sql_error)?;
+        let right=ctx.get::<bool>(1)?;
+        let middle=ids.len().min(BLOCK/2);
+        encode(if right {&ids[middle..]} else {&ids[..middle]}).map_err(sql_error)
+    })?;
+    c.create_scalar_function("state_forward_split",1,flags,|ctx| {
+        decode(&ctx.get::<Vec<u8>>(0)?).map_err(sql_error)?.get(BLOCK/2).copied().ok_or_else(||sql_error(error("STATE_FORWARD_CORRUPT")))
+    })?;
+    Ok(())
+}
+
+pub fn schema(c: &Connection) -> anyhow::Result<()> {
+    c.execute_batch(include_str!("storage_forward_repack/schema.sql"))?;
+    let job=status(c)?;
+    let (writing,active):(bool,bool)=c.query_row("SELECT writing,active FROM compact_forward_config WHERE singleton=1",[],|r|Ok((r.get(0)?,r.get(1)?)))?;
+    let phase=job["phase"].as_str().unwrap_or("");
+    require(["absent","copy","ready","cancelled","cut","retired","aborted"].contains(&phase))?;
+    require(writing==["copy","ready","cancelled","cut","retired"].contains(&phase) && active==["cut","retired"].contains(&phase))?;
+    if phase=="retired" {
+        require(source(c)?.is_none())?;
+        require(c.query_row("SELECT active=1 AND writing=1 FROM compact_inverse_config WHERE singleton=1",[],|r|r.get::<_,bool>(0))?)?;
+    } else {
+        require(source(c)?.is_some())?;
+        if phase!="absent" {require(source(c)?.as_deref()==job["source_sql"].as_str())?;}
+        if writing {c.execute_batch(include_str!("storage_forward_repack/mirror.sql"))?;}
+    }
+    Ok(())
+}
+fn legacy(c: &Connection) -> anyhow::Result<()> {
+    c.execute("UPDATE compact_forward_config SET active=0,writing=0 WHERE singleton=1",[])?;
+    c.execute_batch("DROP TRIGGER IF EXISTS compact_forward_insert; DROP TRIGGER IF EXISTS compact_forward_update; DROP TRIGGER IF EXISTS compact_forward_delete; DROP TRIGGER IF EXISTS compact_forward_source_insert; DROP TRIGGER IF EXISTS compact_forward_source_update; DROP TRIGGER IF EXISTS compact_forward_source_delete;")?;
+    Ok(())
+}
+pub fn retired(c: &Connection) -> anyhow::Result<bool> {
+    let exists:bool=c.query_row("SELECT EXISTS(SELECT 1 FROM sqlite_schema WHERE name='forward_repack_job' AND type='table')",[],|r|r.get(0))?;
+    Ok(exists && status(c)?["phase"]=="retired")
+}
+pub fn status(c: &Connection) -> anyhow::Result<Value> {
+    let job:Option<String>=c.query_row("SELECT value FROM forward_repack_job WHERE singleton=1",[],|r|r.get(0)).optional()?;
+    Ok(job.map(|s|serde_json::from_str(&s)).transpose()?.unwrap_or(json!({"phase":"absent","ordinal":0})))
+}
+fn revision(c: &Connection) -> anyhow::Result<i64> {
+    Ok(c.query_row("SELECT revision FROM compact_forward_config WHERE singleton=1",[],|r|r.get(0))?)
+}
+fn source(c: &Connection) -> anyhow::Result<Option<String>> {
+    Ok(c.query_row("SELECT sql FROM sqlite_schema WHERE name='compact_list_members' AND type='table'",[],|r|r.get(0)).optional()?)
+}
+pub fn receipt(c: &Connection,r: &Request) -> anyhow::Result<Value> {
+    let saved:Option<(Vec<u8>,String)>=c.query_row("SELECT digest,result FROM forward_repack_receipts WHERE operation_id=?1",[&r.operation_id],|r|Ok((r.get(0)?,r.get(1)?))).optional()?;
+    match saved {
+        None=>Ok(json!({"status":"not_found","operation_id":r.operation_id})),
+        Some((digest,result))=>{
+            anyhow::ensure!(digest==Sha256::digest(serde_json::to_vec(r)?).to_vec(),"STATE_TX_REPLAY_CONFLICT");
+            Ok(json!({"status":"applied","operation_id":r.operation_id,"result":serde_json::from_str::<Value>(&result)?}))
+        },
+    }
+}
+pub fn proof(c: &Connection) -> anyhow::Result<Value> {
+    let job=status(c)?;
+    let current=revision(c)?;
+    Ok(json!({"job":job,"revision":current,"exact_pairs_verified":job["proof_complete"]==true && job["proof_revision"].as_i64()==Some(current) && job["inverse_revision"].as_i64()==Some(inverse_proof::revision(c)?),"original_table_protected":source(c)?.is_some(),"physical_bytes_reclaimed":null}))
+}
+
+pub fn execute(c: &Connection,path: &std::path::Path,r: Request) -> anyhow::Result<Value> {
+    r.validate()?;require(!c.is_autocommit())?;
+    let lease=storage_repack::Request {operation_id:r.operation_id.clone(),job_id:r.job_id.clone(),expected_ordinal:r.expected_ordinal,
+        step:if matches!(r.step,Step::Cut|Step::Retire|Step::Abort){storage_repack::Step::Cut}else{storage_repack::Step::Copy},max_ms:r.max_ms,max_bytes:r.max_bytes,limit:r.limit,owner_id:r.owner_id.clone(),fence:r.fence,guard:r.guard.clone()};
+    storage_repack::leases(c,&lease)?;
+    let prior=receipt(c,&r)?;if prior["status"]=="applied" {return Ok(prior["result"].clone());}
+    let mut job=status(c)?;require(job["ordinal"].as_u64()==Some(r.expected_ordinal))?;
+    if r.step==Step::Begin {
+        require(job["phase"]=="absent" && !storage_repack::protected(c)? && !super::storage_lexical_repack::protected(c)?)?;
+        require(super::storage_membership_repack::status(c)?["phase"]=="retired")?;
+        let baseline=physical::sample(c,path)?;
+        let sql=source(c)?.ok_or_else(||error("STATE_FORWARD_SOURCE_MISSING"))?;
+        let first:Option<(i64,i64)>=c.prepare_cached("SELECT list_id,identifier FROM compact_list_members  ORDER BY list_id,identifier LIMIT 1")?.query_row([],|r|Ok((r.get(0)?,r.get(1)?))).optional()?;
+        require(first.is_none_or(|(list_id,list)|list_id>0 && list>0))?;
+        require(c.query_row("SELECT NOT EXISTS(SELECT 1 FROM compact_forward_blocks)",[],|r|r.get::<_,bool>(0))?)?;
+        c.execute("UPDATE compact_forward_config SET writing=1 WHERE singleton=1",[])?;
+        c.execute_batch(include_str!("storage_forward_repack/mirror.sql"))?;
+        job=json!({"job_id":r.job_id,"owner_id":r.owner_id,"phase":"copy","ordinal":0,"cursor":null,"source_sql":sql,"baseline":baseline,"copied_pairs":0,"proof_complete":false});
+    } else if r.step==Step::Abort && job["phase"]=="absent" {
+        let sql=source(c)?.ok_or_else(||error("STATE_FORWARD_SOURCE_MISSING"))?;
+        job=json!({"job_id":r.job_id,"owner_id":r.owner_id,"phase":"absent","ordinal":0,"source_sql":sql,"proof_complete":false});
+    } else {
+        require(job["job_id"]==r.job_id && job["owner_id"]==r.owner_id)?;
+        if job["phase"]!="retired" {require(source(c)?.as_deref()==job["source_sql"].as_str())?;}
+    }
+    let mut processed=0;let mut bytes=0;
+    match r.step {
+        Step::Begin=>(),
+        Step::Discard=>{
+            require(job["phase"]=="aborted" && source(c)?.as_deref()==job["source_sql"].as_str())?;
+            require(c.query_row("SELECT writing=0 AND active=0 FROM compact_forward_config WHERE singleton=1",[],|r|r.get::<_,bool>(0))?)?;
+            let limit=r.limit.min(128).min(r.max_bytes/(MAX_PAYLOAD+64));require(limit>0)?;
+            let rows=c.prepare_cached("SELECT list_id,edge,length(payload) FROM compact_forward_blocks ORDER BY list_id,edge LIMIT ?1")?
+                .query_map([i64::try_from(limit)?],|row|Ok((row.get::<_,i64>(0)?,row.get::<_,i64>(1)?,row.get::<_,i64>(2)?)))?.collect::<rusqlite::Result<Vec<_>>>()?;
+            let keys=rows.iter().map(|row|[row.0,row.1]).collect::<Vec<_>>();
+            bytes=rows.iter().try_fold(0usize,|n,row|n.checked_add(usize::try_from(row.2)?+64).ok_or_else(||error("STATE_TX_LIMIT_EXCEEDED")))?;
+            require(bytes<=r.max_bytes)?;
+            processed=c.prepare_cached("DELETE FROM compact_forward_blocks WHERE (list_id,edge) IN(SELECT json_extract(value,'$[0]'),json_extract(value,'$[1]') FROM json_each(?1))")?.execute([serde_json::to_string(&keys)?])?;
+            require(processed==keys.len())?;
+            job["discarded_blocks"]=json!(job["discarded_blocks"].as_u64().unwrap_or(0).checked_add(processed as u64).ok_or_else(||error("STATE_TX_LIMIT_EXCEEDED"))?);
+            job["discard_complete"]=json!(c.query_row("SELECT NOT EXISTS(SELECT 1 FROM compact_forward_blocks)",[],|r|r.get::<_,bool>(0))?);
+        },
+        Step::Layout=>{
+            require(["ready","cut"].contains(&job["phase"].as_str().unwrap_or("")))?;
+            require(job["proof_complete"]==true && job["proof_revision"].as_i64()==Some(revision(c)?) && job["inverse_revision"].as_i64()==Some(inverse_proof::revision(c)?))?;
+            (processed,bytes)=physical::layout(c,&r,&mut job)?;
+        },
+        Step::Measure=>{
+            require(job["phase"]=="retired")?;
+            require(job["proof_revision"].as_i64()==Some(revision(c)?) && job["inverse_revision"].as_i64()==Some(inverse_proof::revision(c)?))?;
+            job["post_reclaim"]=physical::post_reclaim(c,path,&job)?;
+        },
+        Step::Copy=>{require(job["phase"]=="copy")?;(processed,bytes)=copy(c,&r,&mut job)?;},
+        Step::Verify=>{
+            require(["ready","cut"].contains(&job["phase"].as_str().unwrap_or("")))?;
+            (processed,bytes)=verify(c,&r,&mut job)?;
+        },
+        Step::Cancel=>{
+            require(["copy","ready"].contains(&job["phase"].as_str().unwrap_or("")))?;
+            job["resume_phase"]=job["phase"].clone();job["phase"]=json!("cancelled");
+        },
+        Step::Resume=>{
+            require(job["phase"]=="cancelled" && ["copy","ready"].contains(&job["resume_phase"].as_str().unwrap_or("")))?;
+            job["phase"]=job["resume_phase"].clone();
+        },
+        Step::Cut|Step::Retire=>{
+            require(job["phase"]==if r.step==Step::Cut{"ready"}else{"cut"})?;
+            require(job["proof_complete"]==true && job["proof_revision"].as_i64()==Some(revision(c)?) && job["inverse_revision"].as_i64()==Some(inverse_proof::revision(c)?))?;
+            c.flush_prepared_statement_cache();
+            if r.step==Step::Cut {c.execute("UPDATE compact_forward_config SET active=1 WHERE singleton=1",[])?;job["phase"]=json!("cut");}
+            else {
+                let cost=physical::retirement_gate(c,path,&job)?;
+                c.execute_batch(include_str!("storage_forward_repack/retire.sql"))?;
+                job["physical_gate"]=cost;job["phase"]=json!("retired");
+            }
+        },
+        Step::Rollback=>{
+            require(job["phase"]=="cut")?;
+            c.execute("UPDATE compact_forward_config SET active=0 WHERE singleton=1",[])?;
+            job["phase"]=json!("ready");job["proof_complete"]=json!(false);job["proof_revision"]=Value::Null;
+        },
+        Step::Abort=>{
+            require(["absent","copy","ready","cancelled","cut"].contains(&job["phase"].as_str().unwrap_or("")))?;
+            require(job["source_sql"].is_string() && source(c)?.as_deref()==job["source_sql"].as_str())?;
+            c.flush_prepared_statement_cache();
+            c.execute("UPDATE compact_forward_config SET active=0,writing=0,revision=revision+1 WHERE singleton=1",[])?;
+            legacy(c)?;
+            job["aborted_from_phase"]=job["phase"].clone();job["phase"]=json!("aborted");
+            job["proof_complete"]=json!(false);job["proof_revision"]=Value::Null;
+        },
+    }
+    job["ordinal"]=json!(r.expected_ordinal.checked_add(1).ok_or_else(||error("STATE_TX_LIMIT_EXCEEDED"))?);
+    c.execute("INSERT INTO forward_repack_job VALUES(1,?1) ON CONFLICT(singleton) DO UPDATE SET value=excluded.value",[serde_json::to_string(&job)?])?;
+    let result=json!({"operation_id":r.operation_id,"job":job,"processed_units":processed,"work_bytes":bytes,"original_table_protected":source(c)?.is_some(),"physical_bytes_reclaimed":null});
+    c.execute("INSERT INTO forward_repack_receipts VALUES(?1,?2,?3)",params![r.operation_id,Sha256::digest(serde_json::to_vec(&r)?).to_vec(),serde_json::to_string(&result)?])?;
+    Ok(result)
+}
+
+fn time(r: &Request, started: Instant) -> bool {
+    started.elapsed()<Duration::from_millis(r.max_ms.saturating_sub(200).min(1500))
+}
+fn pair_page(c: &Connection,cursor: &Value,limit: usize) -> anyhow::Result<Vec<(i64,i64)>> {
+    let mut statement=c.prepare_cached("SELECT list_id,identifier FROM compact_list_members  WHERE (list_id,identifier)>(?1,?2) ORDER BY list_id,identifier LIMIT ?3")?;
+    Ok(statement.query_map(params![cursor[0].as_i64().unwrap_or(0),cursor[1].as_i64().unwrap_or(0),i64::try_from(limit.min(512))?],|r|Ok((r.get(0)?,r.get(1)?)))?.collect::<rusqlite::Result<_>>()?)
+}
+fn copy(c: &Connection,r: &Request,job: &mut Value) -> anyhow::Result<(usize,usize)> {
+    let started=Instant::now();let mut rows=0;let mut bytes=0;
+    while rows<r.limit && (rows==0 || time(r,started)) {
+        // Reserve worst-case existing blocks and new encoded blocks per pair, then charge actual work.
+        let reserve=4*MAX_PAYLOAD+4*BLOCK*8+256;
+        if bytes+reserve>r.max_bytes {require(rows>0)?;break;}
+        let page=pair_page(c,&job["cursor"],(r.limit-rows).min((r.max_bytes-bytes)/reserve))?;
+        if page.is_empty() {job["phase"]=json!("ready");break;}
+        let mut offset=0;
+        while offset<page.len() {
+            let list_id=page[offset].0;let end=offset+page[offset..].iter().take_while(|p|p.0==list_id).count();
+            let ids=page[offset..end].iter().map(|p|p.1).collect::<Vec<_>>();
+            bytes+=merge(c,list_id,&ids)?;rows+=ids.len();
+            job["cursor"]=json!([list_id,*ids.last().unwrap()]);offset=end;
+            if !time(r,started) {break;}
+        }
+    }
+    job["copied_pairs"]=json!(job["copied_pairs"].as_u64().unwrap_or(0)+rows as u64);
+    require(bytes<=r.max_bytes)?;
+    Ok((rows,bytes))
+}
+fn merge(c: &Connection,list_id:i64,ids:&[i64]) -> anyhow::Result<usize> {
+    let mut offset=0;let mut work=ids.len()*16;
+    while offset<ids.len() {
+        let first=ids[offset];
+        let prior:Option<(i64,Vec<u8>)>=c.prepare_cached("SELECT edge,payload FROM compact_forward_blocks WHERE list_id=?1 AND edge<=?2 ORDER BY edge DESC LIMIT 1")?
+            .query_row(params![list_id,first],|r|Ok((r.get(0)?,r.get(1)?))).optional()?;
+        let edge=prior.as_ref().map_or(0,|p|p.0);
+        let next:Option<i64>=c.prepare_cached("SELECT edge FROM compact_forward_blocks WHERE list_id=?1 AND edge>?2 ORDER BY edge LIMIT 1")?
+            .query_row(params![list_id,edge],|r|r.get(0)).optional()?;
+        let end=offset+ids[offset..].iter().take_while(|&&id|next.is_none_or(|next|id<next)).count();
+        require(end>offset)?;
+        let mut combined=prior.as_ref().map(|p|decode(&p.1)).transpose()?.unwrap_or_default();
+        require(combined.len()<=BLOCK)?;
+        work+=prior.as_ref().map_or(0,|p|p.1.len())+combined.len()*8;
+        combined.extend_from_slice(&ids[offset..end]);combined.sort_unstable();combined.dedup();
+        for (ordinal,part) in combined.chunks(BLOCK).enumerate() {
+            let boundary=if ordinal==0{edge}else{part[0]};let payload=encode(part)?;
+            work+=payload.len()+part.len()*8+64;
+            c.prepare_cached("INSERT INTO compact_forward_blocks VALUES(?1,?2,?3) ON CONFLICT(list_id,edge) DO UPDATE SET payload=excluded.payload")?
+                .execute(params![list_id,boundary,payload])?;
+        }
+        offset=end;
+    }
+    Ok(work)
+}
+fn verify(c: &Connection,r: &Request,job: &mut Value) -> anyhow::Result<(usize,usize)> {
+    let current=revision(c)?;
+    if job["proof_revision"].as_i64()!=Some(current) || job["inverse_revision"].as_i64()!=Some(inverse_proof::revision(c)?) {
+        job["inverse_revision"]=json!(inverse_proof::revision(c)?);
+        job["inverse_cursor"]=Value::Null;job["inverse_last"]=Value::Null;job["inverse_pairs"]=json!(0);job["forward_proof_complete"]=json!(false);
+        job["proof_revision"]=json!(current);job["proof_cursor"]=Value::Null;job["packed_cursor"]=Value::Null;
+        job["proof_complete"]=json!(false);job["verified_forward_pairs"]=json!(0);job["verified_packed_pairs"]=json!(0);
+    }
+    if job["proof_complete"]==true {return Ok((0,0));}
+    if job["forward_proof_complete"]==true {return inverse_proof::verify(c,r,job);}
+    let started=Instant::now();let mut pairs=0;let mut bytes=0;
+    while pairs<r.limit && (pairs==0 || time(r,started)) {
+        let reserve=4*MAX_PAYLOAD+4*BLOCK*8+256;
+        if bytes+reserve>r.max_bytes {require(pairs>0)?;break;}
+        let limit=(r.limit-pairs).min((r.max_bytes-bytes)/reserve).min(512);
+        let source=pair_page(c,&job["proof_cursor"],limit)?;
+        let (packed,cursor,work)=packed_page(c,&job["packed_cursor"],limit)?;
+        // Sorted pair equality plus simultaneous exhaustion proves inclusion in both directions.
+        anyhow::ensure!(source==packed,"STATE_FORWARD_PAIR_MISMATCH");
+        bytes+=work+source.len()*16;
+        if source.is_empty() {job["forward_proof_complete"]=json!(true);break;}
+        let last=source.last().unwrap();job["proof_cursor"]=json!([last.0,last.1]);job["packed_cursor"]=cursor;
+        pairs+=source.len();
+        job["verified_forward_pairs"]=json!(job["verified_forward_pairs"].as_u64().unwrap_or(0)+source.len() as u64);
+        job["verified_packed_pairs"]=json!(job["verified_packed_pairs"].as_u64().unwrap_or(0)+packed.len() as u64);
+    }
+    require(bytes<=r.max_bytes)?;Ok((pairs,bytes))
+}
+fn packed_page(c: &Connection,after: &Value,limit: usize) -> anyhow::Result<(Vec<(i64,i64)>,Value,usize)> {
+    let mut cursor=after.clone();let mut pairs=Vec::with_capacity(limit);let mut work=0;
+    while pairs.len()<limit {
+        let list_id=cursor["list_id"].as_i64().unwrap_or(0);let edge=cursor["edge"].as_i64().unwrap_or(-1);
+        let offset=usize::try_from(cursor["offset"].as_u64().unwrap_or(0))?;
+        let partial=cursor["partial"].as_bool().unwrap_or(false);
+        let row:Option<(i64,i64,Vec<u8>)>=if partial {
+            c.prepare_cached("SELECT list_id,edge,payload FROM compact_forward_blocks WHERE list_id=?1 AND edge=?2")?
+                .query_row(params![list_id,edge],|r|Ok((r.get(0)?,r.get(1)?,r.get(2)?))).optional()?
+        } else {
+            c.prepare_cached("SELECT list_id,edge,payload FROM compact_forward_blocks WHERE (list_id,edge)>(?1,?2) ORDER BY list_id,edge LIMIT 1")?
+                .query_row(params![list_id,edge],|r|Ok((r.get(0)?,r.get(1)?,r.get(2)?))).optional()?
+        };
+        let Some((list_id,edge,payload))=row else {require(!partial)?;break;};
+        let ids=decode(&payload)?;require(!ids.is_empty() && ids.len()<=BLOCK && ids[0]>=edge)?;
+        let start=if partial{offset}else{0};require(start<ids.len())?;
+        let end=ids.len().min(start+limit-pairs.len());
+        work+=payload.len()+ids.len()*8+64;
+        pairs.extend(ids[start..end].iter().map(|&list|(list_id,list)));
+        cursor=json!({"list_id":list_id,"edge":edge,"offset":end,"partial":end<ids.len()});
+    }
+    Ok((pairs,cursor,work))
+}
+
+mod physical;
+mod inverse_proof;
