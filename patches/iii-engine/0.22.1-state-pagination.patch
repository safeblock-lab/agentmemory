+#[tokio::test]
+async fn sqlite_terminal_retention_rolls_back_cleanup_with_closing_receipt_failure() {
+    let (_directory, adapter) = fresh();
+    let owner = guard(&adapter, "retention", "1").await;
+    let id = "completed-job";
+    let scope = format!("mem:graph:inputs:{id}");
+    adapter.commit_batch(batch(owner.clone(),id,"delta:0",0,"0","staging",vec![
+        op(JOBS,id,"0",job(id,"1")),
+        op(WORKING,id,"0",working(id,"1","delta:0",None)),op(&scope,"capture","0",json!("retain until close")),
+    ])).await.unwrap();
+    let revision_scope = scope.clone();
+    let revision_before = adapter.run(4096,move |connection| database::revision(connection, &revision_scope)).await.unwrap();
+    let close = batch(
+        owner.clone(),
+        id,
+        "delta:0",
+        1,
+        "1",
+        "complete",
+        vec![op(JOBS,id,"1",json!({"version":1,"id":id,"generation":"1","state":"completed","result":{"ok":true}})),check(SNAPSHOT, "current", "0")],
+    );
+    adapter.run(4096,|connection|{ connection.execute_batch("CREATE TRIGGER fail_close BEFORE INSERT ON state_rows WHEN NEW.scope='mem:graph:receipts' BEGIN SELECT RAISE(ABORT,'close failed'); END;")?; Ok(()) }).await.unwrap();
+    assert!(adapter.commit_batch(close.clone()).await.is_err());
+    assert_eq!(
+        adapter.list(&scope).await.unwrap(),
+        vec![json!("retain until close")]
+    );
+    assert_eq!(
+        adapter.list(database::RECEIPT_SCOPE).await.unwrap().len(),
+        1
+    );
+    assert_eq!(adapter.get(JOBS,id).await.unwrap().unwrap()["state"],"applying");
+    let rollback_scope = scope.clone();
+    assert_eq!(adapter.run(4096,move |connection| database::revision(connection, &rollback_scope)).await.unwrap(),revision_before);
+    adapter
+        .run(4096, |connection| {
+            connection.execute_batch("DROP TRIGGER fail_close")?;
+            Ok(())
+        })
+        .await
+        .unwrap();
+    let receipt = adapter.commit_batch(close.clone()).await.unwrap();
+    assert_eq!(adapter.commit_batch(close).await.unwrap(), receipt);
+    adapter.graph_prune_terminal(json!({"guard":owner,"job_id":id,"expected_checkpoint_version":"2","limit":256,"max_bytes":4096})).await.unwrap();
+    assert_eq!(adapter.list(&scope).await.unwrap(), vec![json!("retain until close")]);
+    assert_eq!(adapter.get(JOBS,id).await.unwrap().unwrap()["state"],"completed");
+    let revision_scope = scope.clone();
+    let revision_after = adapter.run(4096,move |connection| database::revision(connection, &revision_scope)).await.unwrap();
+    assert_eq!(revision_after,revision_before);
+    assert_eq!(
+        adapter.list(database::RECEIPT_SCOPE).await.unwrap().len(),
+        1
+    );
+}
