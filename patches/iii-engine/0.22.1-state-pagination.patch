+use rusqlite::{Connection, params};
+use serde_json::{Value, json};
+use super::{Request, require};
+
+pub(super) fn revision(c: &Connection) -> anyhow::Result<i64> {
+    Ok(c.query_row("SELECT revision FROM compact_inverse_config WHERE singleton=1",[],|r|r.get(0))?)
+}
+pub(super) fn verify(c: &Connection,r: &Request,job: &mut Value) -> anyhow::Result<(usize,usize)> {
+    let started=std::time::Instant::now();let mut processed=0usize;let mut total_work=0usize;
+    while processed<r.limit && (processed==0 || started.elapsed()<std::time::Duration::from_millis(r.max_ms.saturating_sub(200).min(1500))) {
+    let limit=(r.limit-processed).min(512).min((r.max_bytes-total_work)/8192);
+    if limit==0 {require(processed>0)?;break;}
+    require(limit>0)?;
+    let (pairs,cursor,bytes)=super::super::storage_membership_repack::forward_proof_page(c,&job["inverse_cursor"],limit)?;
+    let mut previous=job["inverse_last"][0].as_i64().zip(job["inverse_last"][1].as_i64());
+    for pair in &pairs {
+        require(previous.is_none_or(|last|*pair>last))?;
+        previous=Some(*pair);
+    }
+    let raw=serde_json::to_string(&pairs)?;
+    let found:i64=c.query_row("SELECT count(*) FROM json_each(?1) j CROSS JOIN compact_list_members m ON m.list_id=json_extract(j.value,'$[1]') AND m.identifier=json_extract(j.value,'$[0]')",params![raw],|r|r.get(0))?;
+    require(usize::try_from(found)?==pairs.len())?;
+    let count=job["inverse_pairs"].as_u64().unwrap_or(0).checked_add(pairs.len() as u64).ok_or_else(||anyhow::anyhow!("STATE_FORWARD_PROOF_OVERFLOW"))?;
+    job["inverse_pairs"]=json!(count);job["inverse_cursor"]=cursor;
+    if let Some(pair)=previous {job["inverse_last"]=json!([pair.0,pair.1]);}
+    if pairs.is_empty() {
+        require(job["verified_forward_pairs"].as_u64()==Some(count))?;
+        job["proof_complete"]=json!(true);
+        break;
+    }
+    let work=bytes.checked_add(pairs.len()*16).ok_or_else(||anyhow::anyhow!("STATE_FORWARD_PROOF_OVERFLOW"))?;
+    total_work=total_work.checked_add(work).ok_or_else(||anyhow::anyhow!("STATE_FORWARD_PROOF_OVERFLOW"))?;
+    require(total_work<=r.max_bytes)?;processed+=pairs.len();
+    }
+    Ok((processed,total_work))
+}
