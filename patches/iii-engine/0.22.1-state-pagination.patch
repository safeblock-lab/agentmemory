+#[test]
+fn project_catalog_unknowns_paginates_and_rejects_stale_snapshot_cursors() {
+    let connection = fresh();
+    for key in ["summary-a", "summary-b", "summary-c"] {
+        unknown_summary(
+            &connection,
+            key,
+            json!({"sessionId":format!("session-{key}")}),
+        );
+    }
+    let first = diagnostics(&connection, "summaries", None, 1, 65_536).unwrap();
+    assert_eq!(first["items"].as_array().unwrap()[0]["key"], "summary-a");
+    assert_eq!(first["has_more"], true);
+    let cursor = first["next_cursor"].as_str().unwrap();
+    let token: Value = serde_json::from_str(cursor).unwrap();
+    assert_eq!(token["version"], 2);
+    assert_eq!(token["last_key"], "summary-a");
+    assert!(token.get("offset").is_none());
+    let second = diagnostics(&connection, "summaries", Some(cursor), 1, 65_536).unwrap();
+    assert_eq!(second["items"].as_array().unwrap()[0]["key"], "summary-b");
+    assert!(serde_json::to_vec(&second).unwrap().len() <= 65_536);
+
+    let mut long_key_token = token;
+    long_key_token["last_key"] = json!("x".repeat(4097));
+    let long_key_cursor = serde_json::to_string(&long_key_token).unwrap();
+    let error =
+        diagnostics(&connection, "summaries", Some(&long_key_cursor), 1, 65_536).unwrap_err();
+    assert_eq!(code(error), "STATE_TX_INVALID_REQUEST");
+    let oversized_cursor = "x".repeat(32_769);
+    let error =
+        diagnostics(&connection, "summaries", Some(&oversized_cursor), 1, 65_536).unwrap_err();
+    assert_eq!(code(error), "STATE_TX_INVALID_REQUEST");
+
+    connection
+        .execute(
+            "UPDATE retrieval_project_catalog SET epoch=epoch+1 WHERE source='summaries'",
+            [],
+        )
+        .unwrap();
+    let error = diagnostics(&connection, "summaries", Some(cursor), 1, 65_536).unwrap_err();
+    assert_eq!(code(error), "STATE_RETRIEVAL_STALE_CURSOR");
