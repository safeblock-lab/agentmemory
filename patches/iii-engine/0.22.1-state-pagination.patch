new file mode 100644
index 0000000..913c40e
--- /dev/null
+++ b/engine/src/state_migration/sqlite_wal.rs
@@ -0,0 +1,63 @@
+use anyhow::{Context, ensure};
+use rusqlite::Connection;
+use std::{fs, path::Path};
+
+pub(super) fn bytes(target: &Path) -> anyhow::Result<u64> {
+    let mut path = target.as_os_str().to_owned();
+    path.push("-wal");
+    match fs::metadata(Path::new(&path)) {
+        Ok(metadata) => Ok(metadata.len()),
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => Ok(0),
+        Err(error) => Err(error).context("Cannot measure shadow migration WAL"),
+    }
+}
+
+pub(super) fn checkpoint(output: &Connection) -> anyhow::Result<()> {
+    let (busy, log, copied): (i64, i64, i64) =
+        output.query_row("PRAGMA main.wal_checkpoint(TRUNCATE)", [], |row| {
+            Ok((row.get(0)?, row.get(1)?, row.get(2)?))
+        })?;
+    ensure!(
+        busy == 0 && log == copied,
+        "Shadow checkpoint blocked: busy={busy}, log={log}, copied={copied}; close shadow readers and resume pending target"
+    );
+    Ok(())
+}
+
+pub(super) fn pending_normal(output: &Connection) -> anyhow::Result<()> {
+    for table in ["state_migration", "shadow_transfer"] {
+        let status: String = output.query_row(
+            &format!("SELECT status FROM {table} WHERE id=1"),
+            [],
+            |row| row.get(0),
+        )?;
+        ensure!(
+            status == "pending",
+            "Bulk migration requires pending fences"
+        );
+    }
+    output.execute_batch("PRAGMA main.synchronous=NORMAL; PRAGMA main.wal_autocheckpoint=0;")?;
+    Ok(())
+}
+
+pub(super) fn after_commit(
+    output: &Connection,
+    target: &Path,
+    finish: bool,
+) -> anyhow::Result<u64> {
+    let wal = bytes(target)?;
+    ensure!(
+        wal <= 512 * 1024 * 1024,
+        "Shadow WAL exceeds 512 MiB operational bound after committed shadow transaction: {wal} bytes; target remains pending and resumable"
+    );
+    if finish || wal >= 256 * 1024 * 1024 {
+        checkpoint(output)?;
+    }
+    Ok(wal)
+}
+
+pub(super) fn full(output: &Connection) -> anyhow::Result<()> {
+    // NORMAL is restricted to reconstructible pending data. Persist it before changing any ready fence.
+    output.execute_batch("PRAGMA main.synchronous=FULL; PRAGMA main.wal_autocheckpoint=1024;")?;
+    checkpoint(output)
+}
