+                c,
+                meta,
+                &session,
+                &id,
+                &version,
+                logical,
+                kind == 0,
+                *processed,
+                *bytes,
+                max_bytes,
+            )? {
+                projection::RowResult::Blocked => return Ok(true),
+                projection::RowResult::Budget => return Ok(false),
+                projection::RowResult::Done(needed) => {
+                    *bytes += needed;
+                    *processed += 1;
+                }
+            }
