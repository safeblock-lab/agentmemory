+use super::*;
+
+mod lifecycle;
+mod paging;
+
+fn fixture() -> Connection {
+    let c = fresh();
+    let mut request = semantic_request("semantic_configure");
+    request["source_kind"] = json!("agentmemory");
+    call(&c,request).unwrap();
+    observation(&c,"session","target","obs");
+    c
+}
+
+fn observation(c: &Connection, session: &str, project: &str, id: &str) {
+    write(c,"mem:sessions",session,Some(&json!({"id":session,"project":project})));
+    let scope = format!("mem:obs:{session}");
+    write(c,&scope,id,Some(&json!({"id":id,"sessionId":session,"title":"title","narrative":"body"})));
+    embed(c,session,id);
+}
+
+fn embed(c: &Connection, session: &str, id: &str) {
+    let scope = format!("mem:obs:{session}");
+    let mut item = vector_item(id,&[1.0,0.0,0.0,0.0],Some("title body"));
+    item["session_id"] = json!(session);
+    item["source_scope"] = json!(scope);
+    item["source_version"] = json!(database::row(c,&scope,id).unwrap().version.to_string());
+    upsert(c,vec![item]).unwrap();
+}
+
+fn step(c: &Connection, project: &str, max_rows: usize) -> Value {
+    call(c,json!({"action":"index_prepare","scope":"mem:graph:browse","project":project,"max_rows":max_rows,"max_bytes":65536})).unwrap()
+}
+
+fn ready(c: &Connection, project: &str) {
+    ready_with_work(c,project,65536);
+}
+
+fn ready_with_work(c: &Connection, project: &str, work_bytes: usize) {
+    for _ in 0..10000 {
+        let result = call(c,json!({"action":"index_prepare","scope":"mem:graph:browse","project":project,"max_rows":16,"max_bytes":work_bytes})).unwrap();
+        if result["status"] == "ready" { return; }
+        assert_eq!(result["continue"],true,"{result}");
+        assert!(result["processed"].as_u64().unwrap()<=16);
+    }
+    panic!("bounded Browse preparation did not finish");
+}
+
+fn browse(c: &Connection, project: &str, cursor: Option<&str>, limit: usize, bytes: usize) -> anyhow::Result<Value> {
+    call(c,json!({"action":"graph_read","project":project,"mode":"browse","cursor":cursor,"limit":limit,"max_bytes":bytes}))
+}
+
+#[test]
+fn preparation_is_explicit_and_read_never_publishes_false_empty() {
+    let c = fixture();
+    write(&c,graph::NODES,"n",Some(&node("n","Name",&["obs"])));
+    let before = browse(&c,"target",None,128,65536).unwrap();
+    assert_eq!(before["status"],"preparing");
+    assert!(graph_browse::project(&c,"target").unwrap().is_none());
+    ready(&c,"target");
+    assert_eq!(ids(&browse(&c,"target",None,128,65536).unwrap()),vec!["n"]);
+    ready(&c,"empty");
+    let empty = browse(&c,"empty",None,128,65536).unwrap();
+    assert_eq!(empty["status"],"ready");
+    assert!(ids(&empty).is_empty());
+}
+
+#[test]
+fn unavailable_prerequisite_stops_continuation_and_invalid_original_is_explicit() {
+    let c = fresh();
+    assert_eq!(step(&c,"target",16)["continue"],false);
+    let c = fixture();
+    write(&c,graph::NODES,"invalid",Some(&json!({"id":"invalid","name":"name","sourceObservationIds":["obs"]})));
+    let mut result = step(&c,"target",16);
+    for _ in 0..20 { if result["status"]=="error" {break;} result=step(&c,"target",16); }
+    assert_eq!(result["status"],"error");
+    assert_eq!(result["reason"],"index_record_invalid");
+    assert_eq!(result["continue"],false);
+    assert!(database::row(&c,graph::NODES,"invalid").unwrap().value.is_some());
+}
