@@ -0,0 +1,67 @@
+use rusqlite::{Connection, params};
+use std::collections::HashSet;
+
+pub(super) fn apply_delta(
+    connection: &Connection,
+    epoch: i64,
+    key: &str,
+    previous: &HashSet<String>,
+    next: &HashSet<String>,
+    position: i64,
+) -> anyhow::Result<bool> {
+    let removed: Vec<_> = previous.difference(next).collect();
+    let added: Vec<_> = next.difference(previous).collect();
+    if removed.is_empty() && added.is_empty() {
+        return Ok(true);
+    }
+
+    let mut key_id = super::super::identifier_id(connection, epoch, key)?;
+    if !previous.is_empty() && key_id.is_none() {
+        return Ok(false);
+    }
+    let mut removed_ids = Vec::with_capacity(removed.len());
+    for member in removed {
+        let Some(id) = super::super::identifier_id(connection, epoch, member)? else {
+            return Ok(false);
+        };
+        removed_ids.push(id);
+    }
+    if !added.is_empty() {
+        key_id = Some(super::super::ensure_identifier_id(connection, epoch, key)?);
+    }
+    let Some(key_id) = key_id else {
+        return Ok(false);
+    };
+
+    connection.execute("DELETE FROM retrieval_orphans", [])?;
+    let mut orphan = connection
+        .prepare_cached("INSERT OR IGNORE INTO retrieval_orphans(id) VALUES(?1)")?;
+    let mut delete = connection.prepare_cached(
+        "DELETE FROM retrieval_membership WHERE epoch=?1 AND observation=?2 AND key=?3",
+    )?;
+    for id in removed_ids {
+        orphan.execute([id])?;
+        delete.execute(params![epoch, id, key_id])?;
+    }
+    let mut insert_identifier = connection.prepare_cached(
+        "INSERT OR IGNORE INTO retrieval_identifiers(epoch,value) VALUES(?1,?2)",
+    )?;
+    let mut insert_membership = connection.prepare_cached(
+        "INSERT OR IGNORE INTO retrieval_membership(epoch,observation,key,position) VALUES(?1,?2,?3,?4)",
+    )?;
+    for member in added {
+        insert_identifier.execute(params![epoch, member])?;
+        let observation_id = super::super::identifier_id(connection, epoch, member)?
+            .ok_or_else(|| super::super::super::super::protocol::error("STATE_TX_FAILED"))?;
+        insert_membership.execute(params![epoch, observation_id, key_id, position])?;
+    }
+    if next.is_empty() {
+        orphan.execute([key_id])?;
+    }
+    connection.execute(
+        "DELETE FROM retrieval_identifiers AS i WHERE i.epoch=?1 AND i.id IN (SELECT id FROM retrieval_orphans) AND NOT EXISTS(SELECT 1 FROM retrieval_inverse_membership_values WHERE epoch=i.epoch AND observation=i.id) AND NOT EXISTS(SELECT 1 FROM retrieval_membership_values WHERE epoch=i.epoch AND key=i.id)",
+        [epoch],
+    )?;
+    connection.execute("DELETE FROM retrieval_orphans", [])?;
+    Ok(true)
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/graph_browse/compact.rs b/engine/src/workers/state/adapters/sqlite/retrieval/graph_browse/compact.rs
