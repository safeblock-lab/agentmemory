+fn inline_control_triggers(c:&Connection)->anyhow::Result<()> {
+    let control="CASE WHEN NEW.scope='mem:storage-maintenance' AND NEW.key='current' THEN json_valid(state_json(NEW.value,NEW.value_bytes)) ELSE 0 END";
+    c.execute_batch(&format!("SAVEPOINT compact_control_copy_v1;
+        DROP TRIGGER IF EXISTS compact_inline_insert; DROP TRIGGER IF EXISTS compact_inline_update;
+        CREATE TRIGGER compact_inline_insert AFTER INSERT ON state_rows WHEN NEW.value IS NOT NULL AND state_compact_root(NEW.value) IS NULL AND NOT ({control}) AND EXISTS(SELECT 1 FROM compact_config WHERE mode=1) BEGIN INSERT INTO compact_copy_dirty(scope,key,version) VALUES(NEW.scope,NEW.key,NEW.version) ON CONFLICT(scope,key) DO UPDATE SET version=excluded.version; UPDATE compact_config SET complete=0 WHERE mode=1; END;
+        CREATE TRIGGER compact_inline_update AFTER UPDATE ON state_rows WHEN NEW.value IS NOT NULL AND state_compact_root(NEW.value) IS NULL AND NOT ({control}) AND EXISTS(SELECT 1 FROM compact_config WHERE mode=1) BEGIN INSERT INTO compact_copy_dirty(scope,key,version) VALUES(NEW.scope,NEW.key,NEW.version) ON CONFLICT(scope,key) DO UPDATE SET version=excluded.version; UPDATE compact_config SET complete=0 WHERE mode=1; END;
