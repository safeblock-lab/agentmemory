+    );
+    assert!(!project_vectors::ready(&c, "observations", 1).unwrap());
+    for action in ["keyword_search", "semantic_search"] {
+        let result = search(&c, "selected", action, 1);
+        assert_eq!(returned_ids(&result), vec!["a"], "{action}: {result}");
+        assert_eq!(search(&c, "foreign", action, 1)["status"], "partial");
+    }
+    let mut alias = json!({"action":"project_vector_prepare","index_id":"observations","project":"selected","source_kind":"observation"});
+    assert_eq!(call(&c, alias.clone()).unwrap()["status"], "ready");
+    alias["source_kind"] = json!("memory");
