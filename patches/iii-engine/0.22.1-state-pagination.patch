+use super::*;
+use super::super::proof as pages;
+fn observation(c:&Connection)->pages::PageRequest {
+    let r=request(c,Step::Copy);let job=status(c).unwrap();
+    pages::PageRequest{job_id:r.job_id,phase:job["phase"].as_str().unwrap().into(),ordinal:r.expected_ordinal,owner_id:r.owner_id,fence:r.fence,guard:r.guard,after_rowid:None,limit:7,max_bytes:1024,anchor:None}
+}
