+++ b/engine/src/workers/state/adapters/sqlite/graph_automatic_recovery/schema.sql
@@ -0,0 +1,73 @@
+CREATE TABLE IF NOT EXISTS engine_graph_auto_policy (
+  singleton INTEGER PRIMARY KEY CHECK(singleton=1), version INTEGER NOT NULL CHECK(version=1), declaration TEXT NOT NULL,
+  total_admitted INTEGER NOT NULL DEFAULT 0 CHECK(total_admitted>=0),
+  last_clock_ms INTEGER NOT NULL DEFAULT 0 CHECK(last_clock_ms>=0), last_admitted_ms INTEGER);
+CREATE TABLE IF NOT EXISTS engine_graph_auto_slots (
+  slot_id TEXT PRIMARY KEY, root_id TEXT NOT NULL, anchor_json TEXT NOT NULL,
+  binding_json TEXT, binding_digest TEXT, source_digest TEXT, authority_id TEXT, original_intent_json TEXT, original_intent_version TEXT NOT NULL,
+  current_attempt INTEGER NOT NULL DEFAULT 0 CHECK(current_attempt BETWEEN 0 AND 1),
+  retry_admitted INTEGER NOT NULL DEFAULT 0 CHECK(retry_admitted IN (0,1)),
+  terminal_reason TEXT, regeneration_id TEXT UNIQUE, new_job_id TEXT UNIQUE,
+  created_at_ms INTEGER NOT NULL, updated_at_ms INTEGER NOT NULL) WITHOUT ROWID;
+CREATE TABLE IF NOT EXISTS engine_graph_auto_attempts (
+  attempt_id TEXT PRIMARY KEY, slot_id TEXT NOT NULL REFERENCES engine_graph_auto_slots(slot_id),
+  root_id TEXT NOT NULL REFERENCES engine_graph_auto_slots(slot_id), ordinal INTEGER NOT NULL CHECK(ordinal BETWEEN 0 AND 1),
+  state TEXT NOT NULL CHECK(state IN ('prepared','intended','captured','completed','unknown','expired','failed')),
+  deadline_ms INTEGER NOT NULL, consumed INTEGER NOT NULL DEFAULT 0 CHECK(consumed IN (0,1)),
+  response_parts INTEGER, response_bytes INTEGER, response_digest TEXT, reason TEXT,
+  created_at_ms INTEGER NOT NULL, updated_at_ms INTEGER NOT NULL,
+  UNIQUE(root_id,ordinal)) WITHOUT ROWID;
+CREATE INDEX IF NOT EXISTS engine_graph_auto_due ON engine_graph_auto_attempts(state,deadline_ms);
+CREATE TABLE IF NOT EXISTS engine_graph_auto_parts (
+  attempt_id TEXT NOT NULL REFERENCES engine_graph_auto_attempts(attempt_id), ordinal INTEGER NOT NULL CHECK(ordinal BETWEEN 0 AND 511),
+  text TEXT NOT NULL, PRIMARY KEY(attempt_id,ordinal)) WITHOUT ROWID;
+CREATE TABLE IF NOT EXISTS engine_graph_auto_admissions (
+  admission_id TEXT PRIMARY KEY, root_id TEXT NOT NULL UNIQUE REFERENCES engine_graph_auto_slots(slot_id),
+  admitted_at_ms INTEGER NOT NULL, kind TEXT NOT NULL CHECK(kind IN ('retry','regeneration'))) WITHOUT ROWID;
+CREATE INDEX IF NOT EXISTS engine_graph_auto_admitted_at ON engine_graph_auto_admissions(admitted_at_ms);
+CREATE TABLE IF NOT EXISTS engine_graph_auto_regenerations (
+  regeneration_id TEXT PRIMARY KEY, root_id TEXT NOT NULL UNIQUE REFERENCES engine_graph_auto_slots(slot_id),
+  new_job_id TEXT NOT NULL UNIQUE, deadline_ms INTEGER NOT NULL, claimed_slot_id TEXT UNIQUE) WITHOUT ROWID;
+CREATE TABLE IF NOT EXISTS engine_graph_auto_events (
+  sequence INTEGER PRIMARY KEY AUTOINCREMENT, slot_id TEXT NOT NULL, attempt_id TEXT,
+  operation TEXT NOT NULL, at_ms INTEGER NOT NULL, detail_json TEXT NOT NULL);
+CREATE TABLE IF NOT EXISTS engine_graph_auto_authorities (
+  profile_id TEXT PRIMARY KEY, declaration TEXT NOT NULL) WITHOUT ROWID;
+CREATE TABLE IF NOT EXISTS engine_graph_auto_terminal_sources (
+  root_id TEXT PRIMARY KEY REFERENCES engine_graph_auto_slots(slot_id), proof_json TEXT NOT NULL,
+  local_value_digest TEXT, delivery_slot_id TEXT, delivery_ordinal INTEGER) WITHOUT ROWID;
+CREATE TABLE IF NOT EXISTS engine_graph_auto_terminal_results (
+  job_id TEXT NOT NULL, generation TEXT NOT NULL, job_version TEXT NOT NULL, checkpoint_version TEXT NOT NULL,
+  reason TEXT NOT NULL, updated_at_ms INTEGER NOT NULL,
+  PRIMARY KEY(job_id,generation)) WITHOUT ROWID;
+CREATE TABLE IF NOT EXISTS engine_graph_auto_terminal_proof_revisions (
+  job_id TEXT NOT NULL, generation TEXT NOT NULL, job_version TEXT NOT NULL, checkpoint_version TEXT NOT NULL,
+  revision TEXT NOT NULL, source_proven INTEGER NOT NULL DEFAULT 0 CHECK(source_proven IN (0,1)),
+  previous_job_version TEXT, previous_checkpoint_version TEXT, previous_reason TEXT, previous_updated_at_ms INTEGER,
+  PRIMARY KEY(job_id,generation)) WITHOUT ROWID;
+CREATE TABLE IF NOT EXISTS engine_graph_auto_units (
+  job_id TEXT NOT NULL, unit_id TEXT NOT NULL, slot_id TEXT NOT NULL UNIQUE,
+  delta_ordinal INTEGER NOT NULL, page_index INTEGER NOT NULL, source_index INTEGER NOT NULL, byte_offset INTEGER NOT NULL,
+  next_page INTEGER NOT NULL, next_source INTEGER NOT NULL, next_byte INTEGER NOT NULL,
+  PRIMARY KEY(job_id,unit_id)) WITHOUT ROWID;
+CREATE TABLE IF NOT EXISTS engine_graph_auto_cleanup (
+  slot_id TEXT NOT NULL REFERENCES engine_graph_auto_slots(slot_id), scope TEXT NOT NULL, prefix TEXT NOT NULL,
+  priority INTEGER NOT NULL, after_key TEXT NOT NULL DEFAULT '', done INTEGER NOT NULL DEFAULT 0,
+  PRIMARY KEY(slot_id,scope,prefix)) WITHOUT ROWID;
+CREATE TABLE IF NOT EXISTS engine_graph_auto_adoption_policy (
+  singleton INTEGER PRIMARY KEY CHECK(singleton=1),version INTEGER NOT NULL CHECK(version=1),declaration TEXT NOT NULL);
+CREATE TABLE IF NOT EXISTS engine_graph_auto_reservation_adoptions (
+  root_id TEXT NOT NULL REFERENCES engine_graph_auto_slots(slot_id),epoch INTEGER NOT NULL CHECK(epoch>0),
+  admitted_at_ms INTEGER NOT NULL,prior_deadline_ms INTEGER NOT NULL,deadline_ms INTEGER NOT NULL,
+  prior_regeneration_id TEXT NOT NULL,regeneration_id TEXT NOT NULL UNIQUE,authority_id TEXT NOT NULL,
+  before_json TEXT NOT NULL,proof_digest TEXT NOT NULL,request_digest TEXT NOT NULL,
+  PRIMARY KEY(root_id,epoch)) WITHOUT ROWID;
+CREATE INDEX IF NOT EXISTS engine_graph_auto_adoption_at ON engine_graph_auto_reservation_adoptions(admitted_at_ms);
+CREATE TABLE IF NOT EXISTS engine_graph_auto_attempt_epochs (
+  attempt_id TEXT PRIMARY KEY REFERENCES engine_graph_auto_attempts(attempt_id),epoch INTEGER NOT NULL CHECK(epoch>0)) WITHOUT ROWID;
+CREATE TABLE IF NOT EXISTS engine_graph_auto_prepare_renewals (
+  root_id TEXT NOT NULL REFERENCES engine_graph_auto_slots(slot_id),epoch INTEGER NOT NULL CHECK(epoch>=0),
+  admitted_at_ms INTEGER NOT NULL,prior_deadline_ms INTEGER NOT NULL,deadline_ms INTEGER NOT NULL,
+  regeneration_id TEXT NOT NULL,proof_json TEXT NOT NULL,
+  PRIMARY KEY(root_id,admitted_at_ms)) WITHOUT ROWID;
+CREATE INDEX IF NOT EXISTS engine_graph_auto_prepare_renewal_at ON engine_graph_auto_prepare_renewals(admitted_at_ms);
