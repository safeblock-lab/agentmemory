+    let sql = scoped::statement(true);
+    let parameters = params![
+        "observations",
+        1,
+        project,
+        1,
+        0,
+        0,
+        bucket,
+        member,
+        2,
+        false
+    ];
+    let plan = c
+        .prepare(&format!("EXPLAIN QUERY PLAN {sql}"))
+        .unwrap()
+        .query_map(parameters, |r| r.get::<_, String>(3))
+        .unwrap()
+        .collect::<rusqlite::Result<Vec<_>>>()
+        .unwrap();
+    assert!(
+        plan.iter().any(|p| p.contains("retrieval_scoped_postings")
+            && p.contains("PRIMARY KEY")
+            && p.contains("bucket=?")
+            && p.contains("session=?")),
+        "{plan:?}"
+    );
+    println!("SCOPED_ANN_EXPLAIN={plan:?}");
+    fn vm(c: &Connection, sql: &str, parameters: impl rusqlite::Params) -> (i32, usize) {
+        let mut s = c.prepare(sql).unwrap();
+        let n = s.query_map(parameters, |_| Ok(())).unwrap().count();
+        (s.get_status(StatementStatus::VmStep), n)
+    }
+    let (_, scope_session) = scoped::terms("observations", 1, project, 1, 0, member);
+    let local_query = format!("session_scope:\"{scope_session}\" AND body:\"needle\"");
+    let early = std::time::Instant::now();
+    let fts_before = vm(
+        &c,
+        scoped::LEXICAL_SQL,
+        params![local_query, 2, "observations", 1, project, false],
+    );
+    let fts_before_us = early.elapsed().as_micros();
+    let baseline = vm(
+        &c,
+        &sql,
+        params![
+            "observations",
+            1,
+            project,
+            1,
+            0,
+            0,
+            bucket,
+            member,
+            2,
+            false
+        ],
+    );
+    let before: i64 = c.query_row("PRAGMA page_count", [], |r| r.get(0)).unwrap();
+    let size: i64 = c.query_row("PRAGMA page_size", [], |r| r.get(0)).unwrap();
+    let t = c.unchecked_transaction().unwrap();
+    let mut posting = t
+        .prepare(
+            "INSERT INTO retrieval_scoped_postings VALUES('observations',1,?1,1,0,0,?2,?3,?4,1)",
+        )
+        .unwrap();
+    let mut fts=t.prepare("INSERT INTO retrieval_scoped_lexical(project_scope,session_scope,body) VALUES('foreign_scope','foreign_session','needle unrelated')").unwrap();
+    for n in 0..50_000 {
+        posting
+            .execute(params![
+                project,
+                bucket ^ u16::MAX,
+                member,
+                format!("unrelated{n:05}")
+            ])
+            .unwrap();
+        fts.execute([]).unwrap();
+    }
+    drop(posting);
+    drop(fts);
+    t.commit().unwrap();
+    let after: i64 = c.query_row("PRAGMA page_count", [], |r| r.get(0)).unwrap();
+    let start = std::time::Instant::now();
+    let grown = vm(
+        &c,
+        &sql,
+        params!["observations", 1, project, 1, 0, 0, bucket, member, 2],
+    );
+    let ann_us = start.elapsed().as_micros();
+    assert_eq!(baseline, grown);
+    assert_eq!(grown.1, 1);
+    let (p, s) = scoped::terms("observations", 1, project, 1, 0, member);
+    let query = format!("session_scope:\"{s}\" AND body:\"needle\"");
+    let fts_start = std::time::Instant::now();
+    let mut lexical = c.prepare(scoped::LEXICAL_SQL).unwrap();
+    let n = lexical
+        .query_map(params![query, 2, "observations", 1, project, false], |r| {
+            r.get::<_, i64>(0)
+        })
+        .unwrap()
+        .count();
+    assert_eq!(n, 1);
+    let fts_us = fts_start.elapsed().as_micros();
+    let fts_vm = lexical.get_status(StatementStatus::VmStep);
+    assert_eq!(fts_vm, fts_before.0);
+    assert!(fts_vm < 1000);
+    let ftsplan = c
+        .prepare(&format!("EXPLAIN QUERY PLAN {}", scoped::LEXICAL_SQL))
+        .unwrap()
+        .query_map(
+            params![
+                format!("project_scope:\"{p}\" AND body:needle"),
+                2,
+                "observations",
+                1,
+                project,
+                false
+            ],
+            |r| r.get::<_, String>(3),
+        )
+        .unwrap()
+        .collect::<rusqlite::Result<Vec<_>>>()
+        .unwrap();
+    assert!(!ftsplan.iter().any(|p| p.contains("ORDER BY")));
