+            return self.run(bytes.saturating_add(8 * 1024 * 1024), move |connection| {
+                graph_automatic_recovery::execute(connection, &path, request)
+            }).await;
+        }
+        if request.provider_budget() {
+            let request = request.into_provider_budget()?;
+            return self.run(bytes.saturating_add(256 * 1024), move |connection| {
+                provider_attempt_budget::execute(connection, &path, request)
+            }).await;
+        }
+        if let storage::Request::Reclaim {maintenance, max_pages, max_ms, checkpoint, lease_owner_id, lease_fence} = request {
+            protocol::require((1..=if maintenance {4096} else {16}).contains(&max_pages)
+                && (1..=if maintenance {3000} else {25}).contains(&max_ms)
+                && storage_maintenance_lease::valid_owner(&lease_owner_id) && lease_fence > 0
+                && if maintenance {checkpoint == "truncate"} else {["passive", "truncate"].contains(&checkpoint.as_str())})?;
+            let slot = self.reclaim_slot.clone().try_acquire_owned().ok();
+            let foreground = self.foreground_pending.clone();
+            let waiters = self.queue_waiters.clone();
+            let schedule = self.reclaim_schedule.clone();
+            return self.run_priority(bytes.saturating_add(4096), true, move |connection| {
+                let pressure = || foreground.load(Ordering::Acquire) != 0
+                    || waiters.available_permits() < MAX_SQLITE_QUEUE_WAITERS;
+                let mut schedule = schedule.lock().map_err(|_| protocol::error("STATE_TX_FAILED"))?;
+                let result = if maintenance {
+                    storage_reclaim::maintenance::cut(connection, &path, max_pages, max_ms,
+                        slot.is_some(), pressure, &lease_owner_id, lease_fence)
+                } else {
+                    storage_reclaim::cut(connection, &path, &mut schedule, max_pages, max_ms,
+                        slot.is_some(), pressure, &lease_owner_id, lease_fence)
+                };
+                drop(slot);
+                result
+            }).await;
+        }
+        if request.read_only() || request.reclamation() || request.maintenance_lease() {
+            self.run(bytes.saturating_add(1024 * 1024), move |connection| {
+                storage::execute(connection, &path, request)
+            }).await
+        } else {
+            let reserve=match &request {storage::Request::CompactApply {request}=>request.max_bytes.saturating_mul(2).saturating_add(4*1024*1024),storage::Request::TtlPage{..}=>MAX_ENVELOPE_BYTES.saturating_sub(bytes),_=>4*1024*1024};
+            if storage_profile::enabled() && matches!(&request,storage::Request::CompactApply{..}) {
+                return self.mutate_profiled(bytes.saturating_add(reserve),move |connection|storage::execute(connection,&path,request)).await;
+            }
+            self.mutate(bytes.saturating_add(reserve), move |connection| {
+                storage::execute(connection, &path, request)
+            }).await
+        }
+    }
+    async fn observation_admit(&self, input: Value) -> anyhow::Result<Value> {
+        let bytes = protocol::size(&input)?;
+        let request: observation::Admit = protocol::decode(input)?;
+        self.mutate(bytes.saturating_add(4096), move |connection| {
+            storage::bounded(connection, 3000, || observation::admit(connection, request))
+        }).await
+    }
+    async fn observation_replace(&self, input: Value) -> anyhow::Result<Value> {
+        let bytes = protocol::size(&input)?;
+        let request: observation::Replace = protocol::decode(input)?;
+        self.mutate(bytes.saturating_add(4096), move |connection| {
+            storage::bounded(connection, 3000, || observation::replace(connection, request))
+        }).await
+    }
+    async fn get_versioned(&self, input: Value) -> anyhow::Result<Value> {
+        let bytes = protocol::size(&input)?;
+        if input.get("guard").is_some_and(Value::is_null) {
+            return Err(protocol::error("STATE_TX_INVALID_REQUEST"));
+        }
+        let request: protocol::VersionedRequest = protocol::decode(input)?;
+        request.validate()?;
+        self.run(bytes, move |connection| {
+            let transaction=connection.unchecked_transaction()?;
+            commit::read_allowed(&transaction, &request.scope, &request.key, request.guard.as_ref())?;
+            let row = database::row(&transaction, &request.scope, &request.key)?;
+            Ok(serde_json::json!({"exists": row.value.is_some(), "value": row.value, "version": row.version.to_string()}))
+        }).await
+    }
+    async fn lease(&self, input: Value) -> anyhow::Result<Value> {
+        let bytes = protocol::size(&input)?;
+        let request = protocol::lease_request(input)?;
+        self.mutate(bytes, move |connection| commit::lease(connection, request))
+            .await
+    }
+    async fn commit_batch(&self, input: Value) -> anyhow::Result<Value> {
+        let bytes = protocol::size(&input)?;
+        let request: protocol::CommitRequest = protocol::decode(input)?;
+        self.mutate(bytes, move |connection| {
+            let body = request.validate(bytes)?;
+            commit::commit(connection, request, body)
+        })
+        .await
+    }
+    async fn destroy(&self) -> anyhow::Result<()> {
+        self.run(4096, |connection| {
+            connection.execute_batch("PRAGMA wal_checkpoint(TRUNCATE)")?;
+            Ok(())
+        })
+        .await
+    }
+}
+
+impl Drop for SqliteAdapter {
+    fn drop(&mut self) {
+        self.sender.take();
+        if let Some(worker) = self.worker.take() {
+            if worker.join().is_err() { tracing::error!("state SQLite worker panicked during shutdown"); }
+        }
+    }
+}
+
+fn make_adapter(_engine: Arc<Engine>, config: Option<Value>) -> StateAdapterFuture {
+    Box::pin(async move { Ok(Arc::new(SqliteAdapter::new(config)?) as Arc<dyn StateAdapter>) })
+}
+crate::register_adapter!(<StateAdapterRegistration> name: "sqlite", make_adapter);
