+        let above_scan_limit = admit_once(&connection, request(2, 12, "observation-two", Some(5000))).unwrap();
+        assert_eq!(above_scan_limit["created"], true);
+        assert!(database::row(&connection, "mem:sessions", "session").unwrap().value.is_none());
+    }
+
+    #[test]
+    fn unscoped_cap_fails_closed_at_the_scan_limit() {
+        let (_directory, connection) = test_database();
+        database::write(&connection, &identity_scope("session"), "__ready__", Some(&json!({"version":1,"ready":true}))).unwrap();
+        let transaction = connection.unchecked_transaction().unwrap();
+        {
+            let mut statement = transaction.prepare(
+                "INSERT INTO state_rows(scope,key,value,version,position,value_bytes) VALUES(?1,?2,?3,'1',?4,1)",
+            ).unwrap();
+            for position in 1..=UNSCOPED_OBSERVATION_COUNT_LIMIT {
+                statement.execute(params![
+                    identity_scope("session"),
+                    format!("identity-{position}"),
+                    vec![0xff_u8],
+                    position as i64,
+                ]).unwrap();
+            }
+        }
+        transaction.commit().unwrap();
+
+        assert_error_code(
+            admit_once(&connection, request(3, 13, "observation-three", Some(4096))).unwrap_err(),
+            "STATE_OBSERVATION_LIMIT",
+        );
+        assert_error_code(
+            admit_once(&connection, request(3, 13, "observation-three", Some(5000))).unwrap_err(),
+            "STATE_TX_LIMIT_EXCEEDED",
+        );
+    }
+
+    #[test]
+    fn absent_index_readiness_still_rejects_legacy_observations() {
+        let (_directory, connection) = test_database();
+        connection.execute(
+            "INSERT INTO state_rows(scope,key,value,version,position,value_bytes) VALUES(?1,'legacy',X'FF','1',0,1)",
+            [scope("session")],
+        ).unwrap();
+
+        assert_error_code(
+            admit_once(&connection, request(4, 14, "observation-four", Some(1))).unwrap_err(),
+            "STATE_OBSERVATION_INDEX_PENDING",
+        );
+        assert!(database::row(&connection, "mem:sessions", "session").unwrap().value.is_none());
+    }
+}
+
+#[cfg(test)]
+mod storage_source_tests {
+    use super::*;
+    fn database() -> (tempfile::TempDir, Connection) {
+        let dir = tempfile::tempdir().unwrap();
+        let connection = database::open(&dir.path().join("source.sqlite")).unwrap();
+        (dir, connection)
+    }
+    fn request(event: char, at: &str) -> Admit {
+        Admit { session_id: "s".into(), identity_digest: "a".repeat(64), event_id: event.to_string().repeat(64),
+            occurred_at: at.into(), observation: json!({"id":"o","sessionId":"s","hookType":"post_tool_use","raw":{"output":"original"}}),
+            provenance: json!({"sessionId":"s","hookType":"post_tool_use"}), session: None, max_observations: None }
+    }
+    #[test]
+    fn storage_source_old_new_event_counts_once_and_replay_survives_reopen() {
+        let (dir, connection) = database();
+        admit(&connection, request('b', "2000-01-02T00:00:00Z")).unwrap();
+        let later = admit(&connection, request('c', "2000-01-01T00:00:00Z")).unwrap();
+        assert_eq!(later["occurrence_count"], 2);
+        assert_eq!(later["first_seen_at"], "2000-01-01T00:00:00Z");
+        assert_eq!(later["last_seen_at"], "2000-01-02T00:00:00Z");
+        drop(connection);
+        let connection = database::open(&dir.path().join("source.sqlite")).unwrap();
+        let replay = admit(&connection, request('c', "2000-01-01T00:00:00Z")).unwrap();
+        assert_eq!(replay["duplicate_event"], true);
+        assert_eq!(replay["occurrence_count"], 2);
+        assert_eq!(replay["observation"]["provenance"][0]["count"], 2);
+    }
+    #[test]
+    fn storage_source_replacement_retains_originals_and_provenance() {
+        let (_dir, connection) = database();
+        let original = admit(&connection, request('b', "2000-01-01T00:00:00Z")).unwrap();
+        let response = replace(&connection, Replace { session_id:"s".into(), observation_id:"o".into(), expected_version:original["version"].as_str().unwrap().into(),
+            observation:json!({"id":"o","sessionId":"s","title":"projection","raw":"wrong","provenance":[]}) }).unwrap();
+        assert_eq!(response["observation"]["raw"], original["observation"]["raw"]);
+        assert_eq!(response["observation"]["provenance"], original["observation"]["provenance"]);
+    }
+    #[test]
+    fn storage_source_provenance_bound_refuses_without_truncating() {
+        let mut value = json!({"provenance":(0..32).map(|id| json!({"id":id,"count":1})).collect::<Vec<_>>()});
+        let original = value.clone();
+        assert!(provenance(&mut value, json!({"id":32}), "2000-01-01T00:00:00Z").is_err());
+        assert_eq!(value, original);
+    }
+    #[test]
+    fn storage_source_provenance_failure_rolls_back_new_session_and_identity() {
+        let (_dir, connection) = database();
+        let mut input=request('b', "2000-01-01T00:00:00Z");
+        input.session=Some(json!({"id":"s","observationCount":0}));
+        input.observation["provenance"]=json!((0..32).map(|id| json!({"id":id})).collect::<Vec<_>>());
+        {
+            let transaction=connection.unchecked_transaction().unwrap();
+            assert!(admit(&transaction,input).is_err());
+        }
+        assert!(database::row(&connection,"mem:sessions","s").unwrap().value.is_none());
+        assert!(database::row(&connection,"mem:obs-identity:s","__ready__").unwrap().value.is_none());
+        assert!(database::row(&connection,"mem:obs:s","o").unwrap().value.is_none());
+    }
+}
diff --git a/engine/src/workers/state/adapters/sqlite/paging.rs b/engine/src/workers/state/adapters/sqlite/paging.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/paging.rs
@@ -0,0 +1,398 @@
+use super::{LEGACY_LIST_BYTES, commit, database, protocol};
+use crate::workers::state::{
+    adapters::StatePageError,
+    structs::{STATE_PAGE_MAX_CURSOR_BYTES, StateListPageResult, StatePageConsistency},
+};
+use base64::{Engine as _, engine::general_purpose::URL_SAFE_NO_PAD};
+use rusqlite::{Connection, OptionalExtension, params};
+use serde::{
+    Deserialize, Serialize,
+    de::{DeserializeSeed, IgnoredAny, MapAccess, Visitor},
+};
+use serde_json::{Map, Value};
+use sha2::{Digest, Sha256};
+use std::fmt;
+
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Cursor {
+    version: u8,
+    generation: uuid::Uuid,
+    scope_fingerprint: String,
+    revision: String,
+    after_position: i64,
+}
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct ProjectedCursor {
+    version: u8,
+    mode: String,
+    generation: uuid::Uuid,
+    scope_fingerprint: String,
+    revision: String,
+    after_position: i64,
+    fields: Vec<String>,
+}
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct KeysetCursor {
+    version: u8,
+    mode: String,
+    generation: uuid::Uuid,
+    scope_fingerprint: String,
+    after_position: i64,
+    upper_position: i64,
+    fields: Option<Vec<String>>,
+}
+enum DecodedCursor {
+    Full(Cursor),
+    Projected(ProjectedCursor),
+    Keyset(KeysetCursor),
+}
+fn encode(cursor: &Cursor) -> Result<String, StatePageError> {
+    let encoded =
+        URL_SAFE_NO_PAD.encode(serde_json::to_vec(cursor).map_err(|_| StatePageError::Internal)?);
+    if encoded.len() > STATE_PAGE_MAX_CURSOR_BYTES {
+        return Err(StatePageError::Internal);
+    }
+    Ok(encoded)
+}
+fn encode_projected(cursor: &ProjectedCursor) -> Result<String, StatePageError> {
+    let encoded =
+        URL_SAFE_NO_PAD.encode(serde_json::to_vec(cursor).map_err(|_| StatePageError::Internal)?);
+    if encoded.len() > STATE_PAGE_MAX_CURSOR_BYTES {
+        return Err(StatePageError::Internal);
+    }
+    Ok(encoded)
+}
+fn encode_keyset(cursor: &KeysetCursor) -> Result<String, StatePageError> {
+    let encoded=URL_SAFE_NO_PAD.encode(serde_json::to_vec(cursor).map_err(|_|StatePageError::Internal)?);
+    if encoded.len()>STATE_PAGE_MAX_CURSOR_BYTES {return Err(StatePageError::Internal);}
+    Ok(encoded)
+}
+
+struct ProjectedSeed<'a>(&'a [String]);
+impl<'de> DeserializeSeed<'de> for ProjectedSeed<'_> {
+    type Value = Value;
+
+    fn deserialize<D>(self, deserializer: D) -> Result<Self::Value, D::Error>
+    where
+        D: serde::Deserializer<'de>,
+    {
+        deserializer.deserialize_map(ProjectedVisitor(self.0))
+    }
+}
+
+struct ProjectedVisitor<'a>(&'a [String]);
+impl<'de> Visitor<'de> for ProjectedVisitor<'_> {
+    type Value = Value;
+
+    fn expecting(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter.write_str("a JSON object")
+    }
+
+    fn visit_map<A>(self, mut object: A) -> Result<Self::Value, A::Error>
+    where
+        A: MapAccess<'de>,
+    {
+        let mut projected = Map::new();
+        while let Some(key) = object.next_key::<String>()? {
+            if self.0.binary_search(&key).is_ok() {
+                projected.insert(key, object.next_value()?);
+            } else {
+                object.next_value::<IgnoredAny>()?;
+            }
+        }
+        Ok(Value::Object(projected))
+    }
+}
+
+fn project_value(value: &str, fields: &[String]) -> Result<Value, StatePageError> {
+    if !value.trim_start().starts_with('{') {
+        return Err(StatePageError::ProjectedRecordNotObject);
+    }
+    let mut deserializer = serde_json::Deserializer::from_str(value);
+    let projected = ProjectedSeed(fields)
+        .deserialize(&mut deserializer)
+        .map_err(|_| StatePageError::Internal)?;
+    deserializer.end().map_err(|_| StatePageError::Internal)?;
+    Ok(projected)
+}
+pub fn list(connection: &Connection, scope: &str) -> anyhow::Result<Vec<Value>> {
+    let transaction = connection.unchecked_transaction()?;
+    commit::read_allowed(&transaction, scope, "", None)?;
+    let bytes:i64=transaction.query_row("SELECT COALESCE(SUM(value_bytes+1),0)+2 FROM state_values WHERE scope=?1 AND live=1",[scope],|r|r.get(0))?;
+    if bytes > LEGACY_LIST_BYTES as i64 - 4096 {
+        return Err(protocol::error("STATE_TX_LIMIT_EXCEEDED"));
+    }
+    let mut statement = transaction.prepare(
+        "SELECT value,value_bytes FROM state_values WHERE scope=?1 AND live=1 ORDER BY position",
+    )?;
+    let mut rows = statement.query([scope])?;
+    let mut values = Vec::new();
+    while let Some(row) = rows.next()? {
+        let encoded: Vec<u8> = row.get(0)?;
+        let logical_bytes: i64 = row.get(1)?;
+        values.push(serde_json::from_str(&database::decode_value(
+            &encoded,
+            logical_bytes,
+        )?)?);
+    }
+    Ok(values)
+}
+pub fn page(
+    connection: &Connection,
+    scope: &str,
+    cursor: Option<&str>,
+    limit: u32,
+    max_bytes: u32,
+    generation: uuid::Uuid,
+) -> Result<StateListPageResult, StatePageError> {
+    page_inner(
+        connection, scope, cursor, limit, max_bytes, None, generation, false,
+    )
+    .map_err(|error| {
+        if let Some(page) = error.downcast_ref::<PageFailure>() {
+            return page.0.clone();
+        }
+        if error
+            .downcast_ref::<protocol::TxError>()
+            .is_some_and(|e| e.0 == "STATE_GRAPH_RECOVERY_REQUIRED")
+        {
+            return StatePageError::RecoveryRequired;
+        }
+        tracing::warn!(error=?error,"SQLite state page failed");
+        StatePageError::Internal
+    })
+}
+pub fn page_projected(
+    connection: &Connection,
+    scope: &str,
+    cursor: Option<&str>,
+    limit: u32,
+    max_bytes: u32,
+    fields: &[String],
+    generation: uuid::Uuid,
+) -> Result<StateListPageResult, StatePageError> {
+    let fields = crate::workers::state::structs::canonical_state_page_fields(fields)
+        .ok_or(StatePageError::InvalidProjection)?;
+    page_inner(
+        connection,
+        scope,
+        cursor,
+        limit,
+        max_bytes,
+        Some(&fields),
+        generation,
+        false,
+    )
+    .map_err(|error| {
+        if let Some(page) = error.downcast_ref::<PageFailure>() {
+            return page.0.clone();
+        }
+        if error
+            .downcast_ref::<protocol::TxError>()
+            .is_some_and(|e| e.0 == "STATE_GRAPH_RECOVERY_REQUIRED")
+        {
+            return StatePageError::RecoveryRequired;
+        }
+        tracing::warn!(error=?error,"SQLite projected state page failed");
+        StatePageError::Internal
+    })
+}
+pub fn page_keyset(
+    connection:&Connection, scope:&str, cursor:Option<&str>, limit:u32, max_bytes:u32,
+    fields:Option<&[String]>, generation:uuid::Uuid,
+) -> Result<StateListPageResult,StatePageError> {
+    let fields=fields.map(|fields|crate::workers::state::structs::canonical_state_page_fields(fields).ok_or(StatePageError::InvalidProjection)).transpose()?;
+    page_inner(connection,scope,cursor,limit,max_bytes,fields.as_deref(),generation,true).map_err(|error| {
+        if let Some(page)=error.downcast_ref::<PageFailure>() {return page.0.clone();}
+        if error.downcast_ref::<protocol::TxError>().is_some_and(|e|e.0=="STATE_GRAPH_RECOVERY_REQUIRED") {return StatePageError::RecoveryRequired;}
+        tracing::warn!(error=?error,"SQLite keyset state page failed");
+        StatePageError::Internal
+    })
+}
+#[derive(Debug, thiserror::Error)]
+#[error("state page rejected")]
+struct PageFailure(StatePageError);
+fn reject(error: StatePageError) -> anyhow::Error {
+    PageFailure(error).into()
+}
+fn page_inner(
+    connection: &Connection,
+    scope: &str,
+    cursor: Option<&str>,
+    limit: u32,
+    max_bytes: u32,
+    fields: Option<&[String]>,
+    generation: uuid::Uuid,
+    keyset_live: bool,
+) -> anyhow::Result<StateListPageResult> {
+    if limit == 0 || limit > 1024 || max_bytes == 0 || max_bytes > 1_048_576 {
+        return Err(reject(StatePageError::InvalidCursor));
+    }
+    let decoded = cursor
+        .map(|cursor| {
+            if cursor.len() > STATE_PAGE_MAX_CURSOR_BYTES {
+                return Err(reject(StatePageError::InvalidCursor));
+            }
+            let bytes = URL_SAFE_NO_PAD
+                .decode(cursor)
+                .map_err(|_| reject(StatePageError::InvalidCursor))?;
+            if keyset_live {
+                let decoded=serde_json::from_slice::<KeysetCursor>(&bytes).map_err(|_|reject(StatePageError::InvalidCursor))?;
+                if decoded.version!=4 || decoded.mode!="keyset_live" || decoded.fields.as_deref()!=fields {return Err(reject(StatePageError::InvalidCursor));}
+                return Ok(DecodedCursor::Keyset(decoded));
+            }
+            match fields {
+                Some(fields) => {
+                    let decoded = serde_json::from_slice::<ProjectedCursor>(&bytes)
+                        .map_err(|_| reject(StatePageError::InvalidCursor))?;
+                    if decoded.version != 3
+                        || decoded.mode != "projected"
+                        || decoded.fields.as_slice() != fields
+                    {
+                        return Err(reject(StatePageError::InvalidCursor));
+                    }
+                    Ok(DecodedCursor::Projected(decoded))
+                }
+                None => {
+                    let decoded = serde_json::from_slice::<Cursor>(&bytes)
+                        .map_err(|_| reject(StatePageError::InvalidCursor))?;
+                    if decoded.version != 2 {
+                        return Err(reject(StatePageError::InvalidCursor));
+                    }
+                    Ok(DecodedCursor::Full(decoded))
+                }
+            }
+        })
+        .transpose()?;
+    let transaction = connection.unchecked_transaction()?;
+    commit::read_allowed(&transaction, scope, "", None)?;
+    let fingerprint = URL_SAFE_NO_PAD.encode(Sha256::digest(scope.as_bytes()));
+    let revision = database::revision(&transaction, scope)?.to_string();
+    let (start,upper_position) = if keyset_live {
+        let next_position:i64=transaction.query_row("SELECT next_position FROM state_scopes WHERE scope=?1",[scope],|row|row.get(0)).optional()?.unwrap_or(0);
+        if next_position<0 {return Err(reject(StatePageError::Internal));}
+        let latest=next_position.checked_sub(1).ok_or_else(||reject(StatePageError::Internal))?;
+        match decoded {
+            Some(DecodedCursor::Keyset(decoded))=>{
+                if decoded.scope_fingerprint!=fingerprint || decoded.after_position<0 || decoded.upper_position<decoded.after_position {return Err(reject(StatePageError::InvalidCursor));}
+                if decoded.generation!=generation {return Err(reject(StatePageError::StaleCursor));}
+                if decoded.upper_position>latest {return Err(reject(StatePageError::InvalidCursor));}
+                (decoded.after_position,decoded.upper_position)
+            },
+            None=>(-1,latest),
+            _=>return Err(reject(StatePageError::InvalidCursor)),
+        }
+    } else {let start = if let Some(decoded) = decoded {
+        let (cursor_generation, cursor_scope, cursor_revision, after_position) = match decoded {
+            DecodedCursor::Full(decoded) => (
+                decoded.generation,
+                decoded.scope_fingerprint,
+                decoded.revision,
+                decoded.after_position,
+            ),
+            DecodedCursor::Projected(decoded) => (
+                decoded.generation,
+                decoded.scope_fingerprint,
+                decoded.revision,
+                decoded.after_position,
+            ),
+            DecodedCursor::Keyset(_)=>return Err(reject(StatePageError::InvalidCursor)),
+        };
+        if cursor_scope != fingerprint || after_position < 0 {
+            return Err(reject(StatePageError::InvalidCursor));
+        }
+        if cursor_generation != generation || cursor_revision != revision {
+            return Err(reject(StatePageError::StaleCursor));
+        }
+        let exists: bool = transaction.query_row(
+            "SELECT EXISTS(SELECT 1 FROM state_values WHERE scope=?1 AND position=?2 AND live=1)",
+            params![scope, after_position],
+            |row| row.get(0),
+        )?;
+        if !exists {
+            return Err(reject(StatePageError::InvalidCursor));
+        }
+        after_position
+    } else {
+        -1
+    };(start,i64::MAX)};
+    let last_live_position: Option<i64> = if keyset_live {
+        transaction.query_row("SELECT position FROM state_values WHERE scope=?1 AND live=1 AND position<=?2 ORDER BY position DESC LIMIT 1",params![scope,upper_position],|row|row.get(0)).optional()?
+    } else {
+        transaction.query_row("SELECT position FROM state_values WHERE scope=?1 AND live=1 ORDER BY position DESC LIMIT 1",[scope],|row|row.get(0)).optional()?
+    };
+    let sql=if keyset_live {"SELECT position,value,value_bytes FROM state_values WHERE scope=?1 AND position>?2 AND live=1 AND position<=?4 ORDER BY position LIMIT ?3"} else {"SELECT position,value,value_bytes FROM state_values WHERE scope=?1 AND position>?2 AND live=1 ORDER BY position LIMIT ?3"};
+    let mut statement=transaction.prepare(sql)?;
+    let mut rows=if keyset_live {statement.query(params![scope,start,limit,upper_position])?} else {statement.query(params![scope,start,limit])?};
+    let mut items = Vec::with_capacity(limit as usize);
+    let mut next_cursor = None;
+    let mut item_bytes = 0usize;
+    while let Some(row) = rows.next()? {
+        let position: i64 = row.get(0)?;
+        let logical_bytes: i64 = row.get(2)?;
+        let logical_bytes = usize::try_from(logical_bytes)?;
+        let projected = fields
+            .map(|fields| {
+                let encoded: Vec<u8> = row.get(1)?;
+                let value = database::decode_value(&encoded, logical_bytes as i64)?;
+                project_value(&value, fields).map_err(reject)
+            })
+            .transpose()?;
+        let value_bytes = match &projected {
+            Some(value) => protocol::size(value)?,
+            None => logical_bytes,
+        };
+        let more = last_live_position.is_some_and(|last_position| position < last_position);
+        let candidate_cursor = if more {
+            Some(if keyset_live {encode_keyset(&KeysetCursor {version:4,mode:"keyset_live".into(),generation,scope_fingerprint:fingerprint.clone(),after_position:position,upper_position,fields:fields.map(<[String]>::to_vec)}).map_err(reject)?} else {match fields {
+                Some(fields) => encode_projected(&ProjectedCursor {
+                    version: 3,
+                    mode: "projected".to_string(),
+                    generation,
+                    scope_fingerprint: fingerprint.clone(),
+                    revision: revision.clone(),
+                    after_position: position,
+                    fields: fields.to_vec(),
+                })
+                .map_err(reject)?,
+                None => encode(&Cursor {
+                    version: 2,
+                    generation,
+                    scope_fingerprint: fingerprint.clone(),
+                    revision: revision.clone(),
+                    after_position: position,
+                })
+                .map_err(reject)?,
+            }})
+        } else {
+            None
+        };
+        let candidate_bytes = item_bytes + value_bytes + usize::from(!items.is_empty());
+        let bytes = protocol::size(&StateListPageResult {
+            items: vec![],
+            next_cursor: candidate_cursor.clone(),
+            consistency: keyset_live.then_some(StatePageConsistency::KeysetLive),
+        })? + candidate_bytes;
+        if bytes > max_bytes as usize {
+            if items.is_empty() {
+                return Err(reject(StatePageError::RecordTooLarge {
+                    required_bytes: bytes,
+                }));
+            }
+            break;
+        }
+        if let Some(projected) = projected {
+            items.push(projected);
+        } else {
+            let encoded: Vec<u8> = row.get(1)?;
+            let value = database::decode_value(&encoded, logical_bytes as i64)?;
+            items.push(serde_json::from_str(&value)?);
+        }
+        item_bytes = candidate_bytes;
+        next_cursor = candidate_cursor;
+    }
+    Ok(StateListPageResult { items, next_cursor,consistency:keyset_live.then_some(StatePageConsistency::KeysetLive) })
+}
diff --git a/engine/src/workers/state/adapters/sqlite/payload_adapter.rs b/engine/src/workers/state/adapters/sqlite/payload_adapter.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/payload_adapter.rs
@@ -0,0 +1,35 @@
+use super::{database, protocol, SqliteAdapter};
+use serde::Deserialize;
+use serde_json::Value;
+use std::time::Duration;
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(super) struct Request {
+    action: String,
+    after_blob: i64,
+    after_root: i64,
+    limit: usize,
+}
+
+pub(super) fn request(input: &Value) -> anyhow::Result<Option<Request>> {
+    if input.get("action").and_then(Value::as_str) != Some("payload_layout_screen") {
+        return Ok(None);
+    }
+    let request: Request = protocol::decode(input.clone())?;
+    protocol::require(request.action == "payload_layout_screen"
+        && request.after_blob >= 0 && request.after_root >= 0
+        && (1..=128).contains(&request.limit))?;
+    Ok(Some(request))
+}
+
+pub(super) async fn execute(adapter: &SqliteAdapter, request: Request) -> anyhow::Result<Value> {
+    let budget = database::PreparationBudget::new("payload_layout_screen", Duration::from_millis(3000));
+    let worker_budget = budget.clone();
+    let path = adapter.path.clone();
+    adapter.run_controlled(2 * 1024 * 1024, true, Some(budget), move |connection| {
+        database::run_preparation(connection, &path, &worker_budget, true, |snapshot| {
+            super::payload_probe::page(snapshot, request.after_blob, request.after_root, request.limit)
+        })
+    }).await
+}
diff --git a/engine/src/workers/state/adapters/sqlite/payload_probe.rs b/engine/src/workers/state/adapters/sqlite/payload_probe.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/payload_probe.rs
@@ -0,0 +1,70 @@
+//! Prepared native measurement only; register beside sqlite::codec after Main admission.
+use rusqlite::{params, Connection};
+use serde_json::{json, Value};
+use std::time::Instant;
+
+#[path = "text_container.rs"]
+mod text_container;
+#[path = "root_fields.rs"]
+mod root_fields;
+
+const MAX_PAGE_ROWS: usize = 128;
+const MAX_PAGE_BYTES: usize = 512 * 1024;
+const MAX_BLOCK_BYTES: usize = 256 * 1024;
+const BASELINE_BYTES: u64 = 5_711_050_488;
+const COMBINED_MINIMUM_BYTES: u64 = 285_552_525;
+
+pub fn page(c: &Connection, after_blob: i64, after_root: i64, limit: usize) -> anyhow::Result<Value> {
+    anyhow::ensure!(after_blob >= 0 && after_root >= 0 && (1..=MAX_PAGE_ROWS).contains(&limit), "STATE_TX_INVALID_REQUEST");
+    anyhow::ensure!(!c.is_autocommit(), "payload probe requires caller-owned snapshot transaction");
+    let started = Instant::now();
+    let headers = c.prepare_cached(
+        "SELECT id,logical_bytes,length(payload) FROM compact_blobs INDEXED BY compact_text_ingress_id WHERE kind=0 AND length(payload)>0 AND id>?1 ORDER BY id LIMIT ?2",
+    )?.query_map(params![after_blob, limit as i64], |r| {
+        Ok((r.get::<_, i64>(0)?, r.get::<_, i64>(1)?, r.get::<_, i64>(2)?))
+    })?.collect::<rusqlite::Result<Vec<_>>>()?;
+    let mut items = Vec::new();
+    let mut cursor = after_blob;
+    let mut decoded_bytes = 0usize;
+    let mut fetched_bytes = 0usize;
+    let mut skipped_large = 0usize;
+    let mut inspected = 0usize;
+    for (id, logical, stored) in &headers {
+        super::database::check_preparation()?;
+        if started.elapsed().as_millis() >= 1200 { break; }
+        anyhow::ensure!(*logical >= 0 && *stored >= 0, "STATE_COMPACT_CORRUPT");
+        let logical = usize::try_from(*logical)?;
+        let stored = usize::try_from(*stored)?;
+        if logical > MAX_BLOCK_BYTES || stored > MAX_BLOCK_BYTES {
+            cursor = *id;
+            inspected += 1;
+            skipped_large += 1;
+            continue;
+        }
+        if decoded_bytes + logical > MAX_PAGE_BYTES || fetched_bytes + stored > MAX_PAGE_BYTES { break; }
+        let payload: Vec<u8> = c.query_row("SELECT payload FROM compact_blobs WHERE id=?1 AND kind=0", [id], |r| r.get(0))?;
+        anyhow::ensure!(payload.len() == stored, "STATE_COMPACT_CORRUPT");
+        let text = super::codec::decode(&payload, logical)?;
+        items.push(text_container::Item { id: *id, text, stored });
+        decoded_bytes += logical;
+        fetched_bytes += stored;
+        cursor = *id;
+        inspected += 1;
+    }
+    let containers = text_container::measure(&items, MAX_BLOCK_BYTES, &started)?;
+    let roots = root_fields::page(c, after_root, limit, &started)?;
+    let receipts=super::receipt_screen::page(c)?;
+    Ok(json!({
+        "format": "payload-layout-screen-v1", "baselineBytes": BASELINE_BYTES,
+        "minimumCombinedNetSavingBytes": COMBINED_MINIMUM_BYTES,
+        "individualMinimumBytes": null,
+        "blobCursor": cursor, "blobDone": headers.len() < limit && inspected == headers.len(),
+        "inspectedBlobs": inspected, "skippedLargeBlobs": skipped_large,
+        "fetchedBytes": fetched_bytes, "decodedBytes": decoded_bytes,
+        "textContainers": containers, "rootFields": roots, "compactReceipts": receipts,
+        "elapsedMs": started.elapsed().as_millis(), "consistency": "caller_owned_snapshot",
+        "eligibleSavingsLowerBoundBytes": 0, "admission": "screening_only",
+        "resumeScope": "same_snapshot_only; separate calls establish new snapshots and independent evidence",
+        "exclusions": ["unmeasured payloads", "physical reclaim", "root field savings", "digest index savings", "unadmitted reader and migration costs"],
+    }))
+}
diff --git a/engine/src/workers/state/adapters/sqlite/protocol.rs b/engine/src/workers/state/adapters/sqlite/protocol.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/protocol.rs
@@ -0,0 +1,464 @@
+use super::{
+    MAX_ENVELOPE_BYTES,
+    database::{CHECKPOINT_SCOPE, CONTROL_SCOPE, RECEIPT_SCOPE},
+};
+use crate::protocol::ErrorBody;
+use serde::{Deserialize, Serialize};
+use serde_json::Value;
+use sha2::{Digest, Sha256};
+use std::{collections::HashSet, io::Write};
+
+pub const SNAPSHOT: &str = "mem:graph:snapshot";
+pub const WORKING: &str = "mem:graph:working-snapshots";
+pub const JOBS: &str = "mem:graph:jobs";
+pub(super) const PREFIXES: [&str; 5] = [
+    "mem:graph:inputs:",
+    "mem:graph:provider-results:",
+    "mem:graph:deltas:",
+    "mem:graph:prepared:",
+    "mem:graph:remaps:",
+];
+pub const GRAPH_RECORD_SCOPES: [&str; 7] = [
+    "mem:graph:nodes",
+    "mem:graph:edges",
+    SNAPSHOT,
+    "mem:graph:name-index",
+    "mem:graph:edge-key",
+    "mem:graph:node-degree",
+    "mem:graph:edge-history",
+];
+
+#[derive(Debug, thiserror::Error)]
+#[error("{0}: state transaction rejected")]
+pub struct TxError(pub &'static str);
+pub fn error(code: &'static str) -> anyhow::Error {
+    TxError(code).into()
+}
+pub fn require(condition: bool) -> anyhow::Result<()> {
+    if condition {
+        Ok(())
+    } else {
+        Err(error("STATE_TX_INVALID_REQUEST"))
+    }
+}
+pub fn guarded(scope: &str, key: &str) -> bool {
+    GRAPH_RECORD_SCOPES.contains(&scope)
+        || [
+            JOBS,
+            WORKING,
+            CONTROL_SCOPE,
+            CHECKPOINT_SCOPE,
+            RECEIPT_SCOPE,
+        ]
+        .contains(&scope)
+        || PREFIXES.iter().any(|prefix| scope.starts_with(prefix))
+        || (scope == "mem:batch-callbacks" && (key == "active:graph" || key.starts_with("graph:")))
+}
+pub fn live(scope: &str, key: &str) -> bool {
+    GRAPH_RECORD_SCOPES.contains(&scope) || (scope == "mem:batch-callbacks" && guarded(scope, key))
+}
+pub fn plain_write(scope: &str, key: &str) -> anyhow::Result<()> {
+    if guarded(scope, key) {
+        Err(error("STATE_TX_FENCED"))
+    } else {
+        Ok(())
+    }
+}
+pub fn error_body(cause: &anyhow::Error, fallback: &str) -> ErrorBody {
+    tracing::warn!(error = ?cause, "state operation rejected");
+    let code = cause
+        .downcast_ref::<TxError>()
+        .map_or(fallback, |error| error.0);
+    ErrorBody {
+        code: code.into(),
+        message: format!("{code}: state operation rejected"),
+        stacktrace: None,
+    }
+}
+#[derive(Default)]
+struct Size(usize);
+impl Write for Size {
+    fn write(&mut self, bytes: &[u8]) -> std::io::Result<usize> {
+        self.0 = self.0.saturating_add(bytes.len());
+        Ok(bytes.len())
+    }
+    fn flush(&mut self) -> std::io::Result<()> {
+        Ok(())
+    }
+}
+pub fn size(value: &impl Serialize) -> anyhow::Result<usize> {
+    let mut size = Size::default();
+    serde_json::to_writer(&mut size, value)?;
+    Ok(size.0)
+}
+pub fn decode<T: serde::de::DeserializeOwned>(value: Value) -> anyhow::Result<T> {
+    serde_json::from_value(value).map_err(|_| error("STATE_TX_INVALID_REQUEST"))
+}
+pub(super) fn strict_value(value: &str) -> anyhow::Result<Value> {
+    serde_json::from_str::<strict_json::StrictValue>(value).map(|value|value.0)
+        .map_err(|_|error("STATE_TX_INVALID_REQUEST"))
+}
+pub fn counter(value: &str) -> anyhow::Result<u64> {
+    require(
+        !value.is_empty()
+            && value.len() <= 20
+            && value.bytes().all(|c| c.is_ascii_digit())
+            && (value == "0" || !value.starts_with('0')),
+    )?;
+    value.parse().map_err(|_| error("STATE_TX_INVALID_REQUEST"))
+}
+pub fn next(value: u64) -> anyhow::Result<u64> {
+    value
+        .checked_add(1)
+        .ok_or_else(|| error("STATE_TX_LIMIT_EXCEEDED"))
+}
+fn ordinal(value: u64) -> bool {
+    value < 9_007_199_254_740_991
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Guard {
+    pub owner_id: String,
+    pub generation: String,
+    pub fence: String,
+}
+impl Guard {
+    pub fn validate(&self) -> anyhow::Result<()> {
+        require(
+            !self.owner_id.is_empty()
+                && counter(&self.generation)? > 0
+                && counter(&self.fence)? > 0,
+        )
+    }
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct VersionedRequest {
+    pub scope: String,
+    pub key: String,
+    pub guard: Option<Guard>,
+}
+impl VersionedRequest {
+    pub fn validate(&self) -> anyhow::Result<()> {
+        require(!self.scope.is_empty() && !self.key.is_empty())?;
+        if let Some(guard) = &self.guard {
+            guard.validate()?;
+        }
+        Ok(())
+    }
+}
+#[derive(Deserialize)]
+#[serde(tag = "action", rename_all = "lowercase", deny_unknown_fields)]
+pub enum LeaseRequest {
+    Acquire {
+        owner_id: String,
+        generation: String,
+        ttl_ms: u64,
+    },
+    Renew {
+        owner_id: String,
+        generation: String,
+        fence: String,
+        ttl_ms: u64,
+    },
+    Release {
+        owner_id: String,
+        generation: String,
+        fence: String,
+    },
+}
+pub fn lease_request(value: Value) -> anyhow::Result<LeaseRequest> {
+    let request = decode(value)?;
+    match &request {
+        LeaseRequest::Acquire {
+            owner_id,
+            generation,
+            ttl_ms,
+        } => require(
+            !owner_id.is_empty() && counter(generation)? > 0 && (1..=300_000).contains(ttl_ms),
+        )?,
+        LeaseRequest::Renew {
+            owner_id,
+            generation,
+            fence,
+            ttl_ms,
+        } => {
+            Guard {
+                owner_id: owner_id.clone(),
+                generation: generation.clone(),
+                fence: fence.clone(),
+            }
+            .validate()?;
+            require((1..=300_000).contains(ttl_ms))?;
+        }
+        LeaseRequest::Release {
+            owner_id,
+            generation,
+            fence,
+        } => Guard {
+            owner_id: owner_id.clone(),
+            generation: generation.clone(),
+            fence: fence.clone(),
+        }
+        .validate()?,
+    }
+    Ok(request)
+}
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct Identity {
+    pub generation: String,
+    pub job_id: String,
+    pub logical_delta_id: String,
+    pub chunk_ordinal: u64,
+}
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Checkpoint {
+    pub generation: String,
+    pub job_id: String,
+    pub logical_delta_id: String,
+    pub delta_ordinal: u64,
+    pub next_chunk_ordinal: u64,
+    pub visibility: String,
+}
+#[derive(Debug, Deserialize)]
+#[serde(tag = "type", rename_all = "lowercase", deny_unknown_fields)]
+pub enum Operation {
+    Set {
+        scope: String,
+        key: String,
+        expected_version: String,
+        value: Value,
+    },
+    Delete {
+        scope: String,
+        key: String,
+        expected_version: String,
+    },
+    Check {
+        scope: String,
+        key: String,
+        expected_version: String,
+    },
+}
+impl Operation {
+    pub fn row(&self) -> (&str, &str, &str) {
+        match self {
+            Self::Set {
+                scope,
+                key,
+                expected_version,
+                ..
+            }
+            | Self::Delete {
+                scope,
+                key,
+                expected_version,
+            }
+            | Self::Check {
+                scope,
+                key,
+                expected_version,
+            } => (scope, key, expected_version),
+        }
+    }
+    pub fn changed(&self) -> bool {
+        !matches!(self, Self::Check { .. })
+    }
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct CommitBody {
+    pub identity: Identity,
+    pub expected_checkpoint_version: String,
+    pub checkpoint: Checkpoint,
+    pub operations: Vec<Operation>,
+    pub advance_generation: Option<bool>,
+    pub allow_oversized_record: Option<bool>,
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct CommitRequest {
+    pub guard: Guard,
+    pub payload_json: String,
+    pub payload_digest: String,
+}
+impl CommitRequest {
+    pub fn validate(&self, bytes: usize) -> anyhow::Result<CommitBody> {
+        self.guard.validate()?;
+        require(
+            self.payload_digest.len() == 64
+                && self
+                    .payload_digest
+                    .bytes()
+                    .all(|c| c.is_ascii_digit() || (b'a'..=b'f').contains(&c)),
+        )?;
+        require(hex::encode(Sha256::digest(self.payload_json.as_bytes())) == self.payload_digest)?;
+        let strict: strict_json::StrictValue = serde_json::from_str(&self.payload_json)
+            .map_err(|_| error("STATE_TX_INVALID_REQUEST"))?;
+        for flag in ["advance_generation", "allow_oversized_record"] {
+            if let Some(value) = strict.0.get(flag) {
+                require(value == true)?;
+            }
+        }
+        if let Some(operations) = strict.0.get("operations").and_then(Value::as_array) {
+            for operation in operations {
+                if operation.get("type") == Some(&Value::String("set".into())) {
+                    require(operation.get("value").is_some())?;
+                }
+            }
+        }
+        let body: CommitBody = decode(strict.0)?;
+        body.validate()?;
+        if bytes > MAX_ENVELOPE_BYTES {
+            return Err(error("STATE_RECORD_TOO_LARGE"));
+        }
+        if bytes > 4 * 1024 * 1024 && body.allow_oversized_record != Some(true) {
+            return Err(error("STATE_TX_LIMIT_EXCEEDED"));
+        }
+        Ok(body)
+    }
+}
+impl CommitBody {
+    fn validate(&self) -> anyhow::Result<()> {
+        let id = &self.identity;
+        let point = &self.checkpoint;
+        require(
+            counter(&id.generation)? > 0
+                && !id.job_id.is_empty()
+                && !id.logical_delta_id.is_empty()
+                && ordinal(id.chunk_ordinal),
+        )?;
+        next(counter(&self.expected_checkpoint_version)?)?;
+        require(
+            point.generation == id.generation
+                && point.job_id == id.job_id
+                && point.logical_delta_id == id.logical_delta_id
+                && ordinal(point.delta_ordinal)
+                && ordinal(point.next_chunk_ordinal)
+                && point.next_chunk_ordinal == id.chunk_ordinal + 1
+                && ["staging", "applying", "complete"].contains(&point.visibility.as_str()),
+        )?;
+        require(
+            self.operations.len() <= 256
+                && self.advance_generation != Some(false)
+                && self.allow_oversized_record != Some(false),
+        )?;
+        if self.advance_generation == Some(true) {
+            require(point.visibility == "complete")?;
+            next(counter(&id.generation)?)?;
+        }
+        let mut seen = HashSet::new();
+        for op in &self.operations {
+            let (scope, key, version) = op.row();
+            require(
+                !scope.is_empty()
+                    && !key.is_empty()
+                    && guarded(scope, key)
+                    && ![CONTROL_SCOPE, CHECKPOINT_SCOPE, RECEIPT_SCOPE].contains(&scope)
+                    && seen.insert((scope, key)),
+            )?;
+            let version = counter(version)?;
+            if op.changed() {
+                next(version)?;
+            }
+            if point.visibility == "staging" {
+                require(
+                    ([JOBS, WORKING].contains(&scope) && key == id.job_id)
+                        || PREFIXES
+                            .iter()
+                            .any(|prefix| scope == format!("{prefix}{}", id.job_id)),
+                )?;
+            }
+            if point.visibility != "complete" {
+                require(scope != SNAPSHOT || !op.changed())?;
+            }
+            if ([JOBS, WORKING].contains(&scope) && key != id.job_id)
+                || (PREFIXES.iter().any(|prefix| scope.starts_with(prefix))
+                    && !PREFIXES
+                        .iter()
+                        .any(|prefix| scope == format!("{prefix}{}", id.job_id)))
+            {
+                return Err(error("STATE_TX_INVALID_REQUEST"));
+            }
+        }
+        if point.visibility == "complete" {
+            require(self.operations.iter().any(|op| {
+                let (scope, key, _) = op.row();
+                scope == SNAPSHOT && key == "current" && !matches!(op, Operation::Delete { .. })
+            }))?;
+        }
+        if self.allow_oversized_record == Some(true) {
+            require(
+                self.operations.iter().filter(|op| op.changed()).count() == 1
+                    && self
+                        .operations
+                        .iter()
+                        .any(|op| matches!(op, Operation::Set { .. })),
+            )?;
+        }
+        Ok(())
+    }
+}
+
+mod strict_json {
+    use serde::{
+        Deserialize, Deserializer,
+        de::{Error, MapAccess, SeqAccess, Visitor},
+    };
+    use serde_json::Value;
+    pub struct StrictValue(pub Value);
+    impl<'de> Deserialize<'de> for StrictValue {
+        fn deserialize<D: Deserializer<'de>>(d: D) -> Result<Self, D::Error> {
+            d.deserialize_any(StrictVisitor).map(Self)
+        }
+    }
+    struct StrictVisitor;
+    impl<'de> Visitor<'de> for StrictVisitor {
+        type Value = Value;
+        fn expecting(&self, f: &mut std::fmt::Formatter) -> std::fmt::Result {
+            f.write_str("strict JSON")
+        }
+        fn visit_unit<E: Error>(self) -> Result<Value, E> {
+            Ok(Value::Null)
+        }
+        fn visit_bool<E: Error>(self, v: bool) -> Result<Value, E> {
+            Ok(Value::Bool(v))
+        }
+        fn visit_i64<E: Error>(self, v: i64) -> Result<Value, E> {
+            Ok(v.into())
+        }
+        fn visit_u64<E: Error>(self, v: u64) -> Result<Value, E> {
+            Ok(v.into())
+        }
+        fn visit_f64<E: Error>(self, v: f64) -> Result<Value, E> {
+            serde_json::Number::from_f64(v)
+                .map(Value::Number)
+                .ok_or_else(|| E::custom("nonfinite number"))
+        }
+        fn visit_str<E: Error>(self, v: &str) -> Result<Value, E> {
+            Ok(v.into())
+        }
+        fn visit_string<E: Error>(self, v: String) -> Result<Value, E> {
+            Ok(v.into())
+        }
+        fn visit_seq<A: SeqAccess<'de>>(self, mut sequence: A) -> Result<Value, A::Error> {
+            let mut values = Vec::new();
+            while let Some(value) = sequence.next_element::<StrictValue>()? {
+                values.push(value.0);
+            }
+            Ok(Value::Array(values))
+        }
+        fn visit_map<A: MapAccess<'de>>(self, mut map: A) -> Result<Value, A::Error> {
+            let mut values = serde_json::Map::new();
+            while let Some((key, value)) = map.next_entry::<String, StrictValue>()? {
+                if values.insert(key, value.0).is_some() {
+                    return Err(A::Error::custom("duplicate key"));
+                }
+            }
+            Ok(Value::Object(values))
+        }
+    }
+}
diff --git a/engine/src/workers/state/adapters/sqlite/provider_attempt_budget.rs b/engine/src/workers/state/adapters/sqlite/provider_attempt_budget.rs
