diff --git a/engine/src/state_migration/archive.rs b/engine/src/state_migration/archive.rs
new file mode 100644
index 0000000000000000000000000000000000000000..283881ad448341d59d56b8ab3dfff8994aa24667
--- /dev/null
+++ b/engine/src/state_migration/archive.rs
@@ -0,0 +1,176 @@
+use anyhow::{Context, ensure};
+use serde::de::{DeserializeSeed, MapAccess, Visitor};
+use serde_json::Value;
+use sha2::{Digest, Sha256};
+use std::{
+    cell::Cell,
+    fmt,
+    fs::File,
+    io::{BufReader, Read, Seek, SeekFrom},
+    path::Path,
+    rc::Rc,
+};
+
+pub fn file_digest(path: &Path) -> anyhow::Result<String> {
+    let mut file = File::open(path)?;
+    let mut hash = Sha256::new();
+    let mut buffer = [0u8; 65536];
+    loop {
+        let length = file.read(&mut buffer)?;
+        if length == 0 {
+            break;
+        }
+        hash.update(&buffer[..length]);
+    }
+    Ok(format!("{:x}", hash.finalize()))
+}
+
+fn json_region(file: &mut File) -> anyhow::Result<(u64, u64)> {
+    let bytes = file.metadata()?.len();
+    ensure!(
+        bytes >= 8 && bytes % 4 == 0,
+        "Invalid legacy archive length/alignment"
+    );
+    let root = bytes - 8;
+    file.seek(SeekFrom::Start(root))?;
+    let mut header = [0u8; 8];
+    file.read_exact(&mut header)?;
+    if header[0] & 0xc0 != 0x80 {
+        ensure!(bytes == 8, "Invalid inline archive prefix");
+        let length = header.iter().position(|b| *b == 0xff).unwrap_or(8);
+        return Ok((root, length as u64));
+    }
+    let encoded = u32::from_le_bytes(header[..4].try_into()?);
+    let length = ((encoded & 0x3f) | ((encoded & !0xff) >> 2)) as u64;
+    let offset = i32::from_le_bytes(header[4..].try_into()?) as i64;
+    ensure!(
+        length > 8 && offset < 0,
+        "Invalid out-of-line archive header"
+    );
+    let start = root
+        .checked_add_signed(offset)
+        .context("Invalid archive pointer")?;
+    ensure!(
+        start == 0 && length <= root && root - length < 4,
+        "Invalid archive bounds"
+    );
+    file.seek(SeekFrom::Start(length))?;
+    let mut padding = [0u8; 3];
+    file.read_exact(&mut padding[..(root - length) as usize])?;
+    ensure!(
+        padding[..(root - length) as usize].iter().all(|b| *b == 0),
+        "Invalid archive padding"
+    );
+    Ok((start, length))
+}
+
+pub fn visit(
+    path: &Path,
+    mut row: impl FnMut(String, Value) -> anyhow::Result<()>,
+) -> anyhow::Result<()> {
+    visit_bounded(
+        path,
+        crate::workers::state::adapters::sqlite::MAX_ENVELOPE_BYTES,
+        &mut row,
+    )
+}
+
+pub(super) fn visit_bounded(
+    path: &Path,
+    limit: usize,
+    mut row: impl FnMut(String, Value) -> anyhow::Result<()>,
+) -> anyhow::Result<()> {
+    let mut file = File::open(path)?;
+    let (start, length) = json_region(&mut file)?;
+    file.seek(SeekFrom::Start(start))?;
+    let consumed = Rc::new(Cell::new(0));
+    let reader = RecordReader {
+        inner: BufReader::with_capacity(65536, file.take(length)),
+        consumed: consumed.clone(),
+        limit,
+    };
+    let mut decoder = serde_json::Deserializer::from_reader(reader);
+    Rows(&mut row, consumed).deserialize(&mut decoder)?;
+    decoder.end()?;
+    Ok(())
+}
+
+struct RecordReader<R> {
+    inner: R,
+    consumed: Rc<Cell<usize>>,
+    limit: usize,
+}
+impl<R: Read> Read for RecordReader<R> {
+    fn read(&mut self, output: &mut [u8]) -> std::io::Result<usize> {
+        if output.is_empty() {
+            return Ok(0);
+        }
+        let remaining = self.limit.saturating_sub(self.consumed.get());
+        if remaining == 0 {
+            return Err(std::io::Error::new(
+                std::io::ErrorKind::InvalidData,
+                "STATE_MIGRATION_RECORD_TOO_LARGE",
+            ));
+        }
+        let requested = output.len().min(remaining);
+        let read = self.inner.read(&mut output[..requested])?;
+        self.consumed.set(self.consumed.get() + read);
+        Ok(read)
+    }
+}
+
+struct Rows<'a, F>(&'a mut F, Rc<Cell<usize>>);
+impl<'de, F: FnMut(String, Value) -> anyhow::Result<()>> DeserializeSeed<'de> for Rows<'_, F> {
+    type Value = ();
+    fn deserialize<D: serde::Deserializer<'de>>(self, decoder: D) -> Result<(), D::Error> {
+        decoder.deserialize_map(self)
+    }
+}
+impl<'de, F: FnMut(String, Value) -> anyhow::Result<()>> Visitor<'de> for Rows<'_, F> {
+    type Value = ();
+    fn expecting(&self, formatter: &mut fmt::Formatter) -> fmt::Result {
+        formatter.write_str("legacy ordered JSON object")
+    }
+    fn visit_map<M: MapAccess<'de>>(self, mut map: M) -> Result<(), M::Error> {
+        loop {
+            self.1.set(0);
+            let Some(key) = map.next_key::<String>()? else {
+                break;
+            };
+            let value = map.next_value::<Value>()?;
+            (self.0)(key, value).map_err(serde::de::Error::custom)?;
+        }
+        Ok(())
+    }
+}
+
+pub fn scope_name(name: &str) -> anyhow::Result<String> {
+    let encoded = name
+        .strip_suffix(".bin")
+        .context("Invalid legacy filename")?;
+    let mut bytes = Vec::with_capacity(encoded.len());
+    let mut input = encoded.bytes();
+    while let Some(byte) = input.next() {
+        bytes.push(if byte == b'%' {
+            let high = input.next().context("Invalid scope escape")?;
+            let low = input.next().context("Invalid scope escape")?;
+            (char::from(high)
+                .to_digit(16)
+                .context("Invalid scope escape")?
+                * 16
+                + char::from(low)
+                    .to_digit(16)
+                    .context("Invalid scope escape")?) as u8
+        } else {
+            byte
+        });
+    }
+    Ok(String::from_utf8(bytes)?)
+}
+
+pub fn content_digest(hash: &mut Sha256, key: &str, value: &str) {
+    hash.update((key.len() as u64).to_le_bytes());
+    hash.update(key.as_bytes());
+    hash.update((value.len() as u64).to_le_bytes());
+    hash.update(value.as_bytes());
+}
diff --git a/engine/src/state_migration/mod.rs b/engine/src/state_migration/mod.rs
new file mode 100644
index 0000000000000000000000000000000000000000..7b294918a23faf51dce33d33caea975a6b9c4081
--- /dev/null
+++ b/engine/src/state_migration/mod.rs
@@ -0,0 +1,249 @@
+mod archive;
+#[cfg(test)]
+mod tests;
+mod transfer;
+
+use crate::workers::state::adapters::sqlite::database;
+use anyhow::{Context, ensure};
+use clap::Args;
+use rusqlite::{Connection, OpenFlags};
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+use std::io::Write;
+use std::{
+    fs::{self, File, OpenOptions},
+    path::{Path, PathBuf},
+};
+
+#[derive(Args, Clone, Debug)]
+pub struct MigrationArgs {
+    /// Frozen custom rkyv/JSON state directory. Stop all source writers first.
+    #[arg(long)]
+    pub source: PathBuf,
+    /// New or previously checkpointed shadow SQLite file, outside the source directory.
+    #[arg(long)]
+    pub target: PathBuf,
+    /// Maximum target database plus WAL bytes; independently verify available disk space first.
+    #[arg(long)]
+    pub disk_budget_bytes: u64,
+}
+
+#[derive(Serialize, Deserialize, Clone, Debug, PartialEq)]
+struct SourceFile {
+    name: String,
+    scope: String,
+    bytes: u64,
+    sha256: String,
+}
+#[derive(Serialize, Deserialize, Clone, Debug, PartialEq)]
+struct Manifest {
+    format: String,
+    source: String,
+    files: Vec<SourceFile>,
+}
+#[derive(Serialize, Debug)]
+pub struct MigrationResult {
+    pub status: &'static str,
+    pub target: String,
+    pub scopes: usize,
+    pub records: u64,
+    pub source_retained: bool,
+    pub source_manifest_sha256: String,
+}
+
+fn manifest(source: &Path) -> anyhow::Result<Manifest> {
+    let mut files = Vec::new();
+    let mut names = std::collections::HashSet::new();
+    for entry in fs::read_dir(source)? {
+        let entry = entry?;
+        let path = entry.path();
+        if path.extension().and_then(|s| s.to_str()) != Some("bin") {
+            continue;
+        }
+        ensure!(
+            entry.file_type()?.is_file(),
+            "Legacy scope must be a regular file"
+        );
+        let name = entry
+            .file_name()
+            .into_string()
+            .map_err(|_| anyhow::anyhow!("Invalid UTF-8 scope filename"))?;
+        let scope = archive::scope_name(&name)?;
+        ensure!(
+            names.insert(scope.clone()),
+            "Duplicate decoded legacy scope"
+        );
+        ensure!(
+            ![
+                database::CONTROL_SCOPE,
+                database::CHECKPOINT_SCOPE,
+                database::RECEIPT_SCOPE
+            ]
+            .contains(&scope.as_str()),
+            "Legacy source contains reserved transaction metadata"
+        );
+        files.push(SourceFile {
+            name,
+            scope,
+            bytes: entry.metadata()?.len(),
+            sha256: archive::file_digest(&path)?,
+        });
+    }
+    files.sort_by(|a, b| a.name.cmp(&b.name));
+    Ok(Manifest {
+        format: "rkyv-0.8-le32-key-storage-json-v1".into(),
+        source: source.to_string_lossy().into_owned(),
+        files,
+    })
+}
+
+fn target_path(source: &Path, target: &Path) -> anyhow::Result<PathBuf> {
+    let name = target
+        .file_name()
+        .context("Target must name a SQLite file")?;
+    let parent = target
+        .parent()
+        .filter(|p| !p.as_os_str().is_empty())
+        .unwrap_or(Path::new("."));
+    let parent = fs::canonicalize(parent).context("Target parent directory must already exist")?;
+    let target = parent.join(name);
+    ensure!(
+        !target.starts_with(source),
+        "Shadow target must be outside the legacy source directory"
+    );
+    if target.exists() {
+        ensure!(
+            fs::symlink_metadata(&target)?.file_type().is_file(),
+            "Target must be a regular file"
+        );
+    }
+    Ok(target)
+}
+
+fn importer_lock(target: &Path) -> anyhow::Result<File> {
+    let mut lock_name = target.as_os_str().to_owned();
+    lock_name.push(".migration-lock");
+    let lock = OpenOptions::new()
+        .read(true)
+        .write(true)
+        .create(true)
+        .truncate(false)
+        .open(PathBuf::from(lock_name))?;
+    lock.try_lock()
+        .context("Another importer owns this shadow target")?;
+    Ok(lock)
+}
+
+pub fn run(args: &MigrationArgs) -> anyhow::Result<MigrationResult> {
+    run_segment(args, None, None)
+}
+
+fn run_segment(
+    args: &MigrationArgs,
+    stop_after: Option<u64>,
+    maximum_pages: Option<u64>,
+) -> anyhow::Result<MigrationResult> {
+    let source = fs::canonicalize(&args.source)?;
+    ensure!(source.is_dir(), "Source must be a frozen legacy directory");
+    let target = target_path(&source, &args.target)?;
+    let _lock = importer_lock(&target)?;
+    let input = manifest(&source)?;
+    let source_bytes = input.files.iter().try_fold(0u64, |sum, file| {
+        sum.checked_add(file.bytes).context("Source size overflow")
+    })?;
+    ensure!(
+        args.disk_budget_bytes
+            >= source_bytes
+                .saturating_mul(2)
+                .saturating_add(64 * 1024 * 1024),
+        "Reserve a disk budget of at least twice source bytes plus 64 MiB"
+    );
+    let input_json = serde_json::to_string(&input)?;
+    let mut marker_name = target.as_os_str().to_owned();
+    marker_name.push(".migration-pending");
+    let marker = PathBuf::from(marker_name);
+    if marker.exists() {
+        ensure!(
+            fs::symlink_metadata(&marker)?.file_type().is_file(),
+            "Pending marker must be a regular file"
+        );
+        ensure!(
+            archive::file_digest(&marker)?
+                == format!("{:x}", Sha256::digest(input_json.as_bytes())),
+            "Shadow pending identity does not match frozen source"
+        );
+    }
+    if target.exists() {
+        let prior = Connection::open_with_flags(&target, OpenFlags::SQLITE_OPEN_READ_ONLY)?;
+        let tables: i64 = prior.query_row(
+            "SELECT count(*) FROM sqlite_master WHERE type='table'",
+            [],
+            |r| r.get(0),
+        )?;
+        if tables == 0 {
+            ensure!(
+                marker.exists(),
+                "Existing empty target is not an owned migration shadow"
+            );
+        } else {
+            let identity: String = prior.query_row("SELECT manifest FROM state_migration WHERE id=1 AND length(CAST(manifest AS BLOB))=?1", [i64::try_from(input_json.len())?], |r| r.get(0))
+                .context("Existing target is not a resumable migration shadow")?;
+            ensure!(
+                identity == input_json,
+                "Frozen source manifest changed; preserve this shadow and start a new target"
+            );
+        }
+    }
+    if !marker.exists() {
+        let mut pending = OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .open(&marker)?;
+        pending.write_all(input_json.as_bytes())?;
+        pending.sync_all()?;
+    }
+    {
+        let mut initialize = Connection::open(&target)?;
+        let transaction = initialize.transaction()?;
+        transaction.execute_batch("CREATE TABLE IF NOT EXISTS state_migration(id INTEGER PRIMARY KEY CHECK(id=1), manifest TEXT NOT NULL, status TEXT NOT NULL CHECK(status IN ('pending','ready')));
+            CREATE TABLE IF NOT EXISTS state_migration_scopes(scope TEXT PRIMARY KEY, ordinal INTEGER NOT NULL, digest TEXT NOT NULL, complete INTEGER NOT NULL CHECK(complete IN (0,1))) WITHOUT ROWID;")?;
+        transaction.execute(
+            "INSERT OR IGNORE INTO state_migration VALUES(1,?1,'pending')",
+            [&input_json],
+        )?;
+        transaction.pragma_update(None, "application_id", database::APPLICATION_ID)?;
+        transaction.pragma_update(None, "user_version", 1)?;
+        transaction.commit()?;
+    }
+    let mut connection = database::open_for_migration(&target)?;
+    if let Some(pages) = maximum_pages {
+        connection.pragma_update(None, "max_page_count", i64::try_from(pages)?)?;
+    }
+    let mut records = 0u64;
+    for file in &input.files {
+        records += transfer::scope(
+            &mut connection,
+            &source,
+            file,
+            &target,
+            args.disk_budget_bytes,
+            stop_after,
+        )?;
+    }
+    ensure!(
+        manifest(&source)? == input,
+        "Frozen source changed during migration; target remains unavailable"
+    );
+    transfer::reconcile(&connection, &input)?;
+    connection.execute("UPDATE state_migration SET status='ready' WHERE id=1", [])?;
+    connection.execute_batch("PRAGMA wal_checkpoint(TRUNCATE)")?;
+    fs::remove_file(&marker)?;
+    Ok(MigrationResult {
+        status: "ready",
+        target: target.to_string_lossy().into_owned(),
+        scopes: input.files.len(),
+        records,
+        source_retained: true,
+        source_manifest_sha256: format!("{:x}", Sha256::digest(input_json.as_bytes())),
+    })
+}
