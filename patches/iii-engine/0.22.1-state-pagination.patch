+}
+pub(super) fn reservation(c:&Connection,root:&store::Slot)->anyhow::Result<Value> {
+    if root.regeneration.is_none() {return Ok(Value::Null);}
+    let Some(attempt)=store::attempt(c,&format!("{}:1",root.id))? else {return Ok(Value::Null);};
+    let claim:Option<String>=c.query_row("SELECT claimed_slot_id FROM engine_graph_auto_regenerations WHERE root_id=?1",[&root.id],|r|r.get(0)).optional()?.flatten();
+    let epoch=latest(c,&root.id)?.map_or(0,|record|record.0);
+    let capture=attempt.parts.zip(attempt.bytes).zip(attempt.digest.as_ref()).map(|((parts,bytes),digest)|json!({"parts":parts,"bytes":bytes,"digest":digest}));
+    Ok(json!({"attempt_id":attempt.id,"attempt_ordinal":attempt.ordinal,"state":attempt.state,"consumed":attempt.consumed,
+        "capture":capture,"deadline_ms":attempt.deadline,"claim_present":claim.is_some(),"epoch":epoch,"adoption_count":epoch}))
+}
+pub(super) fn prepare(c:&Connection,root:&str,token:&str,authority_id:&str)->anyhow::Result<()> {
+    if let Some((_,expected,profile))=latest(c,root)? {
+        need(token==expected && authority_id==profile,"STATE_GRAPH_AUTOMATIC_ADOPTION_EPOCH_CONFLICT")?;
+    }
+    Ok(())
+}
+pub(super) fn claim(c:&Connection,root:&str,attempt:&str)->anyhow::Result<()> {
+    if let Some((epoch,_,_))=latest(c,root)? {
+        c.execute("INSERT INTO engine_graph_auto_attempt_epochs(attempt_id,epoch) VALUES(?1,?2) ON CONFLICT(attempt_id) DO UPDATE SET epoch=excluded.epoch",params![attempt,epoch])?;
+    }
+    Ok(())
+}
+pub(super) fn dispatch(c:&Connection,slot:&store::Slot,attempt:&store::Attempt)->anyhow::Result<()> {
+    let Some((epoch,token,profile))=latest(c,&slot.root)? else {return Ok(());};
+    let claimed:Option<(String,Option<String>,i64)>=c.query_row("SELECT regeneration_id,claimed_slot_id,deadline_ms FROM engine_graph_auto_regenerations WHERE root_id=?1",[&slot.root],|r|Ok((r.get(0)?,r.get(1)?,r.get(2)?))).optional()?;
+    let deadline:i64=c.query_row("SELECT COALESCE((SELECT deadline_ms FROM engine_graph_auto_prepare_renewals WHERE root_id=?1 AND epoch=?2 ORDER BY admitted_at_ms DESC LIMIT 1),(SELECT deadline_ms FROM engine_graph_auto_reservation_adoptions WHERE root_id=?1 AND epoch=?2))",params![slot.root,epoch],|r|r.get(0))?;
+    let prepared:Option<i64>=c.query_row("SELECT epoch FROM engine_graph_auto_attempt_epochs WHERE attempt_id=?1",[&attempt.id],|r|r.get(0)).optional()?;
+    need(attempt.ordinal==1 && prepared==Some(epoch) && attempt.deadline==deadline && slot.authority_id.as_deref()==Some(profile.as_str())
+        && claimed.as_ref().is_some_and(|(current,claimed,current_deadline)|current==&token && *current_deadline==deadline && claimed.as_deref()==Some(slot.id.as_str())),"STATE_GRAPH_AUTOMATIC_ADOPTION_EPOCH_CONFLICT")
+}
+pub(super) fn adopt(c:&Connection,path:&Path,anchor:&Anchor,job:&Value,proof:&Value,now:i64,rollback:bool,trusted:&mut Option<authority::Trusted>)->anyhow::Result<Outcome> {
+    adopt_inner(c,Some(path),anchor,job,proof,now,rollback,trusted,None)
+}
+fn adopt_inner(c:&Connection,path:Option<&Path>,anchor:&Anchor,job:&Value,proof:&Value,now:i64,rollback:bool,trusted:&mut Option<authority::Trusted>,staging:Option<&Anchor>)->anyhow::Result<Outcome> {
+    let id=binding::slot_id(anchor)?;
+    let Some(root)=store::slot(c,&id)? else {return Ok(Outcome::Unchanged);};
+    if root.root!=id || !root.retry || root.regeneration.is_none() {return Ok(Outcome::Unchanged);}
+    let Some(attempt)=store::attempt(c,&format!("{id}:1"))? else {return Ok(Outcome::Deferred("GRAPH_AUTOMATIC_ADOPTION_UNPROVEN"));};
+    if attempt.consumed || attempt.digest.is_some() || attempt.parts.is_some() || attempt.bytes.is_some()
+        || attempt.state!="expired" || attempt.reason.as_deref()!=Some("GRAPH_AUTOMATIC_PREPARED_DEADLINE") {return Ok(Outcome::Unchanged);}
+    if rollback {return Ok(Outcome::Deferred("GRAPH_AUTOMATIC_CLOCK_ROLLBACK"));}
+    let reservation:Option<(String,String,i64,Option<String>)>=c.query_row("SELECT regeneration_id,new_job_id,deadline_ms,claimed_slot_id FROM engine_graph_auto_regenerations WHERE root_id=?1",[&id],|r|Ok((r.get(0)?,r.get(1)?,r.get(2)?,r.get(3)?))).optional()?;
+    let Some((old_token,child,old_deadline,claimed))=reservation else {return Ok(Outcome::Deferred("GRAPH_AUTOMATIC_ADOPTION_UNPROVEN"));};
+    if claimed.is_some() || attempt.slot!=id || attempt.ordinal!=1 || old_deadline!=attempt.deadline || old_deadline>now
+        || root.regeneration.as_deref()!=Some(old_token.as_str()) || root.new_job.as_deref()!=Some(child.as_str()) {
+        return Ok(Outcome::Deferred("GRAPH_AUTOMATIC_ADOPTION_UNPROVEN"));
+    }
+    let parts:bool=c.query_row("SELECT EXISTS(SELECT 1 FROM engine_graph_auto_parts WHERE attempt_id=?1)",[&attempt.id],|r|r.get(0))?;
+    if parts {return Ok(Outcome::Deferred("GRAPH_AUTOMATIC_ADOPTION_UNPROVEN"));}
+    let child_slot:bool=c.query_row("SELECT EXISTS(SELECT 1 FROM engine_graph_auto_slots WHERE json_extract(anchor_json,'$.job_id')=?1)",[&child],|r|r.get(0))?;
+    if child_slot {return Ok(Outcome::Deferred("GRAPH_AUTOMATIC_ADOPTION_CHILD_PRESENT"));}
+    let child_proof=if database::row(c,protocol::JOBS,&child)?.value.is_some() {
