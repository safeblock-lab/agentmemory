+#[tokio::test]
+async fn snapshot_lost_open_ack_and_queue_fairness_use_actual_owner_loop() {
+    use super::super::StateAdapter;
+    use std::sync::{Arc, atomic::{AtomicUsize,Ordering}};
+    let root = std::env::var("III_SQLITE_TEST_ROOT").expect("isolated test root");
+    let directory = tempfile::tempdir_in(root).unwrap();
+    let adapter = Arc::new(super::SqliteAdapter::new(Some(json!({"file_path":directory.path().join("queue.sqlite3")}))).unwrap());
+    let steps=Arc::new(AtomicUsize::new(0)); let worker_steps=steps.clone();
+    adapter.run_controlled_view(0,false,None,move |_,views| { views.fixture.steps=Some(worker_steps); views.fixture.free_bytes=Some(64 * 1024 * 1024 * 1024); Ok(()) }).await.unwrap();
+    adapter.run(0,|c| { c.execute_batch("CREATE TABLE fixture_padding(value BLOB)")?; c.execute("INSERT INTO fixture_padding VALUES(zeroblob(?1))",[128 * 1024 * 1024])?; Ok(()) }).await.unwrap();
+    let owner = adapter.clone(); let count = Arc::new(AtomicUsize::new(0)); let observed = count.clone();
+    let writes = tokio::spawn(async move { for n in 0..64 { owner.run(0,move |c| { let tx=Transaction::new_unchecked(c,TransactionBehavior::Immediate)?; tx.execute("CREATE TABLE IF NOT EXISTS foreground(n INTEGER)",[])?; tx.execute("INSERT INTO foreground VALUES(?1)",[n])?; tx.commit()?; Ok(()) }).await.unwrap(); observed.fetch_add(1,Ordering::AcqRel); } });
+    let owner = adapter.clone();
+    let capture = tokio::spawn(async move { owner.storage(json!({"action":"snapshot_open","owner_id":uuid::Uuid::new_v4().to_string(),"request_id":uuid::Uuid::new_v4().to_string()})).await });
+    // Dropping the RPC future cancels the capture budget. A same-worker barrier
+    // observes cleanup even if the completion acknowledgment was lost.
+    tokio::time::timeout(Duration::from_secs(10),async {
+        while steps.load(Ordering::Acquire)<2 { tokio::task::yield_now().await; }
+    }).await.expect("capture must have started and crossed a foreground boundary");
+    capture.abort(); let _ = capture.await; writes.await.unwrap();
+    assert_eq!(count.load(Ordering::Acquire),64);
+    adapter.run_controlled_view(0,false,None,|_,views| { views.reap()?; assert!(!views.busy()); Ok(()) }).await.unwrap();
+}
