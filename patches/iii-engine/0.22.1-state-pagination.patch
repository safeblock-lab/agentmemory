+use rusqlite::{Connection, OptionalExtension, params};
+
+pub fn resolve_session(c: &Connection, session_id: &str) -> anyhow::Result<Result<String, &'static str>> {
+    Ok(resolve_session_bounded(c,session_id,usize::MAX)?.0)
+}
+
+pub fn resolve_session_bounded(c: &Connection, session_id: &str, max_bytes: usize) -> anyhow::Result<(Result<String, &'static str>, usize)> {
+    if session_id.trim().is_empty() || session_id.len()>256 { return Ok((Err("audience_unknown"),0)); }
+    for (source,scope) in [("sessions","mem:sessions"),("summaries","mem:summaries")] {
+        let version: Option<String> = c.query_row("SELECT CAST(version AS TEXT) FROM state_rows WHERE scope=?1 AND key=?2 AND value IS NOT NULL",params![scope,session_id],|r|r.get(0)).optional()?;
+        let Some(version) = version else { continue };
+        let project: Option<String> = c.query_row("SELECT r.project FROM retrieval_project_refs r JOIN retrieval_project_catalog c ON c.source=r.source AND c.epoch=r.epoch WHERE r.source=?1 AND r.source_key=?2 AND r.session_id=?2 AND r.version=?3",params![source,session_id,version],|r|r.get(0)).optional()?;
+        if let Some(project) = project {
+            let bytes = project.len()+session_id.len()+version.len();
+            return Ok(if bytes>max_bytes {(Err("budget"),0)} else {(Ok(project),bytes)});
+        }
+        let reason: Option<String> = c.query_row("SELECT x.reason FROM retrieval_project_exclusions x JOIN retrieval_project_catalog c ON c.source=x.source AND c.epoch=x.epoch WHERE x.source=?1 AND x.source_key=?2 AND x.version=?3",params![source,session_id,version],|r|r.get(0)).optional()?;
+        return Ok((Err(match reason.as_deref() { Some("stale")=>"stale",Some("audience_unknown")=>"audience_unknown",_=>"authority_incomplete" }),0));
+    }
+    Ok((Err("audience_unknown"),0))
+}
