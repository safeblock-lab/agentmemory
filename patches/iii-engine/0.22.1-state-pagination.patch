+use super::*;
+use rusqlite::Connection;
+use serde_json::{Value, json};
+
+mod durable_tests;
+mod graph_tests;
+mod membership_index_tests;
+mod graph_browse_tests;
+mod graph_read_tests;
+mod project_catalog_repair_tests;
+mod project_sessions_page_tests;
+mod batch_work_tests;
+mod preparation_performance_tests;
+mod semantic_tests;
+mod source_tests;
+mod shared_projection_tests;
+mod canonical_tests;
+
+#[test]
+fn graph_budget_source_readiness_measurement() {
+    let c = fresh();
+    let tx = c.unchecked_transaction().unwrap();
+    for i in 0..50_000 {
+        let scope = format!("mem:obs:measurement-{i:06}");
+        tx.execute("INSERT INTO state_scopes(scope,revision,next_position) VALUES(?1,1,0)", [&scope]).unwrap();
+        tx.execute("INSERT INTO retrieval_source_scopes VALUES('observations',?1,'1',1)", [&scope]).unwrap();
+    }
+    tx.commit().unwrap();
+    let sql = format!("EXPLAIN QUERY PLAN SELECT s.scope,s.revision FROM ({}) s LEFT JOIN retrieval_source_scopes r ON r.index_id=?1 AND r.scope=s.scope WHERE r.scope IS NULL OR r.revision<>s.revision OR r.prepared=0 ORDER BY s.scope LIMIT 1", source::SCOPES);
+    let mut statement = c.prepare(&sql).unwrap();
+    let plan = statement.query_map(["observations"], |row| row.get::<_,String>(3)).unwrap().collect::<rusqlite::Result<Vec<_>>>().unwrap();
+    println!("GRAPH_MEASUREMENT source_pending scopes=50000 plan={plan:?}");
+    for attempt in 0..3 {
+        let start = std::time::Instant::now();
+        assert!(source::pending_scope(&c,"observations").unwrap().is_none());
+        println!("GRAPH_MEASUREMENT source_pending attempt={attempt} elapsed_us={}",start.elapsed().as_micros());
+    }
