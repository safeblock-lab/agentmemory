+++ b/engine/src/workers/state/adapters/sqlite/storage_lexical_repack.rs
@@ -0,0 +1,152 @@
+#[cfg(test)]
+mod tests;
+mod schema;
+pub mod proof;
+pub use schema::validate as validate_schema;
+use super::{protocol::{require,error},retrieval::lexical_content as content,storage_repack::{Request,Step}};
+use rusqlite::{Connection,OptionalExtension,params};
+use serde_json::{Value,json};
+use sha2::{Digest,Sha256};
+use std::time::{Duration,Instant};
+
+const COPY_FIRST_SQL:&str="SELECT rowid,length(CAST(text AS BLOB)) FROM retrieval_lexical ORDER BY rowid LIMIT 1";
+const COPY_AFTER_SQL:&str="SELECT rowid,length(CAST(text AS BLOB)) FROM retrieval_lexical WHERE rowid>?1 ORDER BY rowid LIMIT 1";
+const COPY_WORK_SQL:&str="SELECT coalesce(max(CASE WHEN v.value_bytes BETWEEN 1 AND 262144 AND v.stored_bytes BETWEEN 1 AND 262144 AND e.value_bytes BETWEEN 1 AND 262144 AND e.stored_bytes BETWEEN 1 AND 262144 THEN 3*(v.value_bytes+v.stored_bytes)+e.value_bytes+e.stored_bytes ELSE 0 END),0) FROM retrieval_lexical_links l CROSS JOIN retrieval_source_items s INDEXED BY retrieval_source_items_id ON s.index_id=l.index_id AND s.key=l.id AND s.dirty=0 CROSS JOIN state_values v ON v.scope=s.scope AND v.key=s.key AND v.version=s.version AND v.live=1 CROSS JOIN state_values e ON e.scope='mem:semantic:'||l.index_id AND e.key=l.id AND e.live=1 WHERE l.rowid=?1";
+
+pub fn initialize(c:&Connection)->anyhow::Result<()> {
+    c.execute_batch("CREATE TABLE IF NOT EXISTS lexical_repack_job(singleton INTEGER PRIMARY KEY CHECK(singleton=1),value TEXT NOT NULL); CREATE TABLE IF NOT EXISTS lexical_repack_receipts(operation_id TEXT PRIMARY KEY,digest BLOB NOT NULL,result TEXT NOT NULL) WITHOUT ROWID;")?;
+    Ok(())
+}
+pub fn status(c:&Connection)->anyhow::Result<Value> {
+    let value:Option<String>=c.query_row("SELECT value FROM lexical_repack_job WHERE singleton=1",[],|r|r.get(0)).optional()?;
+    Ok(value.map(|v|serde_json::from_str(&v)).transpose()?.unwrap_or(json!({"phase":"absent","ordinal":0})))
+}
+pub fn protected(c:&Connection)->anyhow::Result<bool> {
+    Ok(c.query_row("SELECT EXISTS(SELECT 1 FROM sqlite_schema WHERE name='lexical_repack_original')",[],|r|r.get(0))?)
+}
+pub fn receipt(c:&Connection,r:&Request)->anyhow::Result<Value> {
+    let saved:Option<(Vec<u8>,String)>=c.query_row("SELECT digest,result FROM lexical_repack_receipts WHERE operation_id=?1",[&r.operation_id],|r|Ok((r.get(0)?,r.get(1)?))).optional()?;
+    match saved {None=>Ok(json!({"status":"not_found","operation_id":r.operation_id})),Some((digest,result))=>{
+        require(digest==Sha256::digest(serde_json::to_vec(r)?).to_vec())?;
+        Ok(json!({"status":"applied","operation_id":r.operation_id,"result":serde_json::from_str::<Value>(&result)?}))
+    }}
+}
+fn mirror(c:&Connection)->anyhow::Result<Option<&'static str>> {
+    Ok(match status(c)?["phase"].as_str(){Some("copy"|"ready")=>Some("lexical_repack_stage"),Some("cut")=>Some("lexical_repack_original"),_=>None})
+}
+pub fn mirror_delete(c:&Connection,rowid:i64)->anyhow::Result<()> {
+    if let Some(target)=mirror(c)? {delete_table(c,target,rowid)?;}
+    Ok(())
+}
+pub fn delete_table(c:&Connection,table:&str,rowid:i64)->anyhow::Result<()> {
+    require(["retrieval_lexical","lexical_repack_stage","lexical_repack_original"].contains(&table))?;
+    let classic=table=="lexical_repack_stage" || (table=="retrieval_lexical" && content::active(c)?);
+    validate_schema(c,table,classic)?;
+    if !classic {c.execute(&format!("DELETE FROM {table} WHERE rowid=?1"),[rowid])?;return Ok(());}
+    let exists:bool=c.query_row(&format!("SELECT EXISTS(SELECT 1 FROM {table} WHERE rowid=?1)"),[rowid],|r|r.get(0))?;
+    if !exists {return Ok(());}
+    let (index,epoch,id):(String,i64,String)=c.query_row("SELECT index_id,epoch,id FROM retrieval_lexical_links WHERE rowid=?1",[rowid],|r|Ok((r.get(0)?,r.get(1)?,r.get(2)?)))?;
+    let text=content::text(c,rowid)?.ok_or_else(||error("STATE_LEXICAL_CONTENT_MISSING"))?;
+    // FTS5 requires the exact OLD indexed values; proof and links remain until all mirrors finish.
+    c.execute(&format!("INSERT INTO {table}({table},rowid,index_id,epoch,id,text) VALUES('delete',?1,?2,?3,?4,?5)"),params![rowid,index,epoch,id,text])?;
+    Ok(())
+}
+pub fn mirror_insert(c:&Connection,rowid:i64,index:&str,epoch:i64,id:&str,text:&str)->anyhow::Result<()> {
+    if let Some(target)=mirror(c)? {
+        delete_table(c,target,rowid)?;
+        c.execute(&format!("INSERT INTO {target}(rowid,index_id,epoch,id,text) VALUES(?1,?2,?3,?4,?5)"),params![rowid,index,epoch,id,text])?;
+    }
+    if content::active(c)? || mirror(c)?.is_some() {content::save(c,rowid,text)?;}
+    Ok(())
+}
+pub fn proof(c:&Connection)->anyhow::Result<Value> {proof::full(c)}
+pub fn execute(c:&Connection,r:Request)->anyhow::Result<Value> {
+    require(!c.is_autocommit() && !r.operation_id.is_empty() && r.operation_id.len()<=128 && !r.job_id.is_empty() && r.job_id.len()<=96
+        && (1..=4096).contains(&r.limit) && (1024..=4*1024*1024).contains(&r.max_bytes)
+        && (1..=if r.step==Step::Cut{60_000}else{3000}).contains(&r.max_ms))?;
+    super::storage_repack::leases(c,&r)?;
+    let prior=receipt(c,&r)?;if prior["status"]=="applied" {return Ok(prior["result"].clone());}
+    let mut job=status(c)?;require(job["ordinal"].as_u64()==Some(r.expected_ordinal))?;
+    if r.step==Step::Begin {
+        require(job["phase"]=="absent" && !content::active(c)? && !super::storage_repack::protected(c)?)?;
+        let original_schema=validate_schema(c,"retrieval_lexical",false)?;
+        schema::create_stage(c)?;
+        let stage_schema=validate_schema(c,"lexical_repack_stage",true)?;
+        job=json!({"job_id":r.job_id,"owner_id":r.owner_id,"phase":"copy","ordinal":0,"cursor":null,"verified_rows":0,"input_text_bytes":0,"canonical_exact_bytes":0,"reasons":{},"original_create_sql":original_schema,"stage_create_sql":stage_schema});
+    } else {
+        require(job["job_id"]==r.job_id && job["owner_id"]==r.owner_id)?;
+        if ["copy","ready"].contains(&job["phase"].as_str().unwrap_or("")) {
+            validate_schema(c,"retrieval_lexical",false)?;validate_schema(c,"lexical_repack_stage",true)?;
+        } else if ["cut","retiring"].contains(&job["phase"].as_str().unwrap_or("")) {
+            validate_schema(c,"retrieval_lexical",true)?;validate_schema(c,"lexical_repack_original",false)?;
+        }
+    }
+    let (mut rows,mut bytes)=(0usize,0usize);let mut cut_proof=None;
+    match r.step {
+        Step::Begin=>(),
+        Step::Copy=>{require(job["phase"]=="copy")?;(rows,bytes)=copy(c,&r,&mut job)?;},
+        Step::Cut=>{
+            require(job["phase"]=="ready")?;let mut verified=proof(c)?;require(verified["rowids_and_metadata_exact"]==true)?;
+            c.flush_prepared_statement_cache();
+            c.execute_batch("ALTER TABLE retrieval_lexical RENAME TO lexical_repack_original; ALTER TABLE lexical_repack_stage RENAME TO retrieval_lexical;")?;
+            let version:i64=c.pragma_query_value(None,"user_version",|r|r.get(0))?;c.pragma_update(None,"user_version",version.max(3))?;
+            job["phase"]=json!("cut");c.flush_prepared_statement_cache();
+            verified["original_create_sql"]=json!(validate_schema(c,"lexical_repack_original",false)?);
+            verified["active_create_sql"]=json!(validate_schema(c,"retrieval_lexical",true)?);content::validate_format(c)?;
+            verified["format"]=json!(3);verified["original_protected"]=json!(protected(c)?);cut_proof=Some(verified);
+        },
+        Step::Rollback=>{
+            require(job["phase"]=="cut")?;c.flush_prepared_statement_cache();
+            c.execute_batch("ALTER TABLE retrieval_lexical RENAME TO lexical_repack_stage; ALTER TABLE lexical_repack_original RENAME TO retrieval_lexical;")?;
+            let version:i64=c.pragma_query_value(None,"user_version",|r|r.get(0))?;if version<4 {c.pragma_update(None,"user_version",2)?;}
+            job["phase"]=json!("ready");c.flush_prepared_statement_cache();
+        },
+        Step::Retire=>{
+            require(job["phase"]=="cut" || job["phase"]=="retiring")?;job["phase"]=json!("retiring");
+            (rows,bytes)=retire(c,&r,&mut job)?;
+        },
+    }
+    job["ordinal"]=json!(r.expected_ordinal.checked_add(1).ok_or_else(||error("STATE_TX_LIMIT_EXCEEDED"))?);
+    c.execute("INSERT INTO lexical_repack_job VALUES(1,?1) ON CONFLICT(singleton) DO UPDATE SET value=excluded.value",[serde_json::to_string(&job)?])?;
+    if let Some(proof)=cut_proof.as_mut(){proof["job"]=job.clone();}
+    let result=json!({"operation_id":r.operation_id,"job":job,"processed_rows":rows,"work_bytes":bytes,"original_protected":protected(c)?,"cut_proof":cut_proof});
+    c.execute("INSERT INTO lexical_repack_receipts VALUES(?1,?2,?3)",params![r.operation_id,Sha256::digest(serde_json::to_vec(&r)?).to_vec(),serde_json::to_string(&result)?])?;
+    Ok(result)
+}
+fn copy(c:&Connection,r:&Request,job:&mut Value)->anyhow::Result<(usize,usize)> {
+    let started=Instant::now();let (mut rows,mut bytes)=(0usize,0usize);
+    while rows<r.limit && (rows==0 || started.elapsed()<Duration::from_millis(r.max_ms.saturating_sub(300).min(1000))) {
+        let next:Option<(i64,i64)>=match job["cursor"].as_i64() {
+            Some(cursor)=>c.prepare_cached(COPY_AFTER_SQL)?.query_row([cursor],|r|Ok((r.get(0)?,r.get(1)?))).optional()?,
+            None=>c.prepare_cached(COPY_FIRST_SQL)?.query_row([],|r|Ok((r.get(0)?,r.get(1)?))).optional()?,
+        };
+        let Some((rowid,size))=next else {job["phase"]=json!("ready");break;};
+        let size=usize::try_from(size)?;anyhow::ensure!(size<=content::MAX_TEXT,"STATE_LEXICAL_ROW_EXCEEDS_BUDGET");
+        let canonical_work:i64=c.prepare_cached(COPY_WORK_SQL)?.query_row([rowid],|r|r.get(0))?;
+        let work=size.saturating_add(usize::try_from(canonical_work)?).saturating_add(4096);
+        if bytes.saturating_add(work)>r.max_bytes {anyhow::ensure!(rows>0,"STATE_LEXICAL_ROW_EXCEEDS_BUDGET");break;}
+        let (index,epoch,id,text):(String,i64,String,String)=c.prepare_cached("SELECT index_id,epoch,id,text FROM retrieval_lexical WHERE rowid=?1")?.query_row([rowid],|r|Ok((r.get(0)?,r.get(1)?,r.get(2)?,r.get(3)?)))?;
+        require(content::rowid(c,&index,epoch,&id)?==Some(rowid))?;
+        let staged:bool=c.prepare_cached("SELECT EXISTS(SELECT 1 FROM lexical_repack_stage WHERE rowid=?1)")?.query_row([rowid],|r|r.get(0))?;
+        if staged {delete_table(c,"lexical_repack_stage",rowid)?;}
+        c.prepare_cached("INSERT INTO lexical_repack_stage(rowid,index_id,epoch,id,text) VALUES(?1,?2,?3,?4,?5)")?.execute(params![rowid,index,epoch,id,text])?;
+        let reason=content::save(c,rowid,&text)?;
+        anyhow::ensure!(content::text(c,rowid)?.as_deref()==Some(text.as_str()),"STATE_LEXICAL_COPY_TEXT_MISMATCH");
+        job["reasons"][reason]=json!(job["reasons"][reason].as_u64().unwrap_or(0)+1);
+        job["input_text_bytes"]=json!(job["input_text_bytes"].as_u64().unwrap_or(0)+size as u64);
+        if reason=="canonical_exact" {job["canonical_exact_bytes"]=json!(job["canonical_exact_bytes"].as_u64().unwrap_or(0)+size as u64);}
+        job["cursor"]=json!(rowid);rows+=1;bytes+=work;
+    }
+    job["verified_rows"]=json!(job["verified_rows"].as_u64().unwrap_or(0)+rows as u64);Ok((rows,bytes))
+}
+fn retire(c:&Connection,r:&Request,job:&mut Value)->anyhow::Result<(usize,usize)> {
+    let started=Instant::now();let (mut rows,mut bytes)=(0usize,0usize);
+    while rows<r.limit && (rows==0 || started.elapsed()<Duration::from_millis(r.max_ms.saturating_sub(300).min(1000))) {
+        let next:Option<(i64,i64)>=c.query_row("SELECT rowid,length(CAST(text AS BLOB)) FROM lexical_repack_original ORDER BY rowid LIMIT 1",[],|r|Ok((r.get(0)?,r.get(1)?))).optional()?;
+        let Some((rowid,size))=next else {c.execute_batch("DROP TABLE lexical_repack_original;")?;job["phase"]=json!("retired");break;};
+        let size=usize::try_from(size)?.saturating_add(4096);
+        if bytes.saturating_add(size)>r.max_bytes {anyhow::ensure!(rows>0,"STATE_LEXICAL_ROW_EXCEEDS_BUDGET");break;}
+        c.execute("DELETE FROM lexical_repack_original WHERE rowid=?1",[rowid])?;rows+=1;bytes+=size;
+    }
+    job["retired_rows"]=json!(job["retired_rows"].as_u64().unwrap_or(0)+rows as u64);Ok((rows,bytes))
+}
