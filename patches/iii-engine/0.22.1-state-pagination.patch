+use super::{batch_work, graph_query, lexical, prepare, request::Request, semantic, semantic_query, source};
+use rusqlite::Connection;
+use serde_json::Value;
+
+pub fn execute(connection: &Connection, request: Request) -> anyhow::Result<Value> {
+    match request {
+        Request::RecoveryIntegrityV1 { input } => super::recovery_inspection::integrity(connection,input),
+        Request::RecoveryGraphSlotV1 { input } => super::recovery_inspection::slot(connection,input),
+        Request::WorkflowStatisticsRecordV1 { input } => super::workflow_statistics::record(connection,input),
+        Request::WorkflowStatisticsReadV1 { agent_id,max_rows,max_bytes,max_ms } =>
+            super::workflow_statistics::read(connection,agent_id.as_deref(),max_rows,max_bytes,max_ms),
+        Request::PreparationStatus {target,index_id,project,source_kind} => {
+            if target=="viewer_recent" {super::viewer_recent::status(connection)}
+            else {
+                let index=index_id.as_deref().ok_or_else(|| super::super::protocol::error("STATE_TX_INVALID_REQUEST"))?;
+                if let Some(project)=project {super::scoped::status(connection,index,&project,source_kind.as_deref()==Some("observation"))}
+                else {super::global_preparation_status(connection,index)}
+            }
+        }
+        Request::CrystalsStatus {} => super::crystals::status(connection),
+        Request::CrystalsPrepare {max_rows,max_bytes,max_ms} => super::crystals::prepare(connection,max_rows,max_bytes,max_ms),
+        Request::CrystalsPage {project,session_id,cursor,limit,max_bytes} =>
+            super::bounded_for(connection,std::time::Duration::from_secs(3),|| super::crystals::page(connection,project.as_deref(),session_id.as_deref(),cursor.as_deref(),limit,max_bytes)),
+        Request::ViewerRecentPrepare {limit,max_bytes,max_ms} => super::viewer_recent::prepare(connection,limit,max_bytes,max_ms),
+        Request::ViewerRecentPage {entity,session_id,cursor,limit,max_bytes,fields} =>
+            super::bounded_for(connection,std::time::Duration::from_secs(3),|| super::viewer_recent::page(connection,&entity,session_id.as_deref(),cursor.as_deref(),limit,max_bytes,&fields)),
+        Request::CanonicalPrepare {scope,max_rows,max_bytes}=>super::canonical::prepare(connection,&scope,max_rows,max_bytes),
+        Request::CanonicalLookup {scope,partition,normalized_key}=>super::canonical::lookup(connection,&scope,&partition,&normalized_key),
+        Request::CanonicalSourcePage {scope,source_session_ids,source_project,cursor,limit,max_bytes}=>super::canonical::source_page(connection,&scope,&source_session_ids,source_project.as_deref(),cursor.as_deref(),limit,max_bytes),
+        Request::CanonicalApply {input}=>match input {super::canonical::wire::ApplyRequest::Write(input)=>super::canonical::apply(connection,input),super::canonical::wire::ApplyRequest::Probe(input)=>super::canonical::receipt_probe(connection,input)},
+        Request::ReflectSources { project, sources, max_items: _, max_bytes } =>
+            super::bounded_for(connection, std::time::Duration::from_millis(3000), ||
+                super::reflect_sources::execute(connection, &project, &sources, max_bytes)),
+        Request::IndexStatus {index_id,..} => if let Some(index)=index_id {super::metadata_status(connection,&index)}else{super::status(connection)},
+        Request::IndexPrepare {
+            scope,
+            project,
+            max_rows,
+            max_bytes,
+        } => if scope == super::graph_browse::SCOPE {
+            super::graph_browse::prepare(connection,project.as_deref().unwrap(),max_rows,max_bytes)
+        } else { prepare::prepare(connection, &scope, max_rows, max_bytes) },
+        Request::ProjectCatalogPrepare { source, max_rows, max_bytes } =>
+            super::project_catalog::prepare(connection, &source, max_rows, max_bytes),
+        Request::ProjectCatalogPage { cursor, limit, max_bytes } =>
+            super::project_catalog::page(connection, cursor.as_deref(), limit, max_bytes),
+        Request::ProjectSessionsPage { project, cursor, limit, max_bytes } =>
+            super::bounded_for(connection, std::time::Duration::from_millis(50), ||
+                super::project_catalog::sessions_page(connection, &project, cursor.as_deref(), limit, max_bytes)),
+        Request::ProjectCatalogUnknowns { source, cursor, limit, max_bytes } =>
+            super::bounded_for(connection, std::time::Duration::from_millis(3000), ||
+                super::project_catalog::unknowns(connection, &source, cursor.as_deref(), limit, max_bytes)),
+        Request::ProjectCatalogRepairUnknown { source, key, expected_version, expected_revision, expected_epoch, expected_cursor } =>
+            super::bounded_for(connection, std::time::Duration::from_millis(3000), ||
+                super::project_catalog::repair_unknown(connection, &source, &key, &expected_version, &expected_revision, expected_epoch, expected_cursor)),
+        Request::ProjectVectorPrepare { index_id, project, source_kind, max_rows, max_bytes } =>
+            if let Some(project)=project {super::scoped::prepare(connection,&index_id,&project,source_kind.as_deref()==Some("observation"),max_rows,max_bytes)} else {super::scoped::global_prepare(connection,&index_id,max_rows,max_bytes)},
+        Request::SharedSourceProjection { sources, max_items: _, max_bytes } =>
+            super::shared_source_projection::execute(connection, &sources, max_bytes),
+        Request::ReflectLegacyWork { key, max_bytes } =>
+            super::legacy_work::execute(connection, &key, max_bytes),
+        Request::BatchWorkPayload { keys, max_items: _, max_bytes } =>
+            batch_work::payload(connection, &keys, max_bytes),
+        Request::BatchWorkSubmissionPatch { batch_job_id, updated_at, items } =>
+            batch_work::submission_patch(connection, &batch_job_id, &updated_at, &items),
+        Request::BatchWorkBridgeAck { key, expected_version, expected_fingerprint, receipt_key } =>
+            batch_work::bridge_ack(connection, &key, &expected_version, &expected_fingerprint, &receipt_key),
+        Request::GraphRead { project, mode, node_ids, edge_ids, from_time, through_time,
+            query, observation_ids, since_revision, cursor, limit, max_bytes, top_n } =>
+            super::bounded_for(connection,std::time::Duration::from_secs(3),|| {
+                let result=super::graph_read::execute(connection, &project, mode, &node_ids, &edge_ids,
+                    query.as_deref(), &observation_ids, from_time.as_deref(), through_time.as_deref(), since_revision.as_deref(),
+                    cursor.as_deref(), limit, max_bytes, top_n);
+                match result {
+                    Err(cause) if cause.downcast_ref::<super::super::protocol::TxError>().is_some_and(|error|error.0=="STATE_RETRIEVAL_RESOURCE_LIMIT") => Ok(super::graph_read::budget_exceeded(&project)),
+                    result=>result,
+                }
+            }).or_else(|cause| {
+                if cause.downcast_ref::<super::super::protocol::TxError>().is_some_and(|error|error.0=="STATE_RETRIEVAL_RESOURCE_LIMIT") {
+                    Ok(super::graph_read::budget_exceeded(&project))
+                } else { Err(cause) }
+            }),
+        Request::GraphSeeds {
+            entity_names,
+            observation_ids,
+            r#match,
+            max_items,
+            max_bytes,
+        } => graph_query::seeds(
+            connection,
+            &entity_names,
+            &observation_ids,
+            r#match,
+            max_items,
+            max_bytes,
+        ),
+        Request::GraphEdges {
+            node_ids,
+            max_items,
+            max_bytes,
+        } => graph_query::edges(connection, &node_ids, max_items, max_bytes),
+        Request::SemanticConfigure {
+            index_id,
+            model,
+            dimensions,
+            generation,
+            source_kind,
+        } => semantic::configure(
+            connection,
+            &index_id,
+            &model,
+            dimensions,
+            &generation,
+            source_kind.as_deref(),
+        ),
+        Request::SourcePrepare {
+            index_id,
+            model,
+            dimensions,
+            generation,
+            max_rows,
+            max_bytes,
+        } => {
+            semantic::get(connection, &index_id)?.identity(&model, dimensions, &generation)?;
+            source::prepare(connection, &index_id, max_rows, max_bytes)
+        }
+        Request::SemanticUpsert {
+            index_id,
+            model,
+            dimensions,
+            generation,
+            items,
+        } => semantic::upsert(
+            connection,
+            &index_id,
+            &model,
+            dimensions,
+            &generation,
+            items,
+        ),
+        Request::SemanticDelete {
+            index_id,
+            model,
+            dimensions,
+            generation,
+            ids,
+        } => semantic::delete(connection, &index_id, &model, dimensions, &generation, &ids),
+        Request::SemanticSearch {
+            index_id,
+            model,
+            dimensions,
+            generation,
+            embedding,
+            limit,
+            max_candidates,
+            probes,
+            project,
+            session_id,
+            source_scope,
+            source_kind,
+            include_text,
+            max_bytes,
+            global: _,
+        } => semantic_query::search(
+            connection,
+            &index_id,
+            &model,
+            dimensions,
+            &generation,
+            &embedding,
+            limit,
+            max_candidates,
+            probes,
+            super::search_projection::Options {project:project.as_deref(),session_id:session_id.as_deref(),source_scope:source_scope.as_deref(),source_kind:source_kind.as_deref(),include_text,max_bytes},
+        ),
+        Request::KeywordSearch {
+            index_id,
+            model,
+            dimensions,
+            generation,
+            query,
+            limit,
+            max_candidates,
+            project,
+            session_id,
+            source_scope,
+            source_kind,
+            include_text,
+            max_bytes,
+            global: _,
+        } => lexical::search(
+            connection,
+            &index_id,
+            &model,
+            dimensions,
+            &generation,
+            &query,
+            limit,
+            max_candidates,
+            super::search_projection::Options {project:project.as_deref(),session_id:session_id.as_deref(),source_scope:source_scope.as_deref(),source_kind:source_kind.as_deref(),include_text,max_bytes},
+        ),
+    }
+}
