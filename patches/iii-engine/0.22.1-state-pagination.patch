+use super::*;
+
+fn validation(result: anyhow::Result<()>) -> anyhow::Result<Value> {
+    match result {
+        Ok(()) => Ok(json!({"valid":true})),
+        Err(error) => match error.downcast_ref::<protocol::TxError>() {
+            Some(error) => Ok(json!({"valid":false,"code":error.0})),
+            None => Err(error),
+        },
+    }
+}
+
+fn admit(output: &mut Value, required: usize, remaining: &mut usize) -> bool {
+    if required > *remaining || required > database::DecodeWorkGuard::remaining() {
+        output["canonical_validation"]=json!({"status":"budget","required_bytes":required});
+        return false;
+    }
+    *remaining=remaining.saturating_sub(required);
+    true
+}
+
+fn current(c: &Connection, meta: &semantic::Meta, session: &str, id: &str, output: &mut Value) -> anyhow::Result<Option<bool>> {
+    let (authority, _) = project_catalog::resolve_session_bounded(c,session,65_536)?;
+    output["session_authority"]=match &authority {
+        Ok(_) => json!({"status":"resolved"}),
+        Err(code) => json!({"status":code}),
+    };
+    let project=match authority {
+        Ok(name) => match membership::project_token(c,&name)? {Some(token)=>Some(token),None=>return Ok(None)},
+        Err("budget") => return Ok(None),
+        Err(_) => None,
+    };
+    let saved:Option<(i64,Option<i64>,i64)>=c.query_row(
+        "SELECT token,project,generation FROM retrieval_scoped_sessions WHERE name=?1",
+        [session],|r|Ok((r.get(0)?,r.get(1)?,r.get(2)?))).optional()?;
+    let Some((token,previous,generation))=saved else {return Ok(None)};
+    let generation=if previous==project {generation} else {
+        generation.checked_add(1).ok_or_else(||protocol::error("STATE_TX_LIMIT_EXCEEDED"))?
+    };
+    c.query_row("SELECT EXISTS(SELECT 1 FROM retrieval_scoped_vectors WHERE index_id=?1 AND epoch=?2 AND id=?3 AND project IS ?4 AND project_generation=1 AND session=?5 AND generation=?6 AND (?7=0 OR document IS NOT NULL))",
+        params![meta.index_id,meta.epoch,id,project,token,generation,project.is_some()],|r|r.get(0)).map(Some).map_err(Into::into)
+}
+
+fn row(c: &Connection, meta: &semantic::Meta, session: &str, id: &str, position: i64, version: &str, remaining: &mut usize) -> anyhow::Result<Value> {
+    let scope=format!("mem:obs:{session}");
+    let item=source::item(c,&meta.index_id,&scope,id)?;
+    let clean=item.as_ref().is_some_and(|x|x.0==version&&!x.1);
+    let vector:bool=c.query_row("SELECT EXISTS(SELECT 1 FROM retrieval_vectors WHERE index_id=?1 AND epoch=?2 AND id=?3)",params![meta.index_id,meta.epoch,id],|r|r.get(0))?;
+    let lexical:bool=c.query_row("SELECT EXISTS(SELECT 1 FROM retrieval_lexical_links l JOIN retrieval_lexical f ON f.rowid=l.rowid WHERE l.index_id=?1 AND l.epoch=?2 AND l.id=?3)",params![meta.index_id,meta.epoch,id],|r|r.get(0))?;
+    let mut output=json!({"id":id,"session_id":session,"scope":scope,"position":position,"source_exists":true,"source_version":version,"epoch":meta.epoch.to_string(),"source_item_version":item.as_ref().map(|x|&x.0),"source_dirty":item.as_ref().map(|x|x.1),"source_clean":clean,"epoch_vector_present":vector,"lexical_present":lexical,"branch":null,"source_eligible":null,"needs_restore":null,"will_exclude_ineligible":null,"current":null,"lexical_reload_required":null,"canonical_validation_required":null});
+    let source_bytes=database::row_work(c,&scope,id)?;
+    if !admit(&mut output,source_bytes,remaining) {return Ok(output)}
+    let source=database::row(c,&scope,id)?;
+    let version_current=source.version.to_string()==version;
+    let eligible=super::super::eligibility::value(&scope,source.value.as_ref());
+    let exclude=!clean&&version_current&&!eligible;
+    let needs_restore=(!clean||!vector)&&!exclude&&version_current;
+    output["source_version_current"]=json!(version_current);
+    output["source_eligible"]=json!(eligible);
+    output["will_exclude_ineligible"]=json!(exclude);
+    output["needs_restore"]=json!(needs_restore);
+    let current=current(c,meta,session,id,&mut output)?;
+    output["current"]=json!(current);
+    output["lexical_reload_required"]=json!(if exclude||!version_current {Some(false)} else if needs_restore {Some(true)} else {current.map(|value|!value)});
+    output["canonical_validation_required"]=json!(needs_restore);
+    if !version_current || exclude {
+        output["branch"]=json!(if !version_current {"source_version_changed"} else {"exclude_ineligible"});
+        output["canonical_validation"]=json!({"status":"not_required"});
+        return Ok(output);
+    }
+    output["branch"]=json!(if needs_restore {"restore"} else if current==Some(true) {"current_document"} else if current==Some(false) {"lexical_projection"} else {"membership_unknown"});
+    let required=source_bytes.saturating_mul(2).saturating_add(database::row_work(c,&meta.scope(),id)?);
+    if !admit(&mut output,required,remaining) {return Ok(output)}
+    let Some(embedding)=database::row(c,&meta.scope(),id)?.value else {
+        output["canonical_validation"]=json!({"valid":false,"code":"canonical_embedding_missing"});
+        return Ok(output);
+    };
+    let check=(|| -> anyhow::Result<()> {
+        protocol::require(embedding["sourceScope"].as_str()==Some(scope.as_str()) && embedding["sourceVersion"].as_str()==Some(version))?;
+        source::validate_readonly(c,&meta.index_id,id,&embedding)?;
+        protocol::require(embedding.is_object() && embedding["id"].as_str()==Some(id))?;
+        let model=embedding["model"].as_str().ok_or_else(||protocol::error("STATE_TX_INVALID_REQUEST"))?;
+        let dimensions=embedding["dimensions"].as_u64().ok_or_else(||protocol::error("STATE_TX_INVALID_REQUEST"))?;
+        let generation=embedding["generation"].as_str().ok_or_else(||protocol::error("STATE_TX_INVALID_REQUEST"))?;
+        meta.identity(model,dimensions as usize,generation)?;
+        let session=embedding["sessionId"].as_str().ok_or_else(||protocol::error("STATE_TX_INVALID_REQUEST"))?;
+        super::super::request::identifier(session)?;
+        super::super::request::identifier(id)?;
+        let encoded=embedding["embedding"].as_str().ok_or_else(||protocol::error("STATE_TX_INVALID_REQUEST"))?;
+        lsh::decode(encoded,meta.dimensions)?;
+        source::lexical_text(c,&meta.index_id,&embedding)?;
+        Ok(())
+    })();
+    output["canonical_validation"]=validation(check)?;
+    Ok(output)
+}
+
+pub(super) fn next_row(c: &Connection, meta: &semantic::Meta, session: &str, position: i64, remaining: &mut usize) -> anyhow::Result<Value> {
+    let next:Option<(String,i64,String)>=c.query_row(
+        "SELECT key,position,version FROM state_rows INDEXED BY state_rows_order WHERE scope=?1 AND value IS NOT NULL AND position>?2 ORDER BY position LIMIT 1",
+        params![format!("mem:obs:{session}"),position],|r|Ok((r.get(0)?,r.get(1)?,r.get(2)?))).optional()?;
+    let Some((id,position,version))=next else {return Ok(Value::Null)};
+    row(c,meta,session,&id,position,&version,remaining)
+}
+
+pub(super) fn next_pending(c: &Connection, meta: &semantic::Meta, project: i64, remaining: &mut usize) -> anyhow::Result<Value> {
+    let affected:Option<(i64,String,i64,String,String)>=c.query_row(
+        "SELECT w.session,s.name,w.position,w.cursor,w.status FROM retrieval_scoped_affected a INDEXED BY retrieval_scoped_affected_project JOIN retrieval_scoped_work w ON w.index_id=a.index_id AND w.session=a.session AND w.kind=a.kind JOIN retrieval_scoped_sessions s ON s.token=w.session WHERE a.index_id=?1 AND a.project=?2 AND a.kind=?3 ORDER BY a.session LIMIT 1",
+        params![meta.index_id,project,0],|r|Ok((r.get(0)?,r.get(1)?,r.get(2)?,r.get(3)?,r.get(4)?))).optional()?;
+    if let Some((token,session,position,cursor,status))=affected {
+        let mut output=json!({"queue":"affected","session_token":token,"session_id":session,"work_status":status,"work_position":position,"work_cursor":cursor,"work_kind":0});
+        if status=="ready" {
+            output["branch"]=json!("ready_cleanup");
+        } else {
+            let next=next_row(c,meta,&session,position,remaining)?;
+            if next.is_null() {output["branch"]=json!("work_completion")} else {
+                output["branch"]=next["branch"].clone();
+                output["observation"]=next;
+            }
+        }
+        return Ok(output);
+    }
+    let dirty:Option<(i64,String,String)>=c.query_row(
+        "SELECT d.session,s.name,d.id FROM retrieval_scoped_dirty d INDEXED BY retrieval_scoped_dirty_project JOIN retrieval_scoped_sessions s ON s.token=d.session WHERE d.index_id=?1 AND d.project=?2 ORDER BY d.session,d.id LIMIT 1",
+        params![meta.index_id,project],|r|Ok((r.get(0)?,r.get(1)?,r.get(2)?))).optional()?;
+    let Some((token,session,id))=dirty else {return Ok(Value::Null)};
+    let scope=format!("mem:obs:{session}");
+    let selected:Option<(String,i64)>=c.query_row(
+        "SELECT version,position FROM state_rows WHERE scope=?1 AND key=?2 AND value IS NOT NULL",
+        params![scope,id],|r|Ok((r.get(0)?,r.get(1)?))).optional()?;
+    let mut output=json!({"queue":"dirty","session_token":token,"session_id":session,"scope":scope,"id":id,"source_exists":selected.is_some()});
+    if let Some((version,position))=selected {
+        let next=row(c,meta,&session,&id,position,&version,remaining)?;
+        output["branch"]=next["branch"].clone();
+        output["observation"]=next;
+    } else {
+        output["branch"]=json!("dirty_key_cleanup");
+    }
+    Ok(output)
+}
+
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/scoped/keyword.rs b/engine/src/workers/state/adapters/sqlite/retrieval/scoped/keyword.rs
new file mode 100644
index 0000000..6c09c4b
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/scoped/keyword.rs
@@ -0,0 +1,116 @@
+use super::query::{available, guarded, kinds, partial, rank};
+use super::*;
+pub fn keyword_search(
+    c: &Connection,
+    meta: &semantic::Meta,
+    expression: Option<&str>,
+    limit: usize,
+    max_candidates: usize,
+    options: super::super::search_projection::Options<'_>,
+) -> anyhow::Result<Value> {
+    let availability = available(c, meta, options)?;
+    if !availability.usable {
+        return Ok(partial(meta, "project_index_not_ready"));
+    }
+    guarded(c, meta, || {
+        keyword_inner(c, meta, expression, limit, max_candidates, options, availability.partial_reason)
+    })
+}
+pub const LEXICAL_SQL: &str = "SELECT retrieval_scoped_lexical.rowid,1.0,scoped.id,session.name,scoped.generation,session.generation,scoped.project_generation,vector.id FROM retrieval_scoped_lexical CROSS JOIN retrieval_scoped_vectors scoped ON scoped.document=retrieval_scoped_lexical.rowid JOIN retrieval_scoped_sessions session ON session.token=scoped.session JOIN retrieval_vectors vector ON vector.index_id=scoped.index_id AND vector.epoch=scoped.epoch AND vector.id=scoped.id LEFT JOIN retrieval_source_items source_item ON source_item.index_id=scoped.index_id AND source_item.key=scoped.id AND source_item.scope=CASE scoped.kind WHEN 0 THEN 'mem:obs:'||session.name WHEN 1 THEN 'mem:memories' ELSE '' END LEFT JOIN state_rows current_source ON current_source.scope=CASE scoped.kind WHEN 0 THEN 'mem:obs:'||session.name WHEN 1 THEN 'mem:memories' ELSE '' END AND current_source.key=scoped.id WHERE retrieval_scoped_lexical MATCH ?1 AND scoped.index_id=?3 AND scoped.epoch=?4 AND scoped.project=?5 AND scoped.project_generation=1 AND scoped.generation=session.generation AND (scoped.kind=2 OR (source_item.version=current_source.version AND source_item.dirty=0 AND current_source.value IS NOT NULL)) AND (scoped.kind=2 OR (EXISTS(SELECT 1 FROM state_rows authority_session WHERE authority_session.scope='mem:sessions' AND authority_session.key=session.name AND authority_session.value IS NOT NULL AND CASE WHEN authority_session.value_bytes BETWEEN 1 AND 65536 AND CASE typeof(authority_session.value) WHEN 'blob' THEN length(authority_session.value) WHEN 'text' THEN length(authority_session.value)*4 ELSE 0 END BETWEEN 1 AND 65536 THEN state_project(authority_session.value,authority_session.value_bytes,NULL) END=?6) OR (NOT EXISTS(SELECT 1 FROM state_rows authority_session WHERE authority_session.scope='mem:sessions' AND authority_session.key=session.name AND authority_session.value IS NOT NULL) AND EXISTS(SELECT 1 FROM state_rows authority_summary WHERE authority_summary.scope='mem:summaries' AND authority_summary.key=session.name AND authority_summary.value IS NOT NULL AND CASE WHEN authority_summary.value_bytes BETWEEN 1 AND 65536 AND CASE typeof(authority_summary.value) WHEN 'blob' THEN length(authority_summary.value) WHEN 'text' THEN length(authority_summary.value)*4 ELSE 0 END BETWEEN 1 AND 65536 THEN state_project(authority_summary.value,authority_summary.value_bytes,session.name) END=?6)))) LIMIT ?2";
+fn keyword_inner(
+    c: &Connection,
+    meta: &semantic::Meta,
+    expression: Option<&str>,
+    limit: usize,
+    max_candidates: usize,
+    options: super::super::search_projection::Options<'_>,
+    readiness_reason: Option<&'static str>,
+) -> anyhow::Result<Value> {
+    if source::kind(c, &meta.index_id)?.is_none() && meta.lexical_count != meta.count {
+        return Err(protocol::error("STATE_LEXICAL_INDEX_NOT_READY"));
+    }
+    let project = project_token(c, options.project.unwrap())?
+        .ok_or_else(|| protocol::error("STATE_INDEX_NOT_READY"))?;
+    let project_generation = 1;
+    let session = options
+        .session_id
+        .map(|s| session_token(c, s))
+        .transpose()?
+        .flatten();
+    let mut output = Vec::with_capacity(limit);
+    let mut candidates = 0;
+    let mut exhausted = false;
+    let mut incomplete = false;
+    if options.session_id.is_none() || session.is_some() {
+        if let Some(expression) = expression {
+            let mut statement = c.prepare_cached(LEXICAL_SQL)?;
+            for kind in kinds(c, &meta.index_id, options)? {
+                let (project_scope, session_scope) = terms(
+                    &meta.index_id,
+                    meta.epoch,
+                    project,
+                    project_generation,
+                    kind,
+                    session.unwrap_or(0),
+                );
+                let scope = if session.is_some() {
+                    format!("session_scope:\"{session_scope}\"")
+                } else {
+                    format!("project_scope:\"{project_scope}\"")
+                };
+                let query = format!("({scope}) AND body:({expression})");
+                let remaining = max_candidates.saturating_sub(candidates);
+                let mut rows = statement.query(params![
+                    query,
+                    (remaining + 1) as i64,
+                    meta.index_id,
+                    meta.epoch,
+                    project,
+                    options.project.unwrap()
+                ])?;
+                while let Some(row) = rows.next()? {
+                    if candidates >= max_candidates {
+                        exhausted = true;
+                        break;
+                    }
+                    candidates += 1;
+                    let id: Option<String> = row.get(2)?;
+                    let current: Option<i64> = row.get(5)?;
+                    let source: Option<i64> = row.get(4)?;
+                    let indexed_project: Option<i64> = row.get(6)?;
+                    let session_id: Option<String> = row.get(3)?;
+                    if id.is_none()
+                        || current != source
+                        || indexed_project != Some(project_generation)
+                        || session_id.is_none()
+                        || row.get::<_, Option<String>>(7)?.is_none()
+                    {
+                        incomplete = true;
+                        continue;
+                    }
+                    let session_id = session_id.unwrap();
+                    output.push(json!({"obsId":id.unwrap(),"sessionId":session_id,"score":1.0}));
+                }
+                if exhausted {
+                    break;
+                }
+            }
+        }
+    }
+    output.sort_unstable_by(rank);
+    output.truncate(limit);
+    let projection =
+        super::super::search_projection::enrich(c, &meta.index_id, &mut output, options)?;
+    let reason = if incomplete {
+        Some("projection_source_missing")
+    } else if projection.is_some() {
+        projection
+    } else if exhausted {
+        Some("candidate_budget")
+    } else {
+        readiness_reason
+    };
+    Ok(
+        json!({"items":output,"candidates":candidates,"budget_exhausted":exhausted,"approximate":true,"status":if reason.is_some(){"partial"}else{"ready"},"reason":reason,"model":meta.model,"dimensions":meta.dimensions,"generation":meta.generation}),
+    )
+}
