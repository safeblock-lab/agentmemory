@@ -0,0 +1,117 @@
+use super::*;
+#[derive(Clone, Copy)]
+pub struct Member {
+    pub token: i64,
+    pub project: Option<i64>,
+    pub generation: i64,
+}
+pub fn project_token(c: &Connection, name: &str) -> anyhow::Result<Option<i64>> {
+    c.query_row(
+        "SELECT token FROM retrieval_scoped_projects WHERE name=?1",
+        [name],
+        |r| r.get(0),
+    )
+    .optional()
+    .map_err(Into::into)
+}
+pub fn session_token(c: &Connection, name: &str) -> anyhow::Result<Option<i64>> {
+    c.query_row(
+        "SELECT token FROM retrieval_scoped_sessions WHERE name=?1",
+        [name],
+        |r| r.get(0),
+    )
+    .optional()
+    .map_err(Into::into)
+}
+pub fn project(c: &Connection, name: &str) -> anyhow::Result<i64> {
+    c.execute(
+        "INSERT OR IGNORE INTO retrieval_scoped_projects(name) VALUES(?1)",
+        [name],
+    )?;
+    Ok(project_token(c, name)?.unwrap())
+}
+pub fn get(c: &Connection, name: &str) -> anyhow::Result<Member> {
+    get_bounded(c, name, usize::MAX)?
+        .map(|(member, _)| member)
+        .ok_or_else(|| protocol::error("STATE_TX_INVALID_REQUEST"))
+}
+pub fn get_bounded(
+    c: &Connection,
+    name: &str,
+    max_bytes: usize,
+) -> anyhow::Result<Option<(Member, usize)>> {
+    let (authority, bytes) = project_catalog::resolve_session_bounded(c, name, max_bytes)?;
+    if authority == Err("budget") {
+        return Ok(None);
+    }
+    let next = match authority {
+        Ok(name) => Some(project(c, &name)?),
+        Err(_) => None,
+    };
+    let saved: Option<(i64, Option<i64>, i64)> = c
+        .query_row(
+            "SELECT token,project,generation FROM retrieval_scoped_sessions WHERE name=?1",
+            [name],
+            |r| Ok((r.get(0)?, r.get(1)?, r.get(2)?)),
+        )
+        .optional()?;
+    if let Some((token, previous, generation)) = saved {
+        if previous == next {
+            return Ok(Some((Member {
+                token,
+                project: next,
+                generation,
+            }, bytes)));
+        }
+        super::super::graph_browse::session(c,name)?;
+        let generation = generation
+            .checked_add(1)
+            .ok_or_else(|| protocol::error("STATE_TX_LIMIT_EXCEEDED"))?;
+        c.execute("UPDATE retrieval_scoped_sessions SET project=?2,generation=?3,status='pending',cursor_index='',cursor_epoch=0,cursor_id='' WHERE token=?1",params![token,next,generation])?;
+        return Ok(Some((Member {
+            token,
+            project: next,
+            generation,
+        }, bytes)));
+    }
+    c.execute("INSERT INTO retrieval_scoped_sessions(name,project,generation,status,cursor_index,cursor_epoch,cursor_id) VALUES(?1,?2,1,?3,'',0,'')",params![name,next,if next.is_some(){"ready"}else{"unknown"}])?;
+    Ok(Some((Member {
+        token: session_token(c, name)?.unwrap(),
+        project: next,
+        generation: 1,
+    }, bytes)))
+}
+pub fn changed(c: &Connection, scope: &str, key: &str) -> anyhow::Result<()> {
+    if ["mem:sessions", "mem:summaries"].contains(&scope) {
+        let old: Option<Option<i64>> = c
+            .query_row(
+                "SELECT project FROM retrieval_scoped_sessions WHERE name=?1",
+                [key],
+                |r| r.get(0),
+            )
+            .optional()?;
+        let next = get(c, key)?;
+        if old != Some(next.project) {
+            let populated:bool=c.query_row("SELECT EXISTS(SELECT 1 FROM state_rows INDEXED BY state_rows_order WHERE scope=?1 AND value IS NOT NULL)",[format!("mem:obs:{key}")],|r|r.get(0))?;
+            let queue = old.is_some() || populated;
+            let mut indices = c.prepare(
+                "SELECT index_id FROM retrieval_semantic_meta ORDER BY index_id LIMIT 128",
+            )?;
+            let indices = indices
+                .query_map([], |r| r.get::<_, String>(0))?
+                .collect::<rusqlite::Result<Vec<_>>>()?;
+            for project in old.into_iter().flatten().chain(next.project) {
+                protocol::require(c.execute("UPDATE retrieval_scoped_projects SET generation=generation+1 WHERE token=?1 AND generation<9007199254740990",[project])?==1)?;
+                if queue {
+                    for index in &indices {
+                        for kind in [0, 3] {
+                            c.execute("INSERT INTO retrieval_scoped_work VALUES(?1,?2,?3,'pending',-1,'') ON CONFLICT(index_id,session,kind) DO UPDATE SET status='pending',position=-1,cursor=''",params![index,next.token,kind])?;
+                            c.execute("INSERT OR IGNORE INTO retrieval_scoped_affected VALUES(?1,?2,?3,?4)",params![index,next.token,kind,project])?;
+                        }
+                    }
+                }
+            }
+        }
+    }
+    Ok(())
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/scoped/mod.rs b/engine/src/workers/state/adapters/sqlite/retrieval/scoped/mod.rs
new file mode 100644
