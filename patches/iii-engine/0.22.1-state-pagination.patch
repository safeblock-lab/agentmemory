+#[test]
+fn canonical_scoped_reopen_move_and_immediate_cut_measurement() {
+    let path = canonical_durable::path();
+    let c = database::open(&path).unwrap();
+    tracked(&c);
+    session(&c, "s", "p");
+    for n in 0..20 {
+        let id = format!("a{n:02}");
+        observation(&c, &id, "s", "needle");
+        embed(&c, &id, "s");
+    }
+    c.execute("DELETE FROM retrieval_scoped_postings", [])
+        .unwrap();
+    c.execute("DELETE FROM retrieval_scoped_lexical", [])
+        .unwrap();
+    c.execute("DELETE FROM retrieval_scoped_vectors", [])
+        .unwrap();
+    c.execute("UPDATE retrieval_scoped_meta SET status='pending'", [])
+        .unwrap();
+    let start = std::time::Instant::now();
+    let tx =
+        rusqlite::Transaction::new_unchecked(&c, rusqlite::TransactionBehavior::Immediate).unwrap();
+    let v=execute(&tx,request::parse(json!({"action":"project_vectors_prepare","index_id":"observations","project":"p","source_kind":"observation","max_rows":4})).unwrap()).unwrap();
+    tx.commit().unwrap();
+    let us = start.elapsed().as_micros();
+    assert_eq!(v["processed"], 4);
+    assert_eq!(v["status"], "pending");
+    drop(c);
+    let c = database::open(&path).unwrap();
+    let next = cut(&c, "p", 4);
+    assert_eq!(next["processed"], 4);
+    assert_ne!(next["cursor"], v["cursor"]);
+    session(&c, "s", "q");
+    drop(c);
+    let c = database::open(&path).unwrap();
+    prepared(&c, "q");
+    prepared(&c, "p");
+    assert_eq!(
+        returned_ids(&search(&c, "p", "keyword_search", 1)),
+        Vec::<String>::new()
+    );
+    assert!(!returned_ids(&search(&c, "q", "keyword_search", 1)).is_empty());
+    #[cfg(windows)]
+    println!(
+        "SCOPED_IMMEDIATE_CUT processed={} text_bytes={} lock_us={us} process_peak_bytes={}",
+        v["processed"],
+        v["text_bytes"],
+        canonical_postings::peak_working_set()
+    );
+}
