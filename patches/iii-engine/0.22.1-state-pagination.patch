+        name: "state_rows".into(),
+        columns: [
+            "scope",
+            "key",
+            "value",
+            "version",
+            "position",
+            "value_bytes",
+        ]
+        .map(str::to_string)
+        .to_vec(),
+        keys: vec![0, 1],
+    }
+}
+fn row(i: usize, value: Option<String>) -> Vec<Value> {
+    let bytes = value.as_ref().map(String::len).unwrap_or(0);
+    vec![
+        Value::Text("scope".into()),
+        Value::Text(format!("ñ😀{i:08}")),
+        value.map(Value::Text).unwrap_or(Value::Null),
+        Value::Text(format!("v{i}")),
+        if bytes == 0 {
+            Value::Null
+        } else {
+            Value::Integer(-(i as i64))
+        },
+        Value::Integer(bytes as i64),
+    ]
+}
+#[test]
+fn sqlite_state_pool_preserves_exact_codec_order_tombstones_and_reverse() {
+    let t = table();
+    let mut pool = Pool::new(&t, false).unwrap();
+    let mut reverse = Pool::new(&t, true).unwrap();
+    for batch in 0..4 {
+        let source: Vec<_> = (0..97)
+            .map(|i| {
+                row(
+                    batch * 97 + i,
+                    if i % 11 == 0 {
+                        None
+                    } else if i % 3 == 0 {
+                        Some(format!("{{\"n\":{i}}}"))
+                    } else {
+                        Some(format!("{{\"text\":\"{}\"}}", "repeat/".repeat(i + 1)))
+                    },
+                )
+            })
+            .collect();
+        let expected: Vec<_> = source
+            .iter()
+            .cloned()
+            .map(|mut r| {
+                if let Value::Text(v) = &r[2] {
+                    r[2] = Value::Blob(codec::encode(v).unwrap())
+                }
+                r
+            })
+            .collect();
+        let encoded = pool.encode(source.clone()).unwrap();
+        assert_eq!(encoded, expected);
+        assert_eq!(reverse.encode(encoded).unwrap(), source);
+    }
+    pool.finish().unwrap();
+    reverse.finish().unwrap();
+}
+#[test]
+fn sqlite_state_pool_rejects_invalid_json_bytes_and_oversized_batches() {
