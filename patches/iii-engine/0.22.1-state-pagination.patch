+use super::*;
+fn session(c: &Connection, id: &str, project: &str) {
+    write(
+        c,
+        "mem:sessions",
+        id,
+        Some(&json!({"id":id,"project":project})),
+    );
+}
+fn tracked(c: &Connection) {
+    let mut v = semantic_request("semantic_configure");
+    v["source_kind"] = json!("agentmemory");
+    call(c, v).unwrap();
+}
+fn observation(c: &Connection, id: &str, session: &str, title: &str) {
+    let scope = format!("mem:obs:{session}");
+    write(
+        c,
+        &scope,
+        id,
+        Some(
+            &json!({"id":id,"sessionId":session,"title":title,"narrative":"needle useful text","facts":[],"concepts":[],"files":[]}),
+        ),
+    );
+}
+fn embed(c: &Connection, id: &str, session: &str) {
+    let scope = format!("mem:obs:{session}");
+    let mut item = vector_item(id, &[1., 0., 0., 0.], Some("ignored"));
+    item["session_id"] = json!(session);
+    item["source_scope"] = json!(scope);
+    item["source_version"] = json!(database::row(c, &scope, id).unwrap().version.to_string());
+    upsert(c, vec![item]).unwrap();
+}
+fn cut(c: &Connection, project: &str, rows: usize) -> Value {
+    call(c,json!({"action":"project_vectors_prepare","index_id":"observations","project":project,"source_kind":"observation","max_rows":rows,"max_bytes":65536})).unwrap()
+}
+fn prepared(c: &Connection, project: &str) {
+    for _ in 0..200 {
+        let v = cut(c, project, 16);
+        assert!(v["processed"].as_u64().unwrap() <= 16);
+        assert!(v["session_visits"].as_u64().unwrap() <= 16);
+        assert!(v["text_bytes"].as_u64().unwrap() <= 1_048_576);
+        if v["status"] == "ready" {
+            return;
+        }
+        assert_ne!(v["status"], "partial", "{v}");
+    }
+    panic!("project did not prepare");
+}
+fn search(c: &Connection, project: &str, action: &str, candidates: usize) -> Value {
+    let mut v = semantic_request(action);
+    v["project"] = json!(project);
+    v["source_kind"] = json!("observation");
+    v["limit"] = json!(1);
+    v["max_candidates"] = json!(candidates);
+    if action == "keyword_search" {
+        v["query"] = json!("needle");
+    } else {
+        v["embedding"] = json!(encoded(&[1., 0., 0., 0.]));
+    }
+    call(c, v).unwrap()
+}
