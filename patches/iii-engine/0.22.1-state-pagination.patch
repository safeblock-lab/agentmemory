+    assert_eq!(configured_path(Some(&json!({}))).unwrap(), default);
+    assert_eq!(
+        configured_path(Some(&json!({"file_path":"custom.sqlite3"}))).unwrap(),
+        std::path::PathBuf::from("custom.sqlite3")
+    );
+    for config in [
+        json!({"file_path":null}),
+        json!({"file_path":42}),
