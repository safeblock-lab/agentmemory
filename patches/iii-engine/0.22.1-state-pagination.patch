+use super::super::request::MAX_PROJECT_CATALOG_UNKNOWN_CURSOR_BYTES;
+use super::super::{database, protocol};
+use rusqlite::{Connection, OptionalExtension, params};
+use serde::{Deserialize, Serialize};
+use serde_json::{Value, json};
+
+const MAX_ROWS: usize = 16;
+const MAX_BYTES: usize = 65_536;
+const MAX_KEY_BYTES: usize = 4096;
+const COMPRESSED_HEADER: &[u8] = b"\x89AMV2Z\x01";
+
+#[derive(Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+struct Cursor {
+    version: u8,
+    source: String,
+    status: String,
+    revision: String,
+    epoch: i64,
+    catalog_cursor: i64,
+    incomplete_rows: i64,
+    last_key: String,
+}
+
+struct Snapshot {
+    source: String,
+    status: String,
+    catalog_cursor: i64,
+    revision: String,
+    current_revision: String,
+    epoch: i64,
+    incomplete_rows: i64,
+}
+
+struct Unknown {
+    key: String,
+    version: String,
+}
+
+pub fn page(
+    connection: &Connection,
+    source: &str,
+    cursor: Option<&str>,
+    limit: usize,
+    max_bytes: usize,
+) -> anyhow::Result<Value> {
+    let scope =
+        super::source_scope(source).ok_or_else(|| protocol::error("STATE_TX_INVALID_REQUEST"))?;
+    protocol::require((1..=MAX_ROWS).contains(&limit) && (1024..=MAX_BYTES).contains(&max_bytes))?;
+    let (status, catalog_cursor, revision, epoch, incomplete_rows) =
+        super::catalog_row(connection, source)?;
+    let current_revision = database::revision(connection, scope)?.to_string();
+    protocol::require(incomplete_rows >= 0)?;
+    let snapshot = Snapshot {
+        source: source.to_owned(),
+        status,
+        catalog_cursor,
+        revision,
+        current_revision,
+        epoch,
+        incomplete_rows,
+    };
+
+    let after_key = match cursor {
+        Some(value) => {
+            protocol::require(value.len() <= MAX_PROJECT_CATALOG_UNKNOWN_CURSOR_BYTES)?;
+            let token: Cursor = serde_json::from_str(value)
+                .map_err(|_| protocol::error("STATE_TX_INVALID_REQUEST"))?;
+            protocol::require(token.last_key.len() <= MAX_KEY_BYTES)?;
+            if !snapshot_matches(&snapshot, &token)
+                || snapshot.revision != snapshot.current_revision
+            {
+                return Err(protocol::error("STATE_RETRIEVAL_STALE_CURSOR"));
+            }
+            Some(token.last_key)
+        }
+        None if snapshot.revision != snapshot.current_revision => {
+            return Ok(stale_response(&snapshot));
+        }
+        None => None,
+    };
+
+    let candidates = read_unknowns(connection, source, epoch, limit, after_key.as_deref())?;
+    let mut items = Vec::with_capacity(limit.min(candidates.len()));
+    for (index, unknown) in candidates.iter().take(limit).enumerate() {
+        let item = inspect(connection, source, scope, unknown)?;
+        let more_after = index + 1 < candidates.len();
+        let next_cursor = if more_after {
+            Some(encode_cursor(&snapshot, &unknown.key)?)
+        } else {
+            None
+        };
+        let mut proposed = items.clone();
+        proposed.push(item.clone());
+        let response = response(&snapshot, proposed, more_after, next_cursor);
+        if protocol::size(&response)? > max_bytes {
+            if items.is_empty() {
+                return Err(super::super::request::resource());
+            }
+            break;
+        }
+        items.push(item);
+    }
+
+    let has_more = items.len() < candidates.len();
+    let next_cursor = if has_more {
+        let last_key = candidates
+            .get(items.len().saturating_sub(1))
+            .ok_or_else(|| protocol::error("STATE_TX_INVALID_REQUEST"))?;
+        Some(encode_cursor(&snapshot, &last_key.key)?)
+    } else {
+        None
+    };
+    let result = response(&snapshot, items, has_more, next_cursor);
+    if protocol::size(&result)? > max_bytes {
+        return Err(super::super::request::resource());
+    }
+    Ok(result)
+}
+
+fn snapshot_matches(snapshot: &Snapshot, cursor: &Cursor) -> bool {
+    cursor.version == 2
+        && cursor.source == snapshot.source
+        && cursor.status == snapshot.status
+        && cursor.revision == snapshot.revision
+        && cursor.epoch == snapshot.epoch
+        && cursor.catalog_cursor == snapshot.catalog_cursor
+        && cursor.incomplete_rows == snapshot.incomplete_rows
+}
+
+fn encode_cursor(snapshot: &Snapshot, last_key: &str) -> anyhow::Result<String> {
+    protocol::require(last_key.len() <= MAX_KEY_BYTES)?;
+    let cursor = serde_json::to_string(&Cursor {
+        version: 2,
+        source: snapshot.source.clone(),
+        status: snapshot.status.clone(),
+        revision: snapshot.revision.clone(),
+        epoch: snapshot.epoch,
+        catalog_cursor: snapshot.catalog_cursor,
+        incomplete_rows: snapshot.incomplete_rows,
+        last_key: last_key.to_owned(),
+    })?;
+    protocol::require(cursor.len() <= MAX_PROJECT_CATALOG_UNKNOWN_CURSOR_BYTES)?;
+    Ok(cursor)
+}
+
+fn response(
+    snapshot: &Snapshot,
+    items: Vec<Value>,
+    has_more: bool,
+    next_cursor: Option<String>,
+) -> Value {
+    json!({
+        "status": snapshot.status,
+        "catalog_status": snapshot.status,
+        "source": snapshot.source,
+        "revision": snapshot.revision,
+        "current_revision": snapshot.current_revision,
+        "epoch": snapshot.epoch.to_string(),
+        "catalog_cursor": snapshot.catalog_cursor.to_string(),
+        "incomplete_rows": snapshot.incomplete_rows.to_string(),
+        "items": items,
+        "has_more": has_more,
+        "next_cursor": next_cursor,
+    })
+}
+
+fn stale_response(snapshot: &Snapshot) -> Value {
+    let mut value = response(snapshot, Vec::new(), false, None);
+    value["status"] = json!("stale");
+    value["reason"] = json!("source_revision_stale");
+    value
+}
+
+fn read_unknowns(
+    connection: &Connection,
+    source: &str,
+    epoch: i64,
+    limit: usize,
+    after_key: Option<&str>,
+) -> anyhow::Result<Vec<Unknown>> {
+    let rows = if let Some(after_key) = after_key {
+        let mut statement = connection.prepare(
+            "SELECT substr(CAST(source_key AS BLOB),1,4097),length(CAST(source_key AS BLOB)),substr(CAST(version AS BLOB),1,21),length(CAST(version AS BLOB)) FROM retrieval_project_unknown WHERE source=?1 AND epoch=?2 AND source_key>?3 ORDER BY source_key LIMIT ?4",
+        )?;
+        statement
+            .query_map(
+                params![source, epoch, after_key, (limit + 1) as i64],
+                |row| {
+                    Ok((
+                        row.get::<_, Vec<u8>>(0)?,
+                        row.get::<_, i64>(1)?,
+                        row.get::<_, Vec<u8>>(2)?,
+                        row.get::<_, i64>(3)?,
+                    ))
+                },
+            )?
+            .collect::<rusqlite::Result<Vec<_>>>()?
+    } else {
+        let mut statement = connection.prepare(
+            "SELECT substr(CAST(source_key AS BLOB),1,4097),length(CAST(source_key AS BLOB)),substr(CAST(version AS BLOB),1,21),length(CAST(version AS BLOB)) FROM retrieval_project_unknown WHERE source=?1 AND epoch=?2 ORDER BY source_key LIMIT ?3",
+        )?;
+        statement
+            .query_map(params![source, epoch, (limit + 1) as i64], |row| {
+                Ok((
+                    row.get::<_, Vec<u8>>(0)?,
+                    row.get::<_, i64>(1)?,
+                    row.get::<_, Vec<u8>>(2)?,
+                    row.get::<_, i64>(3)?,
+                ))
+            })?
+            .collect::<rusqlite::Result<Vec<_>>>()?
+    };
+    let mut unknowns = Vec::with_capacity(rows.len());
+    for (key, key_bytes, version, version_bytes) in rows {
+        if key_bytes > MAX_KEY_BYTES as i64 || version_bytes > 20 {
+            return Err(super::super::request::resource());
+        }
+        let version =
+            String::from_utf8(version).map_err(|_| protocol::error("STATE_TX_INVALID_REQUEST"))?;
+        protocol::counter(&version)?;
+        unknowns.push(Unknown {
+            key: String::from_utf8(key).map_err(|_| protocol::error("STATE_TX_INVALID_REQUEST"))?,
+            version,
+        });
+    }
+    Ok(unknowns)
+}
+
+fn inspect(
+    connection: &Connection,
+    source: &str,
+    scope: &str,
+    unknown: &Unknown,
+) -> anyhow::Result<Value> {
+    let current: Option<(Vec<u8>, i64, bool, i64, Option<i64>)> = connection
+        .query_row(
+            "SELECT substr(CAST(version AS BLOB),1,21),length(CAST(version AS BLOB)),value IS NOT NULL,value_bytes,CASE WHEN value IS NOT NULL THEN length(CAST(value AS BLOB)) END FROM state_rows WHERE scope=?1 AND key=?2",
+            params![scope, unknown.key],
+            |row| Ok((row.get(0)?, row.get(1)?, row.get(2)?, row.get(3)?, row.get(4)?)),
+        )
+        .optional()?;
+    let Some((current_version, current_version_bytes, present, logical_bytes, stored_bytes)) =
+        current
+    else {
+        return Ok(item(unknown, None, None, None, "missing", None));
+    };
+    if current_version_bytes > 20 {
+        return Err(super::super::request::resource());
+    }
+    let current_version = String::from_utf8(current_version)
+        .map_err(|_| protocol::error("STATE_TX_INVALID_REQUEST"))?;
+    protocol::counter(&current_version)?;
+    if !present {
+        return Ok(item(
+            unknown,
+            Some(current_version),
+            None,
+            None,
+            "missing",
+            None,
+        ));
+    }
+    let stored_bytes = stored_bytes.unwrap_or_default();
+    if current_version != unknown.version {
+        return Ok(item(
+            unknown,
+            Some(current_version),
+            Some(logical_bytes),
+            Some(stored_bytes),
+            "stale",
+            Some("source_version_changed"),
+        ));
+    }
+    if logical_bytes <= 0 || stored_bytes <= 0 {
+        return Ok(item(
+            unknown,
+            Some(current_version),
+            Some(logical_bytes),
+            Some(stored_bytes),
+            "invalid_size",
+            None,
+        ));
+    }
+    if logical_bytes > MAX_BYTES as i64 || stored_bytes > MAX_BYTES as i64 {
+        return Ok(item(
+            unknown,
+            Some(current_version),
+            Some(logical_bytes),
+            Some(stored_bytes),
+            if logical_bytes > super::super::super::codec::MAX_LOGICAL_VALUE_BYTES as i64 || stored_bytes > super::super::super::codec::MAX_LOGICAL_VALUE_BYTES as i64 { "oversized" } else { "requires_exact_repair" },
+            None,
+        ));
+    }
+
+    let encoded: Option<Vec<u8>> = connection
+        .query_row(
+            "SELECT value FROM state_rows WHERE scope=?1 AND key=?2 AND version=?3 AND value IS NOT NULL AND value_bytes=?4 AND length(CAST(value AS BLOB))=?5 AND value_bytes BETWEEN 1 AND ?6 AND length(CAST(value AS BLOB)) BETWEEN 1 AND ?6",
+            params![scope, unknown.key, current_version, logical_bytes, stored_bytes, MAX_BYTES as i64],
+            |row| Ok(row.get_ref(0)?.as_bytes()?.to_vec()),
+        )
+        .optional()?;
+    let Some(encoded) = encoded else {
+        return Ok(item(
+            unknown,
+            Some(current_version),
+            Some(logical_bytes),
+            Some(stored_bytes),
+            "stale",
+            Some("source_version_changed"),
+        ));
+    };
+    let raw = match database::decode_value(&encoded, logical_bytes) {
+        Ok(value) => value,
+        Err(_) => {
+            let reason = if encoded.starts_with(COMPRESSED_HEADER) {
+                "invalid_compression"
+            } else {
+                "invalid_encoding"
+            };
+            return Ok(item(
+                unknown,
+                Some(current_version),
+                Some(logical_bytes),
+                Some(stored_bytes),
+                reason,
+                None,
+            ));
+        }
+    };
+    let value: Value = match serde_json::from_str(&raw) {
+        Ok(value) => value,
+        Err(_) => {
+            return Ok(item(
+                unknown,
+                Some(current_version),
+                Some(logical_bytes),
+                Some(stored_bytes),
+                "invalid_json",
+                None,
+            ));
+        }
+    };
+    let (reason, detail) = authority_reason(source, &unknown.key, &value);
+    Ok(item(
+        unknown,
+        Some(current_version),
+        Some(logical_bytes),
+        Some(stored_bytes),
+        reason,
+        Some(detail),
+    ))
+}
+
+fn authority_reason(source: &str, key: &str, value: &Value) -> (&'static str, &'static str) {
+    if value.get("deleted") == Some(&Value::Bool(true))
+        || value.get("stale") == Some(&Value::Bool(true))
+    {
+        return ("stale", "record_marked_stale");
+    }
+    if !value.is_object() {
+        return ("invalid_authority", "value_not_object");
+    }
+    if source == "summaries" {
+        match value.get("sessionId") {
+            None => return ("missing_authority", "sessionId"),
+            Some(Value::String(id)) if !id.is_empty() && id.len() <= 256 => {}
+            _ => return ("invalid_authority", "sessionId"),
+        }
+    } else if key.trim().is_empty() || key.len() > 256 {
+        return ("invalid_authority", "sessionId");
+    }
+    match super::authority_fields(source, key, value) {
+        Ok(super::extraction::Authority::Project(_, _)) => ("stale", "catalog_entry_no_longer_unknown"),
+        Ok(super::extraction::Authority::Excluded(_)) => ("no_project_authority", "project"),
+        Err(_) => match value.get("project") {
+            None => ("missing_authority", "project"),
+            Some(Value::String(project)) if !project.trim().is_empty() && project.len() <= 256 => {
+                ("invalid_authority", "sessionId")
+            }
+            Some(Value::Null) => ("no_project_authority", "project"),
+            Some(Value::String(project)) if project.trim().is_empty() => {
+                ("no_project_authority", "project")
+            }
+            _ => ("invalid_authority", "project"),
+        },
+    }
+}
+
+fn item(
+    unknown: &Unknown,
+    current_version: Option<String>,
+    logical_bytes: Option<i64>,
+    stored_bytes: Option<i64>,
+    reason: &str,
+    detail: Option<&str>,
+) -> Value {
+    json!({
+        "key": unknown.key,
+        "version": unknown.version,
+        "current_version": current_version,
+        "logical_bytes": logical_bytes,
+        "stored_bytes": stored_bytes,
+        "reason": reason,
+        "reason_detail": detail,
+    })
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/project_catalog/extraction.rs b/engine/src/workers/state/adapters/sqlite/retrieval/project_catalog/extraction.rs
