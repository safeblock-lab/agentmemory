+++ b/engine/src/workers/state/adapters/sqlite/graph_metadata_tests.rs
@@ -0,0 +1,247 @@
+use super::fresh;
+use super::super::{database, protocol, SqliteAdapter, StateAdapter};
+use rusqlite::Connection;
+use serde_json::{json, Value};
+
+const MIN_SCAN_BYTES: u64 = 8192;
+
+async fn prepare(adapter: &SqliteAdapter, limit: usize) -> anyhow::Result<Value> {
+    adapter
+        .storage(json!({
+            "action": "graph_metadata_prepare",
+            "limit": limit,
+            "max_bytes": MIN_SCAN_BYTES,
+            "max_ms": 3000
+        }))
+        .await
+}
+
+async fn read(adapter: &SqliteAdapter) -> anyhow::Result<Value> {
+    adapter.storage(json!({"action":"graph_metadata"})).await
+}
+
+fn scoped_totals(connection: &Connection) -> anyhow::Result<(u64, u64, u64)> {
+    let mut rows = 0u64;
+    let mut logical_bytes = 0u64;
+    let mut stored_bytes = 0u64;
+    for scope in protocol::GRAPH_RECORD_SCOPES {
+        let (scope_rows, scope_logical, scope_stored): (i64, i64, i64) = connection.query_row(
+            "SELECT count(*),COALESCE(sum(value_bytes),0),COALESCE(sum(length(value)),0) FROM state_rows WHERE scope=?1 AND value IS NOT NULL",
+            [scope],
+            |row| Ok((row.get(0)?, row.get(1)?, row.get(2)?)),
+        )?;
+        rows += u64::try_from(scope_rows)?;
+        logical_bytes += u64::try_from(scope_logical)?;
+        stored_bytes += u64::try_from(scope_stored)?;
+    }
+    Ok((rows, logical_bytes, stored_bytes))
+}
+
+async fn assert_matches_sql_oracle(adapter: &SqliteAdapter) -> (u64, u64, u64) {
+    let metadata = read(adapter).await.unwrap();
+    let oracle = adapter.run(4096, |connection| scoped_totals(connection)).await.unwrap();
+    assert_eq!(metadata["status"], "ready");
+    assert_eq!(metadata["rows"].as_u64(), Some(oracle.0));
+    assert_eq!(metadata["logical_bytes"].as_u64(), Some(oracle.1));
+    assert_eq!(metadata["stored_bytes"].as_u64(), Some(oracle.2));
+    oracle
+}
+
+#[tokio::test]
+async fn graph_metadata_distinguishes_missing_cache_from_ready_empty() {
+    let (_directory, adapter) = fresh();
+    let missing = read(&adapter).await.unwrap();
+    assert_eq!(missing["status"], "unavailable");
+    assert_eq!(missing["complete"], false);
+    assert_eq!(missing["rows"], Value::Null);
+    assert_eq!(missing["reason"], "metadata_not_prepared");
+
+    let prepared = prepare(&adapter, 1).await.unwrap();
+    assert_eq!(prepared["status"], "complete");
+    assert_eq!(prepared["rows"], 0);
+    assert_eq!(prepared["scope_count"], 7);
+    let empty = read(&adapter).await.unwrap();
+    assert_eq!(empty["status"], "ready");
+    assert_eq!(empty["complete"], true);
+    assert_eq!(empty["rows"], 0);
+    assert_eq!(empty["logical_bytes"], 0);
+    assert_eq!(empty["stored_bytes"], 0);
+}
+
+#[tokio::test]
+async fn graph_metadata_counts_only_live_rows_in_the_exact_seven_scopes() {
+    let (_directory, adapter) = fresh();
+    adapter
+        .mutate(4096, |connection| {
+            for (index, scope) in protocol::GRAPH_RECORD_SCOPES.into_iter().enumerate() {
+                let value = if index == 0 {
+                    json!({"payload":"x".repeat(16384)})
+                } else {
+                    json!({"scope":scope,"index":index})
+                };
+                database::write(connection, scope, "sample", Some(&value))?;
+            }
+            database::write(connection, protocol::GRAPH_RECORD_SCOPES[1], "deleted", None)?;
+            database::write(connection, protocol::JOBS, "job", Some(&json!({"state":"done"})))?;
+            database::write(connection, "other:state", "row", Some(&json!({"kept":true})))?;
+            Ok(())
+        })
+        .await
+        .unwrap();
+
+    assert_eq!(prepare(&adapter, 1024).await.unwrap()["status"], "complete");
+    let totals = assert_matches_sql_oracle(&adapter).await;
+    assert_eq!(totals.0, 7);
+    assert_ne!(totals.1, totals.2);
+}
+
+#[tokio::test]
+async fn graph_metadata_preparation_pages_resume_and_writes_preserve_partial_cache() {
+    let (_directory, adapter) = fresh();
+    adapter
+        .mutate(4096, |connection| {
+            for index in 0..5 {
+                let key = format!("node-{index}");
+                database::write(
+                    connection,
+                    protocol::GRAPH_RECORD_SCOPES[0],
+                    &key,
+                    Some(&json!({"index":index})),
+                )?;
+            }
+            database::write(connection, protocol::GRAPH_RECORD_SCOPES[0], "tombstone", None)?;
+            Ok(())
+        })
+        .await
+        .unwrap();
+
+    let mut pages = 0;
+    let mut rows_scanned = 0;
+    loop {
+        let page = prepare(&adapter, 2).await.unwrap();
+        pages += 1;
+        let page_rows = page["rows_scanned"].as_u64().unwrap();
+        assert!(page_rows <= 2);
+        rows_scanned += page_rows;
+        if pages == 1 {
+            assert_eq!(page["status"], "preparing");
+            assert_eq!(read(&adapter).await.unwrap()["status"], "preparing");
+        }
+        if page["status"] == "complete" {
+            assert_eq!(page["rows"], 5);
+            break;
+        }
+        assert_eq!(page["status"], "preparing");
+        assert!(pages < 10);
+    }
+    assert!(pages >= 3);
+    assert_eq!(rows_scanned, 6);
+    assert_eq!(assert_matches_sql_oracle(&adapter).await.0, 5);
+
+    let (_partial_directory, partial) = fresh();
+    partial
+        .mutate(4096, |connection| {
+            for key in ["a", "b"] {
+                database::write(
+                    connection,
+                    protocol::GRAPH_RECORD_SCOPES[0],
+                    key,
+                    Some(&json!({"key":key})),
+                )?;
+            }
+            Ok(())
+        })
+        .await
+        .unwrap();
+    assert_eq!(prepare(&partial, 1).await.unwrap()["status"], "preparing");
+    partial
+        .mutate(4096, |connection| {
+            database::write(connection, protocol::GRAPH_RECORD_SCOPES[0], "a", Some(&json!({"key":"updated"})))?;
+            database::write(connection, protocol::GRAPH_RECORD_SCOPES[0], "a", Some(&json!({"key":"updated-again"})))?;
+            database::write(connection, protocol::GRAPH_RECORD_SCOPES[0], "0", Some(&json!({"key":"before-cursor"})))?;
+            database::write(connection, protocol::GRAPH_RECORD_SCOPES[0], "b", None)?;
+            database::write(
+                connection,
+                protocol::GRAPH_RECORD_SCOPES[0],
+                "c",
+                Some(&json!({"key":"c"})),
+            )?;
+            Ok(())
+        })
+        .await
+        .unwrap();
+    assert_eq!(read(&partial).await.unwrap()["status"], "preparing");
+    let completed = prepare(&partial, 1024).await.unwrap();
+    assert_eq!(completed["status"], "complete");
+    assert_eq!(completed["rows"], 3);
+    assert_eq!(assert_matches_sql_oracle(&partial).await.0, 3);
+}
+
+#[tokio::test]
+async fn graph_metadata_tracks_transactional_growth_shrink_delete_and_revision_mismatch() {
+    let (_directory, adapter) = fresh();
+    let scope = protocol::GRAPH_RECORD_SCOPES[0];
+    adapter
+        .mutate(4096, move |connection| {
+            database::write(connection, scope, "node", Some(&json!("seed")))?;
+            Ok(())
+        })
+        .await
+        .unwrap();
+    assert_eq!(prepare(&adapter, 1024).await.unwrap()["status"], "complete");
+
+    let initial = assert_matches_sql_oracle(&adapter).await;
+    let grown = json!("x".repeat(8192));
+    adapter
+        .mutate(16384, move |connection| {
+            database::write(connection, scope, "node", Some(&grown))?;
+            Ok(())
+        })
+        .await
+        .unwrap();
+    let after_growth = assert_matches_sql_oracle(&adapter).await;
+    assert!(after_growth.1 > initial.1);
+    assert!(after_growth.2 > initial.2);
+
+    adapter
+        .mutate(4096, move |connection| {
+            database::write(connection, scope, "node", Some(&json!("small")))?;
+            Ok(())
+        })
+        .await
+        .unwrap();
+    let after_shrink = assert_matches_sql_oracle(&adapter).await;
+    assert!(after_shrink.1 < after_growth.1);
+    assert!(after_shrink.2 < after_growth.2);
+
+    adapter
+        .mutate(4096, move |connection| {
+            database::write(connection, scope, "node", None)?;
+            Ok(())
+        })
+        .await
+        .unwrap();
+    let deleted = assert_matches_sql_oracle(&adapter).await;
+    assert_eq!(deleted, (0, 0, 0));
+    assert!(adapter.run(4096, move |connection| {
+        Ok(connection.query_row(
+            "SELECT value IS NULL FROM state_rows WHERE scope=?1 AND key='node'",
+            [scope],
+            |row| row.get::<_, bool>(0),
+        )?)
+    }).await.unwrap());
+
+    adapter
+        .mutate(4096, move |connection| {
+            connection.execute(
+                "UPDATE state_scopes SET revision='999999' WHERE scope=?1",
+                [scope],
+            )?;
+            Ok(())
+        })
+        .await
+        .unwrap();
+    let stale = read(&adapter).await.unwrap();
+    assert_eq!(stale["status"], "stale");
+    assert_eq!(stale["reason"], "metadata_stale");
+}
