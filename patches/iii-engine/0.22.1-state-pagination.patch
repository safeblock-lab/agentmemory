+++ b/engine/src/workers/state/adapters/sqlite/retrieval/viewer_recent/mod.rs
@@ -0,0 +1,95 @@
+mod page;
+mod prepare;
+mod projection;
+
+pub use page::page;
+pub use prepare::{prepare, status};
+pub use projection::validate_fields;
+
+use super::super::{database, protocol};
+use rusqlite::{params, Connection, OptionalExtension};
+use serde_json::Value;
+
+pub(super) const SOURCE_MAX: i64 = 16 * 1024 * 1024;
+
+
+pub fn schema(c: &Connection) -> anyhow::Result<()> {
+    c.execute_batch("CREATE TABLE IF NOT EXISTS viewer_recent_meta(id INTEGER PRIMARY KEY CHECK(id=1),scope_cursor TEXT NOT NULL,key_cursor TEXT NOT NULL,scanned INTEGER NOT NULL,ready INTEGER NOT NULL,generation INTEGER NOT NULL);
+        INSERT OR IGNORE INTO viewer_recent_meta VALUES(1,'mem:sessions','',0,0,1);
+        CREATE TABLE IF NOT EXISTS viewer_recent_rows(scope TEXT NOT NULL,key TEXT NOT NULL,entity TEXT NOT NULL,session_id TEXT NOT NULL,stamp INTEGER NOT NULL,invalid_stamp INTEGER NOT NULL,version TEXT NOT NULL,PRIMARY KEY(scope,key)) WITHOUT ROWID;
+        CREATE INDEX IF NOT EXISTS viewer_recent_order ON viewer_recent_rows(entity,stamp DESC,scope,key);
+        CREATE INDEX IF NOT EXISTS viewer_recent_session_order ON viewer_recent_rows(entity,session_id,stamp DESC,scope,key);
+        CREATE TABLE IF NOT EXISTS viewer_session_count(id INTEGER PRIMARY KEY CHECK(id=1),total INTEGER NOT NULL,revision INTEGER NOT NULL,initialized INTEGER NOT NULL);
+        INSERT OR IGNORE INTO viewer_session_count VALUES(1,0,0,0);
+        CREATE TRIGGER IF NOT EXISTS viewer_session_count_insert AFTER INSERT ON viewer_recent_rows WHEN NEW.entity='sessions' BEGIN UPDATE viewer_session_count SET total=total+initialized,revision=revision+1 WHERE id=1; END;
+        CREATE TRIGGER IF NOT EXISTS viewer_session_count_delete AFTER DELETE ON viewer_recent_rows WHEN OLD.entity='sessions' BEGIN UPDATE viewer_session_count SET total=total-initialized,revision=revision+1 WHERE id=1; END;
+        CREATE TABLE IF NOT EXISTS viewer_recent_dirty(scope TEXT NOT NULL,key TEXT NOT NULL,PRIMARY KEY(scope,key)) WITHOUT ROWID;
+        CREATE TABLE IF NOT EXISTS viewer_recent_issues(scope TEXT NOT NULL,key TEXT NOT NULL,reason TEXT NOT NULL,PRIMARY KEY(scope,key)) WITHOUT ROWID;
+        DROP TRIGGER IF EXISTS viewer_recent_insert;
+        DROP TRIGGER IF EXISTS viewer_recent_update;
+        DROP TRIGGER IF EXISTS viewer_recent_delete;
+        CREATE TRIGGER IF NOT EXISTS viewer_recent_insert AFTER INSERT ON state_rows WHEN NEW.scope='mem:sessions' OR (NEW.scope>='mem:obs:' AND NEW.scope<'mem:obs;') BEGIN INSERT INTO viewer_recent_dirty(scope,key) SELECT NEW.scope,NEW.key WHERE NOT EXISTS (SELECT 1 FROM viewer_recent_dirty WHERE scope=NEW.scope AND key=NEW.key); END;
+        CREATE TRIGGER IF NOT EXISTS viewer_recent_update AFTER UPDATE ON state_rows WHEN NEW.scope='mem:sessions' OR (NEW.scope>='mem:obs:' AND NEW.scope<'mem:obs;') OR OLD.scope='mem:sessions' OR (OLD.scope>='mem:obs:' AND OLD.scope<'mem:obs;') BEGIN INSERT INTO viewer_recent_dirty(scope,key) SELECT NEW.scope,NEW.key WHERE (NEW.scope='mem:sessions' OR (NEW.scope>='mem:obs:' AND NEW.scope<'mem:obs;')) AND NOT EXISTS (SELECT 1 FROM viewer_recent_dirty WHERE scope=NEW.scope AND key=NEW.key); INSERT INTO viewer_recent_dirty(scope,key) SELECT OLD.scope,OLD.key WHERE (OLD.scope='mem:sessions' OR (OLD.scope>='mem:obs:' AND OLD.scope<'mem:obs;')) AND NOT EXISTS (SELECT 1 FROM viewer_recent_dirty WHERE scope=OLD.scope AND key=OLD.key); END;
+        CREATE TRIGGER IF NOT EXISTS viewer_recent_delete AFTER DELETE ON state_rows WHEN OLD.scope='mem:sessions' OR (OLD.scope>='mem:obs:' AND OLD.scope<'mem:obs;') BEGIN INSERT INTO viewer_recent_dirty(scope,key) SELECT OLD.scope,OLD.key WHERE NOT EXISTS (SELECT 1 FROM viewer_recent_dirty WHERE scope=OLD.scope AND key=OLD.key); END;")?;
+    Ok(())
+}
+
+fn tracked(scope: &str) -> bool {
+    scope == "mem:sessions" || scope.starts_with("mem:obs:")
+}
+
+fn stamp(value: &Value, scope: &str) -> Option<i64> {
+    let parse = |field: &str| value.get(field).and_then(Value::as_str)
+        .and_then(|text| chrono::DateTime::parse_from_rfc3339(text).ok())
+        .map(|time| time.timestamp_micros());
+    if scope == "mem:sessions" {
+        parse("startedAt").into_iter().chain(parse("endedAt")).max()
+    } else {
+        parse("timestamp")
+    }
+}
+
+pub fn maintain(c: &Connection, scope: &str, key: &str, value: Option<&Value>, version: u64) -> anyhow::Result<()> {
+    if !tracked(scope) { return Ok(()); }
+    c.prepare_cached("DELETE FROM viewer_recent_rows WHERE scope=?1 AND key=?2")?.execute( params![scope,key])?;
+    c.prepare_cached("DELETE FROM viewer_recent_issues WHERE scope=?1 AND key=?2")?.execute( params![scope,key])?;
+    if let Some(value) = value {
+        let session = scope.strip_prefix("mem:obs:").unwrap_or(key);
+        let valid = value.is_object() && value.get("id").and_then(Value::as_str) == Some(key)
+            && (scope == "mem:sessions" || value.get("sessionId").and_then(Value::as_str) == Some(session));
+        if valid && value.get("deleted") != Some(&Value::Bool(true)) {
+            let timestamp = stamp(value, scope);
+            c.prepare_cached("INSERT INTO viewer_recent_rows VALUES(?1,?2,?3,?4,?5,?6,?7)")?.execute(
+                params![scope,key,if scope=="mem:sessions" {"sessions"} else {"observations"},session,timestamp.unwrap_or(i64::MIN),timestamp.is_none(),version.to_string()])?;
+        } else if !valid {
+            issue(c, scope, key, "invalid_source_identity")?;
+        }
+    }
+    c.prepare_cached("DELETE FROM viewer_recent_dirty WHERE scope=?1 AND key=?2")?.execute( params![scope,key])?;
+    Ok(())
+}
+
+pub(super) fn issue(c: &Connection, scope: &str, key: &str, reason: &str) -> anyhow::Result<()> {
+    c.prepare_cached("DELETE FROM viewer_recent_rows WHERE scope=?1 AND key=?2")?.execute( params![scope,key])?;
+    c.prepare_cached("INSERT INTO viewer_recent_issues VALUES(?1,?2,?3) ON CONFLICT(scope,key) DO UPDATE SET reason=excluded.reason")?.execute( params![scope,key,reason])?;
+    Ok(())
+}
+
+pub(super) fn load(c: &Connection, scope: &str, key: &str, expected: Option<&str>) -> anyhow::Result<Option<(Value,String,i64)>> {
+    let meta: Option<(String,i64,i64)> = c.query_row(
+        "SELECT version,value_bytes,CASE WHEN live=1 THEN stored_bytes ELSE 0 END FROM state_values WHERE scope=?1 AND key=?2 AND live=1",
+        params![scope,key], |r| Ok((r.get(0)?,r.get(1)?,r.get(2)?))).optional()?;
+    let Some((version,logical,stored)) = meta else { return Ok(None); };
+    if expected.is_some_and(|expected| expected != version) { return Err(protocol::error("STATE_RECENT_CURSOR_STALE")); }
+    load_known(c,scope,key,version,logical,stored)
+}
+
+pub(super) fn load_known(c: &Connection, scope: &str, key: &str, version: String, logical: i64, stored: i64) -> anyhow::Result<Option<(Value,String,i64)>> {
+    if logical <= 0 || stored <= 0 || logical > SOURCE_MAX || stored > SOURCE_MAX {
+        return Err(protocol::error("STATE_RECENT_SOURCE_TOO_LARGE"));
+    }
+    let encoded: Vec<u8> = c.prepare_cached("SELECT value FROM state_values WHERE scope=?1 AND key=?2 AND version=?3")?.query_row(params![scope,key,version],|r|Ok(r.get_ref(0)?.as_bytes()?.to_vec()))?;
+    let decoded = database::decode_value(&encoded, logical).map_err(|_|protocol::error("STATE_RECENT_SOURCE_INVALID"))?;
+    let value=serde_json::from_str(&decoded).map_err(|_|protocol::error("STATE_RECENT_SOURCE_INVALID"))?;
+    Ok(Some((value,version,logical)))
+}
