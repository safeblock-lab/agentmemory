+    pub async fn list_page(
+        &self,
+        input: StateListPageInput,
+    ) -> FunctionResult<StateListPageResult, ErrorBody> {
+        if !(1..=1024).contains(&input.limit) || !(1024..=1_048_576).contains(&input.max_bytes) {
+            return FunctionResult::Failure(ErrorBody {
+                message: "limit must be 1..=1024 and max_bytes must be 1024..=1048576".to_string(),
+                code: "STATE_PAGE_INVALID_REQUEST".to_string(),
+                stacktrace: None,
+            });
+        }
+
+        if input
+            .cursor
+            .as_ref()
+            .is_some_and(|cursor| cursor.len() > STATE_PAGE_MAX_CURSOR_BYTES)
+        {
+            return FunctionResult::Failure(ErrorBody {
+                message: "cursor exceeds the maximum size of 4096 bytes".to_string(),
+                code: "STATE_PAGE_CURSOR_INVALID".to_string(),
+                stacktrace: None,
+            });
+        }
+
+        let fields = match input.fields.as_deref() {
+            Some(fields) => match canonical_state_page_fields(fields) {
+                Some(fields) => Some(fields),
+                None => {
+                    return FunctionResult::Failure(ErrorBody {
+                        message: "fields must contain 1..=16 unique names, at most 128 UTF-8 bytes each and 1024 bytes total".to_string(),
+                        code: "STATE_PAGE_INVALID_REQUEST".to_string(),
+                        stacktrace: None,
+                    });
+                }
+            },
+            None => None,
+        };
+
+        let limit = input.limit as u32;
+        let max_bytes = input.max_bytes as u32;
+        let page = match fields.as_deref() {
+            Some(fields) => {
+                self.adapter
+                    .list_page_projected(
+                        &input.scope,
+                        input.cursor.as_deref(),
+                        limit,
+                        max_bytes,
+                        fields,
+                    )
+                    .await
+            }
+            None => {
+                self.adapter
+                    .list_page(&input.scope, input.cursor.as_deref(), limit, max_bytes)
+                    .await
+            }
+        };
+        match page {
+            Ok(page) => FunctionResult::Success(page),
+            Err(StatePageError::Unsupported) => FunctionResult::Failure(ErrorBody {
+                message: "the configured state adapter does not support bounded pagination"
+                    .to_string(),
+                code: "STATE_PAGE_UNSUPPORTED".to_string(),
+                stacktrace: None,
+            }),
+            Err(StatePageError::InvalidCursor) => FunctionResult::Failure(ErrorBody {
+                message: "cursor is malformed or belongs to a different scope".to_string(),
+                code: "STATE_PAGE_CURSOR_INVALID".to_string(),
+                stacktrace: None,
+            }),
+            Err(StatePageError::StaleCursor) => FunctionResult::Failure(ErrorBody {
+                message: "state changed after this cursor was issued; restart pagination"
+                    .to_string(),
+                code: "STATE_PAGE_CURSOR_STALE".to_string(),
+                stacktrace: None,
+            }),
+            Err(StatePageError::InvalidProjection) => FunctionResult::Failure(ErrorBody {
+                message: "projected state pagination requires valid fields".to_string(),
+                code: "STATE_PAGE_INVALID_REQUEST".to_string(),
+                stacktrace: None,
+            }),
+            Err(StatePageError::ProjectedRecordNotObject) => FunctionResult::Failure(ErrorBody {
+                message: "a projected state record must have a JSON object at its root".to_string(),
+                code: "STATE_PAGE_PROJECTION_NON_OBJECT".to_string(),
+                stacktrace: None,
+            }),
+            Err(StatePageError::RecordTooLarge { required_bytes }) => {
+                FunctionResult::Failure(ErrorBody {
+                    message: format!(
+                        "a single state record requires {required_bytes} serialized JSON bytes, exceeding max_bytes {max_bytes}"
+                    ),
+                    code: "STATE_RECORD_TOO_LARGE".to_string(),
+                    stacktrace: None,
+                })
+            }
+            Err(StatePageError::RecoveryRequired) => FunctionResult::Failure(ErrorBody { code: "STATE_GRAPH_RECOVERY_REQUIRED".into(), message: "STATE_GRAPH_RECOVERY_REQUIRED: incomplete graph delta must be recovered".into(), stacktrace: None }),
+            Err(StatePageError::Internal) => FunctionResult::Failure(ErrorBody {
+                message: "failed to serialize bounded state page".to_string(),
+                code: "STATE_PAGE_ERROR".to_string(),
+                stacktrace: None,
+            }),
+        }
+    }
