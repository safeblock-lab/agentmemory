+#[derive(Clone)]
+pub(super) struct PreparationBudget {
+    pub deadline: Instant,
+    cancelled: Arc<AtomicBool>,
+    stage: Arc<AtomicUsize>,
+    stage_active: Arc<AtomicBool>,
+    stage_started: Arc<Mutex<Instant>>,
+    failure_logged: Arc<AtomicBool>,
+    operation: uuid::Uuid,
+    action: String,
+}
+
+#[derive(Clone, Copy, Default)]
+pub(super) struct PreparationProgress {
+    pub rows_processed: usize,
+    pub bytes_processed: usize,
+    pub session_visits: usize,
+    pub cursor_source: i64,
+    pub cursor_position: i64,
+}
+
+impl PreparationBudget {
+    pub fn new(action: &str, duration: Duration) -> Self {
+        Self { deadline: Instant::now() + duration, cancelled: Arc::new(AtomicBool::new(false)),
+            stage: Arc::new(AtomicUsize::new(0)), stage_active: Arc::new(AtomicBool::new(false)),
+            stage_started: Arc::new(Mutex::new(Instant::now())), failure_logged: Arc::new(AtomicBool::new(false)),
+            operation: uuid::Uuid::new_v4(), action: action.into() }
+    }
+    pub fn expired(&self) -> bool {
+        self.cancelled.load(Ordering::Acquire) || Instant::now() >= self.deadline
+    }
+    pub fn cancel(&self) { self.cancelled.store(true, Ordering::Release); }
+    pub fn span(&self) -> tracing::Span {
+        tracing::info_span!("state_sqlite_preparation", operation_id = %self.operation, action = %self.action)
+    }
+    pub fn enter(&self, stage: usize) -> anyhow::Result<()> {
+        let previous = self.stage.load(Ordering::Acquire);
+        if self.stage_active.swap(true, Ordering::AcqRel) {
+            let elapsed = self.stage_started.lock().unwrap_or_else(std::sync::PoisonError::into_inner).elapsed();
+            self.trace_event_at(Self::stage_name_at(previous), "stage", "exit", elapsed, PreparationProgress::default());
+        }
+        self.stage.store(stage, Ordering::Release);
+        *self.stage_started.lock().unwrap_or_else(std::sync::PoisonError::into_inner) = Instant::now();
+        self.trace_event_at(Self::stage_name_at(stage), "stage", "entry", Duration::ZERO, PreparationProgress::default());
+        self.check()
+    }
+    fn stage_name(&self) -> &'static str {
+        Self::stage_name_at(self.stage.load(Ordering::Acquire))
+    }
+    fn stage_name_at(stage: usize) -> &'static str {
+        ["queue", "wal", "begin", "retrieval", "commit", "ack"][stage.min(5)]
+    }
+    pub fn trace_event(&self, step: &'static str, event: &'static str, elapsed: Duration, progress: PreparationProgress) {
+        self.trace_event_at(self.stage_name(), step, event, elapsed, progress);
+    }
+    pub fn trace_event_at(&self, stage: &'static str, step: &'static str, event: &'static str, elapsed: Duration, progress: PreparationProgress) {
+        let timestamp_ms = SystemTime::now().duration_since(UNIX_EPOCH).unwrap_or_default().as_millis().min(u64::MAX as u128) as u64;
+        let elapsed_ms = elapsed.as_millis().min(u64::MAX as u128) as u64;
+        tracing::warn!(
+            operation_id = %self.operation,
+            stage,
+            step,
+            event,
+            timestamp_ms,
+            elapsed_ms,
+            rows_processed = progress.rows_processed,
+            bytes_processed = progress.bytes_processed,
+            session_visits = progress.session_visits,
+            cursor_source = progress.cursor_source,
+            cursor_position = progress.cursor_position,
+            "state SQLite preparation trace"
+        );
+    }
+    pub fn trace_step<T>(&self, step: &'static str, operation: impl FnOnce() -> anyhow::Result<T>) -> anyhow::Result<T> {
+        self.trace_event(step, "entry", Duration::ZERO, PreparationProgress::default());
+        let started = Instant::now();
+        let result = operation();
+        self.trace_event(step, if result.is_ok() { "exit" } else { "error" }, started.elapsed(), PreparationProgress::default());
+        result
+    }
+    pub fn finish_stage(&self) {
+        if self.stage_active.swap(false, Ordering::AcqRel) {
+            let elapsed = self.stage_started.lock().unwrap_or_else(std::sync::PoisonError::into_inner).elapsed();
+            self.trace_event("stage", "exit", elapsed, PreparationProgress::default());
+        }
+    }
+    pub fn check(&self) -> anyhow::Result<()> {
+        if self.expired() {
+            self.failure("deadline_or_cancellation");
+            return Err(protocol::error("STATE_RETRIEVAL_RESOURCE_LIMIT"));
+        }
+        Ok(())
+    }
+    pub fn failure(&self, failure: &str) {
+        if self.failure_logged.swap(true, Ordering::AcqRel) { return; }
+        let elapsed = self.stage_started.lock().unwrap_or_else(std::sync::PoisonError::into_inner).elapsed();
+        self.trace_event("stage_failure", "error", elapsed, PreparationProgress::default());
+        tracing::warn!(operation_id = %self.operation, operation = %self.operation, action = %self.action,
+            stage = self.stage_name(), failure_class = failure, elapsed_ms = elapsed.as_millis() as u64,
+            "state SQLite preparation failed; reconcile durable checkpoint before retry");
+    }
+    pub fn install(&self, connection: &Connection) -> anyhow::Result<()> {
+        self.check()?;
+        ACTIVE_PREPARATION.with(|active| *active.borrow_mut() = Some(self.clone()));
+        // Short busy waits cannot consume a fresh timeout at every transaction stage.
+        connection.busy_timeout(Duration::from_millis(100))?;
+        let budget = self.clone();
+        connection.progress_handler(1000, Some(move || budget.expired()))?;
+        Ok(())
+    }
+}
+
+pub(super) fn trace_preparation<T>(step: &'static str, operation: impl FnOnce() -> anyhow::Result<T>) -> anyhow::Result<T> {
+    let budget = ACTIVE_PREPARATION.with(|active| active.borrow().clone());
+    match budget {
+        Some(budget) => budget.trace_step(step, operation),
+        None => operation(),
+    }
+}
+
+pub(super) fn trace_preparation_progress(step: &'static str, elapsed: Duration, progress: PreparationProgress) {
+    if let Some(budget) = ACTIVE_PREPARATION.with(|active| active.borrow().clone()) {
+        budget.trace_event(step, "progress", elapsed, progress);
+    }
+}
+
+pub(super) fn active_preparation_id() -> Option<uuid::Uuid> {
+    ACTIVE_PREPARATION.with(|active| active.borrow().as_ref().map(|budget| budget.operation))
+}
+
+pub(super) fn clear_preparation_budget(connection: &Connection) -> anyhow::Result<()> {
+    ACTIVE_PREPARATION.with(|active| *active.borrow_mut() = None);
+    connection.progress_handler(0, None::<fn() -> bool>)?;
+    connection.busy_timeout(Duration::from_secs(5))?;
+    Ok(())
+}
+
+pub(super) fn run_preparation<T>(
+    connection: &mut Connection,
+    path: &Path,
+    budget: &PreparationBudget,
+    read_only: bool,
+    job: impl FnOnce(&Connection) -> anyhow::Result<T>,
+) -> anyhow::Result<T> {
+    let span = budget.span();
+    let _entered = span.enter();
+    let result: anyhow::Result<T> = (|| {
+        budget.trace_step("sqlite_budget_install", || budget.install(connection))?;
+        if !read_only {
+            budget.enter(1)?;
+            budget.trace_step("wal_pressure", || wal_pressure(connection,path))?;
+        }
+        budget.enter(2)?;
+        budget.trace_event("sqlite_transaction_begin", "entry", Duration::ZERO, PreparationProgress::default());
+        let begin_started = Instant::now();
+        let transaction_result = connection.transaction_with_behavior(if read_only {
+            rusqlite::TransactionBehavior::Deferred
+        } else { rusqlite::TransactionBehavior::Immediate });
+        budget.trace_event("sqlite_transaction_begin", if transaction_result.is_ok() { "exit" } else { "error" }, begin_started.elapsed(), PreparationProgress::default());
+        let transaction = transaction_result?;
+        let result: anyhow::Result<T> = (|| {
+            budget.enter(3)?;
+            let value = budget.trace_step("retrieval_job", || job(&transaction))?;
+            budget.enter(4)?;
+            budget.trace_step("sqlite_transaction_commit", || { transaction.execute_batch("COMMIT")?; Ok(()) })?;
+            Ok(value)
+        })();
+        match result {
+            Ok(value) => { drop(transaction); Ok(value) }
+            Err(error) => {
+                // Cancellation must not interrupt rollback of the bounded cut.
+                let rollback_started = Instant::now();
+                budget.trace_event("sqlite_transaction_rollback", "entry", Duration::ZERO, PreparationProgress::default());
+                let rollback: anyhow::Result<()> = (|| {
+                    transaction.progress_handler(0, None::<fn() -> bool>)?;
+                    if !transaction.is_autocommit() { transaction.rollback()?; }
+                    Ok(())
+                })();
+                budget.trace_event("sqlite_transaction_rollback", if rollback.is_ok() { "exit" } else { "error" }, rollback_started.elapsed(), PreparationProgress::default());
+                rollback?;
+                Err(error)
+            }
+        }
+    })();
+    let restored = clear_preparation_budget(connection);
+    if restored.is_err() { budget.failure("budget_cleanup_failed"); }
+    if result.is_err() {
+        budget.failure("stage_error");
+        budget.check()?;
+    }
+    let value = result?;
+    restored?;
+    // Commit may have completed even if delivery is subsequently lost.
+    budget.enter(5)?;
+    Ok(value)
+}
+
+pub(crate) const APPLICATION_ID: i64 = 0x49494953;
