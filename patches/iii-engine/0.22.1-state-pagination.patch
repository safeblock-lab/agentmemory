@@ -0,0 +1,357 @@
+use super::{commit, database, protocol};
+use protocol::{Checkpoint, Guard, JOBS, WORKING, error, require};
+use rusqlite::{Connection, params};
+use serde::{Deserialize, Serialize};
+use serde_json::{Value, json};
+
+const MAX_BYTES: u64 = 4 * 1024 * 1024;
+#[derive(Clone, Default, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct Cursor {
+    pub scope_index: usize,
+    pub after_key: String,
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct GraphRequest {
+    pub guard: Guard,
+    pub job_id: String,
+    pub expected_checkpoint_version: String,
+    pub limit: usize,
+    pub max_bytes: u64,
+    pub cursor: Option<Cursor>,
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct AuditRequest {
+    pub guard: Guard,
+    pub through_key: String,
+    pub limit: usize,
+    pub max_bytes: u64,
+    pub cursor: Option<Cursor>,
+}
+fn budget(
+    limit: usize,
+    max_bytes: u64,
+    cursor: &Option<Cursor>,
+    last: usize,
+) -> anyhow::Result<()> {
+    require((1..=256).contains(&limit) && (1..=MAX_BYTES).contains(&max_bytes))?;
+    require(
+        cursor
+            .as_ref()
+            .is_none_or(|c| c.scope_index <= last && c.after_key.len() <= 4096),
+    )
+}
+struct Range {
+    scope: String,
+    lower: String,
+    upper: String,
+    keep: String,
+    keep_prefix: String,
+    exact: bool,
+}
+fn receipt_key(point: &Checkpoint) -> anyhow::Result<String> {
+    require(point.next_chunk_ordinal > 0)?;
+    Ok(serde_json::to_string(&json!([
+        point.generation,
+        point.job_id,
+        point.logical_delta_id,
+        point.next_chunk_ordinal - 1
+    ]))?)
+}
+fn eligible(connection: &Connection, job_id: &str, version: &str) -> anyhow::Result<(Checkpoint,Value)> {
+    if super::storage_prune::protected(job_id) { return Err(error("STATE_TX_CHECKPOINT_CONFLICT")); }
+    let job = super::storage_prune::bounded_dependency(connection, JOBS, job_id)?
+        .ok_or_else(|| error("STATE_TX_CHECKPOINT_CONFLICT"))?;
+    if super::storage_prune::protected(&serde_json::to_string(&job)?) { return Err(error("STATE_TX_CHECKPOINT_CONFLICT")); }
+    if !["completed", "invalidated"].iter().any(|state| job["state"] == *state) { return Err(error("STATE_GRAPH_RECOVERY_REQUIRED")); }
+    let checkpoint = database::row(connection, database::CHECKPOINT_SCOPE, job_id)?;
+    if checkpoint.version != protocol::counter(version)? {
+        return Err(error("STATE_TX_CHECKPOINT_CONFLICT"));
+    }
+    let point: Checkpoint = protocol::decode(
+        checkpoint
+            .value
+            .ok_or_else(|| error("STATE_TX_CHECKPOINT_CONFLICT"))?,
+    )?;
+    require(
+        commit::prunable_job(&job)
+            && point.visibility == "complete"
+            && point.job_id == job_id
+            && job["id"] == job_id
+            && job["generation"] == point.generation,
+    )?;
+    let receipt = super::storage_prune::bounded_dependency(connection, database::RECEIPT_SCOPE, &receipt_key(&point)?)?
+        .ok_or_else(|| error("STATE_GRAPH_RECOVERY_REQUIRED"))?;
+    let identity = json!({"generation":point.generation,"job_id":job_id,"logical_delta_id":point.logical_delta_id,"chunk_ordinal":point.next_chunk_ordinal-1});
+    require(
+        receipt["identity"] == identity
+            && receipt["checkpoint_version"] == version
+            && receipt["payload_digest"]
+                .as_str()
+                .is_some_and(|v| v.len() == 64 && v.bytes().all(|b| b.is_ascii_hexdigit()))
+            && receipt["row_versions"].is_array(),
+    )?;
+    Ok((point,job))
+}
+fn ranges(point: &Checkpoint) -> anyhow::Result<Vec<Range>> {
+    let mut ranges: Vec<Range> = protocol::PREFIXES
+        .iter()
+        // Inputs, captured provider results and delta manifests remain replay authority.
+        .filter(|prefix| !prefix.contains("inputs") && !prefix.contains("provider"))
+        .map(|prefix| Range {
+            scope: format!("{prefix}{}", point.job_id),
+            lower: String::new(),
+            upper: String::new(),
+            keep: String::new(),
+            keep_prefix: if prefix.contains("deltas") { "manifest:".into() } else { String::new() },
+            exact: false,
+        })
+        .collect();
+    ranges.push(Range {
+        scope: WORKING.into(),
+        lower: point.job_id.clone(),
+        upper: point.job_id.clone(),
+        keep: String::new(),
+        keep_prefix: String::new(),
+        exact: true,
+    });
+    let encoded = serde_json::to_string(&json!([point.generation, point.job_id]))?;
+    let prefix = format!("{},", &encoded[..encoded.len() - 1]);
+    ranges.push(Range {
+        scope: database::RECEIPT_SCOPE.into(),
+        lower: prefix.clone(),
+        upper: format!("{prefix}~"),
+        keep: receipt_key(point)?,
+        keep_prefix: String::new(),
+        exact: false,
+    });
+    Ok(ranges)
+}
+fn remove_page(
+    connection: &Connection,
+    ranges: &[Range],
+    limit: usize,
+    max_bytes: u64,
+    cursor: Option<Cursor>,
+) -> anyhow::Result<Value> {
+    let start = std::time::Instant::now();
+    let budget = std::time::Duration::from_secs(3);
+    connection.progress_handler(10_000, Some(move || start.elapsed() >= budget))?;
+    let result = remove_page_inner(connection, ranges, limit, max_bytes, cursor);
+    connection.progress_handler(0, None::<fn() -> bool>)?;
+    if start.elapsed() >= budget || result.as_ref().err().is_some_and(|cause| {
+        cause.downcast_ref::<rusqlite::Error>().is_some_and(|error| {
+            matches!(error, rusqlite::Error::SqliteFailure(code, _)
+                if code.code == rusqlite::ErrorCode::OperationInterrupted)
+        })
+    }) {
+        return Err(error("STATE_TX_LIMIT_EXCEEDED"));
+    }
+    result
+}
+fn remove_page_inner(
+    connection: &Connection,
+    ranges: &[Range],
+    limit: usize,
+    max_bytes: u64,
+    cursor: Option<Cursor>,
+) -> anyhow::Result<Value> {
+    let mut cursor = cursor.unwrap_or_default();
+    let mut count = 0usize;
+    let mut bytes = 0u64;
+    let mut scanned = 0usize;
+    let mut skipped = 0usize;
+    let mut logical_bytes = 0u64;
+    let mut stored_bytes = 0u64;
+    while cursor.scope_index < ranges.len() {
+        let range = &ranges[cursor.scope_index];
+        let rows = {
+            let after = cursor.after_key.as_str();
+            let lower = range.lower.as_str();
+            let upper = range.upper.as_str();
+            let (sql, lower, upper) = if range.exact {
+                ("SELECT key,value_bytes,COALESCE(length(value),0) FROM state_rows WHERE scope=?1 AND key=?3 AND key>?2 AND key<>?5 AND (?7='' OR substr(key,1,length(?7))<>?7) ORDER BY key LIMIT ?4", lower, None)
+            } else if !upper.is_empty() {
+                ("SELECT key,value_bytes,COALESCE(length(value),0) FROM state_rows WHERE scope=?1 AND key>?2 AND key>=?3 AND key<?6 AND key<>?5 AND (?7='' OR substr(key,1,length(?7))<>?7) ORDER BY key LIMIT ?4", lower, Some(upper))
+            } else if !lower.is_empty() {
+                ("SELECT key,value_bytes,COALESCE(length(value),0) FROM state_rows WHERE scope=?1 AND key>?2 AND key>=?3 AND key<>?5 AND (?7='' OR substr(key,1,length(?7))<>?7) ORDER BY key LIMIT ?4", lower, None)
+            } else {
+                ("SELECT key,value_bytes,COALESCE(length(value),0) FROM state_rows WHERE scope=?1 AND key>?2 AND key<>?5 AND (?7='' OR substr(key,1,length(?7))<>?7) ORDER BY key LIMIT ?4", "", None)
+            };
+            let mut statement = connection.prepare_cached(sql)?;
+            statement.raw_bind_parameter(1, &range.scope)?;
+            statement.raw_bind_parameter(2, after)?;
+            if range.exact || !range.upper.is_empty() || !range.lower.is_empty() {
+                statement.raw_bind_parameter(3, lower)?;
+            }
+            statement.raw_bind_parameter(4, (limit - scanned + 1) as i64)?;
+            statement.raw_bind_parameter(5, &range.keep)?;
+            statement.raw_bind_parameter(7, &range.keep_prefix)?;
+            if let Some(upper) = upper {
+                statement.raw_bind_parameter(6, upper)?;
+            }
+            let mut selected = Vec::new();
+            let mut rows = statement.raw_query();
+            while let Some(row) = rows.next()? {
+                selected.push((row.get::<_, String>(0)?, row.get::<_, i64>(1)?, row.get::<_, i64>(2)?));
+            }
+            selected
+        };
+        if rows.is_empty() {
+            cursor.scope_index += 1;
+            cursor.after_key.clear();
+            continue;
+        }
+        let mut changed = false;
+        for (key, value_bytes, encoded_bytes) in rows {
+            let cost = u64::try_from(value_bytes)?
+                .saturating_add(key.len() as u64 + range.scope.len() as u64);
+            if scanned == limit {
+                if changed {
+                    revision(connection, &range.scope)?;
+                }
+                return Ok(
+                    json!({"deleted_count":count,"deleted_bytes":bytes,"deleted_logical_bytes":logical_bytes,"deleted_stored_bytes":stored_bytes,"skipped_oversized_count":skipped,"rows_scanned":scanned,"cursor":cursor,"done":false}),
+                );
+            }
+            scanned += 1;
+            let has_value: bool = connection.query_row("SELECT value IS NOT NULL FROM state_rows WHERE scope=?1 AND key=?2",params![range.scope,key],|row|row.get(0))?;
+            let safe = if !has_value { true } else {
+                match super::storage_prune::bounded_dependency(connection,&range.scope,&key) {
+                    Ok(Some(value)) => !super::storage_prune::protected(&serde_json::to_string(&value)?),
+                    _ => false,
+                }
+            };
+            if !safe { return Err(error("STATE_GRAPH_RECOVERY_REQUIRED")); }
+            if cost > max_bytes {
+                if count > 0 {
+                    skipped += 1;
+                    if changed {
+                        revision(connection, &range.scope)?;
+                    }
+                    return Ok(
+                        json!({"deleted_count":count,"deleted_bytes":bytes,"deleted_logical_bytes":logical_bytes,"deleted_stored_bytes":stored_bytes,"skipped_oversized_count":skipped,"rows_scanned":scanned,"cursor":cursor,"done":false}),
+                    );
+                }
+                connection.execute(
+                    "DELETE FROM state_rows WHERE scope=?1 AND key=?2",
+                    params![range.scope, key],
+                )?;
+                cursor.after_key = key;
+                count += 1;
+                bytes = bytes.saturating_add(cost);
+                logical_bytes = logical_bytes.saturating_add(u64::try_from(value_bytes)?);
+                stored_bytes = stored_bytes.saturating_add(u64::try_from(encoded_bytes)?);
+                revision(connection, &range.scope)?;
+                return Ok(
+                    json!({"deleted_count":count,"deleted_bytes":bytes,"deleted_logical_bytes":logical_bytes,"deleted_stored_bytes":stored_bytes,"skipped_oversized_count":skipped,"rows_scanned":scanned,"cursor":cursor,"done":false}),
+                );
+            }
+            if bytes.saturating_add(cost) > max_bytes {
+                if changed {
+                    revision(connection, &range.scope)?;
+                }
+                return Ok(
+                    json!({"deleted_count":count,"deleted_bytes":bytes,"deleted_logical_bytes":logical_bytes,"deleted_stored_bytes":stored_bytes,"skipped_oversized_count":skipped,"rows_scanned":scanned,"cursor":cursor,"done":false}),
+                );
+            }
+            connection.execute(
+                "DELETE FROM state_rows WHERE scope=?1 AND key=?2",
+                params![range.scope, key],
+            )?;
+            cursor.after_key = key;
+            count += 1;
+            bytes = bytes.saturating_add(cost);
+            logical_bytes = logical_bytes.saturating_add(u64::try_from(value_bytes)?);
+            stored_bytes = stored_bytes.saturating_add(u64::try_from(encoded_bytes)?);
+            changed = true;
+        }
+        if changed {
+            revision(connection, &range.scope)?;
+        }
+    }
+    Ok(json!({"deleted_count":count,"deleted_bytes":bytes,"deleted_logical_bytes":logical_bytes,"deleted_stored_bytes":stored_bytes,"skipped_oversized_count":skipped,"rows_scanned":scanned,"cursor":null,"done":true}))
+}
+fn revision(connection: &Connection, scope: &str) -> anyhow::Result<()> {
+    let revision = protocol::next(database::revision(connection, scope)?)?.to_string();
+    connection.execute(
+        "UPDATE state_scopes SET revision=?2 WHERE scope=?1",
+        params![scope, revision],
+    )?;
+    Ok(())
+}
+pub fn close_page(connection: &Connection, job_id: &str, version: &str) -> anyhow::Result<Value> {
+    if super::storage_prune::protected(job_id) { return Ok(json!({"deleted_count":0,"deleted_bytes":0,"cursor":null,"done":true,"protected":true})); }
+    let (point,job) = eligible(connection, job_id, version)?;
+    prune_job_page(connection, &point, &job, 256, MAX_BYTES, None, true)
+}
+fn prune_job_page(connection: &Connection, point: &Checkpoint, job: &Value, limit: usize, max_bytes: u64, cursor: Option<Cursor>, automatic: bool) -> anyhow::Result<Value> {
+    let ready = super::storage_prune::temporal_unit_ready(connection,&point.job_id,job)?;
+    // The parent acknowledges after the child's closing commit; metadata belongs to later maintenance.
+    if !ready || automatic {
+        return Ok(json!({"deleted_count":0,"deleted_bytes":0,"deleted_logical_bytes":0,"deleted_stored_bytes":0,"cursor":{"scope_index":0,"after_key":""},"done":false}));
+    }
+    super::storage_prune::remember_temporal_origin(connection,&point.job_id,job)?;
+    let ranges = ranges(point)?;
+    let mut result = remove_page(connection,&ranges,limit,max_bytes,cursor)?;
+    if result["done"] == true {
+        // A supplied cursor is advisory; acknowledgment requires all technical ranges to be empty.
+        for range in &ranges {
+            let remaining: bool = if range.exact {
+                connection.query_row("SELECT EXISTS(SELECT 1 FROM state_rows WHERE scope=?1 AND key=?2)",params![range.scope,range.lower],|row|row.get(0))?
+            } else if !range.upper.is_empty() {
+                connection.query_row("SELECT EXISTS(SELECT 1 FROM state_rows WHERE scope=?1 AND key>=?2 AND key<?3 AND key<>?4)",params![range.scope,range.lower,range.upper,range.keep],|row|row.get(0))?
+            } else {
+                connection.query_row("SELECT EXISTS(SELECT 1 FROM state_rows WHERE scope=?1 AND key<>?2 AND (?3='' OR substr(key,1,length(?3))<>?3))",params![range.scope,range.keep,range.keep_prefix],|row|row.get(0))?
+            };
+            if remaining { result["done"] = json!(false); result["cursor"] = json!({"scope_index":0,"after_key":""}); return Ok(result); }
+        }
+        super::storage_prune::temporal_unit_pruned(connection,&point.job_id)?;
+    }
+    Ok(result)
+}
+pub fn graph(connection: &Connection, request: GraphRequest) -> anyhow::Result<Value> {
+    budget(request.limit, request.max_bytes, &request.cursor, 6)?;
+    require(
+        !request.job_id.is_empty()
+            && request.job_id.len() <= 4096
+            && protocol::counter(&request.expected_checkpoint_version)? > 0,
+    )?;
+    commit::maintenance_allowed(connection, &request.guard, Some(&request.job_id))?;
+    let (point,job) = eligible(
+        connection,
+        &request.job_id,
+        &request.expected_checkpoint_version,
+    )?;
+    prune_job_page(
+        connection,
+        &point,
+        &job,
+        request.limit,
+        request.max_bytes,
+        request.cursor,
+        false,
+    )
+}
+pub fn audit(connection: &Connection, request: AuditRequest) -> anyhow::Result<Value> {
+    budget(request.limit, request.max_bytes, &request.cursor, 0)?;
+    require(!request.through_key.is_empty() && request.through_key.len() <= 4096)?;
+    commit::maintenance_allowed(connection, &request.guard, None)?;
+    let range = Range {
+        scope: "mem:audit".into(),
+        lower: String::new(),
+        upper: format!("{}\0", request.through_key),
+        keep: String::new(),
+        keep_prefix: String::new(),
+        exact: false,
+    };
+    remove_page(
+        connection,
+        &[range],
+        request.limit,
+        request.max_bytes,
+        request.cursor,
+    )
+}
