--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/scoped/mod.rs
@@ -0,0 +1,130 @@
+mod ann;
+mod diagnostic;
+pub(super) mod background;
+mod keyword;
+mod membership;
+mod pending;
+mod prepare;
+mod projection;
+mod query;
+mod write;
+use super::super::{database, protocol};
+use super::{lsh, project_catalog, semantic, source};
+pub use background::global_prepare;
+pub use membership::{changed, project_token, session_token};
+pub use pending::{source_changed, source_removed};
+pub use prepare::{prepare, prepare_browse, status};
+#[cfg(test)]
+pub use query::{LEXICAL_SQL, statement};
+pub use query::{keyword_search, semantic_search, terms};
+use rusqlite::{Connection, OptionalExtension, params};
+use serde_json::{Value, json};
+pub use write::{remove, replace, text};
+
+pub fn schema(c: &Connection) -> anyhow::Result<()> {
+    c.execute_batch("CREATE TABLE IF NOT EXISTS retrieval_scoped_projects(token INTEGER PRIMARY KEY,name TEXT NOT NULL UNIQUE,generation INTEGER NOT NULL DEFAULT 1);
+        CREATE TABLE IF NOT EXISTS retrieval_scoped_sessions(token INTEGER PRIMARY KEY,name TEXT NOT NULL UNIQUE,project INTEGER,generation INTEGER NOT NULL,status TEXT NOT NULL,cursor_index TEXT NOT NULL,cursor_epoch INTEGER NOT NULL,cursor_id TEXT NOT NULL);
+        CREATE INDEX IF NOT EXISTS retrieval_scoped_sessions_pending ON retrieval_scoped_sessions(status,token);
+        CREATE TABLE IF NOT EXISTS retrieval_scoped_dirty(index_id TEXT NOT NULL,session INTEGER NOT NULL,id TEXT NOT NULL,project INTEGER NOT NULL,PRIMARY KEY(index_id,session,id)) WITHOUT ROWID;
+        CREATE INDEX IF NOT EXISTS retrieval_scoped_dirty_project ON retrieval_scoped_dirty(index_id,project,session,id);
+        CREATE TABLE IF NOT EXISTS retrieval_scoped_work(index_id TEXT NOT NULL,session INTEGER NOT NULL,kind INTEGER NOT NULL,status TEXT NOT NULL,position INTEGER NOT NULL,cursor TEXT NOT NULL,PRIMARY KEY(index_id,session,kind)) WITHOUT ROWID;
+        CREATE TABLE IF NOT EXISTS retrieval_scoped_affected(index_id TEXT NOT NULL,session INTEGER NOT NULL,kind INTEGER NOT NULL,project INTEGER NOT NULL,PRIMARY KEY(index_id,session,kind,project)) WITHOUT ROWID;
+        CREATE INDEX IF NOT EXISTS retrieval_scoped_affected_project ON retrieval_scoped_affected(index_id,project,kind,session);
+        CREATE TABLE IF NOT EXISTS retrieval_scoped_meta(index_id TEXT PRIMARY KEY,epoch INTEGER NOT NULL,status TEXT NOT NULL,cursor TEXT NOT NULL,unknown INTEGER NOT NULL CHECK(unknown>=0)) WITHOUT ROWID;
+        CREATE TABLE IF NOT EXISTS retrieval_scoped_coverage(index_id TEXT NOT NULL,epoch INTEGER NOT NULL,project INTEGER NOT NULL,kind INTEGER NOT NULL,generation INTEGER NOT NULL,status TEXT NOT NULL,source INTEGER NOT NULL,session_cursor TEXT NOT NULL,key_cursor TEXT NOT NULL,active_session TEXT NOT NULL,position INTEGER NOT NULL,vector_cursor TEXT NOT NULL,sessions_epoch INTEGER NOT NULL,summaries_epoch INTEGER NOT NULL,PRIMARY KEY(index_id,epoch,project,kind)) WITHOUT ROWID;
+        CREATE TABLE IF NOT EXISTS retrieval_scoped_vectors(index_id TEXT NOT NULL,epoch INTEGER NOT NULL,id TEXT NOT NULL,project INTEGER,project_generation INTEGER NOT NULL,kind INTEGER NOT NULL,session INTEGER NOT NULL,generation INTEGER NOT NULL,buckets BLOB NOT NULL,document INTEGER UNIQUE,PRIMARY KEY(index_id,epoch,id)) WITHOUT ROWID;
+        CREATE TABLE IF NOT EXISTS retrieval_scoped_postings(index_id TEXT NOT NULL,epoch INTEGER NOT NULL,project INTEGER NOT NULL,project_generation INTEGER NOT NULL,kind INTEGER NOT NULL,table_id INTEGER NOT NULL,bucket INTEGER NOT NULL,session INTEGER NOT NULL,id TEXT NOT NULL,generation INTEGER NOT NULL,PRIMARY KEY(index_id,epoch,project,project_generation,kind,table_id,bucket,session,id)) WITHOUT ROWID;
+        CREATE VIRTUAL TABLE IF NOT EXISTS retrieval_scoped_lexical USING fts5(project_scope,session_scope,body,content='',contentless_delete=1,tokenize='unicode61 tokenchars ''_''');")?;
+    Ok(())
+}
+pub fn ensure(c: &Connection, index: &str, epoch: i64) -> anyhow::Result<()> {
+    let saved: Option<i64> = c
+        .query_row(
+            "SELECT epoch FROM retrieval_scoped_meta WHERE index_id=?1",
+            [index],
+            |r| r.get(0),
+        )
+        .optional()?;
+    if saved == Some(epoch) {
+        return Ok(());
+    }
+    let exists: bool = c.query_row(
+        "SELECT EXISTS(SELECT 1 FROM retrieval_vectors WHERE index_id=?1 AND epoch=?2)",
+        params![index, epoch],
+        |r| r.get(0),
+    )?;
+    c.execute("INSERT INTO retrieval_scoped_meta VALUES(?1,?2,?3,'',0) ON CONFLICT(index_id) DO UPDATE SET epoch=excluded.epoch,status=excluded.status,cursor='',unknown=0",params![index,epoch,if exists{"pending"}else{"ready"}])?;
+    Ok(())
+}
+pub fn generation(c: &Connection, project: i64) -> anyhow::Result<i64> {
+    c.query_row(
+        "SELECT generation FROM retrieval_scoped_projects WHERE token=?1",
+        [project],
+        |r| r.get(0),
+    )
+    .map_err(Into::into)
+}
+pub fn ready(
+    c: &Connection,
+    index: &str,
+    epoch: i64,
+    project: &str,
+    observation: bool,
+) -> anyhow::Result<bool> {
+    let authority_incomplete = if observation {
+        project_catalog::has_incomplete_session_authority(c)?
+    } else {
+        project_catalog::has_incomplete_authority(c)?
+    };
+    if authority_incomplete {
+        return Ok(false);
+    }
+    let Some(project) = project_token(c, project)? else {
+        return Ok(false);
+    };
+    let generation = generation(c, project)?;
+    if pending::has(c, index, project, if observation { 0 } else { 3 })? {
+        return Ok(false);
+    }
+    let covered: Option<i64> = c
+        .query_row("SELECT source FROM retrieval_scoped_coverage WHERE index_id=?1 AND epoch=?2 AND project=?3 AND generation=?4 AND status='ready' AND kind=?5 AND sessions_epoch=(SELECT epoch FROM retrieval_project_catalog WHERE source='sessions') AND summaries_epoch=(SELECT epoch FROM retrieval_project_catalog WHERE source='summaries')",params![index,epoch,project,generation,if observation{0}else{3}],|row|row.get(0))
+        .optional()?;
+    if observation {
+        if let Some(source) = covered {
+            return Ok(source >= 2
+                || (source == 1 && !project_catalog::summary_authority_ready(c)?));
+        }
+    }
+    if covered.is_some()
+        && source::status(c, index)?["coverage_ready"] == true
+        && super::project_vectors::ready(c, index, epoch)?
+    {
+        return Ok(true);
+    }
+    let meta: Option<(String, i64)> = c
+        .query_row(
+            "SELECT status,unknown FROM retrieval_scoped_meta WHERE index_id=?1 AND epoch=?2",
+            params![index, epoch],
+            |r| Ok((r.get(0)?, r.get(1)?)),
+        )
+        .optional()?;
+    if !meta.is_some_and(|(status, unknown)| status == "ready" && unknown == 0) {
+        return Ok(false);
+    }
+    let meta = semantic::get(c, index)?;
+    if meta.status != "ready" || meta.revision != database::revision(c, &meta.scope())?.to_string()
+    {
+        return Ok(false);
+    }
+    match source::ready(c, index) {
+        Ok(()) => Ok(true),
+        Err(error)
+            if error
+                .downcast_ref::<protocol::TxError>()
+                .is_some_and(|e| e.0 == "STATE_SEMANTIC_SOURCE_NOT_READY") =>
+        {
+            Ok(false)
+        }
+        Err(error) => Err(error),
+    }
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/scoped/pending.rs b/engine/src/workers/state/adapters/sqlite/retrieval/scoped/pending.rs
new file mode 100644
index 0000000..36057f0
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/scoped/pending.rs
@@ -0,0 +1,137 @@
+use super::*;
+pub fn source_changed(
+    c: &Connection,
+    index: &str,
+    scope: &str,
+    id: &str,
+    dirty: bool,
+) -> anyhow::Result<()> {
+    let Some(session) = scope.strip_prefix("mem:obs:") else {
+        return Ok(());
+    };
+    let member = membership::get(c, session)?;
+    if dirty {
+        c.execute("INSERT INTO retrieval_scoped_dirty VALUES(?1,?2,?3,?4) ON CONFLICT(index_id,session,id) DO UPDATE SET project=excluded.project",params![index,member.token,id,member.project.unwrap_or(0)])?;
+    } else {
+        c.execute(
+            "DELETE FROM retrieval_scoped_dirty WHERE index_id=?1 AND session=?2 AND id=?3",
+            params![index, member.token, id],
+        )?;
+    }
+    Ok(())
+}
+pub fn source_removed(c: &Connection, index: &str, scope: &str, id: &str) -> anyhow::Result<()> {
+    if let Some(session) = scope.strip_prefix("mem:obs:") {
+        if let Some(session) = session_token(c, session)? {
+            c.execute(
+                "DELETE FROM retrieval_scoped_dirty WHERE index_id=?1 AND session=?2 AND id=?3",
+                params![index, session, id],
+            )?;
+        }
+    }
+    Ok(())
+}
+pub fn has(c: &Connection, index: &str, project: i64, kind: i64) -> anyhow::Result<bool> {
+    let dirty:bool=c.query_row("SELECT EXISTS(SELECT 1 FROM retrieval_scoped_dirty INDEXED BY retrieval_scoped_dirty_project WHERE index_id=?1 AND project=?2)",params![index,project],|r|r.get(0))?;
+    if dirty {
+        return Ok(true);
+    }
+    c.query_row("SELECT EXISTS(SELECT 1 FROM retrieval_scoped_affected INDEXED BY retrieval_scoped_affected_project WHERE index_id=?1 AND project=?2 AND kind=?3)",params![index,project,kind],|r|r.get(0)).map_err(Into::into)
+}
+pub fn drain(
+    c: &Connection,
+    meta: &semantic::Meta,
+    project: i64,
+    kind: i64,
+    processed: &mut usize,
+    visits: &mut usize,
+    bytes: &mut usize,
+    max_rows: usize,
+    max_bytes: usize,
+    sessions_only: bool,
+) -> anyhow::Result<bool> {
+    while *processed < max_rows && *visits < 16 {
+        let next:Option<(i64,String,i64,String,String)>=c.query_row("SELECT w.session,s.name,w.position,w.cursor,w.status FROM retrieval_scoped_affected a INDEXED BY retrieval_scoped_affected_project JOIN retrieval_scoped_work w ON w.index_id=a.index_id AND w.session=a.session AND w.kind=a.kind JOIN retrieval_scoped_sessions s ON s.token=w.session WHERE a.index_id=?1 AND a.project=?2 AND a.kind=?3 ORDER BY a.session LIMIT 1",params![meta.index_id,project,kind],|r|Ok((r.get(0)?,r.get(1)?,r.get(2)?,r.get(3)?,r.get(4)?))).optional()?;
+        let Some((token, session, mut position, mut cursor, status)) = next else {
+            break;
+        };
+        *visits += 1;
+        if sessions_only && !project_catalog::session_is_authoritative_for_project(c, &session, project)? {
+            return Ok(true);
+        }
+        if status == "ready" {
+            c.execute("DELETE FROM retrieval_scoped_affected WHERE index_id=?1 AND session=?2 AND kind=?3 AND project=?4",params![meta.index_id,token,kind,project])?;
+            continue;
+        }
+        loop {
+            if *processed >= max_rows {
+                return Ok(false);
+            }
