--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/provider_attempt_budget.rs
@@ -0,0 +1,105 @@
+mod config;
+mod private_file;
+mod store;
+#[cfg(test)]
+mod tests;
+
+use super::protocol::error;
+use config::{Context, Trusted};
+use rusqlite::{Connection, TransactionBehavior};
+use serde_json::{json, Value};
+use std::path::Path;
+
+pub(super) const CAPABILITY: &str = "state::provider_attempt_budget_v1";
+pub(super) fn open_graph_automatic_authority(database: &Path) -> anyhow::Result<(std::fs::File,std::fs::File)> {
+    private_file::open_named(database,"graph-automatic-authority.json")
+}
+pub(super) use config::{Context as BindingContext, optional_context};
+#[derive(Clone, Debug)]
+pub(super) struct Identity { pub operation_id: String, pub window_id: String, pub claim_id: String }
+pub(super) enum Request {
+    Claim { identity: Identity, expected_ceiling: u32, context: Option<Context> },
+    Consume { identity: Identity, attempt_id: String, endpoint: String },
+    Finish { identity: Identity, outcome: String },
+    Status { operation_id: String },
+}
+impl Request {
+    fn action(&self) -> &'static str { match self {
+        Self::Claim { .. } => "provider_budget_claim", Self::Consume { .. } => "provider_budget_consume",
+        Self::Finish { .. } => "provider_budget_finish", Self::Status { .. } => "provider_budget_status",
+    } }
+    fn operation(&self) -> &str { match self {
+        Self::Claim { identity, .. } | Self::Consume { identity, .. } | Self::Finish { identity, .. } => &identity.operation_id,
+        Self::Status { operation_id } => operation_id,
+    } }
+    fn validate(&self) -> anyhow::Result<()> {
+        need(config::valid_id(self.operation()), "STATE_PROVIDER_BUDGET_INVALID_REQUEST")?;
+        match self {
+            Self::Status { .. } => Ok(()),
+            Self::Claim { identity, expected_ceiling, context } => {
+                identity.validate()?;
+                need((1..=1000).contains(expected_ceiling) && context.as_ref().is_none_or(Context::valid), "STATE_PROVIDER_BUDGET_INVALID_REQUEST")
+            },
+            Self::Consume { identity, attempt_id, endpoint } => {
+                identity.validate()?;
+                need(config::valid_id(attempt_id) && config::endpoint(endpoint).is_ok(), "STATE_PROVIDER_BUDGET_INVALID_REQUEST")
+            },
+            Self::Finish { identity, outcome } => {
+                identity.validate()?;
+                need(["completed", "unknown"].contains(&outcome.as_str()), "STATE_PROVIDER_BUDGET_INVALID_REQUEST")
+            },
+        }
+    }
+}
+impl Identity {
+    fn validate(&self) -> anyhow::Result<()> {
+        need(config::valid_id(&self.window_id) && config::valid_id(&self.claim_id), "STATE_PROVIDER_BUDGET_INVALID_REQUEST")
+    }
+}
+pub(super) fn need(condition: bool, code: &'static str) -> anyhow::Result<()> {
+    if condition { Ok(()) } else { Err(error(code)) }
+}
+
+pub(super) fn initialize(connection: &Connection) -> anyhow::Result<()> {
+    need(connection.is_autocommit(), "STATE_PROVIDER_BUDGET_TRANSACTION_INVALID")?;
+    let transaction = rusqlite::Transaction::new_unchecked(connection, TransactionBehavior::Immediate)?;
+    store::initialize(&transaction)?;
+    transaction.commit()?;
+    Ok(())
+}
+
+pub(super) fn execute(connection: &Connection, database: &Path, request: Request) -> anyhow::Result<Value> {
+    request.validate()?;
+    // Handles remain open through commit; Windows sharing denies concurrent write/delete.
+    let trusted = Trusted::read(database)?;
+    apply(connection, &trusted, request)
+}
+
+fn apply(connection: &Connection, trusted: &Trusted, request: Request) -> anyhow::Result<Value> {
+    need(connection.is_autocommit(), "STATE_PROVIDER_BUDGET_TRANSACTION_INVALID")?;
+    if matches!(&request, Request::Status { .. }) {
+        store::check_pinned(connection, trusted)?;
+        let receipt = store::receipt(connection, request.operation(), trusted)?;
+        return Ok(json!({"capability":CAPABILITY,"action":request.action(),"operation_id":request.operation(),
+            "fresh":false,"status":"status","receipt":receipt}));
+    }
+    let synchronous: i64 = connection.pragma_query_value(None, "synchronous", |row| row.get(0))?;
+    need(synchronous >= 2, "STATE_PROVIDER_BUDGET_DURABILITY_UNAVAILABLE")?;
+    let transaction = rusqlite::Transaction::new_unchecked(connection, TransactionBehavior::Immediate)?;
+    let result = match &request {
+        Request::Claim { identity, expected_ceiling, context } => store::claim(&transaction, trusted, identity, *expected_ceiling, context.as_ref())?,
+        Request::Consume { identity, attempt_id, endpoint } => store::consume(&transaction, trusted, identity, attempt_id, endpoint)?,
+        Request::Finish { identity, outcome } => store::finish(&transaction, trusted, identity, outcome)?,
+        Request::Status { .. } => unreachable!(),
+    };
+    // A positive fresh ACK is returned only after COMMIT succeeds.
+    transaction.commit()?;
+    Ok(result)
+}
+
+fn acknowledgment(action: &str, identity: &Identity, attempt: Option<&str>, status: &str, fresh: bool, receipt: Value) -> Value {
+    let mut value = json!({"capability":CAPABILITY,"action":action,"operation_id":identity.operation_id,
+        "window_id":identity.window_id,"claim_id":identity.claim_id,"status":status,"fresh":fresh,"receipt":receipt});
+    if let Some(attempt) = attempt { value["attempt_id"] = json!(attempt); }
+    value
+}
