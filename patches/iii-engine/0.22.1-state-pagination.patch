+++ b/engine/src/state_migration/sqlite_replay_tests.rs
@@ -0,0 +1,87 @@
+use super::*;
+use crate::workers::state::adapters::{StateAdapter, sqlite::SqliteAdapter};
+use serde_json::{Value, json};
+
+fn request(guard: Value, weight: u64) -> Value {
+    let body = json!({
+        "identity":{"generation":"1","job_id":"job","logical_delta_id":"delta","chunk_ordinal":0},
+        "expected_checkpoint_version":"0",
+        "checkpoint":{"generation":"1","job_id":"job","logical_delta_id":"delta","delta_ordinal":0,"next_chunk_ordinal":1,"visibility":"applying"},
+        "operations":[
+            {"type":"set","scope":"mem:graph:jobs","key":"job","expected_version":"0","value":{"version":1,"id":"job","generation":"1","logicalDeltaCount":2,"state":"applying"}},
+            {"type":"set","scope":"mem:graph:nodes","key":"a","expected_version":"0","value":{"weight":weight}}
+        ]
+    });
+    let payload = serde_json::to_string(&body).unwrap();
+    json!({"guard":guard,"payload_digest":hex::encode(Sha256::digest(payload.as_bytes())),"payload_json":payload})
+}
+
+#[tokio::test]
+async fn sqlite_migration_preserves_receipt_replay_conflict_and_recovery_fence() {
+    let root = std::env::var_os("III_SQLITE_TEST_ROOT").unwrap();
+    let directory = tempfile::tempdir_in(root).unwrap();
+    let source = directory.path().join("receipt-v2.sqlite3");
+    let adapter = SqliteAdapter::new(Some(json!({"file_path":source}))).unwrap();
+    let mut guard = adapter
+        .lease(json!({"action":"acquire","owner_id":"owner","generation":"1","ttl_ms":300000}))
+        .await
+        .unwrap();
+    guard.as_object_mut().unwrap().remove("expires_at_ms");
+    let first = request(guard.clone(), 2);
+    let receipt = adapter.commit_batch(first).await.unwrap();
+    adapter
+        .lease(
+            json!({"action":"release","owner_id":"owner","generation":"1","fence":guard["fence"]}),
+        )
+        .await
+        .unwrap();
+    adapter.destroy().await.unwrap();
+    drop(adapter);
+    let v1 = directory.path().join("receipt-v1.sqlite3");
+    run(&MigrationArgs {
+        source: source.clone(),
+        target: v1.clone(),
+        disk_budget_bytes: 128 * 1024 * 1024,
+        reverse: true,
+    })
+    .unwrap();
+    let target = directory.path().join("migrated-v2.sqlite3");
+    run(&MigrationArgs {
+        source: v1,
+        target: target.clone(),
+        disk_budget_bytes: 128 * 1024 * 1024,
+        reverse: false,
+    })
+    .unwrap();
+    let migrated = SqliteAdapter::new(Some(json!({"file_path":target}))).unwrap();
+    assert!(
+        migrated
+            .get("mem:graph:nodes", "a")
+            .await
+            .unwrap_err()
+            .to_string()
+            .contains("STATE_GRAPH_RECOVERY_REQUIRED")
+    );
+    let mut guard = migrated
+        .lease(json!({"action":"acquire","owner_id":"recovery","generation":"1","ttl_ms":300000}))
+        .await
+        .unwrap();
+    guard.as_object_mut().unwrap().remove("expires_at_ms");
+    assert_eq!(guard["fence"], "2");
+    assert_eq!(
+        migrated
+            .commit_batch(request(guard.clone(), 2))
+            .await
+            .unwrap(),
+        receipt
+    );
+    assert!(
+        migrated
+            .commit_batch(request(guard, 3))
+            .await
+            .unwrap_err()
+            .to_string()
+            .contains("STATE_TX_REPLAY_CONFLICT")
+    );
+    migrated.destroy().await.unwrap();
+}
diff --git a/engine/src/state_migration/sqlite_schema.rs b/engine/src/state_migration/sqlite_schema.rs
new file mode 100644
index 0000000..c7fde10
--- /dev/null
+++ b/engine/src/state_migration/sqlite_schema.rs
@@ -0,0 +1,101 @@
+use super::sqlite_tables;
+use anyhow::ensure;
+use rusqlite::Connection;
+
+pub(super) fn initialize(
+    input: &Connection,
+    output: &Connection,
+    reverse: bool,
+) -> anyhow::Result<()> {
+    let unsupported: i64 = input.query_row(
+        "SELECT count(*) FROM sqlite_master WHERE type IN ('trigger','view')",
+        [],
+        |r| r.get(0),
+    )?;
+    ensure!(
+        unsupported == 0,
+        "Unsupported source triggers or views; migration requires explicit review"
+    );
+    let mut query = input.prepare("SELECT type,name,sql FROM sqlite_master WHERE sql IS NOT NULL AND name NOT LIKE 'sqlite_%' AND name NOT IN ('shadow_transfer','shadow_transfer_progress') ORDER BY CASE type WHEN 'table' THEN 0 ELSE 1 END,name")?;
+    let mut rows = query.query([])?;
+    while let Some(row) = rows.next()? {
+        let kind: String = row.get(0)?;
+        let name: String = row.get(1)?;
+        let sql: String = row.get(2)?;
+        ensure!(
+            !sql.contains(';'),
+            "Source schema contains unsupported statement separators"
+        );
+        if reverse && name == "retrieval_identifiers" {
+            continue;
+        }
+        if kind == "index" && super::sqlite_indexes::deferred(&name) {
+            continue;
+        }
+        let exists: bool = output.query_row(
+            "SELECT EXISTS(SELECT 1 FROM sqlite_master WHERE name=?1)",
+            [&name],
+            |r| r.get(0),
+        )?;
+        if exists {
+            continue;
+        }
+        if kind == "table" && name == "state_rows" {
+            output.execute_batch(&format!("CREATE TABLE state_rows(scope TEXT NOT NULL,key TEXT NOT NULL,value {},version TEXT NOT NULL,position INTEGER,value_bytes INTEGER NOT NULL,PRIMARY KEY(scope,key)) WITHOUT ROWID",if reverse { "TEXT" } else { "BLOB" }))?;
+        } else if kind == "table" && name == "retrieval_membership" {
+            if reverse {
+                output.execute_batch("CREATE TABLE retrieval_membership(epoch INTEGER NOT NULL,observation TEXT NOT NULL,key TEXT NOT NULL,position INTEGER NOT NULL,PRIMARY KEY(epoch,observation,key)) WITHOUT ROWID")?;
+            } else {
+                output.execute_batch("CREATE TABLE retrieval_identifiers(id INTEGER PRIMARY KEY,epoch INTEGER NOT NULL,value TEXT NOT NULL,UNIQUE(epoch,id),UNIQUE(epoch,value)); CREATE TABLE retrieval_membership(epoch INTEGER NOT NULL,observation INTEGER NOT NULL,key INTEGER NOT NULL,position INTEGER NOT NULL,PRIMARY KEY(epoch,observation,key),FOREIGN KEY(epoch,observation) REFERENCES retrieval_identifiers(epoch,id) ON DELETE CASCADE,FOREIGN KEY(epoch,key) REFERENCES retrieval_identifiers(epoch,id) ON DELETE CASCADE) WITHOUT ROWID")?;
+            }
+        } else {
+            ensure!(
+                !sql.to_uppercase().contains("VIRTUAL TABLE")
+                    || name == "retrieval_lexical" && sql.to_lowercase().contains("using fts5("),
+                "Unsupported virtual table module"
+            );
+            output.execute_batch(&sql)?;
+        }
+    }
+    let fts: bool = output.query_row(
+        "SELECT EXISTS(SELECT 1 FROM sqlite_master WHERE name='retrieval_lexical_config')",
+        [],
+        |r| r.get(0),
+    )?;
+    if fts {
+        for name in [
+            "retrieval_lexical_config",
+            "retrieval_lexical_content",
+            "retrieval_lexical_data",
+            "retrieval_lexical_docsize",
+            "retrieval_lexical_idx",
+        ] {
+            output.execute(&format!("DELETE FROM {}", sqlite_tables::quote(name)), [])?;
+        }
+    }
+    Ok(())
+}
+
+pub(super) fn fence(input: &Connection, output: &Connection, identity: &str) -> anyhow::Result<()> {
+    let exists: bool = input.query_row(
+        "SELECT EXISTS(SELECT 1 FROM sqlite_master WHERE name='state_migration')",
+        [],
+        |r| r.get(0),
+    )?;
+    let manifest = if exists {
+        let count: i64 =
+            input.query_row("SELECT count(*) FROM state_migration", [], |r| r.get(0))?;
+        ensure!(count == 1, "Unexpected source migration history shape");
+        input.query_row("SELECT manifest FROM state_migration WHERE id=1", [], |r| {
+            r.get::<_, String>(0)
+        })?
+    } else {
+        output.execute_batch("CREATE TABLE state_migration(id INTEGER PRIMARY KEY CHECK(id=1),manifest TEXT NOT NULL,status TEXT NOT NULL CHECK(status IN ('pending','ready')))")?;
+        identity.to_owned()
+    };
+    output.execute(
+        "INSERT INTO state_migration(id,manifest,status) VALUES(1,?1,'pending')",
+        [manifest],
+    )?;
+    Ok(())
+}
diff --git a/engine/src/state_migration/sqlite_simple.rs b/engine/src/state_migration/sqlite_simple.rs
new file mode 100644
index 0000000..229080c
--- /dev/null
+++ b/engine/src/state_migration/sqlite_simple.rs
@@ -0,0 +1,105 @@
+use super::{
+    MigrationArgs, sqlite_bulk, sqlite_indexes,
+    sqlite_tables::{self, Table},
+    sqlite_wal, transfer,
+};
+use anyhow::ensure;
+use rusqlite::{Connection, params, types::Value};
+use std::{path::Path, time::Instant};
+
+pub(super) fn copy(
+    input: &Connection,
+    output: &mut Connection,
+    table: &Table,
+    args: &MigrationArgs,
+    target: &Path,
+    stop_after: Option<u64>,
+    total: &mut u64,
+) -> anyhow::Result<()> {
+    ensure!(
+        table.name == "retrieval_name_grams"
+            && table.columns == ["epoch", "gram", "key", "position"]
+            && table.keys == [0, 1, 2],
+        "Unsupported name gram table layout"
+    );
+    let (last, mut count, complete) = sqlite_tables::checkpoint(output, &table.name)?;
+    *total += count;
+    if complete {
+        return Ok(());
+    }
+    let mut cursor = sqlite_tables::parse_cursor(&last)?;
+    sqlite_indexes::defer_table(input, output, &table.name)?;
+    sqlite_wal::pending_normal(output)?;
+    output.execute(
+        "ATTACH DATABASE ?1 AS frozen_name_grams",
+        [sqlite_bulk::readonly_uri(&args.source)?],
+    )?;
+    output.execute_batch("CREATE TEMP TABLE shadow_name_grams_chunk(epoch,gram,key,position); PRAGMA temp.cache_size=-8192;")?;
+    let started = Instant::now();
+    let (mut source_seconds, mut insert_seconds, mut commit_seconds, mut checkpoint_seconds) =
+        (0.0, 0.0, 0.0, 0.0);
+    let mut peak_wal = 0;
+    loop {
+        let limit = stop_after
+            .map(|limit| limit.saturating_sub(*total).clamp(1, 32768))
+            .unwrap_or(32768);
+        let transaction = output.transaction()?;
+        let before = Instant::now();
+        transaction.execute("DELETE FROM temp.shadow_name_grams_chunk", [])?;
+        let after = if cursor.is_empty() {
+            ""
+        } else {
+            " WHERE (epoch,gram,key) > (?,?,?)"
+        };
+        let batch = transaction.execute(&format!("INSERT INTO temp.shadow_name_grams_chunk SELECT epoch,gram,key,position FROM frozen_name_grams.retrieval_name_grams{after} ORDER BY epoch,gram,key LIMIT {limit}"), rusqlite::params_from_iter(&cursor))?;
+        let invalid: i64 = transaction.query_row("SELECT count(*) FROM temp.shadow_name_grams_chunk WHERE typeof(epoch)!='integer' OR typeof(gram)!='text' OR typeof(key)!='text' OR typeof(position)!='integer'", [], |row| row.get(0))?;
+        ensure!(invalid == 0, "Invalid frozen name gram value type");
+        let bytes: i64 = transaction.query_row("SELECT coalesce(sum(length(CAST(gram AS BLOB))+length(CAST(key AS BLOB))+16),0) FROM temp.shadow_name_grams_chunk", [], |row| row.get(0))?;
+        ensure!(
+            bytes <= 32 * 1024 * 1024,
+            "Name gram chunk exceeds bounded batch bytes"
+        );
+        source_seconds += before.elapsed().as_secs_f64();
+        let before = Instant::now();
+        let inserted = transaction.execute("INSERT INTO main.retrieval_name_grams SELECT epoch,gram,key,position FROM temp.shadow_name_grams_chunk ORDER BY epoch,gram,key", [])?;
+        ensure!(
+            inserted == batch,
+            "Name gram copy lost rows: expected {batch}, inserted {inserted}"
+        );
+        if batch != 0 {
+            cursor = transaction.query_row("SELECT epoch,gram,key FROM temp.shadow_name_grams_chunk ORDER BY epoch DESC,gram DESC,key DESC LIMIT 1", [], |row| (0..3).map(|index| row.get::<_,Value>(index)).collect::<rusqlite::Result<Vec<_>>>())?;
+        }
+        count += u64::try_from(batch)?;
+        transaction.execute("INSERT INTO shadow_transfer_progress(name,cursor,count,complete) VALUES('retrieval_name_grams',?1,?2,?3) ON CONFLICT(name) DO UPDATE SET cursor=excluded.cursor,count=excluded.count,complete=excluded.complete", params![sqlite_tables::cursor(&cursor)?,i64::try_from(count)?,batch==0])?;
+        insert_seconds += before.elapsed().as_secs_f64();
+        let before = Instant::now();
+        transaction.commit()?;
+        commit_seconds += before.elapsed().as_secs_f64();
+        *total += u64::try_from(batch)?;
+        transfer::check_budget(target, args.disk_budget_bytes)?;
+        let interrupted = stop_after.is_some_and(|limit| *total >= limit);
+        let before = Instant::now();
+        peak_wal = peak_wal.max(sqlite_wal::after_commit(
+            output,
+            target,
+            batch == 0 || interrupted,
+        )?);
+        checkpoint_seconds += before.elapsed().as_secs_f64();
+        if interrupted {
+            sqlite_wal::full(output)?;
+            anyhow::bail!("Synthetic name gram interruption at committed checkpoint");
+        }
+        if batch == 0 {
+            break;
+        }
+    }
+    output.execute_batch(
+        "DROP TABLE temp.shadow_name_grams_chunk; DETACH DATABASE frozen_name_grams;",
+    )?;
+    sqlite_wal::full(output)?;
+    eprintln!(
+        "shadow migration table=retrieval_name_grams rows={count} bulk_seconds={:.3} source_seconds={source_seconds:.3} insert_seconds={insert_seconds:.3} commit_seconds={commit_seconds:.3} checkpoint_seconds={checkpoint_seconds:.3} peak_wal_bytes={peak_wal}",
+        started.elapsed().as_secs_f64()
+    );
+    Ok(())
+}
diff --git a/engine/src/state_migration/sqlite_simple_tests.rs b/engine/src/state_migration/sqlite_simple_tests.rs
