+use super::*;
+use super::super::{commit,protocol::LeaseRequest};
+use std::sync::{Arc,atomic::{AtomicUsize,Ordering}};
+
+fn open()->(tempfile::TempDir,Connection) {
+    let root=std::env::var("III_SQLITE_TEST_ROOT").expect("isolated test root required");
+    let dir=tempfile::tempdir_in(root).unwrap();
+    let c=database::open(&dir.path().join("repack.sqlite3")).unwrap();(dir,c)
+}
+fn request(c:&Connection,step:Step)->Request {
+    let lease=storage_maintenance_lease::acquire(c,"repack-test",300_000).unwrap();
+    let tx=c.unchecked_transaction().unwrap();
+    let graph=commit::lease(&tx,LeaseRequest::Acquire{owner_id:"repack-test".into(),generation:"1".into(),ttl_ms:300_000}).unwrap();
+    tx.commit().unwrap();
+    Request{operation_id:format!("operation-{}",status(c).unwrap()["ordinal"]),job_id:"pilot".into(),expected_ordinal:status(c).unwrap()["ordinal"].as_u64().unwrap(),step,max_ms:if step==Step::Cut{60_000}else{3000},max_bytes:4*1024*1024,limit:4096,owner_id:"repack-test".into(),fence:lease["fence"].as_u64().unwrap(),guard:Guard{owner_id:"repack-test".into(),generation:"1".into(),fence:graph["fence"].as_str().unwrap().into()}}
+}
+fn apply(c:&Connection,r:Request)->Value {
+    let tx=c.unchecked_transaction().unwrap();let result=execute(&tx,r).unwrap();tx.commit().unwrap();result
+}
+fn ready(c:&Connection) {
+    while status(c).unwrap()["phase"]=="copy" {apply(c,request(c,Step::Copy));}
+    assert_eq!(status(c).unwrap()["phase"],"ready");
+}
+fn rows(c:&Connection,table:&str)->Vec<String> {
+    c.prepare(&format!("SELECT quote(scope)||':'||typeof(scope)||'|'||quote(key)||':'||typeof(key)||'|'||quote(value)||':'||typeof(value)||'|'||quote(version)||':'||typeof(version)||'|'||quote(position)||':'||typeof(position)||'|'||quote(value_bytes)||':'||typeof(value_bytes) FROM {table} ORDER BY scope,key")).unwrap().query_map([],|r|r.get(0)).unwrap().collect::<rusqlite::Result<_>>().unwrap()
+}
+fn seed(c:&Connection,n:usize) {
+    let tx=c.unchecked_transaction().unwrap();
+    for i in 0..n {tx.execute("INSERT INTO state_rows VALUES('test',?1,?2,?3,?4,2)",params![format!("key-{i:08}"),b"{}".as_slice(),format!("{}",i+1),i as i64]).unwrap();}
+    tx.execute_batch("INSERT INTO state_rows VALUES('test','tombstone',NULL,'9007199254740991',NULL,0); INSERT INTO state_rows VALUES('test','text','{}','2',99999,2);").unwrap();tx.commit().unwrap();
+}
+
+#[test]
+fn copy_mirrors_all_mutations_and_cut_preserves_queries_schema_and_rollback() {
+    let (_dir,c)=open();seed(&c,40);let saved=schema::capture(&c).unwrap();
+    apply(&c,request(&c,Step::Begin));let mut first=request(&c,Step::Copy);first.limit=10;apply(&c,first);
+    c.execute_batch("INSERT INTO state_rows VALUES('aaa','behind',X'7B7D','3',42,2); UPDATE state_rows SET scope='aaa',key='moved',version='8',value='{}',position=NULL WHERE scope='test' AND key='key-00000001'; DELETE FROM state_rows WHERE scope='test' AND key='key-00000002'; UPDATE state_rows SET value=NULL,value_bytes=0 WHERE scope='test' AND key='key-00000039';").unwrap();
+    ready(&c);assert_eq!(rows(&c,"state_rows"),rows(&c,"state_repack_stage"));
+    let fidelity=proof(&c).unwrap();assert_eq!(fidelity["raw_verified_rows"],fidelity["copied_rows"]);assert_eq!(fidelity["schema_exact"],true);assert_eq!(fidelity["preserved_native_triggers"],13);
+    let before=rows(&c,"state_rows");let r=request(&c,Step::Cut);apply(&c,r);
+    assert_eq!(rows(&c,"state_rows"),before);assert_eq!(rows(&c,"state_repack_original"),before);
+    assert_eq!(proof(&c).unwrap()["graph_control_raw_types_equal"],true);
+    let view_rows:i64=c.query_row("SELECT count(*) FROM state_values",[],|r|r.get(0)).unwrap();assert_eq!(view_rows,before.len() as i64);
+    let ordered:Vec<String>=c.prepare("SELECT key FROM state_rows INDEXED BY state_rows_order WHERE scope='test' AND value IS NOT NULL ORDER BY position").unwrap().query_map([],|r|r.get(0)).unwrap().collect::<rusqlite::Result<_>>().unwrap();assert!(!ordered.is_empty());
+    mirror::remove(&c).unwrap();assert_eq!(schema::capture(&c).unwrap(),saved);mirror::install(&c,"state_rows","state_repack_original").unwrap();
+    c.execute_batch("INSERT INTO state_rows VALUES('post','cut','{}','1',1,2); UPDATE state_rows SET key='renamed' WHERE scope='post'; DELETE FROM state_rows WHERE scope='aaa';").unwrap();
+    assert_eq!(rows(&c,"state_rows"),rows(&c,"state_repack_original"));
+    let before_rollback=rows(&c,"state_rows");apply(&c,request(&c,Step::Rollback));
+    assert_eq!(rows(&c,"state_rows"),before_rollback);assert_eq!(rows(&c,"state_repack_stage"),before_rollback);
+    apply(&c,request(&c,Step::Cut));apply(&c,request(&c,Step::Retire));
+    assert!(!protected(&c).unwrap());assert_eq!(rows(&c,"state_rows"),before_rollback);
+    assert_eq!(schema::capture(&c).unwrap(),saved);
+}
+
+#[test]
+fn interrupted_copy_rolls_back_cursor_rows_and_receipt_then_resumes() {
+    let (_dir,c)=open();seed(&c,1000);apply(&c,request(&c,Step::Begin));
+    let r=request(&c,Step::Copy);let before=status(&c).unwrap();let stage=rows(&c,"state_repack_stage");
+    let count=Arc::new(AtomicUsize::new(0));let tick=count.clone();
+    let tx=c.unchecked_transaction().unwrap();tx.progress_handler(1,Some(move||tick.fetch_add(1,Ordering::SeqCst)>2000)).unwrap();
+    assert!(execute(&tx,r.clone()).is_err());tx.progress_handler(0,None::<fn()->bool>).unwrap();if !tx.is_autocommit(){tx.rollback().unwrap();}
+    assert_eq!(status(&c).unwrap(),before);assert_eq!(rows(&c,"state_repack_stage"),stage);assert_eq!(receipt(&c,&r).unwrap()["status"],"not_found");
+    apply(&c,r);ready(&c);assert_eq!(rows(&c,"state_rows"),rows(&c,"state_repack_stage"));
+}
+
+#[test]
+fn interrupted_cut_reverts_ddl_keeps_ready_copy_without_recopy() {
+    let (_dir,c)=open();seed(&c,20_000);let saved=schema::capture(&c).unwrap();apply(&c,request(&c,Step::Begin));ready(&c);
+    let before=status(&c).unwrap();let source=rows(&c,"state_rows");let r=request(&c,Step::Cut);
+    let tick=Arc::new(AtomicUsize::new(0));let counter=tick.clone();
+    let tx=c.unchecked_transaction().unwrap();tx.progress_handler(1,Some(move||counter.fetch_add(1,Ordering::SeqCst)>5000)).unwrap();
+    assert!(execute(&tx,r.clone()).is_err());tx.progress_handler(0,None::<fn()->bool>).unwrap();if !tx.is_autocommit(){tx.rollback().unwrap();}
+    assert_eq!(status(&c).unwrap(),before);assert_eq!(rows(&c,"state_rows"),source);assert_eq!(rows(&c,"state_repack_stage"),source);
+    assert_eq!(receipt(&c,&r).unwrap()["status"],"not_found");
+    mirror::remove(&c).unwrap();assert_eq!(schema::capture(&c).unwrap(),saved);mirror::install(&c,"state_rows","state_repack_stage").unwrap();
+    apply(&c,r);assert_eq!(rows(&c,"state_rows"),source);
+}
+
+#[test]
+fn restart_and_lost_ack_use_exact_receipt_across_changed_fence() {
+    let (dir,c)=open();seed(&c,100);apply(&c,request(&c,Step::Begin));let mut r=request(&c,Step::Copy);r.limit=20;let result=apply(&c,r.clone());drop(c);
+    let c=database::open(&dir.path().join("repack.sqlite3")).unwrap();assert_eq!(receipt(&c,&r).unwrap()["result"],result);
+    storage_maintenance_lease::release(&c,&r.owner_id,r.fence).unwrap();let renewed=storage_maintenance_lease::acquire(&c,&r.owner_id,300_000).unwrap();assert_ne!(renewed["fence"],r.fence);
+    assert_eq!(receipt(&c,&r).unwrap()["result"],result);
+    let mut changed=r.clone();changed.fence=renewed["fence"].as_u64().unwrap();assert!(receipt(&c,&changed).is_err());
+    ready(&c);assert_eq!(rows(&c,"state_rows"),rows(&c,"state_repack_stage"));
+}
+
+#[test]
+fn oversized_row_never_skipped_and_original_blocks_gc() {
+    let (_dir,c)=open();c.execute("INSERT INTO state_rows VALUES('large','cell',?1,'1',1,?2)",params![vec![42u8;4*1024*1024],4*1024*1024]).unwrap();
+    apply(&c,request(&c,Step::Begin));let r=request(&c,Step::Copy);let before=status(&c).unwrap();let tx=c.unchecked_transaction().unwrap();
+    let failure=execute(&tx,r).unwrap_err();assert!(failure.to_string().contains("STATE_REPACK_ROW_EXCEEDS_BUDGET"));tx.rollback().unwrap();assert_eq!(status(&c).unwrap(),before);assert!(protected(&c).unwrap());
+    let tx=c.unchecked_transaction().unwrap();let request=super::super::compact::Request{operation_id:"gc-protected".into(),expected_generation:super::super::compact::status(&tx).unwrap()["generation"].as_str().unwrap().into(),step:super::super::compact::Step::Collect,limit:128,max_bytes:4194304,max_ms:3000,lease_owner_id:"repack-test".into(),lease_fence:1};
+    // The native collector guard runs before any candidate or progress mutation.
+    let result=super::super::compact::execute(&tx,request);assert!(result.unwrap_err().to_string().contains("STATE_REPACK_ORIGINAL_PROTECTED"));
+}
diff --git a/engine/src/workers/state/adapters/sqlite/storage_ttl.rs b/engine/src/workers/state/adapters/sqlite/storage_ttl.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/storage_ttl.rs
@@ -0,0 +1,233 @@
+use super::{commit, database, protocol::{self, error, require, Guard}, storage_maintenance_lease, storage_prune};
+use rusqlite::{params, Connection, OptionalExtension};
+use serde::Deserialize;
+use serde_json::{json, Value};
+
+const STATE: &str = "mem:storage-maintenance";
+const DAY: i64 = 86_400_000;
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Request {
+    pub run_id: String,
+    pub ordinal: u64,
+    pub owner_id: String,
+    pub fence: u64,
+    pub guard: Guard,
+    pub viewer_max_age_ms: i64,
+    pub bodies_max_age_ms: i64,
+    pub tools_max_age_ms: i64,
+    #[serde(default)]
+    pub measure_only: bool,
+    #[serde(default)]
+    pub cutoff_at_ms: Option<i64>,
+    #[serde(default)]
+    pub legacy_vector_cache_only: bool,
+}
+
+fn expiry_reason(connection:&Connection,scope:&str,key:&str,value:&Value,_viewer:bool,maximum:i64,now:i64)->anyhow::Result<Option<&'static str>> {
+    super::retention_use_guard::expiry_reason(connection,scope,key,value,maximum,now)
+}
+fn remove(connection: &Connection, scope: &str, key: &str, value: &Value, maximum: i64, now: i64, guard: &Guard, lease_owner: &str, fence: u64) -> anyhow::Result<Value> {
+    let empty = |reason: &str| json!({"deleted_count":0,"raw_stripped_count":0,"deleted_logical_bytes":0,"deleted_stored_bytes":0,"reason":reason});
+    if storage_prune::protected(scope) || storage_prune::protected(key)
+        || storage_prune::protected(&serde_json::to_string(value)?) || storage_prune::row_protected(value) { return Ok(empty("protected")); }
+    if super::storage_legacy_cache::family(scope) {
+        let reason = super::storage_legacy_cache::reason(connection, scope, key, value)?;
+        if reason != "legacy_cache_stale_dimension_canonical_preserved" { return Ok(empty(reason)); }
+        return Ok(json!({"candidate":{"scope":scope,"key":key,"expected_version":database::row_version(connection,scope,key)?.to_string()},"proof":reason}));
+    }
+    let viewer = scope == "mem:recent-searches";
+    let retention = if viewer || scope == "mem:routine-runs" || scope.starts_with("mem:obs:") {
+        let Some(proof)=super::retention_use_guard::snapshot(connection,scope,key,value,maximum,now,lease_owner,fence)? else {
+            return Ok(empty(super::retention_use_guard::expiry_reason(connection,scope,key,value,maximum,now)?.unwrap_or("unknown_origin_or_owner")));
+        };
+        Some(proof)
+    } else {None};
+    if viewer || scope == "mem:routine-runs" || scope.starts_with("mem:obs:") {
+        if let Some(reason)=expiry_reason(connection,scope,key,value,viewer,maximum,now)? {return Ok(empty(reason));}
+    }
+    if viewer || scope == "mem:routine-runs" {
+        if !viewer && value["status"] != "completed" { return Ok(empty("not_completed")); }
+        let (logical, stored): (i64,i64) = connection.query_row(
+            "SELECT value_bytes,COALESCE(stored_bytes,0) FROM state_values WHERE scope=?1 AND key=?2 AND live=1",
+            params![scope,key], |row| Ok((row.get(0)?,row.get(1)?)))?;
+        storage_maintenance_lease::validate_in_transaction(connection,lease_owner,fence)?;
+        if let Some(proof)=retention.as_ref() {super::retention_use_guard::require_recheck(connection,scope,key,value,proof)?;}
+        connection.execute("DELETE FROM state_rows WHERE scope=?1 AND key=?2",params![scope,key])?;
+        let revision=protocol::next(database::revision(connection,scope)?)?.to_string();
+        connection.execute("UPDATE state_scopes SET revision=?2 WHERE scope=?1",params![scope,revision])?;
+        return Ok(json!({"deleted_count":1,"raw_stripped_count":0,"deleted_logical_bytes":logical,"deleted_stored_bytes":stored}));
+    }
+    let mut candidate=json!({"scope":scope,"key":key,"expected_version":database::row_version(connection,scope,key)?.to_string()});
+    if let Some(proof)=retention.as_ref() {candidate["retention"]=serde_json::to_value(proof)?;}
+    if let Some(session)=scope.strip_prefix("mem:obs:") {
+        if !matches!(value["hookType"].as_str(),Some("post_tool_use"|"post_tool_failure")) {return Ok(empty("non_tool_original_preserved"));}
+        if value.get("raw").is_none() {return Ok(empty("raw_already_absent"));}
+        let proof=storage_prune::compressed_source_reason(connection,scope,key,value)?;
+        if matches!(proof,"legacy_indexed_compression"|"native_admission_exact_source_compression") {return Ok(json!({"candidate":candidate,"proof":proof}));}
+        if value["compressionMethod"]=="llm" && value.get("identityIndexedDigest").is_none() {return Ok(empty(proof));}
+        let Some(digest)=value["identityIndexedDigest"].as_str().filter(|digest|value["identityDigest"]==*digest) else {return Ok(empty("identity_not_indexed"))};
+        let Some(identity)=storage_prune::bounded_dependency(connection,&format!("mem:obs-identity:{session}"),digest)? else {return Ok(empty("identity_proof_missing_or_oversized"))};
+        let Some(original)=identity["observationId"].as_str().filter(|original|*original!=key) else {return Ok(empty("unique_source_without_durable_compression"))};
+        candidate["preserved"]=json!({"scope":scope,"key":original,"expected_version":database::row_version(connection,scope,original)?.to_string()});
+        return Ok(json!({"candidate":candidate}));
+    }
+    let parent = if let Some(job)=scope.strip_prefix("mem:summary-queue:units:") {
+        Some(("mem:summary-queue:jobs".to_owned(),job.to_owned()))
+    } else if scope == "mem:temporal-graph-work" && key.starts_with("temporal-work:") {
+        key.strip_prefix("temporal-work:").and_then(|tail|tail.split_once(":page:")).map(|(id,_)|(scope.to_owned(),format!("temporal-work:{id}:manifest")))
+    } else if scope == "mem:temporal-graph-pending" {
+        Some(("mem:temporal-graph-work".to_owned(),format!("temporal-work:{key}:manifest")))
+    } else { None };
+    if let Some((parent_scope,parent_key))=parent {
+        let Some(parent)=storage_prune::bounded_dependency(connection,&parent_scope,&parent_key)? else {return Ok(empty("parent_missing_or_oversized"))};
+        if let Some(reason)=expiry_reason(connection,&parent_scope,&parent_key,&parent,false,maximum,now)? {return Ok(empty(reason));}
+        candidate["preserved"]=json!({"scope":parent_scope,"key":parent_key,
+            "expected_version":database::row_version(connection,&parent_scope,&parent_key)?.to_string()});
+    } else if let Some(job_id)=scope.strip_prefix("mem:graph:prepared:").or_else(||scope.strip_prefix("mem:graph:remaps:")) {
+        commit::maintenance_allowed(connection,guard,Some(job_id))?;
+        let checkpoint_version=database::row_version(connection,database::CHECKPOINT_SCOPE,job_id)?.to_string();
+        let Ok((_,job))=super::retention::eligible(connection,job_id,&checkpoint_version) else {return Ok(empty("graph_publication_or_recovery_not_closed"))};
+        if let Some(reason)=expiry_reason(connection,protocol::JOBS,job_id,&job,false,maximum,now)? {return Ok(empty(reason));}
+        if !storage_prune::temporal_unit_ready(connection,job_id,&job)? {return Ok(empty("temporal_dependencies_open"));}
+        let (logical,stored):(i64,i64)=connection.query_row("SELECT value_bytes,COALESCE(stored_bytes,0) FROM state_values WHERE scope=?1 AND key=?2 AND live=1",params![scope,key],|row|Ok((row.get(0)?,row.get(1)?)))?;
+        storage_maintenance_lease::validate_in_transaction(connection,lease_owner,fence)?;
+        if let Some(proof)=retention.as_ref() {super::retention_use_guard::require_recheck(connection,scope,key,value,proof)?;}
+        connection.execute("DELETE FROM state_rows WHERE scope=?1 AND key=?2",params![scope,key])?;
+        let revision=protocol::next(database::revision(connection,scope)?)?.to_string();
+        connection.execute("UPDATE state_scopes SET revision=?2 WHERE scope=?1",params![scope,revision])?;
+        return Ok(json!({"deleted_count":1,"raw_stripped_count":0,"deleted_logical_bytes":logical,"deleted_stored_bytes":stored}));
+    } else {
+        // Durable manifests, replay identities and original observations remain owned.
+        return Ok(empty("durable_manifest_or_replay_identity"));
+    }
+    Ok(json!({"candidate":candidate}))
+}
