+use super::*;
+
+const OBS: &str = "mem:obs:orphan-session";
+
+fn observation(id: &str, title: &str) -> Value {
+    json!({"id":id,"sessionId":"orphan-session","title":title,"subtitle":"raw_sqlite","narrative":"canonical narrative","facts":["atomic_commit_batch"],"concepts":["disk_posting"],"files":["worker_state.rs"]})
+}
+
+fn tracked(connection: &Connection) {
+    let mut request = semantic_request("semantic_configure");
+    request["source_kind"] = json!("agentmemory");
+    call(connection, request).unwrap();
+}
+
+fn status(connection: &Connection) -> Value {
+    call(connection, json!({"action":"index_status"})).unwrap()["semantic"][0].clone()
+}
+
+fn prepare(connection: &Connection, rows: usize) -> Value {
+    let mut request = semantic_request("source_prepare");
+    request["max_rows"] = json!(rows);
+    request["max_bytes"] = json!(1024);
+    call(connection, request).unwrap()
+}
+
+fn finish_preparation(connection: &Connection) {
+    for _ in 0..100 {
+        if prepare(connection, 1)["source_prepared"] == true {
+            return;
+        }
+    }
+    panic!("bounded preparation failed to finish");
+}
+
+fn source_item(connection: &Connection, scope: &str, id: &str) -> Value {
+    let mut item = vector_item(id, &[1.0, 0.0, 0.0, 0.0], Some("clipped embedding text"));
+    item["source_scope"] = json!(scope);
+    item["source_version"] = json!(
+        database::row(connection, scope, id)
+            .unwrap()
+            .version
+            .to_string()
+    );
+    item
+}
+
+#[test]
+fn canonical_commit_closes_crash_gap_and_metadata_does_not_dirty() {
+    let connection = fresh();
+    tracked(&connection);
+    let mut value = observation("a", "initial");
+    write(&connection, OBS, "a", Some(&value));
+    assert_eq!(status(&connection)["dirty_count"], "1");
+    assert_eq!(status(&connection)["coverage_ready"], false);
+    assert_eq!(
+        code(keywords(&connection, "initial").unwrap_err()),
+        "STATE_SEMANTIC_SOURCE_NOT_READY"
+    );
+    upsert(&connection, vec![source_item(&connection, OBS, "a")]).unwrap();
+    assert_eq!(status(&connection)["coverage_ready"], true);
+    value["lastAccessed"] = json!("later");
+    write(&connection, OBS, "a", Some(&value));
+    assert_eq!(status(&connection)["coverage_ready"], true);
+    for term in [
+        "raw_sqlite",
+        "atomic_commit_batch",
+        "disk_posting",
+        "worker_state",
+    ] {
+        assert_eq!(
+            returned_ids(&keywords(&connection, term).unwrap()),
+            vec!["a"]
+        );
+    }
+    value["files"] = json!(["different_identifier"]);
+    write(&connection, OBS, "a", Some(&value));
+    assert_eq!(status(&connection)["dirty_count"], "1");
+    upsert(&connection, vec![source_item(&connection, OBS, "a")]).unwrap();
+    assert!(returned_ids(&keywords(&connection, "worker_state").unwrap()).is_empty());
+    assert_eq!(
+        returned_ids(&keywords(&connection, "different_identifier").unwrap()),
+        vec!["a"]
+    );
+}
+
+#[test]
+fn stale_source_batch_rolls_back_vectors_and_dirty_acknowledgement() {
+    let connection = fresh();
+    tracked(&connection);
+    for id in ["a", "b"] {
+        write(&connection, OBS, id, Some(&observation(id, id)));
+    }
+    let a = source_item(&connection, OBS, "a");
+    let b = source_item(&connection, OBS, "b");
+    write(&connection, OBS, "b", Some(&observation("b", "new title")));
+    assert_eq!(
+        code(upsert(&connection, vec![a, b]).unwrap_err()),
+        "STATE_SEMANTIC_SOURCE_STALE"
+    );
+    assert_eq!(status(&connection)["dirty_count"], "2");
+    assert_eq!(status(&connection)["count"], 0);
+    assert!(
+        database::row(&connection, "mem:semantic:observations", "a")
+            .unwrap()
+            .value
+            .is_none()
+    );
+    upsert(
+        &connection,
+        vec![
+            source_item(&connection, OBS, "a"),
+            source_item(&connection, OBS, "b"),
+        ],
+    )
+    .unwrap();
+    assert_eq!(status(&connection)["coverage_ready"], true);
+}
