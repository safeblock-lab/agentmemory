@@ -0,0 +1,19 @@
+use rusqlite::Connection;
+use serde_json::{json,Value};
+pub fn page(c:&Connection)->anyhow::Result<Value> {
+    let mut statement=c.prepare_cached("SELECT length(CAST(result AS BLOB)),CASE WHEN length(CAST(result AS BLOB))<=524288 THEN result END FROM compact_receipts ORDER BY operation_id LIMIT 32")?;
+    let mut rows=statement.query([])?;let mut inspected=0usize;let mut skipped=0usize;let mut plain=0usize;let mut encoded=0usize;
+    while let Some(row)=rows.next()? {
+        super::database::check_preparation()?;
+        let size=usize::try_from(row.get::<_,i64>(0)?)?;
+        let value=row.get::<_,Option<String>>(1)?;
+        let Some(value)=value else {skipped+=1;continue;};
+        if plain+size>524288 {break;}
+        let bytes=super::codec::encode(&value)?;
+        anyhow::ensure!(super::codec::decode(&bytes,value.len())?==value,"STATE_RECEIPT_SCREEN_ROUNDTRIP_FAILED");
+        plain+=size;encoded+=bytes.len()+24;inspected+=1;
+    }
+    Ok(json!({"inspected":inspected,"skippedLarge":skipped,"plainBytes":plain,"codecBytesWithProvisionalHeader":encoded,
+        "sampleNetBytes":plain as i64-encoded as i64,"roundtrip":"exact_native_codec","productionMigrationImplemented":false,
+        "projectionPermitted":false,"physicalSavingsCreditedBytes":0,"indefiniteReplayRetention":"unchanged"}))
+}
