+#[test]
+fn canonical_scoped_legacy_restore_sql_failure_rolls_back_acknowledgement_and_cursor() {
+    let c = fixture();
+    c.execute_batch("CREATE TRIGGER reject_restored_posting BEFORE INSERT ON retrieval_vector_postings WHEN new.id='a' BEGIN SELECT RAISE(ABORT,'synthetic restore failure'); END;").unwrap();
+    let error = call(&c, request(16)).unwrap_err();
+    assert!(
+        error.to_string().contains("synthetic restore failure"),
+        "{error}"
+    );
+    assert!(proof(&c, "a").is_none());
+    let roots: i64 = c
+        .query_row("SELECT count(*) FROM retrieval_scoped_coverage", [], |r| {
+            r.get(0)
+        })
+        .unwrap();
+    assert_eq!(roots, 0);
+    c.execute_batch("DROP TRIGGER reject_restored_posting")
+        .unwrap();
+    assert_eq!(call(&c, request(16)).unwrap()["status"], "ready");
+    assert_ready_hit(&c);
+}
