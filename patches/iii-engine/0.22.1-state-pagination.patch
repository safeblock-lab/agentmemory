+                .set("scope".to_string(), "one".to_string(), serde_json::json!(1))
+                .await;
+            store
+                .set("scope".to_string(), "two".to_string(), serde_json::json!(2))
+                .await;
+            if mutation == "release" {
+                assert!(
+                    store
+                        .try_acquire_lock("scope", "lock", "owner", 60_000)
+                        .await
+                );
+            }
+            let cursor = cursor_after_first_item(&store, "scope").await;
+
+            match mutation {
+                "set" => {
+                    store
+                        .set("scope".to_string(), "one".to_string(), serde_json::json!(1))
+                        .await;
+                }
+                "delete" => {
+                    store.delete("scope".to_string(), "one".to_string()).await;
+                }
+                "update" => {
+                    store
+                        .update(
