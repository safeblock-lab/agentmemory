@@ -0,0 +1,51 @@
+use super::super::{database, protocol};
+use super::{semantic::PREFIX, source};
+use rusqlite::{Connection, OptionalExtension};
+use serde_json::{Value, json};
+
+pub struct Meta {
+    pub index_id: String,
+    pub model: String,
+    pub dimensions: usize,
+    pub generation: String,
+    pub status: String,
+    pub cursor: i64,
+    pub revision: String,
+    pub epoch: i64,
+    pub count: usize,
+    pub lexical_count: usize,
+}
+impl Meta {
+    pub fn scope(&self) -> String {
+        format!("{PREFIX}{}", self.index_id)
+    }
+    pub fn ready(&self, connection: &Connection) -> anyhow::Result<()> {
+        if self.status != "ready"
+            || self.revision != database::revision(connection, &self.scope())?.to_string()
+        {
+            return Err(protocol::error("STATE_INDEX_NOT_READY"));
+        }
+        source::ready(connection, &self.index_id)?;
+        Ok(())
+    }
+    pub fn identity(&self, model: &str, dimensions: usize, generation: &str) -> anyhow::Result<()> {
+        if self.model != model || self.dimensions != dimensions || self.generation != generation {
+            return Err(protocol::error("STATE_SEMANTIC_IDENTITY_MISMATCH"));
+        }
+        Ok(())
+    }
+    pub fn status_value(&self) -> Value {
+        json!({"index_id":self.index_id,"model":self.model,"dimensions":self.dimensions,"generation":self.generation,"status":self.status,"count":self.count,"lexical_count":self.lexical_count,"lexical_ready":self.status=="ready" && self.count==self.lexical_count,"cursor":self.cursor.to_string(),"revision":self.revision})
+    }
+}
+
+pub fn get(connection: &Connection, id: &str) -> anyhow::Result<Meta> {
+    connection.query_row("SELECT index_id,model,dimensions,generation,status,cursor,revision,epoch,count,lexical_count FROM retrieval_semantic_meta WHERE index_id=?1", [id], |r| {
+        Ok(Meta {index_id:r.get(0)?,model:r.get(1)?,dimensions:sql_usize(r,2)?,generation:r.get(3)?,status:r.get(4)?,cursor:r.get(5)?,revision:r.get(6)?,epoch:r.get(7)?,count:sql_usize(r,8)?,lexical_count:sql_usize(r,9)?})
+    }).optional()?.ok_or_else(|| protocol::error("STATE_INDEX_NOT_READY"))
+}
+
+fn sql_usize(row: &rusqlite::Row<'_>, column: usize) -> rusqlite::Result<usize> {
+    let value: i64 = row.get(column)?;
+    usize::try_from(value).map_err(|_| rusqlite::Error::IntegralValueOutOfRange(column, value))
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/semantic_query.rs b/engine/src/workers/state/adapters/sqlite/retrieval/semantic_query.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/semantic_query.rs
@@ -0,0 +1,125 @@
+use super::{lsh, semantic};
+use rusqlite::{Connection, params};
+use serde_json::{Value, json};
+use std::collections::HashSet;
+struct Match {
+    id: String,
+    session: String,
+    score: f64,
+}
+fn rank(a: &Match, b: &Match) -> std::cmp::Ordering {
+    b.score.total_cmp(&a.score).then(a.id.cmp(&b.id))
+}
+pub fn search(
+    c: &Connection,
+    id: &str,
+    model: &str,
+    dimensions: usize,
+    generation: &str,
+    embedding: &str,
+    limit: usize,
+    max_candidates: usize,
+    probes: usize,
+    options: super::search_projection::Options<'_>,
+) -> anyhow::Result<Value> {
+    let meta = semantic::get(c, id)?;
+    meta.identity(model, dimensions, generation)?;
+    if options.source_scope.is_some() || options.source_kind.is_some() || options.include_text {
+        super::super::protocol::require(super::source::kind(c, id)?.is_some())?;
+    }
+    if options.project.is_some() {
+        return super::scoped::semantic_search(
+            c,
+            &meta,
+            embedding,
+            limit,
+            max_candidates,
+            probes,
+            options,
+        );
+    }
+    meta.ready(c)?;
+    let query = lsh::decode(embedding, dimensions)?;
+    let buckets: Vec<_> = lsh::signatures(&query)
+        .iter()
+        .map(|signature| lsh::buckets(signature, probes))
+        .collect();
+    let packed = super::super::search_packed::active(c)?;
+    let sql = format!("SELECT p.id,v.session_id,v.embedding FROM retrieval_vector_postings p CROSS JOIN retrieval_vector_values v WHERE p.index_id=?1 AND p.epoch=?2 AND p.table_id=?3 AND p.bucket=?4 AND v.index_id=p.index_id AND v.epoch=p.epoch AND v.id=p.id AND (?5 IS NULL OR v.session_id=?5) {} ORDER BY p.id LIMIT ?8",super::search_projection::filter("?6","?7"));
+    let packed_sql = format!("SELECT v.id,v.session_id,v.embedding FROM search_packed_blocks p CROSS JOIN json_each(state_compact_ids(p.payload)) m CROSS JOIN compact_identifiers i ON i.id=m.value CROSS JOIN retrieval_vector_values v ON v.index_id=p.index_id AND v.epoch=p.epoch AND v.id=json_extract(i.token,'$') WHERE p.index_id=?1 AND p.epoch=?2 AND p.table_id=?3 AND p.bucket=?4 AND (?5 IS NULL OR v.session_id=?5) {} ORDER BY v.id COLLATE BINARY LIMIT ?8",super::search_projection::filter("?6","?7"));
+    let mut packed_statement = c.prepare_cached(&packed_sql)?;
+    let mut statement = c.prepare_cached(&sql)?;
+    let mut seen = HashSet::with_capacity(max_candidates.min(4096));
+    let mut matches: Vec<Match> = Vec::with_capacity(limit);
+    let mut bytes = 0;
+    let mut visits = 0;
+    let max_visits = max_candidates.saturating_mul(lsh::TABLES);
+    let bucket_limit = (max_candidates / lsh::TABLES).max(16);
+    let mut exhausted = false;
+    'probe: for probe in 0..probes {
+        for (table, buckets) in buckets.iter().enumerate() {
+            let statement = if packed && super::super::search_packed::bounded_bucket(c,id,meta.epoch,table,buckets[probe],dimensions)? { &mut packed_statement } else { &mut statement };
+            let mut rows = statement.query(params![
+                id,
+                meta.epoch,
+                table as i64,
+                buckets[probe],
+                options.session_id,
+                options.source_scope,
+                options.source_kind,
+                (bucket_limit + 1) as i64
+            ])?;
+            let mut count = 0;
+            while let Some(row) = rows.next()? {
+                visits += 1;
+                count += 1;
+                if visits > max_visits {
+                    exhausted = true;
+                    break 'probe;
+                }
+                if count > bucket_limit {
+                    exhausted = true;
+                    break;
+                }
+                let id: String = row.get(0)?;
+                if seen.contains(&id) {
+                    continue;
+                }
+                if seen.len() >= max_candidates || bytes + id.len() > 4 * 1024 * 1024 {
+                    exhausted = true;
+                    break 'probe;
+                }
+                bytes += id.len();
+                seen.insert(id.clone());
+                let vector = lsh::from_blob(&row.get::<_, Vec<u8>>(2)?, dimensions)?;
+                let candidate = Match {
+                    id,
+                    session: row.get(1)?,
+                    score: lsh::cosine(&query, &vector),
+                };
+                if matches.len() < limit
+                    || rank(&candidate, matches.last().expect("bounded top results")).is_lt()
+                {
+                    matches.push(candidate);
+                    matches.sort_unstable_by(rank);
+                    matches.truncate(limit);
+                }
+            }
+        }
+    }
+    let mut items: Vec<Value> = matches
+        .into_iter()
+        .map(|v| json!({"obsId":v.id,"sessionId":v.session,"score":v.score}))
+        .collect();
+    let projection = super::search_projection::enrich(c, id, &mut items, options)?;
+    let reason = if projection.is_some() {
+        projection
+    } else if exhausted {
+        Some("candidate_budget")
+    } else {
+        None
+    };
+    Ok(
+        json!({"items":items,"approximate":true,"candidates":seen.len(),"budget_exhausted":exhausted,"status":if reason.is_some(){"partial"}else{"ready"},"reason":reason,"model":model,"dimensions":dimensions,"generation":generation}),
+    )
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/shared_source_projection.rs b/engine/src/workers/state/adapters/sqlite/retrieval/shared_source_projection.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/shared_source_projection.rs
@@ -0,0 +1,201 @@
+use super::super::{database, protocol};
+use super::{
+    project_catalog, reflect_sources, request::ReflectSource, source_lexical::project_fields,
+};
+use rusqlite::Connection;
+use serde_json::{Value, json};
+use sha2::{Digest, Sha256};
+use std::collections::HashSet;
+
+const FIELDS: &[&str] = &[
+    "id",
+    "project",
+    "sessionId",
+    "title",
+    "narrative",
+    "content",
+    "fact",
+    "confidence",
+    "strength",
+    "concepts",
+    "files",
+    "tags",
+    "sourceMemoryIds",
+    "sourceObservationIds",
+    "sourceIds",
+    "lessons",
+    "keyOutcomes",
+    "filesAffected",
+    "sourceActionIds",
+    "createdAt",
+    "updatedAt",
+    "timestamp",
+    "type",
+    "deleted",
+    "stale",
+    "isLatest",
+    "supersededBy",
+    "forgetAfter",
+];
+
+fn session_ids(value: &Value) -> anyhow::Result<Result<Vec<String>, &'static str>> {
+    let mut ids = Vec::new();
+    let mut seen = HashSet::new();
+    for field in ["sessionId", "sessionIds", "sourceSessionIds"] {
+        let Some(reference) = value.get(field) else {
+            continue;
+        };
+        let references: Vec<&Value> = if field == "sessionId" {
+            vec![reference]
+        } else {
+            let Some(values) = reference.as_array() else {
+                return Ok(Err("audience_unknown"));
+            };
+            values.iter().collect()
+        };
+        for reference in references {
+            let Some(id) = reference
+                .as_str()
+                .filter(|id| !id.trim().is_empty() && id.len() <= 256)
+            else {
+                return Ok(Err("audience_unknown"));
+            };
+            if seen.insert(id.to_owned()) {
+                ids.push(id.to_owned());
+                if ids.len() > 2048 {
+                    return Ok(Err("resource_limit"));
+                }
+            }
+        }
+    }
+    Ok(Ok(ids))
+}
+
+fn fingerprint(version: &str, value: &Value) -> anyhow::Result<String> {
+    let bytes = serde_json::to_vec(&json!({"version":version,"value":value}))?;
+    Ok(format!("{:x}", Sha256::digest(bytes)))
+}
+
+fn cursor_digest(scope: &str, key: &str, version: &str) -> String {
+    format!(
+        "{:x}",
+        Sha256::digest(format!("{scope}\0{key}\0{version}").as_bytes())
+    )
+}
+
+fn parse_cursor(cursor: &str, scope: &str, key: &str, version: &str) -> anyhow::Result<usize> {
+    let mut parts = cursor.split(':');
+    let prefix = parts.next();
+    let offset = parts.next().and_then(|value| value.parse::<usize>().ok());
+    let saved_version = parts.next();
+    let digest = parts.next();
+    protocol::require(prefix == Some("v1") && parts.next().is_none())?;
+    protocol::require(
+        saved_version == Some(version)
+            && digest == Some(cursor_digest(scope, key, version).as_str()),
+    )?;
+    let offset = offset.ok_or_else(|| super::request::resource())?;
+    protocol::require(offset > 0)?;
+    Ok(offset)
+}
+
+fn next_cursor(scope: &str, key: &str, version: &str, offset: usize) -> String {
+    format!(
+        "v1:{offset}:{version}:{}",
+        cursor_digest(scope, key, version)
+    )
+}
+
+fn project_source(
+    connection: &Connection,
+    source: &ReflectSource,
+) -> anyhow::Result<Result<Value, &'static str>> {
+    let loaded = reflect_sources::load(connection, &source.scope, &source.key)?;
+    let (version, value) = match loaded {
+        Ok(value) => value,
+        Err(reason) => return Ok(Err(reason)),
+    };
+    if source
+        .expected_version
+        .as_ref()
+        .is_some_and(|expected| expected != &version)
+    {
+        return Ok(Err("stale"));
+    }
+    if !reflect_sources::fresh(&value) {
+        return Ok(Err("stale"));
+    }
+    let refs = match session_ids(&value)? {
+        Ok(refs) => refs,
+        Err(reason) => return Ok(Err(reason)),
+    };
+    if value
+        .get("project")
+        .and_then(Value::as_str)
+        .is_none_or(|p| p.trim().is_empty())
+        && refs.is_empty()
+    {
+        return Ok(Err("audience_unknown"));
+    }
+    let offset = source
+        .provenance_cursor
+        .as_deref()
+        .map_or(Ok(0), |cursor| {
+            parse_cursor(cursor, &source.scope, &source.key, &version)
+        })?;
+    if offset >= refs.len() && offset != 0 {
+        return Ok(Err("stale"));
+    }
+    let end = offset.saturating_add(12).min(refs.len());
+    let mut provenance = Vec::with_capacity(end - offset);
+    for session_id in &refs[offset..end] {
+        match project_catalog::resolve_session(connection, session_id)? {
+            Ok(project) => provenance.push(json!({"session_id":session_id,"project":project})),
+            Err(reason) => return Ok(Err(reason)),
+        }
+    }
+    let projected = project_fields(&value, FIELDS);
+    let fp = fingerprint(&version, &projected)?;
+    let cursor = (end < refs.len()).then(|| next_cursor(&source.scope, &source.key, &version, end));
+    let status = if cursor.is_some() { "partial" } else { "ready" };
+    let mut item = json!({"scope":source.scope,"key":source.key,"version":version,"fingerprint":fp,
+        "value":projected,"provenance":provenance,"status":status});
+    if let Some(cursor) = cursor {
+        item["next_cursor"] = json!(cursor);
+    }
+    if status == "partial" {
+        item["reason"] = json!("provenance_page");
+    }
+    Ok(Ok(item))
+}
+
+pub fn execute(
+    connection: &Connection,
+    sources: &[ReflectSource],
+    max_bytes: usize,
+) -> anyhow::Result<Value> {
+    let mut items = Vec::with_capacity(sources.len());
+    let mut deferred = Vec::new();
+    let mut bytes = 128usize;
+    for source in sources {
+        match project_source(connection, source)? {
+            Ok(item) => {
+                let item_bytes = protocol::size(&item)? + 1;
+                if bytes.saturating_add(item_bytes) > max_bytes {
+                    deferred.push(
+                        json!({"scope":source.scope,"key":source.key,"reason":"response_limit"}),
+                    );
+                    continue;
+                }
+                bytes += item_bytes;
+                items.push(item);
+            }
+            Err(reason) => {
+                deferred.push(json!({"scope":source.scope,"key":source.key,"reason":reason}))
+            }
+        }
+    }
+    Ok(
+        json!({"items":items,"deferred":deferred,"status":if deferred.is_empty(){"ready"}else{"partial"},"revision":database::revision(connection,"mem:sessions")?.to_string()}),
+    )
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/source.rs b/engine/src/workers/state/adapters/sqlite/retrieval/source.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/source.rs
@@ -0,0 +1,230 @@
+use super::super::{database, protocol};
+use super::{eligibility, semantic, source_prepare};
+use rusqlite::{Connection, OptionalExtension, params};
+use serde_json::{Value, json};
+
+pub const SCOPES: &str = "SELECT scope,revision FROM state_scopes WHERE scope>='mem:obs:' AND scope<'mem:obs;' UNION ALL SELECT scope,revision FROM state_scopes WHERE scope='mem:memories'";
+pub fn tracked_scope(scope: &str) -> bool {
+    scope.starts_with("mem:obs:") || scope == "mem:memories"
+}
+
+pub fn schema(connection: &Connection) -> anyhow::Result<()> {
+    eligibility::register(connection)?;
+    connection.execute_batch("CREATE TABLE IF NOT EXISTS retrieval_source_meta(index_id TEXT PRIMARY KEY,kind TEXT NOT NULL,dirty_count INTEGER NOT NULL CHECK(dirty_count>=0),current_scope TEXT NOT NULL,cursor INTEGER NOT NULL,phase TEXT NOT NULL,cleanup_cursor TEXT NOT NULL) WITHOUT ROWID;
+        CREATE TABLE IF NOT EXISTS retrieval_source_scopes(index_id TEXT NOT NULL,scope TEXT NOT NULL,revision TEXT NOT NULL,prepared INTEGER NOT NULL,PRIMARY KEY(index_id,scope)) WITHOUT ROWID;
+        CREATE TABLE IF NOT EXISTS retrieval_source_items(index_id TEXT NOT NULL,scope TEXT NOT NULL,key TEXT NOT NULL,version TEXT NOT NULL,dirty INTEGER NOT NULL,PRIMARY KEY(index_id,scope,key)) WITHOUT ROWID;
+        CREATE TABLE IF NOT EXISTS retrieval_source_repairs(index_id TEXT NOT NULL,scope TEXT NOT NULL,key TEXT NOT NULL,version TEXT NOT NULL,reason TEXT NOT NULL,PRIMARY KEY(index_id,scope,key)) WITHOUT ROWID;
+        CREATE INDEX IF NOT EXISTS retrieval_source_items_id ON retrieval_source_items(index_id,key);
+        CREATE INDEX IF NOT EXISTS retrieval_source_items_dirty ON retrieval_source_items(index_id,dirty,scope,key);")?;
+    Ok(())
+}
+
+pub fn kind(connection: &Connection, id: &str) -> anyhow::Result<Option<String>> {
+    Ok(connection
+        .query_row(
+            "SELECT kind FROM retrieval_source_meta WHERE index_id=?1",
+            [id],
+            |r| r.get(0),
+        )
+        .optional()?)
+}
+
+pub fn configure(
+    connection: &Connection,
+    id: &str,
+    source_kind: Option<&str>,
+    existed: bool,
+) -> anyhow::Result<()> {
+    let current = kind(connection, id)?;
+    if existed && current.as_deref() != source_kind {
+        return Err(protocol::error("STATE_SEMANTIC_IDENTITY_MISMATCH"));
+    }
+    if source_kind.is_some() && current.is_none() {
+        connection.execute(
+            "INSERT INTO retrieval_source_meta VALUES(?1,'agentmemory',0,'',-1,'rows','')",
+            [id],
+        )?;
+    }
+    Ok(())
+}
+
+pub fn pending_scope(
+    connection: &Connection,
+    id: &str,
+) -> anyhow::Result<Option<(String, String)>> {
+    let sql = format!(
+        "SELECT s.scope,s.revision FROM ({SCOPES}) s LEFT JOIN retrieval_source_scopes r ON r.index_id=?1 AND r.scope=s.scope WHERE r.scope IS NULL OR r.revision<>s.revision OR r.prepared=0 ORDER BY s.scope LIMIT 1"
+    );
+    Ok(connection
+        .query_row(&sql, [id], |r| Ok((r.get(0)?, r.get(1)?)))
+        .optional()?)
+}
+
+pub fn status(connection: &Connection, id: &str) -> anyhow::Result<Value> {
+    let source_kind = kind(connection, id)?;
+    let dirty: i64 = if source_kind.is_some() {
+        connection.query_row(
+            "SELECT dirty_count FROM retrieval_source_meta WHERE index_id=?1",
+            [id],
+            |r| r.get(0),
+        )?
+    } else {
+        0
+    };
+    let prepared = source_kind.is_none() || pending_scope(connection, id)?.is_none();
+    let repairs: i64 = connection.query_row(
+        "SELECT count(*) FROM (SELECT 1 FROM retrieval_source_repairs WHERE index_id=?1 LIMIT 129)", [id], |r| r.get(0),
+    )?;
+    let mut statement = connection.prepare("SELECT scope,key,version,reason FROM retrieval_source_repairs WHERE index_id=?1 ORDER BY scope,key LIMIT 16")?;
+    let repair_sources = statement.query_map([id], |r| Ok(json!({
+        "source_scope":r.get::<_,String>(0)?,"id":r.get::<_,String>(1)?,
+        "source_version":r.get::<_,String>(2)?,"reason":r.get::<_,String>(3)?
+    })))?.collect::<rusqlite::Result<Vec<_>>>()?;
+    Ok(
+        json!({"source_kind":source_kind,"source_prepared":prepared,"dirty_count":dirty.to_string(),
+            "repair_count":repairs.to_string(),"repair_count_capped":repairs==129,"repair_sources":repair_sources,"repair_sources_has_more":repairs>16,
+            "coverage_ready":prepared && dirty==0 && repairs==0}),
+    )
+}
+
+pub fn repair_required(connection: &Connection, id: &str, scope: &str, key: &str,
+    version: &str, reason: &str) -> anyhow::Result<()> {
+    protocol::require(tracked_scope(scope))?;
+    protocol::counter(version)?;
+    connection.execute("INSERT INTO retrieval_source_repairs VALUES(?1,?2,?3,?4,?5) ON CONFLICT(index_id,scope,key) DO UPDATE SET version=excluded.version,reason=excluded.reason",
+        params![id,scope,key,version,reason])?;
+    Ok(())
+}
+
+pub fn ready(connection: &Connection, id: &str) -> anyhow::Result<()> {
+    if status(connection, id)?["coverage_ready"] != true {
+        return Err(protocol::error("STATE_SEMANTIC_SOURCE_NOT_READY"));
+    }
+    Ok(())
+}
+
+pub fn decorate(connection: &Connection, id: &str, mut value: Value) -> anyhow::Result<Value> {
+    if let (Some(output), Some(fields)) =
+        (value.as_object_mut(), status(connection, id)?.as_object())
+    {
+        output.extend(
+            fields
+                .iter()
+                .map(|(key, value)| (key.clone(), value.clone())),
+        );
+    }
+    Ok(value)
+}
+
+pub(super) fn item(
+    connection: &Connection,
+    id: &str,
+    scope: &str,
+    key: &str,
+) -> anyhow::Result<Option<(String, bool)>> {
+    Ok(connection.query_row("SELECT version,dirty FROM retrieval_source_items WHERE index_id=?1 AND scope=?2 AND key=?3",params![id,scope,key],|r|Ok((r.get(0)?,r.get(1)?))).optional()?)
+}
+
+pub fn touch(
+    connection: &Connection,
+    id: &str,
+    scope: &str,
+    key: &str,
+    version: &str,
+    dirty: bool,
+) -> anyhow::Result<()> {
+    if id == "observations" { super::graph_browse::observation(connection,key)?; }
+    let previous = item(connection, id, scope, key)?;
+    let delta = i64::from(dirty) - i64::from(previous.as_ref().is_some_and(|(_, dirty)| *dirty));
+    connection.execute("INSERT INTO retrieval_source_items VALUES(?1,?2,?3,?4,?5) ON CONFLICT(index_id,scope,key) DO UPDATE SET version=excluded.version,dirty=excluded.dirty",params![id,scope,key,version,dirty])?;
+    connection.execute(
+        "UPDATE retrieval_source_meta SET dirty_count=dirty_count+?2 WHERE index_id=?1",
+        params![id, delta],
+    )?;
+    connection.execute("DELETE FROM retrieval_source_repairs WHERE index_id=?1 AND scope=?2 AND key=?3 AND version<>?4",params![id,scope,key,version])?;
+    super::scoped::source_changed(connection,id,scope,key,dirty)?;
+    Ok(())
+}
+
+pub fn remove(connection: &Connection, id: &str, scope: &str, key: &str) -> anyhow::Result<()> {
+    if id == "observations" { super::graph_browse::observation(connection,key)?; }
+    super::scoped::source_removed(connection,id,scope,key)?;
+    let previous = item(connection, id, scope, key)?;
+    connection.execute(
+        "DELETE FROM retrieval_source_items WHERE index_id=?1 AND scope=?2 AND key=?3",
+        params![id, scope, key],
+    )?;
+    connection.execute("DELETE FROM retrieval_source_repairs WHERE index_id=?1 AND scope=?2 AND key=?3",params![id,scope,key])?;
+    if previous.is_some_and(|(_, dirty)| dirty) {
+        connection.execute(
+            "UPDATE retrieval_source_meta SET dirty_count=dirty_count-1 WHERE index_id=?1",
+            [id],
+        )?;
+    }
+    let semantic_scope = format!("{}{id}", semantic::PREFIX);
+    if connection.query_row("SELECT EXISTS(SELECT 1 FROM state_values WHERE scope=?1 AND key=?2 AND live=1)",params![semantic_scope,key],|r|r.get::<_,bool>(0))?
+    {
+        database::write(connection, &semantic_scope, key, None)?;
+    }
+    Ok(())
+}
+
+pub fn validate(connection: &Connection, id: &str, key: &str, value: &Value) -> anyhow::Result<()> {
+    if kind(connection, id)?.is_none() {
+        return Ok(());
+    }
+    let scope = value["sourceScope"]
+        .as_str()
+        .ok_or_else(|| protocol::error("STATE_TX_INVALID_REQUEST"))?;
+    let version = value["sourceVersion"]
+        .as_str()
+        .ok_or_else(|| protocol::error("STATE_TX_INVALID_REQUEST"))?;
+    protocol::require(tracked_scope(scope))?;
+    protocol::counter(version)?;
+    let sql = format!(
+        "WITH source_row AS MATERIALIZED (SELECT scope,version,state_json(value,value_bytes) AS state_value FROM state_values WHERE scope=?1 AND key=?2) SELECT version,state_value IS NOT NULL,json_extract(state_value,'$.id'),{} FROM source_row",
+        eligibility::SQL
+    );
+    let source: Option<(String, bool, Option<String>, bool)> = connection
+        .query_row(&sql, params![scope, key], |r| {
+            Ok((r.get(0)?, r.get(1)?, r.get(2)?, r.get(3)?))
+        })
+        .optional()?;
+    if !source.is_some_and(|(current, present, source_id, eligible)| {
+        current == version && present && source_id.as_deref() == Some(key) && eligible
+    }) {
+        return Err(protocol::error("STATE_SEMANTIC_SOURCE_STALE"));
+    }
+    let conflict: bool=connection.query_row("SELECT EXISTS(SELECT 1 FROM retrieval_source_items WHERE index_id=?1 AND key=?2 AND scope<>?3)",params![id,key,scope],|r|r.get(0))?;
+    if conflict {
+        return Err(protocol::error("STATE_SEMANTIC_SOURCE_ID_CONFLICT"));
+    }
+    touch(connection, id, scope, key, version, false)?;
+    connection.execute("DELETE FROM retrieval_source_repairs WHERE index_id=?1 AND scope=?2 AND key=?3 AND version=?4",params![id,scope,key,version])?;
+    Ok(())
+}
+
+pub fn embedding_deleted(connection: &Connection, id: &str, key: &str) -> anyhow::Result<()> {
+    let mut statement = connection
+        .prepare("SELECT scope,version FROM retrieval_source_items WHERE index_id=?1 AND key=?2")?;
+    let rows = statement
+        .query_map(params![id, key], |r| {
+            Ok((r.get::<_, String>(0)?, r.get::<_, String>(1)?))
+        })?
+        .collect::<rusqlite::Result<Vec<_>>>()?;
+    for (scope, version) in rows {
+        touch(connection, id, &scope, key, &version, true)?;
+    }
+    Ok(())
+}
+
+pub fn prepare(
+    connection: &Connection,
+    id: &str,
+    max_rows: usize,
+    max_bytes: usize,
+) -> anyhow::Result<Value> {
+    source_prepare::prepare(connection, id, max_rows, max_bytes)
+}
+
+pub use super::source_lexical::lexical_text;
