--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/project_catalog/repair.rs
@@ -0,0 +1,150 @@
+use super::super::{database, protocol};
+use rusqlite::{Connection, OptionalExtension, params};
+use serde_json::{Value, json};
+
+const MAX_STORED_BYTES: i64 = super::super::super::codec::MAX_LOGICAL_VALUE_BYTES as i64;
+const MAX_LOGICAL_BYTES: i64 = super::super::super::codec::MAX_LOGICAL_VALUE_BYTES as i64;
+
+pub fn repair_unknown(
+    connection: &Connection,
+    source: &str,
+    key: &str,
+    expected_version: &str,
+    expected_revision: &str,
+    expected_epoch: i64,
+    expected_cursor: i64,
+) -> anyhow::Result<Value> {
+    let scope =
+        super::source_scope(source).ok_or_else(|| protocol::error("STATE_TX_INVALID_REQUEST"))?;
+    let (_, cursor, revision, epoch, _) = super::catalog_row(connection, source)?;
+    let current_revision = database::revision(connection, scope)?.to_string();
+    if revision != expected_revision
+        || current_revision != expected_revision
+        || epoch != expected_epoch
+        || cursor != expected_cursor
+    {
+        return Err(protocol::error("STATE_RETRIEVAL_STALE_CURSOR"));
+    }
+
+    let unknown_version: Option<String> = connection
+        .query_row(
+            "SELECT version FROM retrieval_project_unknown WHERE source=?1 AND epoch=?2 AND source_key=?3",
+            params![source, epoch, key],
+            |row| row.get(0),
+        )
+        .optional()?;
+    let Some(unknown_version) = unknown_version else {
+        return already_repaired(
+            connection,
+            source,
+            scope,
+            key,
+            expected_version,
+            &revision,
+            cursor,
+            epoch,
+        );
+    };
+    if unknown_version != expected_version {
+        return Err(protocol::error("STATE_RETRIEVAL_STALE_CURSOR"));
+    }
+
+    let row: Option<(String, i64, i64, i64)> = connection
+        .query_row(
+            "SELECT CAST(version AS TEXT),value_bytes,length(CAST(value AS BLOB)),position FROM state_rows WHERE scope=?1 AND key=?2 AND value IS NOT NULL",
+            params![scope, key],
+            |row| Ok((row.get(0)?, row.get(1)?, row.get(2)?, row.get(3)?)),
+        )
+        .optional()?;
+    let Some((current_version, logical_bytes, stored_bytes, position)) = row else {
+        return Err(protocol::error("STATE_RETRIEVAL_STALE_CURSOR"));
+    };
+    if current_version != expected_version {
+        return Err(protocol::error("STATE_RETRIEVAL_STALE_CURSOR"));
+    }
+    if !(1..=MAX_LOGICAL_BYTES).contains(&logical_bytes)
+        || !(1..=MAX_STORED_BYTES).contains(&stored_bytes)
+    {
+        return Err(protocol::error("STATE_RETRIEVAL_RESOURCE_LIMIT"));
+    }
+
+    let encoded: Option<Vec<u8>> = connection
+        .query_row(
+            "SELECT value FROM state_rows WHERE scope=?1 AND key=?2 AND version=?3 AND value IS NOT NULL AND value_bytes=?4 AND length(CAST(value AS BLOB))=?5 AND value_bytes BETWEEN 1 AND ?6 AND length(CAST(value AS BLOB)) BETWEEN 1 AND ?7",
+            params![
+                scope,
+                key,
+                expected_version,
+                logical_bytes,
+                stored_bytes,
+                MAX_LOGICAL_BYTES,
+                MAX_STORED_BYTES,
+            ],
+            |row| Ok(row.get_ref(0)?.as_bytes()?.to_vec()),
+        )
+        .optional()?;
+    let Some(encoded) = encoded else {
+        return Err(protocol::error("STATE_RETRIEVAL_STALE_CURSOR"));
+    };
+    let raw = database::decode_value(&encoded, logical_bytes)
+        .map_err(|_| protocol::error("STATE_TX_INVALID_REQUEST"))?;
+    let value: Value =
+        serde_json::from_str(&raw).map_err(|_| protocol::error("STATE_TX_INVALID_REQUEST"))?;
+    let (session, project) = match super::authority_fields(source,key,&value)
+        .map_err(|_| protocol::error("STATE_TX_INVALID_REQUEST"))? {
+        super::extraction::Authority::Project(session,project) => (session,Some(project)),
+        super::extraction::Authority::Excluded(_) => (key.to_owned(),None),
+    };
+    super::extraction::project(connection,source,epoch,key,&value,expected_version,position)?;
+    let (status, _, _, _, incomplete) = super::catalog_row(connection, source)?;
+    Ok(json!({
+        "status": status,
+        "repaired": true,
+        "source": source,
+        "key": key,
+        "version": expected_version,
+        "session_id": session,
+        "project": project,
+        "revision": revision,
+        "epoch": epoch.to_string(),
+        "catalog_cursor": cursor.to_string(),
+        "incomplete_rows": incomplete.to_string(),
+    }))
+}
+
+fn already_repaired(
+    connection: &Connection,
+    source: &str,
+    scope: &str,
+    key: &str,
+    expected_version: &str,
+    revision: &str,
+    cursor: i64,
+    epoch: i64,
+) -> anyhow::Result<Value> {
+    let projected: Option<(Option<String>, Option<String>)> = connection
+        .query_row(
+            "SELECT r.project,NULL FROM retrieval_project_refs r JOIN state_rows s ON s.scope=?5 AND s.key=r.source_key AND CAST(s.version AS TEXT)=?4 AND s.value IS NOT NULL WHERE r.source=?1 AND r.epoch=?2 AND r.source_key=?3 AND r.version=?4 UNION ALL SELECT NULL,x.reason FROM retrieval_project_exclusions x JOIN state_rows s ON s.scope=?5 AND s.key=x.source_key AND CAST(s.version AS TEXT)=?4 AND s.value IS NOT NULL WHERE x.source=?1 AND x.epoch=?2 AND x.source_key=?3 AND x.version=?4",
+            params![source, epoch, key, expected_version, scope],
+            |row| Ok((row.get(0)?,row.get(1)?)),
+        )
+        .optional()?;
+    let Some((project, exclusion)) = projected else {
+        return Err(protocol::error("STATE_RETRIEVAL_STALE_CURSOR"));
+    };
+    let (_, _, _, _, incomplete) = super::catalog_row(connection, source)?;
+    Ok(json!({
+        "status": "already_repaired",
+        "repaired": false,
+        "source": source,
+        "key": key,
+        "version": expected_version,
+        "project": project,
+        "exclusion": exclusion,
+        "revision": revision,
+        "epoch": epoch.to_string(),
+        "catalog_cursor": cursor.to_string(),
+        "incomplete_rows": incomplete.to_string(),
+        "replayed": true,
+    }))
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/project_catalog/session_page.rs b/engine/src/workers/state/adapters/sqlite/retrieval/project_catalog/session_page.rs
new file mode 100644
index 0000000..dad0105
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/project_catalog/session_page.rs
@@ -0,0 +1,265 @@
+use super::super::{database, protocol};
+use rusqlite::{Connection, params};
+use serde::{Deserialize, Serialize};
+use serde_json::{Value, json};
+
+const MAX_CURSOR_BYTES: usize = 4096;
+
+#[derive(Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+struct Cursor {
+    version: u8,
+    project: String,
+    revision: String,
+    epoch: i64,
+    catalog_cursor: i64,
+    last_session: String,
+    last_source_key: String,
+}
+
+struct Candidate {
+    session_id: String,
+    source_key: String,
+    row_version: String,
+    current_version: Option<String>,
+    session_json: Option<String>,
+}
+
+pub fn page(
+    connection: &Connection,
+    project: &str,
+    cursor: Option<&str>,
+    limit: usize,
+    max_bytes: usize,
+) -> anyhow::Result<Value> {
+    protocol::require(!project.trim().is_empty() && project.len() <= 256)?;
+    protocol::require((1..=16).contains(&limit) && (1024..=65_536).contains(&max_bytes))?;
+
+    let (catalog_status, catalog_cursor, revision, epoch, incomplete_rows) =
+        super::catalog_row(connection, "sessions")?;
+    let current_revision_value = database::revision(connection, "mem:sessions")?;
+    let current_revision = current_revision_value.to_string();
+    let ready = catalog_status == "ready"
+        && incomplete_rows == 0
+        && revision == current_revision;
+    let snapshot = Cursor {
+        version: 1,
+        project: project.to_owned(),
+        revision: revision.clone(),
+        epoch,
+        catalog_cursor,
+        last_session: String::new(),
+        last_source_key: String::new(),
+    };
+
+    let after = match cursor {
+        Some(value) => {
+            protocol::require(!value.is_empty() && value.len() <= MAX_CURSOR_BYTES)?;
+            let saved: Cursor = serde_json::from_str(value)
+                .map_err(|_| protocol::error("STATE_TX_INVALID_REQUEST"))?;
+            if !ready || !snapshot_matches(&snapshot, &saved) {
+                return Err(protocol::error("STATE_RETRIEVAL_STALE_CURSOR"));
+            }
+            (saved.last_session, saved.last_source_key)
+        }
+        None => (String::new(), String::new()),
+    };
+
+    if !ready {
+        let partial = catalog_status == "partial" || incomplete_rows > 0;
+        return Ok(response(
+            if partial { "partial" } else { "not_ready" },
+            true,
+            Vec::new(),
+            None,
+            current_revision_value,
+            epoch,
+        ));
+    }
+
+    let candidates = read_candidates(connection, project, epoch, &after.0, &after.1, limit)?;
+    let source_has_more = candidates.len() > limit;
+    let mut items = Vec::with_capacity(limit.min(candidates.len()));
+    let mut last_scanned: Option<(String, String)> = None;
+    let mut source_partial = false;
+    let mut byte_limited = false;
+
+    for (index, candidate) in candidates.iter().take(limit).enumerate() {
+        let previous_scanned = last_scanned.clone();
+        last_scanned = Some((candidate.session_id.clone(), candidate.source_key.clone()));
+        let Some(session) = projected_session(candidate, project) else {
+            source_partial = true;
+            continue;
+        };
+        let item = json!({
+            "session_id": candidate.session_id,
+            "source_key": candidate.source_key,
+            "row_version": candidate.row_version,
+            "session": session,
+        });
+        let mut proposed = items.clone();
+        proposed.push(item);
+        let has_more = source_has_more || index + 1 < limit.min(candidates.len());
+        let next_cursor = if has_more {
+            last_scanned
+                .as_ref()
+                .map(|(session, source_key)| encode_cursor(&snapshot, session, source_key))
+                .transpose()?
+        } else {
+            None
+        };
+        let proposed_response = response(
+            if has_more || source_partial { "partial" } else { "ready" },
+            has_more || source_partial,
+            proposed,
+            next_cursor,
+            current_revision_value,
+            epoch,
+        );
+        if protocol::size(&proposed_response)? > max_bytes {
+            last_scanned = previous_scanned;
+            if items.is_empty() {
+                return Err(super::super::request::resource());
+            }
+            byte_limited = true;
+            break;
+        }
+        items = proposed_response["items"]
+            .as_array()
+            .ok_or_else(|| protocol::error("STATE_TX_INVALID_RESPONSE"))?
+            .clone();
+    }
+
+    let has_more = source_has_more || byte_limited;
+    let next_cursor = if has_more {
+        last_scanned
+            .as_ref()
+            .map(|(session, source_key)| encode_cursor(&snapshot, session, source_key))
+            .transpose()?
+    } else {
+        None
+    };
+    let partial = has_more || source_partial;
+    let result = response(
+        if partial { "partial" } else { "ready" },
+        partial,
+        items,
+        next_cursor,
+        current_revision_value,
+        epoch,
+    );
+    if protocol::size(&result)? > max_bytes {
+        return Err(super::super::request::resource());
+    }
+    Ok(result)
+}
+
+fn read_candidates(
+    connection: &Connection,
+    project: &str,
+    epoch: i64,
+    after_session: &str,
+    after_source_key: &str,
+    limit: usize,
+) -> anyhow::Result<Vec<Candidate>> {
+    let mut statement = connection.prepare(
+        "SELECT r.session_id,r.source_key,r.version,s.version,
+            CASE WHEN s.value_bytes BETWEEN 1 AND 65536
+                AND CASE typeof(s.value) WHEN 'blob' THEN length(s.value) WHEN 'text' THEN length(s.value)*4 ELSE 0 END BETWEEN 1 AND 65536
+                AND (CASE WHEN s.value_bytes BETWEEN 1 AND 65536
+                    AND CASE typeof(s.value) WHEN 'blob' THEN length(s.value) WHEN 'text' THEN length(s.value)*4 ELSE 0 END BETWEEN 1 AND 65536
+                    THEN state_project(s.value,s.value_bytes,NULL) END)=?2
+                THEN state_json(s.value,s.value_bytes) END
+         FROM retrieval_project_refs r INDEXED BY retrieval_project_refs_project
+         LEFT JOIN state_rows s ON s.scope='mem:sessions' AND s.key=r.session_id
+         WHERE r.source='sessions' AND r.epoch=?1 AND r.project=?2
+            AND r.source_key=r.session_id
+            AND (r.session_id,r.source_key)>(?3,?4)
+         ORDER BY r.session_id,r.source_key LIMIT ?5",
+    )?;
+    let rows = statement.query_map(
+        params![epoch, project, after_session, after_source_key, (limit + 1) as i64],
+        |row| {
+            Ok(Candidate {
+                session_id: row.get(0)?,
+                source_key: row.get(1)?,
+                row_version: row.get(2)?,
+                current_version: row.get(3)?,
+                session_json: row.get(4)?,
+            })
+        },
+    )?;
+    rows.collect::<rusqlite::Result<Vec<_>>>().map_err(Into::into)
+}
+
+fn projected_session(candidate: &Candidate, project: &str) -> Option<Value> {
+    if candidate.current_version.as_deref() != Some(candidate.row_version.as_str()) {
+        return None;
+    }
+    protocol::counter(&candidate.row_version).ok()?;
+    let value: Value = serde_json::from_str(candidate.session_json.as_deref()?).ok()?;
+    if value.get("id").and_then(Value::as_str) != Some(candidate.session_id.as_str())
+        || value.get("project").and_then(Value::as_str) != Some(project)
+        || !value.is_object()
+    {
+        return None;
+    }
+    let mut session = json!({"id":candidate.session_id,"project":project});
+    for field in ["agentId", "startedAt", "endedAt", "status"] {
+        if let Some(value) = value.get(field).and_then(Value::as_str)
+            && !value.is_empty()
+            && value.len() <= 256
+            && (field != "status" || ["active", "completed", "abandoned"].contains(&value))
+        {
+            session[field] = json!(value);
+        }
+    }
+    if let Some(count) = value.get("observationCount").and_then(Value::as_u64) {
+        session["observationCount"] = json!(count);
+    }
+    Some(session)
+}
+
+fn snapshot_matches(snapshot: &Cursor, cursor: &Cursor) -> bool {
+    cursor.version == snapshot.version
+        && cursor.project == snapshot.project
+        && cursor.revision == snapshot.revision
+        && cursor.epoch == snapshot.epoch
+        && cursor.catalog_cursor == snapshot.catalog_cursor
+        && !cursor.last_session.is_empty()
+        && cursor.last_session == cursor.last_source_key
+}
+
+fn encode_cursor(snapshot: &Cursor, last_session: &str, last_source_key: &str) -> anyhow::Result<String> {
+    let cursor = Cursor {
+        version: snapshot.version,
+        project: snapshot.project.clone(),
+        revision: snapshot.revision.clone(),
+        epoch: snapshot.epoch,
+        catalog_cursor: snapshot.catalog_cursor,
+        last_session: last_session.to_owned(),
+        last_source_key: last_source_key.to_owned(),
+    };
+    protocol::require(last_session == last_source_key)?;
+    let encoded = serde_json::to_string(&cursor)?;
+    protocol::require(encoded.len() <= MAX_CURSOR_BYTES)?;
+    Ok(encoded)
+}
+
+fn response(
+    status: &str,
+    partial: bool,
+    items: Vec<Value>,
+    next_cursor: Option<String>,
+    revision: u64,
+    epoch: i64,
+) -> Value {
+    json!({
+        "status": status,
+        "partial": partial,
+        "items": items,
+        "next_cursor": next_cursor,
+        "revision": revision,
+        "epoch": epoch,
+    })
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/project_vectors.rs b/engine/src/workers/state/adapters/sqlite/retrieval/project_vectors.rs
new file mode 100644
index 0000000..195689e
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/project_vectors.rs
@@ -0,0 +1,140 @@
+use super::super::{database, protocol};
+use super::{request, semantic};
+use rusqlite::{Connection, OptionalExtension, params};
+use serde_json::{Value, json};
+
+
+pub fn schema(connection: &Connection) -> anyhow::Result<()> {
+    connection.execute_batch("CREATE TABLE IF NOT EXISTS retrieval_project_vectors(index_id TEXT NOT NULL,epoch INTEGER NOT NULL,id TEXT NOT NULL,session_id TEXT NOT NULL,PRIMARY KEY(index_id,epoch,id)) WITHOUT ROWID;
+        CREATE INDEX IF NOT EXISTS retrieval_project_vectors_session ON retrieval_project_vectors(session_id,index_id,epoch,id);
+        CREATE TABLE IF NOT EXISTS retrieval_project_vector_meta(index_id TEXT PRIMARY KEY,epoch INTEGER NOT NULL,status TEXT NOT NULL,cursor TEXT NOT NULL,revision TEXT NOT NULL) WITHOUT ROWID;")?;
+    let mut statement = connection.prepare("SELECT index_id,epoch,revision FROM retrieval_semantic_meta ORDER BY index_id")?;
+    let rows = statement.query_map([], |row| Ok((row.get::<_,String>(0)?,row.get::<_,i64>(1)?,row.get::<_,String>(2)?)))?;
+    for row in rows {
+        let (index, epoch, revision) = row?;
+        ensure(connection, &index, epoch, &revision)?;
+    }
+    Ok(())
+}
+
+fn exists(connection: &Connection, index: &str, epoch: i64) -> anyhow::Result<bool> {
+    connection.query_row("SELECT EXISTS(SELECT 1 FROM retrieval_vectors WHERE index_id=?1 AND epoch=?2 LIMIT 1)",params![index,epoch],|row|row.get(0)).map_err(Into::into)
+}
+
+fn ensure(connection: &Connection, index: &str, epoch: i64, revision: &str) -> anyhow::Result<()> {
+    let saved: Option<(i64,String,String)> = connection.query_row(
+        "SELECT epoch,status,revision FROM retrieval_project_vector_meta WHERE index_id=?1",[index],
+        |row|Ok((row.get(0)?,row.get(1)?,row.get(2)?))).optional()?;
+    match saved {
+        None => {
+            connection.execute("INSERT INTO retrieval_project_vector_meta VALUES(?1,?2,?3,'',?4)",params![index,epoch,if exists(connection,index,epoch)?{"pending"}else{"ready"},revision])?;
+        }
+        Some((saved_epoch,status,saved_revision)) if saved_epoch != epoch || saved_revision != revision => {
+            let empty = !exists(connection,index,epoch)?;
+            connection.execute("UPDATE retrieval_project_vector_meta SET epoch=?2,status=?3,cursor='',revision=?4 WHERE index_id=?1",params![index,epoch,if empty{"ready"}else{"pending"},revision])?;
+            if status == "ready" && empty { connection.execute("DELETE FROM retrieval_project_vectors WHERE index_id=?1 AND epoch<>?2",params![index,epoch])?; }
+        }
+        _ => {}
+    }
+    Ok(())
+}
+
+pub fn ensure_index(connection: &Connection, index: &str, epoch: i64, revision: &str) -> anyhow::Result<()> {
+    ensure(connection,index,epoch,revision)
+}
+
+pub fn replace(connection: &Connection, index: &str, epoch: i64, id: &str, session: Option<&str>) -> anyhow::Result<()> {
+    if let Some(session) = session {
+        connection.execute("INSERT INTO retrieval_project_vectors VALUES(?1,?2,?3,?4) ON CONFLICT(index_id,epoch,id) DO UPDATE SET session_id=excluded.session_id",params![index,epoch,id,session])?;
+    } else {
+        connection.execute("DELETE FROM retrieval_project_vectors WHERE index_id=?1 AND epoch=?2 AND id=?3",params![index,epoch,id])?;
+    }
+    Ok(())
+}
+
+pub fn mark_revision(connection: &Connection, index: &str, epoch: i64, revision: &str) -> anyhow::Result<()> {
+    let saved: Option<i64> = connection.query_row("SELECT epoch FROM retrieval_project_vector_meta WHERE index_id=?1",[index],|row|row.get(0)).optional()?;
+    if saved.is_none() || saved != Some(epoch) {
+        ensure(connection,index,epoch,revision)?;
+    } else {
+        connection.execute("UPDATE retrieval_project_vector_meta SET revision=?2 WHERE index_id=?1 AND epoch=?3",params![index,revision,epoch])?;
+    }
+    Ok(())
+}
+
+pub fn prepare(connection: &Connection, index: &str, max_rows: usize, max_bytes: usize) -> anyhow::Result<Value> {
+    protocol::require((1..=1024).contains(&max_rows) && (1024..=request::MAX_GRAPH_PREPARATION_WORK_BYTES).contains(&max_bytes))?;
+    let meta = semantic::get(connection,index)?;
+    let scope = meta.scope();
+    let revision = database::revision(connection,&scope)?.to_string();
+    ensure(connection,index,meta.epoch,&revision)?;
+    if meta.status != "ready" || meta.revision != revision {
+        return Ok(json!({"status":"partial","reason":"source_index_not_ready","index_id":index,"cursor":"","revision":revision,"processed":0,"has_more":true}));
+    }
+    let (mut epoch,mut status,mut cursor,mut saved_revision):(i64,String,String,String)=connection.query_row(
+        "SELECT epoch,status,cursor,revision FROM retrieval_project_vector_meta WHERE index_id=?1",[index],
+        |row|Ok((row.get(0)?,row.get(1)?,row.get(2)?,row.get(3)?)))?;
+    if epoch != meta.epoch || saved_revision != revision {
+        ensure(connection,index,meta.epoch,&revision)?;
+        (epoch,status,cursor,saved_revision)=connection.query_row("SELECT epoch,status,cursor,revision FROM retrieval_project_vector_meta WHERE index_id=?1",[index],|row|Ok((row.get(0)?,row.get(1)?,row.get(2)?,row.get(3)?)))?;
+    }
+    if status == "ready" {
+        return Ok(json!({"status":"ready","index_id":index,"cursor":cursor,"revision":saved_revision,"processed":0,"has_more":false}));
+    }
+    let mut statement=connection.prepare("SELECT id,session_id FROM retrieval_vectors WHERE index_id=?1 AND epoch=?2 AND id>?3 ORDER BY id LIMIT ?4")?;
+    let mut rows=statement.query(params![index,epoch,cursor,(max_rows+1) as i64])?;
+    let mut processed=0usize;
+    let mut bytes=0usize;
+    let mut more=false;
+    while let Some(row)=rows.next()? {
+        if processed==max_rows { more=true; break; }
+        let id:String=row.get(0)?;
+        let session:String=row.get(1)?;
+        let row_bytes=id.len().saturating_add(session.len());
+        if bytes.saturating_add(row_bytes)>max_bytes { if processed==0{return Err(request::resource());} more=true;break; }
+        request::identifier(&id)?; request::identifier(&session)?;
+        replace(connection,index,epoch,&id,Some(&session))?;
+        cursor=id;
+        bytes+=row_bytes;
+        processed+=1;
+    }
+    status=if more {"pending".into()} else {"ready".into()};
+    connection.execute("UPDATE retrieval_project_vector_meta SET status=?3,cursor=?4,revision=?5 WHERE index_id=?1 AND epoch=?2",params![index,epoch,status,cursor,revision])?;
+    Ok(json!({"status":status,"index_id":index,"cursor":cursor,"revision":revision,"processed":processed,"has_more":more}))
+}
+
+pub fn ready(connection: &Connection, index: &str, epoch: i64) -> anyhow::Result<bool> {
+    let status: Option<(String,String)> = connection.query_row("SELECT status,revision FROM retrieval_project_vector_meta WHERE index_id=?1 AND epoch=?2",params![index,epoch],|row|Ok((row.get(0)?,row.get(1)?))).optional()?;
+    let Some((status,revision))=status else{return Ok(false)};
+    let meta=semantic::get(connection,index)?;
+    Ok(status=="ready" && meta.epoch==epoch && meta.status=="ready" && revision==meta.revision && revision==database::revision(connection,&meta.scope())?.to_string())
+}
+
+pub fn status(connection: &Connection) -> anyhow::Result<Value> {
+    let mut output=Vec::new();
+    let mut statement=connection.prepare("SELECT index_id,epoch,status,cursor,revision FROM retrieval_project_vector_meta ORDER BY index_id")?;
+    let mut rows=statement.query([])?;
+    while let Some(row)=rows.next()? {
+        let index:String=row.get(0)?; let epoch:i64=row.get(1)?; let saved:String=row.get(2)?; let cursor:String=row.get(3)?; let revision:String=row.get(4)?;
+        let ready=ready(connection,&index,epoch)?;
+        output.push(json!({"index_id":index,"status":if ready{"ready"}else if saved=="ready"{"pending"}else{saved.as_str()},"cursor":cursor,"revision":revision,"coverage_epoch":epoch.to_string(),"ready":ready}));
+    }
+    Ok(Value::Array(output))
+}
+
+#[cfg(test)]
+mod readiness_tests {
+    use super::*;
+    #[test]
+    fn status_rejects_saved_ready_from_stale_epoch_or_revision() {
+        let c=database::open(std::path::Path::new(":memory:")).unwrap();
+        semantic::configure(&c,"fixture","fixture-model",2,"1",None).unwrap();
+        assert_eq!(status(&c).unwrap()[0]["ready"],true);
+        c.execute("UPDATE retrieval_project_vector_meta SET epoch=0 WHERE index_id='fixture'",[]).unwrap();
+        let stale=status(&c).unwrap();
+        assert_eq!(stale[0]["ready"],false);
+        assert_eq!(stale[0]["status"],"pending");
+        c.execute("UPDATE retrieval_project_vector_meta SET epoch=1,revision='9' WHERE index_id='fixture'",[]).unwrap();
+        assert_eq!(status(&c).unwrap()[0]["status"],"pending");
+    }
+}
