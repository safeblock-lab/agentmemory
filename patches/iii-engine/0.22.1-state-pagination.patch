+CREATE VIEW compact_forward_members AS SELECT list_id,identifier FROM compact_list_members;
+CREATE TRIGGER compact_forward_view_insert INSTEAD OF INSERT ON compact_list_members WHEN NOT EXISTS(SELECT 1 FROM compact_forward_blocks b CROSS JOIN json_each(state_forward_ids(b.payload)) j WHERE b.list_id=NEW.list_id AND b.edge=(SELECT max(edge) FROM compact_forward_blocks WHERE list_id=NEW.list_id AND edge<=NEW.identifier) AND CAST(j.value AS INTEGER)=NEW.identifier) BEGIN
+
+        INSERT INTO compact_forward_blocks(list_id,edge,payload) VALUES(NEW.list_id,coalesce((SELECT max(edge) FROM compact_forward_blocks WHERE list_id=NEW.list_id AND edge<=NEW.identifier),0),state_forward_edit((SELECT payload FROM compact_forward_blocks WHERE list_id=NEW.list_id AND edge<=NEW.identifier ORDER BY edge DESC LIMIT 1),NEW.identifier,0)) ON CONFLICT(list_id,edge) DO UPDATE SET payload=excluded.payload;
+        UPDATE compact_forward_config SET revision=revision+1 WHERE singleton=1;
+
+        INSERT INTO compact_inverse_blocks(identifier,edge,payload) VALUES(NEW.identifier,coalesce((SELECT max(edge) FROM compact_inverse_blocks WHERE identifier=NEW.identifier AND edge<=NEW.list_id),0),state_inverse_edit((SELECT payload FROM compact_inverse_blocks WHERE identifier=NEW.identifier AND edge<=NEW.list_id ORDER BY edge DESC LIMIT 1),NEW.list_id,0)) ON CONFLICT(identifier,edge) DO UPDATE SET payload=excluded.payload;
+        UPDATE compact_inverse_config SET revision=revision+1 WHERE singleton=1;
+END;
+CREATE TRIGGER compact_forward_view_update INSTEAD OF UPDATE OF list_id,identifier ON compact_list_members BEGIN
+SELECT CASE WHEN (NEW.list_id<>OLD.list_id OR NEW.identifier<>OLD.identifier) AND EXISTS(SELECT 1 FROM compact_forward_blocks b CROSS JOIN json_each(state_forward_ids(b.payload)) j WHERE b.list_id=NEW.list_id AND CAST(j.value AS INTEGER)=NEW.identifier) THEN RAISE(ABORT,'STATE_FORWARD_PAIR_CONFLICT') END;
+
+        UPDATE compact_forward_blocks SET payload=state_forward_edit(payload,OLD.identifier,1) WHERE list_id=OLD.list_id AND edge=(SELECT max(edge) FROM compact_forward_blocks WHERE list_id=OLD.list_id AND edge<=OLD.identifier);
+        INSERT INTO compact_forward_blocks(list_id,edge,payload) VALUES(NEW.list_id,coalesce((SELECT max(edge) FROM compact_forward_blocks WHERE list_id=NEW.list_id AND edge<=NEW.identifier),0),state_forward_edit((SELECT payload FROM compact_forward_blocks WHERE list_id=NEW.list_id AND edge<=NEW.identifier ORDER BY edge DESC LIMIT 1),NEW.identifier,0)) ON CONFLICT(list_id,edge) DO UPDATE SET payload=excluded.payload;
+        UPDATE compact_forward_config SET revision=revision+1 WHERE singleton=1;
+
+        UPDATE compact_inverse_blocks SET payload=state_inverse_edit(payload,OLD.list_id,1) WHERE identifier=OLD.identifier AND edge=(SELECT max(edge) FROM compact_inverse_blocks WHERE identifier=OLD.identifier AND edge<=OLD.list_id);
+        INSERT INTO compact_inverse_blocks(identifier,edge,payload) VALUES(NEW.identifier,coalesce((SELECT max(edge) FROM compact_inverse_blocks WHERE identifier=NEW.identifier AND edge<=NEW.list_id),0),state_inverse_edit((SELECT payload FROM compact_inverse_blocks WHERE identifier=NEW.identifier AND edge<=NEW.list_id ORDER BY edge DESC LIMIT 1),NEW.list_id,0)) ON CONFLICT(identifier,edge) DO UPDATE SET payload=excluded.payload;
+        UPDATE compact_inverse_config SET revision=revision+1 WHERE singleton=1;
+END;
+CREATE TRIGGER compact_forward_view_delete INSTEAD OF DELETE ON compact_list_members BEGIN
+
+        UPDATE compact_forward_blocks SET payload=state_forward_edit(payload,OLD.identifier,1) WHERE list_id=OLD.list_id AND edge=(SELECT max(edge) FROM compact_forward_blocks WHERE list_id=OLD.list_id AND edge<=OLD.identifier);
+        UPDATE compact_forward_config SET revision=revision+1 WHERE singleton=1;
+
+        UPDATE compact_inverse_blocks SET payload=state_inverse_edit(payload,OLD.list_id,1) WHERE identifier=OLD.identifier AND edge=(SELECT max(edge) FROM compact_inverse_blocks WHERE identifier=OLD.identifier AND edge<=OLD.list_id);
+        UPDATE compact_inverse_config SET revision=revision+1 WHERE singleton=1;
+END;
