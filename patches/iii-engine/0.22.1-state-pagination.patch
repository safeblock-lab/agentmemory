new file mode 100644
index 0000000..a330dac
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/storage.rs
@@ -0,0 +1,61 @@
+use super::{observation, protocol::{error, require}, storage_diagnostics, storage_graph_metadata, storage_operations, storage_prune, storage_reclaim, storage_maintenance_lease};
+use rusqlite::Connection;
+use serde::Deserialize;
+use serde_json::Value;
+use std::{path::Path, time::{Duration, Instant}};
+
+#[derive(Deserialize)]
+#[serde(tag = "action", rename_all = "snake_case", deny_unknown_fields)]
+pub enum Request {
+    Physical,
+    MigrateIncremental { allow_blocking: bool, max_ms: u64 },
+    Diagnostics { cursor: Option<storage_diagnostics::Cursor>, limit: usize, max_bytes: u64, max_ms: u64 },
+    GraphMetadata,
+    GraphMetadataPrepare { limit: usize, max_bytes: u64, max_ms: u64 },
+    PruneTechnical { candidates: Vec<storage_prune::Candidate>, max_bytes: u64, max_ms: u64 },
+    PruneOperations { expected_version: String, max_ms: u64 },
+    MaintenanceLeaseAcquire { owner_id: String, lease_ms: u64 },
+    MaintenanceLeaseRefresh { owner_id: String, fence: u64, lease_ms: u64 },
+    MaintenanceLeaseRelease { owner_id: String, fence: u64 },
+    MaintenanceStateSave { owner_id: String, fence: u64, value: Value, release: bool },
+    Reclaim { #[serde(default = "default_pages")] max_pages: u32, #[serde(default = "default_ms")] max_ms: u64, #[serde(default = "default_checkpoint")] checkpoint: String, lease_owner_id: String, lease_fence: u64 },
+    ObservationIndex { session_id: String, observation_id: String, identity_digest: String, canonical_identity: String, expected_version: String },
+}
+fn default_pages() -> u32 { 1 }
+fn default_ms() -> u64 { 25 }
+fn default_checkpoint() -> String { "passive".into() }
+impl Request {
+    pub fn maintenance_lease(&self) -> bool { matches!(self, Self::MaintenanceLeaseAcquire { .. } | Self::MaintenanceLeaseRefresh { .. } | Self::MaintenanceLeaseRelease { .. } | Self::MaintenanceStateSave { .. }) }
+    pub fn read_only(&self) -> bool { matches!(self, Self::Diagnostics { .. } | Self::GraphMetadata | Self::Physical) }
+    pub fn reclamation(&self) -> bool { matches!(self, Self::Reclaim { .. } | Self::MigrateIncremental { .. }) }
+}
+pub fn bounded<T>(connection: &Connection, max_ms: u64, job: impl FnOnce() -> anyhow::Result<T>) -> anyhow::Result<T> {
+    require((1..=3000).contains(&max_ms))?;
+    let started = Instant::now();
+    let duration = Duration::from_millis(max_ms);
+    connection.progress_handler(1000, Some(move || started.elapsed() >= duration))?;
+    let result = job();
+    connection.progress_handler(0, None::<fn() -> bool>)?;
+    if started.elapsed() >= duration || result.as_ref().err().is_some_and(|cause| {
+        cause.downcast_ref::<rusqlite::Error>().is_some_and(|cause| matches!(cause,
+            rusqlite::Error::SqliteFailure(code, _) if code.code == rusqlite::ErrorCode::OperationInterrupted))
+    }) { return Err(error("STATE_TX_LIMIT_EXCEEDED")); }
+    result
+}
+pub fn execute(connection: &Connection, path: &Path, request: Request) -> anyhow::Result<Value> {
+    match request {
+        Request::MaintenanceLeaseAcquire {owner_id, lease_ms} => storage_maintenance_lease::acquire(connection, &owner_id, lease_ms),
+        Request::MaintenanceLeaseRefresh {owner_id, fence, lease_ms} => storage_maintenance_lease::refresh(connection, &owner_id, fence, lease_ms),
+        Request::MaintenanceLeaseRelease {owner_id, fence} => storage_maintenance_lease::release(connection, &owner_id, fence),
+        Request::MaintenanceStateSave {owner_id, fence, value, release} => storage_maintenance_lease::save_state(connection, &owner_id, fence, value, release),
+        Request::Diagnostics {cursor, limit, max_bytes, max_ms} => bounded(connection, max_ms, || storage_diagnostics::page(connection, path, cursor, limit, max_bytes)),
+        Request::GraphMetadata => bounded(connection, 1000, || storage_graph_metadata::read(connection)),
+        Request::GraphMetadataPrepare {limit, max_bytes, max_ms} => bounded(connection, max_ms, || storage_graph_metadata::prepare(connection, limit, max_bytes)),
+        Request::PruneTechnical {candidates, max_bytes, max_ms} => bounded(connection, max_ms, || storage_prune::prune(connection, candidates, max_bytes)),
+        Request::PruneOperations {expected_version, max_ms} => bounded(connection, max_ms, || storage_operations::prune(connection, &expected_version)),
+        Request::ObservationIndex {session_id,observation_id,identity_digest,canonical_identity,expected_version} => bounded(connection, 3000, || observation::index(connection, observation::Index {session_id,observation_id,identity_digest,canonical_identity,expected_version})),
+        Request::Physical => storage_reclaim::physical(connection, path),
+        Request::MigrateIncremental {allow_blocking, max_ms} => storage_reclaim::migrate(connection, path, allow_blocking, max_ms),
+        Request::Reclaim {..} => Err(error("STATE_TX_INVALID_REQUEST")),
+    }
+}
diff --git a/engine/src/workers/state/adapters/sqlite/storage_diagnostics.rs b/engine/src/workers/state/adapters/sqlite/storage_diagnostics.rs
new file mode 100644
index 0000000..08c8e04
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/storage_diagnostics.rs
@@ -0,0 +1,77 @@
+use super::protocol::require;
+use rusqlite::{Connection, params};
+use serde::{Deserialize, Serialize};
+use serde_json::{Value, json};
+use std::{collections::BTreeMap, path::{Path, PathBuf}};
+
+#[derive(Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct Cursor { pub scope: String, pub key: String }
+fn file_bytes(path: &Path) -> anyhow::Result<u64> {
+    match std::fs::metadata(path) {
+        Ok(metadata) => Ok(metadata.len()),
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => Ok(0),
+        Err(error) => Err(error.into()),
+    }
+}
+pub fn physical(connection: &Connection, path: &Path) -> anyhow::Result<Value> {
+    let page_size: i64 = connection.pragma_query_value(None, "page_size", |row| row.get(0))?;
+    let page_count: i64 = connection.pragma_query_value(None, "page_count", |row| row.get(0))?;
+    let free: i64 = connection.pragma_query_value(None, "freelist_count", |row| row.get(0))?;
+    let auto: i64 = connection.pragma_query_value(None, "auto_vacuum", |row| row.get(0))?;
+    let journal: String = connection.pragma_query_value(None, "journal_mode", |row| row.get(0))?;
+    Ok(json!({"page_size":page_size,"page_count":page_count,"freelist_count":free,
+        "reusable_bytes":free.saturating_mul(page_size),"allocated_page_bytes":page_count.saturating_mul(page_size),
+        "auto_vacuum":auto,"journal_mode":journal,"database_bytes":file_bytes(path)?,
+        "wal_bytes":file_bytes(&PathBuf::from(format!("{}-wal",path.display())))?}))
+}
+fn category(scope: &str) -> &'static str {
+    if scope.starts_with("mem:obs-identity:") || scope.starts_with("mem:obs-events:") { "observation_identity" }
+    else if scope.starts_with("mem:obs:") { "observations" }
+    else if scope.starts_with("mem:emb:") || scope.starts_with("mem:latent:") || scope.starts_with("mem:image-embeddings") { "embeddings" }
+    else if scope.starts_with("mem:semantic") || scope.starts_with("mem:index:") { "search_state" }
+    else if ["mem:graph:nodes","mem:graph:edges","mem:graph:snapshot","mem:graph:name-index","mem:graph:edge-key","mem:graph:node-degree","mem:graph:edge-history"].contains(&scope) { "durable_graph" }
+    else if scope.starts_with("mem:graph:") { "graph_technical" }
+    else if scope == "mem:audit" { "audit" }
+    else if scope == "mem:recent-operations" { "operations" }
+    else if scope.starts_with("mem:summary-queue:") { "summary_queue" }
+    else if scope.starts_with("mem:fireworks-batch:") || scope == "mem:batch-callbacks" { "provider_queue" }
+    else if ["mem:metrics","mem:health","mem:access","mem:recent-searches","mem:routine-runs","mem:signals"].contains(&scope) { "technical_history" }
+    else if ["mem:memories","mem:summaries","mem:lessons","mem:insights","mem:decisions","mem:procedural","mem:profiles","mem:crystals"].contains(&scope) { "useful_memory" }
+    else if scope == "mem:sessions" { "sessions" }
+    else { "other_state" }
+}
+pub fn page(connection: &Connection, path: &Path, cursor: Option<Cursor>, limit: usize, max_bytes: u64) -> anyhow::Result<Value> {
+    require((1..=1024).contains(&limit) && (1024..=1024*1024).contains(&max_bytes))?;
+    let cursor = cursor.unwrap_or(Cursor {scope:String::new(), key:String::new()});
+    require(cursor.scope.len() <= 4096 && cursor.key.len() <= 4096)?;
+    let mut statement = connection.prepare_cached("SELECT scope,key,value_bytes,COALESCE(length(value),0),value IS NULL FROM state_rows WHERE (scope,key)>(?1,?2) ORDER BY scope,key LIMIT ?3")?;
+    let mut rows = statement.query(params![cursor.scope,cursor.key,(limit+1) as i64])?;
+    let mut groups: BTreeMap<&str, [u64;4]> = BTreeMap::new();
+    let mut scanned = 0;
+    let mut cursor_bytes = 0u64;
+    let mut next = cursor;
+    let mut done = true;
+    while let Some(row) = rows.next()? {
+        let scope: String = row.get(0)?;
+        let key: String = row.get(1)?;
+        let cost = (scope.len()+key.len()+64) as u64;
+        if scanned == limit || (scanned > 0 && cursor_bytes.saturating_add(cost) > max_bytes) { done = false; break; }
+        let logical: i64 = row.get(2)?;
+        let stored: i64 = row.get(3)?;
+        let tombstone: bool = row.get(4)?;
+        let counts = groups.entry(category(&scope)).or_default();
+        counts[0] += 1;
+        counts[1] += u64::try_from(logical)?;
+        counts[2] += u64::try_from(stored)?;
+        counts[3] += u64::from(tombstone);
+        next = Cursor {scope,key};
+        scanned += 1;
+        cursor_bytes += cost;
+    }
+    let categories: Vec<Value> = groups.into_iter().map(|(category,counts)|json!({"category":category,"rows":counts[0],"logical_bytes":counts[1],"stored_bytes":counts[2],"tombstones":counts[3]})).collect();
+    Ok(json!({"category_version":1,"sampled_at":chrono::Utc::now().to_rfc3339_opts(chrono::SecondsFormat::Millis,true),
+        "consistency":"keyset_live","complete":done,"done":done,"rows_scanned":scanned,"categories":categories,
+        "cursor":if done {Value::Null} else {serde_json::to_value(next)?},"physical":physical(connection,path)?,
+        "coverage":"state_rows only; native retrieval indexes and SQLite overhead included in physical bytes"}))
+}
diff --git a/engine/src/workers/state/adapters/sqlite/storage_graph_metadata.rs b/engine/src/workers/state/adapters/sqlite/storage_graph_metadata.rs
new file mode 100644
index 0000000..46f44aa
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/storage_graph_metadata.rs
@@ -0,0 +1,275 @@
+use super::{database, protocol::{self, GRAPH_RECORD_SCOPES}};
+use rusqlite::{Connection, OptionalExtension, params};
+use serde_json::{Value, json};
+
+const MAX_SAFE_INTEGER: u64 = 9_007_199_254_740_991;
+const MAX_KEY_BYTES: usize = 4096;
+const MAX_ROWS: usize = 1024;
+const MIN_SCAN_BYTES: u64 = 8192;
+const MAX_SCAN_BYTES: u64 = 1024 * 1024;
+const COVERAGE: &str = "Exact GRAPH_RECORD_SCOPES live state_rows.value BLOB lengths; logical value_bytes separate; SQLite, WAL, indexes, reusable space, and technical graph scopes excluded";
+
+#[derive(Clone, Copy, Default)]
+pub(super) struct RowSize {
+    rows: u64,
+    logical_bytes: u64,
+    stored_bytes: u64,
+}
+
+impl RowSize {
+    pub(super) fn new(live: bool, logical_bytes: u64, stored_bytes: u64) -> Self {
+        if live {
+            Self { rows: 1, logical_bytes, stored_bytes }
+        } else {
+            Self::default()
+        }
+    }
+}
+
+struct ScopeMetadata {
+    status: String,
+    rows: u64,
+    logical_bytes: u64,
+    stored_bytes: u64,
+    revision: String,
+    last_key: Option<String>,
+}
+
+pub(super) fn row_size(connection: &Connection, scope: &str, key: &str) -> anyhow::Result<RowSize> {
+    let row: Option<(i64, i64)> = connection.query_row(
+        "SELECT value_bytes,length(value) FROM state_rows WHERE scope=?1 AND key=?2 AND value IS NOT NULL",
+        params![scope, key],
+        |row| Ok((row.get(0)?, row.get(1)?)),
+    ).optional()?;
+    row.map_or(Ok(RowSize::default()), |(logical, stored)| Ok(RowSize {
+        rows: 1,
+        logical_bytes: u64::try_from(logical)?,
+        stored_bytes: u64::try_from(stored)?,
+    }))
+}
+
+pub(super) fn record_write(
+    connection: &Connection,
+    scope: &str,
+    old_revision: u64,
+    new_revision: u64,
+    old: RowSize,
+    new: RowSize,
+) -> anyhow::Result<()> {
+    let metadata: Option<(String, i64, i64, i64, String)> = connection.query_row(
+        "SELECT status,rows,logical_bytes,stored_bytes,revision FROM graph_storage_metadata WHERE scope=?1",
+        [scope],
+        |row| Ok((row.get(0)?, row.get(1)?, row.get(2)?, row.get(3)?, row.get(4)?)),
+    ).optional()?;
+    let Some((status, rows, logical_bytes, stored_bytes, revision)) = metadata else { return Ok(()) };
+    if status == "preparing" || status == "scanned" {
+        connection.execute("UPDATE graph_storage_metadata SET status='stale' WHERE status IN ('preparing','scanned')", [])?;
+        return Ok(());
+    }
+    if status != "ready" { return Ok(()) }
+    if revision != old_revision.to_string() {
+        connection.execute("UPDATE graph_storage_metadata SET status='stale' WHERE scope=?1", [scope])?;
+        return Ok(());
+    }
+    let Some(rows) = apply_delta(rows, old.rows, new.rows) else { return stale_scope(connection, scope) };
+    let Some(logical_bytes) = apply_delta(logical_bytes, old.logical_bytes, new.logical_bytes) else { return stale_scope(connection, scope) };
+    let Some(stored_bytes) = apply_delta(stored_bytes, old.stored_bytes, new.stored_bytes) else { return stale_scope(connection, scope) };
+    let changed = connection.execute(
+        "UPDATE graph_storage_metadata SET rows=?2,logical_bytes=?3,stored_bytes=?4,revision=?5 WHERE scope=?1 AND status='ready' AND revision=?6",
+        params![scope, rows, logical_bytes, stored_bytes, new_revision.to_string(), old_revision.to_string()],
+    )?;
+    if changed != 1 { return stale_scope(connection, scope); }
+    Ok(())
+}
+
+fn stale_scope(connection: &Connection, scope: &str) -> anyhow::Result<()> {
+    connection.execute("UPDATE graph_storage_metadata SET status='stale' WHERE scope=?1", [scope])?;
+    Ok(())
+}
+
+fn apply_delta(current: i64, old: u64, new: u64) -> Option<i64> {
+    let current = u64::try_from(current).ok()?;
+    let value = current.checked_sub(old)?.checked_add(new)?;
+    if value > MAX_SAFE_INTEGER { return None; }
+    i64::try_from(value).ok()
+}
+
+fn load(connection: &Connection) -> anyhow::Result<Option<Vec<ScopeMetadata>>> {
+    let count: i64 = connection.query_row("SELECT count(*) FROM graph_storage_metadata", [], |row| row.get(0))?;
+    if count != GRAPH_RECORD_SCOPES.len() as i64 { return Ok(None); }
+    let mut entries = Vec::with_capacity(GRAPH_RECORD_SCOPES.len());
+    for scope in GRAPH_RECORD_SCOPES {
+        let row: Option<(String, i64, i64, i64, String, Option<String>)> = connection.query_row(
+            "SELECT status,rows,logical_bytes,stored_bytes,revision,last_key FROM graph_storage_metadata WHERE scope=?1",
+            [scope],
+            |row| Ok((row.get(0)?, row.get(1)?, row.get(2)?, row.get(3)?, row.get(4)?, row.get(5)?)),
+        ).optional()?;
+        let Some((status, rows, logical_bytes, stored_bytes, revision, last_key)) = row else { return Ok(None) };
+        if !["preparing", "scanned", "ready", "stale"].contains(&status.as_str())
+            || protocol::counter(&revision).is_err()
+            || last_key.as_ref().is_some_and(|key| key.len() > MAX_KEY_BYTES)
+        { return Ok(None); }
+        let (Ok(rows), Ok(logical_bytes), Ok(stored_bytes)) = (
+            u64::try_from(rows), u64::try_from(logical_bytes), u64::try_from(stored_bytes),
+        ) else { return Ok(None) };
+        entries.push(ScopeMetadata { status, rows, logical_bytes, stored_bytes, revision, last_key });
+    }
+    Ok(Some(entries))
+}
+
+fn revisions_match(connection: &Connection, entries: &[ScopeMetadata]) -> anyhow::Result<bool> {
+    for (scope, entry) in GRAPH_RECORD_SCOPES.into_iter().zip(entries) {
+        if database::revision(connection, scope)?.to_string() != entry.revision { return Ok(false); }
+    }
+    Ok(true)
+}
+
+fn reset(connection: &Connection) -> anyhow::Result<Vec<ScopeMetadata>> {
+    connection.execute("DELETE FROM graph_storage_metadata", [])?;
+    for scope in GRAPH_RECORD_SCOPES {
+        connection.execute(
+            "INSERT INTO graph_storage_metadata(scope,status,rows,logical_bytes,stored_bytes,revision,last_key) VALUES(?1,'preparing',0,0,0,?2,NULL)",
+            params![scope, database::revision(connection, scope)?.to_string()],
+        )?;
+    }
+    load(connection)?.ok_or_else(|| protocol::error("STATE_TX_FAILED"))
+}
+
+fn unavailable(status: &str, reason: &str) -> Value {
+    json!({"status":status,"source":"unavailable","complete":false,"rows":null,
+        "logical_bytes":null,"stored_bytes":null,"sampled_at":null,"scope_count":GRAPH_RECORD_SCOPES.len(),
+        "coverage":COVERAGE,"reason":reason})
+}
+
+fn totals(entries: &[ScopeMetadata]) -> Option<(u64, u64, u64)> {
+    entries.iter().try_fold((0u64, 0u64, 0u64), |(rows, logical, stored), entry| {
+        Some((rows.checked_add(entry.rows)?, logical.checked_add(entry.logical_bytes)?, stored.checked_add(entry.stored_bytes)?))
+    }).filter(|(rows, logical, stored)| [*rows, *logical, *stored].iter().all(|value| *value <= MAX_SAFE_INTEGER))
+}
+
+fn complete_result(entries: &[ScopeMetadata]) -> Value {
+    let Some((rows, logical_bytes, stored_bytes)) = totals(entries) else {
+        return unavailable("unavailable", "metadata_limit_exceeded");
+    };
+    json!({"status":"ready","source":"native_scoped_metadata","complete":true,"rows":rows,
+        "logical_bytes":logical_bytes,"stored_bytes":stored_bytes,
+        "sampled_at":chrono::Utc::now().to_rfc3339_opts(chrono::SecondsFormat::Millis,true),
+        "scope_count":GRAPH_RECORD_SCOPES.len(),"coverage":COVERAGE})
+}
+
+pub(super) fn read(connection: &Connection) -> anyhow::Result<Value> {
+    let Some(entries) = load(connection)? else { return Ok(unavailable("unavailable", "metadata_not_prepared")); };
+    if entries.iter().any(|entry| entry.status == "stale") || !revisions_match(connection, &entries)? {
+        return Ok(unavailable("stale", "metadata_stale"));
+    }
+    if entries.iter().any(|entry| entry.status != "ready") {
+        return Ok(unavailable("preparing", "metadata_preparing"));
+    }
+    Ok(complete_result(&entries))
+}
+
+fn preparation_result(entries: &[ScopeMetadata], rows_scanned: usize, complete: bool) -> Value {
+    let scopes_completed = entries.iter().filter(|entry| entry.status == "scanned" || entry.status == "ready").count();
+    if complete {
+        if let Some((rows, logical_bytes, stored_bytes)) = totals(entries) {
+            return json!({"status":"complete","complete":true,"rows":rows,"logical_bytes":logical_bytes,
+                "stored_bytes":stored_bytes,"sampled_at":chrono::Utc::now().to_rfc3339_opts(chrono::SecondsFormat::Millis,true),
+                "scope_count":GRAPH_RECORD_SCOPES.len(),"scopes_completed":scopes_completed,"rows_scanned":rows_scanned});
+        }
+        return json!({"status":"unavailable","complete":false,"rows":null,"logical_bytes":null,"stored_bytes":null,
+            "sampled_at":null,"scope_count":GRAPH_RECORD_SCOPES.len(),"scopes_completed":scopes_completed,
+            "rows_scanned":rows_scanned,"reason":"metadata_limit_exceeded"});
+    }
+    json!({"status":"preparing","complete":false,"rows":null,"logical_bytes":null,"stored_bytes":null,
+        "sampled_at":null,"scope_count":GRAPH_RECORD_SCOPES.len(),"scopes_completed":scopes_completed,
+        "rows_scanned":rows_scanned})
+}
+
+fn stale_preparation(entries: &[ScopeMetadata], rows_scanned: usize) -> Value {
+    let scopes_completed = entries.iter().filter(|entry| entry.status == "scanned" || entry.status == "ready").count();
+    json!({"status":"stale","complete":false,"rows":null,"logical_bytes":null,"stored_bytes":null,
+        "sampled_at":null,"scope_count":GRAPH_RECORD_SCOPES.len(),"scopes_completed":scopes_completed,
+        "rows_scanned":rows_scanned,"reason":"metadata_stale"})
+}
+
+pub(super) fn prepare(connection: &Connection, limit: usize, max_bytes: u64) -> anyhow::Result<Value> {
+    protocol::require((1..=MAX_ROWS).contains(&limit) && (MIN_SCAN_BYTES..=MAX_SCAN_BYTES).contains(&max_bytes))?;
+    let mut entries = match load(connection)? {
+        Some(entries) if entries.iter().all(|entry| entry.status == "ready") && revisions_match(connection, &entries)? => {
+            return Ok(preparation_result(&entries, 0, true));
+        }
+        Some(entries) if entries.iter().all(|entry| ["preparing", "scanned"].contains(&entry.status.as_str()))
+            && revisions_match(connection, &entries)? => entries,
+        _ => reset(connection)?,
+    };
+    let mut rows_scanned = 0usize;
+    let mut bytes_scanned = 0u64;
+    for (index, scope) in GRAPH_RECORD_SCOPES.into_iter().enumerate() {
+        if entries[index].status != "preparing" { continue; }
+        let remaining = limit.saturating_sub(rows_scanned);
+        if remaining == 0 { break; }
+        let mut statement = if entries[index].last_key.is_some() {
+            connection.prepare_cached(
+                "SELECT key,value_bytes,COALESCE(length(value),0),value IS NOT NULL FROM state_rows WHERE scope=?1 AND key>?2 ORDER BY key LIMIT ?3",
+            )?
+        } else {
+            connection.prepare_cached(
+                "SELECT key,value_bytes,COALESCE(length(value),0),value IS NOT NULL FROM state_rows WHERE scope=?1 ORDER BY key LIMIT ?2",
+            )?
+        };
+        let mut rows = if let Some(last_key) = entries[index].last_key.as_deref() {
+            statement.query(params![scope, last_key, (remaining + 1) as i64])?
+        } else {
+            statement.query(params![scope, (remaining + 1) as i64])?
+        };
+        let mut cursor = entries[index].last_key.clone();
+        let mut scope_rows = entries[index].rows;
+        let mut scope_logical = entries[index].logical_bytes;
+        let mut scope_stored = entries[index].stored_bytes;
+        let mut more = false;
+        while let Some(row) = rows.next()? {
+            if rows_scanned == limit { more = true; break; }
+            let key: String = row.get(0)?;
+            if key.len() > MAX_KEY_BYTES { return Err(protocol::error("STATE_TX_LIMIT_EXCEEDED")); }
+            let cost = (scope.len() + key.len() + 32) as u64;
+            if bytes_scanned.saturating_add(cost) > max_bytes {
+                if rows_scanned == 0 { return Err(protocol::error("STATE_TX_LIMIT_EXCEEDED")); }
+                more = true;
+                break;
+            }
+            let logical = u64::try_from(row.get::<_, i64>(1)?)?;
+            let stored = u64::try_from(row.get::<_, i64>(2)?)?;
+            let live: bool = row.get(3)?;
+            if live {
+                scope_rows = scope_rows.checked_add(1).ok_or_else(|| protocol::error("STATE_TX_LIMIT_EXCEEDED"))?;
+                scope_logical = scope_logical.checked_add(logical).filter(|value| *value <= MAX_SAFE_INTEGER).ok_or_else(|| protocol::error("STATE_TX_LIMIT_EXCEEDED"))?;
+                scope_stored = scope_stored.checked_add(stored).filter(|value| *value <= MAX_SAFE_INTEGER).ok_or_else(|| protocol::error("STATE_TX_LIMIT_EXCEEDED"))?;
+            }
+            cursor = Some(key);
+            rows_scanned += 1;
+            bytes_scanned += cost;
+        }
+        let status = if more { "preparing" } else { "scanned" };
+        connection.execute(
+            "UPDATE graph_storage_metadata SET status=?2,rows=?3,logical_bytes=?4,stored_bytes=?5,last_key=?6 WHERE scope=?1",
+            params![scope, status, i64::try_from(scope_rows)?, i64::try_from(scope_logical)?, i64::try_from(scope_stored)?, cursor],
+        )?;
+        entries[index].status = status.into();
+        entries[index].rows = scope_rows;
+        entries[index].logical_bytes = scope_logical;
+        entries[index].stored_bytes = scope_stored;
+        entries[index].last_key = cursor;
+        if more || rows_scanned >= limit || bytes_scanned >= max_bytes { break; }
+    }
+    if entries.iter().all(|entry| entry.status == "scanned") {
+        if !revisions_match(connection, &entries)? {
+            connection.execute("UPDATE graph_storage_metadata SET status='stale'", [])?;
+            return Ok(stale_preparation(&entries, rows_scanned));
+        }
+        connection.execute("UPDATE graph_storage_metadata SET status='ready',last_key=NULL", [])?;
+        entries = load(connection)?.ok_or_else(|| protocol::error("STATE_TX_FAILED"))?;
+        return Ok(preparation_result(&entries, rows_scanned, true));
+    }
+    Ok(preparation_result(&entries, rows_scanned, false))
+}
+
diff --git a/engine/src/workers/state/adapters/sqlite/storage_maintenance_lease.rs b/engine/src/workers/state/adapters/sqlite/storage_maintenance_lease.rs
new file mode 100644
index 0000000..9110db1
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/storage_maintenance_lease.rs
@@ -0,0 +1,234 @@
+use super::protocol::error;
+use chrono::{SecondsFormat, Utc};
+use rusqlite::{params, Connection, Transaction, TransactionBehavior};
+use serde_json::{json, Value};
+
+const PAGE_LEASE_MS: u64 = 120_000;
+const MIN_LEASE_MS: u64 = 1_000;
+const MAX_LEASE_MS: u64 = 300_000;
+
+struct LeaseRow {
+    owner_id: String,
+    fence: i64,
+    expires_at_ms: i64,
+}
+
+pub fn valid_owner(owner_id: &str) -> bool {
+    !owner_id.is_empty()
+        && owner_id.len() <= 128
+        && owner_id.bytes().all(|byte| {
+            byte.is_ascii_alphanumeric() || matches!(byte, b'.' | b'_' | b':' | b'-')
+        })
+}
+
+fn now_ms() -> anyhow::Result<i64> {
+    Ok(Utc::now().timestamp_millis())
+}
+
+fn expires_at(ms: i64) -> Option<String> {
+    chrono::DateTime::<Utc>::from_timestamp_millis(ms)
+        .map(|date| date.to_rfc3339_opts(SecondsFormat::Millis, true))
+}
+
+fn read_row(transaction: &Transaction<'_>) -> anyhow::Result<LeaseRow> {
+    Ok(transaction.query_row(
+        "SELECT owner_id,fence,expires_at_ms FROM state_storage_maintenance_lease WHERE singleton=1",
+        [],
+        |row| Ok(LeaseRow {
+            owner_id: row.get(0)?,
+            fence: row.get(1)?,
+            expires_at_ms: row.get(2)?,
+        }),
+    )?)
+}
+
+fn stale(row: &LeaseRow) -> Value {
+    json!({
+        "status": "stale",
+        "fence": u64::try_from(row.fence).ok().filter(|fence| *fence > 0),
+        "expires_at": expires_at(row.expires_at_ms),
+    })
+}
+
+pub fn initialize(connection: &Connection) -> anyhow::Result<()> {
+    connection.execute_batch(
+        "CREATE TABLE IF NOT EXISTS state_storage_maintenance_lease (
+            singleton INTEGER PRIMARY KEY CHECK(singleton=1),
+            owner_id TEXT NOT NULL,
+            fence INTEGER NOT NULL CHECK(fence>=0),
+            expires_at_ms INTEGER NOT NULL CHECK(expires_at_ms>=0)
+        );
+        INSERT OR IGNORE INTO state_storage_maintenance_lease
+            (singleton,owner_id,fence,expires_at_ms) VALUES (1,'',0,0);",
+    )?;
+    Ok(())
+}
+
+pub fn acquire(
+    connection: &Connection,
+    owner_id: &str,
+    lease_ms: u64,
+) -> anyhow::Result<Value> {
+    if !valid_owner(owner_id) || !(MIN_LEASE_MS..=MAX_LEASE_MS).contains(&lease_ms) {
+        return Err(error("STATE_TX_INVALID_REQUEST"));
+    }
+    let transaction = Transaction::new_unchecked(connection, TransactionBehavior::Immediate)?;
+    let now = now_ms()?;
+    let expires = now
+        .checked_add(i64::try_from(lease_ms)?)
+        .ok_or_else(|| error("STATE_TX_INVALID_REQUEST"))?;
+    let current = read_row(&transaction)?;
+    if !current.owner_id.is_empty() && current.expires_at_ms > now {
+        let response = json!({
+            "status": "busy",
+            "fence": u64::try_from(current.fence)?,
+            "expires_at": expires_at(current.expires_at_ms)
+                .ok_or_else(|| error("STATE_TX_FAILED"))?,
+        });
+        transaction.commit()?;
+        return Ok(response);
+    }
+    let recovered_expired = !current.owner_id.is_empty();
+    let fence = current
+        .fence
+        .checked_add(1)
+        .ok_or_else(|| error("STATE_TX_FAILED"))?;
+    if fence <= 0 {
+        return Err(error("STATE_TX_FAILED"));
+    }
+    transaction.execute(
+        "UPDATE state_storage_maintenance_lease SET owner_id=?1,fence=?2,expires_at_ms=?3 WHERE singleton=1",
+        params![owner_id, fence, expires],
+    )?;
+    transaction.commit()?;
+    Ok(json!({
+        "status": "acquired",
+        "fence": u64::try_from(fence)?,
+        "expires_at": expires_at(expires).ok_or_else(|| error("STATE_TX_FAILED"))?,
+        "recovered_expired": recovered_expired,
+    }))
+}
+
+pub fn refresh(
+    connection: &Connection,
+    owner_id: &str,
+    fence: u64,
+    lease_ms: u64,
+) -> anyhow::Result<Value> {
+    if !valid_owner(owner_id)
+        || fence == 0
+        || !(MIN_LEASE_MS..=MAX_LEASE_MS).contains(&lease_ms)
+    {
+        return Err(error("STATE_TX_INVALID_REQUEST"));
+    }
+    let transaction = Transaction::new_unchecked(connection, TransactionBehavior::Immediate)?;
+    let now = now_ms()?;
+    let expires = now
+        .checked_add(i64::try_from(lease_ms)?)
+        .ok_or_else(|| error("STATE_TX_INVALID_REQUEST"))?;
+    let current = read_row(&transaction)?;
+    if current.owner_id != owner_id
+        || u64::try_from(current.fence).ok() != Some(fence)
+        || current.expires_at_ms <= now
+    {
+        let response = stale(&current);
+        transaction.commit()?;
+        return Ok(response);
+    }
+    transaction.execute(
+        "UPDATE state_storage_maintenance_lease SET expires_at_ms=?1 WHERE singleton=1 AND owner_id=?2 AND fence=?3",
+        params![expires, owner_id, i64::try_from(fence)?],
+    )?;
+    transaction.commit()?;
+    Ok(json!({
+        "status": "refreshed",
+        "fence": fence,
+        "expires_at": expires_at(expires).ok_or_else(|| error("STATE_TX_FAILED"))?,
+    }))
+}
+
+pub fn release(connection: &Connection, owner_id: &str, fence: u64) -> anyhow::Result<Value> {
+    if !valid_owner(owner_id) || fence == 0 {
+        return Err(error("STATE_TX_INVALID_REQUEST"));
+    }
+    let transaction = Transaction::new_unchecked(connection, TransactionBehavior::Immediate)?;
+    let now = now_ms()?;
+    let current = read_row(&transaction)?;
+    if current.owner_id != owner_id
+        || u64::try_from(current.fence).ok() != Some(fence)
+        || current.expires_at_ms <= now
+    {
+        let response = stale(&current);
+        transaction.commit()?;
+        return Ok(response);
+    }
+    transaction.execute(
+        "UPDATE state_storage_maintenance_lease SET owner_id='',expires_at_ms=0 WHERE singleton=1 AND owner_id=?1 AND fence=?2",
+        params![owner_id, i64::try_from(fence)?],
+    )?;
+    transaction.commit()?;
+    Ok(json!({ "status": "released", "fence": fence }))
+}
+
+pub fn reclaim_page(
+    connection: &Connection,
+    owner_id: &str,
+    fence: u64,
+) -> anyhow::Result<()> {
+    if !valid_owner(owner_id) || fence == 0 {
+        return Err(error("STATE_TX_INVALID_REQUEST"));
+    }
+    let transaction = Transaction::new_unchecked(connection, TransactionBehavior::Immediate)?;
+    let now = now_ms()?;
+    let expires = now
+        .checked_add(i64::try_from(PAGE_LEASE_MS)?)
+        .ok_or_else(|| error("STATE_TX_FAILED"))?;
+    let current = read_row(&transaction)?;
+    if current.owner_id != owner_id
+        || u64::try_from(current.fence).ok() != Some(fence)
+        || current.expires_at_ms <= now
+    {
+        return Err(error("STATE_STORAGE_MAINTENANCE_LEASE_FENCED"));
+    }
+    transaction.execute(
+        "UPDATE state_storage_maintenance_lease SET expires_at_ms=?1 WHERE singleton=1 AND owner_id=?2 AND fence=?3",
+        params![expires, owner_id, i64::try_from(fence)?],
+    )?;
+    transaction.execute_batch("PRAGMA incremental_vacuum(1)")?;
+    transaction.commit()?;
+    Ok(())
+}
+
+pub fn validate_current(connection: &Connection, owner_id: &str, fence: u64) -> anyhow::Result<()> {
+    let transaction = Transaction::new_unchecked(connection, TransactionBehavior::Immediate)?;
+    let now = now_ms()?;
+    let current = read_row(&transaction)?;
+    if current.owner_id != owner_id || u64::try_from(current.fence).ok() != Some(fence)
+        || current.expires_at_ms <= now { return Err(error("STATE_STORAGE_MAINTENANCE_LEASE_FENCED")); }
+    transaction.commit()?;
+    Ok(())
+}
+
+pub fn save_state(connection: &Connection, owner_id: &str, fence: u64, value: Value, release: bool) -> anyhow::Result<Value> {
+    if !valid_owner(owner_id) || fence == 0 || super::protocol::size(&value)? > 1_048_576
+        || value["version"] != 1 || !value["compaction"].is_object()
+        || !value["totals"].is_object() || !value["diagnostics"].is_object()
+        || !value["observationIndex"].is_object() || !value["technical"].is_object()
+        || value["maintenanceHistory"].as_array().is_none_or(|rows| rows.len() > 30)
+        || value["updatedAt"].as_str().is_none_or(|at| chrono::DateTime::parse_from_rfc3339(at).is_err()) {
+        return Err(error("STATE_TX_INVALID_REQUEST"));
+    }
+    let transaction = Transaction::new_unchecked(connection, TransactionBehavior::Immediate)?;
+    let now = now_ms()?;
+    let current = read_row(&transaction)?;
+    if current.owner_id != owner_id || u64::try_from(current.fence).ok() != Some(fence)
+        || current.expires_at_ms <= now {
+        return Err(error("STATE_STORAGE_MAINTENANCE_LEASE_FENCED"));
+    }
+    let version = super::database::write(&transaction, "mem:storage-maintenance", "current", Some(&value))?;
+    if release {
+        transaction.execute("UPDATE state_storage_maintenance_lease SET owner_id='',expires_at_ms=0 WHERE singleton=1", [])?;
+    }
+    transaction.commit()?;
+    Ok(json!({"status":"saved","fence":fence,"version":version.to_string(),"released":release}))
+}
