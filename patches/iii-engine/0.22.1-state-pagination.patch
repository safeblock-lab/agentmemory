+    assert_eq!(adapter.run(4096,|connection| database::revision(connection,storage_prune::TEMPORAL_WORK)).await.unwrap(),before+1);
+    assert_temporal_deferred(prune_temporal(&adapter,owner.clone(),&id,256).await);
