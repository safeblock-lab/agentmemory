+        "INSERT INTO state_scopes(scope,revision,next_position) VALUES('mem:obs:unrelated', '1',0)",
+        [],
+    )
+    .unwrap();
+    let result = call(
+        &c,
+        json!({"action":"index_status","index_id":"observations","metadata_only":true}),
+    )
+    .unwrap();
+    assert_eq!(result["version"], 1);
+    assert_eq!(result["metadata_only"], true);
+    assert_eq!(result["index_id"], "observations");
+    assert_eq!(result["semantic"].as_array().unwrap().len(), 1);
+    let meta = &result["semantic"][0];
+    assert_eq!(meta["index_id"], "observations");
+    assert_eq!(meta["source_kind"], "agentmemory");
+    assert!(meta.get("source_prepared").is_none());
+    assert!(result.get("graph").is_none());
+    for value in [
+        json!({"action":"index_status","metadata_only":true}),
+        json!({"action":"index_status","index_id":"observations"}),
+        json!({"action":"index_status","index_id":"observations","metadata_only":true,"extra":1}),
+    ] {
+        assert_eq!(
+            code(call(&c, value).unwrap_err()),
+            "STATE_TX_INVALID_REQUEST"
+        );
+    }
