+    let mut memory = json!({"id":"m","title":"title","content":"content","isLatest":true,"sessionIds":["first"]});
+    write(&connection, "mem:memories", "m", Some(&memory));
+    upsert(
+        &connection,
+        vec![source_item(&connection, "mem:memories", "m")],
+    )
+    .unwrap();
+    memory["sessionIds"] = json!(["second"]);
+    write(&connection, "mem:memories", "m", Some(&memory));
+    assert_eq!(status(&connection)["dirty_count"], "1");
+    assert_eq!(status(&connection)["coverage_ready"], false);
+    upsert(
+        &connection,
+        vec![source_item(&connection, "mem:memories", "m")],
+    )
+    .unwrap();
+    assert_eq!(status(&connection)["coverage_ready"], true);
+}
+
+#[test]
+fn sqlite_execution_deadline_rolls_back_canonical_and_index_mutations() {
+    let connection = fresh();
+    let transaction = connection.unchecked_transaction().unwrap();
+    let cause=bounded_for(&transaction,std::time::Duration::ZERO,|| {
+        database::write(&transaction,graph::NODES,"a",Some(&node("a","rollback",&[])))?;
+        transaction.query_row("WITH RECURSIVE n(x) AS (VALUES(0) UNION ALL SELECT x+1 FROM n WHERE x<100000000) SELECT sum(x) FROM n",[],|r|r.get::<_,i64>(0))?;
+        Ok(())
+    }).unwrap_err();
+    assert_eq!(code(cause), "STATE_RETRIEVAL_RESOURCE_LIMIT");
+    drop(transaction);
+    assert!(
+        database::row(&connection, graph::NODES, "a")
+            .unwrap()
+            .value
+            .is_none()
+    );
+    assert!(
+        ids(&call(
+            &connection,
+            json!({"action":"graph_seeds","entity_names":["rollback"]})
+        )
+        .unwrap())
+        .is_empty()
+    );
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/viewer_recent/mod.rs b/engine/src/workers/state/adapters/sqlite/retrieval/viewer_recent/mod.rs
new file mode 100644
index 0000000..dc929d3
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/viewer_recent/mod.rs
@@ -0,0 +1,91 @@
+mod page;
+mod prepare;
+mod projection;
+
+pub use page::page;
+pub use prepare::{prepare, status};
+pub use projection::validate_fields;
+
+use super::super::{database, protocol};
+use rusqlite::{params, Connection, OptionalExtension};
+use serde_json::Value;
+
+pub(super) const SOURCE_MAX: i64 = 16 * 1024 * 1024;
+
+
+pub fn schema(c: &Connection) -> anyhow::Result<()> {
+    c.execute_batch("CREATE TABLE IF NOT EXISTS viewer_recent_meta(id INTEGER PRIMARY KEY CHECK(id=1),scope_cursor TEXT NOT NULL,key_cursor TEXT NOT NULL,scanned INTEGER NOT NULL,ready INTEGER NOT NULL,generation INTEGER NOT NULL);
+        INSERT OR IGNORE INTO viewer_recent_meta VALUES(1,'mem:sessions','',0,0,1);
+        CREATE TABLE IF NOT EXISTS viewer_recent_rows(scope TEXT NOT NULL,key TEXT NOT NULL,entity TEXT NOT NULL,session_id TEXT NOT NULL,stamp INTEGER NOT NULL,invalid_stamp INTEGER NOT NULL,version TEXT NOT NULL,PRIMARY KEY(scope,key)) WITHOUT ROWID;
+        CREATE INDEX IF NOT EXISTS viewer_recent_order ON viewer_recent_rows(entity,stamp DESC,scope,key);
+        CREATE INDEX IF NOT EXISTS viewer_recent_session_order ON viewer_recent_rows(entity,session_id,stamp DESC,scope,key);
+        CREATE TABLE IF NOT EXISTS viewer_recent_dirty(scope TEXT NOT NULL,key TEXT NOT NULL,PRIMARY KEY(scope,key)) WITHOUT ROWID;
+        CREATE TABLE IF NOT EXISTS viewer_recent_issues(scope TEXT NOT NULL,key TEXT NOT NULL,reason TEXT NOT NULL,PRIMARY KEY(scope,key)) WITHOUT ROWID;
+        DROP TRIGGER IF EXISTS viewer_recent_insert;
+        DROP TRIGGER IF EXISTS viewer_recent_update;
+        DROP TRIGGER IF EXISTS viewer_recent_delete;
+        CREATE TRIGGER IF NOT EXISTS viewer_recent_insert AFTER INSERT ON state_rows WHEN NEW.scope='mem:sessions' OR (NEW.scope>='mem:obs:' AND NEW.scope<'mem:obs;') BEGIN INSERT INTO viewer_recent_dirty(scope,key) SELECT NEW.scope,NEW.key WHERE NOT EXISTS (SELECT 1 FROM viewer_recent_dirty WHERE scope=NEW.scope AND key=NEW.key); END;
+        CREATE TRIGGER IF NOT EXISTS viewer_recent_update AFTER UPDATE ON state_rows WHEN NEW.scope='mem:sessions' OR (NEW.scope>='mem:obs:' AND NEW.scope<'mem:obs;') OR OLD.scope='mem:sessions' OR (OLD.scope>='mem:obs:' AND OLD.scope<'mem:obs;') BEGIN INSERT INTO viewer_recent_dirty(scope,key) SELECT NEW.scope,NEW.key WHERE (NEW.scope='mem:sessions' OR (NEW.scope>='mem:obs:' AND NEW.scope<'mem:obs;')) AND NOT EXISTS (SELECT 1 FROM viewer_recent_dirty WHERE scope=NEW.scope AND key=NEW.key); INSERT INTO viewer_recent_dirty(scope,key) SELECT OLD.scope,OLD.key WHERE (OLD.scope='mem:sessions' OR (OLD.scope>='mem:obs:' AND OLD.scope<'mem:obs;')) AND NOT EXISTS (SELECT 1 FROM viewer_recent_dirty WHERE scope=OLD.scope AND key=OLD.key); END;
+        CREATE TRIGGER IF NOT EXISTS viewer_recent_delete AFTER DELETE ON state_rows WHEN OLD.scope='mem:sessions' OR (OLD.scope>='mem:obs:' AND OLD.scope<'mem:obs;') BEGIN INSERT INTO viewer_recent_dirty(scope,key) SELECT OLD.scope,OLD.key WHERE NOT EXISTS (SELECT 1 FROM viewer_recent_dirty WHERE scope=OLD.scope AND key=OLD.key); END;")?;
+    Ok(())
+}
+
+fn tracked(scope: &str) -> bool {
+    scope == "mem:sessions" || scope.starts_with("mem:obs:")
+}
+
+fn stamp(value: &Value, scope: &str) -> Option<i64> {
+    let parse = |field: &str| value.get(field).and_then(Value::as_str)
+        .and_then(|text| chrono::DateTime::parse_from_rfc3339(text).ok())
+        .map(|time| time.timestamp_micros());
+    if scope == "mem:sessions" {
+        parse("startedAt").into_iter().chain(parse("endedAt")).max()
+    } else {
+        parse("timestamp")
+    }
+}
+
+pub fn maintain(c: &Connection, scope: &str, key: &str, value: Option<&Value>, version: u64) -> anyhow::Result<()> {
+    if !tracked(scope) { return Ok(()); }
+    c.prepare_cached("DELETE FROM viewer_recent_rows WHERE scope=?1 AND key=?2")?.execute( params![scope,key])?;
+    c.prepare_cached("DELETE FROM viewer_recent_issues WHERE scope=?1 AND key=?2")?.execute( params![scope,key])?;
+    if let Some(value) = value {
+        let session = scope.strip_prefix("mem:obs:").unwrap_or(key);
+        let valid = value.is_object() && value.get("id").and_then(Value::as_str) == Some(key)
+            && (scope == "mem:sessions" || value.get("sessionId").and_then(Value::as_str) == Some(session));
+        if valid && value.get("deleted") != Some(&Value::Bool(true)) {
+            let timestamp = stamp(value, scope);
+            c.prepare_cached("INSERT INTO viewer_recent_rows VALUES(?1,?2,?3,?4,?5,?6,?7)")?.execute(
+                params![scope,key,if scope=="mem:sessions" {"sessions"} else {"observations"},session,timestamp.unwrap_or(i64::MIN),timestamp.is_none(),version.to_string()])?;
+        } else if !valid {
+            issue(c, scope, key, "invalid_source_identity")?;
+        }
+    }
+    c.prepare_cached("DELETE FROM viewer_recent_dirty WHERE scope=?1 AND key=?2")?.execute( params![scope,key])?;
+    Ok(())
+}
+
+pub(super) fn issue(c: &Connection, scope: &str, key: &str, reason: &str) -> anyhow::Result<()> {
+    c.prepare_cached("DELETE FROM viewer_recent_rows WHERE scope=?1 AND key=?2")?.execute( params![scope,key])?;
+    c.prepare_cached("INSERT INTO viewer_recent_issues VALUES(?1,?2,?3) ON CONFLICT(scope,key) DO UPDATE SET reason=excluded.reason")?.execute( params![scope,key,reason])?;
+    Ok(())
+}
+
+pub(super) fn load(c: &Connection, scope: &str, key: &str, expected: Option<&str>) -> anyhow::Result<Option<(Value,String,i64)>> {
+    let meta: Option<(String,i64,i64)> = c.query_row(
+        "SELECT version,value_bytes,CASE typeof(value) WHEN 'blob' THEN length(value) WHEN 'text' THEN length(value)*4 ELSE 0 END FROM state_rows WHERE scope=?1 AND key=?2 AND value IS NOT NULL",
+        params![scope,key], |r| Ok((r.get(0)?,r.get(1)?,r.get(2)?))).optional()?;
+    let Some((version,logical,stored)) = meta else { return Ok(None); };
+    if expected.is_some_and(|expected| expected != version) { return Err(protocol::error("STATE_RECENT_CURSOR_STALE")); }
+    load_known(c,scope,key,version,logical,stored)
+}
+
+pub(super) fn load_known(c: &Connection, scope: &str, key: &str, version: String, logical: i64, stored: i64) -> anyhow::Result<Option<(Value,String,i64)>> {
+    if logical <= 0 || stored <= 0 || logical > SOURCE_MAX || stored > SOURCE_MAX {
+        return Err(protocol::error("STATE_RECENT_SOURCE_TOO_LARGE"));
+    }
+    let encoded: Vec<u8> = c.prepare_cached("SELECT value FROM state_rows WHERE scope=?1 AND key=?2 AND version=?3")?.query_row(params![scope,key,version],|r|Ok(r.get_ref(0)?.as_bytes()?.to_vec()))?;
+    let decoded = database::decode_value(&encoded, logical).map_err(|_|protocol::error("STATE_RECENT_SOURCE_INVALID"))?;
+    let value=serde_json::from_str(&decoded).map_err(|_|protocol::error("STATE_RECENT_SOURCE_INVALID"))?;
+    Ok(Some((value,version,logical)))
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/viewer_recent/page.rs b/engine/src/workers/state/adapters/sqlite/retrieval/viewer_recent/page.rs
new file mode 100644
index 0000000..4efcdf1
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/viewer_recent/page.rs
@@ -0,0 +1,86 @@
+use super::*;
+use serde::{Deserialize,Serialize};
+use serde_json::{json,Value};
+use std::time::{Duration,Instant};
+
+#[derive(Deserialize,Serialize)]
+#[serde(deny_unknown_fields)]
+struct Cursor {
+    entity:String,
+    session_id:Option<String>,
+    fields:Vec<String>,
+    generation:i64,
+    stamp:i64,
+    scope:String,
+    key:String,
+}
+
+fn response(status:&str,reason:Option<&str>,items:&[Value],more:bool,cursor:Option<String>) -> Value {
+    json!({"status":status,"reason":reason,"items":items,"has_more":more,"next_cursor":cursor,
+        "ordering":"timestamp_desc_scope_asc_key_asc","session_recency":"max_valid_endedAt_startedAt","timestamp_normalization":"UTC_RFC3339","invalid_timestamps":"oldest"})
+}
+
+pub fn page(c:&Connection,entity:&str,session_id:Option<&str>,cursor:Option<&str>,limit:usize,max_bytes:usize,fields:&[String]) -> anyhow::Result<Value> {
+    let start=Instant::now();
+    let (ready,generation):(bool,i64)=c.query_row("SELECT ready,generation FROM viewer_recent_meta WHERE id=1",[],|r|Ok((r.get(0)?,r.get(1)?)))?;
+    let dirty:bool=c.query_row("SELECT EXISTS(SELECT 1 FROM viewer_recent_dirty)",[],|r|r.get(0))?;
+    if !ready || dirty {return Ok(response("preparing",Some("recent_index_not_ready"),&[],false,None));}
+    let issues:bool=c.query_row("SELECT EXISTS(SELECT 1 FROM viewer_recent_issues)",[],|r|r.get(0))?;
+    let previous:Option<Cursor>=cursor.map(serde_json::from_str).transpose().map_err(|_|protocol::error("STATE_TX_INVALID_REQUEST"))?;
+    if let Some(previous)=&previous {
+        protocol::require(previous.entity==entity && previous.session_id.as_deref()==session_id && previous.fields==fields)?;
+        if previous.generation!=generation {return Err(protocol::error("STATE_RECENT_CURSOR_STALE"));}
+    }
+    let index=if session_id.is_some() {"viewer_recent_session_order"} else {"viewer_recent_order"};
+    let filter=if session_id.is_some() {"AND v.session_id=?2"} else {""};
+    let keyset=if previous.is_some() {"AND (v.stamp<?3 OR (v.stamp=?3 AND (v.scope,v.key)>(?4,?5)))"} else {""};
+    let sql=format!("SELECT v.scope,v.key,v.version,v.stamp,v.invalid_stamp,s.value_bytes FROM viewer_recent_rows v INDEXED BY {index} JOIN state_rows s ON s.scope=v.scope AND s.key=v.key AND s.version=v.version AND s.value IS NOT NULL WHERE v.entity=?1 {filter} {keyset} ORDER BY v.stamp DESC,v.scope,v.key LIMIT ?6");
+    // Only metadata is collected; source bodies are loaded one at a time below.
+    let mut statement=c.prepare(&sql)?;
+    let mut rows=statement.query(params![entity,session_id,previous.as_ref().map(|v|v.stamp),previous.as_ref().map(|v|&v.scope),previous.as_ref().map(|v|&v.key),(limit+1) as i64])?;
+    let mut candidates=Vec::new();
+    while let Some(row)=rows.next()? {
+        candidates.push((row.get::<_,String>(0)?,row.get::<_,String>(1)?,row.get::<_,String>(2)?,row.get::<_,i64>(3)?,row.get::<_,bool>(4)?,row.get::<_,i64>(5)?));
+    }
+    let mut items=Vec::new();
+    let mut next=cursor.map(str::to_owned);
+    let mut reason=issues.then_some("unindexable_sources");
+    let mut decoded_bytes=0i64;
+    let mut more=candidates.len()>limit;
+    for (scope,key,version,stamp,invalid_stamp,logical) in candidates.iter().take(limit) {
+        if start.elapsed()>=Duration::from_millis(25) || decoded_bytes.saturating_add(*logical)>SOURCE_MAX {
+            more=true;reason=Some("recent_query_budget_exceeded");break;
+        }
+        let loaded=match load(c,scope,key,Some(version)) {
+            Ok(Some(loaded))=>loaded,
+            Ok(None)=>{more=true;reason=Some("recent_index_stale");break;}
+            Err(cause) if cause.downcast_ref::<protocol::TxError>().is_some_and(|error|error.0=="STATE_RECENT_SOURCE_TOO_LARGE")=>{
+                more=true;reason=Some("source_too_large");break;
+            }
+            Err(cause)=>return Err(cause),
+        };
+        decoded_bytes+=loaded.2;
+        let (value,mut truncated)=projection::project(&loaded.0,fields);
+        let normalized=if *invalid_stamp {None} else {chrono::DateTime::<chrono::Utc>::from_timestamp_micros(*stamp).map(|time|time.to_rfc3339_opts(chrono::SecondsFormat::Micros,true))};
+        let mut item=json!({"scope":scope,"key":key,"version":version,"value":value,"ordering_timestamp":normalized,"projection":{"truncated_fields":truncated,"invalid_timestamp":invalid_stamp}});
+        let candidate_cursor=serde_json::to_string(&Cursor{entity:entity.into(),session_id:session_id.map(str::to_owned),fields:fields.to_vec(),generation,stamp:*stamp,scope:scope.clone(),key:key.clone()})?;
+        let mut fits=false;
+        for bounds in [None,Some((512,8)),Some((128,4)),Some((32,1)),Some((0,0))] {
+            if let Some((cap,array_cap))=bounds {
+                projection::shrink(&mut item["value"],&mut truncated,cap,array_cap);
+                item["projection"]["truncated_fields"]=json!(truncated);
+            }
+            items.push(item.clone());
+            let proposed=response(if reason.is_some(){"partial"}else{"ready"},reason,&items,true,Some(candidate_cursor.clone()));
+            if protocol::size(&proposed)?<=max_bytes {fits=true;break;}
+            items.pop();
+        }
+        if !fits {more=true;reason=Some("projection_budget_exceeded");break;}
+        next=Some(candidate_cursor);
+    }
+    if items.is_empty() {more=false;next=None;}
+    if !more {next=None;}
+    let result=response(if reason.is_some(){"partial"}else{"ready"},reason,&items,more,next);
+    if protocol::size(&result)?>max_bytes {return Ok(response("partial",Some("projection_budget_exceeded"),&[],false,None));}
+    Ok(result)
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/viewer_recent/prepare.rs b/engine/src/workers/state/adapters/sqlite/retrieval/viewer_recent/prepare.rs
new file mode 100644
index 0000000..86d8bd5
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/viewer_recent/prepare.rs
@@ -0,0 +1,266 @@
+use super::*;
+use serde_json::{json,Value};
+use std::time::Instant;
+use sha2::{Digest, Sha256};
+
+pub fn status(c: &Connection) -> anyhow::Result<Value> {
+    let (scope,key,scanned,saved_ready,generation): (String,String,bool,bool,i64) = c.query_row(
+        "SELECT scope_cursor,key_cursor,scanned,ready,generation FROM viewer_recent_meta WHERE id=1",[],
+        |r|Ok((r.get(0)?,r.get(1)?,r.get(2)?,r.get(3)?,r.get(4)?)))?;
+    let dirty: i64 = c.query_row("SELECT count(*) FROM viewer_recent_dirty",[],|r|r.get(0))?;
+    let issues: i64 = c.query_row("SELECT count(*) FROM viewer_recent_issues",[],|r|r.get(0))?;
+    let checkpoint = hex::encode(Sha256::digest(serde_json::to_vec(&(&scope,&key,scanned,generation,dirty,issues))?));
+    let ready = saved_ready && scanned && dirty == 0 && issues == 0;
+    Ok(json!({"target":"viewer_recent","status":if issues>0 {"partial"}else if ready {"ready"}else{"preparing"},
+        "checkpoint":checkpoint,"generation":generation.to_string(),"scanned":scanned,
+        "dirty":dirty,"issues":issues,"ready":ready,"has_more":!ready}))
+}
+
+#[cfg(test)]
+mod checkpoint_tests {
+    use super::*;
+    #[test]
+    fn lost_ack_checkpoint_survives_reopen_and_status_never_writes() {
+        let root=std::env::var("III_SQLITE_TEST_ROOT").expect("isolated III_SQLITE_TEST_ROOT must be set");
+        let directory=tempfile::tempdir_in(root).unwrap();
+        let path=directory.path().join("recent-checkpoint.sqlite3");
+        let c=database::open(&path).unwrap();
+        let transaction=c.unchecked_transaction().unwrap();
+        // Deliberately discard the successful response, retaining only durable state.
+        prepare(&transaction,1,65536,25).unwrap();
+        transaction.commit().unwrap();
+        let before=c.total_changes();
+        let first=status(&c).unwrap();
+        assert_eq!(c.total_changes(),before);
+        assert_eq!(first["ready"],true);
+        drop(c);
+        let c=database::open(&path).unwrap();
+        assert_eq!(status(&c).unwrap(),first);
+        c.execute("INSERT INTO viewer_recent_dirty VALUES('mem:sessions','new')",[]).unwrap();
+        let dirty=status(&c).unwrap();
+        assert_eq!(dirty["ready"],false);
+        assert_eq!(dirty["dirty"],1);
+        assert_ne!(dirty["checkpoint"],first["checkpoint"]);
+    }
+}
+
+// Metadata pages avoid repeated key probes without retaining decoded source bodies.
+struct Source {
+    scope: String,
+    key: String,
+    version: Option<String>,
+    logical: i64,
+    stored: i64,
+}
+
+fn sources(c: &Connection, scope: &str, key: &str, scanned: bool, limit: usize) -> anyhow::Result<(bool, Vec<Source>)> {
+    let dirty: bool = c.query_row("SELECT EXISTS(SELECT 1 FROM viewer_recent_dirty)", [], |r| r.get(0))?;
+    if !dirty && scanned { return Ok((false, Vec::new())); }
+    let sql = if dirty {
+        "SELECT d.scope,d.key,s.version,COALESCE(s.value_bytes,0),CASE typeof(s.value) WHEN 'blob' THEN length(s.value) WHEN 'text' THEN length(s.value)*4 ELSE 0 END FROM viewer_recent_dirty d LEFT JOIN state_rows s ON s.scope=d.scope AND s.key=d.key AND s.value IS NOT NULL ORDER BY d.scope,d.key LIMIT ?3"
+    } else if scope == "mem:sessions" {
+        "SELECT scope,key,CASE WHEN value IS NULL THEN NULL ELSE version END,value_bytes,CASE typeof(value) WHEN 'blob' THEN length(value) WHEN 'text' THEN length(value)*4 ELSE 0 END FROM state_rows WHERE scope=?1 AND key>?2 ORDER BY key LIMIT ?3"
+    } else {
+        "SELECT scope,key,CASE WHEN value IS NULL THEN NULL ELSE version END,value_bytes,CASE typeof(value) WHEN 'blob' THEN length(value) WHEN 'text' THEN length(value)*4 ELSE 0 END FROM state_rows WHERE scope>='mem:obs:' AND scope<'mem:obs;' AND (scope,key)>(?1,?2) ORDER BY scope,key LIMIT ?3"
+    };
+    let mut statement = c.prepare_cached(sql)?;
+    // ?1/?2 are intentionally absent from the dirty query; numbered ?3 retains three bindings.
+    let rows = statement.query_map(params![scope,key,limit.min(256) as i64], |r| Ok(Source {
+        scope:r.get(0)?, key:r.get(1)?, version:r.get(2)?, logical:r.get(3)?, stored:r.get(4)?,
+    }))?;
+    Ok((dirty, rows.collect::<rusqlite::Result<Vec<_>>>()?))
+}
+
+pub fn prepare(c: &Connection, limit: usize, max_bytes: usize, max_ms: usize) -> anyhow::Result<Value> {
+    let start = Instant::now();
+    let (mut scope,mut key,mut scanned,ready,generation): (String,String,bool,bool,i64) = c.query_row(
+        "SELECT scope_cursor,key_cursor,scanned,ready,generation FROM viewer_recent_meta WHERE id=1",[],
+        |r|Ok((r.get(0)?,r.get(1)?,r.get(2)?,r.get(3)?,r.get(4)?)))?;
+    let dirty: bool = c.query_row("SELECT EXISTS(SELECT 1 FROM viewer_recent_dirty)",[],|r|r.get(0))?;
+    if ready && dirty {
+        let next = generation.checked_add(1).ok_or_else(|| protocol::error("STATE_TX_LIMIT_EXCEEDED"))?;
+        c.execute("UPDATE viewer_recent_meta SET ready=0,generation=?1 WHERE id=1",[next])?;
+    }
+    let mut processed = 0;
+    let mut decoded_bytes = 0usize;
+    let mut source_bytes = 0usize;
+    let mut reason = None;
+    let mut required_bytes = None;
+    'batch: while processed < limit {
+        database::check_preparation()?;
+        let (is_dirty, candidates) = sources(c, &scope, &key, scanned, limit-processed)?;
+        if candidates.is_empty() {
+            if !scanned && scope == "mem:sessions" { scope="mem:obs:".into();key.clear();continue; }
+            scanned=true;
+            break;
+        }
+        for source in candidates {
+            database::check_preparation()?;
+            let Source { scope: next_scope, key: next_key, version, logical, stored } = source;
+            let valid_size = logical > 0 && stored > 0 && logical <= SOURCE_MAX && stored <= SOURCE_MAX;
+            let source_size = logical.max(stored).max(0) as usize;
+            if version.is_some() && valid_size && source_bytes.saturating_add(source_size) > max_bytes {
+                reason=Some("decode_budget_exceeded");
+                required_bytes=Some(source_size);
+                break 'batch;
+            }
+            let loaded = match version {
+                None => Ok(None),
+                Some(version) => load_known(c,&next_scope,&next_key,version,logical,stored),
+            };
+            if valid_size { decoded_bytes+=logical as usize; source_bytes+=source_size; }
+            match loaded {
+                Ok(Some((value,version,_bytes))) => {
+                    maintain(c,&next_scope,&next_key,Some(&value),protocol::counter(&version)?)?;
+                }
+                Ok(None) => maintain(c,&next_scope,&next_key,None,0)?,
+                Err(cause) if cause.downcast_ref::<protocol::TxError>().is_some_and(|error| ["STATE_RECENT_SOURCE_TOO_LARGE","STATE_RECENT_SOURCE_INVALID"].contains(&error.0)) => {
+                    issue(c,&next_scope,&next_key,if !valid_size {"source_too_large"} else {"source_unreadable"})?;
+                    c.prepare_cached("DELETE FROM viewer_recent_dirty WHERE scope=?1 AND key=?2")?.execute(params![next_scope,next_key])?;
+                }
+                Err(cause) => return Err(cause),
+            }
+            processed+=1;
+            if !is_dirty { scope=next_scope;key=next_key; }
+        }
+    }
+    database::check_preparation()?;
+    let dirty: bool = c.query_row("SELECT EXISTS(SELECT 1 FROM viewer_recent_dirty)",[],|r|r.get(0))?;
+    let issues: bool = c.query_row("SELECT EXISTS(SELECT 1 FROM viewer_recent_issues)",[],|r|r.get(0))?;
+    let complete = scanned && !dirty;
+    c.execute("UPDATE viewer_recent_meta SET scope_cursor=?1,key_cursor=?2,scanned=?3,ready=?4 WHERE id=1",params![scope,key,scanned,complete])?;
+    if issues && reason.is_none() { reason=Some("unindexable_sources"); }
+    let generation: i64=c.query_row("SELECT generation FROM viewer_recent_meta WHERE id=1",[],|r|r.get(0))?;
+    let mut output=json!({"status":if issues {"partial"} else if complete {"ready"} else {"preparing"},"processed":processed,"continue":!complete,"cursor":{"phase":if scope=="mem:sessions" {"sessions"} else {"observations"},"scanned":scanned,"generation":generation.to_string()},"reason":reason,"decoded_bytes":decoded_bytes,
+        "source_bytes":source_bytes,"required_bytes":required_bytes,"elapsed_ms":start.elapsed().as_millis(),
+        "batch_limits":{"rows":limit,"decoded_bytes":max_bytes,"safety_ms":database::recent_preparation_duration(limit,max_bytes,max_ms).as_millis()}});
+    output["preparation"]=status(c)?;
+    Ok(output)
+}
+
+#[cfg(test)]
+mod batch_tests {
+    use super::*;
+    use std::time::Duration;
+
+    fn fixture() -> (tempfile::TempDir, std::path::PathBuf, Connection) {
+        let root=std::env::var("III_SQLITE_TEST_ROOT").expect("isolated III_SQLITE_TEST_ROOT must be set");
+        let directory=tempfile::tempdir_in(root).unwrap();
+        let path=directory.path().join("recent-batch.sqlite3");
+        let c=database::open(&path).unwrap();
+        (directory,path,c)
+    }
+
+    fn seed(c: &Connection, count: usize) -> usize {
+        let tx=c.unchecked_transaction().unwrap();
+        let mut bytes=0;
+        for i in 0..count {
+            let key=format!("session-{i:05}");
+            let value=json!({"id":key,"project":"P","startedAt":"2026-10-13T00:00:00Z"}).to_string();
+            bytes+=value.len();
+            tx.prepare_cached("INSERT INTO state_rows(scope,key,value,version,position,value_bytes) VALUES('mem:sessions',?1,?2,'1',NULL,?3)").unwrap()
+                .execute(params![key,value.as_bytes(),value.len() as i64]).unwrap();
+        }
+        tx.execute("DELETE FROM viewer_recent_dirty",[]).unwrap();
+        tx.commit().unwrap();
+        bytes
+    }
+
+    #[test]
+    fn initial_batch_exceeds_legacy_rows_without_elapsed_slice() {
+        let (_directory,_path,c)=fixture();
+        let bytes=seed(&c,513);
+        let tx=c.unchecked_transaction().unwrap();
+        let output=prepare(&tx,4096,32*1024*1024,1).unwrap();
+        assert_eq!(output["processed"],513);
+        assert_eq!(output["decoded_bytes"],bytes);
+        assert_eq!(output["preparation"]["ready"],true);
+        assert_eq!(tx.query_row("SELECT count(*) FROM viewer_recent_rows",[],|r|r.get::<_,i64>(0)).unwrap(),513);
+        tx.commit().unwrap();
+    }
+
+    #[test]
+    fn byte_boundary_preserves_next_source_and_zero_progress_is_explicit() {
+        let (_directory,_path,c)=fixture();
+        let bytes=seed(&c,2);
+        let per_row=bytes/2;
+        let first=prepare(&c,4096,per_row,1).unwrap();
+        assert_eq!(first["processed"],1);
+        assert_eq!(first["decoded_bytes"],per_row);
+        assert_eq!(first["reason"],"decode_budget_exceeded");
+        assert_eq!(first["required_bytes"],per_row);
+        let before=status(&c).unwrap();
+        let blocked=prepare(&c,4096,per_row-1,1).unwrap();
+        assert_eq!(blocked["processed"],0);
+        assert_eq!(blocked["required_bytes"],per_row);
+        assert_eq!(status(&c).unwrap(),before);
+        let final_cut=prepare(&c,4096,per_row,1).unwrap();
+        assert_eq!(final_cut["processed"],1);
+        assert_eq!(final_cut["preparation"]["ready"],true);
+    }
+
+    #[test]
+    fn tombstones_and_oversized_sources_never_claim_full_coverage() {
+        let (_directory,_path,c)=fixture();
+        c.execute("INSERT INTO state_rows VALUES('mem:sessions','gone',NULL,'1',NULL,0)",[]).unwrap();
+        c.execute("INSERT INTO state_rows VALUES('mem:sessions','huge',X'00','1',NULL,?1)",[SOURCE_MAX+1]).unwrap();
+        c.execute("DELETE FROM viewer_recent_dirty",[]).unwrap();
+        let output=prepare(&c,4096,32*1024*1024,1).unwrap();
+        assert_eq!(output["processed"],2);
+        assert_eq!(output["decoded_bytes"],0);
+        assert_eq!(output["status"],"partial");
+        assert_eq!(output["preparation"]["ready"],false);
+        assert_eq!(output["preparation"]["issues"],1);
+        assert_eq!(output["continue"],false);
+    }
+
+    #[test]
+    fn cancelled_recent_batch_rolls_back_projections_and_cursor() {
+        let (_directory,path,mut c)=fixture();
+        seed(&c,2);
+        let before=status(&c).unwrap();
+        let budget=database::PreparationBudget::new("viewer_recent_prepare",Duration::from_secs(30));
+        let cancel=budget.clone();
+        let result=database::run_preparation(&mut c,&path,&budget,false,|tx| {
+            let output=prepare(tx,4096,32*1024*1024,1)?;
+            cancel.cancel();
+            Ok(output)
+        });
+        assert!(result.is_err());
+        assert_eq!(status(&c).unwrap(),before);
+        assert_eq!(c.query_row("SELECT count(*) FROM viewer_recent_rows",[],|r|r.get::<_,i64>(0)).unwrap(),0);
+        assert!(prepare(&c,4096,32*1024*1024,1).is_ok());
+    }
+
+    #[test]
+    fn acknowledged_batch_lost_response_and_current_writes_reconcile() {
+        let (_directory,path,c)=fixture();
+        seed(&c,2);
+        let tx=c.unchecked_transaction().unwrap();
+        prepare(&tx,1,32*1024*1024,1).unwrap();
+        tx.commit().unwrap();
+        let checkpoint=status(&c).unwrap();
+        drop(c);
+        let c=database::open(&path).unwrap();
+        assert_eq!(status(&c).unwrap(),checkpoint);
+        let value=json!({"id":"session-00000","project":"P","startedAt":"2026-10-14T00:00:00Z"}).to_string();
+        c.execute("UPDATE state_rows SET value=?1,value_bytes=?2,version='2' WHERE scope='mem:sessions' AND key='session-00000'",params![value.as_bytes(),value.len() as i64]).unwrap();
+        assert_eq!(status(&c).unwrap()["dirty"],1);
+        prepare(&c,4096,32*1024*1024,1).unwrap();
+        assert_eq!(status(&c).unwrap()["ready"],true);
+        assert_eq!(c.query_row("SELECT version FROM viewer_recent_rows WHERE scope='mem:sessions' AND key='session-00000'",[],|r|r.get::<_,String>(0)).unwrap(),"2");
+    }
+
+    #[test]
+    fn request_defaults_and_finite_bounds_match_work_deadline() {
+        use super::super::super::request::{parse, Request};
+        let Request::ViewerRecentPrepare {limit,max_bytes,max_ms}=parse(json!({"action":"viewer_recent_prepare"})).unwrap() else {panic!("wrong request")};
+        assert_eq!((limit,max_bytes,max_ms),(4096,32*1024*1024,60_000));
+        assert_eq!(database::recent_preparation_duration(limit,max_bytes,max_ms),Duration::from_secs(60));
+        assert!(database::recent_preparation_duration(16_384,128*1024*1024,1)>Duration::from_secs(60));
+        assert!(parse(json!({"action":"viewer_recent_prepare","limit":16_384,"max_bytes":128*1024*1024,"max_ms":300_000})).is_ok());
+        for input in [json!({"action":"viewer_recent_prepare","limit":16_385}),json!({"action":"viewer_recent_prepare","max_bytes":128*1024*1024+1}),json!({"action":"viewer_recent_prepare","max_ms":300_001})] {
+            assert!(parse(input).is_err());
+        }
+    }
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/viewer_recent/projection.rs b/engine/src/workers/state/adapters/sqlite/retrieval/viewer_recent/projection.rs
new file mode 100644
index 0000000..8ee6209
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/viewer_recent/projection.rs
@@ -0,0 +1,71 @@
+use super::protocol;
+use serde_json::{Map,Value};
+
+const SESSIONS: &[&str] = &["id","project","agentId","startedAt","endedAt","status","observationCount","title","cwd","agent","firstPrompt","model","compressionMethod"];
+const OBSERVATIONS: &[&str] = &["id","sessionId","agentId","timestamp","type","title","subtitle","narrative","facts","concepts","files","importance","tokens","toolName","hookType","userPrompt","compressionMethod"];
+
+pub fn validate_fields(entity: &str, fields: &[String]) -> anyhow::Result<()> {
+    let allowed = if entity=="sessions" {SESSIONS} else {OBSERVATIONS};
+    protocol::require(!fields.is_empty() && fields.len()<=allowed.len()
+        && fields.iter().all(|field|allowed.contains(&field.as_str()))
+        && fields.iter().collect::<std::collections::HashSet<_>>().len()==fields.len())
+}
+
+pub(super) fn project(source: &Value, fields: &[String]) -> (Value,Vec<String>) {
+    let mut result=Map::new();
+    let mut truncated=Vec::new();
+    for field in fields {
+        let Some(value)=source.get(field) else {continue;};
+        let cap=if ["narrative","firstPrompt","userPrompt"].contains(&field.as_str()) {4096} else {2048};
+        let projected=match value {
+            Value::String(_) if ["id","sessionId"].contains(&field.as_str())=>value.clone(),
+            Value::String(text)=> {
+                let bounded:String=text.chars().take(cap).collect();
+                if bounded.len()!=text.len() {truncated.push(field.clone());}
+                Value::String(bounded)
+            }
+            Value::Array(values)=> {
+                let mut bounded=Vec::new();
+                let mut changed=values.len()>16;
+                for value in values.iter().take(16) {
+                    if let Some(text)=value.as_str() {
+                        let item:String=text.chars().take(256).collect();
+                        changed|=item.len()!=text.len();
+                        bounded.push(Value::String(item));
+                    } else {changed=true;}
+                }
+                if changed {truncated.push(field.clone());}
+                Value::Array(bounded)
+            }
+            Value::Null|Value::Bool(_)|Value::Number(_)=>value.clone(),
+            Value::Object(_)=> {truncated.push(field.clone());continue;}
+        };
+        result.insert(field.clone(),projected);
+    }
+    (Value::Object(result),truncated)
+}
+
+pub(super) fn shrink(value:&mut Value,truncated:&mut Vec<String>,cap:usize,array_cap:usize) {
+    let Some(fields)=value.as_object_mut() else {return;};
+    for (name,value) in fields {
+        if ["id","sessionId"].contains(&name.as_str()) {continue;}
+        let mut changed=false;
+        match value {
+            Value::String(text)=> {
+                let bounded:String=text.chars().take(cap).collect();
+                changed=bounded.len()!=text.len();*text=bounded;
+            }
+            Value::Array(values)=> {
+                changed=values.len()>array_cap;values.truncate(array_cap);
+                for item in values {
+                    if let Value::String(text)=item {
+                        let bounded:String=text.chars().take(cap).collect();
+                        changed|=bounded.len()!=text.len();*text=bounded;
+                    }
+                }
+            }
+            _=>{}
+        }
+        if changed && !truncated.contains(name) {truncated.push(name.clone());}
+    }
+}
diff --git a/engine/src/workers/state/adapters/sqlite/session_terminal.rs b/engine/src/workers/state/adapters/sqlite/session_terminal.rs
new file mode 100644
index 0000000..54c6bfc
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/session_terminal.rs
@@ -0,0 +1,96 @@
+use super::{database, protocol::{self, error}};
+use rusqlite::Connection;
+use serde::Deserialize;
+use serde_json::{Value, json};
+
+#[derive(Deserialize)]
+#[serde(tag = "action", rename_all = "snake_case", deny_unknown_fields)]
+pub(super) enum Request {
+    Complete { session_id: String, expected_version: String, ended_at: String },
+    RemoveInvalidStub { session_id: String, expected_version: String, expected_value: Value },
+}
+fn valid_text(value: &str, max: usize) -> bool {
+    !value.trim().is_empty() && value.len() <= max && !value.chars().any(char::is_control)
+}
+fn timestamp(value: &Value) -> bool {
+    value.as_str().is_some_and(|value| value.len() <= 64 && chrono::DateTime::parse_from_rfc3339(value).is_ok())
+}
+fn project_authority(value: &Value) -> bool {
+    match value.get("project") {
+        Some(Value::Null) => true,
+        Some(Value::String(project)) => project.trim().is_empty() || project.len() <= 256,
+        _ => false,
+    }
+}
+fn canonical(value: &Value, key: &str) -> bool {
+    value.is_object() && value["id"].as_str() == Some(key)
+        && project_authority(value)
+        && value["cwd"].as_str().is_some_and(|value| value.len() <= 32768)
+        && timestamp(&value["startedAt"])
+        && matches!(value["status"].as_str(), Some("active" | "completed" | "abandoned"))
+        && value["observationCount"].as_u64().is_some_and(|count| count <= 9_007_199_254_740_991)
+        && value.get("endedAt").is_none_or(timestamp)
+        && value.get("deleted") != Some(&Value::Bool(true))
+        && value.get("stale") != Some(&Value::Bool(true))
+}
+fn invalid_stub(value: &Value) -> bool {
+    value.as_object().is_some_and(|value| value.len() == 2 && value.contains_key("endedAt") && value.contains_key("status"))
+        && value["status"] == "completed" && timestamp(&value["endedAt"])
+        && protocol::size(value).is_ok_and(|bytes| bytes == 59)
+}
+pub(super) fn parse(input: Value) -> anyhow::Result<Request> {
+    if protocol::size(&input)? > 4096 { return Err(error("STATE_SESSION_INVALID_REQUEST")); }
+    let request: Request = serde_json::from_value(input).map_err(|_| error("STATE_SESSION_INVALID_REQUEST"))?;
+    let (key, version) = match &request {
+        Request::Complete { session_id, expected_version, ended_at } => {
+            if !timestamp(&json!(ended_at)) { return Err(error("STATE_SESSION_INVALID_REQUEST")); }
+            (session_id, expected_version)
+        }
+        Request::RemoveInvalidStub { session_id, expected_version, expected_value } => {
+            if !invalid_stub(expected_value) { return Err(error("STATE_SESSION_INVALID_REQUEST")); }
+            (session_id, expected_version)
+        }
+    };
+    if !valid_text(key, 256) || protocol::counter(version).is_err() || version == "0" {
+        return Err(error("STATE_SESSION_INVALID_REQUEST"));
+    }
+    Ok(request)
+}
+pub(super) fn execute(connection: &Connection, request: Request) -> anyhow::Result<Value> {
+    let (key, expected_version) = match &request {
+        Request::Complete { session_id, expected_version, .. }
+        | Request::RemoveInvalidStub { session_id, expected_version, .. } => (session_id, expected_version),
+    };
+    if database::row_work(connection, "mem:sessions", key)? > super::MAX_ENVELOPE_BYTES / 2 - 4096 {
+        return Err(error("STATE_RECORD_TOO_LARGE"));
+    }
+    let row = database::row(connection, "mem:sessions", key)?;
+    let old = row.value.ok_or_else(|| error("STATE_SESSION_NOT_FOUND"))?;
+    if row.version.to_string() != *expected_version { return Err(error("STATE_SESSION_CONFLICT")); }
+    match &request {
+        Request::Complete { ended_at, .. } => {
+            if !canonical(&old, key) { return Err(error("STATE_SESSION_INVALID_CANONICAL")); }
+            if old["status"] == "completed" && old.get("endedAt").is_some() {
+                return Ok(json!({"contract":"session_terminal_v1","action":"complete","session_id":key,
+                    "changed":false,"version":row.version.to_string(),"value":old}));
+            }
+            let mut value = old.clone();
+            value["endedAt"] = json!(ended_at);
+            value["status"] = json!("completed");
+            let version = database::write(connection, "mem:sessions", key, Some(&value))?;
+            Ok(json!({"contract":"session_terminal_v1","action":"complete","session_id":key,
+                "changed":true,"version":version.to_string(),"value":value,"old_value":old}))
+        }
+        Request::RemoveInvalidStub { expected_value, .. } => {
+            if !invalid_stub(&old) || old != *expected_value { return Err(error("STATE_SESSION_STUB_MISMATCH")); }
+            let observation_scope = format!("mem:obs:{key}");
+            let linked: bool = connection.query_row(
+                "SELECT EXISTS(SELECT 1 FROM state_rows WHERE scope=?1 AND value IS NOT NULL) OR EXISTS(SELECT 1 FROM state_rows WHERE scope='mem:summaries' AND key=?2 AND value IS NOT NULL)",
+                rusqlite::params![observation_scope, key], |row| row.get(0))?;
+            if linked { return Err(error("STATE_SESSION_STUB_REFERENCED")); }
+            let version = database::write(connection, "mem:sessions", key, None)?;
+            Ok(json!({"contract":"session_terminal_v1","action":"remove_invalid_stub","session_id":key,
+                "changed":true,"version":version.to_string(),"value":null,"old_value":old}))
+        }
+    }
+}
