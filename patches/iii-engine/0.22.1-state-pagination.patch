+#[test]
+fn sqlite_state_pool_migration_resumes_exact_checkpoint_and_reverse() {
+    let (dir, args) = fixture(5003);
+    let original = archive::file_digest(&args.source).unwrap();
+    assert!(
+        run_segment(&args, Some(4097), None)
+            .unwrap_err()
+            .to_string()
