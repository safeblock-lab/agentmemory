+use super::{database, protocol, snapshot_read_view::{Request, Views}};
+use rusqlite::{Connection, Transaction, TransactionBehavior};
+use serde_json::{Value, json};
+use std::{path::PathBuf, time::Duration};
+
+struct Fixture {
+    _directory: tempfile::TempDir,
+    path: PathBuf,
+    connection: Connection,
+    views: Views,
+    owner: String,
+    request: String,
+}
+impl Fixture {
+    fn new(padding: usize) -> Self {
+        let root = std::env::var("III_SQLITE_TEST_ROOT").expect("exclusive isolated III_SQLITE_TEST_ROOT is mandatory");
+        let directory = tempfile::tempdir_in(root).unwrap();
+        let path = directory.path().join("snapshot.sqlite3");
+        let connection = database::open(&path).unwrap();
+        connection.execute_batch("CREATE TABLE fixture_padding(value BLOB)").unwrap();
+        connection.execute("INSERT INTO fixture_padding VALUES(zeroblob(?1))",[i64::try_from(padding).unwrap()]).unwrap();
+        let mut views = Views::new(&path,uuid::Uuid::new_v4()).unwrap();
+        // Space refusal is exercised separately. Do not require 16 GiB just
+        // to run tiny semantic fixtures; the physical-capacity gate is separate.
+        views.fixture.free_bytes = Some(64 * 1024 * 1024 * 1024);
+        Self { _directory: directory,path,connection,views,owner:uuid::Uuid::new_v4().to_string(),request:uuid::Uuid::new_v4().to_string() }
+    }
+    fn capture(&mut self) -> anyhow::Result<Value> {
+        self.views.capture(&self.connection,self.owner.clone(),self.request.clone(),
+            &database::PreparationBudget::new("snapshot_fixture",Duration::from_secs(30)),|_,_| Ok(()))
+    }
+    fn get(&mut self, cut: &Value, scope: &str, key: &str) -> anyhow::Result<Value> {
+        self.views.execute(Request::Get { owner_id:self.owner.clone(),request_id:self.request.clone(),
+            handle:cut["handle"].as_str().unwrap().into(),generation:cut["generation"].as_str().unwrap().into(),scope:scope.into(),key:key.into() })
+    }
+}
+fn write_epoch(c: &Connection, epoch: u64) -> anyhow::Result<()> {
+    let tx = Transaction::new_unchecked(c,TransactionBehavior::Immediate)?;
+    for (scope,key) in [("mem:sessions","s"),("mem:memories","m"),("mem:graph:nodes","g"),("mem:obs:s","o")] {
+        database::write(&tx,scope,key,Some(&json!({"id":key,"epoch":epoch,"provenance":["original"]})))?;
+    }
+    database::write(&tx,"mem:access","m",Some(&json!({"memoryId":"m","epoch":epoch})))?;
+    tx.commit()?;
+    Ok(())
+}
+fn code(result: anyhow::Result<Value>) -> String {
+    let cause = result.unwrap_err();
+    cause.downcast_ref::<protocol::TxError>().map_or_else(|| cause.to_string(),|cause| cause.0.into())
+}
+
+#[test]
+fn snapshot_same_owner_updates_deletes_and_creates_one_completed_cut() {
+    let mut f = Fixture::new(3 * 1024 * 1024); write_epoch(&f.connection,1).unwrap();
+    database::write(&f.connection,"mem:memories","deleted",Some(&json!({"id":"deleted"}))).unwrap();
+    let mut turns = 0;
+    let cut = f.views.capture(&f.connection,f.owner.clone(),f.request.clone(),
+        &database::PreparationBudget::new("snapshot_fixture",Duration::from_secs(30)),|c,_| {
+            turns += 1;
+            if turns == 1 {
+                write_epoch(c,2)?;
+                let tx = Transaction::new_unchecked(c,TransactionBehavior::Immediate)?;
+                database::write(&tx,"mem:memories","deleted",None)?;
+                database::write(&tx,"mem:memories","created",Some(&json!({"id":"created","epoch":2})))?;
+                tx.commit()?;
+            }
+            database::wal_pressure(c,&f.path)?;
+            Ok(())
+        }).unwrap();
+    assert!(turns > 0,"fixture must actually interleave foreground work");
+    write_epoch(&f.connection,3).unwrap();
+    for (scope,key) in [("mem:sessions","s"),("mem:memories","m"),("mem:graph:nodes","g"),("mem:obs:s","o"),("mem:access","m")] {
+        assert_eq!(f.get(&cut,scope,key).unwrap()["value"]["epoch"],2);
+    }
+    assert_eq!(f.get(&cut,"mem:memories","created").unwrap()["value"]["epoch"],2);
+    assert_eq!(code(f.get(&cut,"mem:memories","deleted")),"STATE_SNAPSHOT_RECORD_MISSING");
+    f.views.cleanup().unwrap(); assert!(!f.views.busy());
+}
+
+#[test]
+fn snapshot_full_fifteen_mib_original_and_provenance_roundtrip() {
+    let mut f = Fixture::new(2 * 1024 * 1024);
+    let row = json!({"id":"o","raw":"x".repeat(15 * 1024 * 1024),"provenance":[{"source":"complete","revision":9}]});
+    database::write(&f.connection,"mem:obs:s","o",Some(&row)).unwrap();
+    let cut = f.capture().unwrap(); assert_eq!(f.get(&cut,"mem:obs:s","o").unwrap()["value"],row);
+    f.views.cleanup().unwrap();
+}
+
+#[test]
+fn snapshot_foreign_generation_expiry_and_single_view_refusals() {
+    let mut f = Fixture::new(0); let cut = f.capture().unwrap();
+    assert_eq!(code(f.capture()),"STATE_SNAPSHOT_BUSY");
+    let request = Request::Get { owner_id:uuid::Uuid::new_v4().to_string(),request_id:f.request.clone(),
+        handle:cut["handle"].as_str().unwrap().into(),generation:cut["generation"].as_str().unwrap().into(),scope:"mem:sessions".into(),key:"s".into() };
+    assert_eq!(code(f.views.execute(request)),"STATE_SNAPSHOT_FOREIGN");
