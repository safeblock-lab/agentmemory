+    assert_eq!(repaired["status"], "partial");
+    assert_eq!(catalog_snapshot(&connection).0, "partial");
+    assert_eq!(catalog_snapshot(&connection).1, position - 1);
+    assert_eq!(catalog_snapshot(&connection).4, 0);
+}
