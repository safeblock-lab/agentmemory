+            .await;
+            assert_eq!(checkpoint_after["version"], checkpoint_before["version"]);
+            let job_after = version(&adapter, JOBS, "crash-job", Some(recovery.clone())).await;
+            assert_eq!(job_after["version"], job_before["version"]);
+            let graph_after = version(
+                &adapter,
+                "mem:graph:nodes",
+                "a",
+                Some(recovery.clone()),
+            )
+            .await;
+            assert_eq!(
+                graph_after["value"],
+                json!({"weight":7})
+            );
+            assert_eq!(graph_after["version"], graph_before["version"]);
+            assert_eq!(
+                code(adapter.commit_batch(original_request).await.unwrap_err()),
+                "STATE_TX_FENCED"
+            );
+        }
+    }
+}
+
+fn contains_lease(control: &Value, expected: &Value) -> bool {
+    let fields = ["owner_id", "generation", "fence"];
+    if fields
+        .iter()
+        .all(|field| control.get(field) == expected.get(field))
+    {
+        return true;
+    }
+    match control {
+        Value::Array(values) => values.iter().any(|value| contains_lease(value, expected)),
+        Value::Object(values) => values
+            .values()
+            .any(|value| contains_lease(value, expected)),
+        _ => false,
+    }
+}
diff --git a/engine/src/workers/state/adapters/sqlite/database.rs b/engine/src/workers/state/adapters/sqlite/database.rs
new file mode 100644
index 0000000..06e6975
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/database.rs
@@ -0,0 +1,297 @@
+use super::protocol;
+use rusqlite::{Connection, OptionalExtension, functions::FunctionFlags, params, types::ValueRef};
+use serde_json::Value;
+use std::{path::Path, time::Duration};
+
+pub(crate) const APPLICATION_ID: i64 = 0x49494953;
+pub(crate) const FORMAT_VERSION: i64 = 2;
+pub const CONTROL_SCOPE: &str = "mem:graph:control";
+pub const CHECKPOINT_SCOPE: &str = "mem:graph:checkpoints";
+pub const RECEIPT_SCOPE: &str = "mem:graph:receipts";
+
+pub fn open(path: &Path) -> anyhow::Result<Connection> {
+    let mut marker = path.as_os_str().to_owned();
+    marker.push(".migration-pending");
+    if Path::new(&marker).exists() {
+        anyhow::bail!("STATE_MIGRATION_INCOMPLETE: shadow target is not ready");
+    }
+    if path.is_file() {
+        let prior = Connection::open_with_flags(path, rusqlite::OpenFlags::SQLITE_OPEN_READ_ONLY)?;
+        let exists: i64 = prior.query_row(
+            "SELECT count(*) FROM sqlite_master WHERE type='table' AND name='state_migration'",
+            [],
+            |r| r.get(0),
+        )?;
+        if exists != 0 {
+            let ready: String =
+                prior.query_row("SELECT status FROM state_migration WHERE id=1", [], |r| {
+                    r.get(0)
+                })?;
+            if ready != "ready" {
+                anyhow::bail!("STATE_MIGRATION_INCOMPLETE: shadow target is not ready");
+            }
+        }
+    }
+    let connection = open_for_migration(path)?;
+    let pending: i64 = connection.query_row(
+        "SELECT count(*) FROM sqlite_master WHERE type='table' AND name='state_migration'",
+        [],
+        |r| r.get(0),
+    )?;
+    if pending != 0 {
+        let ready: String =
+            connection.query_row("SELECT status FROM state_migration WHERE id=1", [], |r| {
+                r.get(0)
+            })?;
+        if ready != "ready" {
+            anyhow::bail!("STATE_MIGRATION_INCOMPLETE: shadow target is not ready");
+        }
+    }
+    Ok(connection)
+}
+
+pub(crate) fn open_for_migration(path: &Path) -> anyhow::Result<Connection> {
+    if path.is_dir() {
+        anyhow::bail!(
+            "SQLite file_path must name a database file; migration is required for legacy directories"
+        );
+    }
+    if let Some(parent) = path.parent().filter(|p| !p.as_os_str().is_empty()) {
+        std::fs::create_dir_all(parent)?;
+    }
+    let connection = Connection::open(path)?;
+    register_value_function(&connection)?;
+    let application: i64 = connection.pragma_query_value(None, "application_id", |r| r.get(0))?;
+    let version: i64 = connection.pragma_query_value(None, "user_version", |r| r.get(0))?;
+    let tables: i64 = connection.query_row(
+        "SELECT count(*) FROM sqlite_master WHERE type='table'",
+        [],
+        |r| r.get(0),
+    )?;
+    let compatible = if tables == 0 {
+        (application == 0 || application == APPLICATION_ID)
+            && (version == 0 || version == FORMAT_VERSION)
+    } else {
+        application == APPLICATION_ID && version == FORMAT_VERSION
+    };
+    if !compatible {
+        anyhow::bail!("Unsupported SQLite state format; explicit migration is required");
+    }
+    connection.busy_timeout(Duration::from_secs(5))?;
+    connection.execute_batch("PRAGMA journal_mode=WAL; PRAGMA synchronous=FULL; PRAGMA cache_size=-65536; PRAGMA mmap_size=0; PRAGMA temp_store=FILE; PRAGMA wal_autocheckpoint=1024; PRAGMA journal_size_limit=67108864; PRAGMA foreign_keys=ON;
+        CREATE TABLE IF NOT EXISTS state_scopes(scope TEXT PRIMARY KEY, revision TEXT NOT NULL, next_position INTEGER NOT NULL) WITHOUT ROWID;
+        CREATE TABLE IF NOT EXISTS state_rows(scope TEXT NOT NULL, key TEXT NOT NULL, value BLOB, version TEXT NOT NULL, position INTEGER, value_bytes INTEGER NOT NULL, PRIMARY KEY(scope,key)) WITHOUT ROWID;
+        CREATE INDEX IF NOT EXISTS state_rows_order ON state_rows(scope,position) WHERE value IS NOT NULL;")?;
+    connection.pragma_update(None, "application_id", APPLICATION_ID)?;
+    connection.pragma_update(None, "user_version", FORMAT_VERSION)?;
+    {
+        let transaction = connection.unchecked_transaction()?;
+        super::retrieval::initialize(&transaction)?;
+        transaction.commit()?;
+    }
+    {
+        let transaction = rusqlite::Transaction::new_unchecked(
+            &connection,
+            rusqlite::TransactionBehavior::Immediate,
+        )?;
+        if row(&transaction, CONTROL_SCOPE, "current")?.value.is_none() {
+            write(
+                &transaction,
+                CONTROL_SCOPE,
+                "current",
+                Some(
+                    &serde_json::json!({"version":1,"generation":"1","fence":"0","lease":null,"recovery":null}),
+                ),
+            )?;
+        }
+        transaction.commit()?;
+    }
+    Ok(connection)
+}
+
+fn register_value_function(connection: &Connection) -> anyhow::Result<()> {
+    connection.create_scalar_function(
+        "state_json",
+        2,
+        FunctionFlags::SQLITE_UTF8
+            | FunctionFlags::SQLITE_DETERMINISTIC
+            | FunctionFlags::SQLITE_INNOCUOUS,
+        |context| {
+            if matches!(context.get_raw(0), ValueRef::Null) {
+                return Ok(None::<String>);
+            }
+            let encoded = match context.get_raw(0) {
+                ValueRef::Blob(encoded) | ValueRef::Text(encoded) => encoded,
+                value => {
+                    return Err(rusqlite::Error::InvalidFunctionParameterType(
+                        0,
+                        value.data_type(),
+                    ));
+                }
+            };
+            let logical_bytes = context.get::<i64>(1)?;
+            let logical_bytes = usize::try_from(logical_bytes)
+                .map_err(|error| rusqlite::Error::UserFunctionError(Box::new(error)))?;
+            let decoded = super::codec::decode(encoded, logical_bytes)
+                .map_err(|error| rusqlite::Error::UserFunctionError(error.into()))?;
+            Ok(Some(decoded))
+        },
+    )?;
+    Ok(())
+}
+
+pub fn wal_pressure(connection: &Connection, path: &Path) -> anyhow::Result<()> {
+    let wal = std::path::PathBuf::from(format!("{}-wal", path.display()));
+    let bytes = match std::fs::metadata(&wal) {
+        Ok(metadata) => metadata.len(),
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => 0,
+        Err(error) => return Err(error.into()),
+    };
+    if bytes >= 32 * 1024 * 1024 {
+        let (busy, _, _): (i64, i64, i64) =
+            connection.query_row("PRAGMA wal_checkpoint(TRUNCATE)", [], |r| {
+                Ok((r.get(0)?, r.get(1)?, r.get(2)?))
+            })?;
+        if busy != 0 && bytes >= 64 * 1024 * 1024 {
+            return Err(protocol::error("STATE_TX_LIMIT_EXCEEDED"));
+        }
+    }
+    Ok(())
+}
+
+pub struct Row {
+    pub value: Option<Value>,
+    pub version: u64,
+    pub position: Option<i64>,
+}
+
+pub fn decode_value(encoded: &[u8], logical_bytes: i64) -> anyhow::Result<String> {
+    let logical_bytes = usize::try_from(logical_bytes)?;
+    Ok(super::codec::decode(encoded, logical_bytes)?)
+}
+
+pub fn row(connection: &Connection, scope: &str, key: &str) -> anyhow::Result<Row> {
+    let raw: Option<(Option<Vec<u8>>, String, Option<i64>, i64)> = connection
+        .query_row(
+            "SELECT value,version,position,value_bytes FROM state_rows WHERE scope=?1 AND key=?2",
+            params![scope, key],
+            |r| Ok((r.get(0)?, r.get(1)?, r.get(2)?, r.get(3)?)),
+        )
+        .optional()?;
+    match raw {
+        None => Ok(Row {
+            value: None,
+            version: 0,
+            position: None,
+        }),
+        Some((value, version, position, value_bytes)) => Ok(Row {
+            value: value
+                .map(|encoded| {
+                    decode_value(&encoded, value_bytes)
+                        .and_then(|value| Ok(serde_json::from_str(&value)?))
+                })
+                .transpose()?,
+            version: protocol::counter(&version)?,
+            position,
+        }),
+    }
+}
+pub fn revision(connection: &Connection, scope: &str) -> anyhow::Result<u64> {
+    let version: Option<String> = connection
+        .query_row(
+            "SELECT revision FROM state_scopes WHERE scope=?1",
+            [scope],
+            |r| r.get(0),
+        )
+        .optional()?;
+    version.map_or(Ok(0), |v| protocol::counter(&v))
+}
+
+pub fn scope_revision(connection: &Connection, scope: &str, prefix: bool) -> anyhow::Result<String> {
+    if !prefix {
+        return Ok(revision(connection, scope)?.to_string());
+    }
+
+    let upper = scope_prefix_upper_bound(scope)?;
+    let mut statement = connection.prepare(
+        "SELECT revision FROM state_scopes WHERE scope>=?1 AND scope<?2 ORDER BY scope",
+    )?;
+    let mut rows = statement.query(params![scope, upper])?;
+    let mut count = 0u64;
+    let mut total = 0u128;
+    while let Some(row) = rows.next()? {
+        let value: String = row.get(0)?;
+        total = total
+            .checked_add(u128::from(protocol::counter(&value)?))
+            .ok_or_else(|| protocol::error("STATE_TX_LIMIT_EXCEEDED"))?;
+        count = count
+            .checked_add(1)
+            .ok_or_else(|| protocol::error("STATE_TX_LIMIT_EXCEEDED"))?;
+    }
+    Ok(format!("{count}:{total}"))
+}
+
+fn scope_prefix_upper_bound(prefix: &str) -> anyhow::Result<String> {
+    if prefix.is_empty() || !prefix.is_ascii() || prefix.as_bytes().contains(&0) {
+        anyhow::bail!("STATE_SCOPE_REVISION_INVALID_REQUEST");
+    }
+    let mut bytes = prefix.as_bytes().to_vec();
+    let last = bytes.len() - 1;
+    if bytes[last] == u8::MAX {
+        anyhow::bail!("STATE_SCOPE_REVISION_INVALID_REQUEST");
+    }
+    bytes[last] += 1;
+    String::from_utf8(bytes).map_err(Into::into)
+}
+pub fn write(
+    connection: &Connection,
+    scope: &str,
+    key: &str,
+    value: Option<&Value>,
+) -> anyhow::Result<u64> {
+    let old = row(connection, scope, key)?;
+    let version = protocol::next(old.version)?;
+    let revision = protocol::next(revision(connection, scope)?)?;
+    connection.execute(
+        "INSERT OR IGNORE INTO state_scopes VALUES(?1,'0',0)",
+        [scope],
+    )?;
+    let position = if value.is_some() {
+        match old.position.filter(|_| old.value.is_some()) {
+            Some(position) => Some(position),
+            None => {
+                let position: i64 = connection.query_row(
+                    "SELECT next_position FROM state_scopes WHERE scope=?1",
+                    [scope],
+                    |r| r.get(0),
+                )?;
+                if position >= 9_007_199_254_740_990 {
+                    return Err(protocol::error("STATE_TX_LIMIT_EXCEEDED"));
+                }
+                connection.execute(
+                    "UPDATE state_scopes SET next_position=?2 WHERE scope=?1",
+                    params![scope, position + 1],
+                )?;
+                Some(position)
+            }
+        }
+    } else {
+        None
+    };
+    let serialized = value.map(serde_json::to_string).transpose()?;
+    let bytes = serialized.as_ref().map_or(0, String::len);
+    let encoded = serialized
+        .as_deref()
+        .map(super::codec::encode)
+        .transpose()?;
+    let bytes = i64::try_from(bytes)?;
+    connection.execute("INSERT INTO state_rows VALUES(?1,?2,?3,?4,?5,?6) ON CONFLICT(scope,key) DO UPDATE SET value=excluded.value,version=excluded.version,position=excluded.position,value_bytes=excluded.value_bytes",
+        params![scope,key,encoded,version.to_string(),position,bytes])?;
+    connection.execute(
+        "UPDATE state_scopes SET revision=?2 WHERE scope=?1",
+        params![scope, revision.to_string()],
+    )?;
+    super::retrieval::maintain(connection, scope, key, value, position)?;
+    super::retrieval::source_changed(connection, scope, key, &old, value, version)?;
+    Ok(version)
+}
diff --git a/engine/src/workers/state/adapters/sqlite/format_tests.rs b/engine/src/workers/state/adapters/sqlite/format_tests.rs
