+}
+fn assert_temporal_deferred(result: Value) {
+    assert_eq!(result,json!({"deleted_count":0,"deleted_bytes":0,"deleted_logical_bytes":0,"deleted_stored_bytes":0,"cursor":{"scope_index":0,"after_key":""},"done":false}));
+}
+async fn technical(adapter: &SqliteAdapter, scope: &str, key: &str, stale: bool, parent: bool) -> Value {
+    let scope = scope.to_owned(); let key = key.to_owned();
+    adapter.run(4096,move |connection| {
+        let version = database::row_version(connection,&scope,&key)?;
+        let mut candidate = json!({"scope":scope,"key":key,"expected_version":if stale {"0".to_owned()} else {version.to_string()}});
+        if parent { candidate["preserved"] = json!({"scope":storage_prune::TEMPORAL_WORK,"key":TEMP_MANIFEST,"expected_version":database::row_version(connection,storage_prune::TEMPORAL_WORK,TEMP_MANIFEST)?.to_string()}); }
+        storage_prune::prune(connection,serde_json::from_value(json!([candidate]))?,4096)
+    }).await.unwrap()
+}
