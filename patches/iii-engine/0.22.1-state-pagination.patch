+fn fixture() -> (tempfile::TempDir, MigrationArgs) {
+    let root = std::env::var_os("III_SQLITE_TEST_ROOT").expect("III_SQLITE_TEST_ROOT required");
+    let directory = tempfile::tempdir_in(root).unwrap();
+    let source = directory.path().join("frozen-v1.sqlite3");
+    let connection = Connection::open(&source).unwrap();
+    connection.execute_batch("CREATE TABLE state_scopes(scope TEXT PRIMARY KEY,revision TEXT NOT NULL,next_position INTEGER NOT NULL) WITHOUT ROWID;
+        CREATE TABLE state_rows(scope TEXT NOT NULL,key TEXT NOT NULL,value TEXT,version TEXT NOT NULL,position INTEGER,value_bytes INTEGER NOT NULL,PRIMARY KEY(scope,key)) WITHOUT ROWID;
+        CREATE INDEX state_rows_order ON state_rows(scope,position) WHERE value IS NOT NULL;
+        CREATE TABLE retrieval_membership(epoch INTEGER NOT NULL,observation TEXT NOT NULL,key TEXT NOT NULL,position INTEGER NOT NULL,PRIMARY KEY(epoch,observation,key)) WITHOUT ROWID;
+        CREATE INDEX retrieval_membership_key ON retrieval_membership(epoch,key);
+        CREATE TABLE state_migration(id INTEGER PRIMARY KEY,manifest TEXT NOT NULL,status TEXT NOT NULL);
+        INSERT INTO state_migration VALUES(1,'original-history','ready');
+        CREATE VIRTUAL TABLE retrieval_lexical USING fts5(index_id UNINDEXED,epoch UNINDEXED,id UNINDEXED,text);
+        INSERT INTO retrieval_lexical(rowid,index_id,epoch,id,text) VALUES(17,'index',1,'item','preserved lexical terms');
+        INSERT INTO state_scopes VALUES('ordinary','99',4);") .unwrap();
+    let values = [
+        Some(format!(
+            "{{  \"text\":\"{}\",\"n\":9007199254740993 }}",
+            "repeat/".repeat(4096)
+        )),
+        Some("null".into()),
+        None,
+    ];
+    for (index, value) in values.iter().enumerate() {
+        connection
+            .execute(
+                "INSERT INTO state_rows VALUES('ordinary',?1,?2,?3,?4,?5)",
+                params![
+                    format!("key-{index}"),
+                    value,
+                    (index + 11).to_string(),
+                    value.as_ref().map(|_| index as i64),
+                    value.as_ref().map_or(0, |v| v.len()) as i64
+                ],
+            )
+            .unwrap();
+    }
+    for (observation, key, position) in [
+        ("shared", "node-z", 8),
+        ("node-z", "shared", 3),
+        ("unicode-ñ😀", "node-a", 9),
