+async fn sqlite_terminal_retention_closes_replay_and_preserves_published_graph() {
+    for reset in [false, true] {
+        let (directory, adapter) = fresh();
+        let owner = guard(&adapter, "retention", "1").await;
+        let id = "retention-job-%_quoted\"";
+        let mut operations = vec![
+            op(JOBS, id, "0", job(id, "1")),
+            op(
+                WORKING,
+                id,
+                "0",
+                working(id, "1", "delta:0", Some(json!({"active":true}))),
+            ),
+        ];
+        for prefix in protocol::PREFIXES {
+            operations.push(op(
+                &format!("{prefix}{id}"),
+                "captured",
+                "0",
+                json!({"temporary":"payload"}),
+            ));
+        }
+        let first = batch(owner.clone(), id, "delta:0", 0, "0", "staging", operations);
+        adapter.commit_batch(first.clone()).await.unwrap();
+        let mut final_body: Value = serde_json::from_str(batch(owner.clone(),id,"delta:0",1,"1","complete",vec![
+            op(JOBS,id,"1",json!({"version":1,"id":id,"generation":"1","state":"completed","result":{"value":7}})),
+            op(SNAPSHOT,"current","0",json!({"active":true})),
+            op("mem:graph:nodes","node","0",json!({"weight":3,"sourceObservationIds":["obs"]})),
+        ])["payload_json"].as_str().unwrap()).unwrap();
+        if reset {
+            final_body["advance_generation"] = json!(true);
+        }
+        let closing = prepared(owner.clone(), final_body);
+        let receipt = adapter.commit_batch(closing.clone()).await.unwrap();
+        let current = if reset {
+            guard(&adapter, "replacement", "2").await
+        } else {
+            owner.clone()
+        };
+        let mut replay = closing.clone();
+        replay["guard"] = current.clone();
+        assert_eq!(adapter.commit_batch(replay.clone()).await.unwrap(), receipt);
+        drop(adapter);
+        let adapter = Arc::new(
+            SqliteAdapter::new(Some(
+                json!({"file_path":directory.path().join("synthetic.sqlite3")}),
+            ))
+            .unwrap(),
+        );
+        assert_eq!(adapter.commit_batch(replay).await.unwrap(), receipt);
+        assert_eq!(
+            adapter.list(database::RECEIPT_SCOPE).await.unwrap().len(),
+            1
+        );
+        for prefix in protocol::PREFIXES {
+            assert!(
+                adapter
+                    .list(&format!("{prefix}{id}"))
+                    .await
+                    .unwrap()
+                    .is_empty()
+            );
+        }
+        assert_eq!(adapter.get(WORKING, id).await.unwrap(), None);
+        assert_eq!(
+            adapter.get(SNAPSHOT, "current").await.unwrap(),
+            Some(json!({"active":true}))
+        );
+        assert_eq!(
+            adapter.get("mem:graph:nodes", "node").await.unwrap(),
+            Some(json!({"weight":3,"sourceObservationIds":["obs"]}))
+        );
+        let mut old_replay = first;
+        old_replay["guard"] = current.clone();
+        assert_eq!(
+            code(adapter.commit_batch(old_replay).await.unwrap_err()),
+            if reset {
+                "STATE_TX_GENERATION_STALE"
+            } else {
+                "STATE_TX_CHECKPOINT_CONFLICT"
+            }
+        );
+        if !reset {
+            let unseen = prepared(
+                current,
+                json!({"identity":{"generation":"1","job_id":id,"logical_delta_id":"delta:1","chunk_ordinal":0},
+                "expected_checkpoint_version":"2","checkpoint":{"generation":"1","job_id":id,"logical_delta_id":"delta:1","delta_ordinal":1,"next_chunk_ordinal":1,"visibility":"staging"},
+                "operations":[op(JOBS,id,"2",job(id,"1"))]}),
+            );
+            assert_eq!(
+                code(adapter.commit_batch(unseen).await.unwrap_err()),
+                "STATE_TX_CHECKPOINT_CONFLICT"
+            );
+        }
+        assert_eq!(
+            adapter.list(database::RECEIPT_SCOPE).await.unwrap().len(),
+            1
+        );
+    }
+}
