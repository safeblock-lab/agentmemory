+
+#[tokio::test]
+async fn sqlite_shadow_exact_resume_fts_and_reverse_preserve_later_writes() {
+    let (_directory, args) = fixture();
+    assert!(
+        run_segment(&args, Some(2), None)
+            .unwrap_err()
+            .to_string()
+            .contains("interruption")
+    );
+    assert!(
+        database::open(&args.target)
+            .unwrap_err()
+            .to_string()
+            .contains("INCOMPLETE")
+    );
+    run(&args).unwrap();
+    let connection = database::open(&args.target).unwrap();
+    assert_eq!(
+        connection
+            .query_row("SELECT manifest FROM state_migration", [], |r| r
+                .get::<_, String>(0))
+            .unwrap(),
+        "original-history"
+    );
+    assert_eq!(
+        connection
+            .query_row(
+                "SELECT typeof(value) FROM state_rows WHERE key='key-0'",
+                [],
+                |r| r.get::<_, String>(0)
+            )
+            .unwrap(),
+        "blob"
+    );
+    assert_eq!(
+        connection
+            .query_row(
+                "SELECT rowid FROM retrieval_lexical WHERE retrieval_lexical MATCH 'preserved'",
+                [],
+                |r| r.get::<_, i64>(0)
+            )
+            .unwrap(),
+        17
+    );
+    assert_eq!(
+        database::row(&connection, "ordinary", "key-2")
+            .unwrap()
+            .version,
+        13
+    );
+    drop(connection);
+    let adapter = SqliteAdapter::new(Some(json!({"file_path":args.target}))).unwrap();
+    let expected = adapter.get("ordinary", "key-0").await.unwrap().unwrap();
+    assert_eq!(expected["n"], json!(9007199254740993u64));
+    let page = adapter
+        .list_page("ordinary", None, 1, 1024 * 1024)
+        .await
+        .unwrap();
+    assert_eq!(page.items.len(), 1);
+    adapter
+        .set("ordinary", "later", json!({"post_cutover":true}))
+        .await
+        .unwrap();
+    adapter.delete("ordinary", "key-1").await.unwrap();
+    adapter.destroy().await.unwrap();
+    drop(adapter);
+    // The worker owns its connection until it drains the channel after drop.
+    for _ in 0..100 {
+        let wal = PathBuf::from(format!("{}-wal", args.target.display()));
+        if !wal.exists() || fs::metadata(&wal).unwrap().len() == 0 {
+            break;
+        }
+        std::thread::sleep(std::time::Duration::from_millis(10));
+    }
+    let reverse = MigrationArgs {
+        source: args.target.clone(),
+        target: args.target.with_file_name("rollback-v1.sqlite3"),
+        disk_budget_bytes: 128 * 1024 * 1024,
+        reverse: true,
+    };
+    run(&reverse).unwrap();
+    let rollback = Connection::open(&reverse.target).unwrap();
+    assert_eq!(
+        rollback
+            .pragma_query_value(None, "user_version", |r| r.get::<_, i64>(0))
+            .unwrap(),
+        1
+    );
+    assert_eq!(
+        rollback
+            .query_row("SELECT value FROM state_rows WHERE key='later'", [], |r| {
+                r.get::<_, String>(0)
+            })
+            .unwrap(),
+        "{\"post_cutover\":true}"
+    );
+    assert!(
+        rollback
+            .query_row("SELECT value FROM state_rows WHERE key='key-1'", [], |r| {
+                r.get::<_, Option<String>>(0)
+            })
+            .unwrap()
+            .is_none()
+    );
+    assert_eq!(
+        rollback
+            .query_row("SELECT count(*) FROM retrieval_membership", [], |r| r
+                .get::<_, i64>(0))
+            .unwrap(),
+        3
+    );
+    assert_eq!(
+        rollback
+            .query_row(
+                "SELECT rowid FROM retrieval_lexical WHERE retrieval_lexical MATCH 'preserved'",
+                [],
+                |r| r.get::<_, i64>(0)
+            )
+            .unwrap(),
+        17
+    );
+}
+
+#[test]
+fn sqlite_shadow_rejects_changed_source_and_nonempty_wal() {
+    let (_directory, args) = fixture();
+    assert!(run_segment(&args, Some(2), None).is_err());
+    let connection = Connection::open(&args.source).unwrap();
+    connection
+        .execute("UPDATE state_scopes SET revision='100'", [])
+        .unwrap();
+    drop(connection);
+    assert!(run(&args).unwrap_err().to_string().contains("identity"));
+    let (_directory, args) = fixture();
+    fs::write(format!("{}-wal", args.source.display()), b"uncheckpointed").unwrap();
+    assert!(run(&args).unwrap_err().to_string().contains("journal"));
+    assert!(!args.target.exists());
+}
+
+#[test]
+fn sqlite_shadow_metadata_fence_survives_sidecar_loss() {
+    let (_directory, args) = fixture();
+    assert!(run_segment(&args, Some(2), None).is_err());
+    fs::remove_file(format!("{}.migration-pending", args.target.display())).unwrap();
+    let before = archive::file_digest(&args.target).unwrap();
+    assert!(
+        database::open(&args.target)
+            .unwrap_err()
+            .to_string()
+            .contains("INCOMPLETE")
+    );
