+    let result = call(&c, request(16)).unwrap();
+    assert_eq!(result["status"], "ready", "{result}");
+    assert_eq!(result["processed"], 1);
+    assert_eq!(proof(&c, "a"), Some(("1".to_owned(), false)));
+    assert_eq!(
