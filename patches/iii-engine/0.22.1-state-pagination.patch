+    let (_directory,path,mut connection)=fixture(); let grant=grant(1); let id=identity("operation-1");
+    claim(&mut connection,&grant,&id); consume(&mut connection,&grant,&id,"spent").unwrap();
+    let adapter=SqliteAdapter::new(Some(json!({"file_path":path}))).unwrap();
+    for scope in ["engine_provider_budget_operations","mem:provider-budget","mem:operations"] {
+        adapter.set(scope,"operation-1",json!({"ceiling":9999,"state":"available"})).await.unwrap();
+        adapter.delete(scope,"operation-1").await.unwrap();
+        assert!(adapter.list(scope).await.unwrap().is_empty());
+    }
+    let revision=database::row(&connection,"mem:recent-operations","current").unwrap().version.to_string();
+    storage_operations::prune(&connection,&revision).unwrap();
+    let candidates=serde_json::from_value::<Vec<storage_prune::Candidate>>(json!([
+        {"scope":"engine_provider_budget_windows","key":"window-1","expected_version":"0"},
+        {"scope":"engine_provider_budget_operations","key":"operation-1","expected_version":"0"}
+    ])).unwrap();
+    storage_prune::prune(&connection,candidates,4096).unwrap();
+    assert!(!adapter.list_groups().await.unwrap().iter().any(|scope|scope.starts_with("engine_provider_budget_windows")));
+    assert_eq!(status(&mut connection,&grant,&id.operation_id)["receipt"]["consumed"],1);
