+#[test]
+fn canonical_scoped_current_legacy_kv_restores_without_global_source_coverage() {
+    let c = fixture();
+    assert!(proof(&c, "a").is_none());
+    let result = call(&c, request(16)).unwrap();
+    assert_eq!(result["status"], "ready", "{result}");
+    assert_eq!(result["processed"], 1);
+    assert_eq!(proof(&c, "a"), Some(("1".to_owned(), false)));
+    assert_eq!(
+        source::status(&c, "observations").unwrap()["coverage_ready"],
+        false
+    );
+    assert!(!project_vectors::ready(&c, "observations", 1).unwrap());
+    assert_ready_hit(&c);
+}
