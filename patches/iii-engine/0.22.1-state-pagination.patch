+    for id in ["a", "b"] {
+        observation(&c, id, "s", "needle");
+        let mut value = database::row(&c, "mem:obs:s", id).unwrap().value.unwrap();
+        value["narrative"] = json!(format!("needle {}", "x".repeat(700000)));
+        write(&c, "mem:obs:s", id, Some(&value));
+        embed(&c, id, "s");
+    }
+    c.execute("DELETE FROM retrieval_scoped_postings", [])
+        .unwrap();
+    c.execute("DELETE FROM retrieval_scoped_lexical", [])
+        .unwrap();
+    c.execute("DELETE FROM retrieval_scoped_vectors", [])
+        .unwrap();
