index 0000000..feeb4df
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/project_catalog/prepare.rs
@@ -0,0 +1,96 @@
+use super::super::super::{database, protocol};
+use super::{MAX_PAGE_BYTES, MAX_PAGE_ROWS};
+use rusqlite::{Connection, params};
+use serde_json::{Value, json};
+
+pub fn prepare(connection: &Connection, source: &str, max_rows: usize, max_bytes: usize) -> anyhow::Result<Value> {
+    let scope = super::source_scope(source).ok_or_else(|| protocol::error("STATE_TX_INVALID_REQUEST"))?;
+    protocol::require((1..=1024).contains(&max_rows) && (1024..=super::super::request::MAX_GRAPH_PREPARATION_WORK_BYTES).contains(&max_bytes))?;
+    let (mut status, mut cursor, mut revision, mut epoch, mut incomplete): (String, i64, String, i64, i64) = super::catalog_row(connection, source)?;
+    let current_revision = database::revision(connection, scope)?.to_string();
+    if revision != current_revision {
+        super::reset_epoch(connection, source, &current_revision, epoch)?;
+        epoch += 1;
+        status = "pending".into();
+        cursor = -1;
+        revision = current_revision;
+        incomplete = 0;
+    }
+    if status == "ready" {
+        return Ok(json!({"status":status,"source":source,"cursor":cursor.to_string(),"revision":revision,"processed":0,"indexed_projects":project_count(connection,source,epoch)?,"incomplete_rows":incomplete.to_string()}));
+    }
+    let sql = "SELECT key,position,CAST(version AS TEXT),value_bytes,length(CAST(value AS BLOB)) FROM state_rows INDEXED BY state_rows_order WHERE scope=?1 AND value IS NOT NULL AND position>?2 ORDER BY position LIMIT ?3";
+    let mut statement = connection.prepare(sql)?;
+    let mut rows = statement.query(params![scope,cursor,(max_rows+1) as i64])?;
+    let mut processed = 0usize;
+    let mut bytes = 0usize;
+    let mut more = false;
+    while let Some(row) = rows.next()? {
+        if processed == max_rows { more = true; break; }
+        let key: String = row.get(0)?;
+        let position: i64 = row.get(1)?;
+        let version: String = row.get(2)?;
+        let logical_bytes: i64 = row.get(3)?;
+        let stored_bytes: i64 = row.get(4)?;
+        let source_max = super::super::super::codec::MAX_LOGICAL_VALUE_BYTES as i64;
+        if !(1..=source_max).contains(&logical_bytes) || !(1..=source_max).contains(&stored_bytes) {
+            super::set_scanned_unknown(connection, source, epoch, &key, &version)?;
+            cursor = position;
+            processed += 1;
+            continue;
+        }
+        let row_bytes = (logical_bytes as usize).saturating_add(stored_bytes as usize).saturating_add(key.len());
+        if bytes.saturating_add(row_bytes) > max_bytes {
+            if processed == 0 { return Ok(json!({"status":"pending","source":source,"cursor":cursor.to_string(),"revision":revision,"processed":0,"reason":"preparation_resource_limit","required_bytes":row_bytes})); }
+            more = true;
+            break;
+        }
+        match super::extraction::read(connection,scope,&key,&version,logical_bytes,stored_bytes)? {
+            Some(value) => super::extraction::project(connection,source,epoch,&key,&value,&version,position)?,
+            None => { super::remove_scanned(connection,source,epoch,&key)?; super::set_scanned_unknown(connection,source,epoch,&key,&version)?; }
+        }
+        cursor = position;
+        processed += 1;
+        bytes += row_bytes;
+    }
+    if !more {
+        let incomplete_now: i64 = connection.query_row("SELECT incomplete_rows FROM retrieval_project_catalog WHERE source=?1",[source],|r|r.get(0))?;
+        status = if incomplete_now == 0 { "ready" } else { "partial" }.into();
+    } else {
+        status = "pending".into();
+    }
+    connection.execute("UPDATE retrieval_project_catalog SET status=?2,cursor=?3,revision=?4 WHERE source=?1",params![source,status,cursor,revision])?;
+    incomplete = connection.query_row("SELECT incomplete_rows FROM retrieval_project_catalog WHERE source=?1",[source],|r|r.get(0))?;
+    Ok(json!({"status":status,"source":source,"cursor":cursor.to_string(),"revision":revision,"processed":processed,"indexed_projects":project_count(connection,source,epoch)?,"incomplete_rows":incomplete.to_string()}))
+}
+
+fn project_count(connection: &Connection, source: &str, epoch: i64) -> anyhow::Result<i64> {
+    connection.query_row("SELECT count(*) FROM retrieval_project_counts WHERE source=?1 AND epoch=?2",params![source,epoch],|row|row.get(0)).map_err(Into::into)
+}
+
+pub fn page(connection: &Connection, cursor: Option<&str>, limit: usize, max_bytes: usize) -> anyhow::Result<Value> {
+    protocol::require((1..=MAX_PAGE_ROWS).contains(&limit) && (1024..=MAX_PAGE_BYTES).contains(&max_bytes))?;
+    let after = cursor.unwrap_or("");
+    protocol::require(after.len() <= 256)?;
+    let sessions = super::catalog_row(connection,"sessions")?;
+    let summaries = super::catalog_row(connection,"summaries")?;
+    let current_sessions = database::revision(connection,"mem:sessions")?.to_string();
+    let current_summaries = database::revision(connection,"mem:summaries")?.to_string();
+    let complete = sessions.0 == "ready" && summaries.0 == "ready" && sessions.2 == current_sessions && summaries.2 == current_summaries;
+    let mut statement=connection.prepare("SELECT project,SUM(CASE WHEN source='sessions' THEN ref_count ELSE 0 END),SUM(CASE WHEN source='summaries' THEN ref_count ELSE 0 END) FROM retrieval_project_counts WHERE (source='sessions' AND epoch=?1 OR source='summaries' AND epoch=?2) AND project>?3 GROUP BY project ORDER BY project LIMIT ?4")?;
+    let mut rows=statement.query(params![sessions.3,summaries.3,after,(limit+1) as i64])?;
+    let mut items=Vec::new();
+    let mut next_cursor: Option<String>=None;
+    let mut bytes=128usize;
+    while let Some(row)=rows.next()? {
+        if items.len()==limit { next_cursor=items.last().and_then(|v:&Value|v["project"].as_str().map(str::to_owned)); break; }
+        let item=json!({"project":row.get::<_,String>(0)?,"session_count":row.get::<_,i64>(1)?.to_string(),"summary_count":row.get::<_,i64>(2)?.to_string()});
+        let needed=protocol::size(&item)?+1;
+        if bytes.saturating_add(needed)>max_bytes { if items.is_empty(){return Err(super::super::request::resource());} next_cursor=items.last().and_then(|v:&Value|v["project"].as_str().map(str::to_owned)); break; }
+        bytes+=needed;
+        items.push(item);
+    }
+    let mut has_more=next_cursor.is_some();
+    if !has_more && items.len()==limit { has_more=true; next_cursor=items.last().and_then(|v|v["project"].as_str().map(str::to_owned)); }
+    Ok(json!({"status":if complete{"ready"}else{"partial"},"items":items,"next_cursor":next_cursor,"has_more":has_more,"revision":{"sessions":sessions.2,"summaries":summaries.2}}))
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/project_catalog/repair.rs b/engine/src/workers/state/adapters/sqlite/retrieval/project_catalog/repair.rs
