diff --git a/engine/src/workers/state/adapters/sqlite/text_container.rs b/engine/src/workers/state/adapters/sqlite/text_container.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/text_container.rs
@@ -0,0 +1,92 @@
+use serde_json::{json, Value};
+use std::time::Instant;
+
+pub(super) struct Item {
+    pub id: i64,
+    pub text: String,
+    pub stored: usize,
+}
+
+const HEADER: &[u8; 8] = b"AMPCB1\0\0";
+const HEADER_BYTES: usize = 24;
+const ENTRY_BYTES: usize = 16;
+const LOCATOR_RESERVE_PER_ENTRY: usize = 64;
+const BLOCK_INDEX_RESERVE: usize = 64;
+
+fn block(items: &[&Item]) -> anyhow::Result<(usize, usize)> {
+    let mut joined = String::new();
+    let mut manifest = Vec::new();
+    let mut old_bytes = 0usize;
+    for item in items {
+        manifest.extend_from_slice(&item.id.to_le_bytes());
+        manifest.extend_from_slice(&u32::try_from(joined.len())?.to_le_bytes());
+        manifest.extend_from_slice(&u32::try_from(item.text.len())?.to_le_bytes());
+        joined.push_str(&item.text);
+        old_bytes = old_bytes.checked_add(item.stored).ok_or_else(|| anyhow::anyhow!("payload size overflow"))?;
+    }
+    let encoded = super::super::codec::encode(&joined)?;
+    let mut container = Vec::new();
+    container.extend_from_slice(HEADER);
+    container.extend_from_slice(&u64::try_from(joined.len())?.to_le_bytes());
+    container.extend_from_slice(&u32::try_from(encoded.len())?.to_le_bytes());
+    container.extend_from_slice(&u32::try_from(items.len())?.to_le_bytes());
+    container.extend_from_slice(&manifest);
+    container.extend_from_slice(&encoded);
+    anyhow::ensure!(container.len() == HEADER_BYTES + ENTRY_BYTES * items.len() + encoded.len(), "container size mismatch");
+    // Native decode checks exact strings, including spelling, escapes and boundaries.
+    let restored = super::super::codec::decode(&encoded, joined.len())?;
+    anyhow::ensure!(restored == joined, "native container roundtrip mismatch");
+    for (item, entry) in items.iter().zip(manifest.chunks_exact(ENTRY_BYTES)) {
+        let id = i64::from_le_bytes(entry[0..8].try_into()?);
+        let offset = u32::from_le_bytes(entry[8..12].try_into()?) as usize;
+        let length = u32::from_le_bytes(entry[12..16].try_into()?) as usize;
+        anyhow::ensure!(id == item.id && restored.as_bytes().get(offset..offset + length) == Some(item.text.as_bytes()), "container manifest mismatch");
+    }
+    Ok((old_bytes, container.len()))
+}
+
+pub(super) fn measure(items: &[Item], block_limit: usize, started: &Instant) -> anyhow::Result<Value> {
+    let mut group = Vec::new();
+    let mut group_bytes = 0usize;
+    let mut old_bytes = 0usize;
+    let mut container_bytes = 0usize;
+    let mut blocks = 0usize;
+    for item in items {
+        if !group.is_empty() && group_bytes + item.text.len() > block_limit {
+            check_budget(started)?;
+            let (old, new) = block(&group)?;
+            check_budget(started)?;
+            old_bytes += old;
+            container_bytes += new;
+            blocks += 1;
+            group.clear();
+            group_bytes = 0;
+        }
+        group.push(item);
+        group_bytes += item.text.len();
+    }
+    if !group.is_empty() {
+        check_budget(started)?;
+        let (old, new) = block(&group)?;
+        check_budget(started)?;
+        old_bytes += old;
+        container_bytes += new;
+        blocks += 1;
+    }
+    let locator_reserve = LOCATOR_RESERVE_PER_ENTRY * items.len() + BLOCK_INDEX_RESERVE * blocks;
+    Ok(json!({
+        "rows": items.len(), "blocks": blocks, "oldStoredBytes": old_bytes,
+        "containerBytesIncludingManifest": container_bytes,
+        "provisionalLocatorReserveBytes": locator_reserve,
+        "sampleNetBytesWithReserve": old_bytes as i64 - container_bytes as i64 - locator_reserve as i64,
+        "blockLogicalLimitBytes": block_limit, "roundtrip": "native_codec_exact",
+        "reserveIsPhysicalUpperBound": false, "projectionPermitted": false,
+        "digestAndReferences": "retained_without_savings_credit",
+    }))
+}
+
+fn check_budget(started: &Instant) -> anyhow::Result<()> {
+    super::super::database::check_preparation()?;
+    anyhow::ensure!(started.elapsed().as_millis() < 2200, "STATE_RETRIEVAL_RESOURCE_LIMIT");
+    Ok(())
+}
