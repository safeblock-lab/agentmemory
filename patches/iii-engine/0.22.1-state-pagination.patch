+#[test]
+fn concept_seed_exact_sql_plan_and_high_degree_cost_diagnostic() {
+    let c = fixture();
+    let transaction = c.unchecked_transaction().unwrap();
+    for id in 1..=128 { add_node(&transaction,id,1); }
+    for position in 0..8192 {
+        transaction.execute("INSERT INTO retrieval_edges VALUES(2,?1,?2,?3,?4)", params![format!("edge-{position}"),"node-0001",format!("node-{:04}",position%127+2),position]).unwrap();
+    }
+    transaction.commit().unwrap();
+    for summary_authority_ready in [false,true] {
+        let sql = ranking_sql(summary_authority_ready);
+        let query_plan = plan(&c,&sql);
+        let started = Instant::now();
+        let (items,steps) = measured_ranking(&c,&sql);
+        let elapsed=started.elapsed().as_micros();
+        let (original,original_steps)=measured_ranking(&c,&original_ranking_sql(summary_authority_ready));
+        println!("concept_seed_diagnostic summary_authority={summary_authority_ready} nodes=128 edges=8192 vm_steps={steps} original_vm_steps={original_steps} elapsed_us={elapsed} sql={sql}\nplan={}",query_plan.join("\n"));
+        assert_eq!(items,original);
+        assert_eq!(items.len(),16);
+        assert_eq!(items[0],("node-0001".into(),8192));
+        assert!(steps>0 && steps<original_steps);
+        assert!(query_plan.iter().any(|line|line.contains("retrieval_edges_source")));
+        assert!(query_plan.iter().any(|line|line.contains("retrieval_edges_target")));
+        assert!(query_plan.iter().any(|line|line.contains("MATERIALIZE authorized")));
+    }
+}
