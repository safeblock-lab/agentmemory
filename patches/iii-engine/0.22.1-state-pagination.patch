+use super::*;
+use rusqlite::params;
+
+fn memberships(connection: &Connection, epoch: i64, key: &str) -> Vec<(String, i64)> {
+    let key_id: i64 = connection
+        .query_row(
+            "SELECT id FROM retrieval_identifiers WHERE epoch=?1 AND value=?2",
+            params![epoch, key],
+            |row| row.get(0),
+        )
+        .unwrap();
+    connection
+        .prepare("SELECT o.value,m.position FROM retrieval_membership_values m JOIN retrieval_identifiers o ON o.epoch=m.epoch AND o.id=m.observation WHERE m.epoch=?1 AND m.key=?2 ORDER BY m.position,o.value")
+        .unwrap()
+        .query_map(params![epoch, key_id], |row| Ok((row.get(0)?, row.get(1)?)))
+        .unwrap()
+        .collect::<rusqlite::Result<_>>()
+        .unwrap()
+}
+
+#[test]
+fn membership_cleanup_uses_existing_index_and_survives_compaction_rollback_without_it() {
+    let connection = fresh();
+    let first = node("first", "first", &["old", "shared"]);
+    let second = node("second", "second", &["shared"]);
+    write(&connection, graph::NODES, "first", Some(&first));
+    write(&connection, graph::NODES, "second", Some(&second));
+    let epoch = metadata::graph(&connection, graph::NODES).unwrap().epoch;
+    let first_before = memberships(&connection, epoch, "first");
+    assert_eq!(first_before, vec![("old".into(), 0), ("shared".into(), 0)]);
+
+    let first_id: i64 = connection
+        .query_row(
+            "SELECT id FROM retrieval_identifiers WHERE epoch=?1 AND value='first'",
+            [epoch],
+            |row| row.get(0),
+        )
+        .unwrap();
+    let index_columns = connection
+        .prepare("PRAGMA index_info(retrieval_membership_key)")
+        .unwrap()
+        .query_map([], |row| row.get::<_, String>(2))
+        .unwrap()
+        .collect::<rusqlite::Result<Vec<_>>>()
+        .unwrap();
+    assert_eq!(index_columns, vec!["epoch", "key"]);
+
+    connection
+        .execute("UPDATE compact_config SET mode=1,phase='compact' WHERE singleton=1", [])
+        .unwrap();
+    super::super::super::compact::membership::row(
+        &connection,
+        graph::NODES,
+        "first",
+        Some(0),
+        &first,
+    )
+    .unwrap();
+    assert_eq!(memberships(&connection, epoch, "first"), first_before);
+    assert_eq!(
+        connection
+            .query_row(
+                "SELECT count(*) FROM retrieval_membership WHERE epoch=?1 AND key=?2",
+                params![epoch, first_id],
+                |row| row.get::<_, i64>(0),
+            )
+            .unwrap(),
+        0
+    );
+
+    connection
+        .execute("UPDATE compact_config SET mode=0,phase='rollback' WHERE singleton=1", [])
+        .unwrap();
+    super::super::super::compact::membership::row(
+        &connection,
+        graph::NODES,
+        "first",
+        Some(0),
+        &first,
+    )
+    .unwrap();
+    assert_eq!(memberships(&connection, epoch, "first"), first_before);
+    connection.execute("DROP INDEX retrieval_membership_key", []).unwrap();
+
+    write(
+        &connection,
+        graph::NODES,
+        "first",
+        Some(&node("first", "first updated", &["new", "shared"])),
+    );
+    assert_eq!(
+        memberships(&connection, epoch, "first"),
+        vec![("new".into(), 0), ("shared".into(), 0)]
+    );
+    assert_eq!(memberships(&connection, epoch, "second"), vec![("shared".into(), 1)]);
+    assert_eq!(
+        connection
+            .query_row(
+                "SELECT count(*) FROM retrieval_identifiers WHERE epoch=?1 AND value='old'",
+                [epoch],
+                |row| row.get::<_, i64>(0),
+            )
+            .unwrap(),
+        0
+    );
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/tests/preparation_performance_tests.rs b/engine/src/workers/state/adapters/sqlite/retrieval/tests/preparation_performance_tests.rs
