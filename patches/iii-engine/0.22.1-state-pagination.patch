+                )
+            };
+            assert_eq!(status, rusqlite::ffi::SQLITE_OK);
+            Ok(current)
+        })
+        .await
+        .unwrap();
+    eprintln!(
+        "SQLite cache_used_bytes={cache}, cache_target_bytes={}",
+        64 * 1024 * 1024
+    );
+    assert!(cache <= 72 * 1024 * 1024);
