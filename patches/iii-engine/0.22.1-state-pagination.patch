+    c.execute_batch("CREATE TEMP TRIGGER canonical_fail_insert BEFORE INSERT ON state_rows WHEN NEW.scope='mem:memories' AND NEW.key='m2' BEGIN SELECT RAISE(ABORT,'fixture rollback'); END;").unwrap();
+    assert!(call(&c, second.clone()).is_err());
