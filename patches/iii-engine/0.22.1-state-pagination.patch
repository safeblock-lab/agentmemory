+pub fn canonical_state_page_fields(fields: &[String]) -> Option<Vec<String>> {
+    if !(1..=16).contains(&fields.len()) {
+        return None;
+    }
+    let mut total_bytes = 0usize;
+    for field in fields {
+        if field.len() > 128 {
+            return None;
+        }
+        total_bytes = total_bytes.checked_add(field.len())?;
+        if total_bytes > 1024 {
+            return None;
+        }
+    }
+    let mut canonical = fields.to_vec();
+    canonical.sort_unstable();
+    if canonical.windows(2).any(|pair| pair[0] == pair[1]) {
+        return None;
+    }
