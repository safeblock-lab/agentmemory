+    let mut memory = json!({"id":"memory","title":"memory title","content":"memory_content_token","concepts":["concept_identifier"],"files":["memory_file.ts"],"isLatest":true});
+    write(&connection, "mem:memories", "memory", Some(&memory));
+    upsert(
+        &connection,
+        vec![source_item(&connection, "mem:memories", "memory")],
+    )
+    .unwrap();
+    assert_eq!(
+        returned_ids(&keywords(&connection, "concept_identifier").unwrap()),
