+use super::*;
+use rusqlite::params;
+
+#[test]
+fn sqlite_shadow_many_batches_resume_after_wal_window_and_sidecar_loss() {
+    let root = std::env::var_os("III_SQLITE_TEST_ROOT").unwrap();
+    let directory = tempfile::tempdir_in(root).unwrap();
+    let args = MigrationArgs {
+        source: directory.path().join("window-v1.sqlite3"),
+        target: directory.path().join("window-v2.sqlite3"),
+        disk_budget_bytes: 128 * 1024 * 1024,
+        reverse: false,
+    };
+    let mut source = Connection::open(&args.source).unwrap();
+    source.execute_batch("CREATE TABLE state_scopes(scope TEXT PRIMARY KEY,revision TEXT NOT NULL,next_position INTEGER NOT NULL) WITHOUT ROWID; CREATE TABLE state_rows(scope TEXT NOT NULL,key TEXT NOT NULL,value TEXT,version TEXT NOT NULL,position INTEGER,value_bytes INTEGER NOT NULL,PRIMARY KEY(scope,key)) WITHOUT ROWID; CREATE INDEX state_rows_order ON state_rows(scope,position) WHERE value IS NOT NULL; CREATE TABLE retrieval_membership(epoch INTEGER NOT NULL,observation TEXT NOT NULL,key TEXT NOT NULL,position INTEGER NOT NULL,PRIMARY KEY(epoch,observation,key)) WITHOUT ROWID; CREATE INDEX retrieval_membership_key ON retrieval_membership(epoch,key);").unwrap();
+    let transaction = source.transaction().unwrap();
+    {
+        let mut insert = transaction
+            .prepare("INSERT INTO retrieval_membership VALUES(1,?1,?2,?3)")
+            .unwrap();
+        for position in 0..73728i64 {
+            insert
+                .execute(params![
+                    format!("obs-{:05}", position / 1024),
+                    format!("key-{:05}", position % 1024),
+                    position
+                ])
+                .unwrap();
+        }
+    }
+    transaction
+        .pragma_update(None, "application_id", database::APPLICATION_ID)
+        .unwrap();
+    transaction.pragma_update(None, "user_version", 1).unwrap();
+    transaction.commit().unwrap();
+    drop(source);
+    let source_before = archive::file_digest(&args.source).unwrap();
+    assert!(
+        run_segment(&args, Some(69632), None)
+            .unwrap_err()
+            .to_string()
+            .contains("interruption")
+    );
+    {
+        let pending = Connection::open(&args.target).unwrap();
+        assert_eq!(
+            pending
+                .query_row(
+                    "SELECT count FROM shadow_transfer_progress WHERE name='retrieval_membership'",
+                    [],
+                    |r| r.get::<_, i64>(0)
+                )
+                .unwrap(),
+            69632
+        );
+        assert_eq!(
+            pending
+                .query_row("SELECT count(*) FROM retrieval_membership", [], |r| r
+                    .get::<_, i64>(0))
+                .unwrap(),
+            69632
+        );
+        assert_eq!(
+            pending
+                .query_row("SELECT status FROM state_migration WHERE id=1", [], |r| {
+                    r.get::<_, String>(0)
+                })
+                .unwrap(),
+            "pending"
+        );
+    }
+    let wal = PathBuf::from(format!("{}-wal", args.target.display()));
+    assert!(!wal.exists() || fs::metadata(&wal).unwrap().len() == 0);
+    fs::remove_file(format!("{}.migration-pending", args.target.display())).unwrap();
+    let target_before = archive::file_digest(&args.target).unwrap();
+    assert!(
+        database::open(&args.target)
+            .unwrap_err()
+            .to_string()
+            .contains("INCOMPLETE")
+    );
+    assert_eq!(archive::file_digest(&args.target).unwrap(), target_before);
+    run(&args).unwrap();
+    assert_eq!(archive::file_digest(&args.source).unwrap(), source_before);
+    let complete = Connection::open(&args.target).unwrap();
+    assert_eq!(
+        complete
+            .query_row("SELECT count(*) FROM retrieval_membership", [], |r| r
+                .get::<_, i64>(0))
+            .unwrap(),
+        73728
+    );
+    assert_eq!(
+        complete
+            .query_row("SELECT status FROM state_migration WHERE id=1", [], |r| {
+                r.get::<_, String>(0)
+            })
+            .unwrap(),
+        "ready"
+    );
+}
