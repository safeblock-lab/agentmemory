@@ -0,0 +1,66 @@
+use super::need;
+use std::{fs::{self, File, OpenOptions}, path::Path};
+#[cfg(windows)]
+mod windows;
+const UNAVAILABLE: &str = "STATE_PROVIDER_BUDGET_CONFIG_UNAVAILABLE";
+const PRIVATE: &str = "STATE_PROVIDER_BUDGET_CONFIG_NOT_PRIVATE";
+
+pub(super) fn open(database: &Path) -> anyhow::Result<(File, File)> {
+    open_named(database,"provider-budget-grants.json")
+}
+pub(super) fn open_named(database: &Path, name: &'static str) -> anyhow::Result<(File, File)> {
+    let metadata = fs::symlink_metadata(database).map_err(|_| super::error(UNAVAILABLE))?;
+    need(metadata.is_file() && !metadata.file_type().is_symlink(), PRIVATE)?;
+    reject_reparse(&metadata)?;
+    let database = fs::canonicalize(database).map_err(|_| super::error(UNAVAILABLE))?;
+    let directory = database.parent().ok_or_else(|| super::error(UNAVAILABLE))?;
+    let path = directory.join(name);
+    let metadata = fs::symlink_metadata(&path).map_err(|_| super::error(UNAVAILABLE))?;
+    need(metadata.is_file() && !metadata.file_type().is_symlink() && metadata.len() <= 65536, PRIVATE)?;
+    reject_reparse(&metadata)?;
+    let directory_metadata = fs::symlink_metadata(directory).map_err(|_| super::error(UNAVAILABLE))?;
+    need(directory_metadata.is_dir() && !directory_metadata.file_type().is_symlink(), PRIVATE)?;
+    reject_reparse(&directory_metadata)?;
+    let directory_handle = open_handle(directory, true)?;
+    let file = open_handle(&path, false)?;
+    need(file.metadata().map_err(|_| super::error(UNAVAILABLE))?.len() <= 65536, PRIVATE)?;
+    private(&directory_handle)?;
+    private(&file)?;
+    Ok((file, directory_handle))
+}
+fn reject_reparse(metadata: &fs::Metadata) -> anyhow::Result<()> {
+    #[cfg(windows)] {
+        use std::os::windows::fs::MetadataExt;
+        need(metadata.file_attributes() & 0x400 == 0, PRIVATE)?;
+    }
+    #[cfg(not(windows))] let _ = metadata;
+    Ok(())
+}
+fn open_handle(path: &Path, directory: bool) -> anyhow::Result<File> {
+    let mut options = OpenOptions::new(); options.read(true);
+    #[cfg(windows)] {
+        use std::os::windows::fs::OpenOptionsExt;
+        // FILE_SHARE_READ only; no writer or delete/rename while authority is used.
+        options.share_mode(1).custom_flags(0x00200000 | if directory { 0x02000000 } else { 0 });
+    }
+    #[cfg(unix)] {
+        use std::os::unix::fs::OpenOptionsExt;
+        options.custom_flags(libc::O_NOFOLLOW | if directory { libc::O_DIRECTORY } else { 0 });
+    }
+    #[cfg(not(any(unix, windows)))] { let _ = (path, directory); return Err(super::error(PRIVATE)); }
+    let file = options.open(path).map_err(|_| super::error(UNAVAILABLE))?;
+    let metadata = file.metadata().map_err(|_| super::error(UNAVAILABLE))?;
+    need(if directory { metadata.is_dir() } else { metadata.is_file() }, PRIVATE)?;
+    reject_reparse(&metadata)?;
+    Ok(file)
+}
+fn private(file: &File) -> anyhow::Result<()> {
+    #[cfg(windows)] return windows::check(file);
+    #[cfg(unix)] {
+        use std::os::unix::fs::MetadataExt;
+        let metadata = file.metadata().map_err(|_| super::error(UNAVAILABLE))?;
+        let uid = unsafe { libc::geteuid() };
+        return need((metadata.uid() == uid || metadata.uid() == 0) && metadata.mode() & 0o077 == 0, PRIVATE);
+    }
+    #[cfg(not(any(unix, windows)))] { let _ = file; Err(super::error(PRIVATE)) }
+}
