+use super::*;
+use rusqlite::params;
+
+fn fixture() -> Connection {
+    let c = fresh();
+    let mut configure = semantic_request("semantic_configure");
+    configure["source_kind"] = json!("agentmemory");
+    call(&c, configure).unwrap();
+    for (session, project) in [("s", "p"), ("foreign", "foreign")] {
+        write(
+            &c,
+            "mem:sessions",
+            session,
+            Some(&json!({"id":session,"project":project})),
+        );
+    }
+    observe(&c, "a", "needle current");
+    embed(&c, "a");
+    write(
+        &c,
+        "mem:obs:foreign",
+        "unrelated",
+        Some(&json!({"id":"unrelated","title":"unrelated","narrative":"still pending"})),
+    );
+    forget_derived(&c, "a");
+    c.execute("UPDATE retrieval_scoped_meta SET status='pending'", [])
+        .unwrap();
+    c.execute(
+        "UPDATE retrieval_project_vector_meta SET status='pending',cursor=''",
+        [],
+    )
+    .unwrap();
+    c
+}
+fn observe(c: &Connection, id: &str, text: &str) {
+    write(
+        c,
+        "mem:obs:s",
+        id,
+        Some(&json!({"id":id,"sessionId":"s","title":"needle","narrative":text})),
+    );
+}
+fn embed(c: &Connection, id: &str) {
+    let mut item = vector_item(id, &[1., 0., 0., 0.], Some("ignored"));
+    item["source_scope"] = json!("mem:obs:s");
+    item["source_version"] = json!(
+        database::row(c, "mem:obs:s", id)
+            .unwrap()
+            .version
+            .to_string()
+    );
+    upsert(c, vec![item]).unwrap();
+}
+fn forget_derived(c: &Connection, id: &str) {
+    scoped::remove(c, "observations", 1, id).unwrap();
+    c.execute("DELETE FROM retrieval_source_items WHERE index_id='observations' AND scope='mem:obs:s' AND key=?1", [id]).unwrap();
+}
+fn request(rows: usize) -> Value {
+    json!({"action":"project_vectors_prepare","index_id":"observations","project":"p","source_kind":"observation","max_rows":rows,"max_bytes":65536})
+}
+fn replace_stored(c: &Connection, id: &str, value: &Value) {
+    let encoded = serde_json::to_vec(value).unwrap();
+    c.execute(
+        "UPDATE state_rows SET value=?3,value_bytes=?4 WHERE scope=?1 AND key=?2",
+        params![
+            "mem:semantic:observations",
+            id,
+            encoded,
+            encoded.len() as i64
+        ],
+    )
+    .unwrap();
+}
+fn proof(c: &Connection, id: &str) -> Option<(String, bool)> {
+    source::item(c, "observations", "mem:obs:s", id).unwrap()
+}
+fn assert_ready_hit(c: &Connection) {
+    let mut query = semantic_request("semantic_search");
+    query["project"] = json!("p");
+    query["source_kind"] = json!("observation");
+    query["session_id"] = json!("s");
+    query["source_scope"] = json!("mem:obs:s");
+    query["include_text"] = json!(true);
+    query["embedding"] = json!(encoded(&[1., 0., 0., 0.]));
+    query["limit"] = json!(1);
+    query["max_candidates"] = json!(1);
+    let result = call(c, query).unwrap();
+    assert_eq!(result["status"], "ready", "{result}");
+    assert_eq!(returned_ids(&result), vec!["a"], "{result}");
+    assert_eq!(result["items"][0]["sessionId"], "s");
+    assert_eq!(result["items"][0]["source_scope"], "mem:obs:s");
+    assert_eq!(result["items"][0]["source_version"], "1");
+}
