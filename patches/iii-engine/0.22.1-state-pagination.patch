+use super::super::{database, protocol};
+use super::{semantic::PREFIX, source};
+use rusqlite::{Connection, OptionalExtension};
+use serde_json::{Value, json};
+
+pub struct Meta {
+    pub index_id: String,
+    pub model: String,
+    pub dimensions: usize,
+    pub generation: String,
+    pub status: String,
+    pub cursor: i64,
+    pub revision: String,
+    pub epoch: i64,
+    pub count: usize,
+    pub lexical_count: usize,
+}
+impl Meta {
+    pub fn scope(&self) -> String {
+        format!("{PREFIX}{}", self.index_id)
+    }
+    pub fn ready(&self, connection: &Connection) -> anyhow::Result<()> {
+        if self.status != "ready"
+            || self.revision != database::revision(connection, &self.scope())?.to_string()
+        {
+            return Err(protocol::error("STATE_INDEX_NOT_READY"));
+        }
+        source::ready(connection, &self.index_id)?;
+        Ok(())
+    }
+    pub fn identity(&self, model: &str, dimensions: usize, generation: &str) -> anyhow::Result<()> {
+        if self.model != model || self.dimensions != dimensions || self.generation != generation {
+            return Err(protocol::error("STATE_SEMANTIC_IDENTITY_MISMATCH"));
+        }
+        Ok(())
+    }
+    pub fn status_value(&self) -> Value {
+        json!({"index_id":self.index_id,"model":self.model,"dimensions":self.dimensions,"generation":self.generation,"status":self.status,"count":self.count,"lexical_count":self.lexical_count,"lexical_ready":self.status=="ready" && self.count==self.lexical_count,"cursor":self.cursor.to_string(),"revision":self.revision})
+    }
+}
+
+pub fn get(connection: &Connection, id: &str) -> anyhow::Result<Meta> {
+    connection.query_row("SELECT index_id,model,dimensions,generation,status,cursor,revision,epoch,count,lexical_count FROM retrieval_semantic_meta WHERE index_id=?1", [id], |r| {
+        Ok(Meta {index_id:r.get(0)?,model:r.get(1)?,dimensions:sql_usize(r,2)?,generation:r.get(3)?,status:r.get(4)?,cursor:r.get(5)?,revision:r.get(6)?,epoch:r.get(7)?,count:sql_usize(r,8)?,lexical_count:sql_usize(r,9)?})
+    }).optional()?.ok_or_else(|| protocol::error("STATE_INDEX_NOT_READY"))
+}
+
+fn sql_usize(row: &rusqlite::Row<'_>, column: usize) -> rusqlite::Result<usize> {
+    let value: i64 = row.get(column)?;
+    usize::try_from(value).map_err(|_| rusqlite::Error::IntegralValueOutOfRange(column, value))
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/semantic_query.rs b/engine/src/workers/state/adapters/sqlite/retrieval/semantic_query.rs
new file mode 100644
index 0000000..e992653
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/semantic_query.rs
@@ -0,0 +1,100 @@
+use super::{lsh, semantic};
+use rusqlite::{Connection, params};
+use serde_json::{Value, json};
+use std::collections::HashSet;
+
+struct Match {
+    id: String,
+    session: String,
+    score: f64,
+}
+fn rank(a: &Match, b: &Match) -> std::cmp::Ordering {
+    b.score.total_cmp(&a.score).then(a.id.cmp(&b.id))
+}
+
+pub fn search(
+    connection: &Connection,
+    id: &str,
+    model: &str,
+    dimensions: usize,
+    generation: &str,
+    embedding: &str,
+    limit: usize,
+    max_candidates: usize,
+    probes: usize,
+) -> anyhow::Result<Value> {
+    let meta = semantic::get(connection, id)?;
+    meta.identity(model, dimensions, generation)?;
+    meta.ready(connection)?;
+    let query = lsh::decode(embedding, dimensions)?;
+    let buckets: Vec<Vec<u16>> = lsh::signatures(&query)
+        .iter()
+        .map(|signature| lsh::buckets(signature, probes))
+        .collect();
+    let mut seen = HashSet::with_capacity(max_candidates.min(4096));
+    let mut matches: Vec<Match> = Vec::with_capacity(limit);
+    let mut retained_id_bytes = 0usize;
+    let mut visits = 0usize;
+    let max_visits = max_candidates.saturating_mul(lsh::TABLES);
+    let bucket_limit = (max_candidates / lsh::TABLES).max(32);
+    let mut exhausted = false;
+    let mut statement=connection.prepare_cached("SELECT p.id,v.session_id,v.embedding FROM retrieval_vector_postings p CROSS JOIN retrieval_vectors v WHERE p.index_id=?1 AND p.epoch=?2 AND p.table_id=?3 AND p.bucket=?4 AND v.index_id=p.index_id AND v.epoch=p.epoch AND v.id=p.id ORDER BY p.id LIMIT ?5")?;
+    'probe: for probe in 0..probes {
+        for (table, buckets) in buckets.iter().enumerate() {
+            let mut rows = statement.query(params![
+                id,
+                meta.epoch,
+                table as i64,
+                buckets[probe],
+                (bucket_limit + 1) as i64
+            ])?;
+            let mut bucket_seen = 0;
+            while let Some(row) = rows.next()? {
+                visits += 1;
+                bucket_seen += 1;
+                if visits > max_visits {
+                    exhausted = true;
+                    break 'probe;
+                }
+                if bucket_seen > bucket_limit {
+                    exhausted = true;
+                    break;
+                }
+                let id: String = row.get(0)?;
+                if seen.contains(&id) {
+                    continue;
+                }
+                if seen.len() >= max_candidates || retained_id_bytes + id.len() > 4 * 1024 * 1024 {
+                    exhausted = true;
+                    break 'probe;
+                }
+                retained_id_bytes += id.len();
+                seen.insert(id.clone());
+                let vector = lsh::from_blob(&row.get::<_, Vec<u8>>(2)?, dimensions)?;
+                let candidate = Match {
+                    id,
+                    session: row.get(1)?,
+                    score: lsh::cosine(&query, &vector),
+                };
+                if matches.len() < limit
+                    || rank(
+                        &candidate,
+                        matches.last().expect("nonempty bounded top results"),
+                    )
+                    .is_lt()
+                {
+                    matches.push(candidate);
+                    matches.sort_unstable_by(rank);
+                    matches.truncate(limit);
+                }
+            }
+        }
+    }
+    let items: Vec<Value> = matches
+        .into_iter()
+        .map(|item| json!({"obsId":item.id,"sessionId":item.session,"score":item.score}))
+        .collect();
+    Ok(
+        json!({"items":items,"approximate":true,"candidates":seen.len(),"budget_exhausted":exhausted,"model":model,"dimensions":dimensions,"generation":generation}),
+    )
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/source.rs b/engine/src/workers/state/adapters/sqlite/retrieval/source.rs
new file mode 100644
