+use super::common::*;
+use rusqlite::{params, Connection};
+use serde_json::{json, Value};
+use std::collections::BTreeMap;
+
+const PAGE_CANDIDATES: usize = 17;
+
+fn project_search_sql(summary_fallback: bool) -> String {
+    let mapping = observation_posting_predicate("sp");
+    let currentness = observation_source_currentness("pv", "ss");
+    let authority = observation_session_authority("ss.name", summary_fallback);
+    format!(
+        "SELECT DISTINCT n.key,n.position FROM retrieval_scoped_postings sp CROSS JOIN retrieval_scoped_vectors pv ON pv.index_id=sp.index_id AND pv.epoch=sp.epoch AND pv.id=sp.id AND pv.project=sp.project AND pv.project_generation=sp.project_generation AND pv.kind=sp.kind CROSS JOIN retrieval_scoped_sessions ss ON ss.token=pv.session CROSS JOIN retrieval_identifiers obs ON obs.epoch=?1 AND obs.value=pv.id CROSS JOIN retrieval_inverse_membership_values m ON m.epoch=?1 AND m.observation=obs.id CROSS JOIN retrieval_identifiers nid ON nid.epoch=?1 AND nid.id=m.key CROSS JOIN retrieval_nodes n ON n.epoch=?1 AND n.key=nid.value WHERE {mapping} AND {currentness} AND {authority} AND n.position>?4 AND ((instr(n.name,?5)>0 AND EXISTS(SELECT 1 FROM retrieval_name_grams g INDEXED BY retrieval_name_grams_key WHERE g.epoch=n.epoch AND g.key=n.key AND g.gram=?6)) OR instr(?5,n.name)>0) ORDER BY n.position LIMIT ?7"
+    )
+}
+
+fn observation_sql(summary_fallback: bool) -> String {
+    let mapping = observation_project_predicate("pv");
+    let currentness = observation_source_currentness("pv", "ss");
+    let authority = observation_session_authority("ss.name", summary_fallback);
+    format!(
+        "SELECT DISTINCT nid.value,n.position FROM retrieval_scoped_vectors pv CROSS JOIN retrieval_scoped_sessions ss ON ss.token=pv.session CROSS JOIN retrieval_identifiers obs ON obs.epoch=?1 AND obs.value=pv.id CROSS JOIN retrieval_identifiers nid ON nid.epoch=?1 CROSS JOIN retrieval_inverse_membership_values m ON m.epoch=?1 AND m.observation=obs.id AND m.key=nid.id CROSS JOIN retrieval_nodes n ON n.epoch=?1 AND n.key=nid.value WHERE {mapping} AND {currentness} AND {authority} AND pv.id=?4 AND n.position>?5 ORDER BY n.position LIMIT ?6"
+    )
+}
+
+pub(super) fn execute(
+    connection: &Connection,
+    project: &str,
+    query: Option<&str>,
+    observation_ids: &[String],
+    cursor: Option<&str>,
+    limit: usize,
+    max_bytes: usize,
+) -> anyhow::Result<Value> {
+    check_bounds(limit, max_bytes)?;
+    let ready = ready_context(connection, project)?;
+    let context = match ready {
+        Ok(context) => context,
+        Err(partial) => return Ok(partial),
+    };
+    let selector =
+        json!({"mode":"search","project":project,"query":query,"observation_ids":observation_ids});
+    let hash = selector_hash(&selector)?;
+    let after = cursor_position(cursor, &hash, &context)?;
+    let mut selected: BTreeMap<String, (i64, bool, bool)> = BTreeMap::new();
+    let mut has_more = false;
+    if let Some(query) = query {
+        let normalized = query.trim().to_lowercase();
+        let gram: String = normalized.chars().take(3).collect();
+        let sql = project_search_sql(context.summary_authority_ready);
+        let mut statement = connection.prepare_cached(&sql)?;
+        let mut rows = statement.query(params![
+            context.node_epoch,
+            context.vector_epoch,
+            project,
+            after,
+            normalized,
+            gram,
+            PAGE_CANDIDATES as i64
+        ])?;
+        let mut count = 0;
+        while let Some(row) = rows.next()? {
+            count += 1;
+            let key: String = row.get(0)?;
+            let position: i64 = row.get(1)?;
+            selected
+                .entry(key)
+                .and_modify(|item| item.1 = true)
+                .or_insert((position, true, false));
+        }
+        has_more |= count == PAGE_CANDIDATES;
+    }
+    if !observation_ids.is_empty() {
+        let sql = observation_sql(context.summary_authority_ready);
+        let mut statement = connection.prepare_cached(&sql)?;
+        for observation in observation_ids {
+            let mut rows = statement.query(params![
+                context.node_epoch,
+                context.vector_epoch,
+                project,
+                observation,
+                after,
+                PAGE_CANDIDATES as i64
+            ])?;
+            let mut count = 0;
+            while let Some(row) = rows.next()? {
+                count += 1;
+                let key: String = row.get(0)?;
+                let position: i64 = row.get(1)?;
+                selected
+                    .entry(key)
+                    .and_modify(|item| item.2 = true)
+                    .or_insert((position, false, true));
+            }
+            has_more |= count == PAGE_CANDIDATES;
+        }
+    }
+    let mut ordered = selected
+        .into_iter()
+        .map(|(key, (position, entity, observation))| (position, key, entity, observation))
+        .collect::<Vec<_>>();
+    ordered.sort_by_key(|(position, _, _, _)| *position);
+    if ordered.len() > limit {
+        has_more = true;
+        ordered.truncate(limit);
+    }
+    let ordered=ordered.into_iter().map(|(position,key,entity,observation)|json!({"key":key,"id":key,"position":position.to_string(),"entity":entity,"observation":observation})).collect::<Vec<_>>();
+    let mut accepted = Vec::with_capacity(ordered.len());
+    let mut bytes = 256usize;
+    for item in ordered {
+        let needed = item_bytes(&item)?.saturating_add(1);
+        if bytes.saturating_add(needed) > max_bytes {
+            has_more = true;
+            break;
+        }
+        bytes += needed;
+        accepted.push(item);
+    }
+    let ordered = accepted;
+    let next = if has_more {
+        ordered
+            .last()
+            .and_then(|item| item["position"].as_str())
+            .and_then(|value| value.parse::<i64>().ok())
+            .map(|position| next_cursor(&hash, &context, position))
+    } else {
+        None
+    };
+    let reason = if context.authority_incomplete {
+        Some("project_authority_incomplete")
+    } else if query.is_some() {
+        Some("graph_membership_partial")
+    } else {
+        None
+    };
+    Ok(with_projection_status(
+        json!({"status":if reason.is_some(){"partial"}else{"ready"},"reason":reason,"project":project,"items":ordered,"has_more":has_more,"next_cursor":next,"revision":{"nodes":context.node_revision,"edges":context.edge_revision,"vectors":context.vector_revision}}),
+        &context,
+    ))
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/graph_read/top_n.rs b/engine/src/workers/state/adapters/sqlite/retrieval/graph_read/top_n.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/graph_read/top_n.rs
@@ -0,0 +1,158 @@
+use super::common::*;
+use rusqlite::{params, Connection, OptionalExtension};
+use serde_json::{json, Value};
+use std::collections::BTreeMap;
+
+const CANDIDATE_CAP: usize = 256;
+const DEGREE_CAP: i64 = 257;
+
+pub(super) fn project_candidates(
+    connection: &Connection,
+    context: &Context,
+    project: &str,
+    max_bytes: usize,
+) -> anyhow::Result<(BTreeMap<String, i64>, bool)> {
+    let mapping = observation_posting_predicate("sp");
+    let authority = observation_session_authority("ss.name", context.summary_authority_ready);
+    let currentness = observation_source_currentness("pv", "ss");
+    let readable_nodes = if context.projection_incomplete {
+        "AND EXISTS(SELECT 1 FROM state_values node_value WHERE node_value.scope=?4 AND node_value.key=n.key AND node_value.live=1 AND node_value.value_bytes BETWEEN 1 AND ?5 AND CASE typeof(node_value.value) WHEN 'blob' THEN node_value.stored_bytes WHEN 'text' THEN node_value.stored_bytes*4 ELSE 0 END BETWEEN 1 AND ?5)"
+    } else {
+        ""
+    };
+    let sql=format!("SELECT DISTINCT n.key,n.position FROM retrieval_scoped_postings sp CROSS JOIN retrieval_scoped_vectors pv ON pv.index_id=sp.index_id AND pv.epoch=sp.epoch AND pv.id=sp.id AND pv.project=sp.project AND pv.project_generation=sp.project_generation AND pv.kind=sp.kind CROSS JOIN retrieval_scoped_sessions ss ON ss.token=pv.session CROSS JOIN retrieval_identifiers obs ON obs.epoch=?1 AND obs.value=pv.id CROSS JOIN retrieval_inverse_membership_values m ON m.epoch=?1 AND m.observation=obs.id CROSS JOIN retrieval_identifiers nid ON nid.epoch=?1 AND nid.id=m.key CROSS JOIN retrieval_nodes n ON n.epoch=?1 AND n.key=nid.value WHERE {mapping} AND {currentness} AND {authority} {readable_nodes} LIMIT ?6");
+    let mut result = BTreeMap::new();
+    let mut statement = connection.prepare_cached(&sql)?;
+    let mut rows = statement.query(params![
+        context.node_epoch,
+        context.vector_epoch,
+        project,
+        NODES,
+        max_bytes as i64,
+        (CANDIDATE_CAP + 1) as i64
+    ])?;
+    let mut count = 0;
+    while let Some(row) = rows.next()? {
+        count += 1;
+        let key: String = row.get(0)?;
+        let pos: i64 = row.get(1)?;
+        result.entry(key).or_insert(pos);
+    }
+    let mut more = count > CANDIDATE_CAP;
+    let mut ordered = result.into_iter().collect::<Vec<_>>();
+    ordered.sort_by_key(|(_, position)| *position);
+    if ordered.len() > CANDIDATE_CAP {
+        more = true;
+        ordered.truncate(CANDIDATE_CAP);
+    }
+    let result = ordered.into_iter().collect();
+    Ok((result, more))
+}
+
+fn degree(
+    connection: &Connection,
+    context: &Context,
+    project: &str,
+    node: &str,
+) -> anyhow::Result<(i64, bool)> {
+    let source_scope = node_project_predicate("e.source", context.summary_authority_ready);
+    let target_scope = node_project_predicate("e.target", context.summary_authority_ready);
+    let mut total = 0i64;
+    let mut capped = false;
+    for (column, index) in [
+        ("source", "retrieval_edges_source"),
+        ("target", "retrieval_edges_target"),
+    ] {
+        let sql=format!("SELECT count(*) FROM (SELECT 1 FROM retrieval_edges e INDEXED BY {index} WHERE e.epoch=?4 AND e.{column}=?5 AND {source_scope} AND {target_scope} LIMIT ?6)");
+        let count: i64 = connection.query_row(
+            &sql,
+            params![
+                context.node_epoch,
+                context.vector_epoch,
+                project,
+                context.edge_epoch,
+                node,
+                DEGREE_CAP
+            ],
+            |row| row.get(0),
+        )?;
+        total = total.saturating_add(count);
+        capped |= count == DEGREE_CAP;
+    }
+    Ok((total, capped))
+}
+
+pub(super) fn execute(
+    connection: &Connection,
+    project: &str,
+    node_ids: &[String],
+    top_n: usize,
+    max_bytes: usize,
+) -> anyhow::Result<Value> {
+    check_bounds(top_n, max_bytes)?;
+    let context = match ready_context(connection, project)? {
+        Ok(context) => context,
+        Err(page) => return Ok(page),
+    };
+    let (candidates, candidate_more) = if node_ids.is_empty() {
+        project_candidates(connection, &context, project, max_bytes)?
+    } else {
+        let scope = node_project_predicate("n.key", context.summary_authority_ready);
+        let mut selected = BTreeMap::new();
+        for id in node_ids {
+            let row:Option<i64>=connection.query_row(&format!("SELECT n.position FROM retrieval_nodes n WHERE n.epoch=?1 AND n.key=?4 AND {scope}"),params![context.node_epoch,context.vector_epoch,project,id],|row|row.get(0)).optional()?;
+            if let Some(position) = row {
+                selected.insert(id.clone(), position);
+            }
+        }
+        (selected, false)
+    };
+    let mut ranked = Vec::new();
+    let mut degree_capped = false;
+    for (id, position) in candidates {
+        let (degree, capped) = degree(connection, &context, project, &id)?;
+        degree_capped |= capped;
+        ranked.push((id, position, degree));
+    }
+    ranked.sort_by(|left, right| right.2.cmp(&left.2).then_with(|| left.1.cmp(&right.1)));
+    ranked.truncate(top_n);
+    let mut items = Vec::new();
+    let mut bytes = 256usize;
+    for (id, position, degree) in ranked {
+        let remaining = max_bytes.saturating_sub(bytes);
+        match load_row(connection, NODES, &id, remaining)? {
+            RowLoad::Value(value)
+                if value["id"].as_str() == Some(id.as_str())
+                    && value["stale"] != Value::Bool(true) =>
+            {
+                let item = json!({"key":id,"id":id,"position":position.to_string(),"degree":degree,"value":value});
+                let size = item_bytes(&item)?.saturating_add(1);
+                if bytes.saturating_add(size) > max_bytes {
+                    return Ok(as_partial("graph_node_too_large", project, &context, items));
+                }
+                bytes += size;
+                items.push(item);
+            }
+            RowLoad::Oversized => {
+                return Ok(as_partial("graph_node_too_large", project, &context, items))
+            }
+            RowLoad::Missing | RowLoad::Stale | RowLoad::Invalid | RowLoad::Value(_) => {
+                return Ok(as_partial("graph_index_stale", project, &context, items))
+            }
+        }
+    }
+    let approximate = candidate_more || degree_capped || context.authority_incomplete;
+    let reason = if candidate_more {
+        Some("project_candidate_budget")
+    } else if degree_capped {
+        Some("degree_count_capped")
+    } else if context.authority_incomplete {
+        Some("project_authority_incomplete")
+    } else {
+        None
+    };
+    Ok(with_projection_status(
+        json!({"status":if approximate{"partial"}else{"ready"},"reason":reason,"approximate":approximate,"project":project,"items":items,"has_more":false,"next_cursor":null,"revision":{"nodes":context.node_revision,"edges":context.edge_revision,"vectors":context.vector_revision}}),
+        &context,
+    ))
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/legacy_work.rs b/engine/src/workers/state/adapters/sqlite/retrieval/legacy_work.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/legacy_work.rs
@@ -0,0 +1,147 @@
+use super::super::{database, protocol};
+use rusqlite::{Connection, OptionalExtension, params};
+use serde_json::{Value, json};
+use sha2::{Digest, Sha256};
+
+const SCOPE: &str = "mem:fireworks-batch:work-items";
+const MAX_BYTES: i64 = 65_536;
+
+fn text_field<'a>(value: &'a Value, name: &str, max: usize) -> Option<&'a str> {
+    value
+        .get(name)
+        .and_then(Value::as_str)
+        .filter(|text| !text.is_empty() && text.len() <= max)
+}
+
+fn string_array(value: &Value, max_items: usize) -> Option<Vec<String>> {
+    let items = value.as_array()?;
+    if items.len() > max_items {
+        return None;
+    }
+    let mut output = Vec::with_capacity(items.len());
+    for item in items {
+        let text = item
+            .as_str()
+            .filter(|text| !text.is_empty() && text.len() <= 256)?;
+        output.push(text.to_owned());
+    }
+    Some(output)
+}
+
+fn metadata(value: &Value) -> Option<Value> {
+    let raw = value
+        .get("metadata")
+        .filter(|metadata| metadata.is_object())?;
+    let mut projected = serde_json::Map::new();
+    if let Some(project) = text_field(raw, "project", 256) {
+        projected.insert("project".into(), json!(project));
+    }
+    if let Some(fingerprint) = text_field(raw, "sourceFingerprint", 256) {
+        projected.insert("sourceFingerprint".into(), json!(fingerprint));
+    }
+    if let Some(cluster_raw) = text_field(raw, "cluster", MAX_BYTES as usize) {
+        let cluster: Value = serde_json::from_str(cluster_raw).ok()?;
+        let mut cluster_projected = serde_json::Map::new();
+        for field in [
+            "concepts",
+            "factIds",
+            "lessonIds",
+            "crystalIds",
+            "memoryIds",
+            "observationIds",
+        ] {
+            if cluster.get(field).is_some() {
+                let max = if field == "concepts" { 128 } else { 4096 };
+                cluster_projected
+                    .insert(field.to_owned(), json!(string_array(&cluster[field], max)?));
+            }
+        }
+        projected.insert(
+            "cluster".into(),
+            Value::String(serde_json::to_string(&Value::Object(cluster_projected)).ok()?),
+        );
+    }
+    if let Some(source_ids) = raw.get("sourceIds") {
+        if source_ids.is_array() {
+            projected.insert("sourceIds".into(), json!(string_array(source_ids, 4096)?));
+        } else if let Some(serialized) = source_ids.as_str() {
+            let parsed: Value = serde_json::from_str(serialized).ok()?;
+            projected.insert(
+                "sourceIds".into(),
+                Value::String(serde_json::to_string(&json!(string_array(&parsed, 4096)?)).ok()?),
+            );
+        }
+    }
+    Some(Value::Object(projected))
+}
+
+pub(super) fn projection(key: &str, value: &Value, version: &str) -> Option<Value> {
+    if !value.is_object()
+        || value["id"].as_str() != Some(key)
+        || value["callbackProtocolVersion"].as_u64() != Some(1)
+        || text_field(value, "task", 64) != Some("reflection")
+        || text_field(value, "state", 64) != Some("queued")
+        || value.get("batchJobId").is_some_and(|v| !v.is_null())
+        || value.get("result").is_some_and(|v| !v.is_null())
+        || value.get("completionIntent").is_some_and(|v| !v.is_null())
+    {
+        return None;
+    }
+    let metadata = metadata(value)?;
+    Some(json!({
+        "id":key,
+        "correlationId":text_field(value,"correlationId",256),
+        "callbackProtocolVersion":value.get("callbackProtocolVersion"),
+        "task":text_field(value,"task",64),
+        "state":text_field(value,"state",64),
+        "metadata":metadata,
+        "has_result":value.get("result").is_some_and(|result| !result.is_null()),
+        "has_completion_intent":value.get("completionIntent").is_some_and(|intent| !intent.is_null()),
+        "version":version,
+    }))
+}
+
+pub(super) fn fingerprint(version: &str, projection: &Value) -> anyhow::Result<String> {
+    Ok(format!(
+        "{:x}",
+        Sha256::digest(serde_json::to_vec(
+            &json!({"version":version,"item":projection})
+        )?)
+    ))
+}
+
+pub fn execute(connection: &Connection, key: &str, max_bytes: usize) -> anyhow::Result<Value> {
+    if max_bytes > MAX_BYTES as usize {
+        return Err(super::request::resource());
+    }
+    let meta: Option<(String, i64, i64)> = connection.query_row(
+        "SELECT version,value_bytes,CASE typeof(value) WHEN 'blob' THEN stored_bytes WHEN 'text' THEN stored_bytes*4 ELSE 0 END FROM state_values WHERE scope=?1 AND key=?2 AND live=1",
+        params![SCOPE,key], |row| Ok((row.get(0)?,row.get(1)?,row.get(2)?))).optional()?;
+    let Some((version, logical, stored)) = meta else {
+        return Ok(json!({"item":null,"deferred":{"key":key,"reason":"missing"}}));
+    };
+    if !(1..=MAX_BYTES).contains(&logical) || !(1..=MAX_BYTES).contains(&stored) {
+        return Ok(json!({"item":null,"deferred":{"key":key,"reason":"oversized"}}));
+    }
+    let encoded: Option<Vec<u8>> = connection.query_row(
+        "SELECT value FROM state_values WHERE scope=?1 AND key=?2 AND version=?3 AND live=1 AND value_bytes BETWEEN 1 AND ?4 AND CASE typeof(value) WHEN 'blob' THEN stored_bytes WHEN 'text' THEN stored_bytes*4 ELSE 0 END BETWEEN 1 AND ?4",
+        params![SCOPE,key,version,MAX_BYTES], |row| Ok(row.get_ref(0)?.as_bytes()?.to_vec())).optional()?;
+    let Some(encoded) = encoded else {
+        return Ok(json!({"item":null,"deferred":{"key":key,"reason":"stale"}}));
+    };
+    let raw = database::decode_value(&encoded, logical)?;
+    let value: Value = match serde_json::from_str::<Value>(&raw) {
+        Ok(value) if value.is_object() && value["id"].as_str() == Some(key) => value,
+        _ => return Ok(json!({"item":null,"deferred":{"key":key,"reason":"invalid_record"}})),
+    };
+    let Some(projected) = projection(key, &value, &version) else {
+        return Ok(json!({"item":null,"deferred":{"key":key,"reason":"not_eligible"}}));
+    };
+    if protocol::size(&projected)? > max_bytes {
+        return Ok(json!({"item":null,"deferred":{"key":key,"reason":"projection_oversized"}}));
+    }
+    let fingerprint = fingerprint(&version, &projected)?;
+    let mut item = projected;
+    item["fingerprint"] = json!(fingerprint);
+    Ok(json!({"item":item,"version":version,"fingerprint":fingerprint,"deferred":null}))
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/lexical.rs b/engine/src/workers/state/adapters/sqlite/retrieval/lexical.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/lexical.rs
@@ -0,0 +1,166 @@
+use super::super::protocol;
+use super::{request, semantic, source};
+use rusqlite::{Connection, OptionalExtension, params};
+use serde_json::{Value, json};
+use std::collections::BTreeSet;
+
+pub fn schema(connection: &Connection) -> anyhow::Result<()> {
+    connection.execute_batch(&format!("CREATE VIRTUAL TABLE IF NOT EXISTS retrieval_lexical USING fts5({});
+        CREATE TABLE IF NOT EXISTS retrieval_lexical_links(index_id TEXT NOT NULL,epoch INTEGER NOT NULL,id TEXT NOT NULL,rowid INTEGER NOT NULL UNIQUE,PRIMARY KEY(index_id,epoch,id)) WITHOUT ROWID;",super::lexical_content::DECLARATION))?;
+    super::lexical_content::schema(connection)
+}
+
+pub fn replace(
+    connection: &Connection,
+    meta: &semantic::Meta,
+    key: &str,
+    value: Option<&Value>,
+) -> anyhow::Result<()> {
+    let rowid: Option<i64> = connection
+        .query_row(
+            "SELECT rowid FROM retrieval_lexical_links WHERE index_id=?1 AND epoch=?2 AND id=?3",
+            params![meta.index_id, meta.epoch, key],
+            |r| r.get(0),
+        )
+        .optional()?;
+    if let Some(rowid) = rowid {
+        super::super::storage_lexical_repack::mirror_delete(connection, rowid)?;
+        super::super::storage_lexical_repack::delete_table(connection,"retrieval_lexical",rowid)?;
+        connection.execute("DELETE FROM retrieval_lexical_content_proof WHERE rowid=?1", [rowid])?;
+        connection.execute(
+            "DELETE FROM retrieval_lexical_links WHERE index_id=?1 AND epoch=?2 AND id=?3",
+            params![meta.index_id, meta.epoch, key],
+        )?;
+        connection.execute(
+            "UPDATE retrieval_semantic_meta SET lexical_count=lexical_count-1 WHERE index_id=?1",
+            [&meta.index_id],
+        )?;
+    }
+    let Some(value) = value else {
+        return Ok(());
+    };
+    let Some(text) = source::lexical_text(connection, &meta.index_id, value)? else {
+        return Ok(());
+    };
+    protocol::require(!text.trim().is_empty() && text.len() <= 1_048_576)?;
+    if source::kind(connection, &meta.index_id)?.is_none() {
+        protocol::require(text.len() <= 65_536)?;
+    }
+    let rowid = if super::lexical_content::active(connection)? {
+        let highest:i64=connection.query_row("SELECT coalesce(max(rowid),0) FROM retrieval_lexical_links",[],|r|r.get(0))?;
+        let rowid=highest.checked_add(1).ok_or_else(||protocol::error("STATE_TX_LIMIT_EXCEEDED"))?;
+        connection.execute("INSERT INTO retrieval_lexical(rowid,index_id,epoch,id,text) VALUES(?1,?2,?3,?4,?5)",params![rowid,meta.index_id,meta.epoch,key,text])?;
+        rowid
+    } else {
+        connection.execute("INSERT INTO retrieval_lexical(index_id,epoch,id,text) VALUES(?1,?2,?3,?4)",params![meta.index_id,meta.epoch,key,text])?;
+        connection.last_insert_rowid()
+    };
+    connection.execute(
+        "INSERT INTO retrieval_lexical_links VALUES(?1,?2,?3,?4)",
+        params![meta.index_id, meta.epoch, key, rowid],
+    )?;
+    super::super::storage_lexical_repack::mirror_insert(connection,rowid,&meta.index_id,meta.epoch,key,&text)?;
+    connection.execute(
+        "UPDATE retrieval_semantic_meta SET lexical_count=lexical_count+1 WHERE index_id=?1",
+        [&meta.index_id],
+    )?;
+    Ok(())
+}
+
+fn expression(query: &str) -> anyhow::Result<Option<String>> {
+    let terms: BTreeSet<String> = query
+        .split(|c: char| !(c.is_alphanumeric() || c == '_'))
+        .filter(|v| !v.is_empty())
+        .map(str::to_lowercase)
+        .collect();
+    if terms.len() > 32 || terms.iter().any(|v| v.len() > 256) {
+        return Err(request::resource());
+    }
+    if terms.is_empty() {
+        return Ok(None);
+    }
+    Ok(Some(
+        terms
+            .into_iter()
+            .map(|v| format!("\"{v}\""))
+            .collect::<Vec<_>>()
+            .join(" OR "),
+    ))
+}
+
+pub fn search(
+    connection: &Connection,
+    id: &str,
+    model: &str,
+    dimensions: usize,
+    generation: &str,
+    query: &str,
+    limit: usize,
+    max_candidates: usize,
+    options: super::search_projection::Options<'_>,
+) -> anyhow::Result<Value> {
+    let super::search_projection::Options {
+        project,
+        session_id,
+        source_scope,
+        source_kind,
+        ..
+    } = options;
+    let meta = semantic::get(connection, id)?;
+    meta.identity(model, dimensions, generation)?;
+    if source_scope.is_some() || source_kind.is_some() || options.include_text {
+        protocol::require(source::kind(connection, id)?.is_some())?;
+    }
+    if project.is_some() {
+        return super::scoped::keyword_search(
+            connection,
+            &meta,
+            expression(query)?.as_deref(),
+            limit,
+            max_candidates,
+            options,
+        );
+    }
+    meta.ready(connection)?;
+    if meta.lexical_count != meta.count {
+        return Err(protocol::error("STATE_LEXICAL_INDEX_NOT_READY"));
+    }
+    let mut output = Vec::new();
+    if let Some(expression) = expression(query)? {
+        let global_sql = "SELECT l.id,v.session_id,bm25(retrieval_lexical) FROM retrieval_lexical CROSS JOIN retrieval_lexical_links l ON l.rowid=retrieval_lexical.rowid CROSS JOIN retrieval_vector_values v ON v.index_id=l.index_id AND v.epoch=l.epoch AND v.id=l.id WHERE retrieval_lexical MATCH ?1 AND l.index_id=?2 AND l.epoch=?3 AND (?7 IS NULL OR v.session_id=?7) ORDER BY bm25(retrieval_lexical),l.id LIMIT ?5";
+        let source_predicate = super::search_projection::filter("?8", "?9");
+        let global_sql = global_sql.replace(" ORDER BY", &format!("{source_predicate} ORDER BY"));
+        let mut statement = connection.prepare_cached(&global_sql)?;
+        let mut rows = statement.query(params![
+            expression,
+            id,
+            meta.epoch,
+            Option::<String>::None,
+            max_candidates as i64,
+            Option::<String>::None,
+            session_id,
+            source_scope,
+            source_kind
+        ])?;
+        while let Some(row) = rows.next()? {
+            let score: f64 = row.get(2)?;
+            if !score.is_finite() {
+                return Err(protocol::error("STATE_INDEX_NOT_READY"));
+            }
+            output.push(json!({"obsId":row.get::<_,String>(0)?,"sessionId":row.get::<_,String>(1)?,"score":-score}));
+        }
+    }
+    output.truncate(limit);
+    let incomplete =
+        project.is_some() && super::project_catalog::has_incomplete_authority(connection)?;
+    let projection = super::search_projection::enrich(connection, id, &mut output, options)?;
+    let status = if incomplete || projection.is_some() {
+        "partial"
+    } else {
+        "ready"
+    };
+    let candidates = output.len();
+    Ok(
+        json!({"items":output,"model":model,"dimensions":dimensions,"generation":generation,"status":status,"reason":if incomplete {Some("project_authority_incomplete")} else {projection},"candidates":candidates}),
+    )
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/lexical_content.rs b/engine/src/workers/state/adapters/sqlite/retrieval/lexical_content.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/lexical_content.rs
@@ -0,0 +1,223 @@
+use super::super::protocol;
+use rusqlite::{Connection, OptionalExtension, params};
+use serde_json::Value;
+
+pub const MAX_TEXT: usize = 1_048_576;
+pub const MAX_SOURCE: i64 = 262_144;
+pub const DECLARATION: &str = "index_id UNINDEXED,epoch UNINDEXED,id UNINDEXED,text,tokenize='unicode61 tokenchars ''_'''";
+pub const SOURCE_CANDIDATE_SQL:&str="SELECT s.scope,s.key,s.version,m.model,m.generation,l.epoch,v.value_bytes,v.stored_bytes,l.index_id,e.value_bytes,e.stored_bytes FROM retrieval_lexical_links l CROSS JOIN retrieval_semantic_meta m ON m.index_id=l.index_id AND m.epoch=l.epoch CROSS JOIN retrieval_source_meta sm ON sm.index_id=m.index_id CROSS JOIN retrieval_source_items s INDEXED BY retrieval_source_items_id ON s.index_id=l.index_id AND s.key=l.id AND s.dirty=0 CROSS JOIN state_values v ON v.scope=s.scope AND v.key=s.key AND v.version=s.version AND v.live=1 CROSS JOIN state_values e ON e.scope='mem:semantic:'||l.index_id AND e.key=l.id AND e.live=1 WHERE l.rowid=?1 LIMIT 1";
+pub fn schema(c: &Connection) -> anyhow::Result<()> {
+    c.execute_batch("CREATE TABLE IF NOT EXISTS retrieval_lexical_content_proof(rowid INTEGER PRIMARY KEY,scope TEXT,key TEXT,version TEXT,recipe INTEGER NOT NULL,model TEXT,generation TEXT,epoch INTEGER,bytes INTEGER NOT NULL,literal TEXT);
+        CREATE INDEX IF NOT EXISTS retrieval_lexical_content_source ON retrieval_lexical_content_proof(scope,key) WHERE literal IS NULL;")?;
+    // Both ordinary SDK writes and direct native deletes reach these BEFORE triggers.
+    for event in ["UPDATE", "DELETE"] {
+        c.execute_batch(&format!("CREATE TRIGGER IF NOT EXISTS lexical_content_before_{event} BEFORE {event} ON state_rows
+          WHEN EXISTS(SELECT 1 FROM retrieval_lexical_content_proof WHERE scope=OLD.scope AND key=OLD.key AND literal IS NULL)
+          BEGIN
+            SELECT CASE WHEN EXISTS(SELECT 1 FROM retrieval_lexical_content_proof WHERE scope=OLD.scope AND key=OLD.key AND literal IS NULL AND (version<>OLD.version OR recipe<>1)) THEN RAISE(ABORT,'STATE_LEXICAL_SOURCE_VERSION_MISMATCH') END;
+            UPDATE retrieval_lexical_content_proof SET literal=(SELECT state_lexical_project(state_json(value,value_bytes),OLD.scope) FROM state_values WHERE scope=OLD.scope AND key=OLD.key AND live=1) WHERE scope=OLD.scope AND key=OLD.key AND literal IS NULL;
+            SELECT CASE WHEN EXISTS(SELECT 1 FROM retrieval_lexical_content_proof WHERE scope=OLD.scope AND key=OLD.key AND (literal IS NULL OR length(CAST(literal AS BLOB))<>bytes)) THEN RAISE(ABORT,'STATE_LEXICAL_SOURCE_UNAVAILABLE') END;
+          END;"))?;
+    }
+    Ok(())
+}
+
+pub fn register(c: &Connection) -> anyhow::Result<()> {
+    use rusqlite::functions::FunctionFlags;
+    c.create_scalar_function("state_lexical_project", 2, FunctionFlags::SQLITE_UTF8 | FunctionFlags::SQLITE_DETERMINISTIC | FunctionFlags::SQLITE_INNOCUOUS, |context| {
+        let raw = context.get::<String>(0)?;
+        let scope = context.get::<String>(1)?;
+        let projected = (|| -> anyhow::Result<String> {
+            anyhow::ensure!(raw.len() <= MAX_TEXT, "STATE_LEXICAL_SOURCE_TOO_LARGE");
+            let document: Value = serde_json::from_str(&raw)?;
+            let text = super::source_lexical::project(&document, &scope)?;
+            anyhow::ensure!(text.len() <= MAX_TEXT, "STATE_LEXICAL_SOURCE_TOO_LARGE");
+            Ok(text)
+        })();
+        projected.map_err(|e| rusqlite::Error::UserFunctionError(e.into()))
+    })?;
+    c.create_scalar_function("state_lexical_project_prefix", 3, FunctionFlags::SQLITE_UTF8 | FunctionFlags::SQLITE_DETERMINISTIC | FunctionFlags::SQLITE_INNOCUOUS, |context| {
+        let raw = context.get::<String>(0)?;
+        let scope = context.get::<String>(1)?;
+        let max_bytes = context.get::<i64>(2)?;
+        let projected = (|| -> anyhow::Result<String> {
+            anyhow::ensure!(raw.len() <= MAX_TEXT, "STATE_LEXICAL_SOURCE_TOO_LARGE");
+            let document: Value = serde_json::from_str(&raw)?;
+            let (text, bytes) = super::source_lexical::project_prefix(&document, &scope, usize::try_from(max_bytes)?)?;
+            anyhow::ensure!(bytes <= MAX_TEXT, "STATE_LEXICAL_SOURCE_TOO_LARGE");
+            Ok(serde_json::to_string(&(text, bytes))?)
+        })();
+        projected.map_err(|e| rusqlite::Error::UserFunctionError(e.into()))
+    })?;
+    Ok(())
+}
+
+pub fn active(c: &Connection) -> anyhow::Result<bool> {
+    let version: i64 = c.pragma_query_value(None,"user_version",|r|r.get(0))?;
+    if version==4 {
+        let sql:String=c.query_row("SELECT sql FROM sqlite_schema WHERE type='table' AND name='retrieval_lexical'",[],|r|r.get(0))?;
+        return Ok(sql.contains(",content=''"));
+    }
+    Ok(version == 3)
+}
+pub fn validate_format(c:&Connection)->anyhow::Result<()> {
+    if !active(c)? {return Ok(());}
+    super::super::storage_lexical_repack::validate_schema(c,"retrieval_lexical",true)?;
+    let proof:bool=c.query_row("SELECT EXISTS(SELECT 1 FROM sqlite_schema WHERE name='retrieval_lexical_content_proof')",[],|r|r.get(0))?;
+    anyhow::ensure!(proof,"STATE_LEXICAL_FORMAT_UNSUPPORTED");Ok(())
+}
+pub fn rowid(c: &Connection, index: &str, epoch: i64, id: &str) -> anyhow::Result<Option<i64>> {
+    Ok(c.query_row("SELECT rowid FROM retrieval_lexical_links WHERE index_id=?1 AND epoch=?2 AND id=?3", params![index,epoch,id], |r|r.get(0)).optional()?)
+}
+pub fn length(c: &Connection, rowid: i64) -> anyhow::Result<Option<usize>> {
+    let bytes: Option<i64> = c.query_row("SELECT bytes FROM retrieval_lexical_content_proof WHERE rowid=?1",[rowid],|r|r.get(0)).optional()?;
+    let bytes = match bytes {
+        Some(bytes) => Some(bytes),
+        None if !active(c)? => c.query_row("SELECT length(CAST(text AS BLOB)) FROM retrieval_lexical WHERE rowid=?1",[rowid],|r|r.get(0)).optional()?.flatten(),
+        None => None,
+    };
+    bytes.map(|b|usize::try_from(b).map_err(Into::into)).transpose()
+}
+pub fn text(c: &Connection, rowid: i64) -> anyhow::Result<Option<String>> {
+    let saved: Option<(Option<String>,Option<String>,Option<String>,i64,i64,Option<String>)> = c.query_row("SELECT scope,key,version,recipe,bytes,literal FROM retrieval_lexical_content_proof WHERE rowid=?1",[rowid],|r|Ok((r.get(0)?,r.get(1)?,r.get(2)?,r.get(3)?,r.get(4)?,r.get(5)?))).optional()?;
+    let Some((scope,key,version,recipe,bytes,literal)) = saved else {
+        if active(c)? {return Err(protocol::error("STATE_LEXICAL_CONTENT_MISSING"));}
+        return Ok(c.query_row("SELECT text FROM retrieval_lexical WHERE rowid=?1",[rowid],|r|r.get(0)).optional()?);
+    };
+    let text = if let Some(text) = literal {text} else {
+        protocol::require(recipe == 1)?;
+        c.query_row("SELECT state_lexical_project(state_json(v.value,v.value_bytes),v.scope) FROM state_values v WHERE v.scope=?1 AND v.key=?2 AND v.version=?3 AND v.live=1 AND v.value_bytes<=1048576 AND v.stored_bytes<=1048576",params![scope,key,version],|r|r.get::<_,String>(0)).optional()?.ok_or_else(||protocol::error("STATE_LEXICAL_SOURCE_UNAVAILABLE"))?
+    };
+    anyhow::ensure!(text.len() == usize::try_from(bytes)? && text.len() <= MAX_TEXT,"STATE_LEXICAL_CONTENT_MISMATCH");
+    Ok(Some(text))
+}
+
+fn row_prefix(row: &rusqlite::Row<'_>, column: usize, max_bytes: usize) -> rusqlite::Result<(String, usize)> {
+    let value = row.get_ref(column)?;
+    let rusqlite::types::ValueRef::Text(raw) = value else {
+        return Err(rusqlite::Error::InvalidColumnType(column, row.as_ref().column_name(column)?.to_owned(), value.data_type()));
+    };
+    let text = std::str::from_utf8(raw).map_err(|e| rusqlite::Error::FromSqlConversionFailure(column, value.data_type(), Box::new(e)))?;
+    Ok((super::source_lexical::prefix(text, max_bytes).to_owned(), text.len()))
+}
+
+fn row_prefix_for_keyword(
+    row: &rusqlite::Row<'_>,
+    column: usize,
+    max_bytes: usize,
+    diagnostics: &super::search_projection::KeywordDiagnostics,
+    success_subpath: Option<&'static str>,
+) -> rusqlite::Result<(String, usize)> {
+    diagnostics.literal_started();
+    let timer = diagnostics.literal_validation();
+    let result = row_prefix(row, column, max_bytes);
+    drop(timer);
+    if result.is_ok() {
+        if let Some(subpath) = success_subpath {
+            diagnostics.set_subpath(subpath);
+        }
+    }
+    result
+}
+
+pub fn text_prefix(c: &Connection, rowid: i64, max_bytes: usize) -> anyhow::Result<Option<String>> {
+    Ok(text_prefix_inner(c, rowid, max_bytes, None)?.map(|(text, _)| text))
+}
+
+pub(super) fn text_prefix_for_keyword(
+    c: &Connection,
+    rowid: i64,
+    max_bytes: usize,
+    diagnostics: &super::search_projection::KeywordDiagnostics,
+) -> anyhow::Result<Option<(String, usize)>> {
+    text_prefix_inner(c, rowid, max_bytes, Some(diagnostics))
+}
+
+fn text_prefix_inner(
+    c: &Connection,
+    rowid: i64,
+    max_bytes: usize,
+    diagnostics: Option<&super::search_projection::KeywordDiagnostics>,
+) -> anyhow::Result<Option<(String, usize)>> {
+    let proof_lookup = diagnostics.map(|value| value.proof_lookup());
+    let saved: Option<(Option<String>,Option<String>,Option<String>,i64,i64,Option<(String,usize)>)> = c.query_row("SELECT scope,key,version,recipe,bytes,literal FROM retrieval_lexical_content_proof WHERE rowid=?1",[rowid],|r| {
+        let scope = r.get(0)?;
+        let key = r.get(1)?;
+        let version = r.get(2)?;
+        let recipe = r.get(3)?;
+        let bytes = r.get(4)?;
+        let literal = if matches!(r.get_ref(5)?, rusqlite::types::ValueRef::Null) {
+            None
+        } else {
+            Some(if let Some(diagnostics) = diagnostics {
+                row_prefix_for_keyword(r, 5, max_bytes, diagnostics, Some("proof_lookup"))?
+            } else {
+                row_prefix(r, 5, max_bytes)?
+            })
+        };
+        Ok((scope,key,version,recipe,bytes,literal))
+    }).optional()?;
+    drop(proof_lookup);
+    let Some((scope,key,version,recipe,bytes,literal)) = saved else {
+        if active(c)? {return Err(protocol::error("STATE_LEXICAL_CONTENT_MISSING"));}
+        let text = if let Some(diagnostics) = diagnostics {
+            c.query_row("SELECT text FROM retrieval_lexical WHERE rowid=?1", [rowid], |r| {
+                row_prefix_for_keyword(r, 0, max_bytes, diagnostics, None)
+            })
+            .optional()?
+        } else {
+            c.query_row("SELECT text FROM retrieval_lexical WHERE rowid=?1",[rowid],|r|row_prefix(r,0,max_bytes)).optional()?
+        };
+        return Ok(text);
+    };
+    let from_literal = literal.is_some();
+    let (text, full_bytes) = if let Some(literal) = literal {literal} else {
+        protocol::require(recipe == 1)?;
+        if let Some(diagnostics) = diagnostics {
+            diagnostics.recipe1_started();
+        }
+        let decode_timer = diagnostics.map(|value| value.decode_validation());
+        let projected: String = c.query_row("SELECT state_lexical_project_prefix(state_json(v.value,v.value_bytes),v.scope,?4) FROM state_values v WHERE v.scope=?1 AND v.key=?2 AND v.version=?3 AND v.live=1 AND v.value_bytes<=1048576 AND v.stored_bytes<=1048576",params![scope,key,version,i64::try_from(max_bytes)?],|r|r.get(0)).optional()?.ok_or_else(||protocol::error("STATE_LEXICAL_SOURCE_UNAVAILABLE"))?;
+        let decoded = serde_json::from_str::<(String,usize)>(&projected)?;
+        drop(decode_timer);
+        decoded
+    };
+    let validation_timer = diagnostics.map(|value| if from_literal {
+        value.literal_validation()
+    } else {
+        value.decode_validation()
+    });
+    anyhow::ensure!(full_bytes == usize::try_from(bytes)? && full_bytes <= MAX_TEXT,"STATE_LEXICAL_CONTENT_MISMATCH");
+    drop(validation_timer);
+    if let Some(diagnostics) = diagnostics {
+        diagnostics.set_subpath("proof_lookup");
+    }
+    Ok(Some((text, full_bytes)))
+}
+
+pub fn save(c: &Connection, rowid: i64, text: &str) -> anyhow::Result<&'static str> {
+    protocol::require(text.len() <= MAX_TEXT)?;
+    c.execute("DELETE FROM retrieval_lexical_content_proof WHERE rowid=?1",[rowid])?;
+    let candidate: Option<(String,String,String,String,String,i64,i64,i64,String,i64,i64)> = c.prepare_cached(SOURCE_CANDIDATE_SQL)?.query_row([rowid],|r|Ok((r.get(0)?,r.get(1)?,r.get(2)?,r.get(3)?,r.get(4)?,r.get(5)?,r.get(6)?,r.get(7)?,r.get(8)?,r.get(9)?,r.get(10)?))).optional()?;
+    let mut reason = "missing_dirty_or_historical";
+    if let Some((scope,key,version,model,generation,epoch,logical,stored,index,embedding_logical,embedding_stored)) = candidate {
+        if super::source::tracked_scope(&scope) && [logical,stored,embedding_logical,embedding_stored].iter().all(|n|(1..=MAX_SOURCE).contains(n)) {
+            let embedding:String=c.query_row("SELECT state_json(value,value_bytes) FROM state_values WHERE scope=?1 AND key=?2",params![format!("mem:semantic:{index}"),key],|r|r.get(0))?;
+            let binding=serde_json::from_str::<Value>(&embedding).ok().is_some_and(|v|v["id"]==key && v["sourceScope"]==scope && v["sourceVersion"]==version && v["model"]==model && v["generation"]==generation);
+            if !binding {
+                c.execute("INSERT INTO retrieval_lexical_content_proof(rowid,recipe,bytes,literal) VALUES(?1,0,?2,?3)",params![rowid,text.len() as i64,text])?;
+                return Ok("semantic_binding_stale");
+            }
+            // Invalid canonical documents retain the literal; cancellation and resource errors propagate.
+            let raw: String = c.query_row("SELECT state_json(value,value_bytes) FROM state_values WHERE scope=?1 AND key=?2",params![scope,key],|r|r.get(0))?;
+            let projected = serde_json::from_str::<Value>(&raw).ok().filter(|v|v["id"].as_str()==Some(key.as_str())).and_then(|v|super::source_lexical::project(&v,&scope).ok());
+            if projected.as_deref() == Some(text) {
+                c.execute("INSERT INTO retrieval_lexical_content_proof VALUES(?1,?2,?3,?4,1,?5,?6,?7,?8,NULL)",params![rowid,scope,key,version,model,generation,epoch,text.len() as i64])?;
+                return Ok("canonical_exact");
+            }
+            reason = "canonical_mismatch_or_invalid";
+        } else {reason = "canonical_oversized_or_unknown_scope";}
+    }
+    c.execute("INSERT INTO retrieval_lexical_content_proof(rowid,recipe,bytes,literal) VALUES(?1,0,?2,?3)",params![rowid,text.len() as i64,text])?;
+    Ok(reason)
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/lsh.rs b/engine/src/workers/state/adapters/sqlite/retrieval/lsh.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/lsh.rs
@@ -0,0 +1,139 @@
+use super::super::protocol::{error, require};
+use base64::{Engine, engine::general_purpose::STANDARD};
+
+pub const TABLES: usize = 12;
+const BITS: usize = 12;
+
+pub fn decode(encoded: &str, dimensions: usize) -> anyhow::Result<Vec<f32>> {
+    let bytes = dimensions
+        .checked_mul(4)
+        .ok_or_else(|| error("STATE_TX_INVALID_REQUEST"))?;
+    require(encoded.len() == bytes.div_ceil(3) * 4)?;
+    let raw = STANDARD
+        .decode(encoded)
+        .map_err(|_| error("STATE_TX_INVALID_REQUEST"))?;
+    require(raw.len() == bytes)?;
+    let vector: Vec<f32> = raw
+        .chunks_exact(4)
+        .map(|part| f32::from_le_bytes([part[0], part[1], part[2], part[3]]))
+        .collect();
+    normalize(vector)
+}
+
+fn normalize(mut vector: Vec<f32>) -> anyhow::Result<Vec<f32>> {
+    require(vector.iter().all(|v| v.is_finite()))?;
+    let norm = vector
+        .iter()
+        .map(|v| (*v as f64).powi(2))
+        .sum::<f64>()
+        .sqrt();
+    require(norm.is_finite() && norm > 0.0)?;
+    for value in &mut vector {
+        *value = (*value as f64 / norm) as f32;
+    }
+    Ok(vector)
+}
+
+pub fn blob(vector: &[f32]) -> Vec<u8> {
+    vector
+        .iter()
+        .flat_map(|value| value.to_le_bytes())
+        .collect()
+}
+pub fn from_blob(bytes: &[u8], dimensions: usize) -> anyhow::Result<Vec<f32>> {
+    if bytes.len() != dimensions * 4 {
+        return Err(error("STATE_INDEX_NOT_READY"));
+    }
+    let vector: Vec<f32> = bytes
+        .chunks_exact(4)
+        .map(|part| f32::from_le_bytes([part[0], part[1], part[2], part[3]]))
+        .collect();
+    if !vector.iter().all(|v| v.is_finite()) {
+        return Err(error("STATE_INDEX_NOT_READY"));
+    }
+    Ok(vector)
+}
+
+pub struct Signature {
+    pub bucket: u16,
+    margins: [f64; BITS],
+}
+
+fn random(state: &mut u64) -> u64 {
+    *state ^= *state << 13;
+    *state ^= *state >> 7;
+    *state ^= *state << 17;
+    *state
+}
+
+pub fn signatures(vector: &[f32]) -> Vec<Signature> {
+    (0..TABLES)
+        .map(|table| {
+            let mut signature = Signature {
+                bucket: 0,
+                margins: [0.0; BITS],
+            };
+            for bit in 0..BITS {
+                let mut seed =
+                    0x9e37_79b9_7f4a_7c15u64.wrapping_mul((table * BITS + bit + 1) as u64);
+                let mut dot = 0.0;
+                for value in vector {
+                    dot += if random(&mut seed) & 1 == 0 {
+                        *value as f64
+                    } else {
+                        -(*value as f64)
+                    };
+                }
+                if dot >= 0.0 {
+                    signature.bucket |= 1 << bit;
+                }
+                signature.margins[bit] = dot.abs();
+            }
+            signature
+        })
+        .collect()
+}
+
+pub fn buckets(signature: &Signature, probes: usize) -> Vec<u16> {
+    let mut masks = vec![(0.0, 0u16)];
+    for a in 0..BITS {
+        masks.push((signature.margins[a], 1 << a));
+        for b in (a + 1)..BITS {
+            masks.push((
+                signature.margins[a] + signature.margins[b],
+                (1 << a) | (1 << b),
+            ));
+            for c in (b + 1)..BITS {
+                masks.push((
+                    signature.margins[a] + signature.margins[b] + signature.margins[c],
+                    (1 << a) | (1 << b) | (1 << c),
+                ));
+            }
+        }
+    }
+    masks.sort_unstable_by(|a, b| a.0.total_cmp(&b.0).then(a.1.cmp(&b.1)));
+    masks
+        .into_iter()
+        .take(probes)
+        .map(|(_, mask)| signature.bucket ^ mask)
+        .collect()
+}
+
+pub fn cosine(query: &[f32], vector: &[f32]) -> f64 {
+    let dot: f64 = query
+        .iter()
+        .zip(vector)
+        .map(|(a, b)| *a as f64 * *b as f64)
+        .sum();
+    let q = query
+        .iter()
+        .map(|v| (*v as f64).powi(2))
+        .sum::<f64>()
+        .sqrt();
+    let v = vector
+        .iter()
+        .map(|v| (*v as f64).powi(2))
+        .sum::<f64>()
+        .sqrt();
+    (dot / (q * v)).clamp(-1.0, 1.0)
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/metadata.rs b/engine/src/workers/state/adapters/sqlite/retrieval/metadata.rs
