+            need(!profile.model.is_empty() && profile.model.len()<=128 && !profile.model.chars().any(char::is_control)
+                && (1..=120_000).contains(&profile.timeout_ms) && (1..=8*1024*1024).contains(&profile.max_response_bytes)
+                && super::wire::id(&profile.contract.id,128) && super::wire::id(&profile.contract.version,128)
+                && super::wire::id(&profile.contract.parser_version,128),CONFIG)?;
+            let schema=protocol::strict_value(&profile.contract.schema_json).map_err(|_|error(CONFIG))?;
+            need(schema.is_object() && binding::secret_free(&schema),CONFIG)?;
+            let mut pointers=HashSet::new();
+            for segment in &profile.segments {
+                need(super::wire::pointer(&segment.request_pointer) && pointers.insert(&segment.request_pointer)
+                    && profile.request_template.pointer(&segment.request_pointer)==Some(&Value::Null)
+                    && (1..=32).contains(&segment.sources.len()) && segment.prefix.len()<=1024*1024
+                    && segment.separator.len()<=1024*1024 && segment.suffix.len()<=1024*1024,CONFIG)?;
+                for source in &segment.sources {
+                    need(!source.key.is_empty() && source.key.len()<=2048 && super::wire::pointer(&source.pointer),CONFIG)?;
+                    let expanded=source.key.replace("{delta}","1").replace("{part}","0").replace("{unit}","unit");
+                    need(!expanded.chars().any(|character| ['{','}'].contains(&character)),CONFIG)?;
+                    need(!source.key.contains("{unit}") || profile.unit_pointer.is_some(),CONFIG)?;
+                    match source.scope {
+                        Scope::JobInputs=>need(!source.key.contains("{part}") || source.key=="capture:{part}" && source.pointer.is_empty(),CONFIG)?,
+                        Scope::ProviderValues=>need(source.key.starts_with("value:") && !source.key.contains(":part:") && !source.key.contains("{part}"),CONFIG)?,
+                    }
+                }
+            }
+            if let Some(model)=profile.request_template.get("model") { need(model==&profile.model,CONFIG)?; }
+        }
+        Ok(Self {profiles:declaration.profiles,_handles:(file,directory)})
+    }
+    pub fn authorize(&self, connection:&Connection, anchor:&Anchor, definition:&Binding, job:&Value, expected:Option<&str>)->anyhow::Result<String> {
+        let original_body=protocol::strict_value(&definition.request_json)?;
+        for profile in self.profiles.iter().filter(|profile|expected.is_none_or(|id|profile.id==id)
+            && profile.endpoint==definition.endpoint && profile.model==definition.model && profile.timeout_ms==definition.timeout_ms
+            && profile.max_response_bytes==definition.max_response_bytes && profile.contract==definition.contract) {
+        let candidate=(||->anyhow::Result<()> {
+        let mut body=original_body.clone();
+        let unit=if let Some(pointer)=&profile.unit_pointer {
+            job.pointer(pointer).and_then(Value::as_str).filter(|unit|super::wire::id(unit,128)).ok_or_else(||error("STATE_GRAPH_AUTOMATIC_PROFILE_NOT_APPROVED"))?
+        } else {""};
+        need(profile.value_name_template.replace("{delta}",&anchor.delta_ordinal.to_string()).replace("{unit}",unit)==anchor.value_name,
+            "STATE_GRAPH_AUTOMATIC_PROFILE_NOT_APPROVED")?;
+        need(profile.segments.len()==definition.segments.len(),"STATE_GRAPH_AUTOMATIC_PROFILE_NOT_APPROVED")?;
+        for (rule,segment) in profile.segments.iter().zip(&definition.segments) {
+            need(rule.request_pointer==segment.request_pointer && rule.prefix==segment.prefix && rule.separator==segment.separator
+                && rule.suffix==segment.suffix,"STATE_GRAPH_AUTOMATIC_PROFILE_NOT_APPROVED")?;
+            let mut expected_sources=Vec::new();
+            for source in &rule.sources {
+                let scope=match source.scope {Scope::JobInputs=>format!("mem:graph:inputs:{}",anchor.job_id),Scope::ProviderValues=>anchor.provider_scope()};
+                let parts=if source.key.contains("{part}") {
+                    job["captureParts"].as_u64().filter(|parts|(1..=512).contains(parts)).ok_or_else(||error("STATE_GRAPH_AUTOMATIC_SOURCE_INCOMPLETE"))?
+                } else {1};
+                for part in 0..parts {
+                    expected_sources.push((scope.clone(),source.key.replace("{delta}",&anchor.delta_ordinal.to_string()).replace("{part}",&part.to_string()).replace("{unit}",unit),source.pointer.clone()));
+                }
+            }
+            need(expected_sources.len()==segment.sources.len(),"STATE_GRAPH_AUTOMATIC_PROFILE_NOT_APPROVED")?;
+            for ((scope,key,pointer),source) in expected_sources.iter().zip(&segment.sources) {
+                need(scope==&source.scope && key==&source.key && pointer==&source.pointer,"STATE_GRAPH_AUTOMATIC_PROFILE_NOT_APPROVED")?;
+            }
+            let selected=body.pointer_mut(&rule.request_pointer).ok_or_else(||error(INVALID))?;
+            need(selected.is_string(),"STATE_GRAPH_AUTOMATIC_PROFILE_NOT_APPROVED")?;
+            *selected=Value::Null;
+        }
+        need(body==profile.request_template,"STATE_GRAPH_AUTOMATIC_PROFILE_NOT_APPROVED")?;
+        Ok(())
+        })();
+        if candidate.is_err() {continue;}
+        let canonical=serde_json::to_string(profile)?;
+        let pinned:Option<String>=connection.query_row("SELECT declaration FROM engine_graph_auto_authorities WHERE profile_id=?1",[&profile.id],|r|r.get(0)).optional()?;
+        if let Some(pinned)=pinned { need(pinned==canonical,"STATE_GRAPH_AUTOMATIC_AUTHORITY_CHANGED")?; }
+        else {connection.execute("INSERT INTO engine_graph_auto_authorities(profile_id,declaration) VALUES(?1,?2)",params![profile.id,canonical])?;}
+        return Ok(profile.id.clone());
+        }
+        Err(error("STATE_GRAPH_AUTOMATIC_PROFILE_NOT_APPROVED"))
+    }
+}
