+#[tokio::test]
+async fn graph_metadata_preparation_pages_resume_and_writes_stale_partial_cache() {
+    let (_directory, adapter) = fresh();
+    adapter
+        .mutate(4096, |connection| {
+            for index in 0..5 {
+                let key = format!("node-{index}");
+                database::write(
+                    connection,
+                    protocol::GRAPH_RECORD_SCOPES[0],
+                    &key,
+                    Some(&json!({"index":index})),
+                )?;
+            }
+            database::write(connection, protocol::GRAPH_RECORD_SCOPES[0], "tombstone", None)?;
+            Ok(())
+        })
+        .await
+        .unwrap();
+
+    let mut pages = 0;
+    let mut rows_scanned = 0;
+    loop {
+        let page = prepare(&adapter, 2).await.unwrap();
+        pages += 1;
+        let page_rows = page["rows_scanned"].as_u64().unwrap();
+        assert!(page_rows <= 2);
+        rows_scanned += page_rows;
+        if pages == 1 {
+            assert_eq!(page["status"], "preparing");
+            assert_eq!(read(&adapter).await.unwrap()["status"], "preparing");
+        }
+        if page["status"] == "complete" {
+            assert_eq!(page["rows"], 5);
+            break;
+        }
+        assert_eq!(page["status"], "preparing");
+        assert!(pages < 10);
+    }
+    assert!(pages >= 3);
+    assert_eq!(rows_scanned, 6);
+    assert_eq!(assert_matches_sql_oracle(&adapter).await.0, 5);
+
+    let (_partial_directory, partial) = fresh();
+    partial
+        .mutate(4096, |connection| {
+            for key in ["a", "b"] {
+                database::write(
+                    connection,
+                    protocol::GRAPH_RECORD_SCOPES[0],
+                    key,
+                    Some(&json!({"key":key})),
+                )?;
+            }
+            Ok(())
+        })
+        .await
+        .unwrap();
+    assert_eq!(prepare(&partial, 1).await.unwrap()["status"], "preparing");
+    partial
+        .mutate(4096, |connection| {
+            database::write(
+                connection,
+                protocol::GRAPH_RECORD_SCOPES[0],
+                "c",
+                Some(&json!({"key":"c"})),
+            )?;
+            Ok(())
+        })
+        .await
+        .unwrap();
+    let stale = read(&partial).await.unwrap();
+    assert_eq!(stale["status"], "stale");
+    assert_eq!(stale["reason"], "metadata_stale");
+}
