+pub(super) fn initialize(c:&Connection)->anyhow::Result<()> {
+    let declaration="{\"version\":1,\"same_reserved_attempt\":true,\"admissions_per_hour\":4,\"cooldown_ms\":60000,\"deadline_ms\":120000}";
+    c.execute("INSERT OR IGNORE INTO engine_graph_auto_adoption_policy VALUES(1,1,?1)",[declaration])?;
