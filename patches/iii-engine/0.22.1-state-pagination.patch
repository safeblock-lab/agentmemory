+use rusqlite::{Connection, OptionalExtension, params};
+use serde_json::Value;
+use std::collections::{BTreeSet, HashSet};
+
+mod membership;
+
+const MAX_INCREMENTAL_GRAPH_INDEX_CHANGES: usize = 128;
+
+struct NodeIndex {
+    name: String,
+    prefix: String,
+    members: HashSet<String>,
+}
+
+struct EdgeIndex {
+    source: String,
+    target: String,
+}
+
+fn node_index(value: &Value, key: &str) -> anyhow::Result<Option<NodeIndex>> {
+    if !super::indexable(value, key)? {
+        return Ok(None);
+    }
+    let name = value["name"]
+        .as_str()
+        .ok_or_else(|| super::super::super::protocol::error("STATE_TX_INVALID_REQUEST"))?;
+    if name.len() > 16 * 1024 {
+        return Err(super::super::request::resource());
+    }
+    let mut members = HashSet::new();
+    let mut bytes = 0usize;
+    for member in value["sourceObservationIds"]
+        .as_array()
+        .ok_or_else(|| super::super::super::protocol::error("STATE_TX_INVALID_REQUEST"))?
+    {
+        let member = member
+            .as_str()
+            .ok_or_else(|| super::super::super::protocol::error("STATE_TX_INVALID_REQUEST"))?;
+        super::request::identifier(member)?;
+        bytes = bytes.saturating_add(member.len());
+        if bytes > 2 * 1024 * 1024 {
+            return Err(super::super::request::resource());
+        }
+        members.insert(member.to_owned());
+    }
+    let name = name.to_lowercase();
+    let prefix = name.chars().take(3).collect();
+    Ok(Some(NodeIndex {
+        name,
+        prefix,
+        members,
+    }))
+}
+
+fn edge_index(value: &Value, key: &str) -> anyhow::Result<Option<EdgeIndex>> {
+    if !super::indexable(value, key)? {
+        return Ok(None);
+    }
+    let source = value["sourceNodeId"]
+        .as_str()
+        .ok_or_else(|| super::super::super::protocol::error("STATE_TX_INVALID_REQUEST"))?;
+    let target = value["targetNodeId"]
+        .as_str()
+        .ok_or_else(|| super::super::super::protocol::error("STATE_TX_INVALID_REQUEST"))?;
+    super::request::identifier(source)?;
+    super::request::identifier(target)?;
+    Ok(Some(EdgeIndex {
+        source: source.to_owned(),
+        target: target.to_owned(),
+    }))
+}
+
+fn all_grams(name: &str) -> BTreeSet<String> {
+    (1..=3).flat_map(|width| super::grams(name, width)).collect()
+}
+
+fn replace_node(
+    connection: &Connection,
+    key: &str,
+    previous: Option<&Value>,
+    previous_position: Option<i64>,
+    value: Option<&Value>,
+    position: Option<i64>,
+    epoch: i64,
+) -> anyhow::Result<()> {
+    let (Some(previous), Some(previous_position), Some(value), Some(position)) =
+        (previous, previous_position, value, position)
+    else {
+        return super::replace(connection, super::NODES, key, value, position, epoch);
+    };
+    let previous = match node_index(previous, key) {
+        Ok(Some(previous)) => previous,
+        Ok(None) | Err(_) => {
+            // The existing writer can replace legacy rows that do not satisfy today's index schema.
+            return super::replace(connection, super::NODES, key, Some(value), Some(position), epoch);
+        }
+    };
+    let Some(next) = node_index(value, key)? else {
+        return super::replace(connection, super::NODES, key, Some(value), Some(position), epoch);
+    };
+
+    let indexed: Option<(String, String, String, i64)> = connection
+        .query_row(
+            "SELECT id,name,prefix,position FROM retrieval_nodes WHERE epoch=?1 AND key=?2",
+            params![epoch, key],
+            |row| Ok((row.get(0)?, row.get(1)?, row.get(2)?, row.get(3)?)),
+        )
+        .optional()?;
+    if !indexed.as_ref().is_some_and(|(id, name, prefix, indexed_position)| {
+        id == key
+            && name == &previous.name
+            && prefix == &previous.prefix
+            && *indexed_position == previous_position
+    }) {
+        return super::replace(connection, super::NODES, key, Some(value), Some(position), epoch);
+    }
+
+    let previous_grams = all_grams(&previous.name);
+    let next_grams = all_grams(&next.name);
+    let changed_rows = previous_grams
+        .symmetric_difference(&next_grams)
+        .count()
+        .saturating_add(previous.members.symmetric_difference(&next.members).count());
+    if changed_rows > MAX_INCREMENTAL_GRAPH_INDEX_CHANGES {
+        return super::replace(connection, super::NODES, key, Some(value), Some(position), epoch);
+    }
+    if !membership::apply_delta(connection, epoch, key, &previous.members, &next.members, position)? {
+        return super::replace(connection, super::NODES, key, Some(value), Some(position), epoch);
+    }
+    let mut delete_gram = connection.prepare_cached(
+        "DELETE FROM retrieval_name_grams WHERE epoch=?1 AND gram=?2 AND key=?3",
+    )?;
+    for gram in previous_grams.difference(&next_grams) {
+        delete_gram.execute(params![epoch, gram, key])?;
+    }
+    let mut insert_gram = connection.prepare_cached(
+        "INSERT OR IGNORE INTO retrieval_name_grams(epoch,gram,key,position) VALUES(?1,?2,?3,?4)",
+    )?;
+    for gram in next_grams.difference(&previous_grams) {
+        insert_gram.execute(params![epoch, gram, key, position])?;
+    }
+    if previous_position != position && !next_grams.is_empty() {
+        connection.execute(
+            "UPDATE retrieval_name_grams SET position=?3 WHERE epoch=?1 AND key=?2 AND position<>?3",
+            params![epoch, key, position],
+        )?;
+    }
+    if previous.name != next.name || previous.prefix != next.prefix || previous_position != position {
+        connection.execute(
+            "UPDATE retrieval_nodes SET name=?3,prefix=?4,position=?5 WHERE epoch=?1 AND key=?2",
+            params![epoch, key, next.name, next.prefix, position],
+        )?;
+    }
+    let compact = super::super::graph_browse::compact::node(value);
+    connection.execute("UPDATE retrieval_nodes SET display_name=?3,display_type=?4 WHERE epoch=?1 AND key=?2",params![epoch,key,compact.as_ref().map(|v|&v.0),compact.as_ref().map(|v|&v.1)])?;
+    if previous_position != position && !next.members.is_empty() {
+        let key_id = super::identifier_id(connection, epoch, key)?
+            .ok_or_else(|| super::super::super::protocol::error("STATE_TX_FAILED"))?;
+        connection.execute(
+            "UPDATE retrieval_membership SET position=?3 WHERE epoch=?1 AND key=?2 AND position<>?3",
+            params![epoch, key_id, position],
+        )?;
+    }
+    Ok(())
+}
+
+fn replace_edge(
+    connection: &Connection,
+    key: &str,
+    previous: Option<&Value>,
+    previous_position: Option<i64>,
+    value: Option<&Value>,
+    position: Option<i64>,
+    epoch: i64,
+) -> anyhow::Result<()> {
+    let (Some(previous), Some(previous_position), Some(value), Some(position)) =
+        (previous, previous_position, value, position)
+    else {
+        return super::replace(connection, super::EDGES, key, value, position, epoch);
+    };
+    let previous = match edge_index(previous, key) {
+        Ok(Some(previous)) => previous,
+        Ok(None) | Err(_) => {
+            return super::replace(connection, super::EDGES, key, Some(value), Some(position), epoch);
+        }
+    };
+    let Some(next) = edge_index(value, key)? else {
+        return super::replace(connection, super::EDGES, key, Some(value), Some(position), epoch);
+    };
+    let indexed: Option<(String, String, String, i64)> = connection
+        .query_row(
+            "SELECT key,source,target,position FROM retrieval_edges WHERE epoch=?1 AND key=?2",
+            params![epoch, key],
+            |row| Ok((row.get(0)?, row.get(1)?, row.get(2)?, row.get(3)?)),
+        )
+        .optional()?;
+    if !indexed.as_ref().is_some_and(|(id, source, target, indexed_position)| {
+        id == key
+            && source == &previous.source
+            && target == &previous.target
+            && *indexed_position == previous_position
+    }) {
+        return super::replace(connection, super::EDGES, key, Some(value), Some(position), epoch);
+    }
+    if previous.source != next.source || previous.target != next.target || previous_position != position {
+        connection.execute(
+            "UPDATE retrieval_edges SET source=?3,target=?4,position=?5 WHERE epoch=?1 AND key=?2",
+            params![epoch, key, next.source, next.target, position],
+        )?;
+    }
+    let compact = super::super::graph_browse::compact::edge(value);
+    connection.execute("UPDATE retrieval_edges SET display_type=?3,display_weight=?4 WHERE epoch=?1 AND key=?2",params![epoch,key,compact.as_ref().map(|v|&v.0),compact.as_ref().map(|v|v.1)])?;
+    Ok(())
+}
+
+pub(super) fn replace(
+    connection: &Connection,
+    scope: &str,
+    key: &str,
+    previous: Option<&Value>,
+    previous_position: Option<i64>,
+    value: Option<&Value>,
+    position: Option<i64>,
+    epoch: i64,
+) -> anyhow::Result<()> {
+    if previous.is_some() && previous == value && previous_position == position {
+        return Ok(());
+    }
+    match scope {
+        super::NODES => replace_node(connection, key, previous, previous_position, value, position, epoch),
+        super::EDGES => replace_edge(connection, key, previous, previous_position, value, position, epoch),
+        _ => super::replace(connection, scope, key, value, position, epoch),
+    }
+}
