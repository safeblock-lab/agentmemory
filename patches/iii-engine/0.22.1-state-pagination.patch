+++ b/engine/src/workers/state/adapters/sqlite/compact/collector/sets.rs
@@ -0,0 +1,33 @@
+mod parents;
+pub(super) use parents::{roots,blobs};
+use super::Budget;
+use super::concurrent;
+use rusqlite::{Connection,params};
+
+fn pairs(c:&Connection,sql:&str,limit:usize)->anyhow::Result<Vec<[i64;2]>> {Ok(c.prepare_cached(sql)?.query_map([i64::try_from(limit)?],|r|Ok([r.get(0)?,r.get(1)?]))?.collect::<rusqlite::Result<_>>()?)}
+pub fn graph(c:&Connection,b:&mut Budget)->anyhow::Result<bool> {
+    let rows=if b.queued {concurrent::pairs(c,0,b.chunk())?} else {pairs(c,"SELECT epoch,key FROM compact_graph_lists WHERE (epoch,key)>(SELECT graph_epoch,graph_key FROM compact_gc_cursor WHERE singleton=1) AND (epoch,key)<=(SELECT graph_epoch,graph_key FROM compact_gc_seed WHERE singleton=1) ORDER BY epoch,key LIMIT ?1",b.chunk())?};
+    if rows.is_empty(){return Ok(true);}
+    b.deleted+=c.prepare_cached("DELETE FROM compact_graph_lists AS g WHERE (epoch,key) IN(SELECT json_extract(value,'$[0]'),json_extract(value,'$[1]') FROM json_each(?1)) AND NOT EXISTS(SELECT 1 FROM retrieval_identifiers i JOIN retrieval_nodes n ON n.epoch=i.epoch AND n.key=i.value WHERE i.epoch=g.epoch AND i.id=g.key)")?.execute([serde_json::to_string(&rows)?])?;
+    if b.queued {concurrent::acknowledge_pairs(c,0,&rows)?;} else {let last=rows.last().unwrap();c.execute("UPDATE compact_gc_cursor SET graph_epoch=?1,graph_key=?2 WHERE singleton=1",params![last[0],last[1]])?;}b.inspected+=rows.len();Ok(false)
+}
+pub fn maps(c:&Connection,b:&mut Budget)->anyhow::Result<bool> {
+    let rows=if b.queued {concurrent::pairs(c,1,b.chunk())?} else {pairs(c,"SELECT epoch,identifier FROM compact_graph_identifiers WHERE (epoch,identifier)>(SELECT map_epoch,map_identifier FROM compact_gc_cursor WHERE singleton=1) AND (epoch,identifier)<=(SELECT map_epoch,map_identifier FROM compact_gc_seed WHERE singleton=1) ORDER BY epoch,identifier LIMIT ?1",b.chunk())?};
+    if rows.is_empty(){return Ok(true);}
+    b.deleted+=c.prepare_cached("DELETE FROM compact_graph_identifiers AS i WHERE (epoch,identifier) IN(SELECT json_extract(value,'$[0]'),json_extract(value,'$[1]') FROM json_each(?1)) AND NOT EXISTS(SELECT 1 FROM compact_inverse_members m CROSS JOIN compact_graph_lists g ON g.list=m.list_id WHERE m.identifier=i.identifier AND g.epoch=i.epoch)")?.execute([serde_json::to_string(&rows)?])?;
+    if b.queued {concurrent::acknowledge_pairs(c,1,&rows)?;} else {let last=rows.last().unwrap();c.execute("UPDATE compact_gc_cursor SET map_epoch=?1,map_identifier=?2 WHERE singleton=1",params![last[0],last[1]])?;}b.inspected+=rows.len();Ok(false)
+}
+pub fn inline(c:&Connection,b:&mut Budget)->anyhow::Result<bool> {
+    let sql=if b.queued {"SELECT scope,key,version,length(value) FROM compact_rollback ORDER BY scope,key,version LIMIT ?1"} else {"SELECT scope,key,version,length(value) FROM compact_rollback WHERE (scope,key,version)<=(SELECT inline_scope,inline_key,inline_version FROM compact_gc_seed WHERE singleton=1) ORDER BY scope,key,version LIMIT ?1"};
+    let rows=c.prepare_cached(sql)?.query_map([i64::try_from(b.chunk())?],|r|Ok(([r.get::<_,String>(0)?,r.get::<_,String>(1)?,r.get::<_,String>(2)?],r.get::<_,i64>(3)?)))?.collect::<rusqlite::Result<Vec<_>>>()?;
+    if rows.is_empty(){return Ok(true);}
+    let mut selected=Vec::new();let mut bytes=0usize;
+    for (key,size) in rows {let size=usize::try_from(size)?;if b.bytes+bytes+size>b.max_bytes {anyhow::ensure!(b.bytes>0 || bytes>0,"STATE_TX_LIMIT_EXCEEDED");break;}bytes+=size;selected.push(key);}
+    if selected.is_empty(){b.yielded=true;return Ok(false);}
+    let raw=serde_json::to_string(&selected)?;
+    let values=c.prepare_cached("SELECT value FROM compact_rollback WHERE (scope,key,version) IN(SELECT json_extract(value,'$[0]'),json_extract(value,'$[1]'),json_extract(value,'$[2]') FROM json_each(?1))")?.query_map([&raw],|r|r.get::<_,Vec<u8>>(0))?.collect::<rusqlite::Result<Vec<_>>>()?;
+    anyhow::ensure!(values.iter().map(Vec::len).sum::<usize>()==bytes,"STATE_COMPACT_CORRUPT");
+    let deleted=c.prepare_cached("DELETE FROM compact_rollback WHERE (scope,key,version) IN(SELECT json_extract(value,'$[0]'),json_extract(value,'$[1]'),json_extract(value,'$[2]') FROM json_each(?1))")?.execute([raw])?;
+    anyhow::ensure!(deleted==selected.len(),"STATE_COMPACT_CORRUPT");let last=selected.last().unwrap();c.execute("UPDATE compact_gc_progress SET inline_scope=?1,inline_key=?2,inline_version=?3 WHERE singleton=1",params![last[0],last[1],last[2]])?;
+    b.inspected+=selected.len();b.deleted+=deleted;b.bytes+=bytes;Ok(false)
+}
diff --git a/engine/src/workers/state/adapters/sqlite/compact/collector/sets/parents.rs b/engine/src/workers/state/adapters/sqlite/compact/collector/sets/parents.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/compact/collector/sets/parents.rs
@@ -0,0 +1,39 @@
+use super::super::Budget;
+use super::super::concurrent;
+use rusqlite::{Connection,params};
+fn advance(c:&Connection,column:&str,selected:&[i64],blocked:&[i64])->anyhow::Result<()> {
+    let edge=blocked.iter().min().copied();if let Some(last)=selected.iter().copied().filter(|id|edge.is_none_or(|edge|*id<edge)).max(){c.execute(&format!("UPDATE compact_gc_cursor SET {column}=?1 WHERE singleton=1"),[last])?;}Ok(())
+}
+pub fn roots(c:&Connection,b:&mut Budget)->anyhow::Result<bool> {
+    let rows=if b.queued {concurrent::ids(c,2,b.chunk())?} else {c.prepare_cached("SELECT id FROM compact_roots WHERE id>(SELECT root FROM compact_gc_cursor WHERE singleton=1) AND id<=(SELECT root FROM compact_gc_seed WHERE singleton=1) ORDER BY id LIMIT ?1")?.query_map([i64::try_from(b.chunk())?],|r|r.get::<_,i64>(0))?.collect::<rusqlite::Result<Vec<_>>>()?};
+    if rows.is_empty(){return Ok(true);}
+    let raw=serde_json::to_string(&rows)?;
+    let dead=c.prepare_cached("SELECT r.id FROM json_each(?1) j CROSS JOIN compact_root_values r ON r.id=CAST(j.value AS INTEGER) WHERE NOT EXISTS(SELECT 1 FROM state_rows s WHERE s.scope=(SELECT scope FROM compact_root_values WHERE id=r.id) AND s.key=(SELECT key FROM compact_root_values WHERE id=r.id) AND s.version=(SELECT version FROM compact_root_values WHERE id=r.id) AND state_compact_root(s.value)=r.id)")?.query_map([raw],|r|r.get::<_,i64>(0))?.collect::<rusqlite::Result<Vec<_>>>()?;
+    let dead_raw=serde_json::to_string(&dead)?;
+    let children=c.prepare_cached("SELECT root,ordinal FROM compact_segments WHERE root IN(SELECT CAST(value AS INTEGER) FROM json_each(?1)) ORDER BY root,ordinal LIMIT ?2")?.query_map(params![dead_raw,i64::try_from(b.deletes())?],|r|Ok([r.get::<_,i64>(0)?,r.get::<_,i64>(1)?]))?.collect::<rusqlite::Result<Vec<_>>>()?;
+    b.deleted+=c.prepare_cached("DELETE FROM compact_segments WHERE (root,ordinal) IN(SELECT json_extract(value,'$[0]'),json_extract(value,'$[1]') FROM json_each(?1))")?.execute([serde_json::to_string(&children)?])?;
+    let retired=c.prepare_cached("DELETE FROM compact_roots AS r WHERE id IN(SELECT CAST(value AS INTEGER) FROM json_each(?1)) AND NOT EXISTS(SELECT 1 FROM compact_segments WHERE root=r.id) AND NOT EXISTS(SELECT 1 FROM state_rows s WHERE s.scope=(SELECT scope FROM compact_root_values WHERE id=r.id) AND s.key=(SELECT key FROM compact_root_values WHERE id=r.id) AND s.version=(SELECT version FROM compact_root_values WHERE id=r.id) AND state_compact_root(s.value)=r.id) AND id IN(SELECT CAST(value AS INTEGER) FROM json_each(?1) LIMIT ?2) RETURNING id")?.query_map(params![dead_raw,i64::try_from(b.deletes())?],|r|r.get::<_,i64>(0))?.collect::<rusqlite::Result<Vec<_>>>()?;
+    b.deleted+=retired.len();let blocked=dead.into_iter().filter(|id|!retired.contains(id)).collect::<Vec<_>>();if b.queued {concurrent::acknowledge_ids(c,2,&rows,&blocked)?;} else {advance(c,"root",&rows,&blocked)?;}b.inspected+=rows.len();Ok(false)
+}
+pub fn blobs(c:&Connection,b:&mut Budget)->anyhow::Result<bool> {
+    let rows=if b.queued {concurrent::ids(c,3,b.chunk())?} else {c.prepare_cached("SELECT id FROM compact_blobs WHERE id>(SELECT blob FROM compact_gc_cursor WHERE singleton=1) AND id<=(SELECT blob FROM compact_gc_seed WHERE singleton=1) ORDER BY id LIMIT ?1")?.query_map([i64::try_from(b.chunk())?],|r|r.get::<_,i64>(0))?.collect::<rusqlite::Result<Vec<_>>>()?};
+    if rows.is_empty(){return Ok(true);}
+    let raw=serde_json::to_string(&rows)?;
+    let dead=c.prepare_cached("SELECT b.id,length(b.payload) FROM json_each(?1) j CROSS JOIN compact_blobs b ON b.id=CAST(j.value AS INTEGER) WHERE NOT EXISTS(SELECT 1 FROM compact_text_locators WHERE blob=b.id) AND NOT EXISTS(SELECT 1 FROM compact_segments WHERE blob=b.id) AND NOT EXISTS(SELECT 1 FROM compact_vector_refs WHERE blob=b.id) AND NOT EXISTS(SELECT 1 FROM compact_graph_lists WHERE list=b.id) ORDER BY b.id")?.query_map([raw],|r|Ok((r.get::<_,i64>(0)?,r.get::<_,i64>(1)?)))?.collect::<rusqlite::Result<Vec<_>>>()?;
+    let mut chosen=Vec::new();let mut bytes=0usize;for(id,size)in &dead{let size=usize::try_from(*size)?;if b.bytes+bytes+size>b.max_bytes{anyhow::ensure!(b.bytes>0||bytes>0,"STATE_TX_LIMIT_EXCEEDED");break;}chosen.push(*id);bytes+=size;}
+    if chosen.len()<dead.len(){b.yielded=true;}
+    let raw=serde_json::to_string(&chosen)?;
+    let payloads=c.prepare_cached("SELECT id,payload FROM compact_blobs WHERE id IN(SELECT CAST(value AS INTEGER) FROM json_each(?1))")?.query_map([&raw],|r|Ok((r.get::<_,i64>(0)?,r.get::<_,Vec<u8>>(1)?)))?.collect::<rusqlite::Result<Vec<_>>>()?;
+    anyhow::ensure!(payloads.iter().map(|(_,v)|v.len()).sum::<usize>()==bytes,"STATE_COMPACT_CORRUPT");
+    let forward:bool=c.query_row("SELECT writing=1 FROM compact_forward_config WHERE singleton=1",[],|r|r.get(0))?;
+    let factor=if forward {3} else {1};
+    let member_limit=if forward {(b.deletes()/factor).min(b.max_bytes.saturating_sub(b.bytes).saturating_sub(bytes)/8192)} else {b.deletes()};
+    if forward && member_limit==0 {b.yielded=true;}
+    let children=c.prepare_cached("SELECT list_id,identifier FROM compact_list_members WHERE list_id IN(SELECT CAST(value AS INTEGER) FROM json_each(?1)) ORDER BY list_id,identifier LIMIT ?2")?.query_map(params![raw,i64::try_from(member_limit)?],|r|Ok([r.get::<_,i64>(0)?,r.get::<_,i64>(1)?]))?.collect::<rusqlite::Result<Vec<_>>>()?;
+    let removed=c.prepare_cached("DELETE FROM compact_list_members WHERE (list_id,identifier) IN(SELECT json_extract(value,'$[0]'),json_extract(value,'$[1]') FROM json_each(?1))")?.execute([serde_json::to_string(&children)?])?;
+    for child in &children {concurrent::member_retired(c,child[1])?;}
+    b.deleted+=if forward {children.len()*factor} else {removed};
+    if forward {b.bytes+=bytes+children.len()*8192;}
+    let retired=c.prepare_cached("DELETE FROM compact_blobs AS b WHERE id IN(SELECT CAST(value AS INTEGER) FROM json_each(?1)) AND NOT EXISTS(SELECT 1 FROM compact_text_locators WHERE blob=b.id) AND NOT EXISTS(SELECT 1 FROM compact_list_members WHERE list_id=b.id) AND NOT EXISTS(SELECT 1 FROM compact_segments WHERE blob=b.id) AND NOT EXISTS(SELECT 1 FROM compact_vector_refs WHERE blob=b.id) AND NOT EXISTS(SELECT 1 FROM compact_graph_lists WHERE list=b.id) AND id IN(SELECT CAST(value AS INTEGER) FROM json_each(?1) LIMIT ?2) RETURNING id")?.query_map(params![raw,i64::try_from(b.deletes())?],|r|r.get::<_,i64>(0))?.collect::<rusqlite::Result<Vec<_>>>()?;
+    b.deleted+=retired.len();if !forward {b.bytes+=payloads.iter().filter(|(id,_)|retired.contains(id)).map(|(_,v)|v.len()).sum::<usize>();}let blocked=dead.iter().map(|(id,_)|*id).filter(|id|!retired.contains(id)).collect::<Vec<_>>();if b.queued {concurrent::acknowledge_ids(c,3,&rows,&blocked)?;} else {advance(c,"blob",&rows,&blocked)?;}b.inspected+=rows.len();Ok(false)
+}
diff --git a/engine/src/workers/state/adapters/sqlite/compact/copy_progress.rs b/engine/src/workers/state/adapters/sqlite/compact/copy_progress.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/compact/copy_progress.rs
@@ -0,0 +1,136 @@
+use rusqlite::{params, Connection, OptionalExtension};
+use serde_json::{json, Value};
+
+pub(super) const METADATA_CHUNK_LIMIT: usize = 128;
+
+pub(super) struct Row {
+    pub scope: String,
+    pub key: String,
+    pub version: String,
+    pub logical: i64,
+    pub stored: Option<i64>,
+    pub ticket: Option<(i64, String)>,
+}
+
+pub(super) fn schema(c: &Connection) -> anyhow::Result<()> {
+    c.execute_batch("CREATE TABLE IF NOT EXISTS compact_copy_pass(singleton INTEGER PRIMARY KEY CHECK(singleton=1),initialized INTEGER NOT NULL,seed_complete INTEGER NOT NULL);
+        INSERT OR IGNORE INTO compact_copy_pass VALUES(1,0,0);
+        CREATE TABLE IF NOT EXISTS compact_copy_bounds(scope TEXT PRIMARY KEY,upper_position INTEGER NOT NULL CHECK(upper_position>=-1)) WITHOUT ROWID;
+        CREATE TABLE IF NOT EXISTS compact_copy_dirty(ticket INTEGER PRIMARY KEY AUTOINCREMENT,scope TEXT NOT NULL,key TEXT NOT NULL,version TEXT NOT NULL,UNIQUE(scope,key));")?;
+    Ok(())
+}
+
+fn snapshot(c: &Connection, complete: bool) -> anyhow::Result<()> {
+    anyhow::ensure!(!c.is_autocommit(), "STATE_TX_INVALID_REQUEST");
+    let scopes = c.prepare("SELECT scope,next_position FROM state_scopes ORDER BY scope")?
+        .query_map([], |r| Ok((r.get::<_, String>(0)?, r.get::<_, i64>(1)?)))?
+        .collect::<rusqlite::Result<Vec<_>>>()?;
+    c.execute("DELETE FROM compact_copy_bounds", [])?;
+    for (scope, next) in scopes {
+        anyhow::ensure!(next >= 0, "STATE_COMPACT_CORRUPT");
+        let invalid: bool = c.query_row("SELECT EXISTS(SELECT 1 FROM state_rows INDEXED BY state_rows_order WHERE scope=?1 AND value IS NOT NULL AND position IS NULL)
+            OR EXISTS(SELECT 1 FROM state_rows INDEXED BY state_rows_order WHERE scope=?1 AND value IS NOT NULL AND position<0)
+            OR EXISTS(SELECT 1 FROM state_rows INDEXED BY state_rows_order WHERE scope=?1 AND value IS NOT NULL AND position>=?2)", params![scope,next], |r| r.get(0))?;
+        anyhow::ensure!(!invalid, "STATE_COMPACT_CORRUPT");
+        c.execute("INSERT INTO compact_copy_bounds VALUES(?1,?2)", params![scope,next.checked_sub(1).ok_or_else(|| super::super::protocol::error("STATE_COMPACT_CORRUPT"))?])?;
+    }
+    let mut after: Option<String> = None;
+    loop {
+        let scope: Option<String> = match &after {
+            Some(after) => c.query_row("SELECT scope FROM state_rows WHERE scope>?1 ORDER BY scope LIMIT 1", [after], |r| r.get(0)).optional()?,
+            None => c.query_row("SELECT scope FROM state_rows ORDER BY scope LIMIT 1", [], |r| r.get(0)).optional()?,
+        };
+        let Some(scope) = scope else { break; };
+        let registered: bool = c.query_row("SELECT EXISTS(SELECT 1 FROM compact_copy_bounds WHERE scope=?1)", [&scope], |r| r.get(0))?;
+        anyhow::ensure!(registered, "STATE_COMPACT_CORRUPT");
+        after = Some(scope);
+    }
+    c.execute("UPDATE compact_copy_pass SET initialized=1,seed_complete=?1 WHERE singleton=1", [complete])?;
+    Ok(())
+}
+
+pub(super) fn activate(c: &Connection) -> anyhow::Result<()> {
+    snapshot(c, false)?;
+    c.execute("DELETE FROM compact_copy_dirty", [])?;
+    Ok(())
+}
+
+pub(super) fn rollback(c: &Connection) -> anyhow::Result<()> {
+    c.execute("UPDATE compact_copy_pass SET initialized=0,seed_complete=0 WHERE singleton=1", [])?;
+    Ok(())
+}
+
+pub(super) fn ensure(c: &Connection) -> anyhow::Result<()> {
+    let initialized: bool = c.query_row("SELECT initialized FROM compact_copy_pass WHERE singleton=1", [], |r| r.get(0))?;
+    if !initialized {
+        let complete: bool = c.query_row("SELECT complete FROM compact_config WHERE singleton=1", [], |r| r.get(0))?;
+        snapshot(c, complete)?;
+    }
+    Ok(())
+}
+
+pub(super) fn batch(c: &Connection, limit: usize) -> anyhow::Result<(Vec<Row>, bool)> {
+    anyhow::ensure!((1..=METADATA_CHUNK_LIMIT).contains(&limit), "STATE_TX_LIMIT_EXCEEDED");
+    ensure(c)?;
+    let complete: bool = c.query_row("SELECT seed_complete FROM compact_copy_pass WHERE singleton=1", [], |r| r.get(0))?;
+    let limit = i64::try_from(limit.checked_add(1).ok_or_else(|| super::super::protocol::error("STATE_TX_LIMIT_EXCEEDED"))?)?;
+    if complete {
+        let rows = c.prepare("SELECT q.scope,q.key,coalesce(r.version,q.version),coalesce(r.value_bytes,0),length(r.value),q.ticket,q.version,r.position,s.next_position
+            FROM compact_copy_dirty q LEFT JOIN state_rows r ON r.scope=q.scope AND r.key=q.key LEFT JOIN state_scopes s ON s.scope=r.scope ORDER BY q.ticket LIMIT ?1")?
+            .query_map([limit], |r| {
+                let stored: Option<i64> = r.get(4)?;
+                let position: Option<i64> = r.get(7)?;
+                let next: Option<i64> = r.get(8)?;
+                if stored.is_some() && !matches!((position,next), (Some(position),Some(next)) if position>=0 && position<next) {return Err(rusqlite::Error::InvalidQuery);}
+                Ok(Row {scope:r.get(0)?,key:r.get(1)?,version:r.get(2)?,logical:r.get(3)?,stored,ticket:Some((r.get(5)?,r.get(6)?))})
+            })?
+            .collect::<rusqlite::Result<Vec<_>>>()?;
+        return Ok((rows, true));
+    }
+    let (scope,key,started):(String,String,bool)=c.query_row("SELECT last_scope,last_key,started FROM compact_config WHERE singleton=1", [], |r| Ok((r.get(0)?,r.get(1)?,r.get(2)?)))?;
+    let query = if started {
+        "SELECT r.scope,r.key,r.version,r.value_bytes,length(r.value),r.position
+        FROM state_rows r JOIN compact_copy_bounds b ON b.scope=r.scope
+        WHERE r.value IS NOT NULL AND (r.position IS NULL OR r.position<=b.upper_position) AND (r.scope,r.key)>(?1,?2)
+        ORDER BY r.scope,r.key LIMIT ?3"
+    } else {
+        "SELECT r.scope,r.key,r.version,r.value_bytes,length(r.value),r.position
+        FROM state_rows r JOIN compact_copy_bounds b ON b.scope=r.scope
+        WHERE r.value IS NOT NULL AND (r.position IS NULL OR r.position<=b.upper_position)
+        ORDER BY r.scope,r.key LIMIT ?1"
+    };
+    let map_row = |r: &rusqlite::Row<'_>| {
+        let position: Option<i64> = r.get(5)?;
+        if !matches!(position, Some(value) if value>=0) {return Err(rusqlite::Error::InvalidQuery);}
+        Ok(Row {scope:r.get(0)?,key:r.get(1)?,version:r.get(2)?,logical:r.get(3)?,stored:r.get(4)?,ticket:None})
+    };
+    let mut statement = c.prepare(query)?;
+    let rows = if started {
+        statement.query_map(params![scope,key,limit], map_row)?.collect::<rusqlite::Result<Vec<_>>>()?
+    } else {
+        statement.query_map(params![limit], map_row)?.collect::<rusqlite::Result<Vec<_>>>()?
+    };
+    Ok((rows, false))
+}
+
+pub(super) fn acknowledge(c: &Connection, row: &Row) -> anyhow::Result<()> {
+    if let Some((ticket,version)) = &row.ticket {
+        c.execute("DELETE FROM compact_copy_dirty WHERE ticket=?1 AND version=?2", params![ticket,version])?;
+    } else {
+        c.execute("UPDATE compact_config SET last_scope=?1,last_key=?2,started=1 WHERE singleton=1", params![row.scope,row.key])?;
+    }
+    Ok(())
+}
+
+pub(super) fn finish_batch(c: &Connection, queued: bool, exhausted: bool) -> anyhow::Result<()> {
+    if !queued && exhausted {
+        c.execute("UPDATE compact_copy_pass SET seed_complete=1 WHERE singleton=1", [])?;
+    }
+    c.execute("UPDATE compact_config SET complete=(SELECT seed_complete FROM compact_copy_pass WHERE singleton=1) AND NOT EXISTS(SELECT 1 FROM compact_copy_dirty) WHERE singleton=1", [])?;
+    Ok(())
+}
+
+pub(super) fn progress(c: &Connection) -> anyhow::Result<Value> {
+    c.query_row("SELECT initialized,seed_complete,EXISTS(SELECT 1 FROM compact_copy_dirty) FROM compact_copy_pass WHERE singleton=1", [], |r|
+        Ok(json!({"mode":"finite_scope_positions_and_inline_queue","initialized":r.get::<_,bool>(0)?,"seed_complete":r.get::<_,bool>(1)?,"dirty_pending":r.get::<_,bool>(2)?}))).map_err(Into::into)
+}
diff --git a/engine/src/workers/state/adapters/sqlite/compact/layout.rs b/engine/src/workers/state/adapters/sqlite/compact/layout.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/compact/layout.rs
@@ -0,0 +1,138 @@
+use base64::{Engine, engine::general_purpose::STANDARD};
+use rusqlite::Connection;
+
+pub(super) struct Piece {
+    pub kind: i64,
+    pub bytes: Vec<u8>,
+    pub logical: usize,
+    pub canonical_list: Option<String>,
+}
+
+pub(super) fn unpack(bytes: &[u8]) -> anyhow::Result<Vec<i64>> {
+    anyhow::ensure!(bytes.len() >= 6 && bytes[0] == 1,"STATE_COMPACT_CORRUPT");
+    let width = usize::from(bytes[1]);
+    anyhow::ensure!(width == 3 || width == 8,"STATE_COMPACT_CORRUPT");
+    let count = u32::from_le_bytes(bytes[2..6].try_into()?) as usize;
+    anyhow::ensure!(count.checked_mul(width).and_then(|n|n.checked_add(6)) == Some(bytes.len()),"STATE_COMPACT_CORRUPT");
+    let mut ids = Vec::with_capacity(count);
+    for chunk in bytes[6..].chunks_exact(width) {
+        let mut number = [0;8];
+        number[..width].copy_from_slice(chunk);
+        let id = i64::from_le_bytes(number);
+        anyhow::ensure!(id > 0,"STATE_COMPACT_CORRUPT");
+        ids.push(id);
+    }
+    Ok(ids)
+}
+
+pub(super) fn list(c: &Connection, raw: &str) -> anyhow::Result<Option<Vec<u8>>> {
+    let values: Vec<String> = match serde_json::from_str(raw) { Ok(v)=>v,Err(_)=>return Ok(None) };
+    if serde_json::to_string(&values)? != raw { return Ok(None); }
+    let tokens=values.iter().map(serde_json::to_string).collect::<Result<Vec<_>,_>>()?;
+    let tokens=serde_json::to_string(&tokens)?;
+    c.prepare_cached("INSERT OR IGNORE INTO compact_identifiers(token) SELECT j.value FROM json_each(?1) j ORDER BY CAST(j.key AS INTEGER)")?.execute([&tokens])?;
+    let ids=c.prepare_cached("SELECT i.id FROM json_each(?1) j CROSS JOIN compact_identifiers i ON i.token=j.value ORDER BY CAST(j.key AS INTEGER)")?
+        .query_map([&tokens],|r|r.get::<_,i64>(0))?.collect::<rusqlite::Result<Vec<_>>>()?;
+    anyhow::ensure!(ids.len()==values.len(),"STATE_COMPACT_CORRUPT");
+    let width = if ids.iter().all(|id|*id > 0 && *id < 1<<24) {3usize} else {8};
+    if ids.len().saturating_mul(width).saturating_add(6) > super::LIMIT { return Ok(None); }
+    let mut bytes = vec![1,width as u8];
+    bytes.extend_from_slice(&u32::try_from(ids.len())?.to_le_bytes());
+    for id in ids { bytes.extend_from_slice(&id.to_le_bytes()[..width]); }
+    Ok(Some(bytes))
+}
+
+fn string_end(bytes: &[u8], mut at: usize) -> anyhow::Result<usize> {
+    anyhow::ensure!(bytes.get(at) == Some(&b'"'),"STATE_COMPACT_CORRUPT");
+    at += 1;
+    while at < bytes.len() {
+        match bytes[at] {
+            b'\\' => at += 2,
+            b'"' => return Ok(at+1),
+            _ => at += 1,
+        }
+    }
+    anyhow::bail!("STATE_COMPACT_CORRUPT")
+}
+
+fn whitespace(bytes: &[u8], at: &mut usize) {
+    while bytes.get(*at).is_some_and(u8::is_ascii_whitespace) { *at += 1; }
+}
+
+fn scan(text: &str, at: &mut usize, spans: &mut Vec<(usize,usize,bool)>, depth: usize) -> anyhow::Result<()> {
+    anyhow::ensure!(depth <= 128,"STATE_COMPACT_CORRUPT");
+    let bytes = text.as_bytes();
+    whitespace(bytes,at);
+    match bytes.get(*at) {
+        Some(b'"') => *at = string_end(bytes,*at)?,
+        Some(b'{') => {
+            *at += 1;
+            loop {
+                whitespace(bytes,at);
+                if bytes.get(*at) == Some(&b'}') { *at += 1; break; }
+                let start = *at;
+                *at = string_end(bytes,*at)?;
+                let key: String = serde_json::from_str(&text[start..*at])?;
+                whitespace(bytes,at);
+                anyhow::ensure!(bytes.get(*at) == Some(&b':'),"STATE_COMPACT_CORRUPT");
+                *at += 1;
+                whitespace(bytes,at);
+                let start = *at;
+                let selected = matches!(key.as_str(),"sourceObservations"|"sourceObservationIds"|"sourceActionIds"|"provenance") && bytes.get(start)==Some(&b'[');
+                let vector = key=="embedding" && bytes.get(start)==Some(&b'"');
+                let previous = spans.len();
+                scan(text,at,spans,depth+1)?;
+                if selected || vector {
+                    spans.truncate(previous);
+                    spans.push((start,*at,vector));
+                }
+                whitespace(bytes,at);
+                match bytes.get(*at) { Some(b',')=>*at+=1,Some(b'}')=>{*at+=1;break},_=>anyhow::bail!("STATE_COMPACT_CORRUPT") }
+            }
+        }
+        Some(b'[') => {
+            *at += 1;
+            loop {
+                whitespace(bytes,at);
+                if bytes.get(*at)==Some(&b']') { *at+=1;break; }
+                scan(text,at,spans,depth+1)?;
+                whitespace(bytes,at);
+                match bytes.get(*at) {Some(b',')=>*at+=1,Some(b']')=>{*at+=1;break},_=>anyhow::bail!("STATE_COMPACT_CORRUPT")}
+            }
+        }
+        Some(_) => {while bytes.get(*at).is_some_and(|b|!b.is_ascii_whitespace() && !b",]}".contains(b)) {*at+=1;}}
+        None => anyhow::bail!("STATE_COMPACT_CORRUPT"),
+    }
+    Ok(())
+}
+
+fn literal(text: &str) -> anyhow::Result<Piece> {
+    Ok(Piece{kind:0,bytes:super::super::codec::encode(text)?,logical:text.len(),canonical_list:None})
+}
+
+pub(super) fn pieces(c: &Connection, text: &str) -> anyhow::Result<Vec<Piece>> {
+    let _: serde_json::Value = serde_json::from_str(text)?;
+    let mut spans = Vec::new();
+    scan(text,&mut 0,&mut spans,0)?;
+    if spans.len() > 4096 { return Ok(vec![literal(text)?]); }
+    let mut pieces = Vec::new();
+    let mut previous = 0;
+    for (start,end,vector) in spans {
+        if previous < start {pieces.push(literal(&text[previous..start])?);}
+        let raw = &text[start..end];
+        let piece = if vector {
+            let encoded: String = serde_json::from_str(raw)?;
+            match STANDARD.decode(&encoded) {
+                Ok(bytes) if bytes.len()%4==0 && STANDARD.encode(&bytes)==encoded && serde_json::to_string(&encoded)?==raw => {let logical=bytes.len();Piece{kind:1,bytes,logical,canonical_list:None}},
+                _ => literal(raw)?,
+            }
+        } else {
+            match list(c,raw)? {Some(bytes)=>Piece{kind:2,bytes,logical:raw.len(),canonical_list:Some(raw.to_owned())},None=>literal(raw)?}
+        };
+        pieces.push(piece);
+        previous=end;
+    }
+    if previous < text.len() {pieces.push(literal(&text[previous..])?);}
+    if pieces.is_empty() {pieces.push(literal(text)?);}
+    Ok(pieces)
+}
diff --git a/engine/src/workers/state/adapters/sqlite/compact/maintenance.rs b/engine/src/workers/state/adapters/sqlite/compact/maintenance.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/compact/maintenance.rs
@@ -0,0 +1,240 @@
+use super::{root, marker, store_for_copy};
+use rusqlite::{Connection, OptionalExtension, params};
+use serde::{Deserialize, Serialize};
+use serde_json::{Value,json};
+use sha2::{Digest,Sha256};
+use std::time::{Duration,Instant};
+
+#[derive(Clone,Copy,Deserialize,Serialize)]
+#[serde(rename_all="snake_case")]
+pub enum Step { Activate, Copy, Cut, Rollback, Collect, Checkpoint, EnableIncremental, Rebuild }
+
+#[derive(Deserialize,Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct Request {
+    pub operation_id: String,
+    pub expected_generation: String,
+    pub step: Step,
+    pub limit: usize,
+    pub max_bytes: usize,
+    pub max_ms: u64,
+    pub lease_owner_id: String,
+    pub lease_fence: u64,
+}
+
+pub fn status(c: &Connection) -> anyhow::Result<Value> {
+    let vectors_complete:bool=c.query_row("SELECT complete FROM compact_vector_cursor WHERE singleton=1",[],|r|r.get(0))?;
+    let mut result: Value = c.query_row("SELECT generation,mode,phase,last_scope,last_key,complete FROM compact_config WHERE singleton=1",[],|r| {
+        Ok(json!({"format":3,"generation":r.get::<_,String>(0)?,"active":r.get::<_,bool>(1)?,"phase":r.get::<_,String>(2)?,"cursor":{"scope":r.get::<_,String>(3)?,"key":r.get::<_,String>(4)?},"rows_complete":r.get::<_,bool>(5)?,"vectors_complete":vectors_complete,"complete":r.get::<_,bool>(5)? && vectors_complete,"physical_bytes_reclaimed":null}))
+    })?;
+    let progress=super::collector::progress(c)?;
+    result["pending_checkpoints"]=json!(c.query_row("SELECT count(*) FROM compact_checkpoints WHERE result IS NULL",[],|r|r.get::<_,i64>(0))?);
+    result["gc_complete"]=progress["complete"].clone();
+    result["collect_progress"]=progress;
+    result["copy_progress"]=super::copy_progress::progress(c)?;
+    Ok(result)
+}
+
+pub fn receipt(c: &Connection, request: Request) -> anyhow::Result<Value> {
+    super::super::protocol::require(!request.operation_id.is_empty() && request.operation_id.len()<=128)?;
+    let digest=Sha256::digest(serde_json::to_vec(&request)?).to_vec();
+    let saved:Option<(Vec<u8>,String)>=c.query_row("SELECT digest,result FROM compact_receipts WHERE operation_id=?1",[&request.operation_id],|r|Ok((r.get(0)?,r.get(1)?))).optional()?;
+    match saved {
+        Some((prior,result)) => {
+            if prior!=digest {return Err(super::super::protocol::error("STATE_TX_REPLAY_CONFLICT"));}
+            Ok(json!({"status":"applied","operation_id":request.operation_id,"result":serde_json::from_str::<Value>(&result)?}))
+        }
+        None => Ok(json!({"status":"not_found","operation_id":request.operation_id,"result":null})),
+    }
+}
+
+pub fn execute(c: &Connection, request: Request) -> anyhow::Result<Value> {
+    use super::super::protocol::{require,error};
+    require(!c.is_autocommit() && !request.operation_id.is_empty() && request.operation_id.len()<=128
+        && (1..=if matches!(request.step,Step::Collect) {4096} else if matches!(request.step,Step::Copy) {1024} else {128}).contains(&request.limit) && (1024..=super::LIMIT).contains(&request.max_bytes)
+        && (1..=3000).contains(&request.max_ms))?;
+    super::super::storage_maintenance_lease::validate_in_transaction(c,&request.lease_owner_id,request.lease_fence)?;
+    let digest = Sha256::digest(serde_json::to_vec(&request)?).to_vec();
+    let receipt: Option<(Vec<u8>,String)> = c.query_row("SELECT digest,result FROM compact_receipts WHERE operation_id=?1",[&request.operation_id],|r|Ok((r.get(0)?,r.get(1)?))).optional()?;
+    if let Some((prior,result))=receipt {
+        if prior != digest {return Err(error("STATE_TX_REPLAY_CONFLICT"));}
+        return Ok(serde_json::from_str(&result)?);
+    }
+    let before=status(c)?;
+    require(before["generation"].as_str()==Some(request.expected_generation.as_str()))?;
+    let generation=super::super::protocol::next(super::super::protocol::counter(&request.expected_generation)?)?.to_string();
+    let mut processed=0usize;
+    let mut bytes=0usize;
+    let mut deleted=0usize;
+    match request.step {
+        Step::Checkpoint | Step::EnableIncremental | Step::Rebuild => return Err(error("STATE_TX_INVALID_REQUEST")),
+        Step::Activate => {
+            require(before["phase"]=="legacy")?;
+            c.execute("UPDATE compact_config SET mode=1,phase='copy',last_scope='',last_key='',complete=0,started=0 WHERE singleton=1",[])?;
+            c.execute("UPDATE compact_vector_cursor SET index_id='',epoch=-1,id='',complete=0 WHERE singleton=1",[])?;
+            super::copy_progress::activate(c)?;
+        }
+        Step::Copy => {
+            require(before["active"]==true && (before["phase"]=="copy" || before["phase"]=="compact" && before["rows_complete"]==false))?;
+            (processed,bytes)=copy(c,&request,false)?;
+            if processed==0 && status(c)?["rows_complete"]==true {
+                (processed,bytes)=vectors(c,&request,false)?;
+            }
+        }
+        Step::Cut => {
+            let vectors_complete:bool=c.query_row("SELECT complete FROM compact_vector_cursor WHERE singleton=1",[],|r|r.get(0))?;
+            require(before["active"]==true && before["phase"]=="copy" && before["complete"]==true && vectors_complete)?;
+            c.execute("UPDATE compact_config SET phase='compact' WHERE singleton=1",[])?;
+        }
+        Step::Rollback => {
+            if before["phase"]!="rollback" {
+                c.execute("UPDATE compact_config SET mode=0,phase='rollback',last_scope='',last_key='',complete=0,started=0 WHERE singleton=1",[])?;
+                c.execute("UPDATE compact_vector_cursor SET index_id='',epoch=-1,id='',complete=0 WHERE singleton=1",[])?;
+                super::copy_progress::rollback(c)?;
+            }
+            (processed,bytes)=copy(c,&request,true)?;
+            if processed==0 && status(c)?["rows_complete"]==true {
+                (processed,bytes)=vectors(c,&request,true)?;
+                let done:bool=c.query_row("SELECT complete FROM compact_vector_cursor WHERE singleton=1",[],|r|r.get(0))?;
+                if done {c.execute("UPDATE compact_config SET phase='legacy' WHERE singleton=1",[])?;}
+            }
+        }
+        Step::Collect => {
+            require(before["phase"]=="compact" || before["phase"]=="legacy")?;
+            (processed,deleted,bytes)=super::collector::collect(c,&request)?;
+        }
+    }
+    c.execute("UPDATE compact_config SET generation=?1 WHERE singleton=1",[generation])?;
+    let mut result=status(c)?;
+    result["operation_id"]=json!(request.operation_id);
+    result["processed_count"]=json!(processed);
+    result["input_bytes"]=json!(bytes);
+    if matches!(request.step,Step::Collect) {
+        let progress=super::collector::progress(c)?;
+        result["pending_checkpoints"]=json!(c.query_row("SELECT count(*) FROM compact_checkpoints WHERE result IS NULL",[],|r|r.get::<_,i64>(0))?);
+    result["gc_complete"]=progress["complete"].clone();
+        result["collect_progress"]=progress;
+        result["inspected_count"]=json!(processed);
+        result["deleted_count"]=json!(deleted);
+        let remaining:bool=c.query_row("SELECT EXISTS(SELECT 1 FROM compact_rollback)",[],|r|r.get(0))?;
+        result["retained_inline_present"]=json!(remaining);
+        result["gc_cursor"]=c.query_row("SELECT root,graph_epoch,graph_key,map_epoch,map_identifier,blob FROM compact_gc_cursor WHERE singleton=1",[],|r|Ok(json!({"root":r.get::<_,i64>(0)?,"graph_epoch":r.get::<_,i64>(1)?,"graph_key":r.get::<_,i64>(2)?,"map_epoch":r.get::<_,i64>(3)?,"map_identifier":r.get::<_,i64>(4)?,"blob":r.get::<_,i64>(5)?})))?;
+    }
+    c.execute("INSERT INTO compact_receipts VALUES(?1,?2,?3)",params![request.operation_id,digest,serde_json::to_string(&result)?])?;
+    Ok(result)
+}
+
+fn copy(c: &Connection, request: &Request, rollback: bool) -> anyhow::Result<(usize,usize)> {
+    let budget_started=Instant::now();
+    let mut processed=0;
+    let mut bytes=0usize;
+    let budget=Duration::from_millis(request.max_ms);
+    let mut largest=Duration::ZERO;
+    let mut largest_fetch=Duration::ZERO;
+    loop {
+    if processed>=request.limit || bytes>=request.max_bytes || budget_started.elapsed()>=budget
+        || (processed>0 && budget_started.elapsed().saturating_add(largest.saturating_mul(2))
+            .saturating_add(largest_fetch.saturating_mul(2)).saturating_add(Duration::from_millis(50))>=budget) {break;}
+    let chunk_limit=super::copy_progress::METADATA_CHUNK_LIMIT.min(request.limit-processed);
+    let fetch_started=Instant::now();
+    let (rows,queued)=if rollback {
+        let (scope,key,started):(String,String,bool)=c.query_row("SELECT last_scope,last_key,started FROM compact_config WHERE singleton=1",[],|r|Ok((r.get(0)?,r.get(1)?,r.get(2)?)))?;
+        let mut statement=c.prepare(if started {"SELECT scope,key,version,value_bytes,length(value) FROM state_rows WHERE (scope,key)>(?1,?2) ORDER BY scope,key LIMIT ?3"}else{"SELECT scope,key,version,value_bytes,length(value) FROM state_rows WHERE ?1 IS NOT NULL AND ?2 IS NOT NULL ORDER BY scope,key LIMIT ?3"})?;
+        let rows=statement.query_map(params![scope,key,i64::try_from(chunk_limit+1)?],|r|Ok(super::copy_progress::Row {scope:r.get(0)?,key:r.get(1)?,version:r.get(2)?,logical:r.get(3)?,stored:r.get(4)?,ticket:None}))?.collect::<rusqlite::Result<Vec<_>>>()?;
+        (rows,false)
+    } else {super::copy_progress::batch(c,chunk_limit)?};
+    largest_fetch=largest_fetch.max(fetch_started.elapsed());
+    let chunk_started=processed;
+    for row in rows.iter().take(chunk_limit) {
+        let (scope,key,version,logical,stored)=(&row.scope,&row.key,&row.version,&row.logical,&row.stored);
+        if processed>0 && budget_started.elapsed().saturating_add(largest.saturating_mul(2)).saturating_add(Duration::from_millis(50))>=budget {break;}
+        let row_started=Instant::now();
+        let logical_size=usize::try_from(*logical)?;
+        let stored_size=usize::try_from(stored.unwrap_or(0))?;
+        let control=super::maintenance_control(scope,key);
+        if (rollback || stored_size!=super::MARKER.len()+8 && !control) && bytes.saturating_add(logical_size.max(stored_size))>request.max_bytes {
+            anyhow::ensure!(processed>0,"STATE_TX_LIMIT_EXCEEDED");
+            break;
+        }
+        let probe:Vec<u8>=if stored.is_some() && (rollback || stored_size==super::MARKER.len()+8) {c.query_row("SELECT substr(CAST(value AS BLOB),1,?4) FROM state_rows WHERE scope=?1 AND key=?2 AND version=?3",params![scope,key,version,i64::try_from(super::MARKER.len()+8)?],|r|r.get(0))?} else {Vec::new()};
+        if probe.starts_with(super::MARKER) {anyhow::ensure!(stored_size==super::MARKER.len()+8,"STATE_COMPACT_CORRUPT");}
+        let compact=root(&probe)?.is_some();
+        let convert=stored.is_some() && (control && compact || !control && compact==rollback);
+        let size=if rollback || convert {logical_size.max(stored_size)} else {probe.len().saturating_add(scope.len()).saturating_add(key.len()).saturating_add(version.len()).saturating_add(24)};
+        if bytes.saturating_add(size)>request.max_bytes {
+            anyhow::ensure!(processed>0,"STATE_TX_LIMIT_EXCEEDED");
+            break;
+        }
+        if convert {
+            let physical: Vec<u8>=c.query_row("SELECT CAST(value AS BLOB) FROM state_rows WHERE scope=?1 AND key=?2 AND version=?3",params![scope,key,version],|r|r.get(0))?;
+                let profile_decode=super::super::storage_profile::Clock::start();
+                let encoded: Vec<u8>=c.query_row("SELECT value FROM state_values WHERE scope=?1 AND key=?2 AND version=?3",params![scope,key,version],|r|r.get(0))?;
+                let decoded=super::super::database::decode_value(&encoded,*logical)?;
+                let value:Value=serde_json::from_str(&decoded)?;
+                let target_list=if scope=="mem:graph:nodes" {value["sourceObservationIds"].as_array().map(serde_json::to_string).transpose()?} else {None};
+                super::super::storage_profile::emit("copy_decode",profile_decode,1,size);
+                let profile_store=super::super::storage_profile::Clock::start();
+                let (replacement,built)=if rollback || control {(super::super::codec::encode(&decoded)?,None)} else {store_for_copy(c,scope,key,version,&decoded,target_list.as_deref())?};
+                super::super::storage_profile::emit("copy_store_layout",profile_store,1,size);
+                let profile_write=super::super::storage_profile::Clock::start();
+                if !rollback && !control {
+                    c.execute("INSERT OR IGNORE INTO compact_rollback VALUES(?1,?2,?3,?4,?5)",params![scope,key,version,physical,logical])?;
+                }
+                c.execute("UPDATE state_rows SET value=?4 WHERE scope=?1 AND key=?2 AND version=?3",params![scope,key,version,replacement])?;
+                let position:Option<i64>=c.query_row("SELECT position FROM state_rows WHERE scope=?1 AND key=?2",params![scope,key],|r|r.get(0))?;
+                super::super::storage_profile::emit("copy_snapshot_row_write",profile_write,1,size);
+                let profile_bind=super::super::storage_profile::Clock::start();
+                super::membership::row_built(c,scope,key,position,&value,built.as_ref())?;
+                super::super::storage_profile::emit("copy_membership_bind",profile_bind,1,size);
+                let profile_verify=super::super::storage_profile::Clock::start();
+                let restored:Vec<u8>=c.query_row("SELECT value FROM state_values WHERE scope=?1 AND key=?2 AND version=?3",params![scope,key,version],|r|r.get(0))?;
+                anyhow::ensure!(super::super::database::decode_value(&restored,*logical)?.as_bytes()==decoded.as_bytes(),"STATE_COMPACT_CORRUPT");
+                c.execute("UPDATE graph_storage_metadata SET status='stale' WHERE scope=?1",[scope])?;
+                super::super::storage_profile::emit("copy_verify",profile_verify,1,size);
+        }
+        super::copy_progress::acknowledge(c,row)?;
+        processed+=1;
+        bytes+=size;
+        largest=largest.max(row_started.elapsed());
+    }
+    let chunk_processed=processed-chunk_started;
+    let exhausted=chunk_processed==rows.len();
+    if rollback {
+        if exhausted {c.execute("UPDATE compact_config SET complete=1 WHERE singleton=1",[])?;}
+    } else {super::copy_progress::finish_batch(c,queued,exhausted)?;}
+    if chunk_processed==0 || chunk_processed<rows.len().min(chunk_limit) || (exhausted && (rollback || queued)) {break;}
+    }
+    Ok((processed,bytes))
+}
+
+fn vectors(c:&Connection,request:&Request,rollback:bool)->anyhow::Result<(usize,usize)> {
+    let budget_started=Instant::now();
+    let limit=request.limit.min(super::copy_progress::METADATA_CHUNK_LIMIT);
+    let (index,epoch,key):(String,i64,String)=c.query_row("SELECT index_id,epoch,id FROM compact_vector_cursor WHERE singleton=1",[],|r|Ok((r.get(0)?,r.get(1)?,r.get(2)?)))?;
+    let rows=c.prepare("SELECT index_id,epoch,id,length(embedding) FROM retrieval_vectors WHERE (index_id,epoch,id)>(?1,?2,?3) ORDER BY index_id,epoch,id LIMIT ?4")?.query_map(params![index,epoch,key,i64::try_from(limit+1)?],|r|Ok((r.get::<_,String>(0)?,r.get::<_,i64>(1)?,r.get::<_,String>(2)?,r.get::<_,i64>(3)?)))?.collect::<rusqlite::Result<Vec<_>>>()?;
+    let mut processed=0usize;
+    let mut bytes=0usize;
+    let budget=Duration::from_millis(request.max_ms);
+    let mut largest=Duration::ZERO;
+    for (index,epoch,key,stored) in rows.iter().take(limit) {
+        if processed>0 && budget_started.elapsed().saturating_add(largest.saturating_mul(2)).saturating_add(Duration::from_millis(50))>=budget {break;}
+        let row_started=Instant::now();
+        let raw_size:Option<i64>=c.query_row("SELECT length(b.payload) FROM compact_vector_refs f JOIN compact_blobs b ON b.id=f.blob WHERE f.index_id=?1 AND f.epoch=?2 AND f.id=?3",params![index,epoch,key],|r|r.get(0)).optional()?;
+        let size=usize::try_from(raw_size.unwrap_or(*stored))?;
+        if bytes.saturating_add(size)>request.max_bytes {anyhow::ensure!(processed>0,"STATE_TX_LIMIT_EXCEEDED");break;}
+        let physical:Vec<u8>=c.query_row("SELECT embedding FROM retrieval_vectors WHERE index_id=?1 AND epoch=?2 AND id=?3",params![index,epoch,key],|r|r.get(0))?;
+        let compact=physical.len()==super::MARKER.len()+8 && root(&physical)?.is_some();
+        if compact==rollback {
+            let original:Vec<u8>=c.query_row("SELECT embedding FROM retrieval_vector_values WHERE index_id=?1 AND epoch=?2 AND id=?3",params![index,epoch,key],|r|r.get(0))?;
+            let replacement=super::vector(c,index,*epoch,key,&original)?;
+            c.execute("UPDATE retrieval_vectors SET embedding=?4 WHERE index_id=?1 AND epoch=?2 AND id=?3",params![index,epoch,key,replacement])?;
+            let restored:Vec<u8>=c.query_row("SELECT embedding FROM retrieval_vector_values WHERE index_id=?1 AND epoch=?2 AND id=?3",params![index,epoch,key],|r|r.get(0))?;
+            anyhow::ensure!(original==restored,"STATE_COMPACT_CORRUPT");
+        }
+        c.execute("UPDATE compact_vector_cursor SET index_id=?1,epoch=?2,id=?3 WHERE singleton=1",params![index,epoch,key])?;
+        processed+=1;bytes+=size;
+        largest=largest.max(row_started.elapsed());
+    }
+    if processed==rows.len() {c.execute("UPDATE compact_vector_cursor SET complete=1 WHERE singleton=1",[])?;}
+    Ok((processed,bytes))
+}
diff --git a/engine/src/workers/state/adapters/sqlite/compact/membership.rs b/engine/src/workers/state/adapters/sqlite/compact/membership.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/compact/membership.rs
@@ -0,0 +1,72 @@
+use rusqlite::{Connection,OptionalExtension,params};
+use serde_json::Value;
+
+pub fn replace(c:&Connection,epoch:i64,key:&str,position:i64,members:&[Value])->anyhow::Result<()> {
+    replace_built(c,epoch,key,position,members,None)
+}
+
+fn replace_built(c:&Connection,epoch:i64,key:&str,position:i64,members:&[Value],built:Option<&super::BuiltList>)->anyhow::Result<()> {
+    let active:bool=c.query_row("SELECT mode=1 FROM compact_config WHERE singleton=1",[],|r|r.get(0))?;
+    let key_id:Option<i64>=c.query_row("SELECT id FROM retrieval_identifiers WHERE epoch=?1 AND value=?2",params![epoch,key],|r|r.get(0)).optional()?;
+    let Some(key_id)=key_id else {return Ok(());};
+    if !active {return restore(c,epoch,key_id);}
+    let raw=serde_json::to_string(members)?;
+    let (blob,identifiers)=if let Some(built)=built {
+        anyhow::ensure!(built.canonical==raw,"STATE_COMPACT_CORRUPT");
+        (built.blob,super::layout::unpack(&built.packed)?)
+    } else {
+        let packed=super::layout::list(c,&raw)?.ok_or_else(||super::super::protocol::error("STATE_TX_INVALID_REQUEST"))?;
+        (super::intern(c,2,&packed,raw.len())?,super::layout::unpack(&packed)?)
+    };
+    bind_members(c,epoch,blob,&identifiers,built.is_some())?;
+    let changed=c.execute("INSERT INTO compact_graph_lists VALUES(?1,?2,?3,?4) ON CONFLICT(epoch,key) DO UPDATE SET position=excluded.position,list=excluded.list WHERE compact_graph_lists.position IS NOT excluded.position OR compact_graph_lists.list IS NOT excluded.list",params![epoch,key_id,position,blob])?;
+    if changed>0 {super::collector::invalidate(c)?;}
+    c.execute("DELETE FROM retrieval_membership INDEXED BY retrieval_membership_key WHERE epoch=?1 AND key=?2",params![epoch,key_id])?;
+    Ok(())
+}
+
+pub(super) fn list_members(c:&Connection,blob:i64,identifiers:&[i64])->anyhow::Result<()> {
+    let ids=serde_json::to_string(identifiers)?;
+    c.prepare_cached("INSERT OR IGNORE INTO compact_list_members(list_id,identifier) SELECT ?1,CAST(j.value AS INTEGER) FROM json_each(?2) j ORDER BY CAST(j.value AS INTEGER)")?.execute(params![blob,ids])?;
+    let exact:bool=c.prepare_cached("SELECT (SELECT count(*) FROM compact_list_members WHERE list_id=?1)=(SELECT count(DISTINCT CAST(value AS INTEGER)) FROM json_each(?2))")?.query_row(params![blob,ids],|r|r.get(0))?;
+    anyhow::ensure!(exact,"STATE_COMPACT_CORRUPT");
+    Ok(())
+}
+
+fn bind_members(c:&Connection,epoch:i64,blob:i64,identifiers:&[i64],list_bound:bool)->anyhow::Result<()> {
+    let ids=serde_json::to_string(identifiers)?;
+    let found:i64=c.prepare_cached("SELECT count(*) FROM json_each(?1) j JOIN compact_identifiers i ON i.id=CAST(j.value AS INTEGER) WHERE json_type(i.token,'$')='text'")?
+        .query_row([&ids],|r|r.get(0))?;
+    anyhow::ensure!(usize::try_from(found)?==identifiers.len(),"STATE_COMPACT_CORRUPT");
+    if !list_bound {list_members(c,blob,identifiers)?;}
+    // New native IDs follow the same first-occurrence order as the former loop.
+    c.prepare_cached("INSERT OR IGNORE INTO retrieval_identifiers(epoch,value) SELECT ?1,json_extract(i.token,'$') FROM json_each(?2) j JOIN compact_identifiers i ON i.id=CAST(j.value AS INTEGER) ORDER BY CAST(j.key AS INTEGER)")?
+        .execute(params![epoch,ids])?;
+    c.prepare_cached("INSERT INTO compact_graph_identifiers(epoch,identifier,observation) SELECT ?1,i.id,o.id FROM json_each(?2) j JOIN compact_identifiers i ON i.id=CAST(j.value AS INTEGER) JOIN retrieval_identifiers o ON o.epoch=?1 AND o.value=json_extract(i.token,'$') WHERE 1 ORDER BY i.id ON CONFLICT(epoch,identifier) DO UPDATE SET observation=excluded.observation")?
+        .execute(params![epoch,ids])?;
+    // Keep JSON outermost: an epoch-first scan multiplies every member by the whole list.
+    let bound:i64=c.prepare_cached("SELECT count(*) FROM json_each(?2) j CROSS JOIN compact_identifiers i ON i.id=CAST(j.value AS INTEGER) CROSS JOIN compact_graph_identifiers g ON g.epoch=?1 AND g.identifier=i.id CROSS JOIN retrieval_identifiers o ON o.epoch=?1 AND o.id=g.observation AND o.value=json_extract(i.token,'$')")?
+        .query_row(params![epoch,ids],|r|r.get(0))?;
+    anyhow::ensure!(usize::try_from(bound)?==identifiers.len(),"STATE_COMPACT_CORRUPT");
+    Ok(())
+}
+
+pub fn restore(c:&Connection,epoch:i64,key:i64)->anyhow::Result<()> {
+    c.execute("INSERT OR IGNORE INTO retrieval_membership SELECT epoch,observation,key,position FROM compact_graph_membership WHERE epoch=?1 AND key=?2",params![epoch,key])?;
+    let changed=c.execute("DELETE FROM compact_graph_lists WHERE epoch=?1 AND key=?2",params![epoch,key])?;
+    if changed>0 {super::collector::invalidate(c)?;}
+    Ok(())
+}
+
+pub fn row(c:&Connection,scope:&str,key:&str,position:Option<i64>,value:&Value)->anyhow::Result<()> {
+    row_built(c,scope,key,position,value,None)
+}
+
+pub(super) fn row_built(c:&Connection,scope:&str,key:&str,position:Option<i64>,value:&Value,built:Option<&super::BuiltList>)->anyhow::Result<()> {
+    if value["stale"]==true {return Ok(());}
+    if scope!="mem:graph:nodes" {return Ok(());}
+    let Some(position)=position else {return Ok(());};
+    let epoch:Option<i64>=c.query_row("SELECT epoch FROM retrieval_graph_meta WHERE scope=?1",[scope],|r|r.get(0)).optional()?;
+    if let (Some(epoch),Some(members))=(epoch,value["sourceObservationIds"].as_array()) {replace_built(c,epoch,key,position,members,built)?;}
+    Ok(())
+}
diff --git a/engine/src/workers/state/adapters/sqlite/crash_tests.rs b/engine/src/workers/state/adapters/sqlite/crash_tests.rs
new file mode 100644
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/crash_tests.rs
@@ -0,0 +1,242 @@
+use super::*;
+
+#[test]
+#[ignore = "only run as an isolated crash subprocess"]
+fn sqlite_crash_probe() {
+    let path = match std::env::var("III_SQLITE_CRASH_PATH") {
+        Ok(path) => path,
+        Err(std::env::VarError::NotPresent) => return,
+        Err(std::env::VarError::NotUnicode(_)) => {
+            panic!("isolated crash subprocess path must be valid UTF-8")
+        }
+    };
+    let mode = std::env::var("III_SQLITE_CRASH_MODE").unwrap();
+    let runtime = tokio::runtime::Runtime::new().unwrap();
+    runtime.block_on(async {
