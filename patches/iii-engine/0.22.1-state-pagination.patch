+}
+pub(super) fn pin_staging(connection:&Connection,anchor:&Anchor,job:&Value)->anyhow::Result<()> {
+    let point=database::row(connection,database::CHECKPOINT_SCOPE,&anchor.job_id)?;
+    let checkpoint:Checkpoint=protocol::decode(point.value.ok_or_else(||error(UNPROVEN))?)?;
+    let current=TerminalAnchor {guard:anchor.guard.clone(),job_id:anchor.job_id.clone(),job_version:anchor.job_version.clone(),checkpoint_version:anchor.checkpoint_version.clone()};
