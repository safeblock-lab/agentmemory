+pub fn page(connection: &Connection, request: Request) -> anyhow::Result<Value> {
+    let started=std::time::Instant::now();
+    require(storage_maintenance_lease::valid_owner(&request.run_id) && request.ordinal < 1_000_000
+        && (DAY..=365*DAY).contains(&request.viewer_max_age_ms)
+        && (7*DAY..=365*DAY).contains(&request.tools_max_age_ms)
+        && (7*DAY..=365*DAY).contains(&request.bodies_max_age_ms))?;
+    storage_maintenance_lease::validate_in_transaction(connection,&request.owner_id,request.fence)?;
+    commit::maintenance_allowed(connection,&request.guard,None)?;
+    super::retention_use_schema::reclaim(connection,chrono::Utc::now().timestamp_millis())?;
+    let run_key=format!("ttl:{}",request.run_id);
+    let receipt_key=format!("{run_key}:{}",request.ordinal);
+    require(request.cutoff_at_ms.is_none_or(|at|at>=0 && at<=chrono::Utc::now().timestamp_millis()))?;
+    let policy=json!({"viewerMaxAgeMs":request.viewer_max_age_ms,"bodiesMaxAgeMs":request.bodies_max_age_ms,"toolsMaxAgeMs":request.tools_max_age_ms,"measureOnly":request.measure_only,"cutoffAtMs":request.cutoff_at_ms,"legacyVectorCacheOnly":request.legacy_vector_cache_only,"implementation":6});
+    if let Some(receipt)=database::row(connection,STATE,&receipt_key)?.value {
+        require(receipt["progress"]["policy"]==policy)?;
+        return Ok(receipt);
+    }
+    let mut run=database::row(connection,STATE,&run_key)?.value.unwrap_or_else(||json!({
+        "ordinal":0,"scope":"","key":"","done":false,"policy":policy,"categories":{},
+        "startedAt":chrono::Utc::now().to_rfc3339(),"cutoffAtMs":request.cutoff_at_ms.unwrap_or_else(||chrono::Utc::now().timestamp_millis())}));
+    require(run["ordinal"].as_u64()==Some(request.ordinal) && run["policy"]==policy && run["done"]==false)?;
+    let now=run["cutoffAtMs"].as_i64().ok_or_else(||error("STATE_TX_INVALID_REQUEST"))?;
+    let mut scope=run["scope"].as_str().ok_or_else(||error("STATE_TX_INVALID_REQUEST"))?.to_owned();
+    let mut inspected=0usize;let mut deleted=0u64;let mut stripped=0u64;let mut logical=0u64;let mut stored=0u64;
+    let mut input=0i64;let mut excluded=0u64;let mut eligible=0u64;let mut eligible_logical=0u64;let mut eligible_stored=0u64;
+    let mut oversized=0usize;let mut chunks=0usize;let mut categories=json!({});
+    while inspected<4096 && input<4_194_304 && started.elapsed().as_millis()<2200 {
+        if scope.is_empty() || run["scopeDone"]==true {
+            let scopes = if request.legacy_vector_cache_only {
+                "SELECT scope FROM state_scopes WHERE scope>?1 AND scope>='mem:index:bm25:vec:' AND scope<'mem:index:bm25:vec;' ORDER BY scope LIMIT 1"
+            } else {
+                "SELECT scope FROM state_scopes WHERE scope>?1 AND (scope IN ('mem:recent-searches','mem:routine-runs','mem:temporal-graph-work','mem:temporal-graph-pending') OR (scope>='mem:summary-queue:units:' AND scope<'mem:summary-queue:units;') OR (scope>='mem:obs:' AND scope<'mem:obs;') OR (scope>='mem:graph:prepared:' AND scope<'mem:graph:prepared;') OR (scope>='mem:graph:remaps:' AND scope<'mem:graph:remaps;')) ORDER BY scope LIMIT 1"
+            };
+            scope=connection.query_row(scopes,[&scope],|row|row.get::<_,String>(0)).optional()?.unwrap_or_default();
+            run["key"]=json!("");run["scopeDone"]=json!(false);
+            if scope.is_empty(){run["done"]=json!(true);break;}
+        }
+        let after=run["key"].as_str().ok_or_else(||error("STATE_TX_INVALID_REQUEST"))?;
+        let chunk_limit=(4096-inspected).min(128);
+        let rows=connection.prepare_cached("SELECT key,value_bytes,COALESCE(stored_bytes,0) FROM state_values WHERE scope=?1 AND key>?2 AND live=1 ORDER BY key LIMIT ?3")?
+            .query_map(params![scope,after,chunk_limit as i64],|row|Ok((row.get::<_,String>(0)?,row.get::<_,i64>(1)?,row.get::<_,i64>(2)?)))?.collect::<rusqlite::Result<Vec<_>>>()?;
+        let mut consumed=0;
+        for (key,size,encoded) in &rows {
+            let cost=(*size).max(*encoded);
+            if started.elapsed().as_millis()>=2200 || (cost<=1_048_576 && input.saturating_add(cost)>4_194_304){break;}
+            inspected+=1;consumed+=1;run["key"]=json!(key);
+            let category=if request.legacy_vector_cache_only{"legacyVectorCache"}else if scope=="mem:recent-searches"{"viewer"}else if scope.starts_with("mem:obs:"){"toolBodies"}else if scope.starts_with("mem:summary-queue:"){"summaryAuxiliary"}else if scope.starts_with("mem:graph:"){"graphAuxiliary"}else{"completedBodies"};
+            let band=if cost>1_048_576{"above1MiB"}else if cost>131_072{"above128KiBTo1MiB"}else{"upTo128KiB"};
+            let mut reason="row_decode_budget".to_owned();
+            let mut proof=String::new();
+            let mut result=json!({});
+            if cost>1_048_576 {oversized+=1;} else {
+                input+=cost;
+                let value=database::row(connection,&scope,key)?.value.ok_or_else(||error("STATE_TX_CONFLICT"))?;
+                let maximum=if scope=="mem:recent-searches"{request.viewer_max_age_ms}else if scope.starts_with("mem:obs:"){request.tools_max_age_ms}else{request.bodies_max_age_ms};
+                // Simulation rolls back source rows, revisions, memberships and GC invalidation.
+                // Only this page's measurement cursor/receipt is committed by the outer transaction.
+                if request.measure_only {connection.execute_batch("SAVEPOINT ttl_measure_candidate")?;}
+                result=remove(connection,&scope,key,&value,maximum,now,&request.guard,&request.owner_id,request.fence)?;
+                proof=result["proof"].as_str().unwrap_or("").to_owned();
+                if let Some(candidate)=result.get("candidate") {
+                    result=storage_prune::prune_at(connection,vec![protocol::decode(candidate.clone())?],4_194_304,now)?;
+                    reason="dependency_or_publication_proof_not_closed".to_owned();
+                }else{reason=result["reason"].as_str().unwrap_or("eligible").to_owned();}
+                if request.measure_only {connection.execute_batch("ROLLBACK TO ttl_measure_candidate; RELEASE ttl_measure_candidate")?;}
+            }
+            let count=result["deleted_count"].as_u64().unwrap_or(0);
+            let raw=result["raw_stripped_count"].as_u64().unwrap_or(0);
+            let removed_logical=result["deleted_logical_bytes"].as_u64().unwrap_or(0);
+            let removed_stored=result["deleted_stored_bytes"].as_u64().unwrap_or(0);
+            if count+raw>0 {
+                reason=if proof=="legacy_cache_stale_dimension_canonical_preserved" {
+                    if request.measure_only{"eligible_stale_vector_cache"}else{"modified_stale_vector_cache"}
+                }else if proof=="native_admission_exact_source_compression" {
+                    if request.measure_only{"eligible_native_admission_exact_source_compression"}else{"modified_native_admission_exact_source_compression"}
+                }else if request.measure_only{"eligible"}else{"modified"}.to_owned();
+                eligible+=1;eligible_logical+=removed_logical;eligible_stored+=removed_stored;
+                if !request.measure_only{deleted+=count;stripped+=raw;logical+=removed_logical;stored+=removed_stored;}
+            }else{excluded+=1;}
+            account(&mut categories,category,&reason,band,u64::try_from(*size)?,u64::try_from(*encoded)?);
+            account(&mut run["categories"],category,&reason,band,u64::try_from(*size)?,u64::try_from(*encoded)?);
+        }
+        chunks+=1;run["scopeDone"]=json!(rows.len()<chunk_limit && consumed==rows.len());
+        if consumed<rows.len(){break;}
+    }
+    run["scope"]=json!(scope);run["ordinal"]=json!(request.ordinal+1);
+    for(field,delta)in[("inspected",inspected as u64),("deleted",deleted),("rawStripped",stripped),("logicalBytesDeleted",logical),("storedBytesDeleted",stored),("excluded",excluded),("eligible",eligible),("eligibleLogicalBytes",eligible_logical),("eligibleStoredBytes",eligible_stored)]{
+        run[field]=json!(run[field].as_u64().unwrap_or(0).checked_add(delta).ok_or_else(||error("STATE_TX_LIMIT_EXCEEDED"))?);
+    }
+    let receipt=json!({"runId":request.run_id,"ordinal":request.ordinal,"scope":scope,"inspected":inspected,"deleted":deleted,"rawStripped":stripped,"logicalBytesDeleted":logical,"storedBytesDeleted":stored,"excluded":excluded,"eligible":eligible,"eligibleLogicalBytes":eligible_logical,"eligibleStoredBytes":eligible_stored,"inputBytes":input,"oversizedRetained":oversized,"chunks":chunks,"categories":categories,"elapsedMs":started.elapsed().as_millis(),"done":run["done"],"progress":run,"physicalBytesReclaimed":null,"leaseFence":request.fence,"graphFence":request.guard.fence,"completedAt":chrono::Utc::now().to_rfc3339()});
+    database::write(connection,STATE,&run_key,Some(&run))?;
+    database::write(connection,STATE,&receipt_key,Some(&receipt))?;
+    Ok(receipt)
+}
