+}
+fn lineage(connection:&Connection,job:&str)->anyhow::Result<Option<(String,Value)>> {
+    let row:Option<(String,String)>=connection.query_row("SELECT r.root_id,t.proof_json FROM engine_graph_auto_regenerations r JOIN engine_graph_auto_terminal_sources t ON t.root_id=r.root_id WHERE r.new_job_id=?1",[job],|r|Ok((r.get(0)?,r.get(1)?))).optional()?;
+    row.map(|(root,proof)|Ok((root,protocol::strict_value(&proof)?))).transpose()
+}
+fn simple_prefix(connection:&Connection,job:&str,delta:u64)->anyhow::Result<()> {
+    need(delta==3,UNPROVEN)?;
+    let provider=format!("mem:graph:provider-results:{job}");
+    let mut intents=connection.prepare("SELECT key FROM state_values WHERE scope=?1 AND key>='provider-intent:' AND key<'provider-intent;' AND value IS NOT NULL LIMIT 1025")?;
+    let keys=intents.query_map([&provider],|row|row.get::<_,String>(0))?.collect::<rusqlite::Result<Vec<_>>>()?;
+    need(keys.len()<=1024 && keys.iter().all(|key|key.strip_prefix("provider-intent:").and_then(|key|key.split(':').next()).and_then(|ordinal|ordinal.parse::<u64>().ok()).is_some_and(|ordinal|ordinal>=delta)),UNPROVEN)?;
+    for ordinal in 1..delta {
+        let manifest=database::row(connection,&format!("mem:graph:deltas:{job}"),&format!("manifest:{ordinal}"))?.value.ok_or_else(||error(UNPROVEN))?;
+        let count=manifest["templateCount"].as_u64().filter(|count|*count>0 && *count<=512).ok_or_else(||error(UNPROVEN))?;
+        let attempt=string(&manifest["attempt"],UNPROVEN)?;
+        for index in 0..count {
+            let operations=database::row(connection,&format!("mem:graph:remaps:{job}"),&format!("template:{ordinal}:{attempt}:{index}"))?.value.ok_or_else(||error(UNPROVEN))?;
+            for operation in operations.as_array().ok_or_else(||error(UNPROVEN))? {
+                let scope=string(&operation["scope"],UNPROVEN)?;
+                need(operation["type"]=="check" || [format!("mem:graph:inputs:{job}"),provider.clone(),format!("mem:graph:deltas:{job}"),format!("mem:graph:remaps:{job}")].iter().any(|allowed|scope==allowed)
+                    || scope==JOBS && operation["key"]==job,UNPROVEN)?;
+            }
+        }
+    }
+    Ok(())
+}
+pub(super) fn derive(connection:&Connection,current:&TerminalAnchor,job:&Value,checkpoint:&Checkpoint)->anyhow::Result<(Anchor,Value,Value)> {
+    let generation=string(&job["generation"],UNPROVEN)?.to_owned();protocol::counter(&generation)?;
+    let progress=&job["continuationState"];
+    let (delta,name)=if progress["version"]==2 {
+        let unit=&progress["activeUnit"];let page_index=ordinal(&progress["pageIndex"])?;
+        need(unit["pageIndex"]==page_index && page_index<ordinal(&progress["pageCount"])?,UNPROVEN)?;
+        let delta=ordinal(&unit["resultOrdinal"])?;need(delta>0 && delta<=checkpoint.delta_ordinal,UNPROVEN)?;
+        let page=database::row(connection,&format!("mem:graph:provider-results:{}",current.job_id),&format!("project-work-page:v3:{page_index}"))?.value.ok_or_else(||error(UNPROVEN))?;
+        let expected=grouped::unit(&current.job_id,usize::try_from(page_index)?,&page,progress)?;
+        need(unit["id"]==expected.id,UNPROVEN)?;
+        (delta,format!("project-work-response:v3:{}",expected.id))
+    } else {
+        let manifest=database::row(connection,&format!("mem:graph:deltas:{}",current.job_id),&format!("manifest:{}",checkpoint.delta_ordinal))?.value.ok_or_else(||error(UNPROVEN))?;
+        need(manifest["phase"]=="preparing" && ["templateCount","applyOrdinal","applyCheckpointVersion","result"].iter().all(|key|manifest.get(key).is_none()),UNPROVEN)?;
+        let prefix=format!("provider-intent:{}:",checkpoint.delta_ordinal);
+        let mut statement=connection.prepare("SELECT key FROM state_values WHERE scope=?1 AND key>=?2 AND key<?3 AND value IS NOT NULL ORDER BY key LIMIT 3")?;
+        let keys=statement.query_map(params![format!("mem:graph:provider-results:{}",current.job_id),prefix,format!("{prefix}\u{10ffff}")],|r|r.get::<_,String>(0))?.collect::<rusqlite::Result<Vec<_>>>()?;
+        need(keys.len()==1,UNPROVEN)?;
+        let name=keys[0].strip_prefix(&prefix).ok_or_else(||error(UNPROVEN))?.to_owned();
+        need(name=="compaction",UNPROVEN)?;
+        simple_prefix(connection,&current.job_id,checkpoint.delta_ordinal)?;
+        (checkpoint.delta_ordinal,name)
+    };
+    let row=database::row(connection,&format!("mem:graph:deltas:{}",current.job_id),&format!("manifest:{delta}"))?;
+    let manifest=row.value.ok_or_else(||error(UNPROVEN))?;
+    need(manifest["id"]==format!("delta:{delta}") && manifest["ordinal"]==delta && manifest["advanceGeneration"]!=true,UNPROVEN)?;
+    let anchor=Anchor {guard:current.guard.clone(),job_id:current.job_id.clone(),job_version:current.job_version.clone(),source_generation:Some(generation),checkpoint_version:current.checkpoint_version.clone(),delta_ordinal:delta,value_name:name,manifest_version:row.version.to_string(),manifest_attempt:string(&manifest["attempt"],UNPROVEN)?.to_owned()};
+    anchor.validate()?;
+    let input=capture(connection,&anchor,job)?;
+    if let Some((_,parent))=lineage(connection,&current.job_id)? {
+        need(normalized(input.clone())?==parent["capture"],SCOPE)?;
+        let old:Anchor=serde_json::from_value(parent["anchor"].clone())?;
+        let old_job=database::row(connection,JOBS,&old.job_id)?.value.ok_or_else(||error(SCOPE))?;
+        need(binding::source_capture(connection,&old,&old_job)?==string(&parent["source_digest"],SCOPE)?,SCOPE)?;
+        if parent["progress"]["version"]==2 {
+            let base=ordinal(&parent["progress"]["pageIndex"])?;
+            need(progress["version"]==2 && progress["pageCount"]==ordinal(&parent["progress"]["pageCount"])?-base
+                && progress["extractionSystem"]==parent["progress"]["extractionSystem"]
+                && progress["envelopeSuffix"]==parent["progress"]["envelopeSuffix"] && progress["options"]==parent["progress"]["options"],SCOPE)?;
+            for index in ordinal(&progress["pageIndex"])?..ordinal(&progress["pageCount"])? {
+                let row=database::row(connection,&anchor.provider_scope(),&format!("project-work-page:v3:{index}"))?.value.ok_or_else(||error(SCOPE))?;
+                let old_row=database::row(connection,&old.provider_scope(),&format!("project-work-page:v3:{}",base+index))?;
+                let retained=parent["pages"].as_array().and_then(|pages|pages.iter().find(|page|page["index"]==base+index)).ok_or_else(||error(SCOPE))?;
+                need(old_row.value.as_ref()==Some(&row) && retained["version"]==old_row.version.to_string()
+                    && retained["digest"]==binding::digest(serde_json::to_string(&row)?.as_bytes()),SCOPE)?;
+            }
+        }
+    }
+    let selection=selected(connection,&anchor,job,&input)?;
+    let intent=database::row(connection,&anchor.provider_scope(),&anchor.intent_key())?;
+    let value=database::row(connection,&anchor.provider_scope(),&anchor.value_key())?;
+    need(intent.value.as_ref().is_some_and(|intent|intent["version"]==1 && ["intended","not-dispatched"].iter().any(|state|intent["state"]==*state) && intent["id"].as_str().is_some()) || value.value.is_some(),UNPROVEN)?;
+    if anchor.delta_ordinal<checkpoint.delta_ordinal {
+        need(manifest["phase"]=="preparing" && ["templateCount","applyOrdinal","applyCheckpointVersion","result"].iter().all(|key|manifest.get(key).is_none()) || applied(connection,&anchor,&manifest,checkpoint,&current.checkpoint_version).is_ok(),UNPROVEN)?;
+    }
+    let mut pages=Vec::new();
+    if progress["version"]==2 {
+        let start=ordinal(&progress["pageIndex"])?;let count=ordinal(&progress["pageCount"])?;
+        need(count>=start && count-start<=1024,UNPROVEN)?;
+        for index in start..count {
+            let key=format!("project-work-page:v3:{index}");let row=database::row(connection,&anchor.provider_scope(),&key)?;
+            let page=row.value.ok_or_else(||error(UNPROVEN))?;
+            need(page["version"]==2 && page["sources"].as_array().is_some_and(|sources|!sources.is_empty() && sources.len()<=12),UNPROVEN)?;
+            if !selection.is_null() {need(page["project"]==selection["project"],SCOPE)?;}
+            if let Some(observations)=input["observations"].as_array() {
+                for source in page["sources"].as_array().ok_or_else(||error(UNPROVEN))? {
+                    need(observations.iter().any(|observation|observation["id"]==source["id"]
+                        && source["version"].as_str().is_some_and(|version|observation["timestamp"].as_str().is_some_and(|timestamp|version.starts_with(&format!("{timestamp}:"))))),UNPROVEN)?;
+                }
+            } else {need(selection.is_null(),SCOPE)?;}
+            pages.push(json!({"index":index,"version":row.version.to_string(),"digest":binding::digest(serde_json::to_string(&page)?.as_bytes())}));
+        }
+    }
+    let reference=value.value.map_or(Value::Null,|reference|json!({"scope":anchor.provider_scope(),"key":anchor.value_key(),"version":value.version.to_string(),"reference":reference}));
+    let proof=json!({"anchor":anchor,"capture":normalized(input)?,"source_digest":binding::source_capture(connection,&anchor,job)?,"selection":selection,"progress":progress,"pages":pages,"reference":reference});
+    Ok((anchor,proof,reference))
+}
+pub(super) fn history(connection:&Connection,anchor:&Anchor,intent:Option<&Value>)->anyhow::Result<Option<&'static str>> {
+    let mut effects=Vec::new();
+    if anchor.value_name=="compaction" && anchor.delta_ordinal==3 {
+        if let Some(receipt)=database::row(connection,&anchor.provider_scope(),"repeat-intent:3:compaction")?.value {
+            if receipt["version"]!=1 || receipt["generation"]!=*anchor.source_generation.as_ref().unwrap_or(&anchor.guard.generation) || receipt["acknowledgedUnknown"]!=true {return Ok(Some("GRAPH_AUTOMATIC_HISTORY_UNBOUND"));}
+            effects.push(string(&receipt["effectId"],UNPROVEN)?.to_owned());
+        }
+    }
+    if anchor.value_name=="provider-response" {
+        if let Some(receipt)=database::row(connection,&anchor.provider_scope(),&format!("provider-response-admission:{}",anchor.delta_ordinal))?.value {
+            if receipt["version"]!=1 || intent.is_none_or(|intent|receipt["intentId"]!=intent["id"]) {return Ok(Some("GRAPH_AUTOMATIC_HISTORY_UNBOUND"));}
+            effects.push(string(&receipt["effectId"],UNPROVEN)?.to_owned());
+        }
+    }
+    let mut statement=connection.prepare("SELECT g.operation_id,g.declaration,o.claim_id,o.consumed,o.state FROM engine_provider_budget_grants g LEFT JOIN engine_provider_budget_operations o ON o.operation_id=g.operation_id ORDER BY g.operation_id LIMIT 1025")?;
+    let rows=statement.query_map([],|r|Ok((r.get::<_,String>(0)?,r.get::<_,String>(1)?,r.get::<_,Option<String>>(2)?,r.get::<_,Option<i64>>(3)?,r.get::<_,Option<String>>(4)?)))?.collect::<rusqlite::Result<Vec<_>>>()?;
+    if rows.len()>1024 {return Ok(Some("GRAPH_AUTOMATIC_HISTORY_UNBOUND"));}
+    let mut exact=false;
+    for (operation,declaration,claim,_,_) in rows {
+        let declaration=protocol::strict_value(&declaration)?;let context=&declaration["context"];
+        if effects.iter().any(|effect|effect==&operation || claim.as_ref()==Some(effect)) {exact=true;continue;}
+        if context["jobId"]==anchor.job_id && (context.get("unitId").is_none() || context["unitId"]==anchor.value_name
+            || anchor.value_name.strip_prefix("project-work-response:v3:").is_some_and(|unit|context["unitId"]==unit)) {
+            return Ok(Some("GRAPH_AUTOMATIC_HISTORY_UNBOUND"));
+        }
+    }
+    if exact || !effects.is_empty() {Ok(Some("GRAPH_AUTOMATIC_SLOT_EXHAUSTED"))} else {Ok(None)}
+}
+fn output(connection:&Connection,current:&TerminalAnchor,slot:Option<&Anchor>,value_ref:Value,reason:Option<&str>,fresh:bool)->anyhow::Result<Value> {
+    let mut recovery=slot.map(|anchor|store::response(connection,"status",&binding::slot_id(anchor)?,false)).transpose()?;
+    if let (Some(reason),Some(recovery))=(reason,recovery.as_mut()) {
+        recovery["reason"]=json!(reason);
+        recovery["retry_after_ms"]=json!(store::retry_after(connection,Some(reason))?);
+    }
+    let mut replacement=Value::Null;let mut resolution="terminal";
+    let mut why=reason.map(str::to_owned);let mut retry=Value::Null;
+    if let Some(recovery)=&recovery {
+        if why.is_none(){why=recovery["reason"].as_str().map(str::to_owned);}
+        retry=recovery["retry_after_ms"].clone();
+        if let (Some(new_job),Some(regeneration))=(recovery["new_job_id"].as_str(),recovery["regeneration_id"].as_str()) {
+            let (claimed,local):(Option<String>,Option<String>)=connection.query_row("SELECT r.claimed_slot_id,t.local_value_digest FROM engine_graph_auto_regenerations r LEFT JOIN engine_graph_auto_terminal_sources t ON t.root_id=r.root_id WHERE r.regeneration_id=?1",[regeneration],|r|Ok((r.get(0)?,r.get(1)?)))?;
+            let usable=local.is_some() || claimed.is_some() || recovery["reason"]=="GRAPH_AUTOMATIC_REGENERATION_READY";
+            if usable && new_job!=current.job_id {
+                resolution=if local.is_some(){"local_replay"}else{"regeneration"};
+                replacement=json!({"job_id":new_job,"regeneration_id":regeneration,"mode":if local.is_some(){"local_replay"}else{"provider"}});
+            }
+        }
+    }
+    Ok(json!({"capability":CAPABILITY,"policy":policy(),"command":"terminal_recover","job_id":current.job_id,"job_version":current.job_version,"checkpoint_version":current.checkpoint_version,
+        "resolution":resolution,"reason":why,"retry_after_ms":retry,"fresh":fresh,"adoption_revision":adoption::REVISION,"unspent_child_revision":super::child::REVISION,"unspent_child_proof_revision":super::child::PROOF_REVISION,
+        "original_slot":slot.map(|anchor|json!({"generation":anchor.source_generation.as_ref().unwrap_or(&anchor.guard.generation),"delta_ordinal":anchor.delta_ordinal,"value_name":anchor.value_name,"manifest_version":anchor.manifest_version,"manifest_attempt":anchor.manifest_attempt,"value_ref":value_ref})),"recovery":recovery,"replacement":replacement}))
+}
+fn stopped(connection:&Connection,current:&TerminalAnchor,generation:&str,reason:&str,now:i64)->anyhow::Result<Value> {
+    connection.execute("INSERT INTO engine_graph_auto_terminal_results(job_id,generation,job_version,checkpoint_version,reason,updated_at_ms) VALUES(?1,?2,?3,?4,?5,?6) ON CONFLICT(job_id,generation) DO UPDATE SET job_version=excluded.job_version,checkpoint_version=excluded.checkpoint_version,reason=excluded.reason,updated_at_ms=excluded.updated_at_ms",params![current.job_id,generation,current.job_version,current.checkpoint_version,reason,now])?;
