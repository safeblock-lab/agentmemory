+#[test]
+fn canonical_real_connections_serialize_negative_create_race() {
+    let path = path();
+    let c = database::open(&path).unwrap();
+    prepare_all(&c, SCOPE);
+    let a = application(&c, SCOPE, "", "fact", "a", fact("a", "Fact"), 'a');
+    let b = application(&c, SCOPE, "", "fact", "b", fact("b", "FACT"), 'b');
+    drop(c);
+    // Connection initialization is outside the race; the independent IMMEDIATE writes race.
+    // Timed channels keep a worker failure from stranding the entire test harness.
+    let connections = [
+        database::open(&path).unwrap(),
+        database::open(&path).unwrap(),
+    ];
+    let (ready_tx, ready_rx) = mpsc::channel();
+    let (done_tx, done_rx) = mpsc::channel();
+    let mut starts = Vec::new();
+    let handles = connections
+        .into_iter()
+        .zip([a, b])
+        .enumerate()
+        .map(|(worker, (c, request))| {
+            let (start_tx, start_rx) = mpsc::channel();
+            starts.push(start_tx);
+            let ready = ready_tx.clone();
+            let done = done_tx.clone();
+            std::thread::spawn(move || {
+                let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(
+                    || -> Result<Value, String> {
+                        ready
+                            .send(worker)
+                            .map_err(|e| format!("worker {worker} ready: {e}"))?;
+                        start_rx
+                            .recv_timeout(Duration::from_secs(5))
+                            .map_err(|e| format!("worker {worker} start: {e}"))?;
+                        let tx = rusqlite::Transaction::new_unchecked(
+                            &c,
+                            rusqlite::TransactionBehavior::Immediate,
+                        )
+                        .map_err(|e| format!("worker {worker} transaction: {e}"))?;
+                        match request::parse(request).and_then(|r| execute(&tx, r)) {
+                            Ok(value) => {
+                                tx.commit()
+                                    .map_err(|e| format!("worker {worker} commit: {e}"))?;
+                                Ok(value)
+                            }
+                            Err(cause) => Err(code(cause)),
+                        }
+                    },
+                ))
+                .unwrap_or_else(|_| Err(format!("worker {worker} panicked")));
+                done.send((worker, result))
+                    .expect("race completion receiver dropped");
+            })
+        })
+        .collect::<Vec<_>>();
+    drop(ready_tx);
+    drop(done_tx);
+    for _ in 0..2 {
+        ready_rx
+            .recv_timeout(Duration::from_secs(5))
+            .expect("race workers did not become ready");
+    }
+    for start in starts {
+        start.send(()).expect("race worker exited before start");
+    }
+    let results = (0..2)
+        .map(|_| {
+            done_rx
+                .recv_timeout(Duration::from_secs(15))
+                .expect("race worker did not complete")
+                .1
+        })
+        .collect::<Vec<_>>();
+    let deadline = Instant::now() + Duration::from_secs(5);
+    while handles.iter().any(|h| !h.is_finished()) && Instant::now() < deadline {
+        std::thread::sleep(Duration::from_millis(1));
+    }
+    assert!(
+        handles.iter().all(|h| h.is_finished()),
+        "race workers did not terminate"
+    );
+    for handle in handles {
+        handle.join().expect("race worker failed after completion");
+    }
+    assert_eq!(results.iter().filter(|r| r.is_ok()).count(), 1);
+    assert_eq!(
+        results
+            .iter()
+            .filter(|r| r.as_ref().err().map(String::as_str) == Some("STATE_TX_CONFLICT"))
+            .count(),
+        1
+    );
+    let c = database::open(&path).unwrap();
+    assert_eq!(
+        c.query_row(
+            "SELECT COUNT(*) FROM state_rows WHERE scope=?1 AND value IS NOT NULL",
+            [SCOPE],
+            |r| r.get::<_, i64>(0)
+        )
+        .unwrap(),
+        1
+    );
+}
