@@ -0,0 +1,73 @@
+use super::super::protocol;
+use super::source::kind;
+use rusqlite::{Connection, params};
+use serde_json::Value;
+
+pub fn lexical_text(
+    connection: &Connection,
+    id: &str,
+    value: &Value,
+) -> anyhow::Result<Option<String>> {
+    if kind(connection, id)?.is_none() {
+        return value
+            .get("text")
+            .map(|v| {
+                v.as_str()
+                    .map(str::to_owned)
+                    .ok_or_else(|| protocol::error("STATE_TX_INVALID_REQUEST"))
+            })
+            .transpose();
+    }
+    let scope = value["sourceScope"]
+        .as_str()
+        .ok_or_else(|| protocol::error("STATE_TX_INVALID_REQUEST"))?;
+    let key = value["id"]
+        .as_str()
+        .ok_or_else(|| protocol::error("STATE_TX_INVALID_REQUEST"))?;
+    let projection = "json_object('title',json_extract(state_value,'$.title'),'subtitle',json_extract(state_value,'$.subtitle'),'narrative',json_extract(state_value,'$.narrative'),'content',json_extract(state_value,'$.content'),'facts',json_extract(state_value,'$.facts'),'concepts',json_extract(state_value,'$.concepts'),'files',json_extract(state_value,'$.files'))";
+    let sql = format!(
+        "WITH source_row AS MATERIALIZED (SELECT state_json(value,value_bytes) AS state_value FROM state_rows WHERE scope=?1 AND key=?2 AND value IS NOT NULL) SELECT length(CAST({projection} AS BLOB)),{projection} FROM source_row"
+    );
+    let mut statement = connection.prepare(&sql)?;
+    let mut rows = statement.query(params![scope, key])?;
+    let row = rows
+        .next()?
+        .ok_or_else(|| protocol::error("STATE_SEMANTIC_SOURCE_STALE"))?;
+    if row.get::<_, i64>(0)? > 1_048_576 {
+        return Err(super::request::resource());
+    }
+    let raw: String = row.get(1)?;
+    let document: Value = serde_json::from_str(&raw)?;
+    let fields: &[&str] = if scope == "mem:memories" {
+        &["title", "content", "concepts", "files"]
+    } else {
+        &[
+            "title",
+            "subtitle",
+            "narrative",
+            "facts",
+            "concepts",
+            "files",
+        ]
+    };
+    let mut terms = Vec::new();
+    for field in fields {
+        match &document[field] {
+            Value::Null => {}
+            Value::String(text) => terms.push(text.as_str()),
+            Value::Array(values) => {
+                for value in values {
+                    terms.push(
+                        value
+                            .as_str()
+                            .ok_or_else(|| protocol::error("STATE_TX_INVALID_REQUEST"))?,
+                    );
+                }
+            }
+            _ => return Err(protocol::error("STATE_TX_INVALID_REQUEST")),
+        }
+    }
+    let text = terms.join(" ");
+    protocol::require(!text.trim().is_empty())?;
+    Ok(Some(text))
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/source_prepare.rs b/engine/src/workers/state/adapters/sqlite/retrieval/source_prepare.rs
