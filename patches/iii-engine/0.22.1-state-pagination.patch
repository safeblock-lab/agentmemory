+    let retained=protocol::strict_value(&retained)?;
+    if !["capture","source_digest","selection","progress","pages","reference"].iter().all(|key|retained[*key]==proof[*key]) {
+        return Ok(Outcome::Deferred("GRAPH_AUTOMATIC_SOURCE_CHANGED"));
+    }
+    if let Some(reason)=terminal::history(c,anchor,root.original_intent.as_ref())? {return Ok(Outcome::Deferred(reason));}
+    if trusted.is_none() {
+        match path.map(authority::Trusted::read).transpose() {Ok(Some(value))=>*trusted=Some(value),_=>return Ok(Outcome::Deferred("GRAPH_AUTOMATIC_ADOPTION_AUTHORITY_UNPROVEN"))}
+    }
+    let (authority_id,request_digest)=match trusted.as_ref().ok_or_else(||error("STATE_GRAPH_AUTOMATIC_AUTHORITY_UNAVAILABLE"))?.authorize_terminal(c,anchor,job) {
+        Ok(value)=>value,Err(_)=>return Ok(Outcome::Deferred("GRAPH_AUTOMATIC_ADOPTION_AUTHORITY_UNPROVEN")),
+    };
+    if let Some(reason)=wait(c,now)? {return Ok(Outcome::Deferred(reason));}
+    let epoch=latest(c,&id)?.map_or(0,|record|record.0).checked_add(1).filter(|epoch|*epoch<=9_007_199_254_740_990).ok_or_else(||error("STATE_GRAPH_AUTOMATIC_COUNTER_EXHAUSTED"))?;
+    let deadline=now.checked_add(120_000).filter(|deadline|*deadline<=9_007_199_254_740_991).ok_or_else(||error("STATE_GRAPH_AUTOMATIC_CLOCK_INVALID"))?;
+    let token=format!("{id}:regen:1:e{epoch}");
+    need(super::wire::id(&token,128),"STATE_GRAPH_AUTOMATIC_COUNTER_EXHAUSTED")?;
+    let total:i64=c.query_row("SELECT total_admitted FROM engine_graph_auto_policy WHERE singleton=1",[],|r|r.get(0))?;
+    need(total<9_007_199_254_740_990,"STATE_GRAPH_AUTOMATIC_COUNTER_EXHAUSTED")?;
