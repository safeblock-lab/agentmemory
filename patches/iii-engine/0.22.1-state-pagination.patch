@@ -0,0 +1,85 @@
+use anyhow::{Context, ensure};
+use rusqlite::Connection;
+
+pub(super) fn target_checks(connection: &Connection) -> anyhow::Result<()> {
+    let started = std::time::Instant::now();
+    let result: String = connection
+        .query_row("PRAGMA quick_check", [], |row| row.get(0))
+        .context("Shadow structural verification failed")?;
+    ensure!(result == "ok", "Shadow quick_check failed: {result}");
+    eprintln!(
+        "shadow verification target_quick_check_seconds={:.3}",
+        started.elapsed().as_secs_f64()
+    );
+    let started = std::time::Instant::now();
+    ensure!(
+        connection
+            .prepare("PRAGMA foreign_key_check")?
+            .query([])?
+            .next()?
+            .is_none(),
+        "Shadow foreign key check failed"
+    );
+    eprintln!(
+        "shadow verification target_foreign_keys_seconds={:.3}",
+        started.elapsed().as_secs_f64()
+    );
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn quick_checks_preserve_valid_rows_and_reject_foreign_key_orphans() {
+        let connection = Connection::open_in_memory().unwrap();
+        connection.execute_batch("PRAGMA foreign_keys=OFF; CREATE TABLE parent(id INTEGER PRIMARY KEY); CREATE TABLE child(id INTEGER REFERENCES parent(id)); INSERT INTO parent VALUES(1); INSERT INTO child VALUES(1)").unwrap();
+        target_checks(&connection).unwrap();
+        assert_eq!(
+            connection
+                .query_row("SELECT id FROM child", [], |row| row.get::<_, i64>(0))
+                .unwrap(),
+            1
+        );
+        connection
+            .execute("INSERT INTO child VALUES(2)", [])
+            .unwrap();
+        assert!(format!("{:#}", target_checks(&connection).unwrap_err()).contains("foreign key"));
+        assert_eq!(
+            connection
+                .query_row("SELECT count(*) FROM child", [], |row| row.get::<_, i64>(0))
+                .unwrap(),
+            2
+        );
+    }
+    #[test]
+    fn quick_checks_reject_corrupt_btree_before_acceptance() {
+        use std::io::{Seek, SeekFrom, Write};
+        let directory = tempfile::Builder::new()
+            .prefix("verification-small-")
+            .tempdir()
+            .unwrap();
+        let path = directory.path().join("target.sqlite3");
+        let connection = Connection::open(&path).unwrap();
+        connection.execute_batch("CREATE TABLE data(key TEXT PRIMARY KEY,value BLOB) WITHOUT ROWID; INSERT INTO data VALUES('key',X'31')").unwrap();
+        let page: i64 = connection
+            .query_row(
+                "SELECT rootpage FROM sqlite_master WHERE name='data'",
+                [],
+                |row| row.get(0),
+            )
+            .unwrap();
+        let page_size: i64 = connection
+            .query_row("PRAGMA page_size", [], |row| row.get(0))
+            .unwrap();
+        drop(connection);
+        let mut file = std::fs::OpenOptions::new().write(true).open(&path).unwrap();
+        file.seek(SeekFrom::Start(((page - 1) * page_size + 5) as u64))
+            .unwrap();
+        file.write_all(&[255, 255]).unwrap();
+        file.sync_all().unwrap();
+        drop(file);
+        let connection = Connection::open(&path).unwrap();
+        assert!(target_checks(&connection).is_err());
+    }
+}
diff --git a/engine/src/state_migration/sqlite_wal.rs b/engine/src/state_migration/sqlite_wal.rs
new file mode 100644
index 0000000..913c40e
--- /dev/null
+++ b/engine/src/state_migration/sqlite_wal.rs
@@ -0,0 +1,63 @@
+use anyhow::{Context, ensure};
+use rusqlite::Connection;
+use std::{fs, path::Path};
+
+pub(super) fn bytes(target: &Path) -> anyhow::Result<u64> {
+    let mut path = target.as_os_str().to_owned();
+    path.push("-wal");
+    match fs::metadata(Path::new(&path)) {
+        Ok(metadata) => Ok(metadata.len()),
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => Ok(0),
+        Err(error) => Err(error).context("Cannot measure shadow migration WAL"),
+    }
+}
+
+pub(super) fn checkpoint(output: &Connection) -> anyhow::Result<()> {
+    let (busy, log, copied): (i64, i64, i64) =
+        output.query_row("PRAGMA main.wal_checkpoint(TRUNCATE)", [], |row| {
+            Ok((row.get(0)?, row.get(1)?, row.get(2)?))
+        })?;
+    ensure!(
+        busy == 0 && log == copied,
+        "Shadow checkpoint blocked: busy={busy}, log={log}, copied={copied}; close shadow readers and resume pending target"
+    );
+    Ok(())
+}
+
+pub(super) fn pending_normal(output: &Connection) -> anyhow::Result<()> {
+    for table in ["state_migration", "shadow_transfer"] {
+        let status: String = output.query_row(
+            &format!("SELECT status FROM {table} WHERE id=1"),
+            [],
+            |row| row.get(0),
+        )?;
+        ensure!(
+            status == "pending",
+            "Bulk migration requires pending fences"
+        );
+    }
+    output.execute_batch("PRAGMA main.synchronous=NORMAL; PRAGMA main.wal_autocheckpoint=0;")?;
+    Ok(())
+}
+
+pub(super) fn after_commit(
+    output: &Connection,
+    target: &Path,
+    finish: bool,
+) -> anyhow::Result<u64> {
+    let wal = bytes(target)?;
+    ensure!(
+        wal <= 512 * 1024 * 1024,
+        "Shadow WAL exceeds 512 MiB operational bound after committed shadow transaction: {wal} bytes; target remains pending and resumable"
+    );
+    if finish || wal >= 256 * 1024 * 1024 {
+        checkpoint(output)?;
+    }
+    Ok(wal)
+}
+
+pub(super) fn full(output: &Connection) -> anyhow::Result<()> {
+    // NORMAL is restricted to reconstructible pending data. Persist it before changing any ready fence.
+    output.execute_batch("PRAGMA main.synchronous=FULL; PRAGMA main.wal_autocheckpoint=1024;")?;
+    checkpoint(output)
+}
