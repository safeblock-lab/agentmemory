index 0000000..ff48673
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/source_prepare.rs
@@ -0,0 +1,156 @@
+use super::super::{database, protocol};
+use super::{eligibility, source};
+use rusqlite::{Connection, OptionalExtension, params};
+use serde_json::{Value, json};
+
+fn dirty_page(
+    connection: &Connection,
+    id: &str,
+    max_rows: usize,
+    max_bytes: usize,
+) -> anyhow::Result<Value> {
+    let mut statement=connection.prepare("SELECT scope,key,version FROM retrieval_source_items INDEXED BY retrieval_source_items_dirty WHERE index_id=?1 AND dirty=1 ORDER BY scope,key LIMIT ?2")?;
+    let mut rows = statement.query(params![id, max_rows as i64])?;
+    let mut items = Vec::new();
+    let mut bytes = 512usize;
+    while let Some(row) = rows.next()? {
+        let item = json!({"source_scope":row.get::<_,String>(0)?,"id":row.get::<_,String>(1)?,"source_version":row.get::<_,String>(2)?});
+        let needed = protocol::size(&item)? + 1;
+        if bytes + needed > max_bytes {
+            if items.is_empty() {
+                return Err(super::request::resource());
+            }
+            break;
+        }
+        items.push(item);
+        bytes += needed;
+    }
+    source::decorate(
+        connection,
+        id,
+        json!({"processed":0,"scope":"","cursor":"-1","items":items}),
+    )
+}
+
+pub fn prepare(
+    connection: &Connection,
+    id: &str,
+    max_rows: usize,
+    max_bytes: usize,
+) -> anyhow::Result<Value> {
+    protocol::require(source::kind(connection, id)?.is_some())?;
+    let (mut scope,mut cursor,mut phase,mut cleanup): (String,i64,String,String)=connection.query_row("SELECT current_scope,cursor,phase,cleanup_cursor FROM retrieval_source_meta WHERE index_id=?1",[id],|r|Ok((r.get(0)?,r.get(1)?,r.get(2)?,r.get(3)?)))?;
+    if scope.is_empty() {
+        if let Some((next, _)) = source::pending_scope(connection, id)? {
+            scope = next;
+            cursor = -1;
+            phase = "rows".into();
+            cleanup.clear();
+        } else {
+            return dirty_page(connection, id, max_rows, max_bytes);
+        }
+    }
+    let revision = database::revision(connection, &scope)?.to_string();
+    let saved: Option<String> = connection
+        .query_row(
+            "SELECT revision FROM retrieval_source_scopes WHERE index_id=?1 AND scope=?2",
+            params![id, scope],
+            |r| r.get(0),
+        )
+        .optional()?;
+    if saved.as_deref() != Some(&revision) {
+        cursor = -1;
+        phase = "rows".into();
+        cleanup.clear();
+    }
+    connection.execute("INSERT INTO retrieval_source_scopes VALUES(?1,?2,?3,0) ON CONFLICT(index_id,scope) DO UPDATE SET revision=excluded.revision,prepared=0",params![id,scope,revision])?;
+    let mut processed = 0usize;
+    let mut bytes = 512usize;
+    let mut items = Vec::new();
+    let mut complete = true;
+    if phase == "rows" {
+        let sql = format!(
+            "WITH indexed_rows AS MATERIALIZED (SELECT scope,key,position,version,state_json(value,value_bytes) AS state_value FROM state_rows INDEXED BY state_rows_order WHERE scope=?1 AND value IS NOT NULL AND position>?2 ORDER BY position LIMIT ?3) SELECT key,position,version,{} FROM indexed_rows ORDER BY position",
+            eligibility::SQL
+        );
+        let mut statement = connection.prepare(&sql)?;
+        let mut rows = statement.query(params![scope, cursor, (max_rows + 1) as i64])?;
+        while let Some(row) = rows.next()? {
+            if processed == max_rows {
+                complete = false;
+                break;
+            }
+            let key: String = row.get(0)?;
+            let version: String = row.get(2)?;
+            let item = json!({"source_scope":scope,"id":key,"source_version":version});
+            let needed = protocol::size(&item)? + 1;
+            if bytes + needed > max_bytes {
+                if processed == 0 {
+                    return Err(super::request::resource());
+                }
+                complete = false;
+                break;
+            }
+            if !row.get::<_, bool>(3)? {
+                source::remove(connection, id, &scope, &key)?;
+            } else {
+                let previous: Option<(String,bool)>=connection.query_row("SELECT version,dirty FROM retrieval_source_items WHERE index_id=?1 AND scope=?2 AND key=?3",params![id,scope,key],|r|Ok((r.get(0)?,r.get(1)?))).optional()?;
+                let dirty = previous.is_none_or(|(saved, dirty)| saved != version || dirty);
+                source::touch(connection, id, &scope, &key, &version, dirty)?;
+                if dirty {
+                    items.push(item);
+                }
+            }
+            cursor = row.get(1)?;
+            processed += 1;
+            bytes += needed;
+        }
+        if complete {
+            phase = "cleanup".into();
+            complete = false;
+        }
+    } else {
+        let mut statement=connection.prepare("SELECT key FROM retrieval_source_items WHERE index_id=?1 AND scope=?2 AND key>?3 ORDER BY key LIMIT ?4")?;
+        let mut rows = statement.query(params![id, scope, cleanup, (max_rows + 1) as i64])?;
+        while let Some(row) = rows.next()? {
+            if processed == max_rows {
+                complete = false;
+                break;
+            }
+            let key: String = row.get(0)?;
+            let needed = key.len() + 64;
+            if bytes + needed > max_bytes {
+                if processed == 0 {
+                    return Err(super::request::resource());
+                }
+                complete = false;
+                break;
+            }
+            let sql = format!(
+                "WITH current_row AS MATERIALIZED (SELECT scope,state_json(value,value_bytes) AS state_value FROM state_rows WHERE scope=?1 AND key=?2 AND value IS NOT NULL) SELECT EXISTS(SELECT 1 FROM current_row WHERE {})",
+                eligibility::SQL
+            );
+            let eligible: bool = connection.query_row(&sql, params![scope, key], |r| r.get(0))?;
+            if !eligible {
+                source::remove(connection, id, &scope, &key)?;
+            }
+            cleanup = key;
+            processed += 1;
+            bytes += needed;
+        }
+    }
+    let response_scope = scope.clone();
+    if complete {
+        connection.execute("UPDATE retrieval_source_scopes SET prepared=1,revision=?3 WHERE index_id=?1 AND scope=?2",params![id,scope,revision])?;
+        scope.clear();
+        cursor = -1;
+        phase = "rows".into();
+        cleanup.clear();
+    }
+    connection.execute("UPDATE retrieval_source_meta SET current_scope=?2,cursor=?3,phase=?4,cleanup_cursor=?5 WHERE index_id=?1",params![id,scope,cursor,phase,cleanup])?;
+    source::decorate(
+        connection,
+        id,
+        json!({"processed":processed,"scope":response_scope,"cursor":cursor.to_string(),"items":items}),
+    )
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/source_write.rs b/engine/src/workers/state/adapters/sqlite/retrieval/source_write.rs
new file mode 100644
index 0000000..e8f9756
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/source_write.rs
@@ -0,0 +1,74 @@
+use super::super::{database, protocol};
+use super::{
+    eligibility,
+    source::{item, remove, touch, tracked_scope},
+};
+use rusqlite::{Connection, OptionalExtension, params};
+use serde_json::Value;
+
+pub fn changed(
+    connection: &Connection,
+    scope: &str,
+    key: &str,
+    old: &database::Row,
+    value: Option<&Value>,
+    version: u64,
+) -> anyhow::Result<()> {
+    if !tracked_scope(scope) {
+        return Ok(());
+    }
+    let mut statement =
+        connection.prepare("SELECT index_id FROM retrieval_source_meta ORDER BY index_id")?;
+    let ids = statement
+        .query_map([], |r| r.get::<_, String>(0))?
+        .collect::<rusqlite::Result<Vec<_>>>()?;
+    let revision = database::revision(connection, scope)?;
+    for id in ids {
+        let previous: Option<(String,bool)>=connection.query_row("SELECT revision,prepared FROM retrieval_source_scopes WHERE index_id=?1 AND scope=?2",params![id,scope],|r|Ok((r.get(0)?,r.get(1)?))).optional()?;
+        let continuous = previous.as_ref().is_some_and(|(saved, _)| {
+            protocol::counter(saved).ok().and_then(|v| v.checked_add(1)) == Some(revision)
+        });
+        let prepared = if continuous {
+            previous.as_ref().is_some_and(|(_, ready)| *ready)
+        } else {
+            revision == 1
+        };
+        if !continuous {
+            connection.execute("UPDATE retrieval_source_meta SET cursor=-1,phase='rows',cleanup_cursor='' WHERE index_id=?1 AND current_scope=?2",params![id,scope])?;
+        }
+        connection.execute("INSERT INTO retrieval_source_scopes VALUES(?1,?2,?3,?4) ON CONFLICT(index_id,scope) DO UPDATE SET revision=excluded.revision,prepared=excluded.prepared",params![id,scope,revision.to_string(),prepared])?;
+        if !eligibility::value(scope, value) {
+            remove(connection, &id, scope, key)?;
+            continue;
+        }
+        let previous = item(connection, &id, scope, key)?;
+        let unchanged = previous
+            .as_ref()
+            .is_some_and(|(saved, dirty)| !dirty && saved == &old.version.to_string())
+            && [
+                "title",
+                "subtitle",
+                "narrative",
+                "content",
+                "facts",
+                "concepts",
+                "files",
+                "sessionId",
+                "sessionIds",
+                "isLatest",
+            ]
+            .iter()
+            .all(|field| {
+                old.value.as_ref().and_then(|v| v.get(field)) == value.and_then(|v| v.get(field))
+            });
+        touch(
+            connection,
+            &id,
+            scope,
+            key,
+            &version.to_string(),
+            !unchanged,
+        )?;
+    }
+    Ok(())
+}
diff --git a/engine/src/workers/state/adapters/sqlite/retrieval/tests.rs b/engine/src/workers/state/adapters/sqlite/retrieval/tests.rs
