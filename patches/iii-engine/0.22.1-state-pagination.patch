diff --git a/engine/src/state_migration/sqlite_tables.rs b/engine/src/state_migration/sqlite_tables.rs
new file mode 100644
index 0000000..18826ed
--- /dev/null
+++ b/engine/src/state_migration/sqlite_tables.rs
@@ -0,0 +1,236 @@
+pub(super) use super::sqlite_values::{cursor, logical_row, parse_cursor, quote};
+use crate::workers::state::adapters::sqlite::codec;
+use rusqlite::{Connection, OptionalExtension, params, types::Value};
+use std::collections::BTreeMap;
+
+#[derive(Clone, Debug)]
+pub(super) struct Table {
+    pub name: String,
+    pub columns: Vec<String>,
+    pub keys: Vec<usize>,
+}
+
+pub(super) fn tables(connection: &Connection, reverse: bool) -> anyhow::Result<Vec<Table>> {
+    let mut statement = connection.prepare("SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%' AND name NOT IN ('shadow_transfer','shadow_transfer_progress','retrieval_lexical') ORDER BY name")?;
+    let names = statement
+        .query_map([], |r| r.get::<_, String>(0))?
+        .collect::<rusqlite::Result<Vec<_>>>()?;
+    let mut result = Vec::new();
+    for name in names {
+        if reverse && name == "retrieval_identifiers" {
+            continue;
+        }
+        let mut statement = connection.prepare(&format!("PRAGMA table_info({})", quote(&name)))?;
+        let info = statement
+            .query_map([], |r| Ok((r.get::<_, String>(1)?, r.get::<_, i64>(5)?)))?
+            .collect::<rusqlite::Result<Vec<_>>>()?;
+        let mut keys: Vec<_> = info
+            .iter()
+            .enumerate()
+            .filter(|(_, (_, pk))| *pk > 0)
+            .map(|(i, (_, pk))| (*pk, i))
+            .collect();
+        keys.sort();
+        let mut columns: Vec<_> = info.into_iter().map(|(name, _)| name).collect();
+        let keys = if keys.is_empty() {
+            columns.insert(0, "rowid".into());
+            vec![0]
+        } else {
+            keys.into_iter().map(|(_, i)| i).collect()
+        };
+        result.push(Table {
+            name,
+            columns,
+            keys,
+        });
+    }
+    Ok(result)
+}
+
+impl Table {
+    pub fn projection(&self) -> String {
+        self.columns
+            .iter()
+            .map(|s| quote(s))
+            .collect::<Vec<_>>()
+            .join(",")
+    }
+    pub fn ordering(&self) -> String {
+        self.keys
+            .iter()
+            .map(|i| quote(&self.columns[*i]))
+            .collect::<Vec<_>>()
+            .join(",")
+    }
+    pub fn select(&self, reverse: bool, after: bool) -> String {
+        let body = if self.name == "retrieval_membership" && reverse {
+            "(SELECT o.epoch,o.value AS observation,k.value AS key,m.position FROM retrieval_identifiers o CROSS JOIN retrieval_membership m ON m.epoch=o.epoch AND m.observation=o.id CROSS JOIN retrieval_identifiers k ON k.epoch=m.epoch AND k.id=m.key)".into()
+        } else {
+            quote(&self.name)
+        };
+        let where_clause = if after {
+            format!(
+                " WHERE ({}) > ({})",
+                self.ordering(),
+                self.keys.iter().map(|_| "?").collect::<Vec<_>>().join(",")
+            )
+        } else {
+            String::new()
+        };
+        format!(
+            "SELECT {} FROM {}{} ORDER BY {}",
+            self.projection(),
+            body,
+            where_clause,
+            self.ordering()
+        )
+    }
+}
+
+pub(super) struct Writer {
+    identifiers: BTreeMap<(i64, String), i64>,
+    decoded: BTreeMap<(i64, i64), String>,
+    identifier_bytes: usize,
+    decoded_bytes: usize,
+}
+impl Writer {
+    pub fn new() -> Self {
+        Self {
+            identifiers: BTreeMap::new(),
+            decoded: BTreeMap::new(),
+            identifier_bytes: 0,
+            decoded_bytes: 0,
+        }
+    }
+    fn identifier(
+        &mut self,
+        connection: &Connection,
+        epoch: i64,
+        value: &str,
+    ) -> anyhow::Result<i64> {
+        let key = (epoch, value.to_owned());
+        if let Some(id) = self.identifiers.get(&key) {
+            return Ok(*id);
+        }
+        connection
+            .prepare_cached(
+                "INSERT OR IGNORE INTO retrieval_identifiers(epoch,value) VALUES(?1,?2)",
+            )?
+            .execute(params![epoch, value])?;
+        let id = connection
+            .prepare_cached("SELECT id FROM retrieval_identifiers WHERE epoch=?1 AND value=?2")?
+            .query_row(params![epoch, value], |r| r.get(0))?;
+        if self.identifiers.len() >= 16384
+            || self.identifier_bytes.saturating_add(value.len()) > 8 * 1024 * 1024
+        {
+            self.identifiers.clear();
+            self.identifier_bytes = 0;
+        }
+        if value.len() <= 8 * 1024 * 1024 {
+            self.identifier_bytes += value.len();
+            self.identifiers.insert(key, id);
+        }
+        Ok(id)
+    }
+    pub fn write(
+        &mut self,
+        input: &Connection,
+        connection: &Connection,
+        table: &Table,
+        row: Vec<Value>,
+        reverse: bool,
+    ) -> anyhow::Result<()> {
+        let mut row = logical_row(table, row, reverse)?;
+        if table.name == "state_migration" {
+            anyhow::ensure!(
+                table.columns == ["id", "manifest", "status"],
+                "Unexpected migration metadata columns"
+            );
+            anyhow::ensure!(
+                row[2] == Value::Text("ready".into()),
+                "Source migration metadata is incomplete"
+            );
+            row[2] = Value::Text("pending".into());
+        }
+        if table.name == "state_rows" && !reverse {
+            if let Value::Text(value) = &row[2] {
+                row[2] = Value::Blob(codec::encode(value)?);
+            }
+        }
+        if table.name == "retrieval_membership" && !reverse {
+            let epoch = match row[0] {
+                Value::Integer(v) => v,
+                _ => anyhow::bail!("Invalid membership epoch"),
+            };
+            for index in [1, 2] {
+                let Value::Text(value) = &row[index] else {
+                    anyhow::bail!("Invalid V1 membership identifier")
+                };
+                row[index] = Value::Integer(self.identifier(connection, epoch, value)?);
+            }
+        }
+        if table.name == "retrieval_membership" && reverse {
+            let epoch = match row[0] {
+                Value::Integer(v) => v,
+                _ => anyhow::bail!("Invalid membership epoch"),
+            };
+            for index in [1, 2] {
+                let Value::Integer(id) = row[index] else {
+                    anyhow::bail!("Invalid V2 membership identifier")
+                };
+                let value = match self.decoded.get(&(epoch, id)) {
+                    Some(value) => value.clone(),
+                    None => {
+                        let value: String = input
+                            .prepare_cached(
+                                "SELECT value FROM retrieval_identifiers WHERE epoch=?1 AND id=?2",
+                            )?
+                            .query_row(params![epoch, id], |r| r.get(0))?;
+                        if self.decoded.len() >= 16384
+                            || self.decoded_bytes.saturating_add(value.len()) > 8 * 1024 * 1024
+                        {
+                            self.decoded.clear();
+                            self.decoded_bytes = 0;
+                        }
+                        if value.len() <= 8 * 1024 * 1024 {
+                            self.decoded_bytes += value.len();
+                            self.decoded.insert((epoch, id), value.clone());
+                        }
+                        value
+                    }
+                };
+                row[index] = Value::Text(value);
+            }
+        }
+        let sql = format!(
+            "INSERT {} INTO {}({}) VALUES({})",
+            if table.name == "state_migration" {
+                "OR REPLACE"
+            } else {
+                ""
+            },
+            quote(&table.name),
+            table.projection(),
+            row.iter().map(|_| "?").collect::<Vec<_>>().join(",")
+        );
+        connection
+            .prepare_cached(&sql)?
+            .execute(rusqlite::params_from_iter(row))?;
+        Ok(())
+    }
+}
+
+pub(super) fn checkpoint(
+    connection: &Connection,
+    name: &str,
+) -> anyhow::Result<(String, u64, bool)> {
+    let (cursor, count, complete): (String, i64, bool) = connection
+        .query_row(
+            "SELECT cursor,count,complete FROM shadow_transfer_progress WHERE name=?1",
+            [name],
+            |r| Ok((r.get(0)?, r.get(1)?, r.get(2)?)),
+        )
+        .optional()?
+        .unwrap_or(("[]".into(), 0, false));
+    Ok((cursor, u64::try_from(count)?, complete))
+}
