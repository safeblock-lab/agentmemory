@@ -0,0 +1,484 @@
+use super::common::*;
+use rusqlite::{params, Connection, OptionalExtension};
+use serde_json::{json, Value};
+use std::collections::BTreeMap;
+
+const EXTRA: i64 = 1;
+
+fn current_edges(
+    connection: &Connection,
+    context: &Context,
+    project: &str,
+    nodes: &[String],
+    edge_ids: &[String],
+    after: i64,
+    page: usize,
+) -> anyhow::Result<(BTreeMap<String, (i64, String, String)>, bool)> {
+    let source_scope = node_project_predicate("e.source", context.summary_authority_ready);
+    let target_scope = node_project_predicate("e.target", context.summary_authority_ready);
+    let mut selected = BTreeMap::new();
+    let mut more = false;
+    for node in nodes {
+        for (column, index) in [
+            ("source", "retrieval_edges_source"),
+            ("target", "retrieval_edges_target"),
+        ] {
+            let sql = format!(
+                "SELECT e.key,e.position,e.source,e.target FROM retrieval_edges e INDEXED BY {index} WHERE e.epoch=?4 AND e.{column}=?5 AND e.position>?6 AND {source_scope} AND {target_scope} ORDER BY e.position LIMIT ?7"
+            );
+            let mut statement = connection.prepare_cached(&sql)?;
+            let mut rows = statement.query(params![
+                context.node_epoch,
+                context.vector_epoch,
+                project,
+                context.edge_epoch,
+                node,
+                after,
+                (page + EXTRA as usize) as i64
+            ])?;
+            let mut count = 0;
+            while let Some(row) = rows.next()? {
+                count += 1;
+                let key: String = row.get(0)?;
+                let position: i64 = row.get(1)?;
+                let source: String = row.get(2)?;
+                let target: String = row.get(3)?;
+                selected.entry(key).or_insert((position, source, target));
+            }
+            more |= count > page;
+        }
+    }
+    for key in edge_ids {
+        let sql = format!(
+            "SELECT e.key,e.position,e.source,e.target FROM retrieval_edges e WHERE e.epoch=?4 AND e.key=?5 AND e.position>?6 AND {source_scope} AND {target_scope}"
+        );
+        let row: Option<(String, i64, String, String)> = connection
+            .query_row(
+                &sql,
+                params![
+                    context.node_epoch,
+                    context.vector_epoch,
+                    project,
+                    context.edge_epoch,
+                    key,
+                    after
+                ],
+                |row| Ok((row.get(0)?, row.get(1)?, row.get(2)?, row.get(3)?)),
+            )
+            .optional()?;
+        if let Some((key, position, source, target)) = row {
+            selected.entry(key).or_insert((position, source, target));
+        }
+    }
+    Ok((selected, more))
+}
+
+fn partial_result(
+    project: &str,
+    context: &Context,
+    reason: &str,
+    items: Vec<Value>,
+    _after: Option<i64>,
+) -> Value {
+    with_projection_status(
+        json!({"status":"partial","reason":reason,"project":project,"items":items,"has_more":false,"next_cursor":null,"revision":{"nodes":context.node_revision,"edges":context.edge_revision,"vectors":context.vector_revision}}),
+        context,
+    )
+}
+
+fn edge_item(
+    connection: &Connection,
+    key: &str,
+    position: i64,
+    remaining: usize,
+) -> anyhow::Result<Result<Value, &'static str>> {
+    match load_row(connection, EDGES, key, remaining)? {
+        RowLoad::Value(value)
+            if value["id"].as_str() == Some(key) && value["stale"] != Value::Bool(true) =>
+        {
+            Ok(Ok(
+                json!({"key":key,"id":key,"position":position.to_string(),"value":value}),
+            ))
+        }
+        RowLoad::Value(_) => Ok(Err("graph_index_stale")),
+        RowLoad::Missing | RowLoad::Stale => Ok(Err("graph_row_missing")),
+        RowLoad::Oversized => Ok(Err("graph_row_too_large")),
+        RowLoad::Invalid => Ok(Err("graph_row_invalid")),
+    }
+}
+
+pub(super) fn neighbors(
+    connection: &Connection,
+    project: &str,
+    node_ids: &[String],
+    cursor: Option<&str>,
+    limit: usize,
+    max_bytes: usize,
+) -> anyhow::Result<Value> {
+    check_bounds(limit, max_bytes)?;
+    let context = match ready_context(connection, project)? {
+        Ok(context) => context,
+        Err(page) => return Ok(page),
+    };
+    let hash = selector_hash(&json!({"mode":"neighbors","project":project,"node_ids":node_ids}))?;
+    let after = cursor_position(cursor, &hash, &context)?;
+    let (selected, mut more) =
+        current_edges(connection, &context, project, node_ids, &[], after, limit)?;
+    let mut ordered = selected.into_iter().collect::<Vec<_>>();
+    ordered.sort_by_key(|(_, (position, _, _))| *position);
+    if ordered.len() > limit {
+        more = true;
+        ordered.truncate(limit);
+    }
+    let mut items = Vec::new();
+    let mut bytes = 256usize;
+    let mut last = None;
+    for (key, (position, _, _)) in ordered {
+        match edge_item(connection, &key, position, max_bytes.saturating_sub(bytes))? {
+            Ok(item) => {
+                let item_bytes = item_bytes(&item)?.saturating_add(1);
+                if bytes.saturating_add(item_bytes) > max_bytes {
+                    more = true;
+                    break;
+                }
+                bytes += item_bytes;
+                last = Some(position);
+                items.push(item);
+            }
+            Err(reason) => return Ok(partial_result(project, &context, reason, items, last)),
+        }
+    }
+    let next = if more {
+        last.map(|position| next_cursor(&hash, &context, position))
+    } else {
+        None
+    };
+    Ok(with_projection_status(
+        json!({"status":if context.authority_incomplete{"partial"}else{"ready"},"reason":if context.authority_incomplete{Some("project_authority_incomplete")}else{None},"project":project,"items":items,"has_more":more,"next_cursor":next,"revision":{"nodes":context.node_revision,"edges":context.edge_revision,"vectors":context.vector_revision}}),
+        &context,
+    ))
+}
+
+fn timestamp(value: &Value, primary: &str, fallback: Option<&str>) -> Option<i64> {
+    let text = value
+        .get(primary)
+        .and_then(Value::as_str)
+        .or_else(|| fallback.and_then(|field| value.get(field).and_then(Value::as_str)))?;
+    chrono::DateTime::parse_from_rfc3339(text)
+        .ok()
+        .map(|date| date.timestamp_millis())
+}
+
+fn in_time(value: &Value, from: i64, through: i64) -> Result<bool, ()> {
+    let start = timestamp(value, "tvalid", Some("createdAt")).ok_or(())?;
+    let end = match value.get("tvalidEnd") {
+        None | Some(Value::Null) => None,
+        Some(Value::String(text)) if text == "current" => None,
+        Some(Value::String(text)) => Some(
+            chrono::DateTime::parse_from_rfc3339(text)
+                .map_err(|_| ())?
+                .timestamp_millis(),
+        ),
+        _ => return Err(()),
+    };
+    Ok(start <= through && end.is_none_or(|end| end >= from))
+}
+
+pub(super) fn time(
+    connection: &Connection,
+    project: &str,
+    nodes: &[String],
+    edge_ids: &[String],
+    from: &str,
+    through: &str,
+    cursor: Option<&str>,
+    limit: usize,
+    max_bytes: usize,
+) -> anyhow::Result<Value> {
+    let from = chrono::DateTime::parse_from_rfc3339(from)
+        .map_err(|_| super::super::request::resource())?
+        .timestamp_millis();
+    let through = chrono::DateTime::parse_from_rfc3339(through)
+        .map_err(|_| super::super::request::resource())?
+        .timestamp_millis();
+    check_bounds(limit, max_bytes)?;
+    let context = match ready_context(connection, project)? {
+        Ok(context) => context,
+        Err(page) => return Ok(page),
+    };
+    let hash = selector_hash(
+        &json!({"mode":"time","project":project,"node_ids":nodes,"edge_ids":edge_ids,"from":from,"through":through}),
+    )?;
+    let after = cursor_position(cursor, &hash, &context)?;
+    let (selected, mut more) =
+        current_edges(connection, &context, project, nodes, edge_ids, after, limit)?;
+    let mut ordered = selected.into_iter().collect::<Vec<_>>();
+    ordered.sort_by_key(|(_, (position, _, _))| *position);
+    let mut items = Vec::new();
+    let mut bytes = 256usize;
+    let mut last = None;
+    let mut scanned = None;
+    let mut unknown = false;
+    for (key, (position, _, _)) in ordered {
+        if items.len() >= limit {
+            more = true;
+            break;
+        }
+        scanned = Some(position);
+        match edge_item(connection, &key, position, max_bytes.saturating_sub(bytes))? {
+            Ok(item) => match in_time(&item["value"], from, through) {
+                Ok(true) => {
+                    let size = item_bytes(&item)?.saturating_add(1);
+                    if bytes.saturating_add(size) > max_bytes {
+                        more = true;
+                        break;
+                    }
+                    bytes += size;
+                    items.push(item);
+                    last = Some(position);
+                }
+                Ok(false) => {}
+                Err(()) => {
+                    unknown = true;
+                }
+            },
+            Err(reason) => return Ok(partial_result(project, &context, reason, items, last)),
+        }
+    }
+    let reason = if unknown {
+        Some("temporal_metadata_unavailable")
+    } else if context.authority_incomplete {
+        Some("project_authority_incomplete")
+    } else {
+        None
+    };
+    let next = if more {
+        last.or(scanned)
+            .map(|position| next_cursor(&hash, &context, position))
+    } else {
+        None
+    };
+    Ok(with_projection_status(
+        json!({"status":if reason.is_some(){"partial"}else{"ready"},"reason":reason,"project":project,"items":items,"has_more":more,"next_cursor":next,"revision":{"nodes":context.node_revision,"edges":context.edge_revision,"vectors":context.vector_revision}}),
+        &context,
+    ))
+}
+
+pub(super) fn history(
+    connection: &Connection,
+    project: &str,
+    edge_ids: &[String],
+    cursor: Option<&str>,
+    limit: usize,
+    max_bytes: usize,
+) -> anyhow::Result<Value> {
+    check_bounds(limit, max_bytes)?;
+    let context = match ready_context(connection, project)? {
+        Ok(context) => context,
+        Err(page) => return Ok(page),
+    };
+    let hash = selector_hash(&json!({"mode":"history","project":project,"edge_ids":edge_ids}))?;
+    let after = cursor_position(cursor, &hash, &context)?;
+    let (selected, _) = current_edges(connection, &context, project, &[], edge_ids, after, limit)?;
+    let mut ordered = selected.into_iter().collect::<Vec<_>>();
+    ordered.sort_by_key(|(_, (position, _, _))| *position);
+    let mut items = Vec::new();
+    let mut bytes = 256usize;
+    let mut more = false;
+    let mut last = None;
+    for (key, (position, _, _)) in ordered {
+        if items.len() >= limit {
+            more = true;
+            break;
+        }
+        match load_row(connection, HISTORY, &key, max_bytes.saturating_sub(bytes))? {
+            RowLoad::Value(value) => {
+                if !history_value_scoped(connection, &context, project, &value)? {
+                    return Ok(partial_result(
+                        project,
+                        &context,
+                        "history_provenance_unavailable",
+                        items,
+                        last,
+                    ));
+                }
+                let item =
+                    json!({"key":key,"id":key,"position":position.to_string(),"value":value});
+                let size = item_bytes(&item)?.saturating_add(1);
+                if bytes.saturating_add(size) > max_bytes {
+                    return Ok(partial_result(
+                        project,
+                        &context,
+                        "history_row_too_large",
+                        items,
+                        last,
+                    ));
+                }
+                bytes += size;
+                items.push(item);
+                last = Some(position);
+            }
+            RowLoad::Missing => {
+                return Ok(partial_result(
+                    project,
+                    &context,
+                    "history_unavailable",
+                    items,
+                    last,
+                ));
+            }
+            RowLoad::Oversized => {
+                return Ok(partial_result(
+                    project,
+                    &context,
+                    "history_row_too_large",
+                    items,
+                    last,
+                ));
+            }
+            RowLoad::Stale | RowLoad::Invalid => {
+                return Ok(partial_result(
+                    project,
+                    &context,
+                    "history_row_unavailable",
+                    items,
+                    last,
+                ));
+            }
+        }
+    }
+    let next = if more {
+        last.map(|position| next_cursor(&hash, &context, position))
+    } else {
+        None
+    };
+    Ok(with_projection_status(
+        json!({"status":if context.authority_incomplete{"partial"}else{"ready"},"reason":if context.authority_incomplete{Some("project_authority_incomplete")}else{None},"project":project,"items":items,"has_more":more,"next_cursor":next,"revision":{"nodes":context.node_revision,"edges":context.edge_revision,"vectors":context.vector_revision}}),
+        &context,
+    ))
+}
+
+fn history_value_scoped(
+    connection: &Connection,
+    context: &Context,
+    project: &str,
+    value: &Value,
+) -> anyhow::Result<bool> {
+    fn endpoints(value: &Value) -> Option<Vec<(&str, &str)>> {
+        let records = if value.get("sourceNodeId").is_some() || value.get("targetNodeId").is_some()
+        {
+            vec![value]
+        } else if let Some(items) = value.as_array() {
+            items.iter().collect()
+        } else {
+            ["edges", "history", "versions", "items"]
+                .iter()
+                .find_map(|field| {
+                    value
+                        .get(*field)
+                        .and_then(Value::as_array)
+                        .map(|items| items.iter().collect())
+                })?
+        };
+        if records.is_empty() {
+            return None;
+        }
+        records
+            .iter()
+            .map(|item| {
+                Some((
+                    item.get("sourceNodeId")?.as_str()?,
+                    item.get("targetNodeId")?.as_str()?,
+                ))
+            })
+            .collect()
+    }
+    let Some(edges) = endpoints(value) else {
+        return Ok(false);
+    };
+    let scope = node_project_predicate("?4", context.summary_authority_ready);
+    let sql = format!(
+        "SELECT ({scope}) AND ({})",
+        node_project_predicate("?5", context.summary_authority_ready)
+    );
+    for (source, target) in edges {
+        if source.trim().is_empty() || target.trim().is_empty() {
+            return Ok(false);
+        }
+        let valid: bool = connection.query_row(
+            &sql,
+            params![
+                context.node_epoch,
+                context.vector_epoch,
+                project,
+                source,
+                target
+            ],
+            |row| row.get(0),
+        )?;
+        if !valid {
+            return Ok(false);
+        }
+    }
+    Ok(true)
+}
+
+pub(super) fn differential(
+    connection: &Connection,
+    project: &str,
+    _edge_ids: &[String],
+    _since: &str,
+    _cursor: Option<&str>,
+    _limit: usize,
+    _max_bytes: usize,
+) -> anyhow::Result<Value> {
+    check_bounds(_limit, _max_bytes)?;
+    let context = match ready_context(connection, project)? {
+        Ok(context) => context,
+        Err(page) => return Ok(page),
+    };
+    reject_partial_projection_cursor(_cursor, &context)?;
+    Ok(as_partial(
+        "revision_changefeed_unavailable",
+        project,
+        &context,
+        Vec::new(),
+    ))
+}
+
+pub(super) fn aggregate(
+    connection: &Connection,
+    project: &str,
+    node_ids: &[String],
+    edge_ids: &[String],
+    max_bytes: usize,
+) -> anyhow::Result<Value> {
+    check_bounds(1, max_bytes)?;
+    let context = match ready_context(connection, project)? {
+        Ok(context) => context,
+        Err(page) => return Ok(page),
+    };
+    let node_scope = node_project_predicate("n.key", context.summary_authority_ready);
+    let edge_source = node_project_predicate("e.source", context.summary_authority_ready);
+    let edge_target = node_project_predicate("e.target", context.summary_authority_ready);
+    let unique_nodes = node_ids.iter().collect::<std::collections::HashSet<_>>();
+    let unique_edges = edge_ids.iter().collect::<std::collections::HashSet<_>>();
+    let mut node_count = 0usize;
+    for id in unique_nodes {
+        let exists:bool=connection.query_row(&format!("SELECT EXISTS(SELECT 1 FROM retrieval_nodes n WHERE n.epoch=?1 AND n.key=?4 AND {node_scope})"),params![context.node_epoch,context.vector_epoch,project,id],|row|row.get(0))?;
+        if exists {
+            node_count += 1;
+        }
+    }
+    let mut edge_count = 0usize;
+    for id in unique_edges {
+        let exists:bool=connection.query_row(&format!("SELECT EXISTS(SELECT 1 FROM retrieval_edges e WHERE e.epoch=?4 AND e.key=?5 AND {edge_source} AND {edge_target})"),params![context.node_epoch,context.vector_epoch,project,context.edge_epoch,id],|row|row.get(0))?;
+        if exists {
+            edge_count += 1;
+        }
+    }
+    Ok(with_projection_status(
+        json!({"status":if context.authority_incomplete{"partial"}else{"ready"},"reason":if context.authority_incomplete{Some("project_authority_incomplete")}else{None},"project":project,"items":[],"aggregate":{"node_count":node_count,"edge_count":edge_count},"has_more":false,"next_cursor":null,"revision":{"nodes":context.node_revision,"edges":context.edge_revision,"vectors":context.vector_revision}}),
+        &context,
+    ))
+}
