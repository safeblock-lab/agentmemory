+use super::query::{
+    SMALL_PROJECT_MAX_CANDIDATES, SMALL_PROJECT_MAX_ID_BYTES, available, batch_page_size,
+    batch_params, batch_statement, batch_window_count, guarded, kinds, partial, rank,
+    small_project_params, small_project_statement, vector_batch_size, vector_params,
+    vector_statement,
+};
+use super::*;
+use rusqlite::params_from_iter;
+use std::collections::{HashMap, HashSet};
+
+struct Candidate {
+    id: String,
+    session: String,
+}
+
+fn small_project_candidates(
+    c: &Connection,
+    meta: &semantic::Meta,
+    project: i64,
+    session: Option<i64>,
+    project_name: &str,
+    kinds: &[i64],
+    max_candidates: usize,
+) -> anyhow::Result<Option<Vec<Candidate>>> {
+    let threshold = max_candidates.min(SMALL_PROJECT_MAX_CANDIDATES);
+    if threshold == 0 {
+        return Ok(None);
+    }
+    let mut candidates = Vec::with_capacity(threshold);
+    let mut seen = HashSet::with_capacity(threshold);
+    let mut id_bytes = 0usize;
+    for kind in kinds {
+        let remaining = threshold.saturating_sub(candidates.len());
+        let query_limit = remaining + 1;
+        let values = small_project_params(
+            &meta.index_id,
+            meta.epoch,
+            project,
+            *kind,
+            session,
+            project_name,
+            query_limit,
+            SMALL_PROJECT_MAX_ID_BYTES.saturating_sub(id_bytes),
+        );
+        let sql = small_project_statement(*kind, session.is_some());
+        let mut statement = c.prepare_cached(&sql)?;
+        let mut rows = statement.query(params_from_iter(values.iter()))?;
+        while let Some(row) = rows.next()? {
+            if candidates.len() == threshold || row.get::<_, bool>(10)? {
+                return Ok(None);
+            }
+            let id: String = row.get(0)?;
+            let posting_generation: i64 = row.get(2)?;
+            let session_name: String = row.get(3)?;
+            let session_generation: i64 = row.get(4)?;
+            let vector_present: bool = row.get(9)?;
+            if posting_generation != session_generation
+                || !vector_present
+                || !seen.insert(id.clone())
+            {
+                return Ok(None);
+            }
+            if *kind != 2
+                && (row.get::<_, Option<String>>(5)?.is_none()
+                    || row.get::<_, Option<bool>>(6)? != Some(false)
+                    || row.get::<_, Option<String>>(7)? != row.get::<_, Option<String>>(5)?
+                    || !row.get::<_, bool>(8)?)
+            {
+                return Ok(None);
+            }
+            id_bytes = id_bytes.saturating_add(id.len());
+            if id_bytes > SMALL_PROJECT_MAX_ID_BYTES {
+                return Ok(None);
+            }
+            candidates.push(Candidate {
+                id,
+                session: session_name,
+            });
+        }
+    }
+    Ok(Some(candidates))
+}
+
+fn small_project_search(
+    c: &Connection,
+    meta: &semantic::Meta,
+    query: &[f32],
+    project: i64,
+    session: Option<i64>,
+    project_name: &str,
+    kinds: &[i64],
+    limit: usize,
+    max_candidates: usize,
+    options: super::super::search_projection::Options<'_>,
+    readiness_reason: Option<&'static str>,
+) -> anyhow::Result<Option<Value>> {
+    let Some(candidates) = small_project_candidates(
+        c,
+        meta,
+        project,
+        session,
+        project_name,
+        kinds,
+        max_candidates,
+    )?
+    else {
+        return Ok(None);
+    };
+    let candidate_count = candidates.len();
+    let mut matches = Vec::with_capacity(limit);
+    if !score_candidates(
+        c,
+        meta,
+        query,
+        meta.dimensions,
+        &candidates,
+        limit,
+        &mut matches,
+    )?
+    .is_empty()
+    {
+        return Ok(None);
+    }
+    let projection =
+        super::super::search_projection::enrich(c, &meta.index_id, &mut matches, options)?;
+    let partial_reason = if projection.is_some() {
+        projection
+    } else {
+        readiness_reason
+    };
+    let status = if partial_reason.is_some() {
+        "partial"
+    } else {
+        "ready"
+    };
+    Ok(Some(json!({
+        "items":matches,
+        "approximate":false,
+        "candidates":candidate_count,
+        "raw_visits":candidate_count,
+        "budget_exhausted":false,
+        "status":status,
+        "reason":partial_reason,
+        "model":meta.model,
+        "dimensions":meta.dimensions,
+        "generation":meta.generation
+    })))
+}
+
+fn score_candidates(
+    c: &Connection,
+    meta: &semantic::Meta,
+    query: &[f32],
+    dimensions: usize,
+    candidates: &[Candidate],
+    limit: usize,
+    matches: &mut Vec<Value>,
+) -> anyhow::Result<Vec<String>> {
+    if candidates.is_empty() {
+        return Ok(Vec::new());
+    }
+    let batch_size = vector_batch_size(dimensions);
+    let sql = vector_statement(batch_size);
+    let mut statement = c.prepare_cached(&sql)?;
+    let mut missing = Vec::new();
+    for batch in candidates.chunks(batch_size) {
+        let ids: Vec<_> = batch.iter().map(|candidate| candidate.id.clone()).collect();
+        let mut sessions: HashMap<_, _> = batch
+            .iter()
+            .map(|candidate| (candidate.id.as_str(), candidate.session.as_str()))
+            .collect();
+        let values = vector_params(&meta.index_id, meta.epoch, &ids, batch_size);
+        let mut rows = statement.query(params_from_iter(values.iter()))?;
+        while let Some(row) = rows.next()? {
+            let id: String = row.get(0)?;
+            let Some(session_id) = sessions.remove(id.as_str()) else {
+                return Err(protocol::error("STATE_INDEX_NOT_READY"));
+            };
+            let embedding: Vec<u8> = row.get(1)?;
+            let score = lsh::cosine(query, &lsh::from_blob(&embedding, dimensions)?);
+            matches.push(json!({"obsId":id,"sessionId":session_id,"score":score}));
+            matches.sort_unstable_by(rank);
+            matches.truncate(limit);
+        }
+        missing.extend(sessions.into_keys().map(str::to_owned));
+    }
+    Ok(missing)
+}
+
+pub fn semantic_search(
+    c: &Connection,
+    meta: &semantic::Meta,
+    embedding: &str,
+    limit: usize,
+    max_candidates: usize,
+    probes: usize,
+    options: super::super::search_projection::Options<'_>,
+) -> anyhow::Result<Value> {
+    let availability = available(c, meta, options)?;
+    if !availability.usable {
+        return Ok(partial(meta, "project_index_not_ready"));
+    }
+    guarded(c, meta, || {
+        semantic_inner(c, meta, embedding, limit, max_candidates, probes, options, availability.partial_reason)
+    })
+}
+fn semantic_inner(
+    c: &Connection,
+    meta: &semantic::Meta,
+    embedding: &str,
+    limit: usize,
+    max_candidates: usize,
+    probes: usize,
+    options: super::super::search_projection::Options<'_>,
+    readiness_reason: Option<&'static str>,
+) -> anyhow::Result<Value> {
+    let project = project_token(c, options.project.unwrap())?
+        .ok_or_else(|| protocol::error("STATE_INDEX_NOT_READY"))?;
+    let project_name = options.project.unwrap();
+    let session = options
+        .session_id
+        .map(|s| session_token(c, s))
+        .transpose()?
+        .flatten();
+    if options.session_id.is_some() && session.is_none() {
+        return Ok(json!({"items":[],"status":if readiness_reason.is_some(){"partial"}else{"ready"},"reason":readiness_reason,"candidates":0,"approximate":true,"budget_exhausted":false,"model":meta.model,"dimensions":meta.dimensions,"generation":meta.generation}));
+    }
+    let query = lsh::decode(embedding, meta.dimensions)?;
+    let kinds = kinds(c, &meta.index_id, options)?;
+    if let Some(result) = small_project_search(
+        c,
+        meta,
+        &query,
+        project,
+        session,
+        project_name,
+        &kinds,
+        limit,
+        max_candidates,
+        options,
+        readiness_reason,
+    )? {
+        return Ok(result);
+    }
+    let buckets: Vec<_> = lsh::signatures(&query)
+        .iter()
+        .map(|signature| lsh::buckets(signature, probes))
+        .collect();
+    let bucket_limit = (max_candidates / lsh::TABLES / kinds.len()).max(16);
+    let max_visits = max_candidates
+        .saturating_mul(lsh::TABLES)
+        .saturating_mul(kinds.len());
+    let batch_windows = batch_window_count(bucket_limit);
+    let bucket_rows = bucket_limit.saturating_add(1);
+    let page_size = batch_page_size(bucket_limit);
+    let paged_window = bucket_rows > page_size;
+    let sql = batch_statement(session.is_some(), batch_windows);
+    let mut statement = c.prepare_cached(&sql)?;
+    let mut seen = HashSet::with_capacity(max_candidates.min(4096));
+    let mut matches: Vec<Value> = Vec::with_capacity(limit);
+    let mut visits = 0;
+    let mut exhausted = false;
+    let mut incomplete = false;
+    let mut id_bytes = 0;
+    let selectors_per_probe = lsh::TABLES * kinds.len();
+    let total_windows = probes * selectors_per_probe;
+    let mut window_start = 0;
+    'windows: while window_start < total_windows {
+        let active_windows = batch_windows.min(total_windows - window_start);
+        let mut selectors = Vec::with_capacity(active_windows);
+        for offset in 0..active_windows {
+            let position = window_start + offset;
+            let probe = position / selectors_per_probe;
+            let within_probe = position % selectors_per_probe;
+            let table = within_probe / kinds.len();
+            let kind = kinds[within_probe % kinds.len()];
+            selectors.push((kind, table as i64, Some(buckets[table][probe])));
+        }
+        let values = batch_params(
+            &meta.index_id,
+            meta.epoch,
+            project,
+            session,
+            project_name,
+            if paged_window { page_size } else { bucket_rows },
+            None,
+            &selectors,
+            batch_windows,
+        );
+        let mut stop = false;
+        let mut page_cursor: Option<(i64, String)> = None;
+        let mut current_window: Option<i64> = None;
+        let mut bucket_seen = 0;
+        loop {
+            let page_values = if let Some((cursor_session, cursor_id)) = &page_cursor {
+                batch_params(
+                    &meta.index_id,
+                    meta.epoch,
+                    project,
+                    session,
+                    project_name,
+                    if paged_window { page_size } else { bucket_rows },
+                    Some((*cursor_session, cursor_id.as_str())),
+                    &selectors,
+                    batch_windows,
+                )
+            } else {
+                values.clone()
+            };
+            let query_page_size = if paged_window { page_size } else { bucket_rows };
+            let mut page_rows = 0;
+            let mut last_cursor = None;
+            let mut page_candidates = Vec::new();
+            let mut bucket_done = false;
+            {
+                let mut rows = statement.query(params_from_iter(page_values.iter()))?;
+                while let Some(row) = rows.next()? {
+                    page_rows += 1;
+                    let window: i64 = row.get(0)?;
+                    if current_window != Some(window) {
+                        current_window = Some(window);
+                        if !paged_window {
+                            bucket_seen = 0;
+                        }
+                    }
+                    let id: String = row.get(1)?;
+                    let posting_session: i64 = row.get(2)?;
+                    last_cursor = Some((posting_session, id.clone()));
+                    visits += 1;
+                    if visits > max_visits {
+                        exhausted = true;
+                        stop = true;
+                        break;
+                    }
+                    bucket_seen += 1;
+                    if bucket_seen > bucket_limit {
+                        exhausted = true;
+                        bucket_done = true;
+                        if paged_window {
+                            break;
+                        }
+                        continue;
+                    }
+                    if seen.contains(&id) {
+                        continue;
+                    }
+                    if seen.len() >= max_candidates || id_bytes + id.len() > 4 * 1024 * 1024 {
+                        exhausted = true;
+                        stop = true;
+                        break;
+                    }
+                    let kind: i64 = row.get(3)?;
+                    let posting_generation: i64 = row.get(4)?;
+                    let session_generation: Option<i64> = row.get(6)?;
+                    let source_version: Option<String> = row.get(7)?;
+                    let dirty: Option<bool> = row.get(8)?;
+                    let vector_present: bool = row.get(9)?;
+                    if !vector_present
+                        || session_generation != Some(posting_generation)
+                        || (kind != 2 && (source_version.is_none() || dirty != Some(false)))
+                    {
+                        incomplete = true;
+                        continue;
+                    }
+                    let session_id: String = row.get(5)?;
+                    id_bytes += id.len();
+                    seen.insert(id.clone());
+                    page_candidates.push(Candidate {
+                        id,
+                        session: session_id,
+                    });
+                }
+            }
+            for id in score_candidates(
+                c,
+                meta,
+                &query,
+                meta.dimensions,
+                &page_candidates,
+                limit,
+                &mut matches,
+            )? {
+                incomplete = true;
+                if seen.remove(&id) {
+                    id_bytes = id_bytes.saturating_sub(id.len());
+                }
+            }
+            if stop || !paged_window || bucket_done || page_rows < query_page_size {
+                break;
+            }
+            page_cursor = last_cursor;
+            if page_cursor.is_none() {
+                break;
+            }
+        }
+        if stop {
+            break 'windows;
+        }
+        window_start += active_windows;
+    }
+    let projection =
+        super::super::search_projection::enrich(c, &meta.index_id, &mut matches, options)?;
+    let reason = if incomplete {
+        Some("projection_source_missing")
+    } else if projection.is_some() {
+        projection
+    } else if exhausted {
+        Some("candidate_budget")
+    } else {
+        readiness_reason
+    };
+    Ok(
+        json!({"items":matches,"approximate":true,"candidates":seen.len(),"raw_visits":visits,"budget_exhausted":exhausted,"status":if reason.is_some(){"partial"}else{"ready"},"reason":reason,"model":meta.model,"dimensions":meta.dimensions,"generation":meta.generation}),
+    )
+}
