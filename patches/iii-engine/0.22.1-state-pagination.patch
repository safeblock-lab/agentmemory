+fn memory(id: &str, project: &str, title: &str, version: i64) -> Value {
+    json!({"id":id,"project":project,"title":title,"content":"Useful memory","sessionIds":["s"],"sourceObservationIds":["obs"],"version":version,"isLatest":true,"strength":1.0,"updatedAt":"2026-10-09T00:00:00Z"})
+}
+fn evolution(c: &Connection, id: &str, value: Value, effect: char) -> Value {
