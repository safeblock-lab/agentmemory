+    let before = adapter.run(4096,|connection| database::revision(connection,storage_prune::TEMPORAL_WORK)).await.unwrap();
+    let deleted = technical(&adapter,storage_prune::TEMPORAL_WORK,TEMP_MANIFEST,false,false).await;
