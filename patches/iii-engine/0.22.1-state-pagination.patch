+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn sqlite_admission_bytes_and_queue_count_reject_overload() {
+    let (_directory, adapter) = fresh();
+    let all = adapter
+        .admission
+        .clone()
+        .acquire_many_owned(ADMISSION_BYTES as u32)
+        .await
+        .unwrap();
+    assert_eq!(
+        code(adapter.get("s", "a").await.unwrap_err()),
+        "STATE_TX_LIMIT_EXCEEDED"
+    );
+    drop(all);
+    assert_eq!(
+        code(
+            adapter
+                .set("s", "a", json!("x".repeat(MAX_ENVELOPE_BYTES)))
+                .await
+                .unwrap_err()
+        ),
+        "STATE_RECORD_TOO_LARGE"
+    );
+    let (entered_send, entered_receive) = std::sync::mpsc::channel();
+    let (release_send, release_receive) = std::sync::mpsc::channel();
+    let executing = adapter.clone();
+    let blocker = tokio::spawn(async move {
+        executing
+            .run(4096, move |_| {
+                entered_send.send(()).unwrap();
+                release_receive.recv().unwrap();
+                Ok(())
+            })
+            .await
+    });
+    tokio::task::spawn_blocking(move || entered_receive.recv().unwrap())
+        .await
+        .unwrap();
+    for _ in 0..32 {
+        assert!(adapter.sender.try_send(Box::new(|_| {})).is_ok());
+    }
+    assert_eq!(
+        code(adapter.get("s", "a").await.unwrap_err()),
+        "STATE_TX_LIMIT_EXCEEDED"
+    );
+    release_send.send(()).unwrap();
+    blocker.await.unwrap().unwrap();
+}
