--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/retrieval/workflow_statistics.rs
@@ -0,0 +1,277 @@
+use super::super::{database, protocol};
+use rusqlite::{params, Connection, OptionalExtension};
+use serde::{Deserialize, Serialize};
+use serde_json::{json, Value};
+use sha2::{Digest, Sha256};
+use std::{collections::BTreeSet, time::{Duration, Instant}};
+
+const WORKFLOWS: [&str; 8] = ["summaries", "skills", "graph", "reflection", "consolidation", "compression", "snapshots", "maintenance"];
+const SAFE_INTEGER: i64 = 9_007_199_254_740_991;
+
+#[derive(Deserialize, Serialize)]
+#[serde(tag = "kind", rename_all = "snake_case", deny_unknown_fields)]
+pub enum Record {
+    Terminal { workflow: String, producer: String, execution_id: String, execution_level: String,
+        #[serde(deserialize_with = "deserialize_agent_id")]
+        agent_id: Option<String>, occurred_at: String, outcome: String },
+    Activate { workflow: String, collector_id: String },
+    Invalidate { workflow: String, reason: String },
+}
+
+fn deserialize_agent_id<'de, D: serde::Deserializer<'de>>(deserializer: D) -> Result<Option<String>, D::Error> {
+    Option::<String>::deserialize(deserializer)
+}
+
+fn text(value: &str) -> anyhow::Result<()> {
+    protocol::require(!value.trim().is_empty() && value.len() <= 256 && !value.chars().any(char::is_control))
+}
+fn timestamp(value: &str) -> anyhow::Result<i64> {
+    Ok(chrono::DateTime::parse_from_rfc3339(value)
+        .map_err(|_| protocol::error("STATE_TX_INVALID_REQUEST"))?.timestamp_millis())
+}
+fn iso(ms: i64) -> String {
+    chrono::DateTime::from_timestamp_millis(ms).unwrap().to_rfc3339_opts(chrono::SecondsFormat::Millis, true)
+}
+pub fn validate(input: &Record) -> anyhow::Result<()> {
+    let workflow = match input {
+        Record::Terminal { workflow, producer, execution_id, execution_level, agent_id, occurred_at, outcome } => {
+            for value in [producer, execution_id] { text(value)?; }
+            if let Some(agent_id) = agent_id { text(agent_id)?; }
+            protocol::require(["workflow", "unit"].contains(&execution_level.as_str())
+                && ["completed", "partial", "failed"].contains(&outcome.as_str()) && occurred_at.len() <= 64)?;
+            protocol::require(timestamp(occurred_at)? >= 0)?;
+            workflow
+        },
+        Record::Activate { workflow, collector_id } => { text(collector_id)?; workflow },
+        Record::Invalidate { workflow, reason } => {
+            protocol::require(["recorder_loss", "recorder_failure", "collector_gap", "producer_gap"].contains(&reason.as_str()))?;
+            workflow
+        },
+    };
+    protocol::require(WORKFLOWS.contains(&workflow.as_str()))
+}
+pub fn schema(c: &Connection) -> anyhow::Result<()> {
+    c.execute_batch("CREATE TABLE IF NOT EXISTS retrieval_workflow_receipts(producer TEXT NOT NULL,execution_id TEXT NOT NULL,payload TEXT NOT NULL,receipt TEXT NOT NULL,PRIMARY KEY(producer,execution_id)) WITHOUT ROWID;
+        CREATE TABLE IF NOT EXISTS retrieval_workflow_last(workflow TEXT NOT NULL,agent TEXT NOT NULL,occurred INTEGER NOT NULL,execution_id TEXT NOT NULL,producer TEXT NOT NULL,terminal TEXT NOT NULL,PRIMARY KEY(workflow,agent)) WITHOUT ROWID;
+        CREATE TABLE IF NOT EXISTS retrieval_workflow_buckets(workflow TEXT NOT NULL,agent TEXT NOT NULL,minute INTEGER NOT NULL,runs INTEGER NOT NULL,failures INTEGER NOT NULL,PRIMARY KEY(workflow,agent,minute)) WITHOUT ROWID;
+        CREATE TABLE IF NOT EXISTS retrieval_workflow_coverage(workflow TEXT PRIMARY KEY,collector TEXT NOT NULL,since INTEGER NOT NULL,invalid TEXT) WITHOUT ROWID;
+        CREATE TABLE IF NOT EXISTS retrieval_workflow_gaps(workflow TEXT NOT NULL,start INTEGER NOT NULL,end INTEGER NOT NULL,reason TEXT NOT NULL,PRIMARY KEY(workflow,start,end,reason)) WITHOUT ROWID;
+        CREATE TABLE IF NOT EXISTS retrieval_workflow_revision(id INTEGER PRIMARY KEY CHECK(id=1),revision INTEGER NOT NULL);
+        INSERT OR IGNORE INTO retrieval_workflow_revision VALUES(1,0);")?;
+    Ok(())
+}
+fn bump(c: &Connection) -> anyhow::Result<i64> {
+    protocol::require(c.execute("UPDATE retrieval_workflow_revision SET revision=revision+1 WHERE id=1 AND revision<9223372036854775807", [])? == 1)?;
+    Ok(c.query_row("SELECT revision FROM retrieval_workflow_revision WHERE id=1", [], |r| r.get(0))?)
+}
+pub fn record(c: &Connection, input: Record) -> anyhow::Result<Value> {
+    validate(&input)?;
+    let now = chrono::Utc::now().timestamp_millis();
+    let payload = serde_json::to_string(&input)?;
+    match input {
+        Record::Terminal { workflow, producer, execution_id, execution_level, agent_id, occurred_at, outcome } => {
+            let old: Option<(String, String)> = c.query_row("SELECT payload,receipt FROM retrieval_workflow_receipts WHERE producer=?1 AND execution_id=?2", params![producer, execution_id], |r| Ok((r.get(0)?, r.get(1)?))).optional()?;
+            if let Some((old, receipt)) = old {
+                if old != payload { return Err(protocol::error("STATE_TX_REPLAY_CONFLICT")); }
+                return Ok(serde_json::from_str(&receipt)?);
+            }
+            let occurred = timestamp(&occurred_at)?;
+            protocol::require(occurred <= now)?;
+            let revision = bump(c)?;
+            let receipt = json!({"version":1,"recorded":true,"revision":revision.to_string(),"recordedAt":iso(now)});
+            c.execute("INSERT INTO retrieval_workflow_receipts VALUES(?1,?2,?3,?4)", params![producer, execution_id, payload, receipt.to_string()])?;
+            if execution_level == "workflow" {
+                let logical_id = serde_json::to_string(&(&producer, &execution_id))?;
+                let terminal = json!({"workflow":workflow,"executionId":logical_id,"executionLevel":execution_level,"agentId":agent_id,"occurredAt":iso(occurred),"outcome":outcome}).to_string();
+                for agent in std::iter::once("").chain(agent_id.as_deref()) {
+                    c.execute("INSERT INTO retrieval_workflow_last VALUES(?1,?2,?3,?4,?5,?6) ON CONFLICT(workflow,agent) DO UPDATE SET occurred=excluded.occurred,execution_id=excluded.execution_id,producer=excluded.producer,terminal=excluded.terminal WHERE excluded.occurred>occurred OR (excluded.occurred=occurred AND excluded.execution_id>execution_id)", params![workflow, agent, occurred, logical_id, producer, terminal])?;
+                    let changed = c.execute("INSERT INTO retrieval_workflow_buckets VALUES(?1,?2,?3,1,?4) ON CONFLICT(workflow,agent,minute) DO UPDATE SET runs=runs+1,failures=failures+excluded.failures WHERE runs<?5 AND failures<?5", params![workflow, agent, occurred.div_euclid(60_000), i64::from(outcome == "failed"), SAFE_INTEGER / 1440])?;
+                    if changed != 1 { return Err(super::request::resource()); }
+                }
+            }
+            Ok(receipt)
+        },
+        Record::Activate { workflow, collector_id } => {
+            let mut changed = c.execute("INSERT OR IGNORE INTO retrieval_workflow_coverage VALUES(?1,?2,?3,NULL)", params![workflow, collector_id, now])?;
+            // Legacy invalidations have no event time; retain the whole possible gap through recovery.
+            changed += c.execute("INSERT OR IGNORE INTO retrieval_workflow_gaps SELECT workflow,since,?2,invalid FROM retrieval_workflow_coverage WHERE workflow=?1 AND invalid IS NOT NULL", params![workflow, now+1])?;
+            changed += c.execute("UPDATE retrieval_workflow_coverage SET collector=?2,invalid=NULL WHERE workflow=?1 AND (collector<>?2 OR invalid IS NOT NULL)", params![workflow, collector_id])?;
+            if changed > 0 { bump(c)?; }
+            Ok(json!({"version":1,"activated":changed>0,"sticky":true}))
+        },
+        Record::Invalidate { workflow, reason } => {
+            c.execute("INSERT OR IGNORE INTO retrieval_workflow_coverage VALUES(?1,'',?2,NULL)", params![workflow, now])?;
+            // The producer does not supply the missing execution time, so bound it conservatively.
+            let changed = c.execute("INSERT OR IGNORE INTO retrieval_workflow_gaps SELECT workflow,since,?2,?3 FROM retrieval_workflow_coverage WHERE workflow=?1", params![workflow, now+1, reason])?;
+            if changed > 0 { bump(c)?; }
+            Ok(json!({"version":1,"invalid":true,"sticky":true}))
+        },
+    }
+}
+
+struct Budget { rows: usize, bytes: usize, start: Instant, duration: Duration, revisions: Vec<(String, String)> }
+impl Budget {
+    fn check(&self) -> anyhow::Result<()> {
+        if self.rows == 0 || self.bytes == 0 || self.start.elapsed() >= self.duration { return Err(super::request::resource()); }
+        Ok(())
+    }
+    fn row(&mut self, c: &Connection, scope: &str, key: &str) -> anyhow::Result<Option<Value>> {
+        self.check()?;
+        self.rows -= 1;
+        let work = database::row_work(c, scope, key)?.saturating_add(key.len()).saturating_add(scope.len());
+        if work > self.bytes { return Err(super::request::resource()); }
+        self.bytes -= work;
+        if !self.revisions.iter().any(|(s,_)| s == scope) {
+            self.revisions.push((scope.to_owned(), database::revision(c,scope)?.to_string()));
+        }
+        Ok(database::row(c, scope, key)?.value)
+    }
+    fn scan(&mut self, c: &Connection, scope: &str, mut visit: impl FnMut(&mut Self, String, Value) -> anyhow::Result<()>) -> anyhow::Result<()> {
+        self.check()?;
+        self.revisions.push((scope.to_owned(), database::revision(c,scope)?.to_string()));
+        let mut statement = c.prepare("SELECT key FROM state_rows WHERE scope=?1 AND value IS NOT NULL ORDER BY position LIMIT ?2")?;
+        let keys = statement.query_map(params![scope, self.rows.saturating_add(1) as i64], |r| r.get::<_,String>(0))?;
+        for key in keys {
+            let key=key?;
+            let value=self.row(c,scope,&key)?.ok_or_else(|| protocol::error("STATE_INDEX_RECORD_INVALID"))?;
+            visit(self,key,value)?;
+        }
+        Ok(())
+    }
+}
+fn field<'a>(v: &'a Value, name: &str) -> anyhow::Result<&'a str> {
+    v.get(name).and_then(Value::as_str).filter(|s| !s.is_empty() && s.len()<=256).ok_or_else(|| protocol::error("STATE_INDEX_RECORD_INVALID"))
+}
+fn optional_time(v: &Value, name: &str) -> anyhow::Result<Option<i64>> {
+    v.get(name).filter(|v| !v.is_null()).map(|v| v.as_str().ok_or_else(|| protocol::error("STATE_INDEX_RECORD_INVALID")).and_then(timestamp)).transpose()
+}
+fn queue_count(c: &Connection, workflow: &str, now: i64, b: &mut Budget, count: &mut i64) -> anyhow::Result<()> {
+    match workflow {
+        "skills" => b.scan(c,"mem:skill-lifecycle:intents", |_,_,v| {
+            match field(&v,"kind")? { "session" => {}, "intent" => match field(&v,"status")? {
+                "queued" => *count+=1, "running"|"completed"|"skipped"|"stale"|"failed"=>{}, _=>return Err(protocol::error("STATE_INDEX_RECORD_INVALID")) },
+                _=>return Err(protocol::error("STATE_INDEX_RECORD_INVALID")) }
+            Ok(())
+        })?,
+        "graph" => b.scan(c,"mem:graph-dispatch:intents", |b,_,v| {
+            match field(&v,"state")? { "completed"|"failed"=>return Ok(()), "pending"=>{}, _=>return Err(protocol::error("STATE_INDEX_RECORD_INVALID")) }
+            let digest=field(&v,"digest")?;
+            let job = b.row(c,"mem:graph:jobs",field(&v,"jobId")?)?;
+            if let Some(job) = job {
+                if field(&job,"captureDigest")? != digest { return Err(protocol::error("STATE_TX_REPLAY_CONFLICT")); }
+                if job["state"] == "completed" || job["state"] == "failed" && job["recoveryStopped"] == true { return Ok(()); }
+            }
+            let claimed=optional_time(&v,"claimedAt")?;
+            if v.get("deliveryId").is_some_and(|v| !v.is_null()) && claimed.is_none() { return Err(protocol::error("STATE_INDEX_RECORD_INVALID")); }
+            if claimed.is_some_and(|t| t+600_000>now) { return Ok(()); }
+            *count+=1;
+            Ok(())
+        })?,
+        "reflection" => b.scan(c,"mem:reflect:jobs", |_,_,v| {
+            match field(&v,"status")? {
+                "completed"|"partial"|"failed"|"blocked"|"waiting_index"|"waiting_graph"|"waiting_scope"|"waiting_budget"|"waiting_batch"=>return Ok(()),
+                "pending"=>{}, _=>return Err(protocol::error("STATE_INDEX_RECORD_INVALID")) }
+            if let Some(claim) = v.get("claim").filter(|v| !v.is_null()) {
+                if claim["expiresAt"].as_i64().ok_or_else(|| protocol::error("STATE_INDEX_RECORD_INVALID"))? > now { return Ok(()); }
+            }
+            *count+=1;
+            Ok(())
+        })?,
+        "summaries" => {
+            let mut sessions = BTreeSet::new();
+            let mut terminal_sessions = BTreeSet::new();
+            b.scan(c,"mem:summary-queue:jobs", |b,key,v| {
+                match field(&v,"status")? {
+                    "completed"|"failed"=>{ terminal_sessions.insert(field(&v,"sessionId")?.to_owned()); return Ok(()); },
+                    "pending"=>{}, _=>return Err(protocol::error("STATE_INDEX_RECORD_INVALID")) }
+                let session = field(&v,"sessionId")?;
+                if field(&v,"id")? != key { return Err(protocol::error("STATE_INDEX_RECORD_INVALID")); }
+                let active = b.row(c,"mem:summary-queue:active",session)?.ok_or_else(|| protocol::error("STATE_INDEX_RECORD_INVALID"))?;
+                if field(&active,"jobId")? != key { return Err(protocol::error("STATE_INDEX_RECORD_INVALID")); }
+                if !sessions.insert(session.to_owned()) { return Err(protocol::error("STATE_INDEX_RECORD_INVALID")); }
+                let ids = v["unitIds"].as_array().ok_or_else(|| protocol::error("STATE_INDEX_RECORD_INVALID"))?;
+                if ids.is_empty() { return Err(protocol::error("STATE_WORKFLOW_SUMMARY_TRANSITION_UNKNOWN")); }
+                if ids.len()>b.rows { return Err(super::request::resource()); }
+                let scope = format!("mem:summary-queue:units:{key}");
+                let mut running = false;
+                for id in ids {
+                    let unit = b.row(c,&scope,id.as_str().ok_or_else(|| protocol::error("STATE_INDEX_RECORD_INVALID"))?)?.ok_or_else(|| protocol::error("STATE_INDEX_RECORD_INVALID"))?;
+                    if field(&unit,"jobId")? != key { return Err(protocol::error("STATE_INDEX_RECORD_INVALID")); }
+                    if unit.get("output").is_some_and(|v| !v.is_null()) { continue; }
+                    if optional_time(&unit,"startedAt")?.is_some_and(|t| t+210_000>now) { running=true; }
+                    if let Some(dispatched) = optional_time(&unit,"dispatchedAt")? {
+                        if dispatched+60_000>now || unit["attempts"]==0 && dispatched+210_000>now { running=true; }
+                        else if dispatched+210_000>now && optional_time(&unit,"startedAt")?.is_none() {
+                            return Err(protocol::error("STATE_WORKFLOW_SUMMARY_TRANSITION_UNKNOWN"));
+                        }
+                    }
+                }
+                if !running { *count+=1; }
+                Ok(())
+            })?;
+            b.scan(c,"mem:summary-queue:intents", |b,key,v| {
+                let session=field(&v,"sessionId")?;
+                if session!=key { return Err(protocol::error("STATE_INDEX_RECORD_INVALID")); }
+                if sessions.contains(session) { return Ok(()); }
+                if terminal_sessions.contains(session) { return Err(protocol::error("STATE_WORKFLOW_SUMMARY_INTENT_UNKNOWN")); }
+                let session_row=b.row(c,"mem:sessions",session)?.ok_or_else(|| protocol::error("STATE_INDEX_RECORD_INVALID"))?;
+                if field(&session_row,"status")? != "completed" { return Ok(()); }
+                if b.row(c,"mem:summary-queue:active",session)?.is_some() || b.row(c,"mem:summaries",session)?.is_some() {
+                    return Err(protocol::error("STATE_WORKFLOW_SUMMARY_INTENT_UNKNOWN"));
+                }
+                if sessions.insert(session.to_owned()) { *count+=1; }
+                Ok(())
+            })?;
+        },
+        _ => return Err(protocol::error("STATE_WORKFLOW_QUEUE_UNAVAILABLE")),
+    }
+    if b.start.elapsed() >= b.duration { return Err(super::request::resource()); }
+    Ok(())
+}
+fn queue(c: &Connection, workflow: &str, agent: Option<&str>, now: i64, rows: usize, bytes: usize, ms: usize) -> Value {
+    let mut b = Budget { rows, bytes, start:Instant::now(), duration:Duration::from_millis(ms as u64), revisions:Vec::new() };
+    let mut value = json!({"count":null,"state":"unavailable","unit":"logical_jobs","sampledAt":null,"sourceScopes":[],"revision":null});
+    if agent.is_some() { value["reason"]=json!("agent_attribution_unavailable"); return value; }
+    let mut count = 0;
+    match queue_count(c,workflow,now,&mut b,&mut count) {
+        Ok(()) => { value["count"]=json!(count);value["state"]=json!("current");value["sampledAt"]=json!(iso(now)); },
+        Err(cause) => {
+            let code=cause.downcast_ref::<protocol::TxError>().map(|e|e.0);
+            let limited=code==Some("STATE_RETRIEVAL_RESOURCE_LIMIT");
+            if limited { value["count"]=json!(count);value["sampledAt"]=json!(iso(now)); }
+            value["state"]=json!(if limited {"partial"}else{"unavailable"});
+            value["reason"]=json!(if limited {"queue_budget_exceeded"}else if code==Some("STATE_WORKFLOW_SUMMARY_INTENT_UNKNOWN") {"summary_intent_requires_source_reconciliation"}else if code==Some("STATE_WORKFLOW_SUMMARY_TRANSITION_UNKNOWN") {"summary_delivery_or_stage_transition_unknown"}else if WORKFLOWS[4..].contains(&workflow) {"authoritative_queue_not_established"}else{"queue_source_invalid_or_inconsistent"});
+        },
+    }
+    value["sourceScopes"]=json!(b.revisions.iter().map(|(scope,_)| {
+        if scope.starts_with("mem:summary-queue:units:") { "mem:summary-queue:units:*" } else { scope.as_str() }
+    }).collect::<BTreeSet<_>>());
+    if value["state"]=="current" {
+        let revision=Sha256::digest(serde_json::to_vec(&b.revisions).unwrap());
+        value["revision"]=json!(format!("sha256:{}",hex::encode(revision)));
+    }
+    value
+}
+pub fn read(c: &Connection, agent: Option<&str>, rows: usize, bytes: usize, ms: usize) -> anyhow::Result<Value> {
+    let now = chrono::Utc::now().timestamp_millis();
+    let end = now.div_euclid(60_000)*60_000;
+    let start = end-86_400_000;
+    let revision:i64=c.query_row("SELECT revision FROM retrieval_workflow_revision WHERE id=1",[],|r|r.get(0))?;
+    let mut workflows=Vec::new();
+    for workflow in WORKFLOWS {
+        let coverage:Option<(i64,Option<String>)>=c.query_row("SELECT since,invalid FROM retrieval_workflow_coverage WHERE workflow=?1",[workflow],|r|Ok((r.get(0)?,r.get(1)?))).optional()?;
+        let gap:Option<String>=c.query_row("SELECT reason FROM retrieval_workflow_gaps WHERE workflow=?1 AND start<?3 AND end>?2 ORDER BY end DESC LIMIT 1",params![workflow,start,end],|r|r.get(0)).optional()?;
+        let last:Option<String>=c.query_row("SELECT terminal FROM retrieval_workflow_last WHERE workflow=?1 AND agent=?2",params![workflow,agent.unwrap_or("")],|r|r.get(0)).optional()?;
+        let (runs,failures):(i64,i64)=c.query_row("SELECT COALESCE(SUM(runs),0),COALESCE(SUM(failures),0) FROM retrieval_workflow_buckets WHERE workflow=?1 AND agent=?2 AND minute>=?3 AND minute<?4",params![workflow,agent.unwrap_or(""),start.div_euclid(60_000),end.div_euclid(60_000)],|r|Ok((r.get(0)?,r.get(1)?)))?;
+        let gap_reason=coverage.as_ref().and_then(|(_,reason)|reason.as_deref()).or(gap.as_deref());
+        let invalid=gap_reason.is_some();
+        // Neither collector uptime nor an empty bucket proves every producer reported its executions.
+        let complete=false;
+        let state=if invalid {"invalid"}else if coverage.is_none(){"uninitialized"}else if complete {"complete"}else{"partial"};
+        let window=|count:i64| json!({"observedCount":if count>SAFE_INTEGER {None}else{Some(count)},"intervalStart":iso(start),"intervalEnd":iso(end),"coverageSince":coverage.as_ref().map(|(since,_)|iso(*since)),"complete":complete,"state":if count>SAFE_INTEGER {"unavailable"}else{state},"reason":if count>SAFE_INTEGER {"count_exceeds_safe_integer"}else if let Some(reason)=gap_reason {reason}else if coverage.is_none(){"collector_not_activated"}else{"producer_coverage_unproven"}});
+        workflows.push(json!({"workflow":workflow,"source":"native-workflow-statistics-v1","agentScope":agent,"asOf":iso(now),"lastRun":last.as_ref().map(|s|serde_json::from_str::<Value>(s)).transpose()?,"lastRunState":if last.is_some() {"recorded"}else{"unknown"},"runs24h":window(runs),"failures24h":window(failures),"queued":queue(c,workflow,agent,now,rows,bytes,ms)}));
+    }
+    let result=json!({"version":1,"revision":revision.to_string(),"asOf":iso(now),"workflows":workflows});
+    if serde_json::to_vec(&result)?.len()>bytes { return Err(super::request::resource()); }
+    Ok(result)
+}
