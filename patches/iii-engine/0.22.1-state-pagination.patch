@@ -0,0 +1,121 @@
+use super::*;
+use rusqlite::{Connection, params};
+
+fn directory() -> tempfile::TempDir {
+    tempfile::tempdir_in(std::env::var("III_SQLITE_TEST_ROOT").unwrap()).unwrap()
+}
+
+#[test]
+fn native_format_rejects_v1_and_future_files_before_any_write() {
+    let dir = directory();
+    for version in [1, 3] {
+        let path = dir.path().join(format!("version-{version}.sqlite3"));
+        let connection = Connection::open(&path).unwrap();
+        connection
+            .execute_batch(
+                "CREATE TABLE sentinel(value TEXT); INSERT INTO sentinel VALUES('preserve');",
+            )
+            .unwrap();
+        connection
+            .pragma_update(None, "application_id", database::APPLICATION_ID)
+            .unwrap();
+        connection
+            .pragma_update(None, "user_version", version)
+            .unwrap();
+        drop(connection);
+        let before = std::fs::read(&path).unwrap();
+        assert!(
+            database::open(&path)
+                .unwrap_err()
+                .to_string()
+                .contains("explicit migration")
+        );
+        assert_eq!(std::fs::read(&path).unwrap(), before);
+        assert!(!std::path::PathBuf::from(format!("{}-wal", path.display())).exists());
+    }
+}
+
+#[test]
+fn native_format_restart_keeps_raw_json_metadata_and_tombstones() {
+    let dir = directory();
+    let path = dir.path().join("values.sqlite3");
+    let raw = format!(
+        "{{ \"text\": \"{}\", \"number\":9007199254740993 }}",
+        "café 東京 😀 /".repeat(1024)
+    );
+    {
+        let connection = database::open(&path).unwrap();
+        connection
+            .execute("INSERT INTO state_scopes VALUES('fixture','9',8)", [])
+            .unwrap();
+        connection
+            .execute(
+                "INSERT INTO state_rows VALUES('fixture','live',?1,'7',5,?2)",
+                params![codec::encode(&raw).unwrap(), raw.len() as i64],
+            )
+            .unwrap();
+        connection
+            .execute(
+                "INSERT INTO state_rows VALUES('fixture','deleted',NULL,'9',NULL,0)",
+                [],
+            )
+            .unwrap();
+    }
+    let connection = database::open(&path).unwrap();
+    let (encoded,version,position,bytes):(Vec<u8>,String,i64,i64)=connection.query_row("SELECT value,version,position,value_bytes FROM state_rows WHERE scope='fixture' AND key='live'",[],|r|Ok((r.get(0)?,r.get(1)?,r.get(2)?,r.get(3)?))).unwrap();
+    assert_eq!(database::decode_value(&encoded, bytes).unwrap(), raw);
+    assert_eq!(
+        (version, position, bytes),
+        ("7".into(), 5, raw.len() as i64)
+    );
+    assert_eq!(database::revision(&connection, "fixture").unwrap(), 9);
+    assert_eq!(
+        database::row(&connection, "fixture", "deleted")
+            .unwrap()
+            .version,
+        9
+    );
+    assert!(
+        database::row(&connection, "fixture", "deleted")
+            .unwrap()
+            .value
+            .is_none()
+    );
+    assert_eq!(
+        paging::list(&connection, "fixture").unwrap(),
+        vec![serde_json::from_str::<Value>(&raw).unwrap()]
+    );
+    assert_eq!(
+        connection
+            .query_row("PRAGMA user_version", [], |r| r.get::<_, i64>(0))
+            .unwrap(),
+        2
+    );
+    assert_eq!(
+        connection
+            .query_row("PRAGMA integrity_check", [], |r| r.get::<_, String>(0))
+            .unwrap(),
+        "ok"
+    );
+}
+
+#[test]
+fn incomplete_shadow_is_rejected_before_initialization() {
+    let dir = directory();
+    let path = dir.path().join("shadow.sqlite3");
+    let connection = database::open_for_migration(&path).unwrap();
+    connection.execute_batch("CREATE TABLE state_migration(id INTEGER PRIMARY KEY,status TEXT); INSERT INTO state_migration VALUES(1,'copying');").unwrap();
+    drop(connection);
+    let before = std::fs::read(&path).unwrap();
+    assert!(
+        database::open(&path)
+            .unwrap_err()
+            .to_string()
+            .contains("STATE_MIGRATION_INCOMPLETE")
+    );
+    assert_eq!(std::fs::read(&path).unwrap(), before);
+    let marker = dir.path().join("missing.sqlite3.migration-pending");
+    std::fs::write(&marker, b"pending").unwrap();
+    assert!(database::open(&dir.path().join("missing.sqlite3")).is_err());
+    assert!(!dir.path().join("missing.sqlite3").exists());
+}
diff --git a/engine/src/workers/state/adapters/sqlite/graph_metadata_tests.rs b/engine/src/workers/state/adapters/sqlite/graph_metadata_tests.rs
new file mode 100644
index 0000000..08f24f0
--- /dev/null
+++ b/engine/src/workers/state/adapters/sqlite/graph_metadata_tests.rs
@@ -0,0 +1,241 @@
+use super::fresh;
+use super::super::{database, protocol, SqliteAdapter, StateAdapter};
+use rusqlite::Connection;
+use serde_json::{json, Value};
+
+const MIN_SCAN_BYTES: u64 = 8192;
+
+async fn prepare(adapter: &SqliteAdapter, limit: usize) -> anyhow::Result<Value> {
+    adapter
+        .storage(json!({
+            "action": "graph_metadata_prepare",
+            "limit": limit,
+            "max_bytes": MIN_SCAN_BYTES,
+            "max_ms": 3000
+        }))
+        .await
+}
+
+async fn read(adapter: &SqliteAdapter) -> anyhow::Result<Value> {
+    adapter.storage(json!({"action":"graph_metadata"})).await
+}
+
+fn scoped_totals(connection: &Connection) -> anyhow::Result<(u64, u64, u64)> {
+    let mut rows = 0u64;
+    let mut logical_bytes = 0u64;
+    let mut stored_bytes = 0u64;
+    for scope in protocol::GRAPH_RECORD_SCOPES {
+        let (scope_rows, scope_logical, scope_stored): (i64, i64, i64) = connection.query_row(
+            "SELECT count(*),COALESCE(sum(value_bytes),0),COALESCE(sum(length(value)),0) FROM state_rows WHERE scope=?1 AND value IS NOT NULL",
+            [scope],
+            |row| Ok((row.get(0)?, row.get(1)?, row.get(2)?)),
+        )?;
+        rows += u64::try_from(scope_rows)?;
+        logical_bytes += u64::try_from(scope_logical)?;
+        stored_bytes += u64::try_from(scope_stored)?;
+    }
+    Ok((rows, logical_bytes, stored_bytes))
+}
+
+async fn assert_matches_sql_oracle(adapter: &SqliteAdapter) -> (u64, u64, u64) {
+    let metadata = read(adapter).await.unwrap();
+    let oracle = adapter.run(4096, |connection| scoped_totals(connection)).await.unwrap();
+    assert_eq!(metadata["status"], "ready");
+    assert_eq!(metadata["rows"].as_u64(), Some(oracle.0));
+    assert_eq!(metadata["logical_bytes"].as_u64(), Some(oracle.1));
+    assert_eq!(metadata["stored_bytes"].as_u64(), Some(oracle.2));
+    oracle
+}
