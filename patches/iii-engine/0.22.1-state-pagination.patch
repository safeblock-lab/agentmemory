+use super::{binding, error, need, wire::{Anchor, Binding, Contract}, INVALID};
+use super::super::protocol;
+use rusqlite::{params, Connection, OptionalExtension};
+use serde::{Deserialize, Serialize};
+use serde_json::Value;
+use std::{collections::HashSet, fs::File, io::Read, path::Path};
+
+const CONFIG: &str="STATE_GRAPH_AUTOMATIC_AUTHORITY_INVALID";
+#[derive(Clone, Copy, Serialize, Deserialize)]
+#[serde(rename_all="snake_case")]
+enum Scope { JobInputs, ProviderValues }
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct SourceRule { scope: Scope, key: String, pointer: String }
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct SegmentRule {
+    request_pointer: String, sources: Vec<SourceRule>, prefix: String, separator: String, suffix: String,
+}
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Profile {
+    id: String, endpoint: String, model: String, timeout_ms: u64, max_response_bytes: usize,
+    value_name_template: String, unit_pointer: Option<String>,
+    contract: Contract, request_template: Value, segments: Vec<SegmentRule>,
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Declaration { version: u32, profiles: Vec<Profile> }
+pub(super) struct Trusted { profiles: Vec<Profile>, _handles: (File,File) }
+impl Trusted {
+    pub fn authorize_terminal(&self, connection:&Connection, anchor:&Anchor, job:&Value)->anyhow::Result<(String,String)> {
+        let progress=&job["continuationState"];
+        need(progress["version"]==2,"STATE_GRAPH_AUTOMATIC_ADOPTION_AUTHORITY_UNPROVEN")?;
+        let index=progress["pageIndex"].as_u64().and_then(|index|usize::try_from(index).ok()).ok_or_else(||error("STATE_GRAPH_AUTOMATIC_ADOPTION_AUTHORITY_UNPROVEN"))?;
+        let page=super::super::database::row(connection,&anchor.provider_scope(),&format!("project-work-page:v3:{index}"))?.value.ok_or_else(||error("STATE_GRAPH_AUTOMATIC_ADOPTION_AUTHORITY_UNPROVEN"))?;
+        let unit=super::grouped::unit(&anchor.job_id,index,&page,progress)?;
+        need(progress["activeUnit"]["id"]==unit.id,"STATE_GRAPH_AUTOMATIC_ADOPTION_AUTHORITY_UNPROVEN")?;
+        let mut matches=Vec::new();
+        for profile in &self.profiles {
+            if profile.unit_pointer.as_deref()!=Some("/continuationState/activeUnit/id")
+                || profile.value_name_template.replace("{delta}",&anchor.delta_ordinal.to_string()).replace("{unit}",&unit.id)!=anchor.value_name
+                || profile.segments.len()!=1 {continue;}
+            let rule=&profile.segments[0];
+            if rule.request_pointer!="/messages/1/content" || !rule.prefix.is_empty() || !rule.separator.is_empty() || !rule.suffix.is_empty()
+                || rule.sources.len()!=1 || !matches!(rule.sources[0].scope,Scope::ProviderValues)
+                || rule.sources[0].key!="value:{delta}:automatic-source" || rule.sources[0].pointer!="/value"
+                || profile.request_template.pointer("/messages/0/role").and_then(Value::as_str)!=Some("system")
+                || profile.request_template.pointer("/messages/0/content").and_then(Value::as_str)!=Some(unit.system.as_str())
+                || profile.request_template.pointer("/messages/1/role").and_then(Value::as_str)!=Some("user") {continue;}
+            let mut body=profile.request_template.clone();
+            let selected=body.pointer_mut("/messages/1/content").ok_or_else(||error(CONFIG))?;
+            need(selected.is_null(),CONFIG)?;
+            *selected=Value::String(unit.prompt.clone());
+            let request=serde_json::to_string(&body)?;
+            need(request.len()<=2*1024*1024 && binding::secret_free(&body),"STATE_GRAPH_AUTOMATIC_ADOPTION_AUTHORITY_UNPROVEN")?;
+            matches.push((profile,binding::digest(request.as_bytes())));
+        }
+        need(matches.len()==1,"STATE_GRAPH_AUTOMATIC_ADOPTION_AUTHORITY_UNPROVEN")?;
+        let (profile,digest)=matches.remove(0);
+        let declaration=serde_json::to_string(profile)?;
+        let pinned:Option<String>=connection.query_row("SELECT declaration FROM engine_graph_auto_authorities WHERE profile_id=?1",[&profile.id],|row|row.get(0)).optional()?;
+        if let Some(pinned)=pinned {need(pinned==declaration,"STATE_GRAPH_AUTOMATIC_AUTHORITY_CHANGED")?;}
+        else {connection.execute("INSERT INTO engine_graph_auto_authorities(profile_id,declaration) VALUES(?1,?2)",params![profile.id,declaration])?;}
+        Ok((profile.id.clone(),digest))
+    }
+    pub fn read(database:&Path)->anyhow::Result<Self> {
+        let (mut file,directory)=super::super::provider_attempt_budget::open_graph_automatic_authority(database)
+            .map_err(|_|error("STATE_GRAPH_AUTOMATIC_AUTHORITY_UNAVAILABLE"))?;
+        let mut raw=String::new();
+        file.by_ref().take(65_537).read_to_string(&mut raw).map_err(|_|error(CONFIG))?;
+        need(!raw.is_empty() && raw.len()<=65_536,CONFIG)?;
+        let value=protocol::strict_value(&raw).map_err(|_|error(CONFIG))?;
+        let declaration:Declaration=serde_json::from_value(value).map_err(|_|error(CONFIG))?;
+        need(declaration.version==1 && (1..=32).contains(&declaration.profiles.len()),CONFIG)?;
+        let mut ids=HashSet::new();
+        for profile in &declaration.profiles {
+            need(super::wire::id(&profile.id,128) && ids.insert(&profile.id) && profile.request_template.is_object()
+                && binding::secret_free(&profile.request_template) && (1..=32).contains(&profile.segments.len()),CONFIG)?;
+            let target=profile.value_name_template.replace("{delta}","1").replace("{unit}","unit");
+            need(super::wire::id(&target,192) && profile.unit_pointer.as_ref().is_none_or(|pointer|super::wire::pointer(pointer))
