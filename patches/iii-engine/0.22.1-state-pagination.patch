+    let capture = serde_json::to_string(&json!({"temporalUnitVersion":2,"jobId":TEMP_PARENT,"pageIndex":0,"unit":{"fingerprint":fingerprint}})).unwrap();
+    let mut job = json!({"version":1,"id":id,"generation":"1","kind":"temporal","state":"applying","captureParts":1,"captureComplete":true,"captureDigest":hex::encode(Sha256::digest(capture.as_bytes()))});
+    adapter.set(storage_prune::TEMPORAL_WORK,TEMP_MANIFEST,temporal_parent(false,"2000-01-01T00:00:00.000Z")).await.unwrap();
+    adapter.set(storage_prune::TEMPORAL_WORK,TEMP_PAGE,json!({"sources":["retain"]})).await.unwrap();
+    adapter.set("mem:temporal-graph-pending",TEMP_PARENT,json!({"version":1,"jobId":TEMP_PARENT,"state":"pending"})).await.unwrap();
+    adapter.commit_batch(batch(owner.clone(),&id,"delta",0,"0","staging",vec![op(JOBS,&id,"0",job.clone()),op(WORKING,&id,"0",working(&id,"1","delta",None)),op(&format!("mem:graph:inputs:{id}"),"capture:0","0",json!(capture))])).await.unwrap();
+    job["state"] = json!("completed");
+    let close = batch(owner.clone(),&id,"delta",1,"1","complete",vec![op(JOBS,&id,"1",job),check(SNAPSHOT,"current","0")]);
+    let receipt = adapter.commit_batch(close.clone()).await.unwrap();
+    assert_eq!(adapter.commit_batch(close).await.unwrap(),receipt);
+    let version_id = id.clone();
