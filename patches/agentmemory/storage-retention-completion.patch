@@ -0,0 +1,56 @@
+import type { IIIClient } from "iii-sdk";
+import type { StateGraphGuard } from "./state-transactions.js";
+import { STORAGE_RETENTION } from "../functions/storage-retention.js";
+
+export interface StorageTtlReceipt {
+  runId: string;
+  ordinal: number;
+  scope: string;
+  inspected: number;
+  deleted: number;
+  rawStripped: number;
+  logicalBytesDeleted: number;
+  storedBytesDeleted: number;
+  excluded: number;
+  inputBytes: number;
+  elapsedMs: number;
+  done: boolean;
+  progress: { ordinal: number; done: boolean };
+}
+
+export async function storageTtlPage(sdk: IIIClient, request: {
+  runId: string; ordinal: number; ownerId: string; fence: number; guard: StateGraphGuard;
+}): Promise<StorageTtlReceipt> {
+  if (!/^[A-Za-z0-9._:-]{1,128}$/.test(request.runId) || !Number.isSafeInteger(request.ordinal)
+    || request.ordinal < 0 || request.ordinal >= 1_000_000) throw new Error("STATE_STORAGE_INVALID_REQUEST");
+  const value = await sdk.trigger<unknown, unknown>({ function_id: "state::storage", payload: {
+    action: "ttl_page", request: {
+      run_id: request.runId, ordinal: request.ordinal, owner_id: request.ownerId,
+      fence: request.fence, guard: request.guard,
+      viewer_max_age_ms: STORAGE_RETENTION.viewer.maximumAgeMs,
+      bodies_max_age_ms: STORAGE_RETENTION.completedBodies.maximumAgeMs,
+      tools_max_age_ms: STORAGE_RETENTION.tools.maximumAgeMs,
+    },
+  } });
+  if (typeof value !== "object" || value === null || Array.isArray(value)) throw new Error("STATE_STORAGE_INVALID_RESPONSE");
+  const receipt = value as StorageTtlReceipt;
+  if (receipt.runId !== request.runId || receipt.ordinal !== request.ordinal || typeof receipt.done !== "boolean"
+    || typeof receipt.scope !== "string" || !receipt.progress || receipt.progress.ordinal !== request.ordinal + 1
+    || receipt.progress.done !== receipt.done
+    || ![receipt.inspected, receipt.deleted, receipt.rawStripped, receipt.logicalBytesDeleted,
+      receipt.storedBytesDeleted, receipt.excluded, receipt.inputBytes].every(n => Number.isSafeInteger(n) && n >= 0)
+    || receipt.inspected > 4096 || receipt.inputBytes > 4_194_304 || !Number.isFinite(receipt.elapsedMs) || receipt.elapsedMs < 0
+    || receipt.deleted + receipt.rawStripped + receipt.excluded !== receipt.inspected) throw new Error("STATE_STORAGE_INVALID_RESPONSE");
+  return receipt;
+}
+
+export async function recordContextRetentionUse(sdk: IIIClient, sessionId: string, project: string,
+  targets: Array<{ scope: string; key: string; expected_version: string }>): Promise<void> {
+  if (!targets.length) return;
+  const result = await sdk.trigger<unknown, { recorded?: unknown }>({ function_id: "state::storage", payload: {
+    action: "ttl_record_context_use", request: { session_id: sessionId, project, targets: targets.slice(0, 50) },
+  } });
+  if (!Number.isSafeInteger(result?.recorded) || Number(result.recorded) < 0 || Number(result.recorded) > targets.length) {
+    throw new Error("STATE_STORAGE_INVALID_RESPONSE");
+  }
+}
