+function shouldYield(deadlineAt: number, shouldPause: () => boolean): boolean {
+  return Date.now() >= deadlineAt || shouldPause();
+}
+
+async function waitForMaintenanceSlot(until: number, deadlineAt: number, shouldPause: () => boolean): Promise<boolean> {
+  while (Date.now() < until && !shouldYield(deadlineAt, shouldPause)) {
+    const remaining = Math.min(until - Date.now(), deadlineAt - Date.now(), 250);
+    if (remaining <= 0) break;
+    await new Promise((resolve) => setTimeout(resolve, remaining));
+  }
+  return Date.now() >= until && !shouldYield(deadlineAt, shouldPause);
+}
+
+async function nativeCompactionStatus(sdk: IIIClient): Promise<NativeCompactionStatus> {
+  return triggerStateStorage<NativeCompactionStatus>(sdk, { action: "compact_status" });
+}
+
+async function nativeCompactionBatch(
+  sdk: IIIClient,
+  kv: StateKV,
+  state: MaintenanceState,
+  lease: MaintenanceLease,
+  refreshLease: () => Promise<void>,
+  status: NativeCompactionStatus,
+  step: NativeCompactionStep,
+  deadlineAt: number,
+  shouldPause: () => boolean,
+): Promise<NativeCompactionStatus> {
+  let request: NativeCompactionApply;
+  let pending = state.compactOperation;
+  await refreshLease();
+  if (shouldYield(deadlineAt, shouldPause)) return status;
+  if (pending) {
+    if (pending.request.lease_owner_id === lease.ownerId && pending.request.lease_fence === lease.fence) {
+      request = pending.request;
+    } else {
+      if (status.generation !== pending.request.expected_generation) {
+        state.compactOutcomeUnknown = true;
+        await saveState(kv, state);
+        return status;
+      }
+      state.compactOperationHistory = [...(state.compactOperationHistory ?? []), {
+        ...pending, outcome: "not_applied", recordedAt: new Date().toISOString(),
+      }].slice(-30);
+      state.compactOperation = undefined;
+      await saveState(kv, state);
+      pending = undefined;
+    }
+  }
+  if (!pending) {
+    const collection = step === "collect";
+    request = {
+      operation_id: generateId("storage-compact"), expected_generation: status.generation, step,
+      limit: collection ? COLLECTION_LIMIT : COMPACTION_BATCH_LIMIT,
+      max_bytes: collection ? COLLECTION_MAX_BYTES : COMPACTION_BATCH_MAX_BYTES,
+      max_ms: COMPACTION_MAX_MS, lease_owner_id: lease.ownerId, lease_fence: lease.fence,
+    };
+    state.compactOperation = {
+      request,
+      before: {
+        phase: status.phase, cursor: { ...status.cursor }, active: status.active,
+        rows_complete: status.rows_complete, vectors_complete: status.vectors_complete,
+        complete: status.complete,
+      },
+    };
+  }
+  await saveState(kv, state);
+  const result = await triggerStateStorage<NativeCompactionStatus>(sdk, { action: "compact_apply", request });
+  if (request.step === "collect") {
+    if (typeof result.gc_complete !== "boolean") throw new Error("STATE_STORAGE_INVALID_RESPONSE");
+    state.compactGcComplete = result.gc_complete;
+  }
+  state.compactOperation = undefined;
+  await saveState(kv, state);
+  return result;
+}
+
+async function runNativeCompactionCycle(
+  sdk: IIIClient,
+  kv: StateKV,
+  state: MaintenanceState,
+  lease: MaintenanceLease,
+  refreshLease: () => Promise<void>,
+  deadlineAt: number,
+  shouldPause: () => boolean,
+): Promise<{ completed: boolean; status: StorageReclaimResult | null; outcomeUnknown: boolean }> {
+  if (state.compactOutcomeUnknown) return { completed: false, status: null, outcomeUnknown: false };
+  let status = await nativeCompactionStatus(sdk);
+  if (status.phase === "rollback") throw new Error("STATE_STORAGE_COMPACTION_ROLLBACK_ACTIVE");
+  const nativeWork = status.active || status.phase === "copy" || status.phase === "compact";
+  if (!state.compactCycleActive && !nativeWork
+    && (!state.ttlReceipt?.done || state.maintenanceReview.dueReasons.length === 0)) {
+    return { completed: false, status: null, outcomeUnknown: false };
+  }
+  state.compactCycleActive = true;
+  await saveState(kv, state);
+
+  while (!state.compactGcComplete && !state.compactOutcomeUnknown && !shouldYield(deadlineAt, shouldPause)) {
+    status = await nativeCompactionStatus(sdk);
+    if (status.phase === "rollback") throw new Error("STATE_STORAGE_COMPACTION_ROLLBACK_ACTIVE");
+    let step: NativeCompactionStep;
+    if (status.phase === "legacy" && !status.active) step = "activate";
+    else if (status.phase === "copy") {
+      step = status.rows_complete && status.vectors_complete ? "cut" : "copy";
+    } else if (status.phase === "compact") step = "collect";
+    else throw new Error("STATE_STORAGE_COMPACTION_STATE_UNKNOWN");
+    status = await nativeCompactionBatch(
+      sdk, kv, state, lease, refreshLease, status, step, deadlineAt, shouldPause,
+    );
+    if (state.compactOutcomeUnknown) return { completed: false, status: null, outcomeUnknown: false };
+    if (step === "collect" && status.gc_complete === true) state.compactGcComplete = true;
+  }
+  if (!state.compactGcComplete) return { completed: false, status: null, outcomeUnknown: false };
+
+  let lastResult: StorageReclaimResult | null = null;
+  while (!shouldYield(deadlineAt, shouldPause)) {
+    const backoffUntil = state.compaction.backoffUntil ? Date.parse(state.compaction.backoffUntil) : 0;
+    if (backoffUntil > Date.now()) break;
+    const nextEligibleAt = state.compaction.nextEligibleAt ? Date.parse(state.compaction.nextEligibleAt) : 0;
+    if (nextEligibleAt > Date.now()
+      && !await waitForMaintenanceSlot(nextEligibleAt, deadlineAt, shouldPause)) break;
+    const outcome = await reclaim(
+      sdk, kv, state, lease, false, true, () => shouldYield(deadlineAt, shouldPause),
+    );
+    if (outcome.outcomeUnknown) return { completed: false, status: outcome.result, outcomeUnknown: true };
+    const result = outcome.result;
+    if (!result) break;
+    lastResult = result;
+    if (result.status === "complete" && result.after.freelist_count === 0) {
+      const completedAt = new Date().toISOString();
+      const review = state.maintenanceReview;
+      review.footprintBaselineBytes = result.after.database_bytes + result.after.wal_bytes;
+      review.footprintBaselineAt = completedAt;
+      review.footprintBaselineKind = "successful_cycle";
+      review.freePagePendingSince = null;
+      review.dueReasons = [];
+      state.lastSuccessfulCompactionAt = completedAt;
+      state.compactCycleActive = false;
+      state.compactGcComplete = false;
+      await saveState(kv, state);
+      return { completed: true, status: result, outcomeUnknown: false };
+    }
+    if (!["progress", "complete"].includes(result.status)) break;
+  }
+  return { completed: false, status: lastResult, outcomeUnknown: false };
+}
