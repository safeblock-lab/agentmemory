+        },
+    }
+    job["ordinal"]=json!(r.expected_ordinal.checked_add(1).ok_or_else(||error("STATE_TX_LIMIT_EXCEEDED"))?);
+    c.execute("INSERT INTO lexical_repack_job VALUES(1,?1) ON CONFLICT(singleton) DO UPDATE SET value=excluded.value",[serde_json::to_string(&job)?])?;
+    if let Some(proof)=cut_proof.as_mut(){proof["job"]=job.clone();}
+    let result=json!({"operation_id":r.operation_id,"job":job,"processed_rows":rows,"work_bytes":bytes,"original_protected":protected(c)?,"cut_proof":cut_proof});
+    c.execute("INSERT INTO lexical_repack_receipts VALUES(?1,?2,?3)",params![r.operation_id,Sha256::digest(serde_json::to_vec(&r)?).to_vec(),serde_json::to_string(&result)?])?;
+    Ok(result)
+}
+fn copy(c:&Connection,r:&Request,job:&mut Value)->anyhow::Result<(usize,usize)> {
+    let started=Instant::now();let (mut rows,mut bytes)=(0usize,0usize);
+    while rows<r.limit && (rows==0 || started.elapsed()<Duration::from_millis(r.max_ms.saturating_sub(300).min(1000))) {
+        let next:Option<(i64,i64)>=match job["cursor"].as_i64() {
+            Some(cursor)=>c.prepare_cached(COPY_AFTER_SQL)?.query_row([cursor],|r|Ok((r.get(0)?,r.get(1)?))).optional()?,
+            None=>c.prepare_cached(COPY_FIRST_SQL)?.query_row([],|r|Ok((r.get(0)?,r.get(1)?))).optional()?,
+        };
+        let Some((rowid,size))=next else {job["phase"]=json!("ready");break;};
+        let size=usize::try_from(size)?;anyhow::ensure!(size<=content::MAX_TEXT,"STATE_LEXICAL_ROW_EXCEEDS_BUDGET");
+        let canonical_work:i64=c.prepare_cached(COPY_WORK_SQL)?.query_row([rowid],|r|r.get(0))?;
+        let work=size.saturating_add(usize::try_from(canonical_work)?).saturating_add(4096);
+        if bytes.saturating_add(work)>r.max_bytes {anyhow::ensure!(rows>0,"STATE_LEXICAL_ROW_EXCEEDS_BUDGET");break;}
+        let (index,epoch,id,text):(String,i64,String,String)=c.prepare_cached("SELECT index_id,epoch,id,text FROM retrieval_lexical WHERE rowid=?1")?.query_row([rowid],|r|Ok((r.get(0)?,r.get(1)?,r.get(2)?,r.get(3)?)))?;
