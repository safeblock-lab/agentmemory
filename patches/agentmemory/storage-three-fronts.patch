+    c.execute(&format!("INSERT INTO {table}({table},rowid,index_id,epoch,id,text) VALUES('delete',?1,?2,?3,?4,?5)"),params![rowid,index,epoch,id,text])?;
+    Ok(())
+}
+pub fn mirror_insert(c:&Connection,rowid:i64,index:&str,epoch:i64,id:&str,text:&str)->anyhow::Result<()> {
