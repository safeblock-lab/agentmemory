+pub fn validate(c:&Connection,table:&str,classic:bool)->anyhow::Result<String> {
+    require(["retrieval_lexical","lexical_repack_stage","lexical_repack_original"].contains(&table))?;
+    let sql:String=c.query_row("SELECT sql FROM sqlite_schema WHERE type='table' AND name=?1",[table],|r|r.get(0))?;
+    let rest=sql.strip_prefix("CREATE VIRTUAL TABLE ").ok_or_else(||error("STATE_LEXICAL_SCHEMA_UNSUPPORTED"))?;
+    let rest=rest.strip_prefix("IF NOT EXISTS ").unwrap_or(rest);
+    let quoted=format!("\"{table}\"");
+    let tail=rest.strip_prefix(quoted.as_str()).or_else(||rest.strip_prefix(table)).ok_or_else(||error("STATE_LEXICAL_SCHEMA_UNSUPPORTED"))?;
+    let expected=format!(" USING fts5({}{})",content::DECLARATION,if classic{",content=''"}else{""});
+    anyhow::ensure!(tail.trim_end_matches(';').trim_end()==expected,"STATE_LEXICAL_SCHEMA_UNSUPPORTED");
+    let columns=c.prepare("SELECT name FROM pragma_table_xinfo(?1) WHERE hidden=0 ORDER BY cid")?.query_map([table],|r|r.get::<_,String>(0))?.collect::<rusqlite::Result<Vec<_>>>()?;
+    anyhow::ensure!(columns==["index_id","epoch","id","text"],"STATE_LEXICAL_SCHEMA_UNSUPPORTED");
+    Ok(sql)
