+fn expiry_reason(connection:&Connection,scope:&str,key:&str,value:&Value,viewer:bool,maximum:i64,now:i64)->anyhow::Result<Option<&'static str>> {
+    if storage_prune::row_protected(value) {return Ok(Some("protected"));}
+    let origin=if viewer {value["at"].as_i64().filter(|at|*at>=0)} else {
+        value.get("completedAt").or_else(||value.get("closedAt")).or_else(||value.get("updatedAt"))
+            .or_else(||value.get("createdAt")).or_else(||value.get("timestamp"))
+            .and_then(Value::as_str).and_then(|at|chrono::DateTime::parse_from_rfc3339(at).ok()).map(|at|at.timestamp_millis())
+    };
+    let Some(origin)=origin else {return Ok(Some("unknown_or_invalid_origin"))};
+    if origin>now {return Ok(Some("future_origin"));}
+    if value.get("meaningfulUse").is_some() || value.get("retentionUse").is_some() {return Ok(Some("unattributed_use"));}
+    if let Some(evidence)=storage_prune::bounded_dependency(connection,STATE,&use_key(scope,key))? {
+        if evidence["producer"]!="server-task-context-delivery"
+            || evidence["targetVersion"]!=database::row_version(connection,scope,key)?.to_string()
+            || evidence["occurredAtMs"].as_i64().is_none_or(|at|at<origin || at>now) {return Ok(Some("invalid_or_stale_use_evidence"));}
+    }
+    Ok(if expired(connection,scope,key,value,viewer,maximum,now)? {None} else {Some("not_expired")})
+}
