+    else if scope.starts_with("mem:obs:"){"toolBodies"}
+    else if scope.starts_with("mem:graph:prepared:") || scope.starts_with("mem:graph:remaps:"){"graphAuxiliary"}
+    else if scope.starts_with("mem:summary-queue:units:"){"summaryAuxiliary"}
+    else if scope=="mem:recent-searches"{"viewer"}
