+const COPY_FIRST_SQL:&str="SELECT rowid,length(CAST(text AS BLOB)) FROM retrieval_lexical ORDER BY rowid LIMIT 1";
+const COPY_AFTER_SQL:&str="SELECT rowid,length(CAST(text AS BLOB)) FROM retrieval_lexical WHERE rowid>?1 ORDER BY rowid LIMIT 1";
+const COPY_WORK_SQL:&str="SELECT coalesce(max(CASE WHEN v.value_bytes BETWEEN 1 AND 262144 AND v.stored_bytes BETWEEN 1 AND 262144 AND e.value_bytes BETWEEN 1 AND 262144 AND e.stored_bytes BETWEEN 1 AND 262144 THEN 3*(v.value_bytes+v.stored_bytes)+e.value_bytes+e.stored_bytes ELSE 0 END),0) FROM retrieval_lexical_links l CROSS JOIN retrieval_source_items s INDEXED BY retrieval_source_items_id ON s.index_id=l.index_id AND s.key=l.id AND s.dirty=0 CROSS JOIN state_values v ON v.scope=s.scope AND v.key=s.key AND v.version=s.version AND v.live=1 CROSS JOIN state_values e ON e.scope='mem:semantic:'||l.index_id AND e.key=l.id AND e.live=1 WHERE l.rowid=?1";
+
+pub fn initialize(c:&Connection)->anyhow::Result<()> {
+    c.execute_batch("CREATE TABLE IF NOT EXISTS lexical_repack_job(singleton INTEGER PRIMARY KEY CHECK(singleton=1),value TEXT NOT NULL); CREATE TABLE IF NOT EXISTS lexical_repack_receipts(operation_id TEXT PRIMARY KEY,digest BLOB NOT NULL,result TEXT NOT NULL) WITHOUT ROWID;")?;
+    Ok(())
+}
+pub fn status(c:&Connection)->anyhow::Result<Value> {
+    let value:Option<String>=c.query_row("SELECT value FROM lexical_repack_job WHERE singleton=1",[],|r|r.get(0)).optional()?;
+    Ok(value.map(|v|serde_json::from_str(&v)).transpose()?.unwrap_or(json!({"phase":"absent","ordinal":0})))
+}
+pub fn protected(c:&Connection)->anyhow::Result<bool> {
+    Ok(c.query_row("SELECT EXISTS(SELECT 1 FROM sqlite_schema WHERE name='lexical_repack_original')",[],|r|r.get(0))?)
+}
+pub fn receipt(c:&Connection,r:&Request)->anyhow::Result<Value> {
+    let saved:Option<(Vec<u8>,String)>=c.query_row("SELECT digest,result FROM lexical_repack_receipts WHERE operation_id=?1",[&r.operation_id],|r|Ok((r.get(0)?,r.get(1)?))).optional()?;
+    match saved {None=>Ok(json!({"status":"not_found","operation_id":r.operation_id})),Some((digest,result))=>{
+        require(digest==Sha256::digest(serde_json::to_vec(r)?).to_vec())?;
+        Ok(json!({"status":"applied","operation_id":r.operation_id,"result":serde_json::from_str::<Value>(&result)?}))
+    }}
+}
+fn mirror(c:&Connection)->anyhow::Result<Option<&'static str>> {
+    Ok(match status(c)?["phase"].as_str(){Some("copy"|"ready")=>Some("lexical_repack_stage"),Some("cut")=>Some("lexical_repack_original"),_=>None})
+}
+pub fn mirror_delete(c:&Connection,rowid:i64)->anyhow::Result<()> {
+    if let Some(target)=mirror(c)? {delete_table(c,target,rowid)?;}
+    Ok(())
+}
+pub fn delete_table(c:&Connection,table:&str,rowid:i64)->anyhow::Result<()> {
+    require(["retrieval_lexical","lexical_repack_stage","lexical_repack_original"].contains(&table))?;
+    let classic=table=="lexical_repack_stage" || (table=="retrieval_lexical" && content::active(c)?);
+    validate_schema(c,table,classic)?;
+    if !classic {c.execute(&format!("DELETE FROM {table} WHERE rowid=?1"),[rowid])?;return Ok(());}
+    let exists:bool=c.query_row(&format!("SELECT EXISTS(SELECT 1 FROM {table} WHERE rowid=?1)"),[rowid],|r|r.get(0))?;
+    if !exists {return Ok(());}
+    let (index,epoch,id):(String,i64,String)=c.query_row("SELECT index_id,epoch,id FROM retrieval_lexical_links WHERE rowid=?1",[rowid],|r|Ok((r.get(0)?,r.get(1)?,r.get(2)?)))?;
