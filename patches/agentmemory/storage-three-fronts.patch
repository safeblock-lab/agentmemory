+pub fn proof(c:&Connection)->anyhow::Result<Value> {proof::full(c)}
+pub fn execute(c:&Connection,r:Request)->anyhow::Result<Value> {
+    require(!c.is_autocommit() && !r.operation_id.is_empty() && r.operation_id.len()<=128 && !r.job_id.is_empty() && r.job_id.len()<=96
+        && (1..=4096).contains(&r.limit) && (1024..=4*1024*1024).contains(&r.max_bytes)
+        && (1..=if r.step==Step::Cut{60_000}else{3000}).contains(&r.max_ms))?;
