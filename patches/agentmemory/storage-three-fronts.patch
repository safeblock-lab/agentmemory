+pub(super) fn reason(c: &Connection, scope: &str, key: &str, value: &Value) -> anyhow::Result<&'static str> {
+    if !family(scope) { return Ok("legacy_cache_family_unknown"); }
+    let Some(object) = value.as_object() else { return Ok("legacy_cache_format_unknown"); };
+    if object.len() != 3 || value["id"] != key || !["id", "s", "e"].iter().all(|field| value[*field].is_string()) {
+        return Ok("legacy_cache_format_unknown");
+    }
+    let session = value["s"].as_str().unwrap();
+    let encoded = value["e"].as_str().unwrap();
+    if session.is_empty() || session.len() > 4096 || encoded.len() > 131_072 { return Ok("legacy_cache_decode_budget"); }
+    let Ok(bytes) = STANDARD.decode(encoded) else { return Ok("legacy_cache_embedding_invalid"); };
+    if bytes.is_empty() || bytes.len() % 4 != 0 || STANDARD.encode(&bytes) != encoded
+        || bytes.chunks_exact(4).any(|bytes| !f32::from_le_bytes(bytes.try_into().unwrap()).is_finite()) {
+        return Ok("legacy_cache_embedding_invalid");
+    }
+    let identity: Option<(String, i64, String, i64)> = c.query_row(
+        "SELECT model,dimensions,generation,epoch FROM retrieval_semantic_meta WHERE index_id='observations' AND status='ready'",
+        [], |row| Ok((row.get(0)?,row.get(1)?,row.get(2)?,row.get(3)?))).optional()?;
+    let Some((model, dimensions, generation, epoch)) = identity else { return Ok("legacy_cache_native_identity_not_ready"); };
+    // This retirement is deliberately restricted to the accepted current local corpus.
+    if model != "Xenova/all-MiniLM-L6-v2" || dimensions != 384 || generation != "local-v1" {
+        return Ok("legacy_cache_native_identity_changed");
+    }
+    if bytes.len() / 4 == dimensions as usize { return Ok("legacy_cache_dimension_compatible"); }
+    let rollback: bool = c.query_row("SELECT EXISTS(SELECT 1 FROM compact_rollback) OR EXISTS(SELECT 1 FROM compact_config WHERE mode!=1 OR phase!='compact' OR complete!=1)", [], |row| row.get(0))?;
+    if rollback { return Ok("legacy_cache_compaction_or_rollback_open"); }
+    let source_scope = format!("mem:obs:{session}");
+    let Some(source) = storage_prune::bounded_dependency(c, &source_scope, key)? else { return Ok("legacy_cache_canonical_missing_or_oversized"); };
+    if source["id"] != key || source["sessionId"] != session || storage_prune::row_protected(&source)
+        || storage_prune::protected(&serde_json::to_string(&source)?) {
+        return Ok("legacy_cache_canonical_identity_or_protection");
+    }
+    let version = database::row_version(c, &source_scope, key)?.to_string();
+    let Some(semantic) = storage_prune::bounded_dependency(c, "mem:semantic:observations", key)? else { return Ok("legacy_cache_native_source_missing_or_oversized"); };
+    if semantic["id"] != key || semantic["sessionId"] != session || semantic["sourceScope"] != source_scope
+        || semantic["sourceVersion"] != version || semantic["model"] != model
+        || semantic["dimensions"] != dimensions || semantic["generation"] != generation
+        || storage_prune::row_protected(&semantic) {
+        return Ok("legacy_cache_native_source_stale");
+    }
+    let current: bool = c.query_row(
+        "SELECT EXISTS(SELECT 1 FROM retrieval_source_items s JOIN state_rows r ON r.scope=s.scope AND r.key=s.key AND r.version=s.version JOIN retrieval_vectors v ON v.index_id=s.index_id AND v.id=s.key AND v.epoch=?4 AND v.session_id=?5 WHERE s.index_id='observations' AND s.scope=?1 AND s.key=?2 AND s.version=?3 AND s.dirty=0)",
+        params![source_scope,key,version,epoch,session], |row| row.get(0))?;
+    Ok(if current { "legacy_cache_stale_dimension_canonical_preserved" } else { "legacy_cache_native_coverage_not_current" })
+}
