+// Revalidate guards in a bounded read transaction, then reject commits during either read.
+pub fn after(c:&Connection,path:&std::path::Path,generation:&str,r:&PageRequest,value:&Value,budget:&database::PreparationBudget)->anyhow::Result<()> {
