+pub(super) fn install(c:&Connection,source:&str,target:&str)->anyhow::Result<()> {
+    let insert=format!("INSERT INTO {target}(scope,key,value,version,position,value_bytes) VALUES(NEW.scope,NEW.key,NEW.value,NEW.version,NEW.position,NEW.value_bytes) ON CONFLICT(scope,key) DO UPDATE SET value=excluded.value,version=excluded.version,position=excluded.position,value_bytes=excluded.value_bytes;");
