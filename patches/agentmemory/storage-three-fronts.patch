+    let prior=receipt(c,&r)?;if prior["status"]=="applied" {return Ok(prior["result"].clone());}
+    let mut job=status(c)?;require(job["ordinal"].as_u64()==Some(r.expected_ordinal))?;
+    if r.step==Step::Begin {
+        require(job["phase"]=="absent" && !content::active(c)? && !super::storage_repack::protected(c)?)?;
+        let original_schema=validate_schema(c,"retrieval_lexical",false)?;
+        schema::create_stage(c)?;
+        let stage_schema=validate_schema(c,"lexical_repack_stage",true)?;
+        job=json!({"job_id":r.job_id,"owner_id":r.owner_id,"phase":"copy","ordinal":0,"cursor":null,"verified_rows":0,"input_text_bytes":0,"canonical_exact_bytes":0,"reasons":{},"original_create_sql":original_schema,"stage_create_sql":stage_schema});
+    } else {
+        require(job["job_id"]==r.job_id && job["owner_id"]==r.owner_id)?;
+        if ["copy","ready"].contains(&job["phase"].as_str().unwrap_or("")) {
+            validate_schema(c,"retrieval_lexical",false)?;validate_schema(c,"lexical_repack_stage",true)?;
+        } else if ["cut","retiring"].contains(&job["phase"].as_str().unwrap_or("")) {
+            validate_schema(c,"retrieval_lexical",true)?;validate_schema(c,"lexical_repack_original",false)?;
+        }
+    }
+    let (mut rows,mut bytes)=(0usize,0usize);let mut cut_proof=None;
+    match r.step {
+        Step::Begin=>(),
+        Step::Copy=>{require(job["phase"]=="copy")?;(rows,bytes)=copy(c,&r,&mut job)?;},
+        Step::Cut=>{
+            require(job["phase"]=="ready")?;let mut verified=proof(c)?;require(verified["rowids_and_metadata_exact"]==true)?;
+            c.flush_prepared_statement_cache();
+            c.execute_batch("ALTER TABLE retrieval_lexical RENAME TO lexical_repack_original; ALTER TABLE lexical_repack_stage RENAME TO retrieval_lexical; PRAGMA user_version=3;")?;
+            job["phase"]=json!("cut");c.flush_prepared_statement_cache();
+            verified["original_create_sql"]=json!(validate_schema(c,"lexical_repack_original",false)?);
+            verified["active_create_sql"]=json!(validate_schema(c,"retrieval_lexical",true)?);content::validate_format(c)?;
+            verified["format"]=json!(3);verified["original_protected"]=json!(protected(c)?);cut_proof=Some(verified);
+        },
+        Step::Rollback=>{
+            require(job["phase"]=="cut")?;c.flush_prepared_statement_cache();
+            c.execute_batch("ALTER TABLE retrieval_lexical RENAME TO lexical_repack_stage; ALTER TABLE lexical_repack_original RENAME TO retrieval_lexical; PRAGMA user_version=2;")?;
+            job["phase"]=json!("ready");c.flush_prepared_statement_cache();
+        },
+        Step::Retire=>{
