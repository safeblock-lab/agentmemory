+fn capture_without_mirror(c:&Connection)->anyhow::Result<Value> {
+    capture(c)
+}
+pub(super) fn rollback(c:&Connection,saved:&Value)->anyhow::Result<()> {
+    c.flush_prepared_statement_cache();detach(c,saved)?;
+    c.execute_batch("ALTER TABLE state_rows RENAME TO state_repack_stage; ALTER TABLE state_repack_original RENAME TO state_rows;")?;
+    attach(c,saved)?;super::mirror::install(c,"state_rows","state_repack_stage")?;
