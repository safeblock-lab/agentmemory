+fn bounded_stamps<T>(c:&Connection,budget:&database::PreparationBudget,read:impl FnOnce()->anyhow::Result<T>)->anyhow::Result<T> {
+    let result=(||{budget.install(c)?;let value=read()?;budget.check()?;Ok(value)})();
