{
  "name": "@agentmemory/agentmemory",
  "version": "0.9.84",
  "description": "Persistent memory for AI coding agents, powered by iii-engine's three primitives",
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./dist/standalone.mjs": "./dist/standalone.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "agentmemory": "dist/cli.mjs"
  },
  "scripts": {
    "build:engine": "node scripts/build-iii-engine.mjs",
    "build": "tsdown && node scripts/copy-package-assets.mjs --require-engine",
    "dev": "tsx src/index.ts",
    "start": "node dist/cli.mjs",
    "migrate": "node dist/functions/migrate.js",
    "test": "vitest run --exclude test/integration.test.ts",
    "test:watch": "vitest --exclude test/integration.test.ts",
    "test:integration": "vitest run test/integration.test.ts",
    "test:all": "vitest run",
    "skills:gen": "tsx scripts/skills/generate.ts",
    "skills:check": "tsx scripts/skills/generate.ts --check && tsx scripts/skills/check.ts",
    "bench:load": "node --import tsx benchmark/load-100k.ts",
    "eval:longmemeval": "tsx eval/runner/longmemeval.ts",
    "eval:coding-life": "tsx eval/runner/coding-life.ts",
    "eval:llm-routing": "tsx eval/runner/llm-routing.ts"
  },
  "keywords": [
    "ai",
    "agent",
    "memory",
    "persistent",
    "iii-engine",
    "claude-code",
    "coding-agent",
    "context",
    "observation"
  ],
  "files": [
    "dist/",
    "plugin/",
    "integrations/pi/",
    "iii-config.yaml",
    "iii-config.docker.yaml",
    "docker-compose.yml",
    ".env.example",
    "LICENSE",
    "README.md",
    "docs/fork-local-usage.md",
    "docs/README.md",
    "docs/graph/local-indexed-runtime.md",
    "docs/graph/local-indexed-results.md",
    "docs/graph/local-reranking.md",
    "docs/graph/qwen-gpu-upstream-assets.json",
    "docs/graph/qwen-model-notice.md",
    "docs/graph/licenses/Apache-2.0.txt",
    "docs/graph/licenses/llama.cpp-b11371-LICENSE.txt",
    "docs/operations/state-pagination.md",
    "docs/fireworks-batch.md",
    "docs/typesafe.md",
    "docs/summary-budget.md",
    "AGENTS.md",
    "docs/operations/background-health-repair.md",
    "docs/operations/agentmemory-0.9.82-release.md",
    "docs/operations/agentmemory-0.9.84-release.md",
    "docs/operations/dashboard-native-health.md",
    "docs/operations/agentmemory-status.md",
    "docs/operations/export-contract.md",
    "docs/operations/graph-job-retention.md",
    "docs/operations/native-storage-format-v2.md"
  ],
  "author": "Rohit Ghumare <ghumare64@gmail.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/rohitg00/agentmemory"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.142",
    "@anthropic-ai/sdk": "^0.100.1",
    "@clack/prompts": "^1.2.0",
    "dotenv": "^17.4.2",
    "@iii-dev/helpers": "0.22.1",
    "iii-sdk": "0.22.1",
    "jsonrepair": "3.15.0",
    "picocolors": "^1.1.1",
    "zod": "^4.0.0"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@node-rs/jieba": "^2.0.1",
    "tiny-segmenter": "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsdown": "^0.21.10",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "qs": "^6.15.2",
    "ws": "^8.21.0",
    "protobufjs": "^7.5.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
